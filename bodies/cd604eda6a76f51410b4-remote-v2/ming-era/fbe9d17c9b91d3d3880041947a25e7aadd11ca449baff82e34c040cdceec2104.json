[{"title":"落花","author":"陆卿","text":"风流犹记旧相偎，洗却铅华另结胎。\n饱阅炎凉羞献笑，无端聚散莫兴哀。\n情缘到底方知冷，世事回头尽可猜。\n姚魏未须矜异艳，行看次第衬苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春袁挺生介若以感怀诗见投步韵答之","author":"陆卿","text":"多难惭存未死身，荒山惊见历书新。\n十围旧柳犹存汉，七日孤臣敢乞秦。\n如戟须髯空负我，无情花草自争春。\n闲来读史愁来饮，架上樽中或未贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀洪东木谢梁也两给谏","author":"陆卿","text":"年来抗节与时违，家国飘零各未归。\n给事山亭开雀省，康王茅屋易龙衣。\n辱金久已羞同炼，灵豆何从得度饥。\n吾道自应长守困，且栽薜荔坐渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕台逢黄原虚话旧","author":"陆卿","text":"十五年间梦里过，相逢扼腕共蹉跎。\n衣冠谁是当时者，须鬓其如此日何。\n漠漠寒云迷玉马，萋萋荒草没铜驼。\n由来燕赵多悲感，携向青帘且放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵返棹","author":"陆卿","text":"摇摇一棹荡斜晖，行止年来与愿违。\n淮水自奔京口出，春风又送广陵归。\n途穷泪洒冯生铗，金尽寒侵季子衣。\n莫问隋堤重回首，暮鸦空向玉钩飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"久客还渫园","author":"陆卿","text":"数架牙签尘网垂，庭松径柳自离披。\n情当磈礌惟看剑，我负云山赖有诗。\n避债长扃花外户，畏人静理局中棋。\n香烟一缕疏帘寂，得句掀髯付雪儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中梦故友黄积水","author":"陆卿","text":"念我浪游苦，分伊家食甘。\n才高雠忍杀，面冷子无男。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文邑八景 其一 三江夹洞","author":"邢之显","text":"壮矣城南一洞天，三江环绕夜沦涟。\n澄波没岸凝秋雾，空翠飞檐挂紫烟。\n一粒明珠浮镜里，半钩新月映帘前。\n依稀欲写沧洲景，到处逢人话辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文邑八景 其二 浮丘分潮","author":"邢之显","text":"人间何处有丹丘，花落鸟啼景自幽。\n鲛室玲珑浮翠岛，冰壶潋滟贮瀛洲。\n孤峰半落青天外，二水中分大地流。\n搔首问天差足慰，扁舟拟作武陵游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登准提阁","author":"黄德燝","text":"傍湖深浅得山情，入望江峰次第评。\n飞鹤云间冲雨至，斜帆天际泛烟轻。\n檐齐孤塔闻铃语，人定千家有磬声。\n鱼鸟不须惊钓弋，曹源一滴證无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"银瓶飞瀑","author":"黄德燝","text":"层峦月夕殷轻雷，一派银河接上台。\n海国年年春泽沛，作霖应尔是仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海门潮声","author":"黄德燝","text":"极目沧溟浸远天，鼍音隐隐度斜川。\n移情我亦成连者，一奏回风涨紫烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丽江月色","author":"黄德燝","text":"横披素练水晶乡，万户蟾光桂蕊香。\n何处兰舟吹短笛，孺歌月下咏沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长沙夜雨","author":"黄德燝","text":"江面初生一缕阴，霏霏尽作老龙吟。\n飘来远屿归帆湿，维向芦花伴宿禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤河晚渡","author":"黄德燝","text":"见说河东有凤山，问津人在夕阳湾。\n江鸥不管行骖速，故傍渔矶作意閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五坡怀古","author":"黄德燝","text":"宋末支天草拜麻，六师驻处即为家。\n龙归沧渤号遗鼎，雁度燕关咽暮笳。\n元相于公端属望，臣心一死已无加。\n空山古道千秋色，松柏森森长岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬子春羊踶岭庵重葺落成","author":"黄德燝","text":"一径纡回最上峰，四时岚气幻山容。\n尽芟榛莽栽棠树，且息疲劳听晚钟。\n施茗衲僧敲石火，窥人林鸟数游踪。\n帝乡子舍含情处，天际云横野色浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题金鸡春晓","author":"李腾","text":"金冈胜概多，灵鸟生非俗。\n名雒异凤凰，志不同鸿鹄。\n烟花四望春，天地一声旭。\n徵音勿云杳，于兹端可续。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴那灵雨","author":"李士长","text":"古刹岧峣翠巘重，飞湮挟雨锁芙蓉。\n云柯忽动千峰梵，石鏬争鸣万壑钟。\n禅磬数声清客梦，佛灯孤照印空宗。\n胜游休讶山灵妒，簇簇膏□到处逢。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经犀牛峡","author":"樊起龙","text":"海暗烽烟暮，楼船几度过。\n崃云吞落日，堤柳接长河。\n孤鹤腾清汉，灵犀起白波。\n何人仍缓带，倚棹听渔歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴江晓发","author":"樊起龙","text":"江湖风雨暗斜晖，历乱云山入望微。\n司马闻移京口旆，将军未解洞庭围。\n角声悲壮迎金鼓，水色光寒上铁衣。\n不尽客怀帆影外，又看秋雁向南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岳王庙","author":"樊起龙","text":"武昌公庙大江头，门掩松花一径幽。\n宋业欲亡和议起，郾城初捷羽书愁。\n苔碑有恨山云寂，石马无声烟水秋。\n梦断黄龙何日底，天南钟鼓思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过东莞伯墓","author":"樊起龙","text":"毬石狮岩势欲吞，霸图雄业一丘存。\n登坛结士先刑赏，倚剑观星识至尊。\n荒冢有花开二月，断碑无字落孤村。\n东南半壁今还古，赤帜何人候虎门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兴 其一","author":"陈炅","text":"潮生古岸寒风急，野渡无人行路难。\n杨柳萧条羌笛怨，芰荷零落客衣寒。\n楼头星火依檐落，槛外云山倚剑看。\n回首沧江无限兴，故溪归去负渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兴 其二","author":"陈炅","text":"散步江村日影斜，双双鸥鸟踏晴沙。\n晚霞海角三株树，秋水明河八月槎。\n回首天涯真浪迹，侧身歧路岂无家。\n别来不奈逢摇落，愁见芙蓉一度花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兴 其三","author":"陈炅","text":"云尽江空大火流，丹枫岸接白蘋洲。\n三漕溪上闻豺虎，七夕楼中望女牛。\n岂谓多才偏有恨，未曾为客不知秋。\n人生尽被风尘老，肯信閒居易白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁自如大司马 其一","author":"陈炅","text":"一出关门任是非，忽来萋菲动天威。\n当时共喜平台对，今日翻从大理归。\n本谓五年期雪耻，谁令六月见霜飞。\n长城万里今何在，闻道关山数被围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁自如大司马 其二","author":"陈炅","text":"男子当为天下奇，满朝交赞圣明知。\n己忘白马图家计，直抵黄龙誓自期。\n韩范在军胡胆落，苏张当国士心疑。\n千年幽恨还谁似，读罢金陀有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芷园张太史楼居寄赠 其一","author":"陈炅","text":"楼居百尺倚云危，隔断风烟碧海湄。\n风景不殊悲晋日，衣冠还似避秦时。\n玉堂金马三更梦，浙水闽山一局棋。\n国士未酬应有意，此身端不负伦彝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芷园张太史楼居寄赠 其二","author":"陈炅","text":"日落寒云惨不开，西山片石共崔嵬。\n当时尚有常山舌，此日宁无博浪椎。\n失马塞翁殊未定，卜龟詹尹亦难裁。\n千回万转思量遍，肯信英雄念已灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽苏宇霖阁部 其一","author":"陈炅","text":"间关西浙与东闽，身是云台第一人。\n已拥真人兴白水，更收群彦集平津。\n朱茑前道驱风伯，青雀西飞走海神。\n锡命已深惭未报，誓将长剑扫风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽苏宇霖阁部 其二","author":"陈炅","text":"亲承锁钥镇雄关，拟复中原济险艰。\n兴晋预陈淝水阵，覆吴思保会稽山。\n何期狼跋难回顾，遂至龙髯不可攀。\n入赣出闽今已矣，旌旗凄断故乡还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽苏宇霖阁部 其三","author":"陈炅","text":"两朝开济付飞灰，元老丹心合自裁。\n斥堠狼烟今已寂，都城鱼钥问谁开。\n鹰鹯饱食多飏去，桃李成阴枉笃培。\n瞻奉山陵在何处，空留抔土粤王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽苏宇霖阁部 其四","author":"陈炅","text":"血碧苌弘出九原，全忠全孝竟难言。\n千钟不逮高堂养，万死宁酬国士恩。\n世运兴亡原有数，功名成败岂须论。\n厓山祠屋长邻近，俎豆他年正气存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶兴","author":"陈万几","text":"萧萧铁骑捲潮来，百雉重城破竹开。\n结草竟虚龙驭去，乘轩空见鹤飞回。\n湘娥清泪啼斑竹，望帝芳魂委绿苔。\n独有崖山旧时月，凄凄还照越王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜张穆至","author":"陈万几","text":"朔风栗栗透絺衣，有客萧条坐钓矶。\n化鹤自怜城郭改，侩牛何事市尘非。\n东归有母空怀橘，西去无人问采薇。\n惆怅三噫歌欲罢，满天愁思雁鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过龟湖诗","author":"陈国英","text":"竭泽年来鱼□□，沧桑犹是古龟湖。\n浮沉往迹潮高下，去住冢□云有无。\n世乱未能终稼穑，士贫那肯废诗书。\n□时得睹修和理，鸡犬桑麻遍海隅。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇","author":"陈国英","text":"平生怀一剑，无异风胡削。\n琉璃吐莲花，江河精不涸。\n纵横运无前，截蛟如断藿。\n如何没埃尘，芒寒未磅礴。\n夜夜斗牛边，宝气尚腾焯。\n慎勿畀匪人，用之同刈获。\n以防君子身，千年光涵锷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中漫兴","author":"陈国英","text":"散发寻幽地，登山一放歌。\n采芳眠药圃，耽翠坐藤萝。\n愚谷风波少，顽仙慷慨多。\n非关徒适志，吾道在槃阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别署县吕明府二首 其一","author":"陈国英","text":"乍出葵阳道，骊歌声未休。\n山花恋去驾，梅雨送行舟。\n文治推单父，才名识太丘。\n明时方汲引，迟汝到皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别署县吕明府二首 其二","author":"陈国英","text":"宦况似飞鸥，云天任息游。\n饮泉不易志，对月几登楼。\n鳄海迹初散，罗浮梦欲留。\n独怜诸父老，携酒立沙头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮歌二首 其一","author":"陈国英","text":"朱崖翠壁满流霞，怪石穿松故老家。\n坐玩茏葱五色雀，令人忘想就丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮歌二首 其二","author":"陈国英","text":"锦绣峰随玉女峰，鸾箫仙佩响琮琮。\n相逢话指麻姑在，为饮琼苏酒一钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪参六祖赋得三十四韵","author":"陈国英","text":"不识朝华路，寻源一睇凝。\n香流溪口寂，云护宝林层。\n龙象胎真气，山河应圣兴。\n我师诞岭南，觉性自圆成。\n黄梅会七百，不羡六朝僧。\n一悟无相偈，衣钵遂亲承。\n逍遥爰自来，飘笠作萝藤。\n远□身藏猎，知机鸟避鹰。\n自解风幡义，演法道力胜。\n四山为坐具，兰若纷坡陵。\n佛树台阴古，潭心海气蒸。\n亚仙檀樾主，高原尚棱棱。\n功德天广大，诸魔静伏惩。\n果然下下者，别有上上能。\n说法龙降钵，卓锡地泉升。\n金刚永不坏，流璃一鉴澄。\n慈云荫下界，慧日无边明。\n击空波浪灭，一叶须弥凌。\n不立文字教，顿入最上乘。\n三车希解脱，四道證无生。\n天龙全依护，人鬼自凝丞。\n大千同普照，沙佛合齐登。\n譬如彼茎草，能为丈六腾。\n迦叶智无量，瞿昙骨崚嶒。\n古塔曾栖鹤，花龛萃百灵。\n琳宇耀金梵，宝幡绘吴绫。\n天乐时闻响，传灯续相仍。\n如如元无极，世法漫损增。\n五花终成果，今修得未曾。\n快瞻真面目，千年拳服膺。\n时代虽云隔，檀经信有徵。\n迷川怀彼岸，大路准金绳。\n兔角洵为幻，电光亦匪恒。\n待看野劫火，化作玉壶冰。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蜚遁篇","author":"林隽胄","text":"白日皖晚不见人，岛龟安藏龙戢鳞。\n有客湔衣江海垠，还来取适黄羲身。\n遂使岩薄万古尘，此兴不随沧桑泯。\n大文既舒烂以陈，中有奇光可结邻。\n白石之粲水粼粼，宛其无数流花湮。\n渔父棹卷恍知津，怅望江秋生江春。\n犹令人者传避汉，莫往莫来谁为真。\n日月自此揽青磷，道心文心两逡巡。\n噫嘻，道心文心两逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题紫阳朱夫子画像","author":"林隽胄","text":"尼山闻治世所宗，斯道经天行地同。\n岩岩邹峄闲先圣，由兹而降经尘封。\n大道为公不终秘，登堂仿佛闻丝桐。\n汉室诸侯抱残缺，未能阐发开愚蒙。\n周程张邵接踵起，维时文在天所钟。\n紫阳夫子毓关南，更知后起难为功。\n格致诚正八字张，微言大义无疑恫。\n当其投匦上书日，说书崇政达四聪。\n中遭谗邪道将废，未几天朗日昭融。\n历祀于今且数百，王鈇圣灯咸率从。\n瞻仰肃拜效赞叹，绘天赋海徒冥濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游潮阳白牛岩","author":"林隽胄","text":"梦魂久结此山间，秋晚山缘得未悭。\n松壑出云皆绿气，石岩生月共苍颜。\n天能磊砢安峰骨，我欲高歌动海澜。\n爱尔晨曦兼暮紫，可容袖满水声还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花前集杜","author":"林隽胄","text":"差见黄花无数新，正思戎马泪盈巾。\n且看欲尽花经眼，花底山蜂远趁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旧斋葺成二首 其一","author":"饶希燮","text":"烟霞吾道在，丘壑一枝安。\n暂用全身朴，惟存入世宽。\n衣将缝薜荔，书且赋台兰。\n好谢腾云侣，樵渔亦百端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旧斋葺成二首 其二","author":"饶希燮","text":"倦卧南窗下，长吟慰索居。\n门廉高士辙，架足道人书。\n藜藿陈家俭，耕桑乐岁馀。\n虽多泉石癖，我法带经锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜","author":"饶希燮","text":"仄路飘蓬久，优游叹陆沈。\n栖乌啼夜数，寒柝护更深。\n招隐全无术，分耕赖有心。\n平生祈远大，何用铸黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西僧","author":"饶希燮","text":"虬髯深目话波罗，问法徒惊竖指多。\n今日□台松柏映，岂看都应是天魔。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀旷园禅师","author":"黄鹤仙","text":"炎蒸方逐客，选胜寄行踪。\n好景题应遍，名峰住几重。\n云深徒忆雁，地迥恍闻钟。\n深怪罗浮蝶，终宵与梦逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自述","author":"黄鹤仙","text":"飘零何处曳长裾，短鬓星星霜雪馀。\n入世不须悲失马，出门何事叹无车。\n人非彭泽宁辞酒，学逊龙门漫著书。\n回首春明惊梦断，梅花几树已成庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦示诸孙","author":"黄鹤仙","text":"春风盈户雪盈头，日见趋庭得自由。\n杨震祇传清白后，李斯惟代子孙忧。\n到门莫喜题为凤，入世须防唤作牛。\n我有良田人不见，一经相继更何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽张家玉","author":"黄葵日","text":"天运靡常，帝道倾危。\n四海鼎沸，蹂躏东陲。\n谁哉守土，倒戈失旂。\n吁嗟哲人，陈抗六师。\n大厦将颓，只手难支。\n洒血战场，千古男儿。\n尔死有用，我生奚为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上和胡先生","author":"梁若衡","text":"萧瑟金飙动苇芦，那堪书剑半长途。\n天连浊浪浮三岛，目断虹桥带五湖。\n云白雁来人对酒，花开秋尽客思鲈。\n相逢莫漫嗟留滞，异地同声自不孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水送家大人之任北雍时十月之望 其一","author":"梁若衡","text":"岭树燕云此问津，朝来菱彩映江滨。\n澄清更为忧时急，湛露今承宠命新。\n虎观谈经环礼乐，彤墀鸣佩曳星辰。\n匆匆计日长安近，正喜银幡赐侍臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水送家大人之任北雍时十月之望 其二","author":"梁若衡","text":"萧瑟寒风万里程，问衣还苦别离情。\n藜灯自是家声旧，璧水如同宦况清。\n雪满新丰催去马，花明帝里喜迁莺。\n从容匕箸加餐饭，几度临风念远行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署西始辟草岸多植荪枝物外萧然清閒徐步援笔赏之","author":"梁若衡","text":"绿树浓阴护短墙，何妨枳棘借他乡。\n诛茆署后三春暖，剪綵庭前百和香。\n月浸楼台浑近水，烟寒橘柚欲肥霜。\n凭栏更对新蓂荚，自爱舒徐岁月长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅次","author":"梁若衡","text":"朔风吹雁断菰芦，楚水吴山问去途。\n十载烟霜馀梦寐，经秋书剑半江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答兄子观","author":"何乔松","text":"读尽千秋绿字书，小贤那比大贤如。\n北山蕙帐庸讥鹤，东海纶竿岂为鱼。\n道散诸家宗复振，文兴八代统宁孤。\n问奇予敢嗟迟暮，嬴得茅心日渐除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳题石","author":"严而舒","text":"香雾萦回蝶翅舒，西陵松柏未湮垆。\n铜台艳粉埋金锁，瑶水花宫疗玉鱼。\n螓首巫云伤冶鬓，蝇头唐韵想遗书。\n彩虹化后嫣香歇，曳雪谁留汉使车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]