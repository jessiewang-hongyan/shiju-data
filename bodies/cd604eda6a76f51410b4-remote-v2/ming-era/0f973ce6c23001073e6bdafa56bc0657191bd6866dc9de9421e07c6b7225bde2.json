[{"title":"赠月儿 其四","author":"张萱","text":"刺史空闻说断肠，胸前雪妒鬓边霜。\n心情忍作秋云薄，一任飞花自主张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其五","author":"张萱","text":"新腔休谱白头吟，一曲离筵恨转深。\n为报使君原有妇，相逢不是惜黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其六","author":"张萱","text":"红线如何别薛郎，座中谁是冷朝阳。\n魂销百尺楼头句，博得閒情闹一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其七","author":"张萱","text":"五两风轻日欲西，傍蓬拢鬓背人啼。\n共怜此别如飞絮，一着狂风便着泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其八","author":"张萱","text":"使君原亦有情痴，何事临岐咏柳枝。\n总为五湖秋色好，扁舟久已载西施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其九","author":"张萱","text":"一片柔情百首诗，关情多在恼人时。\n赠离惟有罗虬笔，不比红儿比月儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月儿 其十","author":"张萱","text":"悔将歌舞逐狂夫，来路曾同去路无。\n若上山头频眺望，春来休更采蘼芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题鸡鷘图 其一","author":"张萱","text":"肃肃鲜姿映碧梧，玄黄美色绣罗襦。\n好将敕令频频去，莫遣溪边有短狐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题鸡鷘图 其二","author":"张萱","text":"为语孤飞不用高，且随俦侣戏江皋。\n情知鹰隼多猜忌，何必翩翩锦羽毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题自写梅花赠曾元陟","author":"张萱","text":"楼头短笛日初勋，咽断江城片片云。\n几度幽怀怜独夜，半输林雪半输君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾元陟铿然亭宴集同陈用休韩伯举舍弟仲蔚分韵赋 其一","author":"张萱","text":"迢遥谁着旱龙鞭，曲槛疏棂落日前。\n醉看愧非王子侣，团圞空自赋铿然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾元陟铿然亭宴集同陈用休韩伯举舍弟仲蔚分韵赋 其二","author":"张萱","text":"醉羡琴心此更宜，挑鸾抵凤转情痴。\n清阴不让章台下，懒向他家说画眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾元陟铿然亭宴集同陈用休韩伯举舍弟仲蔚分韵赋 其三","author":"张萱","text":"春残金井辘轳寒，几树芭蕉倚醉看。\n日永亭间香一缕，临池初罢谱幽兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾元陟铿然亭宴集同陈用休韩伯举舍弟仲蔚分韵赋 其四","author":"张萱","text":"龙眼抽条竹长芽，德星初聚舞雩家。\n斗山任是饶清笔，犹向张颠问墨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"爱民诗教卷为张松陵父母作","author":"张萱","text":"万里南天忆远音，倚云长诵别时吟。\n欲知赤子车前意，尽是斑衣膝下心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友人招赏桂花 其一","author":"张萱","text":"西风吹折剪鹅黄，四出奇葩万斛香。\n更借西风频着力，莫教秋色过东墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友人招赏桂花 其二","author":"张萱","text":"香从云外月中裁，检点幽芳细细开。\n始信主人贪佞佛，却从金粟觅如来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友人招赏桂花 其三","author":"张萱","text":"开尊倚树共淹留，笑撚花枝醉未休。\n闻说王孙招未得，至今空负小山秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题周□□西园雅集卷 其一","author":"张萱","text":"记得西园画本真，公麟妙笔已传神。\n于今我亦西园主，却欠公麟十六人。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题周□□西园雅集卷 其二","author":"张萱","text":"儒雅风流满画图，琴书觞咏共相呼。\n不知此日东坡老，曾觅黄莲点眼无。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"试笔诗成呈诸君子园丁以玉兰岩桂二花来献复以二十八字分贻之","author":"张萱","text":"欲将花事竞芳辰，采得双花伴五辛。\n擎向华堂当綵胜，兰孙桂子日振振。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种竹 其一","author":"张萱","text":"碧玉周遭已万竿，补篱编槿护檀栾。\n直须移却门前影，留得前山入坐看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种竹 其二","author":"张萱","text":"疏中移密密移疏，欲取清光一抹过。\n好语旱龙鞭蚤着，春雷已奋莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种竹 其三","author":"张萱","text":"东墙移竹种西墙，珍重琅玕挂夕阳。\n种罢喜逢花底雨，春风应自长新篁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种竹 其四","author":"张萱","text":"擘得春苞宛似觓，旧泥新水酌稀稠。\n倘饶千亩年年绿，何必人呼万户侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移花 其一","author":"张萱","text":"雨意霏微日欲斜，轻雷唤醒一池蛙。\n园公睡起无它事，荷锸呼童急种花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移花 其二","author":"张萱","text":"分畦布畹喜成行，密密疏疏次第香。\n此日主人闻晋秩，新衔花国太平章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移花 其三","author":"张萱","text":"园公酌酒劝花神，花事勿忙亦苦辛。\n为语春风休督促，花开何必一时新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移花 其四","author":"张萱","text":"草本休随木本移，栏边急种向阳枝。\n移根莫剪前春叶，卫足留阴正此时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"肃客口号 其一","author":"张萱","text":"閒居学圃枕城隈，竹屋茅斋日日开。\n不用闭门防客到，爱閒能得几人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"肃客口号 其二","author":"张萱","text":"胜事幽怀日日新，往来无伴住无邻。\n园丁莫问客何姓，到此游人非俗人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"肃客口号 其三","author":"张萱","text":"懒来浪得绝交名，自笑交穷懒便成。\n若是子猷来看竹，何须园主礼相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"肃客口号 其四","author":"张萱","text":"花竹新栽费护持，来游莫折向阳枝。\n亦知转眼皆荒废，且让閒人乐一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其一 韩偓韵","author":"张萱","text":"空林秋色满柴关，何事园公独破颜。\n为趁晚凉脩竹下，一溪新月半衔山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其二 前人韵","author":"张萱","text":"柳岸凉生七月天，银梭玉尺弄溪烟。\n沙边网得林边煮，笑唤渔船作酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其三 长孙佐辅韵","author":"张萱","text":"园已趣成还日涉，西风又到梧桐叶。\n野老休言花事稀，栏前还有双双蝶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其四 薛能韵","author":"张萱","text":"诛茅剪棘即吾卢，买得邻畦带月锄。\n不为庾郎饱鲑菜，年来欲试橐驼书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其五 韦庄韵","author":"张萱","text":"扫地焚香读楚招，却惊风拂树头瓢。\n无端一笛沧浪里，又答行歌隔水樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其六 杜荀鹤韵","author":"张萱","text":"门堆桑叶网蛛丝，暂出呼童扫一时。\n数步即还仍却扫，孤踪犹恐隔邻知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其七 陆龟蒙韵","author":"张萱","text":"篱堤时筑亦时崩，野水曾侵竹几层。\n一任渔郎竹根宿，夜归犹得借渔灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其八 郑谷韵","author":"张萱","text":"镇日湖边一老翁，开襟常饱芰荷风。\n閒持藜杖频敲竹，为逐鸬鹚落照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其九 李商隐韵","author":"张萱","text":"田舍儿孙礼教稀，捕蝉探鷇闹柴扉。\n园丁忽报来禽熟，走向园公笑挽衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农圃渔樵十咏 其十 张演韵","author":"张萱","text":"新畦傍水芋苗肥，玉糁才羹客扣扉。\n且喜盘餐有兼味，樵青溪畔打渔归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王知白山人 其一","author":"张萱","text":"杖藜何事踏苍烟，为趁春风到水边。\n若遇芳菲须放步，莫教虚度艳阳天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王知白山人 其二","author":"张萱","text":"有意啼春花底鸟，无心出树岭头云。\n挂瓢植杖空山里，独对心香不用焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题自写古松障子 其一","author":"张萱","text":"不为梁栋不为薪，雪态霜姿老更真。\n可是世情嫌磥砢，年来长谢斧斤人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题自写古松障子 其二","author":"张萱","text":"皮乾顶秃复根龈，郁郁犹能护藓文。\n更喜虬柯独支撑，欲排阊阖竞拿云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题自写木石障子 其一","author":"张萱","text":"凋零何事伴荒墟，不向春风借一嘘。\n独有根盘老顽碧，数拳犹是补天馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题自写木石障子 其二","author":"张萱","text":"野旷天高白雁迟，清霜先到最高枝。\n自饶一种萧疏意，任你芳菲那得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上小堂戏题 其一","author":"张萱","text":"江上小堂无十亩，堂前老树有三株。\n主人原住清凉界，又得浓阴屋半区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上小堂戏题 其二","author":"张萱","text":"山色岂随时眼改，溪声留与老年听。\n朅来更有娱人处，日日风云不暂停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上小堂戏题 其三","author":"张萱","text":"临流影笑蒙头雪，倚树凉生露顶风。\n却恼儿童常戏浴，諠争偏聒老渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上小堂戏题 其四","author":"张萱","text":"东流水合西流水，后浪沙同前浪沙。\n为问空江垂钓者，一年几度浪飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题写生荔枝赠韩绪仲太史纳宠 其一","author":"张萱","text":"国色天香满玉堂，一枝谁荐茜罗囊。\n知君惟采秋前实，擘得星苞仔细尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题写生荔枝赠韩绪仲太史纳宠 其二","author":"张萱","text":"明珠数颗缬红霞，不入开元帝子家。\n闻说阿娇曾破笑，累累应作掌中誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其一","author":"张萱","text":"弦月初升玉漏微，箱牛辍轭织停机。\n莫言隔岁才相见，犹胜人间去不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其二","author":"张萱","text":"促夜频惊转斗杓，双星脉脉绛河遥。\n相逢最恨雕陵鹊，一岁填河止一宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其三","author":"张萱","text":"曝衣楼上拜深深，乞得蛛丝笑不禁。\n曲缀却同群小态，空怜一夜斗穿针。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其四","author":"张萱","text":"茶浆瓜果满中庭，喜见红光拥玉軿。\n稚子不知同乞巧，笑呼阿母数流萤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其五","author":"张萱","text":"迢迢银汉渡云鬟，秋冷龙梭喜暂閒。\n旧好孔嘉惟此夕，谁能送巧到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其六","author":"张萱","text":"天孙总为巧调梭，好合其如隔岁何。\n若问雨云朝暮事，东邻拙妇较偏多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其七","author":"张萱","text":"深更朗月渡奔龙，灵匹幽期岁岁同。\n久别乍逢休错过，多情珍重一宵中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词 其八","author":"张萱","text":"濒云水接月如梭，脉脉盈盈可若何。\n谁道银河深不极，妾愁深较倍银河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其一","author":"张萱","text":"春满罗浮四百峰，霞光长护玉芙蓉。\n寿星福曜中天丽，仙籍重标两鲍公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其二","author":"张萱","text":"凤历初开淑气新，昌期五百岳生申。\n十城共效华封祝，福寿如天万井春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其三","author":"张萱","text":"百福全寿正无涯，散作鹅城万树花。\n放鸽阶前何所献，一杯丰水九光霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其四","author":"张萱","text":"紫气嶙峋鳄渚边，况逢梅柳正争妍。\n延禧骈祉春长在，寿似冈陵福似川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其五","author":"张萱","text":"寿从海屋更添筹，百福骈繁锡禹畴。\n曾是玉皇香案吏，分城聊作汎莲游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其六","author":"张萱","text":"飙轮羽驾拥云璈，不数当年度索桃。\n福寿筵中歌一曲，天南春暖鹤飞高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其七","author":"张萱","text":"黄山练水毓精灵，勋业当朝满鼎铭。\n最羡象贤名相国，天申福寿自千龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其八","author":"张萱","text":"春王八日集群仙，南极星明傍紫璇。\n百福已全仍百寿，一尊齐祝鹤峰前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福寿图九咏代九邑令公寿鲍瞻鲁同府 其九","author":"张萱","text":"中和乐职乐难支，云锦同裁百寿诗。\n八洞仙真齐拜手，玉书今已下瑶池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题洒仙子五云双舄图 其一","author":"张萱","text":"有客空山坐翠微，长安回首思依依。\n年来远道多矰缴，为语双凫莫浪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题洒仙子五云双舄图 其二","author":"张萱","text":"浮云何事莽争徂，白日于今不可呼。\n共说寒鸦能带色，应怜天外有双凫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题洒仙子五云双舄图 其三","author":"张萱","text":"迟日春云覆玉墀，飞鸣争满上林枝。\n朝天纵有双双影，万里君门总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李晋衷广文北上春官以诗见别用来韵却赠 其一","author":"张萱","text":"片帆秋色尉它乡，破浪惊看万里航。\n到日长安花似锦，春风应逐马蹄忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李晋衷广文北上春官以诗见别用来韵却赠 其二","author":"张萱","text":"携得青毡换玉鞭，日烘香陌杏花然。\n看花正喜春光醉，莫忘侯芭载酒年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]