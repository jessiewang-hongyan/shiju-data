[{"title":"送贾中丞抚甘肃四首 其二","author":"卢龙云","text":"风高太白剑横霜，一曲凉州道路长。\n不羡虎头堪万里，直教旃酪颂天王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送贾中丞抚甘肃四首 其三","author":"卢龙云","text":"笳鼓城头月五更，边陲何日罢论兵。\n已闻胆落西羌戍，应是人传小范名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送贾中丞抚甘肃四首 其四","author":"卢龙云","text":"羽骑如林节制同，昆崙片石好铭功。\n远人亦自知文德，天马还令入汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮柬陈新之四首 其一","author":"卢龙云","text":"暮景萧森欲换年，宦情羁思两悠然。\n流光半逐红尘去，窃食能无愧俸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮柬陈新之四首 其二","author":"卢龙云","text":"玄英吹尽一冬阑，百里同君共岁寒。\n下榻几能过仲举，独传篇咏可人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮柬陈新之四首 其三","author":"卢龙云","text":"雪残东阁未多时，又与春光暗有期。\n谁遣阳春随白雪，歌来应是郢人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮柬陈新之四首 其四","author":"卢龙云","text":"光阴一度一年华，政暇平干早放衙。\n残腊送馀无一事，坐看春到万人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食","author":"卢龙云","text":"几回飞梦绕松楸，万叠云山紫翠浮。\n客里又逢寒食至，那能不动故乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后郊行","author":"卢龙云","text":"雨过黄鹂转翠林，芳郊云物半晴阴。\n行行忽听民间语，最喜骄阳渐化霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入京补谪奉老母暂居清源途中感述四首 其一","author":"卢龙云","text":"候馆萧森旅思频，西风其奈倚闾人。\n凭谁共对忘忧草，坐见秋容次第新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入京补谪奉老母暂居清源途中感述四首 其二","author":"卢龙云","text":"冲泥匹马笑重来，可道王阳驭未回。\n寸禄总非淹国士，北堂还待旅颜开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入京补谪奉老母暂居清源途中感述四首 其三","author":"卢龙云","text":"僻巷柴扃仅避喧，何知行乐有潘园。\n板舆未尽承欢意，菽水还应似里门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入京补谪奉老母暂居清源途中感述四首 其四","author":"卢龙云","text":"去年秋满赵王城，秋月重圆复旅行。\n一笑天边投杼事，几令华发望金茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发清源","author":"卢龙云","text":"北风吹马利如刀，何事尘途尽日劳。\n只为桑榆功未竟，片心仍逐五陵豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿武城","author":"卢龙云","text":"日暮停骖傍武城，牛刀无地不关情。\n通宵未听弦歌起，更问何人似灭明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"道中口占二首 其一","author":"卢龙云","text":"回首丛台愿已违，蹉跎薄宦愧雄飞。\n微名在世无轻重，直道逢人有是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"道中口占二首 其二","author":"卢龙云","text":"捧檄重来强为亲，风涛湖海怅无津。\n贞心自古悲怀璞，宦业由来似积薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日寓僧舍二首 其一","author":"卢龙云","text":"廿载王春又履端，蓬莱宫阙拥千官。\n谁知独客双林外，五夜遥听禁漏寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日寓僧舍二首 其二","author":"卢龙云","text":"东风入仗岁华新，万姓朝天拜舞频。\n借问春光回帝里，寂寥还亦到孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠相者杨生二首 其一","author":"卢龙云","text":"杨子谈经客屡过，自誇双眼阅人多。\n从教万态浮云改，骨相天然奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠相者杨生二首 其二","author":"卢龙云","text":"几载风尘混越吟，头颅不自卜升沉。\n看来肉眼皆皮相，喜尔逢人直见心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画竹","author":"卢龙云","text":"千亩何须胜渭川，此君风节在孤妍。\n每怜俗态消难尽，日日平安好为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画菜","author":"卢龙云","text":"风味长存士大夫，映畦新绿更堪娱。\n眼中百事只如此，且问民间色有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠山泉酒二首 其一","author":"卢龙云","text":"山泉祗道因茶胜，谁识尊中绿倍嘉。\n好倩老僧通水脉，百杯扶醉更烹茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠山泉酒二首 其二","author":"卢龙云","text":"爱酒徒劳暮酒泉，山灵还笑李青莲。\n典衣此味应难换，信是长安斗十千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"卢龙云","text":"三月莺花处处鲜，山居风物更幽妍。\n閒来结伴溪桥外，共坐厓头看瀑泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方延客而公出走笔缓之","author":"卢龙云","text":"相逢须放好怀开，已拟花前共举杯。\n束带又从尘里去，却邀明月待君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读王进士下第时所拟宫词六十首为赋四绝 其一","author":"卢龙云","text":"当春几度惜春残，此日深宫乐事宽。\n戏罢金钱随步辇，名花千树许同看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读王进士下第时所拟宫词六十首为赋四绝 其二","author":"卢龙云","text":"有诏新开避暑筵，清虚水殿纳凉偏。\n披襟尽解当年愠，引得南薰入舜弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读王进士下第时所拟宫词六十首为赋四绝 其三","author":"卢龙云","text":"凉月扬辉逗碧纱，从前幽恨托琵琶。\n今宵伴月看歌舞，翻笑姮娥独岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读王进士下第时所拟宫词六十首为赋四绝 其四","author":"卢龙云","text":"兽炭初红夜未阑，宫中行乐尚承欢。\n拥炉漫酌羊羔满，暗忆人间有岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱使君虚白室二首 其一","author":"卢龙云","text":"傍舍新营可数椽，一尊许我坐谈天。\n剑光入夜床头出，似有青藜烛汗编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱使君虚白室二首 其二","author":"卢龙云","text":"小斋如舫托深居，东壁文光逗绮疏。\n半点红尘飞不入，散衙堪自对清虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高唐王惠自斲桐琴汉宫瓦砚赋谢二首 其一","author":"卢龙云","text":"朱邸由来近峄阳，孤桐清越中宫商。\n绮罗乍识王门贵，珍重何如单父堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高唐王惠自斲桐琴汉宫瓦砚赋谢二首 其二","author":"卢龙云","text":"东阁摧残惜未央，谁知此日重文房。\n酂侯本自功高者，更得名留翰墨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏花","author":"卢龙云","text":"浅红轻绿媚春风，曾记曲江马上逢。\n回首十年成底事，一枝今在短墙东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祷雨有应侍老母小酌","author":"卢龙云","text":"二月不雨春事迟，忽看檐外雨飏丝。\n一杯解动慈颜豫，共喜民间有孑遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读朱大复海牢骚二首 其一","author":"卢龙云","text":"遵海东来访旧游，闻君移疾乞林丘。\n怪来伏枕偏能赋，七发何人释汝愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读朱大复海牢骚二首 其二","author":"卢龙云","text":"难将卑湿比长沙，三载栖迟倦忆家。\n君自楚材工九辨，卜居吾亦困天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画寄刘参知先生","author":"卢龙云","text":"解组归来岁屡迁，萧萧林屋对山泉。\n有人策马朝天去，竟日焚香手一编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱阳湖二首 其一","author":"卢龙云","text":"极目烟波接远天，王师曾此驻楼船。\n帆樯上下因风候，犹似扬澜大阅年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱阳湖二首 其二","author":"卢龙云","text":"挂帆飞指落星湾，四顾湖光荻苇间。\n王气千年应不散，紫云高处是匡山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马当山","author":"卢龙云","text":"丹厓翠壁俯沧江，指点舟人说马当。\n何事水灵私赋客，长风一夕送滕王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新凉二首 其一","author":"卢龙云","text":"乍见金飙下汉津，翛然爽气满庭新。\n不须避暑思河朔，渐有秋光照海滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新凉二首 其二","author":"卢龙云","text":"炎蒸历尽转秋时，一叶初飞天下知。\n昨夜微凉生枕簟，起来清兴入新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六平山二首 其一","author":"卢龙云","text":"层峦叠叠斗峥嵘，下见峻冈号六平。\n自是山灵嫌太横，祗应回伏护专城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六平山二首 其二","author":"卢龙云","text":"千仞谁能即振衣，迂回樵径傍斜晖。\n丹梯任尔凌云出，平步还应绕翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雨","author":"卢龙云","text":"细雨生凉入院庭，离离秋草照帘青。\n山容四面浑如洗，倚槛真看绕翠屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜渡马江二首 其一","author":"卢龙云","text":"一派长江接暮潮，半轮孤月出烟霄。\n江光月色兼天涌，有客中流独泛桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜渡马江二首 其二","author":"卢龙云","text":"冥冥江上几青山，烟水悠悠雁□湾。\n但使风波常不起，扁舟时向月中还。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三山城外桥边候潮二首 其一","author":"卢龙云","text":"懒向尘中屡折腰，登舟犹复待江潮。\n往来大陆长如水，亦自魂销似灞桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三山城外桥边候潮二首 其二","author":"卢龙云","text":"去住风尘不自由，迟回江上一扁舟。\n须臾月上潮初溢，少借轻帆任拍浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊","author":"卢龙云","text":"摇落西风感岁华，几枝彭泽径中花。\n餐英亦类东篱酌，羁客惭非处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀","author":"卢龙云","text":"山前木叶向人秋，屋外溪声带雨流。\n吹雁西风犹自急，听来偏动旅中愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居答友人远讯二首 其一","author":"卢龙云","text":"故人千里问加餐，三径何如蜀道难。\n耕食已能轻五斗，无心随伴索长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居答友人远讯二首 其二","author":"卢龙云","text":"揽镜初看鬓有霜，閒身偏恋水云乡。\n匡山莫讶归来早，万卷于今足草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行二首 其一","author":"卢龙云","text":"出郭柴车两度行，花厓竹涧总关情。\n山人却讶初相识，偏向儿童问姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行二首 其二","author":"卢龙云","text":"到处云林访洞天，空囊宁办买山钱。\n千畦并注溪流水，都是人家负郭田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得何明府京中书四首 其一","author":"卢龙云","text":"万里书邮未易传，偶因鸿翼到南天。\n嵇生懒嫚年逾甚，祗向山林结静缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得何明府京中书四首 其二","author":"卢龙云","text":"畿南何地不耕桑，水旱相仍入奏章。\n捧檄知君趋熟道，定多奇策慰壶浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得何明府京中书四首 其三","author":"卢龙云","text":"偃息衡门岁月过，更开一径在烟萝。\n八行已悟题书意，且向池亭葺芰荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得何明府京中书四首 其四","author":"卢龙云","text":"缁尘在在正西风，尊酒谈天强自雄。\n世上几人知傲吏，敢期姓字动山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客有索余酿秫斋酒者时未有以应也口占复之二首 其一","author":"卢龙云","text":"二载岩耕事秫田，秋成犹恨不逢年。\n瓮头春色俱无赖，比舍难教吏部眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客有索余酿秫斋酒者时未有以应也口占复之二首 其二","author":"卢龙云","text":"三径黄花伴逐臣，深樽还待白衣人。\n岂应竹叶长无分，到处垆头绿可亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其一 云洞藏春","author":"卢龙云","text":"背郭晴云绕洞门，依然飞盖旧西园。\n四时卉木皆春色，最可留人倒绿尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其二 山楼挹翠","author":"卢龙云","text":"结庐何事栖碧山，云林景物异尘寰。\n飞楼竟日浮空翠，独坐层轩意自閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其三 一区玄草","author":"卢龙云","text":"荜门蓬径隐烟霞，草就玄经自一家。\n载酒许人时问字，不知谁复似侯芭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其四 藕花池馆","author":"卢龙云","text":"别馆临池锦绣开，荷衣多在此中裁。\n凭阑绝爱清难染，避暑何妨数举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其五 绿野耕云","author":"卢龙云","text":"春来日上课农亭，满壑云含雨气青。\n东作易成耕犊健，居閒能诵兔园经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其六 三径琴尊","author":"卢龙云","text":"薜萝深径敞幽居，暇日琴尊亦自娱。\n时向竹间留二仲，岂缘日涉但篮舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其七 兰亭碧鉴","author":"卢龙云","text":"漠漠烟光汎蕙兰，更开一鉴水云宽。\n山阴故事堪修褉，千载风流此并看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其八 龙洞巢云","author":"卢龙云","text":"灵洞纡回有伏龙，郁葱云气日相从。\n他时更待为霖雨，八表沾濡泽自浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其九 泛湖钓舫","author":"卢龙云","text":"一片湖光滉漾寒，扁舟明月浸渔竿。\n磻溪事业应还在，不似羊裘祗自安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其十 晚泊溪云","author":"卢龙云","text":"鸥鸟忘机任泊浮，捲纶日暮此维舟。\n清溪坐对心如水，不定閒云亦共留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其十一 五湖烟景","author":"卢龙云","text":"烟波浩渺接平芜，天为何人豁五湖。\n此地由来争者少，苍生四海望难孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞景十二首 其十二 白云在望","author":"卢龙云","text":"浮云聚散本无期，一上高台入望思。\n何限停杯心里事，多因极目倚阑时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友人春游六首 其一","author":"卢龙云","text":"日南花木竞先春，自爱閒居岁月新。\n多少红尘随去马，相逢俱道看花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]