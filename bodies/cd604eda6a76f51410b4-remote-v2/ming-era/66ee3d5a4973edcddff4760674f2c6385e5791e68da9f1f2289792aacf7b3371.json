[{"title":"题乌蛮滩二首 其一 下滩","author":"邓云霄","text":"石啮旋涡急，舟惊下濑忙。\n危机缘斗捷，利涉是轻装。\n猿送三声泪，波随九转肠。\n纵然清见底，终不似沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题乌蛮滩二首 其二 上滩","author":"邓云霄","text":"水心元不竞，奔逼欲何之。\n浪挟毒龙斗，舟如退鹢迟。\n中流殊险恶，傍岸自平夷。\n百丈徐徐意，惟应拙宦知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重入朗宁署","author":"邓云霄","text":"署冷厌重游，新愁并旧愁。\n看梅今待腊，把菊昔悲秋。\n两篆官仍寄，三冬岁欲周。\n谁家调晚笛，偏倚夕阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月六日夏至彭贞元祁仲鱼陈永平集镜园赏荔时凶岁艰食","author":"邓云霄","text":"节过泛蒲后，堂开曲港滨。\n白鸥元狎客，丹荔似佳人。\n夏盛一阴长，年荒三径贫。\n宜乘晚潮至，击水贷波臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其一","author":"邓云霄","text":"久避城中地，新成浦外桥。\n荒郊来好客，归鹤下层霄。\n暑气随潮退，商风倩竹招。\n翛然幽事足，顿觉世尘遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其二","author":"邓云霄","text":"息荫火云净，雄潭秋水清。\n闲门惟待淮，求友尚闻莺。\n茗碗青浮乳，莼丝紫和羹。\n前堤共携手，偶伴野鸥行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其三","author":"邓云霄","text":"莲社叶心期，谈禅辨辟支。\n观空聊指月，照寂更窥池。\n发论鱼潜听，忘言石已知。\n悠悠对挥麈，云雾豁然披。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其四","author":"邓云霄","text":"句觅囊中锦，诗裁笔里花。\n但将声应钵，莫以足添蛇。\n一字推敲细，千秋事业赊。\n词坛今屈指，南北几名家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其五","author":"邓云霄","text":"于野同人处，寒塘一镜开。\n舟移剡曲棹，书忆陇头梅。\n已叹三秋别，那过七夕来。\n醉眠宜藉草，莫损石阶苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其六","author":"邓云霄","text":"潮来没古岸，雨过涨新泉。\n移席花为幄，侵鞋草似绵。\n壶觞馀种秫，风月不论钱。\n更有沧浪曲，渔歌起夕川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其七","author":"邓云霄","text":"谁能鲸吸海，亦有酒如池。\n乘兴还骑马，何妨倒接䍠。\n科头看醉态，拍手任群儿。\n言念昔人达，携壶荷锸随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其八","author":"邓云霄","text":"共识禽鱼乐，微闻菡萏香。\n池亭不受暑，水木自生凉。\n溪暗海烟接，林深雨气藏。\n数峰遥对酒，日暮转青苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其九","author":"邓云霄","text":"更领夕佳景，高台踏紫云。\n双龙占剑气，百里验星文。\n酌罢月初上，吟成夜正分。\n醉乡堪避世，时俗日纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子孟秋十九日西园公过访镜园步杜少陵游何将军山林十律韵投赠步元韵酬之同集者尹用平温尔惇时溪桥初成十首 其十","author":"邓云霄","text":"同声自求应，倡和有羊何。\n斗酒勿云薄，百篇奚足多。\n倾杯鱼渐醉，得句鸟先歌。\n愿扫矶头石，时邀彩鹢过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四老吟和周贵谔四首 其一 老将","author":"邓云霄","text":"百战清胡塞，廿年归汉关。\n乞身辞北阙，赐第傍南山。\n铁券勋名远，金丹日月闲。\n还闻奉朝请，剑履近龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四老吟和周贵谔四首 其二 老僧","author":"邓云霄","text":"庞眉耳到颐，剃发雪霏霏。\n面壁不知岁，栽松大几围。\n谈空三世事，传法六朝衣。\n振锡南天遍，西方只履归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四老吟和周贵谔四首 其三 老妓","author":"邓云霄","text":"荡子太无情，徒劳巧笑迎。\n容颜异今昔，门馆有虚盈。\n云雨迷前梦，琵琶理旧声。\n独怜卖赋客，还慕校书名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四老吟和周贵谔四首 其四 老农","author":"邓云霄","text":"作苦半生忙，劳劳鬓尽霜。\n倦勤百亩力，剩得几年粮。\n晚景桑榆末，闲身酒瓮旁。\n代耕孙辈事，策杖饭牛羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香淡斋对梅读何凝生寄怀诗赋酬","author":"邓云霄","text":"试索寒梅笑，闲窗独立时。\n花如平叔粉，人忆水曹诗。\n影动疑君到，书来慰梦思。\n赠章何以报，聊折陇头枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题大笑出门卷送李烟客三首 其一","author":"邓云霄","text":"我已卧游倦，君今始出门。\n遨游称上客，顾盼尽中原。\n然诺千金重，防身一剑存。\n阳关不下泪，任听峡边猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题大笑出门卷送李烟客三首 其二","author":"邓云霄","text":"俱是低眉者，谁为大笑人。\n才名同入洛，傲骨耻干秦。\n川陆征途远，湖山引兴新。\n片言堪赠璧，行矣岂长贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题大笑出门卷送李烟客三首 其三","author":"邓云霄","text":"四方男子事，儿女强牵衣。\n名岳行应遍，雄心去若飞。\n泛交投剌易，高调和人稀。\n揽胜兼怀古，奚囊满载归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日罗翊文携歌者镜园泛舟","author":"邓云霄","text":"银塘摇锦浪，泛泛木兰堂。\n酾酒鱼皆醉，听歌鸟亦狂。\n荔浓迎巧笑，莲艳妒新妆。\n夏日长如岁，沿洄乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟次日翊文复携四妓小演湛碧蓬时暑甚不雨来献负约不至末句戏嘲之二首 其一","author":"邓云霄","text":"可怜花解语，结伴得重陪。\n缓唱回风曲，徐传避暑杯。\n火云笼竹径，香汗湿桃腮。\n借问阳台女，曾携楚雨来？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟次日翊文复携四妓小演湛碧蓬时暑甚不雨来献负约不至末句戏嘲之二首 其二","author":"邓云霄","text":"三竿睡未足，四美又逢迎。\n风曳冰轮薄，歌□碧浪轻。\n登场试小演，掩袖转多情。\n避席者谁子？\n虚传惊座名。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏至日翊文携两小娃过镜园赏荔酌在藻轩得十四盐","author":"邓云霄","text":"荔林红若焰，莫助火云炎。\n岁觉一阴长，人逢二妙兼。\n腰纤摇弱柳，歌细逗疏帘。\n何物能消暑，盘中绛雪甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纪异诗","author":"邓云霄","text":"沉醉欲无醒，悲歌只自听。\n弥天开火宅，半夜斗妖星。\n梗稻空南亩，烽烟满北庭。\n群仙方濯足，且莫竭沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬二尹瞿尔锡父母过访镜园留题","author":"邓云霄","text":"散衙生野兴，飞盖出芳郊。\n偶载词人笔，留题逋客巢。\n水云溪畔舫，鸡黍竹间庖。\n不厌闲门冷，知君爱淡交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集海珠寺","author":"邓云霄","text":"万道金光涌蕊宫，诸天色界坐来空。\n闲从赤水嬉游里，拾得玄珠罔象中。\n八月灵槎天路近，三山仙峤海门通。\n吹笙不待骑羊子，此夜泠泠已御风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮二首 其一","author":"邓云霄","text":"万里罡风吹鹖冠，扶桑碣石倚筇看。\n乾坤一指浮空界，日月双珠在晓盘。\n雨过黄龙初返洞，烟销玉女静临坛。\n寻真丹灶行应得，未信刀圭不羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮二首 其二","author":"邓云霄","text":"朱明岩壑洞天遥，楼结青霞傍斗杓。\n呼吸可能通帝座，啸歌犹听和鸾箫。\n上清缥缈无今古，下界苍茫自暮朝。\n不用登高誇作赋，游仙须奏白云谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨妃春睡图","author":"邓云霄","text":"脉脉芳心倚洞房，娇姿无力罢霓裳。\n枕欹寒玉秋波迥，钗堕明瑶春恨长。\n化蝶香魂迷上苑，行云仙佩绕高唐。\n落红万点愁如许，谁送东风醉海棠？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛海二首 其一","author":"邓云霄","text":"谢傅轻舟兴渺茫，图南人挟大鹏翔。\n六鳌自涌三山动，四渎终输百谷王。\n且慢回帆归小虎，直将散发到扶桑。\n鸣榔一笑人间事，驱石何因解作梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛海二首 其二","author":"邓云霄","text":"落魄高阳一酒徒，几年清梦寄江湖。\n观涛秋壮枚乘笔，击楫风传海若呼。\n遥礼东皇基北斗，更窥鲛室采骊珠。\n蓬莱山下国清浅，问讯麻姑近到无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云山寺","author":"邓云霄","text":"白云高锁上方幽，有客乘秋赋胜游。\n石涧菖蒲人不识，安期黄鹤自深愁。\n台隍远近分夷夏，宫殿依稀逼女牛。\n东望罗浮顾沧海，粤王灵气未全收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"结茅石湖山中","author":"邓云霄","text":"岂为逃名遂陆沉，闲情原不借云林。\n畏人渐觉蓬蒿长，舒啸时闻鸾凤音。\n古洞夜寒占剑气，空山春静适琴心。\n齐盟此道还吾辈，和得新诗细细吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山东坡祠","author":"邓云霄","text":"烟笼蜃气晓霏微，竹色波光碧四围。\n冕服三朝留直骨，文章千载握灵玑。\n箫声月下成今古，鹤梦人间有是非。\n前世德云谁更问，怀仙孤屿憺忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登新安城楼时有边报","author":"邓云霄","text":"醉倚层楼发浩歌，忧时孤愤意如何？\n奔涛动地鲸鲵斗，毒雾笼城瘴疠多。\n望支朔方多锁钥，愁多炎塞有干戈。\n书生谈剑真迂拙，横海何年起伏波？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五层楼秋望","author":"邓云霄","text":"岭外天空人泬㵳，层楼登眺倚璇霄。\n关河又报风霜急，城郭空嗟世代遥。\n谁把长绳牵落日？\n欲将强弩射回潮。\n秋怀直寄蓬山远，玄鹤东归未易招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠二陈兄弟二首 其一","author":"邓云霄","text":"风雅谁云此道难，齐盟天地尔登坛。\n百年共梦文通笔，千里同弹贡禹冠。\n望去青云推骏逸，飞来白雪动秋寒。\n先朝北斗声华在，人拟玄成旧业看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠二陈兄弟二首 其二","author":"邓云霄","text":"人入芝兰味自芬，翱翔偏得凤毛群。\n风流已羡淮王妙，江左犹传小陆文。\n玉树双标依丽日，金茎并秀擢丛云。\n酒酣共倚青萍看，星聚遥占百粤分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊崖","author":"邓云霄","text":"弹剑崖门赋大招，伤心指点问前朝。\n胶舟云暗昭王魄，鸱革风驱伍子潮。\n半夜星辰归海岛，千年肝胆照烟霄。\n可怜秦玺龙宫得，长使鲛人泪满绡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石门晚眺","author":"邓云霄","text":"石门斜日片帆扬，北望关河思渺茫。\n人过贪泉须戒饮，舟回前浦尚闻香。\n鸣榔秋月千山静，说剑雄风万里长。\n渔父沧浪如有问，汀兰早晚正芬芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒韩泷昌黎庙","author":"邓云霄","text":"梵宫处处摇金碧，韩庙犹瞻泷水旁。\n南去潮阳沧海远，西来衡岳楚天长。\n文澜倒峡常风雨，直气高峰自雪霜。\n日晚停舟荐蘋藻，犹怜浊世满秕糠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘流思亲","author":"邓云霄","text":"天南天北两冥冥，落木萧萧迸泪零。\n弟妹几人谁问寝，关山何日复趋庭？\n白蘋海国牵归梦，红树湘江送去舲。\n水碧沙明千万里，断鸿哀怨不堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独夜","author":"邓云霄","text":"锦纹书隔楚云长，岁暮怀归鬓欲霜。\n别后容华惊逝水，病中雨雪忆连床。\n人于梅国留王粲，谁向菱花怨太常。\n彻夜越吟聊假寐，西风吹梦过潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮生","author":"邓云霄","text":"浮生一掷惊虚度，听鸟临风怆岁华。\n壮士虽贫犹有舌，丈夫何事叹无家。\n日临仙掌寒先退，春到人间树自花。\n试向斗牛占瑞气，龙光终夜散红霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郴州义帝陵","author":"邓云霄","text":"王气摧残骨已收，千年遗迹落荒邱。\n林间似走秦时鹿，树杪如啼楚国猴。\n伏剑江中魂渺渺，听歌垓下夜悠悠。\n汉家陵阙今何在？\n往事伤心任水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扬子江夜泊逢友人自边回谈塞上事","author":"邓云霄","text":"仗剑从军侠骨横，相逢凄恻十年情。\n醉来杨子潮头月，肠断蓬婆雪外城。\n汉将射雕吹晓角，胡儿牧马起边声。\n闻君话尽沙场苦，一夜西风白发生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵即事","author":"邓云霄","text":"桥上吹箫澹月华，隋堤新柳半藏鸦。\n佳人尽拥青鸾佩，豪客争归碧玉家。\n事往迷楼伤翠辇，时移幽观落琼花。\n愁闻古渡歌声急，夜夜涛来滚白沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮南怀古","author":"邓云霄","text":"城外河流啮石根，客心涛浪夜同翻。\n少年尚集淮阴市，罢钓谁过漂母门？\n云去八公留马迹，风惊孤鹤唳淝源。\n论兵更欲征仙事，地远难招自古魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署蔷薇为林明府赋","author":"邓云霄","text":"河阳仙令花为县，七宝栏中贮国香。\n翡翠迎风摇绿袖，珊瑚临水映红妆。\n尊前锦瑟催花语，帘外游丝惹蝶狂。\n明月白云长自好，东山歌舞旧成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下邳怀子房","author":"邓云霄","text":"圯桥流水夜潺潺，黄石西归竟不还。\n往籍已闻随虐焰，异书何意出人间。\n蛇分鹿静宁留犬，鸟尽弓藏合闭关。\n可怪紫芝诸父老，庞眉携杖下商山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭城书怀","author":"邓云霄","text":"堤畔奔涛走吕梁，城南墟落莽苍苍。\n黄河近报千家哭，赤帝曾经百战场。\n日月浮生谁寿夭？\n兴亡人世几沧桑。\n试人沛里寻遗老，彭祖坟边半夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕子楼","author":"邓云霄","text":"双燕楼中羽翼乖，百年欢笑竟难谐。\n萦回旧恨缠红缕，零落新妆断玉钗。\n无复行云归独寝，空馀明月照幽怀。\n可怜曲罢梁尘歇，春雨泥融草满阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏马台","author":"邓云霄","text":"盖世当年气有无，霸王遗事见平芜。\n听歌帐底美人尽，戏马台前落日孤。\n瓦碎空墙喧鸟雀，草深荒砌任樵苏。\n更看硭砀云烟净，叹息英雄与世徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中同侄珣轰饮","author":"邓云霄","text":"大阮欢呼小阮狂，一尊啸入楚云长。\n共翻玉液擎鹦鹉，欲就胡姬典鹔鹴。\n天地光阴同过客，风尘歧路总亡羊。\n高歌取醉元吾事，曲垒糟邱是故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄塘江上逢立春寄同社诸子","author":"邓云霄","text":"有客伤春感慨多，裁诗江上寄羊何。\n怀人一夜生芳草，叹世千川怨逝波。\n去住厌随都市卜，风云须借鲁阳戈。\n长安衣马花如锦，莫向春江制芰荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度大庾岭二首 其一","author":"邓云霄","text":"叱驭层峦冒险行，瘴烟回合旅魂惊。\n山盘鸟道无三蜀，路凿羊肠亦五丁。\n古庙风悲唐相树，荒屯月冷汉家营。\n故乡东望频回首，恨逐飞云片片生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度大庾岭二首 其二","author":"邓云霄","text":"洞壑萦回涧道幽，天开雄镇巩神州。\n分流楚粤中崖坼，异代兴衰入望愁。\n试向关门占紫气，谁从仙吏识青牛？\n息肩亭上人如许，来往风尘自白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石谪仙楼","author":"邓云霄","text":"采石明霞带晚晴，维舟登眺古今情。\n客从白月窥金粟，人踏青莲上玉京。\n鲸背宫袍馀锦浪，鸭头寒酒泻江清。\n谪仙前后身俱幻，啸倚楼头进百觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵怀古","author":"邓云霄","text":"玉树徒伤野草腓，梁台陈苑眼中稀。\n遗风六代繁华尽，王气千年历数归。\n寂寞园陵龙去远，逶迤城郭燕来飞。\n宫门下马频回首，万里孤臣泪满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登岱","author":"邓云霄","text":"罡风千仞跨茅龙，日观遥临第一峰。\n汉禅已亡司马草，秦碑空覆大夫松。\n低看四岳为诸弟，高揖须弥作大宗。\n眼底谁云小天下，华夷瀛海尽尧封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]