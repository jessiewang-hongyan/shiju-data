[{"title":"游土山寺用前韵","author":"吴俨","text":"倦向双林欲解衣，入门何暇问禅机。\n叉鱼稚子持竿去，卖药山僧负米归。\n松径月明樵唱远，竹林风细磬声微。\n归来舆皂心偏急，遥望重门步若飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮魏国园亭","author":"吴俨","text":"台榭秋深百卉空，空庭惟有雁来红。\n曲池暗接秦淮北，小径遥连魏阙东。\n富贵岂争金谷胜，文章不与建安同。\n上公亭馆无多地，犹有前人朴素风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恽宪副书约春尽会龙江驿","author":"吴俨","text":"送客时登黄鹤楼，江波日日向东流。\n诗人谩道眼前景，老叟空怀身外忧。\n鹦鹉洲边春草细，凤凰山下暮云收。\n故人旌节闻东下，借问何时到石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙卯季冬见白发效乐天体三首 其一 喜白发","author":"吴俨","text":"白发新生岂少恩，天教小子渐称尊。\n一茎便作千茎种，四十将开八十门。\n拔去自家难讳老，染来何物可除根。\n后生切莫轻前辈，日月随君万马奔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙卯季冬见白发效乐天体三首 其二 问白发","author":"吴俨","text":"晓来对雪常梳发，镜里何缘得上头。\n岂为作诗真太苦，或因谋国有深忧。\n官叨七品谁言贵，年过三旬未识愁。\n莫是家庭元有种，人言今日可凭不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙卯季冬见白发效乐天体三首 其三 止白发","author":"吴俨","text":"人生大率百年期，四十宁当发白时。\n秪许头颅留少雪，可容髭发尽成丝。\n恒言未敢先称老，壮志安能便服衰。\n春笋秋禾今已悟，东坡两语是吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕景鸣饷酒戏作小诗奉谢","author":"吴俨","text":"一诗换得两瓶罂，文字年来价渐轻。\n润笔不知金石例，危词长恐鬼神惊。\n岁除狂态还依旧，老去浮名敢浪争。\n明日衣冠随万国，山呼不尽小臣情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14560,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元旦醉后与景鸣引之联句戏柬国贤","author":"吴俨","text":"醉边倔强妄称兄，醒后心降气亦平。\n藏鹿隍中真是梦，伏尸蜗角竟何兵。\n棋能不著为长胜，辩到忘言更有情。\n忽忆木鸡因有得，独输全德与邻生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14561,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"景鸣和章欲任痴名予不敢许复次前韵","author":"吴俨","text":"低头真合拜吾兄，兄自无言意亦平。\n地让一头明退舍，战曾三北敢称兵。\n亡誇为有予真妄，智欲成愚子不情。\n掷笔据梧聊假寐，令人千载忆庄生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14562,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送马学士","author":"吴俨","text":"人间何处是蓬瀛，翰苑相传近玉清。\n苍藓阶除春雨合，绿槐庭院午风轻。\n安眠竟夕无宣诏，读史随人有品评。\n今日长卿仍姓马，又因消渴暂南行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14563,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送西宁兵备潘以正","author":"吴俨","text":"五月霜风卷旆旌，六蕃相率道傍迎。\n只今塞外无烽火，空负胸中有甲兵。\n校猎平原秋草碧，投壶客舍夜灯明。\n谁知缓带轻裘者，自是官家万里城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王世赏云南提学","author":"吴俨","text":"归向沧洲近十春，始持宪节出风尘。\n干将可合埋藏久，薏苡何妨谤语频。\n绝塞竞看金马客，雄词惊倒碧鸡神。\n他年宣室虚前席，应为苍生访旧臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宝应湖阻风","author":"吴俨","text":"琉璃城阙水晶宫，玉局仙人到此中。\n便觉鼋鼍忙徙窟，不妨波浪直翻空。\n隔溪茅店鸡声早，千里家山月色同。\n明日樯乌幸无恙，莫教深怨石尤风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送充道乃兄某南归","author":"吴俨","text":"友于一见即成别，不欲缁尘上素衣。\n霜信似催鸿雁去，月明如送鹡鸰归。\n官河冰合来时路，江渚烟迷旧钓矶。\n又恐移文先有在，不容重采北山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽周月窗医者","author":"吴俨","text":"南来北去任天真，到处逢人论谷神。\n医不专门兼老少，药无定法有君臣。\n读书窗小能留月，种术堂虚尚贮春。\n愧我独无迁史笔，仓公传后续斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和西涯先生拟卜居宜兴韵三首 其一","author":"吴俨","text":"画船曾泊旧城阴，綵笔亲题汉上襟。\n梦卜敢忘明主意，登临不负壮年心。\n幽并客向沙尘老，湘汉人愁草木深。\n阳羡溪山真不恶，即今坡老是知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和西涯先生拟卜居宜兴韵三首 其二","author":"吴俨","text":"一雨商岩万里阴，清时亟欲解尘襟。\n田园有兴成前约，杖屦相从是夙心。\n玉在铜官山益润，珠藏罨画水增深。\n古来风土同荆楚，不用咻咻学语音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和西涯先生拟卜居宜兴韵三首 其三","author":"吴俨","text":"莫为槎头忆汉阴，长桥南下可开襟。\n采芝试听山人曲，伐木应知长者心。\n江夏米无阳羡好，巨区水似洞庭深。\n勿言少贱无知己，草泽中间有赏音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用前韵戏柬徵伯","author":"吴俨","text":"五云溪傍太湖阴，不藉三江远作襟。\n谁说市朝成大隐，要知父子本同心。\n石能攻玉皆为砺，水可容舠即是深。\n何事卜邻无一语，疑君未欲听南音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用卜居韵邀国贤赏雪","author":"吴俨","text":"密云千里夜同阴，有客相邀话素襟。\n凝结固知由地力，丰登谁识是天心。\n纸窗外借三分白，瓦陇中铺一尺深。\n五鼎待君同下箸，莫劳终日听车音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西涯宅观梅花","author":"吴俨","text":"东风聊借一枝春，特慰巡檐索笑人。\n花比去年香不改，诗从今日思尤新。\n旧传傅老能调鼎，近许逋仙为卜邻。\n忽忆故园千树雪，无由独步大江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次敬所少宰赠傅北潭韵","author":"吴俨","text":"重重烟树数家村，王事何须与客论。\n老鹤风前声更远，孤松雪后色长存。\n万言不尽明公意，一饭难忘圣主恩。\n今日鸡泉东咫尺，草亭聊尔寄乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张亚卿进万寿表分得秋字","author":"吴俨","text":"一尊酒饯小瀛洲，明日神京拜冕旒。\n云为从龙归北去，水因朝海向东流。\n清风到处迎仙旆，好雨随时送客舟。\n万口山呼意难尽，独将金镜续千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游天竺","author":"吴俨","text":"佛国谁闻有此山，幽深彷佛类商颜。\n鸟归故道如相引，云起前岑自不閒。\n月落钟鸣僧入定，风吹酒醒客忘还。\n峰头何处飞来石，长锁松筠第一关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"臂痛渐愈次张东海韵","author":"吴俨","text":"三时臂痛一时瘳，冠帻依然又上头。\n病脱偶逢医国手，功成全藉醉乡侯。\n钟山高处凭栏望，淮水东偏载月游。\n酒思诗情浑不减，临池兴复似前不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏筑雪假山次韵","author":"吴俨","text":"风驱滕六似哀号，为恨侬家辇筑劳。\n转日可无双岫在，碍云真有一峰高。\n经营意匠输天巧，掩映诗斑上鬓毛。\n西蜀雪山谁是假，同归沧海作春涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送龙致仁主政管闸","author":"吴俨","text":"伯高何但省郎才，为有诗名水部来。\n官驿算无千里远，斗门日放几回开。\n深春尚拥蓝关雪，未蛰先惊夏泽雷。\n莫为苦吟留过客，舟行到此已心灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诸公以丝瓜诗韵险复赋一首","author":"吴俨","text":"不向东陵学种瓜，偶携一本自邻家。\n苞中未见青丝缕，架上先看满眼花。\n双实交加垂晓露，数茎蟠结挂秋蛇。\n天寒百卉凋零后，老蔓青青更茁芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次杭方伯寿日韵","author":"吴俨","text":"梅花长自占先春，一度相看一度新。\n投绂正当垂老日，归家犹是未閒身。\n雪晴风煖笙歌细，弟劝兄酬礼数频。\n试问尊前称寿者，几人谷日是生辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"世卿诵斗草联句戏次其韵","author":"吴俨","text":"懒向东风看落花，筠笼摘草戏相誇。\n欲寻指佞兼醒醉，直造山巅与水涯。\n色弄青红根可辨，味分甘苦性应差。\n莫因今日儿童戏，便作神农注疏家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示园丁","author":"吴俨","text":"为我先营养老资，青青双鬓欲成丝。\n赏花壮日心犹在，抱瓮当年力已衰。\n园小不宜遗地力，春深切勿后天时。\n绿阴如幄花如锦，应共佳宾醉玉卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿伯舅谦斋翁","author":"吴俨","text":"甘雨和风遍域中，太山乔岳可论功。\n人思识面多瞻仰，天本无言自感通。\n清净宛如曹相国，纯诚全类富韩公。\n我于元舅无他祝，鹤发年年侍九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾士廉编修父还松江","author":"吴俨","text":"北来南去几多时，怕见缁尘上素衣。\n斜日城阴千里别，秋风江上一帆归。\n鲈肥不用思张翰，鹤唳谁将吊陆机。\n莫怪冠裳苦缠缚，封章早晚到岩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄师惟明","author":"吴俨","text":"白昼迟迟玉漏沈，北窗清兴在孤吟。\n半生未试屠龙技，三刖无惭献璞心。\n自有文章齐白璧，不须籯橐贮黄金。\n缄书为托南飞雁，一入青冥思转深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郭大尹鲁瞻","author":"吴俨","text":"山阴未久又朝歌，南北民风竟若何。\n围带减缘勤抚字，闾阎静为缓催科。\n棠梨花外双凫下，杨柳阴中匹马过。\n到处喜迎贤令尹，儿童妇女笑声多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿杨方正乃翁","author":"吴俨","text":"笑傲乾坤八十年，垂垂白发映朱颜。\n高情已在羲皇上，遗爱犹存召杜间。\n清白传来知有子，利名看破觉无关。\n长生要诀谁能识，浪说神仙炼九还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和白秉德寺中斋宿韵二首 其一","author":"吴俨","text":"萧寺凄凉月色寒，雪消将尽尚留残。\n自嗔岁月忙中过，暂借楞严静里看。\n同舍谩劳虚左席，上方谁许建骚坛。\n明朝又入承明直，依旧含香更握兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和白秉德寺中斋宿韵二首 其二","author":"吴俨","text":"斋阁东西各一方，燔柴同见烛天光。\n南郊本为苍生祷，东作先祈百谷穰。\n随世功名成潦倒，应人文字恨劻勷。\n洛阳尽是红尘地，不信香山独不忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仁仲斋居和章盛誇僧寺之美复用前韵戏之","author":"吴俨","text":"铁衣自惯雪山寒，笑杀诗人觅懒残。\n梵语本空何足听，天花虽好有谁看。\n北门不信斋无室，西域徒闻戒有坛。\n邪正分明如黑白，鲍鱼莫误作芝兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郧阳太守胡天叙","author":"吴俨","text":"昔日曾过旧草堂，喜闻高论夜联床。\n东曹初受司徒荐，南国新分太守章。\n地控三方连陇蜀，水流百折到荆襄。\n中间待哺知多少，安得人人粟一囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄堵邦宁","author":"吴俨","text":"碧梧翠竹水云乡，中有幽人行最方。\n洗耳不教闻理乱，逢人秪自说耕桑。\n春来秉笔修茶谱，花发随时具酒觞。\n天与清閒浑不识，登临犹恨一身忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄任十","author":"吴俨","text":"而翁与我是忘年，我忆而翁愿尔贤。\n孝似曾参宁过分，弟如王览亦当然。\n夜深灯火宜勤学，雨足郊原好种田。\n勿逐少年游侠伴，斗鸡走马县门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次国贤韵送浃侄","author":"吴俨","text":"城东水竹有新居，尽是前人手泽馀。\n群从中间惟汝长，百年谱牒至今虚。\n北来暂假朝天梦，南去还看种树书。\n行役到家应自乐，风波渺渺更愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿德辉母某太夫人","author":"吴俨","text":"近时王母定何居，不在瑶池在帝都。\n阶下行厨麟作脯，曲中新谱凤将雏。\n红颜不假榴花映，健步何须竹杖扶。\n爱日恩光天假贷，青官辍讲助欢娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽吴汝砺","author":"吴俨","text":"生为同姓客为邻，每爱交游我独真。\n字法近从山谷变，诗才惟许宛陵亲。\n身尝百药犹多病，家累千金尚似贫。\n后日书香知未断，婴儿风骨已惊人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次守溪少宰夜饮韵","author":"吴俨","text":"妙句曾题邴曼容，至今什袭未开封。\n袖中怀刺羞频谒，马上趋朝喜暂逢。\n仕宦心轻今更懒，登临兴在老尤浓。\n洞庭湖水东山路，杖屦何时得远从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏伯诚由江西改四川提学马上作","author":"吴俨","text":"长空雪霁朔风号，送客方知去客劳。\n蜀道莫言今日易，庐山还似旧时高。\n玺书新换增光彩，旌节长悬脱羽毛。\n试看青襟谁最好，笔头滚滚带春涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邦彦第四和章不至复用韵促之","author":"吴俨","text":"诗人不厌六虫号，奴厌诗筒入递劳。\n东野久知韩子富，老坡独数柳州高。\n任教勍敌轻鸡肋，却喜寒林得凤毛。\n冻砚频烘玄浪涌，小奚误指作溪涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次仲实咏雪","author":"吴俨","text":"六花莫认作飞霜，疋练谁家有许长。\n当午渐疏知避日，迎风不下欲循墙。\n太平有意先呈瑞，轻薄何须更学狂。\n莫与梅花较优劣，纵多一出已输香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送伍朝信省祖","author":"吴俨","text":"记得嬉游大父前，分甘膝上是何年。\n朗陵老去思荀彧，灵运归来拜谢玄。\n新制綵衣初试舞，旧骑竹马尚依然。\n碧桃花下称觞处，更祝灵椿寿八千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽章恭毅公","author":"吴俨","text":"回天力仗一封书，震地雷霆我自如。\n海内疮痍何日起，胸中孤愤几时摅。\n狄公直谏安唐室，商皓危言定汉储。\n惭愧后公三十载，无由一束致生刍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小茅山书屋","author":"吴俨","text":"小结茅山屋数椽，藏书却笑米家船。\n长檐不解荫歌舞，净几偏宜阁简编。\n蝌蚪影涵春雪里，伊吾声落晚风前。\n遥看翠竹苍松外，时有虹光夜烛天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽周尚书","author":"吴俨","text":"入官已不为身谋，壮岁声名动冕旒。\n执法坚如于定国，活民多似富青州。\n官居廊庙无遗恨，老去江湖有远忧。\n试问近来诸老宿，立朝还有此公不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邓生下第","author":"吴俨","text":"壮岁才名已不羁，儒冠误子亦多时。\n从知照乘珠难售，方信千钧弩独迟。\n夜雨青灯愁客梦，秋风泽国动乡思。\n何年挟策重来此，折取蟾宫第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送段惟勤宰新城","author":"吴俨","text":"龚黄卓鲁是何人，千载令人仰后尘。\n宁拙催科书下考，莫由捷径问通津。\n公门似水谁嫌简，马骨如山始信贫。\n三尺待君来执法，触邪还见廌冠新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿大理陈少卿母九十","author":"吴俨","text":"不在山间与水边，女中亦自有神仙。\n种桃直待三千岁，屈指才过九十年。\n嫁日旧衣何太窄，满头黑发尚依然。\n白云似解贤郎意，片片飞来棘寺前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽欧时举次苏伯诚韵 其一","author":"吴俨","text":"白发瀛洲第一仙，王堂閒暇日如年。\n文兴六一将衰后，易究乾坤未画前。\n武帝不知颜驷老，汉廷偏让贾生贤。\n可怜才大终难用，禄薄无由满二千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽欧时举次苏伯诚韵 其二","author":"吴俨","text":"少年不作探花郎，老去功名心更忙。\n白发穷愁多夜雨，青云得隽已斜阳。\n殿前同对三千字，门下谁持一瓣香。\n丹旐飞飞归旧路，旅魂彷佛记吾常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送南京张学士先生","author":"吴俨","text":"东白文章旧有声，金縢国史诰初成。\n南都命下新承宠，九月秋高始启行。\n铃索不愁深夜警，官衔犹带北门清。\n石头城外秦淮口，一片轻帆挂月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿程宗鲁父母","author":"吴俨","text":"湘流曲折绕长沙，百岁岩高石径斜。\n深静初疑王母宅，幽閒又道葛洪家。\n阶前袖手调青鸟，花下浮觞泛紫霞。\n回首綵衣千里外，楚山时被白云遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送守溪乃兄世隐东归","author":"吴俨","text":"难弟归来兄亦归，高堂齐著老莱衣。\n洞庭金橘霜前熟，笠泽银鱼雨后肥。\n伐木有声来户牖，采薪无伴扣岩扉。\n山边水次逢人语，莫道长安是与非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送体斋先生省祭","author":"吴俨","text":"学士归来扫墓田，天风特为舞松杉。\n盐梅久待调商鼎，版筑犹思在傅岩。\n墓左丰碑仍旧额，祠中木主换新衔。\n碧山不是流连地，颙望春江挂锦帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送聚上人还普应寺","author":"吴俨","text":"铃语遥遥紫翠间，分明为报远公还。\n龙施法雨迎新檄，雪作天花散旧山。\n净土未归飞锡远，清淮初渡木杯閒。\n从今高卧双松底，便是渊明懒出关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]