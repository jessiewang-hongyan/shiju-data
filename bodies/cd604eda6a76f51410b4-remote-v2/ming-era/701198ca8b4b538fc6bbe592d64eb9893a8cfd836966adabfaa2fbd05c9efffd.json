[{"title":"丙子元日试笔","author":"邵宝","text":"栽得野松苍色多，隔墙菉竹亦猗猗。\n焚香扫地自我是，投刺到门如客何。\n亭上高登移晚岫，溪边徐步起新波。\n去年今日曾题句，和者盈屏皆可歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四日观灯","author":"邵宝","text":"前日方愁月负灯，夜来灯月兴还增。\n桥通碧水湾湾路，街覆青松处处棚。\n海上不知蓬岛隔，春来漫拟广寒登。\n少年乐事今如梦，驻马长安几度曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十九日漫述用元夕韵柬坐客","author":"邵宝","text":"满城风雨夜收灯，草色阶前看渐增。\n三载病躯才入市，一时诗兴敢题棚。\n绕门水可容舟泊，负郭山须借屐登。\n燕九有名何必问，匏翁诗向蓟门曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日寄玉林","author":"邵宝","text":"春日题诗问玉林，山中春色浅还深。\n初鸣谷鸟乘风煖，半吐岩花坐野阴。\n画舫壶觞游客兴，竹垆泉水老僧心。\n凭君为约新晴后，绣岭堂前共一吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵荅如山","author":"邵宝","text":"读书曾共借东林，竹上题诗岁月深。\n千仞羽仪看晚霁，几番花信作春阴。\n而今诸老多明眼，自古良工独苦心。\n我有一杯非浪致，为君先唱鹿鸣吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈方伯良臣雨中见访以归田数诗索和和其一以荅之","author":"邵宝","text":"归计休论负郭田，险途曾讶璧能全。\n故人今雨非他客，吾道沧洲共此年。\n秋兴剩添三径菊，春潮不到五湖船。\n凭君再拟相寻地，数点閒鸥野水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭喻子乾","author":"邵宝","text":"数口西悲蜀道难，一骢五马旧相看。\n风传天上春光近，月堕云间海气寒。\n事志已脩千里郡，功名俄盖百年棺。\n惟馀南省相知意，独取焦桐忍泪弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳之明日登锡山顶一首","author":"邵宝","text":"閒上东峰望五湖，旧时亭榭半荒芜。\n山中石刻曾传汉，水上䲭夷独吊吴。\n南涧袈裟僧迓客，西岩尊榼仆争途。\n五年再起登高兴，问道山花识我无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用登山韵送尹吉士舜弼","author":"邵宝","text":"几年踪迹隔江湖，冉冉春愁寄绿芜。\n北望京华常傍斗，东来舟楫又经吴。\n鹅湖鹿洞今何梦，瀛水蓬山旧有途。\n我忆麓堂心更切，临书翻愧一言无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舜弼去张提学汝立至复用韵一首","author":"邵宝","text":"旧游回首几鄱湖，白鹿堂坛半欲芜。\n周氏图书元自孔，楚邦风壤尚连吴。\n壮观独泛三江水，正学先驱万里途。\n闻道春来多雨露，山城桃李已开无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日访莫如山不遇","author":"邵宝","text":"南郭沙边一系舟，山亭步转更登楼。\n仆知旧事问能荅，客有馀情行复留。\n背谷且看花独放，隔林曾听鸟相求。\n主人试屐今何处，应在龙峰最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华藏寺和玉林","author":"邵宝","text":"涌金亭倚水云高，三月馀寒尚绮袍。\n古寺客来敲柳瘿，老僧门外扫松毛。\n天风欲定还舟楫，春色无端漫酒醪。\n独立苍茫思何限，吴山烟树越江涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘侍御起溟","author":"邵宝","text":"柱史新从两浙还，清风随鹢过吴山。\n南方郡国巡行后，北极朝廷仰望间。\n八月秋涛虚谷震，六桥春雨落花斑。\n朝来暂舣蓉湖棹，却爱沙鸥水际閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吹笛","author":"邵宝","text":"吹笛禅堂夏日长，月明还忆玉河觞。\n弟兄于我交能世，山水而今会在乡。\n兴逐微波生绿酒，梦将幻景出黄粱。\n清秋更拟酬君地，高阁松风坐夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午热书事用西涯公韵公用杜韵 其一","author":"邵宝","text":"矮矮床如席地然，十分昼漏七分眠。\n铜槃水石自手弄，山阁风松犹梦牵。\n故人馈酒江浙上，童子诵书秦汉边。\n东街铃声冰水过，时向慈闱须买钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午热书事用西涯公韵公用杜韵 其二","author":"邵宝","text":"古涧泉如为我然，松阴有石更堪眠。\n仰高长对山灵在，习静将胜尘务牵。\n大孤小孤汇泽畔，南高北高潮海边。\n人间山水即风月，清兴到时那用钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜得精舍地有作用杜韵","author":"邵宝","text":"寺门东北径悠然，小洞阴多鹿惯眠。\n出地泉声无石碍，倚天松骨有萝牵。\n病馀杖几三年后，梦里堂坛五老边。\n莲社在邻吾不入，门人今助买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热用虞邵庵韵","author":"邵宝","text":"酷暑凌人未肯休，深居谢客汗还流。\n月星影照此堂夜，风雨梦回何处秋。\n吾道江湖应久病，谁歌云汉不深忧。\n长松古涧新精舍，愿与诸君裹茗游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怡閒翁七十寿诗","author":"邵宝","text":"不须开燕却须诗，七十年来两好儿。\n晨策杖时无地碍，夜焚香处有天知。\n中书宅畔云连合，罗汉祠前水满池。\n莫向人间问蓬岛，人间人以百为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月三日小饯施克和于惠山酒间克和诵刘后村元日诗为令因用其韵再致别意是日予奉老母观新精舍故别设于知微山房云","author":"邵宝","text":"精舍初成近惠泉，几回辰至起僧眠。\n新正屈指今三日，旧约惊心又一年。\n慈母板舆应偶尔，佳宾草饭乃居然。\n凭君莫问山中事，万里青云彩鹢前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"精舍成荅徐侍御侍御拟复命还日来观故结语云","author":"邵宝","text":"宪台檄至筑书台，野寺东头辟草莱。\n新水槛前看正脉，古松坛下赏遗材。\n诗传涯老能千纸，酒酹山灵又一杯。\n刚道暮春吾兴在，绣衣天上亦朝回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日怀僧知微","author":"邵宝","text":"今雨山中未煮茶，僧房岑寂闭梅花。\n云心逐我俱无迹，草色逢春渐有涯。\n林径几时松叶满，洞门何处竹枝斜。\n野人持赠青藜杖，欲向吟诗社里誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题宜兴李宗源双桐用吴宁庵韵","author":"邵宝","text":"双桐自比双南金，地得宽閒谢斧寻。\n吴老诗题从始植，文郎图画已成阴。\n霜黄碧叶秋将及，月白青枝夜不禁。\n吾树在庭须客赋，为君还作短长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦氏山庄用慰国英韵","author":"邵宝","text":"五峰东下见平林，中老当年卜隐心。\n龙尾白云看不远，水心明月坐曾深。\n谁家桃李春无色，此地松筠晚有阴。\n欲过荒亭桥板断，几时香茗更相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和荅乔司马","author":"邵宝","text":"参赞堂高倚碧天，旧章新贺又今年。\n野情不问山深浅，春色争看雨后前。\n梅柳云霞俱物候，江湖廊庙各诗篇。\n江南二月多游兴，独放清溪爱我船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观梅","author":"邵宝","text":"病起逢春意渐宽，梅花又向槛前看。\n色如桃李无尘俗，心与冰霜共岁寒。\n素后也知施采易，黄时才觉作酸难。\n东风吹雨花朝近，对酒题诗政未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄复张提学用旧韵","author":"邵宝","text":"两月东巡历四州，几多诗景待君收。\n节从海上应遄返，题为泉头合再留。\n湖上晚风云未定，山中春水鸟相求。\n濯缨别有沧浪调，何处兰亭水曲流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅南沙用前韵","author":"邵宝","text":"红梅又发旧年枝，多事相寻酒与诗。\n草木欲蕃先喜色，冰霜虽老独贞姿。\n君歌已到能言地，我赏偏于半醉时。\n谁道忘忧但萱草，北堂移此亦应宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵荅见素先生","author":"邵宝","text":"一别金溪十载馀，郊斋犹忆识荆初。\n吟诗坛远旗频偃，执法台高席屡虚。\n闽峤衣冠千里梦，蜀川兵革几封书。\n花篱竹径寻常地，惭愧先生问卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄夏德树用素翁见寄韵","author":"邵宝","text":"赤城别我十年馀，犹忆麻城语我初。\n夜月江南鸿雁少，春风海上翠屏虚。\n佳人空谷长劳梦，远道平生未尽书。\n闻道草玄多暇日，杖藜时过野翁居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻庞方伯元化讣","author":"邵宝","text":"激昂意气欲凌云，他日同朝仅见君。\n国论是非谁史笔，谏垣轻重几弹文。\n山连吴楚三台近，水出江河两纪分。\n信宿信州成永诀，旧诗凄楚不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中访王校书 其一","author":"邵宝","text":"閒看书法到山中，骑从多烦两县公。\n茶鼎润生移竹雨，墨池清起落梅风。\n闭门谢客精庐右，扫榻劳僧丈室东。\n只恐春深游客到，青松林外万花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅一首用涯翁壬申岁韵","author":"邵宝","text":"红梅阑畔兴无涯，颇觉诗从去岁赊。\n贞白心肠元绝物，寻常颜色自成家。\n品题合著孤山月，行辈休论二月花。\n剩取馀情与来岁，只今谁逊复谁誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳日私试诸生于二泉精舍","author":"邵宝","text":"一从脩禊起流觞，千载高风尚未忘。\n此日閒来非此客，吾山佳处复吾堂。\n卧龙庵外寻黄石，活水源头见紫阳。\n沂上是非人莫问，草亭真对海天长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观锡山塔基寄顾少参与成","author":"邵宝","text":"东峰石塔对西峰，云去云来俯仰中。\n万古不磨铭地语，百年谁试补天功。\n雷将化雨春回蛰，斗避文星夜起虹。\n何日落成须我报，望湖亭上一樽同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐复用韵寄与成","author":"邵宝","text":"夜闻雷雨过前峰，忽见浮图在眼中。\n最喜江城增胜槩，却愁山鬼妒成功。\n白云影护无声瀑，碧海光摇不霁虹。\n东望怡亭西剑井，路人传谶定应同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龚守诚为山于水北庄诗以讯之用玉林韵","author":"邵宝","text":"却对真山作假山，白云来往隔松关。\n屐从一径委蛇处，亭在双峰掩映间。\n地僻有人能散逸，时清何物不幽閒。\n二泉精舍长邻近，日见林翁杖屦还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"连日在听松冗未有诗雨中补之","author":"邵宝","text":"谁将第一扁西神，竹径新开及晚春。\n劫火不烧无屋地，海鸥如避有机人。\n池边水脉通时活，阁上松声听后真。\n闻道观音经卷在，欲从老衲话来因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用前韵","author":"邵宝","text":"休将冥漠问山神，绣岭花开别样春。\n竹少千竿分两径，松高百尺抱三人。\n茶垆欲试新泉在，画壁曾看老衲真。\n内翰中书前辈行，閒来衰劣愧相因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又用前韵专咏松风","author":"邵宝","text":"高阁松风似有神，骤如秋雨细如春。\n病馀每爱同游客，静里偏宜独听人。\n已向陶庐誇地远，更于庄籁认天真。\n眼前一片虚空界，童子何知问起因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中次文玉","author":"邵宝","text":"庭下双松相对清，东风吹花松子生。\n四檐飞雨葛衣薄，一径带云藜杖轻。\n课诗未足销多暇，戒酒非关爱独醒。\n何处沧洲堪一眺，已知吾道负冠缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘平阳","author":"邵宝","text":"东归匝月复南游，百里封疆旧是州。\n雁荡峰高连两越，钱塘潮长及中秋。\n琴横昼日随鸣鹤，冕露春风起卧牛。\n更喜老亲迎养便，冯公舆接少微舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登华甥西楼用唐人韵","author":"邵宝","text":"满天风雨独登楼，林杪清烟淡欲收。\n云重不知今日午，月明还忆去年秋。\n道经南郭蒲帆近，望入东庐草径幽。\n何处新晴堪试屐，溪桥北去有高邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中在堠阳闻徐东之讣垂涕对客情见乎辞","author":"邵宝","text":"老来方恨少知音，忽报斯人又陆沈。\n万里枯槎空一水，百年敝帚独千金。\n唐衢泪尽江湖远，李渤盟寒岁月深。\n头白门生君自道，晋陵回首重伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中自堠阳还冉泾","author":"邵宝","text":"雨斋正喜故人来，兴尽将归雨又催。\n溪上船如春水坐，云中帆似楚江回。\n傍沙白鸟时双下，隔浦红蕖已半开。\n回首东庐休惜别，月明曾约共登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一室","author":"邵宝","text":"郁蒸今两异他年，一室焚香坐且眠。\n门外刺常愁客入，社中诗却喜人传。\n古盘水石堪时弄，高阁风松亦梦牵。\n短壑层冰何处所，杜陵歌罢兴悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两精舍","author":"邵宝","text":"两精舍共二泉名，惠麓清风似冉泾。\n松倚一峰元有径，草迷七曲已无亭。\n渠通活水门前碧，岭出浮云屋上青。\n刚道病馀多谢客，小舟时复过西汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松风阁追次秦中斋韵","author":"邵宝","text":"一木还将古殿支，真公五叶又逢师。\n閒云锡远心初定，净水瓶深手自持。\n南涧浚泉寻石窦，西林望月倚松枝。\n旧庵更有新楼阁，淮海先生为作碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松风阁追次莫东川韵二首 其二","author":"邵宝","text":"石畔青梧正有华，白云深处问僧家。\n壁葭梦远犹疑画，垆竹盟寒不为茶。\n绣岭峰回松起籁，黄梅时尽雨如花。\n流泉东入蓉湖去，遥听滩声走碧沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松风阁坐圆金方益二僧和莫东川诗来呈用韵赏之","author":"邵宝","text":"母怪侏㒧语杂华，静中禅却自成家。\n石庵故有诗题竹，雪老曾闻榜说茶。\n三日天能留阁雨，一杯吾亦对山花。\n秪应便放中秋棹，黄阜墩边倚月沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄周都宪文化","author":"邵宝","text":"病馀思见故人难，东浙山川入画看。\n风雨百年多幻景，江湖万里几惊湍。\n尊前每进新鸠杖，箧里还看旧豸冠。\n尚忆虔州同驻节，郁孤台上望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱推官","author":"邵宝","text":"曾从天际望苍梧，西向浔州莫问途。\n狱讼岂应轻郡国，经纶未必负江湖。\n文书散后诗还有，车服临时牒并无。\n指日听宣风宪召，郁林船石又东吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侯职方书问我冉泾听松二精舍诗以为荅","author":"邵宝","text":"远问容春及九峰，北湖于我意偏浓。\n幽怀自许长如石，晚岁相看有此松。\n江上书回乡国骑，山中梦醒县楼钟。\n何时更是思君地，活水源头一短筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再荅王郡公","author":"邵宝","text":"太守诗来老衲收，清风长满听松楼。\n为山坐雨谁三日，嗟我怀人又一秋。\n对酒且须诸客赋，省耕还及早春游。\n最怜多稼亭前月，夜夜光明照远洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过舍弟小庄复用前韵","author":"邵宝","text":"溪深竹密两三家，树柳为墙近北涯。\n浅水渐容新渚出，疏林犹作远山遮。\n路回贾客帆初转，风急行人帽欲斜。\n日暮相看兴无尽，漫从舟畔采蘋花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送葛泉州","author":"邵宝","text":"老称汉吏尚青年，路指南闽上越船。\n何郡独非盘错地，吾山元有洌寒泉。\n田田麻麦东风雨，夜夜星辰北极天。\n行过莆阳烦问讯，素翁庄在野云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观冯廷伯园池湖石","author":"邵宝","text":"石丈新从湖上来，君家方筑水中台。\n百年风力谁能挽，万古云根我更培。\n袍笏有时真合取，斧寻何处尚须裁。\n题名未敢轻拈笔，恐露精光逼斗台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得罗建宁和篇复用韵","author":"邵宝","text":"君向江郎看石来，冯家池上复登台。\n奇踪漫谓星辰陨，秀色还从雨露培。\n杖者几须梧竹制，仙家衣是薜萝裁。\n若教移置钟山下，何处金声更赋台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"精舍奉安忠定祠","author":"邵宝","text":"七载蘋蘩也自脩，听松庵外竹林幽。\n高山仰止今祠宇，旧事荒凉某水邱。\n诸葛表中空汉贼，考亭笔下有春秋。\n共看箫鼓迎神地，一道清泉万古流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又明日作","author":"邵宝","text":"十年论道坐黄扉，多少文章上衮衣。\n绿野堂成才少息，碧山居在竟何归。\n昌黎山斗名方著，君实儿童事已非。\n愁绝两知亭外竹，声声萧瑟倚斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又明日作","author":"邵宝","text":"明农疏入兴超然，刚道艰危已济川。\n晚岁乐无司马独，盛时忧有范公先。\n三朝天为留平格，一语民曾解倒悬。\n纵是门人脩谱录，隐功阴德恐难传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又明日作","author":"邵宝","text":"方石东山各远行，朱弦还对老门生。\n酒边梅雪五年梦，诗里云山千里情。\n节击和歌声响应，囊留删稿字纵横。\n独怀他日抠趋地，欲向南屏问旧盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又明日作","author":"邵宝","text":"病久无书问起居，有书还复索亲书。\n但能数字何须楷，从此三年遂不虚。\n湖海却忘魂梦外，亭台犹想笑谈馀。\n静探月窟诗中意，舞罢莱衣每愧予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]