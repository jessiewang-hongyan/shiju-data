9c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日嘉会楼登高 其一","author":"陈献章","text":"引步下前除，儿扶杖亦扶。\n会于何处胜，客有去年无。\n天道常流转，园林又变疏。\n暂留赏今日，醉莫看茱萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日嘉会楼登高 其二","author":"陈献章","text":"兼有吟诗病，何妨著酒扶。\n景逢佳处少，句向觅时无。\n醉去乾坤小，醒来伴侣疏。\n今朝嘉会会，不尽看茱萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日嘉会楼登高 其三","author":"陈献章","text":"半酣壶矢折，又减两三扶。\n九日江门有，千年栗里无。\n山形当晚瘦，脚迹向秋疏。\n问我登高去，都忘菊与萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日嘉会楼登高 其四","author":"陈献章","text":"溪边菊一区，溪竹两相扶。\n草木从吾好，风霜杀此无。\n閒同元日醉，浩笑一生疏。\n试问干云桧，何如小沜萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楚云台观民泽所栽菊寄民泽用作九日韵时民泽还五羊未返","author":"陈献章","text":"当轩玉朵孤，植竹翠茎扶。\n香细风初动，神清俗本无。\n寒深溪井涸，月出山瓢疏。\n何处异乡客，永怀歌茱萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野菊吟寄子长再次","author":"陈献章","text":"野菊生何处，寻香杖偶扶。\n孤标犹讶绝，佳色旧知无。\n老弄真成独，秋来不作疏。\n金樽谁九日，引满对茱萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42682,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答周潮州万里","author":"陈献章","text":"今代潮州守，濂溪是一门。\n乾坤吾道在，岁月此心存。\n行次天边路，书投海上村。\n夕愁空伫望，风雨暗高原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42683,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汪巡按见访","author":"陈献章","text":"岭南经略地，柱史不谋身。\n料理安危事，更张文武臣。\n风行先动草，寒极正开春。\n倾盖江楼暮，挥杯劝故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42684,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题小圆冈书屋和民泽韵","author":"陈献章","text":"四野云飞尽，圆冈一室清。\n至虚元受道，真隐或逃名。\n有疏微言塞，无为大业成。\n一声闻绝唱，五岳看全轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42685,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刘少参见寄次韵奉答","author":"陈献章","text":"西川一杯水，为我浣诗尘。\n身落沧溟远，心将翰墨亲。\n江楼初见客，野径别藏春。\n十郡停车地，千峰击壤民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42686,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李世卿 其一","author":"陈献章","text":"楚客复归楚，青山此送君。\n往来十年破，精力半生分。\n著意当时见，留情异代闻。\n若非真有见，何处谢浮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42687,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李世卿 其二","author":"陈献章","text":"三尺短春蓑，山风吹薜萝。\n人材非管乐，吾道本丘轲。\n送老诸名岳，全生一病窝。\n相思凭寄语，路打祝融过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42688,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李世卿 其三","author":"陈献章","text":"落日苍梧望，清风发棹讴。\n楚山正西上，江水自东流。\n作伴春携酒，谈诗月满舟。\n洞庭看未透，更上岳阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42689,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题黄公钓台","author":"陈献章","text":"小小离人意，羊裘却未工。\n今人多白眼，为我谢黄公。\n弄钓浮沈见，登庖拨刺空。\n浩歌泉石里，况有古人风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42690,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓枕示湛雨龚曰高 其一","author":"陈献章","text":"二千六百丈，脚底是飞云。\n悠悠四十年，欲往念徒勤。\n多谢红藤子，扶吾还数君。\n铁桥问何如，见景胜于闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42691,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓枕示湛雨龚曰高 其二","author":"陈献章","text":"万年如一瞬，莫问我浮生。\n风雨将秋至，山河载月明。\n语檐幽鸟乐，对竹小童清。\n夜夜湘江梦，与君何日行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42692,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再和晓枕寄廷实 其一","author":"陈献章","text":"仰见双白鹤，高飞入紫云。\n苟无脱俗意，安用看山勤。\n好句能传我，幽期敢后君。\n异时铁桥咏，莫遣世人闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42693,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再和晓枕寄廷实 其二","author":"陈献章","text":"万往皆有复，左车不复生。\n西风今夜起，朗月四山明。\n天马非常步，铁桥相伴清。\n去去莫复顾，衡山顶上行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42694,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓枕再和 其一","author":"陈献章","text":"平生老黄石，引望空白云。\n无人知感激，为我尽殷勤。\n何处寻吾契，名山访道君。\n洞天三十六，步步声相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42695,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓枕再和 其二","author":"陈献章","text":"外生即非死，胡为乐久生。\n去来大化内，俗眼未分明。\n我寿元无极，君才亦太清。\n五峰南斗上，何日踏歌行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42696,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋 其一","author":"陈献章","text":"平楼时稳步，身虚欲翩翩。\n明日秋始半，中天月最圆。\n武昌书未返，督府句堪传。\n衡岳那能去，罗浮何处烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42697,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋 其二","author":"陈献章","text":"广寞天自然，浮云任飘翩。\n随时有忧乐，与物无方圆。\n酒底月未咽，水中神莫传。\n去年今夜艇，吾欲破湘烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42698,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"彭司寇挽词 其一","author":"陈献章","text":"男子固多奇，如公更不疑。\n经纶思昔日，功业问当时。\n鬼幸村巫小，棋还国手知。\n杜陵秋月下，兴尽八哀诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42699,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]