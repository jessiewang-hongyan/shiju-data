[{"title":"狱中集古十六首　东岩同扉 其二","author":"韩邦奇","text":"徘徊虎穴上，性命由他人。\n漂梗无安地，涂泥任此身。\n浮生看物变，薄宦走风尘。\n烱烱一心在，天高难重陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其三","author":"韩邦奇","text":"赤县昔同游，忽在天一方。\n危时暂相见，鬓发各已苍。\n阴风千里来，岁暮有严霜。\n人间夜寥閒，落月满屋梁。\n出处同世网，涕泪溅我裳。\n平生方寸心，嫉恶怀刚肠。\n痛愤寄所宣，激烈思时康。\n皇皇太宗业，道德仰今王。\n丈夫誓许国，志士怀感伤。\n吾道正羁束，真宰意茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其四","author":"韩邦奇","text":"楼角凌风迥，夜深露气清。\n今夕复何夕，寂寞壮心惊。\n故国十年别，转衰病相婴。\n妻子隔绝久，万里正含情。\n惆怅年半百，何得尚浮名。\n鸱鸮志意满，豺虎正纵横。\n麟凤在赤霄，赤骥顿长缨。\n志士泪如水，忠臣气不平。\n挺身艰难际，万古一死生。\n感恩义不小，永怀丹凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其五","author":"韩邦奇","text":"感激平生意，此心谁见明。\n与君歌一曲，一半是秦声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其六","author":"韩邦奇","text":"狂风吹古月，肠断白杨声。\n寒雪梅中尽，空歌怀友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其七","author":"韩邦奇","text":"燕臣昔恸哭，千载为悲辛。\n圣代复元古，如君何足珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其八","author":"韩邦奇","text":"雁度秋色远，林光淡碧滋。\n长歌尽白日，不觉鬓成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其九","author":"韩邦奇","text":"郁悒独愁坐，烟萝欲暝时。\n秦云起岭树，及此有相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其十","author":"韩邦奇","text":"献纳青云际，狂言非至公。\n何由返初服，美酒沽新丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其十一","author":"韩邦奇","text":"岁落众芳歇，秋来百草生。\n万重关塞断，慷慨泪沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其十二","author":"韩邦奇","text":"昔献长扬赋，风云四海生。\n遭逢圣明主，礼乐秀群英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其十三","author":"韩邦奇","text":"潜虬隐尺水，海鸟知天风。\n霜鬓两边白，出门悲路穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其十四","author":"韩邦奇","text":"蹭蹬遭谗毁，空怀恋主情。\n贤人当重寄，或冀一人生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其十五","author":"韩邦奇","text":"朔云横高天，远海动风色。\n萧飒望中来，摧残梧桐叶。\n感叹发秋兴，苍然五情热。\n长安如梦中，云山万里隔。\n前期浩漫漫，落日归心绝。\n生事如转蓬，一官已发白。\n昨日东楼醉，绿杨正可折。\n今兹大火落，已属流芳歇。\n壮心惜暮年，岁光屡奔迫。\n天地一浮云，生死殊飘忽。\n李斯上蔡门，穷途方恸哭。\n张翰江东去，清风洒兰雪。\n世路今太行，非时将安适。\n结心寄青松，千春卧蓬阙。\n且复命酒樽，浩歌待明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其十六","author":"韩邦奇","text":"空名适自误，寡识冒天刑。\n应念投沙客，多愧鲁连生。\n感此三叹息，泪满逐臣缨。\n白日在青天，为君前致辞。\n我本草间人，幸遭圣明时。\n投躯寄天下，远为千载期。\n一度浙江北，茫然使心悲。\n世路成奔峭，万姓危朝霜。\n修蛇横洞庭，独坐伤激扬。\n六驳食猛虎，剪棘树兰芳。\n献书入金阙，著论谈兴亡。\n浮云蔽紫闼，虹霓掩天光。\n黄金消众口，青蝇遂成冤。\n其事竟不就，小节岂足言。\n松柏本孤直，虬龙盘古根。\n瑶草寒不死，犹怀明主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋居　时隶司徒卿 其一","author":"韩邦奇","text":"奉天承帝戒，东省肃斋居。\n竹荫春阶月，灯明夜榻书。\n天风传禁漏，郊露湿銮舆。\n清晓朝班事，兢兢整佩琚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋居　时隶司徒卿 其二","author":"韩邦奇","text":"暮鸦巢树定，春望正漫漫。\n月夜地曹静，风郊天仗寒。\n万年周社稷，百辟汉衣冠。\n深愧书生腐，惟馀一寸丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日邀石泉大司寇 其一","author":"韩邦奇","text":"虚馆昼无事，秋光惊客心。\n疏篱三径菊，斜日万家砧。\n行役嗟归雁，幽情望远岑。\n缶中有桑落，相对一豪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日邀石泉大司寇 其二","author":"韩邦奇","text":"万里荒城暮，三秋使节来。\n共携杜陵酒，同上越王台。\n俊逸知高兴，疏狂愧菲才。\n过从能几度，早晚鹭车回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春岗","author":"韩邦奇","text":"岗自嵩高发，春来旺气生。\n卿云千树合，修竹万竿清。\n汉野曾龙卧，周岐有凤鸣。\n地灵久融结，今日见钟英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐中丞抚蜀","author":"韩邦奇","text":"圣主忧三蜀，中丞宪府开。\n西南全胜地，经济出群才。\n节钺辞枫陛，风霜动柏台。\n鹭车应早发，闻有御中催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梅溪","author":"韩邦奇","text":"寒江归去晚，秋树望中疏。\n霜没金蟾影，风传玉雁书。\n青山依别浦，白发对征车。\n相送万馀里，思君入梦初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送光禄大夫王子之南都时以九庙功成迁","author":"韩邦奇","text":"圣皇崇孝理，恩命被仪臣。\n帝里龙蟠旧，仙槎凤览新。\n十年负才略，九庙见忠勤。\n暂尔留都试，行当侍紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万给舍擢山东少参","author":"韩邦奇","text":"画舫春江渡，台高凤欲翔。\n风生青琐闼，花静紫薇堂。\n报政闻齐鲁，封章动庙廊。\n经纶应不负，咫尺仲尼乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱银台自考部之南都","author":"韩邦奇","text":"考功天部客，长啸出春明。\n祖席开燕阁，繁花发帝城。\n晚风催去舫，新月照行旌。\n圣主思弘化，应还召贾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢秋官辞京部之南部为亲也","author":"韩邦奇","text":"帝里青春好，千家桃李开。\n君翻辞玉阙，谁不爱金台。\n望切秋云迥，心惊暮日催。\n即今承彩服，朝夕奉霞杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诗寄端溪一首","author":"韩邦奇","text":"端溪天下士，高卧在林泉。\n四海苍生望，千年道学传。\n圣皇今侧席，君子好弹冠。\n王佐明时彦，风流陋谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"节妇义女　为杨侍御题","author":"韩邦奇","text":"悲风起天暮，开帙感双真。\n绿藿偏倾日，芳梅未识春。\n三秋深夜雨，百折岁寒身。\n谁秉如椽笔，休令漫泯沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西盘冢宰奏功入京","author":"韩邦奇","text":"北阙趋环佩，南都报治成。\n百僚师揆度，四海仰均平。\n轻舸过天荡，高标拂月明。\n此行应简在，天子旧知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浙上送邃谷　无涯白石入广五泉明农今复见子伤哉独为四子耶","author":"韩邦奇","text":"知己半零落，生离几怆神。\n忽逢洛下客，亦是岭南人。\n时事频相问，忧心未敢陈。\n京华四千里，回首一沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘司训罢归蜀","author":"韩邦奇","text":"万里川南道，秋深感慨多。\n汉江冲雨渡，栈道拂云过。\n对月应怀友，临杯且浩歌。\n到家问黄菊，三径长青萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过霍州","author":"韩邦奇","text":"此地吾尝治，风尘几度游。\n道随汾水折，云拥霍山浮。\n昔往黄梅雨，今来白雁秋。\n萍踪倦行役，何处是沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平遥夜坐","author":"韩邦奇","text":"漠漠荒城暮，飘飘旅笛哀。\n坐看寒烛尽，愁绝夜更催。\n冀北花争发，秦西雁不来。\n岁华容易改，春尽且尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同戈怀古","author":"韩邦奇","text":"英俊同戈地，隋唐百战秋。\n晋阳戎马歇，瓜步锦帆收。\n风野平沙合，霜林落叶稠。\n更怜金水碧，咽咽下徐沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高都御史总督南粮储","author":"韩邦奇","text":"留都根本地，国计仰台臣。\n民力东南竭，天菑远近臻。\n圣皇思博济，君子抱经纶。\n独叹阳城拙，空劳抚字仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丽水道中答慧岩","author":"韩邦奇","text":"驱车下丽水，倏雨发微凉。\n晴树遥偏绿，秋山晚更苍。\n关城严虎豹，郡邑少豺狼。\n更喜薇垣使，春风满婺阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻舍弟下狱","author":"韩邦奇","text":"邸报封章事，敷陈与世违。\n怪来明主怒，原是小臣非。\n事业千年远，存亡一叶微。\n高堂双白发，如我只宜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出狱至蒲","author":"韩邦奇","text":"驱车下蒲坂，云树见吾家。\n覆苑堤堤柳，沿河曲曲花。\n生还仍故国，客去几天涯。\n不寐今宵月，鸡鸣问渡槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诏狱　自浙至京未尝顷刻释三刑","author":"韩邦奇","text":"五品监司贵，朝廷法不私。\n一封渎明主，十口累相知。\n黄卷春扉静，青灯夜榻迟。\n旧闻胡宪使，此日慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀慧岩","author":"韩邦奇","text":"画舫潮来别，孤帆夜不眠。\n寒江烟浩浩，秋野草芊芊。\n客病经三月，天涯又一年。\n薇垣新月上，今夕最堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"具庆受敕　继母也","author":"韩邦奇","text":"东署多劳绩，褒封感圣明。\n锦云宫墨淡，宝篆玉香清。\n雨露椿萱秀，恩波泉壤荣。\n高堂春酒绿，悲喜可胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送焦少师阁老致仕","author":"韩邦奇","text":"圣主咨元老，封章遽乞归。\n黄麻心尚壮，白发愿何违。\n事业存青史，勋阶冠紫薇。\n泌阳富花鸟，相对好忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀友","author":"韩邦奇","text":"关西一羁旅，燕北苦孤吟。\n梦落沙楼月，魂消灞水心。\n思君无药力，念尔独情深。\n湖海孤舟夜，秋来风雨侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻车驾幸北边","author":"韩邦奇","text":"圣主思弘业，扬兵出紫宸。\n天威凌瀚海，杀气薄秋旻。\n鏖战有边将，奇勋多近臣。\n传闻奏凯日，还欲下三秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中对棋","author":"韩邦奇","text":"画地为棋局，相看趣亦深。\n推移惟信手，胜负不关心。\n得著知秦汉，收枰叹古今。\n达人观物变，志士惜分阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱成坐狱诽谤","author":"韩邦奇","text":"狱吏传招下，文罗亦大深。\n青蝇闻点璧，黄口果销金。\n欲效燕人哭，应悲楚泽吟。\n神灵存九庙，堪献小臣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孙羽士太初　关内人隐于浙江西湖之上","author":"韩邦奇","text":"羽士关中产，高名远近闻。\n洞宾通变化，太白富诗文。\n华岳三峰月，终南万壑云。\n西湖歌舞地，箫鼓日纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云中道","author":"韩邦奇","text":"景物边城异，多愁旅更增。\n风高闻昼柝，日薄结秋冰。\n渡水愁沙陷，登山畏石崩。\n晚来孤馆宿，燃木即为灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至沁州书怀","author":"韩邦奇","text":"昔岁蒲关度，淹留直至今。\n病来改蓬鬓，春到益乡心。\n万壑迷寒雨，孤城隔远林。\n须臾悲角起，怅望一沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毕尹祈雨有应","author":"韩邦奇","text":"夜半阴云合，滂沱应候霖。\n参天万竿玉，遍地一犁金。\n歌舞斯民乐，精诚大尹心。\n五行洪范传，感应验于今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庆源堂　松皋阁老","author":"韩邦奇","text":"旧趾留遗泽，新堂起庆源。\n河泉自星宿，山脉发昆崙。\n派到函关大，峰惟嵩岳尊。\n精灵钟胜地，阀阅冠中原。\n瑞气通黄阁，天星照紫垣。\n一门三宰相，两代八贤孙。\n声实心名在，勋功汗简存。\n师臣荣极品，大作答皇恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送介溪宗伯承天祀陵","author":"韩邦奇","text":"达孝隆追王，天恩显大伦。\n星槎劳使节，圭璧奏皇仁。\n牺酌灵神格，鸾刑至敬伸。\n登歌周礼乐，奔走汉儒绅。\n历岁松楸古，凌空殿阁新。\n荆衡万马下，江汉九龙驯。\n期会隆昌运，精英毓圣人。\n宸碑光御翰，宠命被词臣。\n问俗周郊甸，观风驻骆骃。\n民情与吏治，还望达枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵石道中","author":"韩邦奇","text":"汾水环灵石，苍山落日程。\n攒峰寒雾结，宿莽暮烟生。\n牧笛横牛背，樵歌杂雁声。\n夕阳催去骑，绿树绕行旌。\n坠叶三秋思，飘蓬万里情。\n家山渐喜近，人语似秦城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"褫亭道中 其一","author":"韩邦奇","text":"云际千岩落照，荒村几树轻烟。\n暗水声闻涧底，流莺啼傍花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"褫亭道中 其二","author":"韩邦奇","text":"落日旌旗摇曳，晚风鼙鼓填諠。\n新柳满堤春色，长杨夹道黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过禠亭 其一","author":"韩邦奇","text":"初去煖风绿柳，重来冷雨黄花。\n天末数声塞雁，庭前满树寒鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过禠亭 其二","author":"韩邦奇","text":"野戍凄凄画角，山城处处寒砧。\n最是秋风羁客，不堪暮雨乡心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盘石道中 其一","author":"韩邦奇","text":"万里久淹海峤，一官又到春初。\n花鸟更添客思，云山还滞乡书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盘石道中 其二","author":"韩邦奇","text":"闻说南荒溽暑，原来海国寒多。\n盘石桃花未□，长安春色如何。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"世芳楼襄毅少保","author":"韩邦奇","text":"世芳楼下花竹稠，太华拱揖长河流。\n襄毅少保一代良，正宜经纶坐朝堂。\n当时是谁握衡钧，却令少保养閒身。\n君不见吐鲁番，时逞陆梁，乃敢掳我西藩王。\n少保赫然挥甲兵，提戈直指哈密城。\n其酋胆落惊逃奔，金印付还元王孙。\n又不见当时刘瑾持朝权，百僚稽首皆争先。\n少保直节难磷磨，一见不肯矧肯阿。\n元元不幸颓朝纲，再令少保乐世芳。\n松皋阁老际圣明，三部尚书进阿衡。\n扬历中外五十年，巍巍勋业真光前。\n吾皇神武御紫宸，昌期自应生名臣。\n我愿天子益严师，阁老大作安边陲。\n只使常怀廊庙忧，莫教独乐世芳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送南太守之保宁","author":"韩邦奇","text":"燕山二月杏花开，千树万树御城隈。\n柳条新发夹长路，祖筵却傍黄金台。\n台下独策征车去，东风日暮起飞埃。\n我思郭隗三叹息，他年还骑青骢来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘中镇萃美","author":"韩邦奇","text":"杭州佳丽天下强，中镇才名动圣皇。\n近侍班中亲简陟，玉符金篆双龙敕。\n号令一出神鬼惊，两浙六月寒风生。\n叱咤指顾雷电走，智士勇夫皆俯首。\n我有忠勤结主知，御书时复来丹墀。\n我行我止谁敢斁，一或撄予天子怒。\n上方四时充珍鲜，长江大海飞黄船。\n三十二宫被龙凤，匪我玄纁谁许贡。\n湖山奇处起生祠，飞碧流丹百尺危。\n穹碑高碣凿瑶石，雄文大字论功绩。\n复有钱塘百万民，黄童白叟传俱真。\n湖山高，湖水深，恩光荡漾君王心。\n湖水深，湖山高，烨烨声华中镇劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘吏部考满","author":"韩邦奇","text":"石头城下长江流，中有美人乘仙舟。\n顺风大帆西北去，不消一月到皇州。\n知君报最献天子，旭日遥瞻五凤楼。\n金台正在凤楼下，君好乘春一上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七里滩","author":"韩邦奇","text":"行路难，春风七里滩。\n阴崖暗白日，危石湱惊湍。\n挽夫力竭舵师瘠，尽日才能进咫尺。\n狭塘水隘忽迸流，满船相顾无魂魄。\n君不见南来箫鼓轻帆舟，一日一夜到杭州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]