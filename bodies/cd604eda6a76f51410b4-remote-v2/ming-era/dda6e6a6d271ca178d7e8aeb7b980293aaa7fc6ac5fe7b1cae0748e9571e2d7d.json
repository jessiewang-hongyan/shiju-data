[{"title":"丙午冬至","author":"张弼","text":"今年冬至暖于春，细雨空阶草色新。\n应是苍天怜赤子，无衣无褐未为贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈进士之京","author":"张弼","text":"老我餐霞东海西，与君只隔碧琉璃。\n于今跨却金鳌去，红日扶桑丹凤啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘络克理进士之京","author":"张弼","text":"冬如春暖促梅花，折得疏枝赠使车。\n试上黄金台上望，无边红杏夺晴霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听儿辈读书","author":"张弼","text":"因听儿童读旧书，书中滋味胜当初。\n几番风雨閒花落，硕果累累蜜不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题","author":"张弼","text":"离离原草淡斜晖，游子天涯尚未归。\n一段秋光谁管领，花开花落付鹑衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"守南安柬招张直","author":"张弼","text":"五羊城里半诗仙，袂接神交三十年。\n绿发张生最年少，好来抄我紫霞篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答寄盐渍荔枝","author":"张弼","text":"绛苞玉质俨如新，可奈重来味巳陈。\n应恐先生知此味，也劳飞骑走红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢寄辰砂","author":"张弼","text":"吾家老井饮红泉，时发丹砂数十船。\n勾漏归来小仙子，却将一七助延年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题晋宁凌节妇","author":"张弼","text":"柳叶桃红几度新，寒窗独坐不知春。\n世间碌碌随流者，空有须眉丑妇人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题行泊二舟","author":"张弼","text":"前船乘风棹千里，后船搥碇犹未起。\n同在江湖各待时，傍人且莫论行止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与乔钟良上舍同游青浦作","author":"张弼","text":"青浦春风三日游，轻裘骏马宝山头。\n小乔却是今男子，野草閒花不转眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予游上海将归而乔钟秀治具于龙华寺以舟往来昼夜忙甚别后舟中写此寄谢东海翁拜手","author":"张弼","text":"角巾卉服大乔郎，为我閒游数日忙。\n借问上洋新酒债，可将诗句一时偿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题枯木竹石","author":"张弼","text":"日转扶桑映绛袍，醒肰独坐鬓萧萧。\n却思筠石霜柯畔，时与仙人和洞萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江山贰教吾乡王维藩先生□子至常山乃策马逾木棉岭而来会时新雨路滑冒险不辞诚笃于故旧之好肰也因赋诗记之而古人雪夜访戴者何足多耶","author":"张弼","text":"水绵岭上鹧鸪声，劝道休行强欲行。\n赢马凌竞浑不顾，无端□曲故人情。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十七日与侄弘立弘左婿行巳秀才共游□云庄赋此二绝 其一","author":"张弼","text":"寒飓恻恻霰疏疏，荠麦青青柳未苏。\n伴我庆云庄上饮，放舟回去不须扶。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十七日与侄弘立弘左婿行巳秀才共游□云庄赋此二绝 其二","author":"张弼","text":"击鼓频催□□花，春光先到种田家。\n诸郎其写新诗句，我独龙钟醉帽斜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄文温州","author":"张弼","text":"短棹轻舟载夕阳，独寻新句下横塘。\n白鸥却是催诗使，飞探蘋洲醉墨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅纸帐","author":"张弼","text":"短纸垂垂茧瓮开，白云堆里绝纤埃。\n东风吹醒罗浮梦，便觉春从天上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题武昌守王德孚梅花屏","author":"张弼","text":"松竹隆冬共结盟，不同桃李竞春英。\n武昌太守人都说，官与梅花一样清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听雷堂","author":"张弼","text":"昔年我寓龙潭上，大醉高声呼老龙。\n今日归来听雷处，老龙来笑我龙钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访陆学士不遇戏题于壁","author":"张弼","text":"毗陵城下朔风尖，日暮天寒雨雪间。\n始知东阁先生贵，不放南安太守参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琳湖二首 其一","author":"张弼","text":"琳湖湖上草堂幽，四面窗涵一鉴秋。\n轩冕红尘飞不到，竹床高枕对閒鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琳湖二首 其二","author":"张弼","text":"廿年不踏琳湖路，修竹依肰旧日清。\n醉后错疑湖水上，东风吹落鹧鸪声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其一","author":"张弼","text":"使君新赋十梅诗，老眼惊看叹色丝。\n绝胜西湖千树雪，孤舟欲发重相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其二","author":"张弼","text":"我曾两宿金山寺，江海风涛入壮图。\n小范于今能久驻，无边清绝胜蓬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其三","author":"张弼","text":"姑苏翰墨风流地，道观高蹲没字碑。\n几问章缝浑未识，独摩苍藓立多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其五","author":"张弼","text":"冒雨游山不见山，耳根空自饱潺潺。\n蘋蘩了却中心事，旧友新坟紫翠间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其六","author":"张弼","text":"吴淞江上白云深，一屋诗书万古心。\n闻说墨池鱼变化，几多翘首望甘霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其七","author":"张弼","text":"腹不饥时身不寒，心头无事手头宽。\n父慈子孝妻贤慧，胜做当朝一品官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其八","author":"张弼","text":"鸭嘴沙头竹叶舟，主人何处作清游。\n绿萝阴里黄茆屋，时有书声似水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其九","author":"张弼","text":"白鹤城中沸市声，谁知帘下有君平。\n张骞懒问支机石，得得频来讲易经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其十","author":"张弼","text":"平生心事远游篇，谁信空山叫杜鹃。\n五岭三湘一杯酒，悠悠片月下长川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其十一","author":"张弼","text":"绿树村边白鹭沙，参差茆屋蜑人家。\n扁舟满载清风去，何处笙歌赏杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题十二首 其十二","author":"张弼","text":"庭槐风静午阴多，睡起西窗日影过。\n自笑老来无复梦，漫看庭蚁上南柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹊桥仙 为马宗海同年作","author":"张弼","text":"琼林宴罢，萍踪无定，空自传消寄信。\n天涯海角此相逢，这段旧、情怀难尽。\n交情似海，宦途如梦，后会安知何处。\n大家尽力报君亲，且莫计、东西去住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞龙吟 送司马祭酒省亲","author":"张弼","text":"秋光子。\n正遇月窟香清，天街凉早。\n诸生云会都门，斯□□□，今朝出道。\n为亲老。\n常念承颜无便，陈情有表。\n□□暂许南归，捧觞戏綵，增延寿考。\n金带绯袍趋拜，古□如此从来少。\n司马相公曾孙，全尽忠孝。\n越山涑水，千载相辉耀。\n娱亲暇、松风萝月，幽情倾倒。\n只恐丹山鸟。\n口衔一纸天风晓。\n催入蓬壶岛。\n东阁下，还将丝纶来草。\n燮调二气，万年熙皞。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拙女词","author":"张弼","text":"团扇初成梧叶秋，夹罗欲试又重裘。\n也知不是时来早，拙女囊空自晚谋。\n拙女囊空自晚谋，清寒到底未为羞。\n盈箱锦绣依时著，多在春风十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"□花词","author":"张弼","text":"杨花衮衮随风飘，悠悠扬扬低复高。\n海天空阔任尔云，莫来沾我木棉袍。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南归散词","author":"张弼","text":"东海先生归也，南安太守新除。\n一挑行李两船书，被人笑道痴愚书。\n书寒不堪穿，饥不堪煮，收拾许多何用处。\n况而今、白发苍颜，坐黄堂之署。\n乘五马之车，安得工夫再看渠，又将载到南安去。\n古人糟粕，谁味真腴。\n枉说道黄卷中，与圣贤相对语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"禽言 其一","author":"张弼","text":"得过且过，饮啄随时度朝暮。\n得陇望蜀徒尔为，未知是福还是祸。\n得过且过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观泉 其一","author":"张弼","text":"山巘高低如绣，溪流屈曲无声。\n幽人闭户不出，门外小桥自横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客","author":"张弼","text":"日晚鸟啼山树，雨晴马踏香尘。\n人向红亭惜别，客依芳草伤春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"张弼","text":"□色欣欣如笑，溪流脉脉无声。\n亭下十分好景，琴中万古幽情。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过孙竹庄","author":"张弼","text":"碧梧庭院晚香台，廿里风烟特地来。\n莫怪登临□一醉，棠梨有意借春开。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洙泾为沈士登题盛子昭画时在五湖一苇舟","author":"张弼","text":"溪雨溟濛逗客舟，五湖一苇且遨游。\n看山细勘痴仙笔，万里云衢咫尺谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过石门","author":"张弼","text":"溪云作雨晚溟濛，胜地重游事不同。\n到处门墙堪入画，几家苍翠欲凌空。\n读书台古看栖凤，洗砚池平忆去龙。\n惊问故人伤宿草，欲携长剑挂西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨看假山","author":"张弼","text":"曲池小径碧琅玕，夜雨灯笼步步看。\n不是先生山水癖，风云长路几人閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓吴山驿","author":"张弼","text":"两度重阳客里身，一番秋信一番心。\n黄花绿醑閒相对，岳色江声晚独吟。\n旅雁嗷云湘水碧，寒蛩催晓越山深。\n故园若问归消息，古树飘香已满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿浙江驿惊潮","author":"张弼","text":"万里驱驰第一程，浙中山水旧经行。\n江船正好安眠去，又作迎潮夜半惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行","author":"张弼","text":"尘鞅苦相聒，江槎喜自閒。\n数编翻欲遍，小饮卧看山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿草萍驿次林都宪见素题璧韵","author":"张弼","text":"四塞山岚一面当，肩舆虽稳不如航。\n潦侵松径溪桥滑，日转霜林野店忙。\n楚岫雁回秋漠漠，吴峰云净晚苍苍。\n壮游万里皇恩布，归及春衫旧草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次前韵题草萍驿璧","author":"张弼","text":"万里先锋莫可当，山行乘?水行航。\n男儿堕地分如此，客子逢秋兴自忙。\n一宿草萍青嶂暮，几看云峤白衣苍。\n骞槎不尽昆崙脉，我欲南搜海若堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南昌柬林粹夫","author":"张弼","text":"慷慨风烟万里秋，章江如旧客重游。\n宁亲空忆趋庭对，奉使何能为国谋。\n岚舞蛟龙双旆远，云移霄汉一帆收。\n鱼城更报先祠在，春信归槎十日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丰城夜行","author":"张弼","text":"踪迹劳劳愧野鸥，眠沙泛碧蓼花秋。\n烧灯夜发丰城道，谁信临江五日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过南安谢父老修东海先翁生祠","author":"张弼","text":"迢递先公遗世久，慇勤父老尚追思。\n东海英灵惊独在，南安祀礼岁如之。\n庾梅未落春何往，湘竹淩寒节不移。\n翘首相承贤守令，不胜云外雨丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其一","author":"张弼","text":"霜降风高始觉秋，半林红叶送飕飕。\n郡翁领客多延伫，未信云槎向斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其二","author":"张弼","text":"路入秋江十月交，蹒跚茶树遍山腰。\n黄云割尽青云起，几处枫林弄晚娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其三","author":"张弼","text":"四山如障竹如墙，斜枕山陂半作堂。\n更上楼居瞰灵碧，一溪清涨泻方塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其四","author":"张弼","text":"晚麦惟荍满路葩，软香乌饼忆山家。\n南来秋尽犹馀暑，何处玄云缀雪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其五","author":"张弼","text":"丛竹秧松杂作篱，曲檐斜枕午炊藜。\n忙煎茶乳供官客，知是前村老铺司。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其六","author":"张弼","text":"罗溪中站数家丛，谁信豺狼白昼攻。\n独有大参惊识面，天教小丑试孤忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其七","author":"张弼","text":"数家野店曲成村，老妪当垆洗瓦盆。\n惊唤儿童走相探，半林秋日照柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其八","author":"张弼","text":"杨墈溪桥覆瓦亭，疏棂高瞰碧流倾。\n浑如复道行空去，不共嬴秦受恶名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其九","author":"张弼","text":"伐竹为梁架短溪，肩舆平步可东西。\n不知云路仍多少，应过藤桥是到时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江陆行十绝 其十","author":"张弼","text":"乍登山路不胜疲，数里劳劳却自如。\n独念肩舆亦人子，此生何际得消除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至袁州界","author":"张弼","text":"远使百蛮国，轻轺十月天。\n暖留山草宿，寒沁涧流潺。\n风土谙多历，官寮厌曲拳。\n天涯涵帝泽，先向海南宣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻雁寄姑苏皇甫世庸年兄","author":"张弼","text":"客路萧萧闻唳雁，数声犹似怨西风。\n寒云压塞梦魂断，凉月半江清影空。\n旧翅不禁伤岁暮，分飞无奈各西东。\n天涯欲寄江南信，归路迢迢万里蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚渡新喻县石子冈","author":"张弼","text":"石子岗头路，累累石子坡。\n百年吾一到，千古几人过。\n返照凝丹壑，欹桥撼碧萝。\n使船轻万里，一任晚云多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过昌山渡","author":"张弼","text":"峡水昌山渡，深秋薄午过。\n两崖森壁立，一涧闯盘陀。\n团隐东西崦，田开上下坡。\n土风多俭朴，司社竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过周濂溪行祠","author":"张弼","text":"过化传先哲，遗踪咎后思。\n一官监酒税，千古建香祠。\n秋日高山丽，春风满座熙。\n渺然经一拜，庭草绿差池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湘东登舟","author":"张弼","text":"日日劳劳历万重，湘东舴艋意偏浓。\n悠然已过湖南境，一夜潺湲听不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醴陵邑舟中","author":"张弼","text":"蓬背坐轩豁，餐当象山眠。\n鸥行□棹起，乱石激流潺。\n渌口迷苍霭，湖头亸翠鬟。\n夕阳留晚照，白醉使臣颜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醴陵闻陈文鸣提学至待之不遇寄此","author":"张弼","text":"路涉湖南境，人传宗主临。\n江山空伴侣，天地有知心。\n浩思云相隔，羁怀水共深。\n东流如不碍，遥寄短长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]