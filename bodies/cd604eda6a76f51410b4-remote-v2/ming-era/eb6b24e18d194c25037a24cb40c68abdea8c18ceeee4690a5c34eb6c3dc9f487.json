[{"title":"书奥","author":"郑真","text":"奎星高照屋西隅，插架纵横万卷书。\n彩笔梦花孤榻静，青藜炊火半窗虚。\n天潢尚谱先朝系，官诰犹存世泽余。\n已有声名登阙下，苦心何必注虫鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贫乐轩","author":"郑真","text":"繁华过眼尽堪怜，古木青山自屋椽。\n三韭香沾原上雨，一瓢冷泛雪中泉。\n卖文敢儗金成匮，问字何容酒满船。\n风月襟怀天万里，青春座暖味重玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题义儿陈清卷","author":"郑真","text":"而翁双鬓早星星，膝下儿郎得宁馨。\n长忆杜陵怜骥子，不惭周雅赋螟蛉。\n衔哀欲诉心如割，舐血多闻舌尚腥。\n见说宛丘存谱牒，还家终不负幽冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊枕用吴先生韵","author":"郑真","text":"幽花包裹御袍黄，一枕齁齁卧石床。\n老觉形神安晚节，静通鼻观溢秋香。\n蚁醪醉醒疏篱月，鹤帐寒惊满径霜。\n辨得楮衾如白氎，梦中红日上东方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题马知县梦云图","author":"郑真","text":"长日思亲慨白云，客窗有梦暮缊缊。\n绿衣恍若樽前舞，哀角凄然枕上闻。\n千里寸心随缥缈，半床孤影落缤纷。\n骚坛有客夸能赋，不数河阳狄使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浮玉山房","author":"郑真","text":"削成尖玉涌玻瓈，疑似昆仑瀚海西。\n宝气伏藏丹壑暗，佩声缥缈彩云低。\n长材自许充瑚琏，高爵终期赐璧圭。\n夜月秋深瑶帙启，浮光耿耿烛星奎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送医士凌伯川归吴中","author":"郑真","text":"浮世生涯药笼中，佩声飞渡碧云重。\n沙河水暖龙遗骨，山苑风晴鹿有茸。\n九转尽传丹灶诀，万言宁待皂囊封。\n吴江归去春如海，满眼莺花锦绣浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡廷干归松江","author":"郑真","text":"谪居陇亩慰幽栖，物外游尘不上衣。\n自有阮生青眼顾，也如江总黑头归。\n秋风东海莼鲈熟，晓日西园柿栗肥。\n自此不须谈作客，白鸥应许共忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分题得芍坡送李太守","author":"郑真","text":"疏凿咸夸惠济功，使君来守表清风。\n千渠声合雷车迅，万顷光开月鉴空。\n暮雨冥冥腾赤鲤，秋云渺渺落玄鸿。\n吾民要觅铭勋处，坡上新亭有庆丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘推官可成归长沙","author":"郑真","text":"云杳长沙客思孤，凉风千里赋归欤。\n五雷曾阐神明秘，一卷犹存法律书。\n岳麓天高抟化鹤，屈潭水满荐嘉鱼。\n作官何似还家乐，仍有丹心恋玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答宋推官廷臣见寄","author":"郑真","text":"淮南为客已多年，长忆山中孟浩然。\n雁信远随千里月，鸾章忽报九重天。\n论文愿借清风榻，载酒须同碧水船。\n莫道老虔官独冷，吹嘘正待向云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵三首 其一","author":"郑真","text":"苍发萧萧五十年，文章金石慕燕然。\n壮游自儗探蟾窟，清梦谁知到木天。\n感兴夜闻江上笛，附书晓问海东船。\n广平才子夸能赋，诗酒从容共客边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵三首 其二","author":"郑真","text":"作客从今儗十年，瀛洲东望自悠然。\n金堂玉室真仙窟，赤水丹山有洞天。\n云谷曾游灵运屐，雪溪还访子猷船。\n多情为想归田乐，又见君来自日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵三首 其三","author":"郑真","text":"客乡千里数流年，风雨淮山思渺然。\n水绕奕坛送碧海，云开仙洞见青天。\n笙歌谩忆秋风宴，书画欣逢夜月船。\n公府昼长官讼少，轻车须约到芹边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻沈茂玄大使索登州砚","author":"郑真","text":"登州异产胜端溪，即墨封侯品秩跻。\n要使九重分雨露，便须五色吐虹霓。\n御前漫说宫妃捧，海上频闻使客携。\n莫待人间高着价，锦囊好送竹窗西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵乌先生留别二首 其一","author":"郑真","text":"太古遗音识者稀，酒边一曲怅分违。\n池河共说神鱼蛰，瀛海还看独鹤飞。\n水阔三江云缥缈，凉生六月雨霏微。\n客途争似还家好，过眼休嗟旧事非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵乌先生留别二首 其二","author":"郑真","text":"老来归去世应稀，功业宁怜与世违。\n淮甸天遥双鬓改，海城家近寸心飞。\n可应骚客伤迟暮，料得诗人赋式微。\n乡社斯文如一线，好令后学认公非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同郡乌先生继善蒙恩还里过濠上待舟留二旬余予以契家周旋无虚日将行着序为赠先生复留诗以别遂用韵以致惓惓并附先生留别诗于后","author":"郑真","text":"十载长愁信息稀，异乡相见复相违。\n自惭堕地非千里，谁似冲天任一飞。\n解带石边苍树合，升仙桥上好风微。\n箧中空有南征稿，不为从容较是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李伯谨同知归吉安","author":"郑真","text":"千里江山似画图，天光如洗雨晴初。\n共传游子催归骑，还道慈亲正倚闾。\n野水耕畬收黍稌，芸窗俎席荐殽蔬。\n中都旧日留遗爱，好属周南太史书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王汉章以博学授英山知县予以其能绳祖武作诗贺之盖汉章曾伯祖内翰公曾祖常博公兄弟相继登博学宏词科有名咸淳间者也","author":"郑真","text":"咸淳博学有名儒，先泽犹存五世余。\n晓日枫廷催入觐，春风花县听恩除。\n山中好着青箱录，淮上谁传玉海书。\n老我天涯曾作客，欲因相见定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄林允原同知","author":"郑真","text":"闻君匹马过邳州，不得相从说旧游。\n枫陛仰瞻京国晓，棘闱同试浙江秋。\n看云好着圯桥履，对月须乘泗水舟。\n肯过临淮松竹底，定将诗酒诧风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶主簿伯兴归慈溪","author":"郑真","text":"同乡千里盼瀛洲，风雪淮山赋远游。\n云暗松厅翻锦帙，香倾枣酿醉琼舟。\n上新桥外沧波暮，大着坟前绿树秋。\n归语同宗贤弟侄，青灯还忆夜窗幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢大使归潮阳","author":"郑真","text":"潮阳久矣望归来，淮水风帆一日开。\n深荷九天滂德泽，不辞五岭冒炎埃。\n山中剑气龙吟匣，海上珠光蚌拆胎。\n想见故园风物旧，题诗正好寄多才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄乌先生","author":"郑真","text":"田园归去好从容，故旧相看梦寐中。\n把镜尚怜愁鬓白，持杯休惜醉颜红。\n歌弹长铗风生席，曲奏瑶琴月满空。\n应念淮山千里客，寄诗须是杜陵翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄蒋古岩知县","author":"郑真","text":"外家金紫见英髦，谱牒相传尚未遥。\n蝶梦正酣沧海月，鸾章忽拜紫宸朝。\n留城落日双鸿杳，汲冢西风万叶飘。\n车骑东来须一见，山窗剪烛话清宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其一","author":"郑真","text":"日月光开万岁山，蓬莱云气渺茫间。\n封疆自古夸幽俗，玉帛从今入汉关。\n驯象驾车踰海徼，真龙立仗育天闲。\n帝乡万代称汤沐，共喜恩波浃宇寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其二","author":"郑真","text":"风生濠上碧流湍，日照金鸡五色翰。\n枫岸晴看霜锦烂，菊篱香挹露珠寒。\n附书每欲随玄雁，绾诰何因识紫鸾。\n沧海东归怜骥子，吴江应已过淮安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其三","author":"郑真","text":"玉宇天高对广寒，清辉照见酒肠宽。\n神踪要觅三生石，仙药须凭九转丹。\n宋璟多应趋宰辅，郑虔祇合老儒官。\n山川万里秋空阔，好趁西风挟羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其四","author":"郑真","text":"锦鞯花马抹青刍，天上承恩喜赐租。\n出塞将军闻奏凯，还朝使者迓先驱。\n露凉松径悲玄鹤，水阔莲塘浴锦凫。\n犴户秋清公牍少，远游作赋托三闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其五","author":"郑真","text":"同乡旧日访山居，插架纵横万卷书。\n郡府贤良催剡荐，皇家爵禄庆宣除。\n斯文每逐仪容接，公道何嫌职守拘。\n樗散由来天所放，厅阶日觉往来疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其六","author":"郑真","text":"此身甘似鲁诸生，汗简悠悠万古情。\n试艺声传秋院锁，论文光动夜窗檠。\n春秋圣笔终麟获，雅颂工歌宴鹿鸣。\n先泽有传当不愧，朝恩何敢望盘缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其七","author":"郑真","text":"客里黄花九日杯，凭谁织得锦文回。\n非关使者征求急，可是诸生劝得来。\n老觉丹心终不改，愁怜白发苦相催。\n夜深却作还家梦，城郭秋声画角哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴用宋推府韵 其八","author":"郑真","text":"望乡远在海瀛边，茅屋苍苔问石田。\n夜月上时探兔窟，寒潮落处抖鱼筌。\n踏歌遥听青云外，射策长怀玉殿前。\n千里祇今怜作客，焚香再拜祝尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答冯道常谢毡袜之惠","author":"郑真","text":"书来袜寄紫茸毡，霜雪应怜老服虔。\n暄暖自须回晚节，冻皴浑不怕残年。\n感君高义何能报，愧我虚名莫浪传。\n为觅靴材如近样，着随野鹤破苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送贾惟敬","author":"郑真","text":"彩凤双飞远到家，北风满道正尘沙。\n十年客况随迁谪，一日君恩拜宠嘉。\n林壑生寒霜落果，海途晒日碱浮花。\n乡中故旧多青眼，醉倒金樽不用赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题桂林图","author":"郑真","text":"爱看丹桂倚林皋，花下仙人白纻袍。\n应为名家多积德，不因招隐赋离骚。\n鹤巢声出青云表，蟾窟香传玉宇高。\n忆向西风曾折取，待君初度醉挥毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅桧图","author":"郑真","text":"春梦繁华正可怜，山深岁暮爱清妍。\n疏枝落落初开萼，老树亭亭远际天。\n飞瀑听从干涧底，悬崖望近片云边。\n沧溟咫尺蓬莱岛，笑我归来要学仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋南山别墅","author":"郑真","text":"笑指南山第一峰，山中无事得从容。\n金银气合云霄上，紫翠光开涧壑重。\n太傅多才传洛下，相如有赋忆临邛。\n岁寒正有松梅约，腊酒香浮琥珀钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹村","author":"郑真","text":"竹村深处问仙家，石洞琅玕长碧芽。\n鸾鹤秋高横铁笛，鸡豚社近漉乌纱。\n山阴越上人相讶，渭水淇园客漫夸。\n唤取陵州文太守，筼筜谷底问年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为吴孟舟赠医士盛元礼","author":"郑真","text":"堂前慈母正呻吟，三圣谁传太古心。\n袖有神针投寸铁，囊余宝药售千金。\n杏山香蔼红云烂，橘井寒生碧水深。\n盛德在人须补报，欲求丹诀问云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘学正","author":"郑真","text":"缑山讲道拥皋比，五夜星光耿璧奎。\n帝里恩承红日近，仙梯步逐彩云低。\n不惭徐乐登金马，有待王褒颂碧鸡。\n笑我同袍华发早，祇须归老故园栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗副使丁母忧还乡","author":"郑真","text":"缞麻换却老莱衣，千里西江赋独归。\n可忍丛萱摧夜雨，多怜寸草报春晖。\n瑶池信逐青鸾杳，琼岛仙游白鹤飞。\n愧我无能将赠赙，客边相别泪重挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和孙大年留别韵","author":"郑真","text":"东风花县几经春，夜度秦关月似银。\n陶谢诗名夸得俊，欧虞碑帖认来真。\n客边敢复留冠盖，天上应须列搢绅。\n跨马又成淮海别，云霄步武莫逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春萱堂","author":"郑真","text":"双亲鹤发画堂中，生意森森合化工。\n夜月天高垂翠黛，午风日暖艳金红。\n舞衣笑奉仪容接，仙箓欣夸福寿同。\n百岁一门歌具庆，恩封早赐大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王汉章","author":"郑真","text":"春来见说两朝天，禄宦多蒙圣主怜。\n病足敢骑沙苑马，归心忍听蜀山鹃。\n水亭修禊招贤士，月馆吹箫候列仙。\n尚有掖垣遗稿在，手抄应许寄芹边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予在临淮手植杏一株越五年而作花赋诗寄郡庠诸先生","author":"郑真","text":"当年手植近窗纱，正待春风早看花。\n绛雪生寒迎晓日，香绡透暖绚晴霞。\n敢云相国裴公宅，不比仙人董奉家。\n寄语琼林新进士，朝来载酒好将车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵寄开城县丞孙大年先生","author":"郑真","text":"宫锦红翻御赐衣，风流文物近来稀。\n山中共讶前驱过，天上同夸入觐归。\n烽火台词谐玉律，古长城调叶清徽。\n幽州购得昭仁帖，好寄濠梁水竹西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用五河县孙驿丞行简秋凉感怀诗韵 其一","author":"郑真","text":"远碧亭前翠竹幽，多情谁为数诗筹。\n云霄指点无多路，淮海从容一半秋。\n客骑鸣鸾行复止，官船挝鼓去如流。\n登高好寄孙公赋，消得吾生万斛愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用五河县孙驿丞行简秋凉感怀诗韵 其二","author":"郑真","text":"琪树西风枕簟幽，邮程百里报船筹。\n声传哀角孤城夜，梦断浮槎瀚海秋。\n弹铗不禁歌激烈，操觚聊复寄风流。\n河头见说鱼还贱，好寄樽前洗客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用五河县孙驿丞行简秋凉感怀诗韵 其三","author":"郑真","text":"汗简孤灯夜榻幽，老来无计借前筹。\n丹枫影睇龙廷晓，玉桂香探兔窟秋。\n河汉天高星北拱，瀛洲海阔水东流。\n客怀浩荡凭谁写，清唱应须唤莫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用五河县孙驿丞行简秋凉感怀诗韵 其四","author":"郑真","text":"呼酒邻家隔竹幽，杯行到手不论筹。\n蒹葭水阔汀洲暗，苜蓿凉生苑囿秋。\n解佩正须归旧隐，濯缨还许向中流。\n相思坐对濠梁月，千里难禁宋玉愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用五河县孙驿丞行简秋凉感怀诗韵 其五","author":"郑真","text":"芹边自足寄清幽，机巧人间不用筹。\n蓂荚周回尧甲子，简编笔削鲁春秋。\n月凉濠水清如靛，雨洗淮山翠欲流。\n为问五河明博士，病中应恐不胜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用五河县孙驿丞行简秋凉感怀诗韵 其六","author":"郑真","text":"水郭人家处处幽，太平久已息边筹。\n箜篌曲奏虹桥月，刁斗声传雉堞秋。\n展席恍惊珠露滴，据床遥指玉绳流。\n封书欲寄南飞雁，翠竹窗西人正愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次黄以斋韵寿吴方斋博士","author":"郑真","text":"日照扶桑海宇开，五云多处望三台。\n且陪坐席春风乐，相约林泉晚节回。\n雅调谁歌青玉案，碧香同捧紫霞杯。\n百年好为斯文寿，祇恐天边使命催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题松存斋","author":"郑真","text":"君家种德自先公，存得山中几树松。\n仙籁满林搏化鹤，翠涛滚壑舞群龙。\n九重路与云霄接，百岁恩承雨露浓。\n见说明堂求柱石，荣华何止大夫封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵王文祥见寄","author":"郑真","text":"作客彭城又几春，煌煌庠序正兴文。\n光躔奎宿空中现，曲奏霓裳月里闻。\n眢井水枯怜宿草，萧关路杳盼行云。\n遨游如过欧阳墓，拓得残碑幸见分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王敏文自宁夏还四明 其一","author":"郑真","text":"同乡久矣识多才，淮海相逢一笑开。\n世味真能甘淡汨，客情且复慰招徕。\n官槽正熟葡萄酿，塞曲新传鴳滥堆。\n千里烦将家信寄，山中松竹问谁栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王敏文自宁夏还四明 其二","author":"郑真","text":"双亲两地思愔愔，万里难为一寸心。\n于越山川春树远，李王城郭暮云深。\n馔馐要待双鱼出，彩袖行随独鹤吟。\n至孝往来应不惮，为传作赋儗词林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用沈茂玄大使录示令亲所寄诗韵就寄 其一","author":"郑真","text":"风流人物奈君何，淮海从容客兴多。\n夜月光开云母帐，春筵曲唤雪儿歌。\n日穿林壑啼黄鸟，雨洗庭阶湿翠罗。\n正欲扣门同一笑，归来星斗看天河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用沈茂玄大使录示令亲所寄诗韵就寄 其二","author":"郑真","text":"三月春深问若何，看花应怪落红多。\n骚坛屡扫堂堂阵，仙馆频听踏踏歌。\n已见良材成杞梓，更闻嘉好叶松萝。\n天涯谁念瀛洲客，梦逐扁舟过浙河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陟望轩","author":"郑真","text":"一片浮云伴落晖，望乡千里意多违。\n天高淮甸冥鸿度，海阔蓬莱独鹤飞。\n使幕敢辞毛义檄，亲庭谁舞老莱衣。\n百年已注长生箓，白发萧萧待汝归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢五河孙驿丞鱼酒之惠","author":"郑真","text":"买得河鱼不论钱，寄来羊续底须悬。\n烹鲜自可供朝饭，斫脍须当献午筵。\n家酝生香传宝瓮，声诗托兴写金笺。\n感君厚赐何能报，问讯云鸿若个边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]