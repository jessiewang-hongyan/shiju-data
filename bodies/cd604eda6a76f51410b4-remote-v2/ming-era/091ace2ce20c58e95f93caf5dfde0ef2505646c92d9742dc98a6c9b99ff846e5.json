[{"title":"草堂七夕二首 其二","author":"黄佐","text":"星汉经年别，机丝此夜情。\n微云双鹊度，细草一蛩鸣。\n客暑销蕲簟，雄风满粤城。\n不须论巧拙，吾自爱秋清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步崖","author":"黄佐","text":"村落除蝥贼，农畴长稻苗。\n更逢江海客，细话圣明朝。\n魏阙彤云满，徐方绿水消。\n步崖看霁月，双袂自飘摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"眠石","author":"黄佐","text":"眠石听松涛，风清韵更高。\n却怜青琐闼，偏醉紫檀槽。\n响答谐双凤，轩腾涌六鳌。\n坐来天籁息，一叶下亭皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"缓步","author":"黄佐","text":"缓步珠江上，烟山迭献新。\n日高桃炫昼，风定鸟鸣春。\n把钓须谋酒，扬舲恰爱人。\n悠然吾羡汝，天宇渐为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日栖霞庄上放鹤","author":"黄佐","text":"双鹤盘三径，飞飞出化城。\n流云开浩渺，积翠入空明。\n野籁江天合，林芳日夜生。\n东风吹健羽，好伴玉箫声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答侯少参惠雁宕明茶","author":"黄佐","text":"丽日依珠树，高风挹玉川。\n明茶分雁宕，活火瀹虹泉。\n海上抟扶翼，松间广乐弦。\n泠然清不寐，真似伏羲年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁思伯惠盆兰对酒有作学月露体","author":"黄佐","text":"泛泛光风里，崇兰香满庭。\n玉芽滋湑露，金粟胜繁星。\n秀色依霞紫，芳根带雨青。\n呼儿开晚酌，对月敞云屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁祭早盥偶成","author":"黄佐","text":"早盥怀玄圣，逢秋感慨多。\n砌蛩闻暗室，庭树挂明河。\n紞紞风谯急，丝丝雪鬓皤。\n乘桴浮海意，千载竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八月十日早起祝圣口占","author":"黄佐","text":"谯鼓静秋城，丛霄雁一声。\n薄云随佩动，多露藉灯明。\n紫极曾遥梦，沧江只此生。\n十年瞻拜地，香忆御炉清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦中同仙子讽咏作","author":"黄佐","text":"瑶圃毓三秀，广庭辉五云。\n自惭衰白质，同讽太玄文。\n浩荡烟霞侣，翩跹鸾鹤群。\n郁台霄汉上，恭礼玉晨君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠曾侍御佩","author":"黄佐","text":"豸绣当霄汉，君王召贾生。\n晴云消宿雨，佳气满行旌。\n鼓棹南薰动，浩歌西月明。\n定应前席问，天下见澄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠江刘生吉卿往江州书馆赋诗以送之","author":"黄佐","text":"腊月行邕管，沧波冷白蘋。\n雨晴梅映日，风定鸟催春。\n说剑休辞酒，扬舲恰爱人。\n此行须自爱，期尔德为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲春朔夜子刻，梦得一尊字，时在素会试京师，是夕一鼓得男孙，弥月告庙，命名谦之，义取谦尊而光也，赋诗以纪","author":"黄佐","text":"朔夜梦谦尊，今朝抱仲孙。\n伏犀看日角，驰马报天门。\n清旭照兰砌，香风来杏园。\n孩提正相笑，姜酒更开樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偶成","author":"黄佐","text":"搜诗聊隐几，观物更登台。\n虫篆半欹竹，鸟窥新绽梅。\n雨霁青峰出，云深白雁来。\n柴门春酒熟，客到肯停杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖霞春游见怀次吴自湖韵","author":"黄佐","text":"栖霞展瑶席，飞盖淩矞云。\n虹涧溯清濑，鹤台飘紫氛。\n风和鸟语合，日丽江烟分。\n自笑匪逋客，山庭休勒文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日迎宫詹召命出驿见杨柳有感","author":"黄佐","text":"元日迎君召，恩光与岁新。\n即看杨柳色，同遇太平春。\n白日明长道，轻烟净素尘。\n汉廷思羽翼，园绮乐称臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用兵河套二首 其一","author":"黄佐","text":"昔日开平将，长年髀肉消。\n黄河屯地险，白草隔天骄。\n河套深藏马，阴山远射雕。\n受降城上月，曾照霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用兵河套二首 其二","author":"黄佐","text":"定鼎燕京后，胡烽照范阳。\n留屯无板屋，住牧有牙璋。\n转饷归朝遍，鸣箛入塞长。\n墩台绝征旆，徒尔遣边郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春阴诵杜诗有感","author":"黄佐","text":"鸟得春光早，花因日色迟。\n诵公诗自得，嗟此意谁知。\n隐几瑟绵裌，销愁仗酒卮。\n风寒氛祲里，灵雨到何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春寒二十韵","author":"黄佐","text":"朔气经春在，湘帘尽日垂。\n帝城天最近，宫漏晓犹迟。\n瑟缩追趋地，凄清儤直时。\n柳边闲夜月，花下爱朝曦。\n沆瀣凝金掌，香烟散玉墀。\n螭头攒彩仗，雉尾拥青旗。\n骚屑闻鸡树，萧疏见凤池。\n出门饶裋褐，归路怯涟漪。\n憺似无能语，浑疑有所思。\n紫山应奏籁，黄竹浪传诗。\n怅望扶光远，低回淑景移。\n梁间看燕并，韝上念鹰饥。\n冀马拳毛竦，奚童败絮知。\n情深晨露曲，兴剧白云司。\n蚁绿空持酒，猩红未满枝。\n小炉愄榾柮，深户闭扊扅。\n未觉头如鹤，相怜手不龟。\n行行离塞雁，脉脉向阳葵。\n闲寂过燕市，虚无浴鲁沂。\n愿回寒谷暖，邹管莫休吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酒中对坡山赠何东崖太守","author":"黄佐","text":"展却经纶即挂冠，林泉惟恐旧盟寒。\n青山终日捲帘坐，明月有时邀客看。\n洞里紫烟浮棨戟，尊前苍玉绕阑干。\n兴来彩笔裁诗就，应是清平有凤鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五坡岭文山丞相表忠祠","author":"黄佐","text":"间关炎岭奋霓旌，谁道平胡竟不成。\n三户有人消楚恨，八公无险慑秦兵。\n魂随精卫填南海，碧化苌弘向北平。\n正气到今凝不散，年年花鸟自江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登栖霞山赠冯宗典","author":"黄佐","text":"松涛千顷静中闻，渺渺虹泉带白云。\n九日风烟同缓步，十年情事入微曛。\n机关应世谁能悟，影响谋生各欠勤。\n归路不妨城径远，碧天留月待夫君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都门饯江约之南归","author":"黄佐","text":"都门疋马愿行迟，折柳相看鬓未丝。\n多事北风消客醉，尽情南菊待吾诗。\n鸠声唤雨何寥廓，龙气成云太陆离。\n畎亩未须忧岁事，傅岩勋业欲深期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉诏抡材遇微雨有感","author":"黄佐","text":"青冥华盖接金台，喜听纶音扈阁开。\n天外骥群来万里，日中鹑羽度三台。\n扶抟细逐南薰起，优渥潜从北极来。\n采菲岂堪承圣泽，挥毫惟愿颂昭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏书灯","author":"黄佐","text":"午夜文虹彻绛纱，缥缃丛里客京华。\n风尘鬓短频看影，乡国情深忽见花。\n阁上藜光思往事，马前莲炬送谁家。\n唤回一枕朝天梦，兰灺初销闻曙鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻鹤","author":"黄佐","text":"茶鼎初生一缕烟，叠琴无处觅胎仙。\n瑶台有路归何日，华表遗踪说往年。\n玉树风声生蕙帐，霞峰月色映芝田。\n扁舟更到梅花路，应在罗浮洞里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早秋即事","author":"黄佐","text":"玉露无端下碧空，飞飞霞鹜望何穷。\n人游禁籞千花里，秋在梧桐一叶中。\n冰簟梦回犹客暑，云屏声动忽雄风。\n豳图赋就无由达，还待鸣珂紫殿东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何子鱼侍御按湖广","author":"黄佐","text":"澄清天下几封章，揽辔今聊泽一方。\n豸角晓辞燕禁月，骢蹄秋度郢门霜。\n穷檐历历皆身事，佳气葱葱况帝乡。\n握手顿成经岁别，都门南望柳烟长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋宿和廖鸣吾","author":"黄佐","text":"龙池花木锁春阴，静向环中一洗心。\n隐几绪风传促漏，开帘孤月出遥岑。\n歌翻清庙无疏越，梦入钧天有大音。\n却忆卜郊虚二载，紫坛今喜翠华临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李一凤次见寄韵","author":"黄佐","text":"洛下风尘双短鬓，梦中山雪一长镵。\n谋身自笑屠龙拙，应俗谁嗔看鸟贪。\n归去心情闻作赋，别来颜色见开缄。\n夜阑忽有思君句，吟倚梅花与月参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冰泮志喜赠徵仲","author":"黄佐","text":"晏岁长歌行路难，兰桡今喜出冰滩。\n霞杯绮席春初并，浴鹭飞凫晓共看。\n茅屋待归花未老，凤楼回望雪初残。\n酒酣却忆追趋地，谁在彤墀白玉阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂对雨","author":"黄佐","text":"一亩宫墙傍翠微，雨中吟望澹忘归。\n烟深石洞苍苔入，水满银塘白鹭飞。\n室已罄悬仍爱酒，身如柴立强胜衣。\n穷愁消尽缘何事，九陌尘清万井肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后闻梅花香甚走笔二首 其一","author":"黄佐","text":"江南春事到烟山，冷蕊疏枝渐可攀。\n帐底忽惊香满席，梦中真见玉为颜。\n啾啾翠羽翻珠缀，历历星榆挟佩环。\n玉宇霞窗相映晓，始知天上即人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦后闻梅花香甚走笔二首 其二","author":"黄佐","text":"罗浮清梦正深期，东阁当年忆赋诗。\n枝上一阳回白雪，膝边三弄协朱丝。\n彤云有影承金殿，湛露无声下玉墀。\n移植若从升北极，暗香应绕万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂江秋怀借养斋方伯韵奉寄","author":"黄佐","text":"桂江水高三尺强，秋来鸿雁相回翔。\n鸣桡捩柁亦何意，枫叶芦花俱可伤。\n苍梧望断粤云白，沧浪歌罢湘烟长。\n会须万里去寥廓，嗟尔罻罗空自张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉谂养斋再用前韵","author":"黄佐","text":"江湖同病羡君强，霄汉何由并尔翔。\n方茂云深归梦杳，粤台花近客心伤。\n青春已共蛙声老，白日潜随燕羽长。\n东阁捲帘诗景里，挥毫应续艾如张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王子尚使事归省","author":"黄佐","text":"外史輶轩出帝乡，莱衣惟恐负春阳。\n重闱向晓占乌鹊，下里迎风拜骕骦。\n殿上朵云常咫尺，阶前兰玉有辉光。\n交河之水流无尽，得似君家爱日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阳陈氏墓祠","author":"黄佐","text":"十亩园林一径斜，玄堂灯火太丘家。\n秋声半在稍云竹，春泪多逢带雨花。\n远慕可能忘伏腊，幽栖非复为烟霞。\n月明想像慈颜在，愁绝淮阳几树鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘尚宝代祀海上","author":"黄佐","text":"紫宸衔命出符台，剑气峥嵘拂曙开。\n望祀正修虞舜典，壮游那负汉迁才。\n春帆带雨应千里，祖帐临风更一杯。\n文采承家今不忝，青藜高阁待君回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同何古林登玄览台","author":"黄佐","text":"此日登台笑语时，依然云影在江湄。\n闲云出岫真何意，逝水如斯岂自知。\n世道行藏惟与尔，舞雩童冠更须谁。\n台前多少淩霜树，一任和风取次吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘助教判夔府","author":"黄佐","text":"夔府雌涂望倅车，桥门衿佩拥除书。\n传经刘向情无厌，化蜀文翁泽有馀。\n飞鹢忽看天作练，卧龙犹说草为庐。\n知君露冕行春处，应有新诗锦不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送门人江应霄北上","author":"黄佐","text":"江淹声价起湟川，羡尔乘舟向日边。\n金阙曙钟趋午夜，玉河春色动新年。\n衣冠总向南宫集，姓字还从北阙传。\n旧日授经今不忝，承恩人道是儒仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张叔显尹博白","author":"黄佐","text":"陌上薰风吹绿杨，珠江西转入梧长。\n白州此日优为令，青史他年定数张。\n留犊清名传梓里，蟠龙秀色胜桐乡。\n水东往事看前辈，豸绣还飞六月霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁思伯送瑞香花二株赋此答之","author":"黄佐","text":"晓坐前荣噏日华，扣门欣见瑞香花。\n即移双树依丹桂，何异三珠在绛霞。\n琼蕊遇寒添旖旎，翠蕤随照肯欹斜。\n蔫然笑对冰霜里，先得春阳向海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林惟乔送糟鲥鱼","author":"黄佐","text":"旅食吾曾侍禁垣，鲥鱼当夏足盘飧。\n十年梦隔山龙阙，腊月缄来海隺村。\n风味有馀惟曲蘖，馨香无减似兰荪。\n野怀却忆江门句，炒蚬犹堪奉至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日口占","author":"黄佐","text":"清晓遥遥祝紫宸，东风吹佩鹤随身。\n尊前莲蕊浓于旧，墙角梅花冷更新。\n畎亩寸心丹向日，尘涂双眼白看人。\n闭门且续罗浮志，收得天南一洞春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月二日得黎婿惟和书报除大行人喜甚口占俚语录似惟敬惟仁","author":"黄佐","text":"去年屡得金台信，今日真闻王节行。\n兄弟夔龙应接武，山林巢许亦欢情。\n登楼每见青天近，览镜从教白发明。\n知尔北园多雨露，梦回春草满池生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦游罗浮作","author":"黄佐","text":"银殿瑶池尽列仙，良常西入耀真天。\n霞随葛令飘青玉，雨为麻姑洒白莲。\n符竹萧萧桃洞月，星松袅袅石楼烟。\n苍龙溪上山卿梦，又度清宁二百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈惟功掌教临桂","author":"黄佐","text":"漓山百丈即蓬莱，碧玉青萝画里开。\n濂洛以南源桂岭，潇湘之北到金台。\n光风好在窗前草，春信应传陇上梅。\n我昔骖鸾归万里，汝今鸣铎彻三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登玄览台留客赏菊梦中作","author":"黄佐","text":"天风吹袂上高台，无数黄花照眼开。\n飞盖路从云外出，盍簪人自日边来。\n十年往事翻如梦，一笑相逢共此杯。\n醉后整冠频北望，凤城烟树正低回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续王冕梅花诗梦中作","author":"黄佐","text":"猎猎北风吹角巾，巡檐索笑转相亲。\n疏枝交影长疑雪，冷蕊含香似养神。\n月下径蹊偏胜晓，水边篱落暗传春。\n相思一夜罗浮梦，隔陇惟应寄远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦中九日寄怀郑世穆作","author":"黄佐","text":"九日清斋深忆君，往年曾共醉论文。\n箧中乌帽负黄菊，门外青山间白云。\n独鹤依依何意舞，宾鸿渺渺几时闻。\n黄金台上一翘首，神骏惟应空冀群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日草堂雅集次李少藩韵","author":"黄佐","text":"草堂春满径三三，俯仰无言妙与参。\n燕塞朔鸿天外杳，粤台新绿镜中含。\n只今云谷谁元晦，终古龙门独史谈。\n醉挹和风看活水，咏归真似鲁城南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴自湖迁浙台宪长","author":"黄佐","text":"豸角峨峨出粤藩，刺桐花里竞攀辕。\n维扬树色连棠影，岭海潮声溯浙源。\n东鲁秖闻吴季子，西湖那见宋王孙。\n华夷此日须匡济，应有封章入禁垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕山田少参将奉表北上以忠孝节义四书见惠题诗其上赋此答赠","author":"黄佐","text":"粤城南望水明霞，薇省移舟观翠华。\n梦入钧天仪彩凤，风回江树听啼鸦。\n琅玕得雨高千仞，荠菜逢春胜万花。\n展诵思君何处是，草堂萝月映窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠副总兵王汝贤之广西","author":"黄佐","text":"宾梅视我犹兄弟，节操承家有石川。\n诸葛古亭鱼复阵，山云遗烈虎铨编。\n桂林节镇三千里，藤峡威名十二年。\n知尔思亲明月夜，暗香疏影到窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谷子迁归吴","author":"黄佐","text":"梦到长洲宿莽间，嘤鸣犹似听春山。\n东吴画舫偏堪往，北斗朱旗恐未闲。\n谷永谢书今已达，陆机文赋昔曾还。\n玄冬别汝炎风里，独对前荣细菊斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢梁思伯中舍","author":"黄佐","text":"葛巾吾亦晋时陶，瑶席初开集俊髦。\n醉倚曲池浮晚照，凉从清樾起秋涛。\n苍龙石上张鳞鬣，仙鹤云间下羽毛。\n知是扶抟应万里，夜来风雨动亭皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄南雄章太守接","author":"黄佐","text":"枫山堂构自天开，清白传芳到岭梅。\n舄外淩江涵粤浦，衙前关树赴燕台。\n碧云已共棠阴合，丹壑曾劳驿使来。\n应有凤书传帝简，双旌从此近三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝酒诗奉答麦乔齐","author":"黄佐","text":"轻红重碧酝初开，稚子喧呼洗旧罍。\n草草蔬肴延客坐，纷纷蜂蝶逐人来。\n曲江有赋空凫藻，河朔无诗岂骏材。\n照眼榴花莫相笑，年年那肯独衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿诗次欧彦桢韵","author":"黄佐","text":"供奉当年侍翠帷，只今衰懒掩柴扉。\n池边竹日闻鱼跃，台下松云见鹤归。\n莲醑到冬堪酩酊，草堂因咏更光辉。\n碧山尚觉红尘近，长羡严陵有钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁彦国贺七十一寿次韵","author":"黄佐","text":"榣山瀛海一愚臣，竹叶椒花百病身。\n年过古稀犹似健，运逢今圣已维新。\n悬弧日每随南至，恋阙心长望北辰。\n聊傍粤台开小隐，只从庄叟问灵椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄制太仆主簿","author":"黄佐","text":"绿槐萧萧迁谷莺，越门酌别趋燕城。\n龙光久矣耀丹极，骏足今惟朝紫清。\n黄霸勋名见远到，曲江风度逢升平。\n弹冠此去听囧命，满岭梅花随袂馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]