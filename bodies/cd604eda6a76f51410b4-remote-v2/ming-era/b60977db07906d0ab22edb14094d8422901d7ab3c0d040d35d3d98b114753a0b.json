[{"title":"窦家道中","author":"张子翼","text":"石城石磴何崔嵬，宦辙凌风费卷帏。\n峻礕临江开径小，弧村带垒聚民稀。\n苍茫渔船含秋雨，窈渺禽声入翠微。\n谁叱王阳经九折，错分忠与孝相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代家父赏菊","author":"张子翼","text":"花情最与逸相宜，十月霜风挟雨披。\n时序惊心频北顾，老夫即事向东篱。\n落英细数看云久，尊酒同倾对客迟。\n处处年年拚著汝，东西南北任吾之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梧州喜报家君至陆川","author":"张子翼","text":"独行羁旅不遑将，讵意承颜此宦乡。\n阑烛再烧疑是梦，彩帘初舞恰生狂。\n三孙提抱骇还笑，五载慇勤短更长。\n闻道畏途今且慰，矢心何以报穹苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宴印唐宅留题","author":"张子翼","text":"丝桐自昔向知音，过柳穿塘一径深。\n洞口攀桃惊犬吠，山门弄月傍花阴。\n幽怀未展棋双局，独酌何妨酒半斟。\n旅邸轩楹多徙倚，思君不见发狂吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"印唐宅效首尾吟","author":"张子翼","text":"看竹何须问主人，东风和煦草堂春。\n如屏天远诸峰出，傍户声幽一鸟驯。\n池向山头分月晓，石于花圃绣苔匀。\n眼前佳景宜行乐，看竹何曾问主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎春即事","author":"张子翼","text":"露冕寻芳晓出封，淡桃细柳露华秾。\n人逢岁首春偏富，鸟啭枝头花正浓。\n便遗佩刀来买犊，尽令编甲去归农。\n旬宣近喜民风胜，饱煖讴歌处处逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"藤县中即事","author":"张子翼","text":"径转田隈小竹篱，老翁七十自扶藜。\n烟笼古柏迷村火，云拥前山失酒旗。\n马历崎岖缘事棘，饭甘藜藿为民疲。\n藤江仆仆重经地，松岭轻阴粤鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆川六景 其一 温泉潴暖","author":"张子翼","text":"三台山下沸温泉，泉上芳亭夕照悬。\n宝鼎香浮浓带雨，石泓春暖瑞生烟。\n炎荒气候原多热，寰宇洪炉信有天。\n不用邹生来协律，融融生意足蓝田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆川六景 其二 分水清环","author":"张子翼","text":"云气秋深薄鹭汀，春风岸柳拂沙明。\n山从穿石分源迥，水入空江到海清。\n九曲菁茭诸派合，三台楼阁远峰迎。\n粤南到此真形胜，如带关河拱帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆川六景 其三 后阳叠嶂","author":"张子翼","text":"后阳山上郁岑岑，万籁松篁接洞阴。\n城市烟云相结带，山河表里尽交襟。\n金汤虎豹横关塞，玉柱风岚变古今。\n谁道陆川非陆海，凭虚回首一登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆川六景 其四 前台列屏","author":"张子翼","text":"文芒星宿列三台，鳌极方舆控海开。\n画案云横青嶂合，锦屏天远碧峰回。\n灵洲已向南中出，间气遥从北极来。\n自古嵩高能毓秀，笃生申甫济时才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆川六景 其五 西凤朝阳","author":"张子翼","text":"高岗西望产梧桐，仪羽婆娑讶许同。\n象郡有山皆拱北，凤台无日不朝东。\n彩悬苞竹千寻起，云拥扶桑五色笼。\n并峙云龙终不改，遥看剑阁淬天雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆川六景 其六 谢仙飞瀑","author":"张子翼","text":"昆崙源水碧嶕峣，瀑布千寻界鹊桥。\n原有锡飞生羽翰，扔怜仙掌出云霄。\n琪花未老桃先实，瑶草方苓杏已条。\n自是山灵通望气，嵩呼千载祝唐尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与李瑶泉甘文峰月夜投壶会饮因携游赋此","author":"张子翼","text":"菖蒲初泛舟中绿，甘荔新传席上丹。\n千里月来今夜共，百年壶送此杯宽。\n江云独纵南州远，剑气双侵北斗寒。\n酒罢不禁还秉烛，楼头容数四更残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄符敬所","author":"张子翼","text":"郑野多年喜御君，忆从馆谷夜论文。\n垂纶水向石中落，扣角声从陇上闻。\n藜火三冬劳旧梦，斋居百里望停云。\n江村寂寞江天晚，欲借园林春几分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与谢昆阳唐舜封游天宁寺","author":"张子翼","text":"拂羽林中耽白昼，归云海上阁青山。\n偶从郭外逢知己，便向禅林大说还。\n松影清留孤鹤瘦，洞门深锁一僧閒。\n追陪盛会缘非偶，细数虚名一笑间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中迎川见访","author":"张子翼","text":"雁薄西风拂晓霜，故人车马自丈乡。\n山中带雨遥催旆，竹径呼童笑倒裳。\n念旧独惊风木苦，摊诗不觉水云长。\n东篱漏得春消息，冉冉韶光是小阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李南薰见访","author":"张子翼","text":"雨涩凉生海峤秋，石床花径晓云浮。\n清尊此日逢知己，策杖人间岂浪投。\n独向先天分造化，远从孤屿觅丹丘。\n林间拚作堪舆子，欲向松筠结晚俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再寄迎川","author":"张子翼","text":"客去迟迟主脍鱼，催诗中酒共春初。\n高怀不觉老来壮，即事看移忙里书。\n乔谷阴浓莺得意，药栏花茂蝶先舒。\n知君兴溢彭宣外，祇恐安昌愧草居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓建江月夜闻笛有怀甘文峰","author":"张子翼","text":"隔邻风度入帘声，午夜堪怜月色清。\n杨柳翩翩回海岱，梅花历历动江城。\n青衿咫尺何千里，碧浪三秋是五更。\n欲尽曲中无限意，须缘歌扇再班荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭甘文峰","author":"张子翼","text":"解绶归来鬓未华，逍遥岁梦忽惊蛇。\n玉楼独擅修文手，沧海谁怜绮季家。\n百里韶光留橘荫，五更风雨惜荆花。\n登堂念旧人何在，拭泪临风祇自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄汝钦宅上","author":"张子翼","text":"幽居正喜尘嚣远，出谷谁云生事稀。\n芳草留人清露湿，莺花近眼暖风微。\n林间蕉鹿看成梦，海上沙鸥羡息机。\n信宿话君多感慨，石家金谷野禽飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋经莫东山旧宅","author":"张子翼","text":"竹径榔阴忆夜分，主翁扫榻细论文。\n独怜碧水今黄土，祇有寒山对夕曛。\n沧海常连三伏雨，晴风不改四时云。\n古今聚散寻常事，瞬息黄粱独慨君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次张业白韵二首 其一","author":"张子翼","text":"何须绝岛问蓬瀛，水碧山青护草楹。\n夜月半将松影度，春风细捲钓纶轻。\n渊明松菊惟高枕，范蠡渔舟祇避名。\n黄鸟年来旧相识，绿阴时送隔溪声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次张业白韵二首 其二","author":"张子翼","text":"世事清消一健忘，道心随处浴沧浪。\n偶逢洞口刀圭诀，因识山中岁月长。\n百里棠阴分雨露，十年歧路叹膏粱。\n凭谁尚友崆峒子，比屋于今共挽唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邀甘程二丈人","author":"张子翼","text":"池上新亭独倚栏，自临钓石俯云湍。\n赏心谁是高阳侣，阅险频催杜甫鞍。\n濛雨细侵花径滑，停云浓带旧山寒。\n凉风摧折阶前笋，惊作故人车马看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次张业白见访二首 其一","author":"张子翼","text":"晓骑凌风乘兴长，倒裳独笑主人忙。\n感君旧是玄真侣，惠我兼遗肘后方。\n岸转渔歌横落日，春留燕语背斜阳。\n匏尊却羡江亭好，独愧高人元漫郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次张业白见访二首 其二","author":"张子翼","text":"老去诗篇次第裁，兴来鱼鸟莫相猜。\n谷盘徐有松花落，径远惟宜隐者来。\n叩角有时歌白石，看花随意踏苍苔。\n莫将转盼论陈迹，百岁相看能几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登竹峰员墩书馆","author":"张子翼","text":"松风拄杖访蓬瀛，傍竹青青结草楹。\n水绕灯花山馆静，江含秋色岛云清。\n每从盘谷耽幽隐，更向匡庐续令名。\n林下观鱼春睡足，频听午夜有书声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再勉馆中诸郎","author":"张子翼","text":"松篁隔水护书台，年少从今万卷开。\n笔付江淹添五彩，文追燕许上三台。\n郎于灯下知勤读，翁向江头口纵杯。\n诸暨源流今拟续，不论荀氏有群才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石圃荣归","author":"张子翼","text":"渊明秋日赋归来，书剑萧萧度粤台。\n半亩林塘三径在，五湖烟雨一尊开。\n梧山云尽棠阴远，桂水天空雁影催。\n戏彩有衣熊未梦，祝君拟泛庆儿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺陈少云诞子","author":"张子翼","text":"春时十月转江梅，蓬矢初惊诞日开。\n降岳英声钟海岱，充闾喜气动楼台。\n歌传瓜瓞环珠履，庆溢萱堂泛紫杯。\n正拟古人何所似，眉山秀出小坡来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜席书美人便面 其一","author":"张子翼","text":"瓜入东陵五色饶，翛然青鸟下云霄。\n琼楼不用寻三岛，铜雀何须数二乔。\n尽道扁舟归范蠡，谁知金屋醉阿娇。\n丝桐独解无弦意，杜若芳洲忆楚骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜席书美人便面 其二","author":"张子翼","text":"酒换灯花载草堂，醉乡不觉倚新妆。\n舞筵灿烂知倾国，歌馆轻盈羡绕梁。\n不用斗杓倾子夜，何妨云雨妒朝阳。\n湘妃无恨怀沙意，欲向尊前学楚狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄齐兰野三首 其一","author":"张子翼","text":"丝桐松下访知音，药甲青云一径深。\n祇谓龙骧閒豹略，谁知城市隐山林。\n诗吟子建须拚酒，赋薄长卿祇为金。\n拟泛虚舟期汗漫，萧然世味一何心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄齐兰野三首 其二","author":"张子翼","text":"岁晚看君共卜邻，青山带郭正宜人。\n终疑绮里曾归汉，谁似桃源早避秦。\n阶下兰孙真次第，山中岁月太因循。\n星辰昨愧从游地，江汉今谁笑隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄齐兰野三首 其三","author":"张子翼","text":"闉阇得汝频开径，南北驱人错问津。\n五柳逍遥彭泽外，三闾憔悴楚江滨。\n消除岁月惟尊酒，寄傲乾坤祇钓纶。\n莫道太平无补事，陶唐须有葛天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄竹峰","author":"张子翼","text":"元春雷雨动扶摇，对雨知君逸思飘。\n种玉阶前耽昼永，争梨膝下看孙骄。\n塘陂命辔多防滑，江浒倾尊不费邀。\n病骨年来惟伏枕，可能穷巷一回轺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元宵会饮昆季草堂","author":"张子翼","text":"星桥元夜转新晴，节序人间万炬明。\n满座催花荆树合，半尊迟月斗云横。\n病怀不觉三分减，酒令须教万斛倾。\n已报金吾弛夜禁，流连直待晓钟声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴梨园请书便面诗以付之","author":"张子翼","text":"十载飘零滞远游，此生天地一虚舟。\n春随歌扇人留榻，舞尽花妖客上楼。\n抚景从容登海峤，怀乡汗漫认并州。\n行边莫折章台柳，自古闺人咏白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日寄舅弟贞宇","author":"张子翼","text":"历历秋旻隐翠屏，高轩何处隔江城。\n山斋寂寞天涵影，谷口清泠涧有声。\n听雨悬灯蛩自语，看云倚槛句还成。\n不嫌地僻回车马，肝鬲拚为信宿倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至蚬冈用戴公韵","author":"张子翼","text":"岧峣行尽蚬冈头，李郭同登泛渚舟。\n会有乡书频寄雁，原无机事不惊鸥。\n水归沧海潮偏急，岸隔渔歌思转幽。\n月小山高真赤璧，烟波杜若采芳洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九峰寺用壁间韵","author":"张子翼","text":"古寺周旋思更悠，十年怀抱此登游。\n山寻绝巘云盘阁，僧入参禅月满楼。\n石磴列屏环且秀，小桥通径曲还幽。\n却惭无念瞿昙子，一衲传灯何所求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与医士蒋南山夜话","author":"张子翼","text":"绿盖亭亭月色深，草堂留榻玉河沉。\n炉传丹鼎知文武，经授青囊破古今。\n萍水看君多旧梦，金篦刮目是神针。\n炎州自古钟瑶草，莫动匡庐夜雨心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题何武库悔斋图","author":"佘世亨","text":"闻有大人仙，幽居傲岩麓。\n清宵餐沆瀣，白日甘黄独。\n年少焚银鱼，三冬万卷足。\n白眼世途人，黄粱几时熟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与丘止山登高明亭","author":"佘世亨","text":"群阴渐以尽，微阳入短楹。\n岸帻观云物，悠然同丘生。\n所志岂凡近，谁甘绊浮名。\n睥睨寰宇中，沧浪濯吾缨。\n仰天诵九歌，答尔万里声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆金陵","author":"佘世亨","text":"天作兴王地，神工岂偶然。\n潮从东海入，山与石城连。\n绣幕开朱户，笙歌拥画船。\n风流佳丽地，忆别又经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游香山","author":"佘世亨","text":"地接宸光近，山高王气浮。\n青云连紫禁，白日照丹丘。\n阁俯中原极，河分大泽流。\n出关行欲去，策马且夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过承天府","author":"佘世亨","text":"郢中今代邸，王气昔来多。\n宫城自盘踞，陵庙郁嵯峨。\n月下衣冠出，风前钟磬和。\n野臣瞻望处，天保几回歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄唐内翰","author":"佘世亨","text":"北望蓟门迥，龙楼旭日边。\n我惟山泽老，君竟玉堂仙。\n魂梦常千里，音书动隔年。\n行藏各随分，知有故人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄沈懋学","author":"佘世亨","text":"遥忆青门子，西湖久客年。\n孤山调玉鹤，龙井试新泉。\n洒落黄公望，风流葛稚川。\n相思空有梦，衰病更谁怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与欧敬斋夜酌高道士炼室","author":"佘世亨","text":"江柳依依水国春，眼中时序一番新。\n未誇石室逢仙客，且喜临邛有故人。\n酒盏浸消千古恨，莺花聊伴百年身。\n韶光转瞬须臾事，莫漫停歌泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州登高","author":"佘世亨","text":"薄暮孤城逸兴催，远寻天半九成台。\n风烟水石无今古，鱼鸟帆樯自往来。\n去国未留王粲赋，悲秋空羡宋生才。\n迂痴老懒霜凝鬓，惭对黄花满径开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿紫霄宫","author":"佘世亨","text":"欲从真境觅佺僼，暂借云窗卧野翁。\n今夜石床青蕙帐，十年云梦紫霄宫。\n帘栊影落松虬月，殿角寒吹铁马风。\n隐几吟馀方就枕，榔梅花外几声钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日过黎氏清泉书院","author":"佘世亨","text":"冉冉春云覆短墙，洞门天远自风光。\n红桃碧柳山初暖，翠竹黄鹂昼自长。\n南国阳和生瑞蔼，西风浩荡送幽香。\n小车莫厌频来往，几度寻芳恣老狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠霍职方佥宪桂林","author":"梁柱臣","text":"燕郊木叶下，大漠氛埃灭。\n空门一樽酒，远送万里别。\n远别欲何之，桂岭炎荒绝。\n之子吾粤才，高视信雄杰。\n赐环蒙主恩，推毂冠朝列。\n玄成有世绪，嫖姚袭芳烈。\n肮脏多父风，倜傥见臣节。\n明当历长途，绝足任驰轶。\n暂违司马署，肃秉宪台臬。\n高议自风采，奇勋待明哲。\n执手念当乖，临岐怅劳结。\n何以慰相望，铜柱表巀嶭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喷玉岩","author":"梁柱臣","text":"层峦合沓岚烟簇，玉虹卧断苍山隩。\n晓吸沧江百尺澜，却向岩前溅飞瀑。\n喷沫流珠下翠微，千岩错落散明玑。\n声传石窦逶迤转，白满寒潭历乱飞。\n精融液泄气惨冽，万古清秋长不竭。\n初疑云雨暗巫阳，转讶梁园夜飞雪。\n遥空隐隐半如雷，坐令叠嶂无氛埃。\n直窥素练烟中起，却似银河天际来。\n潨涛汹涌拂绝壑，涧户无风自挥霍。\n触石浮云冻不翻，当窗木叶先秋落。\n落叶亭亭乱晚霏，绝怜空翠湿人衣。\n别有清流断肌骨，龙吟石上涓涓出。\n纷披百道下松门，月明几处翻萧瑟。\n朅来濯足兹山头，恍惚如寄匡庐游。\n水帘石室无溽暑，披襟兀坐清烦忧。\n下看涘溘一长啸，千山日暮断猿愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿黎惟敬借树轩同怀郭山人","author":"梁柱臣","text":"高情怜郭泰，山水寄行踪。\n杖策独归去，深杯何日逢。\n月明残夜雪，风度晓霜钟。\n复此成相忆，迢迢云树重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集梁比部拙清楼对菊","author":"梁柱臣","text":"白水青山秋可怜，碧楼风物敞芳筵。\n交深傲吏形骸外，兴逐词人菊酒边。\n歌罢海云过暝色，坐来檐月挂寒烟。\n更为后会知能几，江海萍踪各渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别燕京作","author":"梁柱臣","text":"烟郊立马独踌躇，去国身悲万里馀。\n燕市春光何日醉，潞河杨柳病中舒。\n高台寂寞曾招骏，沧海归来拟钓鱼。\n谁向周南叹留滞，风尘一望正愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓登甘露寺览眺","author":"梁柱臣","text":"北固斜临铁瓮城，南徐烟树望中平。\n山横海气诸陵色，江咽寒潮万里声。\n书断梁碑无旧迹，寺荒吴构尚初名。\n不须更说兴亡事，满目云霞无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别诗 其一","author":"梁柱臣","text":"揽别如昨日，桃花空复春。\n盈盈川上月，好为照征轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别诗 其二","author":"梁柱臣","text":"江风吹行色，游子惨不发。\n恶见秋鸿飞，双双楚云没。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]