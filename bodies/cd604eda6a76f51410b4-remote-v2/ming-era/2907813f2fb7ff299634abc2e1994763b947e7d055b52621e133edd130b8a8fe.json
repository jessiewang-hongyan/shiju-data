[{"title":"海山秋思图为乐清邬知县赋","author":"林弼","text":"写得新图记旧游，无穷诗思海天秋。\n白云黄叶浑相似，雁荡山前思远楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33697,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题凤山图","author":"林弼","text":"青沙白石草离离，万仞苍崖瞰碧漪。\n凤鸟秪今鸣嶰谷，朝阳未老碧梧枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33698,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题朱孟辨临文与可墨竹","author":"林弼","text":"胸中千亩老陵州，用写西风一树秋。\n咄咄逼人青琐客，时来泚笔凤池头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33699,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题王章红梅","author":"林弼","text":"妖娆暂借杏桃色，铁石终存冰雪心。\n额粉风飘妆镜尽，脸霞春酒入杯深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33700,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题危中书所藏和靖墨迹 其一","author":"林弼","text":"旧书迢遰谢相过，何日重来共晤歌。\n笼鹤不飞茅屋静，西湖十里月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33701,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题危中书所藏和靖墨迹 其二","author":"林弼","text":"湖上题诗衲袂分，梅花千树雪纷纷。\n明朝飞锡知何处，雁荡山中一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33702,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题危中书所藏和靖墨迹 其三","author":"林弼","text":"翡翠湖边迹已荒，凤凰池上墨犹香。\n炉熏清昼开诗卷，宛见孤山旧草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33703,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题竹间清逸图","author":"林弼","text":"流水柴门万竹秋，玉人还似晋风流。\n瑶琴一曲潇湘雨，隔浦渔翁正倚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33704,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅雀图","author":"林弼","text":"一树寒梅花的的，两三冻雀羽离离。\n上林鳷鹊春如海，谁为东风借一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33705,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师夔令尹作树石图以寄其友黄君复纪别时之景也阅而有赋二绝 其一","author":"林弼","text":"杨柳江头送客归，暮潮初落见渔矶。\n画图无限怀人意，云树依依又夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33706,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师夔令尹作树石图以寄其友黄君复纪别时之景也阅而有赋二绝 其二","author":"林弼","text":"画图诗句两清新，远向邮筒寄故人。\n惆怅宿云双墨桧，碧纱零落满埃尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33707,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题山窗秋色图","author":"林弼","text":"青山点点雨初过，黄叶潇潇霜已多。\n惆怅美人秋水外，晴窗掩卷奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33708,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书罗彦周画扇","author":"林弼","text":"流水高山独抱琴，挐舟有客识弹心。\n小楼一曲猗兰操，黄叶西风秋满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33709,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冯性之以顾定之墨竹寄其友方时举题曰清风来故人索赋一绝","author":"林弼","text":"故人别去每相思，修竹清风若见之。\n凤鸟不来春又暮，湘云吹断玉参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33710,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为袁能伯宪使题墨竹","author":"林弼","text":"亭亭玉节拂云霄，坐觉清风瘴雾消。\n拟奏钧天筒十二，虞廷此日听鸣韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33711,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题方壶子墨竹","author":"林弼","text":"方壶仙子御风还，云外珊珊响佩环。\n吹彻凤笙山月冷，参差玉管落人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33712,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜梦亡友林伯永有风宪之除觉而赋此","author":"林弼","text":"青袍白面旧参军，风宪新除死后闻。\n清梦觉来清泪集，屋梁落月白纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33713,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题熊自成双鹤图","author":"林弼","text":"海上归来岁月迟，懒随青鸟度瑶池。\n一双清泪秋霄月，莫遣云中仙子知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题柯敬仲墨竹","author":"林弼","text":"宣文博士老丹丘，戏写潇湘一段秋。\n留向竹山隐居处，虹光夜与剑光浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杏林图为丰城杨从善题","author":"林弼","text":"昔年曾说董仙翁，种杏成林烂熳红。\n多少活人阴德在，枝枝叶叶总春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题黄尚英墨竹","author":"林弼","text":"竹山万个碧琅玕，喜向仙家画里看。\n午夜凤台吹玉管，不知风露逼人寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为张叔同题江城送别图","author":"林弼","text":"双剑江头春水生，浦云村树总关情。\n观图忽忆曾游处，倚棹渔村听笛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题熊自成红梅","author":"林弼","text":"飘残额粉见朱唇，杏艳桃娇谩妒人。\n解得花神留恋意，枝南枝北一般春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"藤州","author":"林弼","text":"江月楼前江水深，玉人曾醉古藤阴。\n雪堂归去无消息，半亩荒亭千载心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题黎省之唐马","author":"林弼","text":"嗅地低回欲衮尘，玄云散彩五花新。\n蹴冰不识交河道，刍豆相从愧圉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为王彦举题听雨轩图","author":"林弼","text":"山窗酒醒梦魂清，竹外松边点点鸣。\n蒲涧寺前千尺瀑，都随黄叶作秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石泉操","author":"林弼","text":"白石凿凿兮清泉泠泠。\n可洗吾耳兮可濯吾缨。\n援吾琴兮发希声。\n玉琳琅兮金琮琤。\n泉有鱼兮龙出听。\n嗟若人兮耳厌秦筝。\n石泉曲兮邈千古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望云亭辞","author":"林弼","text":"青山兮白云，怅予望兮远人。\n望远人兮不可见，目渺渺兮海垠。\n鄱之山兮泉之水，云孤飞兮心千里。\n临华亭兮奈何，望有极兮思无已。\n云之归兮芒砀，蹇游子兮悲故乡。\n云之出兮太行，渺亲舍兮天一方。\n松楸摵兮霜露下，宛在目兮愁予。\n云兮云兮其作霖雨，望复望兮毋使我心苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风树亭辞","author":"林弼","text":"袅袅兮秋风，树摵摵兮声未终。\n风之声兮在耳，子之思兮曷穷。\n松楸凄兮霜露下，亲不见兮愁予。\n三釜贵兮谁为荣，抱兹痛兮终古。\n彭之坡兮何长，彭之亭兮树荒。\n荒播兹风兮千载，庶锡类兮不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梁溪辞","author":"林弼","text":"梁溪之水兮其流溶溶。\n浅有蒲荷兮深有鱼龙。\n泛予舟兮溪之风。\n侣云月兮甘长终。\n䲭夷游兮犹遗踪。\n玄真蜕兮或可逢。\n微斯人兮吾将曷从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"万年欢 赠别陈都事","author":"林弼","text":"问讯东君，又何事、一岁一番归去。\n杜宇声中，撩乱落花飞絮。\n漫向江头凝伫，想无计、可能留住。\n江亭上、况有离人，不禁千种愁绪。\n还思泽国风尘，更谁能、草檄名重藩府。\n旧业都荒，茅屋稻田瓜圃。\n说与风流谢傅，且休把、云山自许。\n应回首、人在丹霞，满庭榕叶莺语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"木兰花慢 送孔子远少府归东瓯","author":"林弼","text":"羡千年泗水，流圣泽、尚淙淙。\n远西引河源，东连岱岳，南下瓯江。\n如君一门簪绂，更风流文彩世无双。\n柳外藏书楼阁，竹间放鹤轩窗。\n弓刀暂尔拥旌幢。\n清誉蔼南邦。\n喜烟净妖狼，滩飞瑞鹅，月静惊厖。\n归去吴钩锦带，想高堂春酒正盈缸。\n菽水清欢未极，风云壮志休降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"木兰花慢 为允元学录寿时戊戌中秋南城溪楼即席分得微字","author":"林弼","text":"秋江水上，花外岸、柳边矶。\n喜满眼晴光，溪云摇曳，山日熹微。\n无限庾楼清兴，一瓢春酒，今夜莫相违。\n幸对月明风细，况逢莼美鲈肥。\n寸心此际念庭帏。\n称寿舞斑衣。\n笑薄宦孤踪，塞鸿海燕，北去南归。\n万顷澄江如练，咏新诗却忆谢玄晖。\n但愿诸公长健，共看千里清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"飞鲸楼诗","author":"释妙声","text":"崇楼言言，上下太清。\n鸣钟在悬，飞鲸是名。\n在昔先民，制器尚形。\n取类相感，用谹其声。\n此方真教，由闻而入。\n诞敷法音，昭我玄极。\n假物以鸣，与世作则。\n震惊大千，群响俄息。\n维此积善，灵僧之宫。\n爰作斯楼，警昏启蒙。\n侯谁尸之，曰沙门惠。\n公胡溃于，成矢誓在。\n躬瞻彼飞，楼峙于东。\n海华䲔在，兹蒲牢震。\n骇苦轮乃，轫音场无。\n碍于千万，年迷者永。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"圭复庵贫乐斋","author":"释妙声","text":"贫非乐也，乐惟道义。\n匪哲弗居，孰云细事。\n室如悬磬，俯仰无愧。\n终身欣然，何忧何惧。\n矧伊吾人，宗自西方。\n一饭候晷，三宿于桑。\n彼上人者，如圭如璋。\n肆求懿德，其居允臧。\n载瞻其居，有琴有书。\n亦有嘉宾，来与我娱。\n草衣藜羹，屡空晏如。\n从吾所好，有乐只且。\n往有钟鼎，弗慎弗守。\n彼有荣观，弗图弗究。\n沦胥以亡，亦孔之丑。\n我作是诗，以咏座右。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒲庵","author":"释妙声","text":"循彼南涧，言采其蒲。\n采之何为，滫瀡是图。\n彼蒲之良，利用为屦。\n载缉载紬，如蓺稷黍。\n我思古人，惟睦之陈。\n克用是道，甚宜其亲。\n我行四方，十年于今。\n母寔有命，余何弗钦。\n乃筑我居，于越之野。\n悠悠我思，朝夕于楚。\n乱离孔怃，山川邈悠。\n岂不怀归，水无行舟。\n爰有清泉，在居之侧。\n既浸既灌，蒲叶嶷嶷。\n蒲叶嶷嶷，蒲生日多。\n母氏燕喜，我劳其何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"藏晖斋诗","author":"释妙声","text":"易贵含章，诗称养晦。\n进德以愚，明道若昧。\n瞻彼曜灵，运无停机。\n匪息于渊，害恒其晖。\n君子则之，以恬养志。\n出处语嘿，弗愆于义。\n继我显祖，庶免以之。\n或升或潜，允也其时。\n其时维何，像季师表。\n骏奔东南，于今有耀。\n世殊事往，手泽尚存。\n天相斯文，佑我后人。\n于乎小子，思绳厥武。\n丕若诒谋，无念尔祖。\n无念尔祖，淑慎其躬。\n爰作是诗，式铭尔胸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟秋胡三首 其一","author":"释妙声","text":"来者靡居，逝者其奈何。\n来者靡居，逝者其奈何。\n岁短意长，乐少哀多。\n遗世独立，岂无其他。\n哀我人斯，营营则那。\n歌以言之，逝者其奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟秋胡三首 其二","author":"释妙声","text":"瞻彼西山，松柏何苍苍。\n瞻彼西山，松柏何苍苍。\n所谓伊人，在天一方。\n至道在兹，怀之靡忘。\n岂不欲往，道阻且长。\n歌以言之，松柏何苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟秋胡三首 其三","author":"释妙声","text":"彼瑶者台，赫赫何人居。\n彼瑶者台，赫赫何人居。\n朝竞纷华，夕已为墟。\n鬼神害盈，乃丧厥家。\n昔为所羡，今可长吁。\n歌以言之，赫赫何人居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送汤漕使赴省","author":"释妙声","text":"冉冉岁云暮，萧萧班马鸣。\n蓐食俟明发，走赴公家程。\n江南足粳稌，我仓今既盈。\n中吴开饟台，转海趋神京。\n国用食为本，均输寄非轻。\n上计选才彦，君今及此行。\n堂堂紫薇垣，冠佩罗群英。\n愿言慎词令，专对贵尽诚。\n江湖渺空阔，冰霰浩纵横。\n岂不念逸乐，王事靡皇宁。\n谖草日已长，春兰亦向荣。\n当思倚门望，庶尽君子情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和感遇并杂诗六首 其一","author":"释妙声","text":"悲风抎黄桑，茇舍依樲棘。\n岁歉儿苦饥，家贫母犹织。\n寒窗秉机杼，卒岁不成匹。\n里胥夜蹋门，叫怒催纴织。\n蹇余晚归田，耕不如神力。\n一饭愧其人，安敢自皇息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和感遇并杂诗六首 其二","author":"释妙声","text":"胡雁乘朔风，矫矫厉羽翼。\n江南稻粱地，异彼阴山北。\n所忧弋者篡，缯缴在寻尺。\n奈何随阳侣，自剪排风翮。\n岂知经罗网，复惧膏鼎鬲。\n本不飞冥冥，于今悔何益。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和感遇并杂诗六首 其三","author":"释妙声","text":"有虞昔南狩，死葬苍梧山。\n帝子泣幽怨，至今竹斑斑。\n重华骨已朽，淳朴何时还。\n我欲往从之，洞庭汨孱颜。\n梦寐奠灵琐，怀椒候其间。\n安得御风去，挥手谢人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和感遇并杂诗六首 其四","author":"释妙声","text":"美利在于人，翕张随所如。\n上焉有好者，天下将同趣。\n宣尼常罕言，防源知在初。\n魏罃问利国，孟子亦回车。\n沛公田舍夫，萧何刀笔胥。\n提剑入咸阳，仅收其图书。\n谋生诫止足，制用自可馀。\n横流竟莫返，举世无宁居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和感遇并杂诗六首 其五","author":"释妙声","text":"西山一何高，草树郁樽樽。\n仙灵此焉宅，尚有秦遗民。\n我欲蹑丹梯，引手扪青天。\n天高迥无极，欲上嗟无因。\n令天若可上，世上那有人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和感遇并杂诗六首 其六","author":"释妙声","text":"乔木岂无枝，高山亦有岑。\n嘤鸣尚求友，我独无知音。\n沉叹和氏璧，掩抑嵇生琴。\n谁令抱奇蕴，恻恻多苦心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题归去来图","author":"释妙声","text":"奋身报韩仇，决策扶汉鼎。\n有怀千载上，慷慨心独领。\n家贫值时变，乐道事幽屏。\n赋诗聊自娱，去县不待请。\n高风振六合，名与日月并。\n朗咏归去篇，犹疑见烟艇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题沧浪醉眠图","author":"释妙声","text":"沄沄此河水，水浑不见底。\n水浑犹自可，水深将没汝。\n舟楫无根柢，风波无时休。\n不如高堂上，饮酒可忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋槐市送人之越","author":"释妙声","text":"日出槐市东，送客槐市西。\n桥边綵舟发，城上夜乌啼。\n叶密春云合，花黄秋雨迷。\n赋诗誉嘉树，长忆若耶溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨","author":"释妙声","text":"密云遂崇朝，飞雨洒高阁。\n萧瑟傍松檐，委迤带烟郭。\n坐来池水满，吟罢林花落。\n已知禾黍秋，不奈衣裳薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贞寿堂","author":"释妙声","text":"翼翼贞寿堂，肃肃贤者居。\n堂上鹤发母，霓裳而霞裾。\n贞节四十年，寿今八帙馀。\n斯堂得嘉名，请试陈厥初。\n母也实氏吴，番有先人庐。\n良人溘先露，生计亦沦胥。\n誓言赋柏舟，那复咏关雎。\n志存杨氏祀，靡暇恤其诸。\n大儿甫六期，小才五月馀。\n辛勤立门户，寤寐课诗书。\n崭然见头角，藉甚多名誉。\n伯为邑大夫，仲随李轻车。\n綵衣日就养，树谖满庭除。\n兄弟进甘旨，夫人御板舆。\n令德兼寿考，此乐复何如。\n瞻彼堂之阴，嘉树郁扶疏。\n上有双凤雏，和鸣自纡徐。\n爵位日以高，禄养日以舒。\n生封有令典，厚积待吹嘘。\n煌煌太史笔，照映百车渠。\n桓楹俯流水，过者式其庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题分金墩次唐元微之韵","author":"释妙声","text":"吾慕管与鲍，结交忘贱贫。\n惜哉以君霸，功烈犹陪臣。\n分金念其贤，多取讵妨真。\n凡今交游者，愿以此义陈。\n吊古访遗迹，岑邱委荒榛。\n踌躇不能去，伫立望夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕","author":"释妙声","text":"七夕已复至，徂暑适云消。\n候虫依砌响，梧桐带露飘。\n双星限河汉，孤月丽层霄。\n歘吸仰灵气，徘徊望斗杓。\n独嗟天路永，空悲清夜遥。\n南飞有乌鹊，惆怅不成桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述古道雪斋","author":"释妙声","text":"黄冈有雪堂，西湖有雪斋。\n胜选不在雪，其人贤且佳。\n苏公天下士，与世寡所谐。\n爱此林下趣，品题自吾侪。\n风流吾家述，好古独兴怀。\n南游得成印，况与秦文偕。\n神交契冥漠，尚友遗形骸。\n积雪遍大野，流水鸣空阶。\n湛妙信可乐，勿愧食无鲑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"樗轩","author":"释妙声","text":"彼樗实散木，三年踰十寻。\n形质虽偃蹇，柯叶自萧森。\n物生各有适，小大在所任。\n敢期当世用，聊致东溪阴。\n清风树下至，和我邱中琴。\n群鸟亦萃止，怀人遗好音。\n各遂天地性，庶当君子心。\n培根在封植，种德务华深。\n逍遥乐其下，永愿辞朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荷花咏","author":"释妙声","text":"彼泽有嘉植，淤泥擢朱华。\n宛在水中央，尘土无由加。\n秀色一何丽，幽气静以遐。\n群鱼戏其下，游蜂亦来过。\n而爱君子心，独立终非他。\n我欲集为裳，佩之以揭车。\n临波托文鳐，遗彼帝子家。\n采莲者谁子，日暮发清歌。\n歌长路且迥，使我一咨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"易安轩","author":"释妙声","text":"丰屋虽万间，所托在寻尺。\n南窗极低小，亦足容我膝。\n知止庶不殆，适性聊自佚。\n邈哉古之人，瞻彼江上宅。\n桑麻被墟曲，榆柳荫沟术。\n有子学书史，有田艺黍稷。\n于焉悦亲戚，且以御宾客。\n赫赫通侯居，荣观亘阡陌。\n持盈谅弗戒，百鬼瞰其室。\n永怀栗里翁，旷达有清识。\n欣赏方在兹，庶用警晨夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄葵","author":"释妙声","text":"庭树鹈鴂鸣，众芳迹如扫。\n爱此承露杯，扬英向晴昊。\n黄中本通理，静退合天道。\n所怀秉明德，非独颜色好。\n陶潜爱佳菊，归去苦不蚤。\n三径已就荒，壶觞亦倾倒。\n邈哉千载上，异代同襟抱。\n揽彼草木微，于焉托幽讨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送沈行恕","author":"释妙声","text":"挟策事行迈，言往五湖滨。\n阴风结山岳，落叶满河津。\n之子忽已远，我怀将焉陈。\n志士惜白日，行客念萧晨。\n况兹艰难际，夺我心所亲。\n中情苟不移，在远犹比邻。\n毋为离别苦，庶以道自珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]