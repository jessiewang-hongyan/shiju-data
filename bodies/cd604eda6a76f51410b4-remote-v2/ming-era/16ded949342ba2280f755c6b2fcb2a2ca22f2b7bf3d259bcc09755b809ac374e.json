[{"title":"夏至","author":"吴与弼","text":"昼雨聊城逢夏至，暮云江右忆侬家。\n东林新箨知成荫，南亩香粳想俵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录诗后作","author":"吴与弼","text":"无事偏宜白昼长，薰风多送午窗凉。\n思家恐有南飞雁，预写新诗待寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王锦衣赠梅圣俞集","author":"吴与弼","text":"早自欧编慕圣俞，晚从汶水得明珠。\n慇勤欲表将军爱，又向思亲锦卷书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"端午前一日作","author":"吴与弼","text":"端午明朝是，乡园此际思。\n南归人未上，北去日随时。\n道远诸孙弱，家贫老母慈。\n荣枯自有分，无使泪空垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写诗后又题","author":"吴与弼","text":"新诗写就即封题，只候河边雁字飞。\n消息定于何日达，梦魂夜夜大江西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临清端午王锦衣馈粽","author":"吴与弼","text":"且食将军粽，休论故国情。\n离家从两月，挈榼任诸生。\n碧艾仍悬户，香蒲可泛觥。\n稚孙嬉作队，谁念日边行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"盗名","author":"吴与弼","text":"实若虚兮有若无，如斯方表圣门徒。\n盗名似我真堪鄙，愧尔昂藏一丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武城对月","author":"吴与弼","text":"一钩清照故园心，独倚薰风又一吟。\n惆怅麦秋今夜宿，诸生共听玉山琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泊武城","author":"吴与弼","text":"长年捩柁棹讴停，淡月疏星泊武城。\n若使九原人可作，弦歌声里拜先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陪天使及王锦衣登陆閒眺取径徐步坐滕家铺绿阴候舟小儿陪二使习射","author":"吴与弼","text":"见说行逢对摺湾，相招取径纵遐观。\n河山指罢仍留射，好似雩坛春服还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登德州梁家庄驿楼","author":"吴与弼","text":"一赏薰风瞰水楼，楼头清兴暂相留。\n明朝知隔几程驿，绿树人家记德州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题德州梁家庄驿馆粉壁四牡聘贤二图","author":"吴与弼","text":"左是皇华右聘贤，苦心于此岂徒然。\n中原万里能无孕，不在商岩即渭边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书姜米巷壁","author":"吴与弼","text":"云山万里去吾庐，萍梗那知此寓居。\n昼梦每便风帐静，夜怀几共月窗虚。\n乐天知命忧何在，安土敦仁爱有馀。\n他日多情时北望，慇勤却忆壁间书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客夜即事","author":"吴与弼","text":"庭户沈沈夜未央，碧天如水月如霜。\n一星为幸何多也，独许寒芒伴耿光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得小陂消息","author":"吴与弼","text":"辞家三见月团圆，几望南云路渺漫。\n忽报遥临桑梓客，晓窗倒屣问平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"移寓宗人建一","author":"吴与弼","text":"素佩行云流水词，一枝何处不堪依。\n慇勤况有吾宗子，小阁虚窗懒正宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题南薰阁","author":"吴与弼","text":"玲珑杰阁面南城，满座薰风解我情。\n玉轸朱丝秋月夕，几回清兴绕虞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题南薰坊寓居","author":"吴与弼","text":"一柏亭亭杰阁西，婆娑厚盖未经题。\n他日哦吟南斗外，时时梦想与云齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10107,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王医士","author":"吴与弼","text":"杏林春色满窗纱，好是当年董奉家。\n我借馀光辉客邸，神功特向众人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10108,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉呈忠国公","author":"吴与弼","text":"翠柏苍松几岁寒，菊窗竹牖共平安。\n百年勋业寰中满，万古声名鼎上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10109,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别文安伯","author":"吴与弼","text":"彤墀执手话绸缪，双砚慇勤谊更优。\n明发青山白云里，龙楼凤阁梦神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10110,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别李尚书学士","author":"吴与弼","text":"神交尺牍比南金，况复雄文重盍簪。\n锦绣欲酬何所祷，和羹慰满四民心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10111,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别彭吕二学士","author":"吴与弼","text":"几陪鸳鹭肆愚言，玉趾频烦坐客毡。\n归梦已随秋兴远，寸心犹在五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10112,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别主客诸公","author":"吴与弼","text":"圣贤事业细曾论，别语谆谆问所存。\n尚友轩中铭座处，纷纷慎勿惑多门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10113,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别孙黄二姻旧","author":"吴与弼","text":"客里情亲孙与黄，夜来归梦绕秋江。\n西风黄菊青山曲，细把平安报旧乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10114,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孙氏丛桂堂","author":"吴与弼","text":"莫说当年窦十郎，君家丛桂互流芳。\n灵台更有天然妙，不待秋风也自香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10115,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孙氏更造八里桥","author":"吴与弼","text":"八里新更通济名，乃知仁者用心宏。\n谁人更续生生德，好共千秋万载馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10116,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十友饯别城东五里","author":"吴与弼","text":"疏顽无以答升平，况辱群英远饯情。\n明日青山回首处，五云遥忆读书声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10117,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重宿通州驿馆 其一","author":"吴与弼","text":"五月蓬窗触热多，清凉台馆此调和。\n故人重进杯中物，独酌灯花一放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10118,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重宿通州驿馆 其二","author":"吴与弼","text":"细数灯花事短歌，南归魂梦白云窝。\n独怜葵藿微私切，惆怅何心制芰荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10119,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别二孙生","author":"吴与弼","text":"客里过从喜二生，云和夜夜玉壶冰。\n长河寄得临分语，莫把灵台泥俗情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10120,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋新桥驿次去年诗韵","author":"吴与弼","text":"何处中秋对月圆，新桥旅泊近人烟。\n西江皓彩阻千里，北阙清光隔九天。\n画舫独吟河水曲，银灯高照驿楼前。\n时逢乡友谈萍梗，华发添明又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10121,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登陆偶成","author":"吴与弼","text":"旷望晴芜外，聊为曹濮吟。\n静观浮世事，端合付无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10122,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉谢都水车主事","author":"吴与弼","text":"争奈舟人贪利涉，宁知见险却当需。\n指麾非仗仁人力，颠沛洪涛尾尽濡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10123,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"崇武即事","author":"吴与弼","text":"一舸秋风昼枕清，楼台时见博平城。\n思家款款南归梦，恋阙依依北望情。\n独倚沧浪怀古调，细论舆地阅图经。\n明朝放犊晴岚坞，遍忆琴书水上萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10124,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古城舟中","author":"吴与弼","text":"朔风微雨橹和鸣，已度钟吾问古城。\n北路渐遥南路近，伊谁一写个中情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10125,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠金通判","author":"吴与弼","text":"少小为邻今老夫，淮阴重喜话冰壶。\n男儿肯负平生志，正好明时展壮图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10126,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经蚌壳湖","author":"吴与弼","text":"前月兹晨滥宠嘉，恭承天语侍文华。\n片帆容易几千里，独咏西风野水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10127,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高邮湖","author":"吴与弼","text":"长空漠漠水云平，北极风高一舸轻。\n菊有黄花归梦切，青山日计抚州程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10128,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孟城驿","author":"吴与弼","text":"高柳收帆处，平芜纵目馀。\n都将今古兴，尽向驿楼书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10129,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"船头船尾富欢声，高挂云帆四体平。\n时见南陲山隐约，明朝定拟到金陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10130,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发仪真","author":"吴与弼","text":"埧上停篙立柁楼，江边解缆别真州。\n满怀秋思无心写，独看岷峨万古流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10131,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中见红树","author":"吴与弼","text":"船头时作望乡吟，难写浮生去住心。\n忽忽不知为客久，谁家红树报秋深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10132,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白螺矶","author":"吴与弼","text":"柔橹和鸣人力齐，急流竞渡肯迟迟。\n试将众理依斯看，万事心同不足为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10133,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牵路宿上元地","author":"吴与弼","text":"江北邮程昼夜贪，寒芦已喜属江南。\n青山门巷无劳梦，消得东风几日帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10134,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题淡然卷子","author":"吴与弼","text":"东风红紫竞芳菲，万叶千葩恐后时。\n谁道太羹玄酒味，却能医得兆民彝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10135,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发石头城","author":"吴与弼","text":"旧游历遍问归程，晴色东风一舸轻。\n杨柳堤边吟望处，青山犹是石头城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10136,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"板石矶","author":"吴与弼","text":"红叶黄花归兴浓，青山夜夜梦巴峰。\n矶头记得蕃昌路，西日一帆芦荻风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10137,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次荻港 其一","author":"吴与弼","text":"漠漠寒芦一港通，衣冠迎候礼从容。\n已陪徐步凤凰岭，更与遥谈狮子峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10138,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次荻港 其二","author":"吴与弼","text":"晴芜眺罢事霜毫，点染秋云散海涛。\n馀兴归来眠未得，芦花寒月满江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10139,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十里青山","author":"吴与弼","text":"群冈联络接铜陵，何代流传十里名。\n隔岸翠屏相映好，片帆归咏正秋清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10140,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铜陵舟中","author":"吴与弼","text":"归心日日数邮程，楚水吴山次第迎。\n安乐有窝时有限，只怜无计荅升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10141,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅根次辛丑岁诗韵","author":"吴与弼","text":"轻风疏雨送微寒，淡月疏云溯急湍。\n年少旧题今白发，浮生犹幸一身安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10142,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重修余忠宣公墓堂诗","author":"吴与弼","text":"薇垣参辅隆风教，花县郎官尚典刑。\n顾我疏顽何似者，敢将名姓污丹青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10143,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胡贰令索诗题尊府方伯公一曲轩","author":"吴与弼","text":"画省高车久已悬，花封才子正青年。\n鉴湖一曲幽栖处，明月清风水拍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10144,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同安即事","author":"吴与弼","text":"几日扁舟系浅沙，独吟夜夜梦灯花。\n青山剩有平安侣，频说天边客到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10145,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鄱阳舟中","author":"吴与弼","text":"诗卷书来兴转佳，好风应念客天涯。\n明朝再假一帆力，指日琴书可达家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10146,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"进贤道中","author":"吴与弼","text":"诗思乡心共落霞，连村红树胜春花。\n少年髣髴曾游处，独立苍茫两鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10147,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蔗林","author":"吴与弼","text":"梦回夜半候鸡声，时听舟人问水程。\n明发扬舲过百里，好山却看故乡青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10148,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢家埠","author":"吴与弼","text":"连樯金鼓气飞扬，共喜邮程近武阳。\n诗兴无端吟不彻，霜林处处奠红芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10149,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其一 皇华亭","author":"吴与弼","text":"皇华曾喜见名亭，使节重临胜倍增。\n愧乏长才歌盛美，漫将下里颂升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10150,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其二 集庆亭","author":"吴与弼","text":"集庆当年众所誇，四民重喜拜皇华。\n一壶春酒供多兴，归从如云拥鼓笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10151,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其三 天使亭","author":"吴与弼","text":"箫鼓喧腾日正融，烝黎满路庆时雍。\n旌麾隐映红云表，天使重临天使峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10152,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其四 綵云亭","author":"吴与弼","text":"綵云亭子碧云岑，舜日重沾雨露深。\n红树溪桥春似锦，高吟细写北来心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10153,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其五 驻节亭","author":"吴与弼","text":"遥传天语下青霄，使节荣瞻驻此桥。\n燕喜有筵供胜会，旧家文物话唐朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10154,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其六 塔山","author":"吴与弼","text":"穷乡谁道塔山名，惟是樵歌牧笛声。\n岂意远承天上使，翩然下此驻霓旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10155,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其七 石溪先陇","author":"吴与弼","text":"石溪桥畔蔚松楸，叠鼓清笳导胜游。\n好是丹青难状处，百年心事共春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10156,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其八 石原","author":"吴与弼","text":"清明风日小春天，旌旆翩翩会石原。\n借问皇华辉映处，升平文采万人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10157,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其九 萝溪重庆亭","author":"吴与弼","text":"雪窗萤案饱储书，两沐旌旗奉使车。\n请赋新亭留胜迹，画檐高映绿萝居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10158,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉陪天使金陵王侯游山十首 其十 赤冈","author":"吴与弼","text":"赤冈斜抱小陂南，乡邑流传富美谈。\n红叶清霜风日媚，送迎天使此停骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10159,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送天使王侯回朝綵旗联句","author":"吴与弼","text":"九重雨露尧天大，万国衣冠舜日明。\n草木光华南服重，风云庆会北归荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10160,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元生陪往宝塘小憩路口铺","author":"吴与弼","text":"晴山联辔日迟迟，小憩邮亭啜茗时。\n少长森严环侍好，旧乡细诵帝乡诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10161,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿下城丘孔曼","author":"吴与弼","text":"先朝心事共春秋，此日投装话白头。\n莫把光阴牵俗态，勉教孙子继前修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10162,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐金垦田","author":"吴与弼","text":"滥向文华辱赐金，侧身北望五云深。\n都将至渥归南亩，瓜瓞绵绵万古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10163,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"亲农归途中次旧放水诗韵","author":"吴与弼","text":"迎恩桥畔独经过，课仆西畴事早禾。\n却忆去年今夜兴，淮阴去棹好风多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10164,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"坐沼上有怀京师冠盖","author":"吴与弼","text":"倦抛铅椠暂挥锄，浴罢观鱼听鸟呼。\n乘兴不知吟坐久，无端秋思绕皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10165,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆去年今日","author":"吴与弼","text":"去年今日侍文华，天语谆谆过宠嘉。\n二度丁宁归去后，好书多做贡皇家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10166,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆去年今日","author":"吴与弼","text":"去年今日拜彤墀，天语温淳赐敕归。\n中使传宣天使道，好生看顾荷皇威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10167,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]