[{"title":"赠方松崖擢湖南宪副","author":"周瑛","text":"正气驱人呼不回，两年看遍故山梅。\n洞庭春水连天碧，又见危樯破浪来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送黄伯望知肇庆府","author":"周瑛","text":"几度伤心忆岭南，民刳兵燹丧田蚕。\n黄堂此去看经济，千里春回雨露酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈石峰入京谒选","author":"周瑛","text":"雪霰初消道路平，马头红日照行旌。\n丹山毛羽非凡鸟，拟作朝阳第一鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈惇贤黄门应诏北上","author":"周瑛","text":"烟霞自分卧方壶，诏使忽从门外呼。\n五色石花烹炼惯，补天应不费枝梧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郡推郑改廉州经历","author":"周瑛","text":"自将纲铁铸吴钩，一道风霜冻不流。\n日暮满天风雨恶，不知何处是廉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽程孝廉二首 其一","author":"周瑛","text":"戴此头颅赎父刑，谁知不得比缇萦。\n断魂化作双飞鸟，飞薄青霄日月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽程孝廉二首 其二","author":"周瑛","text":"霄汉云深雨脚纤，难将只手引龙髯。\n西风吹断莱衣梦，空使人间哭孝廉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其一 小溪","author":"周瑛","text":"我爱主人家，溪流带屋斜。\n得诗曾梦草，对谱旋栽花。\n养鹤汀洲近，栖鸾枳棘赊。\n有孙能作赋，跃马入京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48058,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其二 玉带沟","author":"周瑛","text":"玉带人间少，吾家有此沟。\n天门从亥入，地户向坤收。\n夜雨书灯乱，春云墨汁浮。\n行看好孙子，应谶步瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48059,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其三 浴云池","author":"周瑛","text":"宿墨洗初罢，春云惊满池。\n暝分天色澹，寒逗日光迟。\n鹭下应先觉，鱼游浑不知。\n学书怜未就，深愧汉张芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48060,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其四 甘露洲","author":"周瑛","text":"有露浓如酒，瀼瀼降此洲。\n八年曾两结，十日未全收。\n月映祥光淡，烟笼瑞气浮。\n平生看墨本，此处识天休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48061,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其五 水棉树","author":"周瑛","text":"佳树列门前，栽培自昔年。\n旧根龙偃仰，老干鹤蹁跹。\n影碍半天日，翠分十亩烟。\n季孙宫里赋，应可续韩宣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48062,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其六 芙蓉峰","author":"周瑛","text":"湖上无多地，分明见秀峰。\n晚烟含紫翠，春雨长蒙茸。\n九华应争秀，五侯欲并雄。\n他年问何有，百尺看高松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48063,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其七 清风亭","author":"周瑛","text":"独向高堂坐，清风问伯夷。\n不知孤竹国，何似首阳芝。\n布被煖如纩，藜羹甘若饴。\n人生各有志，吾自得吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48064,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其八 鹤洲","author":"周瑛","text":"养鹤向江洲，每怜江事幽。\n沙鸥同入社，野鹜避回舟。\n梦落松巢冷，路分鹏背秋。\n好诗满人世，灯火为重篝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48065,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其九 翠渠","author":"周瑛","text":"渠水映柴扉，春深可染衣。\n天光带云影，鱼跃间鸢飞。\n世路尘埃远，道怀声利希。\n苍苔满白石，独坐对斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48066,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其十 昔曾亭","author":"周瑛","text":"改屋以为亭，昔人疑亦曾。\n笋芽穿壁入，菌茸傍栏蒸。\n昼卧云为幕，夜吟月作灯。\n许多幽胜事，欲赋愧未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48067,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其十一 榆川","author":"周瑛","text":"川中何所有，榆树正扶疏。\n日色晚来好，秋阴浓似初。\n官閒分子禄，身健课孙书。\n更拟门前地，容停驷马车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48068,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其十二 水云亭","author":"周瑛","text":"养鹤人何在，北园空此亭。\n树当原座绿，草傍故阶青。\n近水长桥卧，小山怪石层。\n好诗吟未就，落日满疏棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48069,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其十三 宜晚亭","author":"周瑛","text":"花草交前院，亭居背夕阳。\n晚来宜杖屦，老去可壶觞。\n烟合山光紫，霜寒月色黄。\n久飞吾亦倦，思与共徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48070,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翠湖杂咏 其十四 归来亭","author":"周瑛","text":"蚤依翠湖住，晚傍翠湖归。\n天地一亭小，功名两鬓稀。\n春云鸣社鼓，秋雨暗鱼矶。\n俯仰全无事，吾心已息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48071,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和兄鹤洲延绿堂诸公作","author":"周瑛","text":"亭内幽芳手可拈，亭外绿阴分四檐。\n主人出去云在榻，独客行来月满帘。\n佳禽四五似相语，小竹二三初放尖。\n自古天公惜清况，赏心乐事谁能兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48072,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和水云亭诸公作","author":"周瑛","text":"此心何处洗尘埃，家有小亭渠上开。\n山雨未收云尚湿，江枫欲落雁初来。\n食莼偶并季鹰驾，对菊思衔陶令杯。\n最喜赏音人不远，小航频到鹤洲回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48073,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题归来亭","author":"周瑛","text":"天地孤亭小，江湖倦客归。\n不图钟鼎食，来试薜萝衣。\n鸥鹭波涛阔，风云声迹希。\n世情方起灭，吾自息吾机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48074,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题环璧亭","author":"周瑛","text":"亭外水如璧，仅容一杓通。\n蘋风秋琐细，蒲月夜玲珑。\n坐卧皆天上，往来疑镜中。\n主人原会赋，收拾若为工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48075,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金门待漏院试作","author":"梁储","text":"十年丹扆梦中情，几向长安对月明。\n凤阙未曾开曙色，龙池先已听钟声。\n焉知落落孤踪士，独抱区区万里诚。\n却恨相如献词赋，不将憔悴及苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48076,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夜 其一","author":"梁储","text":"四方民瘼已无忧，圣主宵衣正御楼。\n万岁山前黄道转，九层台上紫烟浮。\n星环凤扆高居处，雷动鳌山最上头。\n此夕欢娱知几许，霓裳谁羡月中游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48077,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夜 其二","author":"梁储","text":"已遣金吾弛夜巡，更将休沐赐群臣。\n一年月向今宵好，万国春从此后新。\n王豫庇民徵夏谚，薰风调律叶韶钧。\n疏虞久滥瀛洲客，窃禄年年未致身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48078,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夜 其四","author":"梁储","text":"万年枝上雪初晴，千步回廊月转明。\n天为良辰留美景，风传和气作歌声。\n广寒自昔身难到，弱水今宵浪已平。\n愿向大庭歌此曲，卷阿诗句合先赓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48079,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿刘阁老夫人","author":"梁储","text":"何处飞来海鹤姿，白头金紫照清时。\n天教椿树长如此，身是神仙自不知。\n膝下綵衣丞相舞，花边春酒上公持。\n年年入奏升平曲，不道祯祥正在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48080,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李守正吉士引疾还家","author":"梁储","text":"西风吹雨湿窗纱，阶下决明才着花。\n人在玉堂看起草，病辞仙仗喜还家。\n舟移潞水天初远，马入聊城路不赊。\n预约明年当此日，板舆随母觐东华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48081,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿崔太常次邃庵韵","author":"梁储","text":"圣明亲简太卿贤，重叠恩光照暮年。\n惟学后夔能典乐，不随方朔更求仙。\n瑶琴待月成三友，珠唾随风落九天。\n明日药栏招手地，也知吾得预宾筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48082,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送倪尚书","author":"梁储","text":"东曹居第冷如冰，共喜公来聚德星。\n诸老入门时秉烛，晚生投谒亦分庭。\n高才司马休归洛，白首侯芭愿执经。\n惭愧浅才同甔石，临岐犹拟挹沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48083,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和张元升宗伯游西湖见寄","author":"梁储","text":"春风飞鞚帝城西，杨柳阴阴夹御堤。\n寺外断云千里目，壁间流水十年题。\n禅谈有味风生席，诗思无边月在溪。\n老衲不须留玉带，百篇端已重招提。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48084,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽周司寇","author":"梁储","text":"未老辞官帝未俞，七旬方得赋閒居。\n却怜阳曲无归宅，翻使台城有卧庐。\n三尺龟趺庄懿墓，万年金匮史臣书。\n槐庭雨露今如许，犹是当时积庆馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48085,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿座主彭阁老","author":"梁储","text":"乞归先伴赤松游，甲子今来又一周。\n发白已怜身早退，心閒还与国同忧。\n书成东里终篇后，名冠西江第一流。\n姜桂自怜偏性在，当时药笼愧同收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48086,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿丘阁老七十二","author":"梁储","text":"琼山前度降神时，初报寒梅第一枝。\n麟出九真曾瑞世，凤翔千仞更来仪。\n苍生正喜归仁寿，黄阁于今有俊耆。\n浅薄幸随乡里后，愿输忠悃荅无为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48087,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送叔永如金陵","author":"梁储","text":"车轮此去愿迟迟，莫惜频频有和诗。\n前度岁华方共惜，后来风雨莫愆期。\n谁令别酒初醒地，正值飞鸿独下时。\n今夜秣陵春草色，想应先满谢家池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48088,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中元谒陵次屠东湖韵","author":"梁储","text":"松栝苍苍望不迷，五陵风露已凄凄。\n立当明月频惊雁，行过荒村只听鸡。\n原庙尚闻藏剑履，关门何用借封泥。\n不堪马上成归梦，还绕东华綵仗齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48089,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"顷以事至留都旧寅诸老用词林故事燕于吏部后堂归成二首 其一","author":"梁储","text":"故人交谊重南金，画省风流许重寻。\n千里云宵违比翼，十年江汉阻知音。\n祥鸾自合归阿阁，倦鸟惟思返故林。\n多谢北堂今夜月，后来应照我遐心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48090,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"顷以事至留都旧寅诸老用词林故事燕于吏部后堂归成二首 其二","author":"梁储","text":"停觞休讶饮迟迟，蜡炬分行照翠眉。\n头白尚怜公记忆，力微虚负主恩私。\n鹓鸾天上终相远，鱼鸟江边定不疑。\n他日凤凰楼畔客，相逢还更语相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48091,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"萧总制致仕西归予亦自岭外至相会话别","author":"梁储","text":"河桥柳色正丝丝，故国逢君又别离。\n江海论交惟此日，山林归隐又同时。\n公如白璧心何忝，我恋青山力已疲。\n从此侧身西望地，年年空忆采华芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48092,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次三老阁前迎春草","author":"梁储","text":"二月群芳尚未花，独怜仙草已抽芽。\n风传紫禁香初远，月到瑶阶影未斜。\n泉石故知惭小草，江湖何处寄瑶华。\n祗应待到重阳日，犹有馀香共菊誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48093,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈亚卿册封","author":"梁储","text":"吟罢霞天菊未花，驱车明日是天涯。\n留人初揽淮南桂，奉使还乘汉水槎。\n八座官联班最贵，维城宗子颂非誇。\n归来献赋明光殿，依旧彤云绕翠华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48094,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送傅北潭宗伯致仕","author":"梁储","text":"水苍为佩锦为袪，长照天家白玉除。\n北阙早年仍听履，东门今日已悬车。\n尊前绿绮风吹断，望里丹梯画不如。\n此去若逢关令尹，好将道德著成书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48095,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和杨邃庵郊坛斋居之作杨民部旧僚也","author":"梁储","text":"宝炬光中夜漏深，万行珠树肃萧森。\n阳回左个迎雕辇，人在东坛整玉簪。\n伐木尚怜求友义，倾葵偏切侍臣心。\n悬知扈从归来日，应有文思颂德音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48096,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿三原王太宰","author":"梁储","text":"翘首班行八座尊，清风归去隐三原。\n为霖望切人心在，调鼎功多国史存。\n心远尚怜思魏阙，身閒聊得卧丘园。\n庭前丛桂高千丈，应是明时雨露繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48097,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代夏景述怀","author":"梁储","text":"小麦青青大麦柔，榴花开遍殿东头。\n日长麋鹿惟依辇，波静鱼龙不负舟。\n家国有贤天所鉴，生灵无事我何求。\n堪嗟汉武神仙意，误却当年尚未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48098,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次西涯韵","author":"梁储","text":"十年身已到璇霄，开閤犹闻引下僚。\n玄圃会须呈璞玉，终南当复赋梅条。\n人才孰可追三代，文字君应叹六朝。\n试问澄江静如练，何如澎湃浙江潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48099,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和蔡东轩驸马自寿","author":"梁储","text":"一代豪华称戚畹，百龄风骨似神仙。\n旧闻朱邸邻珍馆，新赐黄封出御筵。\n尘榻每缘佳客下，清风还许后生传。\n欲知箫史酬恩地，惟以忠贞照暮年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48100,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"使节荣归为江文源侍读作","author":"梁储","text":"为因衔命到蕲阳，还得承欢向北堂。\n金册手持归赤社，绿衣身著到钱塘。\n鹓鸾一别思仙侣，书剑何时返帝乡。\n闻道江南民瘼甚，愿裁封事上明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48101,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李程二学士被命教庶吉士唐大夫有作奉柬予次其韵","author":"梁储","text":"奎壁光芒夜彻天，两公新命领群仙。\n金堤晓日联丝鞚，玉署春风醉锦筵。\n鸾掖文章瞻具美，鲤庭诗礼属多贤。\n中丞剩有新篇纪，明日都城作话传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48102,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园次陈以道评事","author":"梁储","text":"老来心事乐幽栖，看竹怜君远见携。\n初辍班行来入社，旧栽花木已成蹊。\n东篱谁送陶潜酒，半夜还分太乙藜。\n从此过逢知不倦，帝乡今已隔云泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48103,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿郑介庵为其子通判作","author":"梁储","text":"归来犹未买良田，谁似淩江二守贤。\n心已忘机犹爱国，身无侈累却求仙。\n听残曙鸟眠初觉，吟对秋英句倍妍。\n明发阿郎归省地，岂无庭鹤共蹁跹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48104,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送唐给事出使侍母还乡","author":"梁储","text":"朝回长得奉慈闱，又却乘轺侍远归。\n江水自饶鱼入馔，门闾偏称锦为衣。\n君亲恩重知难报，江海情深念久违。\n驱遍羊肠无畏处，也应持此报春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48105,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送曾大尹","author":"梁储","text":"宿云收尽好风来，令尹帆樯此日开。\n人为循良添怅望，诗因离别句难裁。\n枫宸玉帛千官会，花县琴书几日回。\n家近河阳春尚浅，满城桃李更须栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48106,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游海珠寺","author":"梁储","text":"是谁驱石到江心，天为羊城镇古今。\n风月不随人共老，莺花宁藉我登临。\n诗情肯与珠争丽，酒兴还怜海共深。\n怪得兰桡归去晚，伫看灵雨遍山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48107,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上作","author":"梁储","text":"江月雾中明，孤舟触浪行。\n吹笳知远浦，沽酒听寒更。\n旅雁依依去，霜风落落鸣。\n故园松与菊，今夕倍关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48108,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送冬官王申之","author":"梁储","text":"郎署念庭闱，秋来病乞归。\n鸟乌心正切，江海念无违。\n衣带前时减，灯花昨夜辉。\n高堂十月景，犹待老莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48109,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北堂雨露诗为侍御曹汝学作","author":"梁储","text":"天上恩波远，人间庆泽长。\n慈闱初拜命，先子重增光。\n贺客朝朝满，纶音字字香。\n欲知图报地，葵藿正倾阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48110,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午赐扇","author":"梁储","text":"宝月辉周制，银钩灿禹谟。\n九重新泽出，万寿小臣呼。\n天上清风好，人间暑气无。\n愿言均此施，荡涤到樵苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48111,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬轩何君顷以公事至京师事讫言归索诗为别因为之赋此","author":"梁储","text":"王事有程期，居京越一时。\n不愁春易尽，惟恨路多岐。\n白酒先秋熟，黄柑带雨垂。\n故园归兴好，莫惜寄来诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48112,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝贞皇太后王氏挽章 其一","author":"梁储","text":"南有乌衣巷，生祥旧不休。\n文王初御极，太姒已归周。\n明发诗篇在，关雎德泽流。\n孰知从此去，长夜竟悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48113,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝贞皇太后王氏挽章 其二","author":"梁储","text":"二十三年内，恭勤奉至尊。\n心犹忧治世，恩不厚私门。\n中馈思民瘼，端居念化原。\n黄童兼白叟，歌颂至今存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48114,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝贞皇太后王氏挽章 其三","author":"梁储","text":"四海雍熙极，重闱孝养深。\n宫中无遂事，天下有徽音。\n寿祝千千岁，恩沾万万寻。\n那知遗诏下，哀动圣皇心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48115,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝贞皇太后王氏挽章 其四","author":"梁储","text":"圣德那能纪，风谣岂易听。\n悲笳才一动，群泪已千零。\n旧事留编简，馀音入杳冥。\n秪应松柏路，还有五云扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48116,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次简正郎韵","author":"梁储","text":"几岁乞归休，衔恩尚勉留。\n形容空自老，松菊为谁秋。\n病岂堪朱绂，天应念白头。\n秋鸿莫先去，期傍我行舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48117,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]