4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茆坪","author":"刘崧","text":"断垄荒冈少树林，翩翩何许一幽禽。\n欲栖不定还飞去，白苇黄茆秋正深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小庄","author":"刘崧","text":"老虎庙前溪水长，白羊坪下晚山苍。\n到家尚远心先近，指点行人问小庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"猪龙潭","author":"刘崧","text":"猪龙已化潭中石，石上空馀人虎迹。\n老僧骑虎不曾归，溪水潺潺山叶碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"老兵","author":"刘崧","text":"丁男战死籍名存，主将呼名更点屯。\n白发满头筋力尽，却教随伴守营门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与郭约别","author":"刘崧","text":"火烧桥畔草离离，野水寒山日暮时。\n已渡前溪更回首，知君独立尚归迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东原对月","author":"刘崧","text":"土屋无风尚不关，屋前遥见两青山。\n瓦盆盛酒茆铺席，何日柴门望月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄湛上人","author":"刘崧","text":"当时曾共北沙游，把酒哦诗赏素秋。\n十载故人零落尽，东山依旧说汤休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"流江春日","author":"刘崧","text":"山绕平原屋绕山，两溪流水结回环。\n绿杨如画花如锦，长日鸟啼烟雾间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过郎湖","author":"刘崧","text":"山中春鸟夜相呼，岸上谁家酒可沽。\n风露满船眠不得，长歌乘月过郎湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酒醒","author":"刘崧","text":"野人乱后无归处，惟有尊前似故乡。\n昨夜流江水亭上，五更酒醒月如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"纪梦","author":"刘崧","text":"风雨潇潇鸡乱啼，去年春梦使人迷。\n环波亭下东湖路，依旧荷花水满堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题上元周伯宁所赠僧惟善山水小图","author":"刘崧","text":"北苑南宫意所亲，早于挥洒见天真。\n僧郎前月金陵去，卷得淮山一片春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出水口望牛头诸峰不见","author":"刘崧","text":"万壑千林掩翠岑，出山自浅入山深。\n桃源未必真无路，正恐重来自莫寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早次楠木塘","author":"刘崧","text":"月隐前峰雾不开，杉林十里路萦回。\n多情楠木塘边水，相送行人出岭来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过山塘坂","author":"刘崧","text":"山塘坂上路如弓，步入巉岩曲折中。\n野鸟乱啼寒日暮，满山红叶动秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题竹石赠王伯初","author":"刘崧","text":"知君高节抱幽贞，为写修篁石上生。\n却忆瑶琴清奏罢，满天风露听秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观野烧","author":"刘崧","text":"历历烈烈风火飞，前山后山相映辉。\n春来雨打黑灰落，山下麦田应解肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题石泉山人隐居","author":"刘崧","text":"閒寻隐者忆重论，路绕荒田水绕园。\n何日山中收药去，满林脩竹不开门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":25189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题李复中所画髯龙图","author":"刘崧","text":"海外飞腾地轴倾，五云雷电绕神京。\n鼎湖天远人难见，彷佛龙髯下太清。","