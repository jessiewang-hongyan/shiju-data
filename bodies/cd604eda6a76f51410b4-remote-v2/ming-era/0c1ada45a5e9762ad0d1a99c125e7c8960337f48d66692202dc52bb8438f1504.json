[{"title":"秀屏归口占赠之","author":"饶与龄","text":"酷暑何妨梵宇居，醒时哦句睡抛书。\n澄心百虑都消遣，为说诸公莫浪呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九龙省先妣墓","author":"饶与龄","text":"思亲轻舸展新坟，草色青葱散缬文。\n雨里隔溪闻怨鸟，日曛依柏忍驱蚊。\n商游绝巘觅金穴，农挂重蓑事火耘。\n独有茹哀篷底客，永怀熊胆助辛勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放舟三河镇","author":"饶与龄","text":"懒散情怀未老癯，舣舟雄镇揽花衢。\n千源分派三流合，万谷周遭一嶂孤。\n比屋笙歌闻彻远，通津帆楫竞招呼。\n上游藉此金汤固，漫说全潮任有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林坑观稼","author":"饶与龄","text":"旭日融融出自乐，疏松脩竹赤光通。\n肩舆缓步巡阡陌，束盖偻躬避苇丛。\n量雨较晴逢牧子，烝藜炊黍有山翁。\n酣歌直待梢头月，奚羡仙姝醉蕊宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放舟乌槎","author":"饶与龄","text":"长向江湄学漫游，诗囊茶灶载扁舟。\n碧空呼鹤频招手，浅濑观鱼辄点头。\n棹过芦花惊水鸟，角吹洲畔逐溪牛。\n风清兼吐山巅月，醉听渔歌自在流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新矶书室","author":"饶与龄","text":"三水萦回一草堂，万竿脩竹戛琳琅。\n黑甜窗下无人问，可信神游到燧皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸巳仲冬念四日予五旬有一贱诞忧制未释因避客新矶书舍漫成俚句姑以咏怀","author":"饶与龄","text":"履世躬逢三圣王，悬弧五度荷穹苍。\n抱怀纠郁长如结，毛发萧疏渐有霜。\n闷过园林聊玩日，閒谈轩岐摄生方。\n蓼莪遗咏多惭负，敢向堂前强举觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凝翠亭","author":"饶与龄","text":"筑亭种树阅年多，翠翠青青羡两娑。\n徙倚赏心移白日，何嫌门外可张罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见一台","author":"饶与龄","text":"丛篁奉足坐盘蜗，心远尘寰绝世拿。\n管见一班禅定趣，纷华屏却且韬瑕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行厨值送鱼不受","author":"饶与龄","text":"冷庖不解校人烹，盂粥盐齑自结盟。\n漫说一铛藏世界，却疴清肺任肠鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予谢客至新矶馆亲友虽不至间有遗问者予复拿舟往莲塘山庄数日甚惬幽意 其一","author":"饶与龄","text":"莲塘之宫半亩宽，喜于幽处托盘桓。\n长松风扫笙簧奏，峻岭云横锦绣看。\n哦句遣怀移枕簟，巡檐索突笑衣冠。\n农人披豁谈耕稼，较胜歌声杂管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予谢客至新矶馆亲友虽不至间有遗问者予复拿舟往莲塘山庄数日甚惬幽意 其二","author":"饶与龄","text":"莲塘之宫半亩宽，何妨避俗此中蟠。\n閒来点易频濡笔，倦后寻芳漫倚栏。\n鸟雀喧啾脩竹里，牛羊驰逐大江干。\n幽思触景成狂句，题罢长吟亦解颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予谢客至新矶馆亲友虽不至间有遗问者予复拿舟往莲塘山庄数日甚惬幽意 其三","author":"饶与龄","text":"莲塘之宫半亩宽，灵台静定自身安。\n观书燃烛鸡传唱，拥被酣眠日上竿。\n客座楸枰时对奕，仙家炉鼎学烧丹。\n松菊三径栖迟处，不愧当年具四难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予适莲塘亲友尽谢却之独三河陈巡使云石接乡丈吴东溪枉顾云石官予地谊不可拒因留款竟日","author":"饶与龄","text":"烟雾濛濛收雨脚，朝曦掩霭菊花团。\n拟从别墅理归棹，忽枉高轩访考槃。\n纁币承筐来厚贶，黍鸡下榻罄交欢。\n舒长化日无尘鞅，为倒金樽莫兴阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉送别驾效愚沈公署邑篆得代还郡二律 其一","author":"饶与龄","text":"海陬岩邑叹疲癃，万里天门隐未通。\n枉沐朱幡来上佐，高悬华烛照青穹。\n陈蕃慰满题舆望，余靖终膺御笔崇。\n杯酒印冈延别处，桃花夹岸映溪红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉送别驾效愚沈公署邑篆得代还郡二律 其二","author":"饶与龄","text":"霏微春雨暗河桥，草色青青涨早潮。\n方咏飞鸿安泽国，忽瞻彩鹢拨归桡。\n三年半刺称良翰，期月慈君薄试萧。\n欲采民风知骏绩，茶阳载道裤襦谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张晋宇北上 其一","author":"饶与龄","text":"岭南仙尉朝天去，两袖清风匹马催。\n菊酒长亭须惜别，刺桐花畔待君回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张晋宇北上 其二","author":"饶与龄","text":"三年桴鼓寝疆封，赞政河阳花更浓。\n烂熳仙桃春色蚤，更看城锦媚芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张晋宇北上 其三","author":"饶与龄","text":"香尉朝天去马催，担头书剑映朝晖。\n离亭一阕阳关曲，射鸭堂空忆主回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄坑埠头","author":"饶与龄","text":"擅名自古黄坑好，水色山光画嶂开。\n贾客舟航来荻渚，山丁篁木集蒿莱。\n登场稌黍兼蔬果，举网鲈鳊佐酒杯。\n桂魄一轮清潋滟，披襟独对绝纤埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九龙水次见三人执杖亟行间之乃追盗牛者口占慰之","author":"饶与龄","text":"纷纷铚艾趣南亩，骇见持殳逐盗牛。\n渤海循风今罕见，嘱君牖户早绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟返三河见诸得举者归内有黄生继章乃宪副及泉公之令子予之姻家也喜而有作","author":"饶与龄","text":"江月扬辉江水清，科名又见一番新。\n綵舟簇拥登瀛侣，箫鼓喧阗贺客情。\n众艳七人皆国隽，我贤一子续家声。\n蛟龙奋起三春浪，伫听胪传答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别莲塘书舍","author":"饶与龄","text":"数年浪迹寄衡门，时洒幽襟亦避喧。\n白酒黄鹂添野兴，老农稚子喜风淳。\n解衣蓬跣无官客，课读灯窗有子孙。\n暂别芧檐谒金阙，归来重见举芳尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辞先大夫墓","author":"饶与龄","text":"维舟江曲着征衣，拜别幽扃上帝畿。\n黄叶飘时离思结，白云飞处望心迷。\n承家惭负庭前训，报国期酬地下知。\n郁郁松楸瞻渐远，何当陟岵学裁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺黄浚泉春元","author":"饶与龄","text":"宝剑龙吟经几年，瑞光直射斗牛边。\n而今交付青春佩，挥霍奇勋震八埏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题五凤蟠桃图寿熊太公","author":"饶与龄","text":"五凤翩迁瑞气钟，碧桃千岁熟仙宫。\n玳筵献祝椿庭寿，飞綵行看下九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬族弟庠生印池送别","author":"饶与龄","text":"风雨连床不计年，归来复聚白云边。\n驽骀偶愧先驰骤，鸿雁还期接翅翩。\n一阕阳关催酒斝，数枝梅信出寒烟。\n天门雨露春应遍，会见贤书起惠连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吉水三姑滩舟中除夕次李友竹韵","author":"饶与龄","text":"远寺钟声晚更沉，鸦迎彩鹢噪丛林。\n通宵爆竹惊春梦，好友赓诗畅客心。\n回首云烟离思杳，半生雨露荷恩深。\n丹衷㣼雁驰天北，勉效勤渠惜禹阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜渡赣州十八滩呈贡元李友竹","author":"饶与龄","text":"峻滩长吼万军声，两岸黄茅山更嵘。\n鼓枻周回防石角，停桡盼睐候风旌。\n畏途频陟惊星序，脩路徂征叹旅程。\n幸就故人杯酒乐，披襟酬唱破三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日舟次峡江和友竹韵","author":"饶与龄","text":"元晨万寿祝枫宸，二十三年又见春。\n绛阙祥浮冠佩集，黄扉令布宪章新。\n皞神启泰今为主，■泽宏敷乐与人。\n丹悃不将华发变，岂容暇豫独谋身。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河泊所阻风用侧体成五言二律 其一","author":"饶与龄","text":"扁舟拟远征，逆飙滞行棹。\n洪城伫遨游，荒涯可停泊。\n飘摇等鸥浮，局束如龟缩。\n悠悠拥寒衾，厌听鸡声促。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河泊所阻风用侧体成五言二律 其二","author":"饶与龄","text":"朔风打船头，行云拖雨脚。\n停桡苦逗遛，濡衣虞踯躅。\n舵动呕哑鸣，杯衔黾勉乐。\n何如云际鸿，飘飘翔寥廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次前韵答友竹兄㝢宽解之意 其一","author":"饶与龄","text":"家食怀君恩，北发理征棹。\n煖风入屠苏，孤舟反漂泊。\n青阳令始行，顽阴气未缩。\n击楫呼长年，勉㫋为予促。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次前韵答友竹兄㝢宽解之意 其二","author":"饶与龄","text":"连袂趋西江，阳春谓有脚。\n羁旅惜韶华，扬鞭逐芳躅。\n留滞岂足悲，挥霍当愈乐。\n达观志桑弧，宇宙皆吾廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏答友竹李兄","author":"饶与龄","text":"桃夭准拟达都门，漫向西江舣行棹。\n垂空雪霰扑面扬，满目风涛捲岸泊。\n楚姬压酒春花嫣，篙工拥炉壁蜗缩。\n彭城道上走风尘，诗思应观驴背促。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自慰","author":"饶与龄","text":"日边佳气郁葱浮，万里勉策蹒跚脚。\n筮仕恰当从政年，步趋敢踵古人躅。\n听命苍苍不过求，素位休休聊自乐。\n开篷四望云渺茫，长啸一声心愈廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河泊所遥望滕王阁","author":"饶与龄","text":"杰阁渠渠竖江浒，洪都名郡羡蜚英。\n朱帘画栋丹青象，南浦西山梦寐情。\n帝子雄图留迹古，才人记胜觉风生。\n会经佳地开尘眼，高步瑶池上玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春正七日颙望风静","author":"饶与龄","text":"巽二连朝恣怒号，冯夷击鼓涌波涛。\n南帆鳞次悠飏举，北楫龙蟠偃卧高。\n谁谓苍旻能助顺，顿教仁气转钧陶。\n佳辰空负古人日，愁饮江干面色酕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏许真君","author":"饶与龄","text":"旌阳仙令人何在，闻说遗因事甚都。\n井柱伏蛟神秘术，节杯化鹤运阴符。\n成功碧汉瞻飞舄，崇报巍宫列画图。\n千载悠悠谁复见，楚江春草听鸣鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过滕王阁欲登不果和友竹","author":"饶与龄","text":"阁高辣出万家中，披豁登临雅意同。\n四野密云将雨暗，一川浊浪入天空。\n漫云雪夜扁舟兴，辜负高贤琢句工。\n拥被侵寒惊寤寐，渔歌欸乃耸孤篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"猫号戏作","author":"饶与龄","text":"阳春二气降腾时，生意潜被物自知。\n狸子夜嗥惊旅梦，时来天动复何疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十一日新晴答友竹","author":"饶与龄","text":"愁怀顿发喜颜开，且庆今朝淑气回。\n耐岁共瞻松与柏，迎春先占柳和梅。\n金台桥树张灯市，彭蠡篷窗对寿杯。\n搦管频频记光景，何时樽宴俯怜才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜渡鄱阳东湖","author":"饶与龄","text":"北征三度过彭蠡，此度波澄镜面平。\n桨荡渔船摇拽易，帆悬贾艇往来轻。\n雁翔南浦偕鸥集，鹤入青霄挟子鸣。\n月到天心船到岸，歌声满耳杂风筝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢答友竹兄","author":"饶与龄","text":"早春已动禹门雷，氤氲生机次第开。\n龙蛰惊吟风雨里，虫雕窃响砌阶来。\n连襟幸值连茹会，上国应知上乘才。\n多少门墙桃李树，伫同时雨化蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元宵与二客同饮用杜工部赠田舍人韵","author":"饶与龄","text":"维舟此夕弋城边，明月清风对二贤。\n酒觅郫筒酬令节，蔬分园韭助春筵。\n萧条旅次无佳制，吟笑笥中有古篇。\n遥想六鳌双凤胜，野凫何日听钧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步杜工部进艇韵","author":"饶与龄","text":"上元舟底听钲鼓，三五蟾光又逗窗。\n途远不妨淹落日，风从何厌泛长江。\n崚嶒翠壁奇仍丽，游泳沙鸥去复双。\n佳景屡逢堪寄眺，明灯相向尽罂釭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弋阳见灯城 其一","author":"饶与龄","text":"纱笼万炬走江湄，旋绕团团技益奇。\n更有笙簧嘹喨甚，隔溪齐听唱歌时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弋阳见灯城 其二","author":"饶与龄","text":"火城红映碧波深，星斗罗空弋水浔。\n泡影跳丸归幻化，传奇戏笔付长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洪都访吴凤岐佥宪以入贺行信州访张莲滨少参又以迁秩去二人旧知俱不遇有感","author":"饶与龄","text":"纾辔江南几千里，人生萍梗叹参辰。\n莺声乔啭多春色，凫翼霄翔入杳冥。\n干泽耻为弹铗计，拥吟远慕闭关人。\n举头眺望天功溥，雨润青松亦长蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上饶县五里墟舟行阻借宿酒店","author":"饶与龄","text":"风声奔万马，云气暗千崧。\n飞絮逗重幕，堆盐压短篷。\n悠悠违旅舍，咄咄袛书空。\n谁为驱滕六，扶桑睍影红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁丑与春元杨雨江等六人过玉山今复由北上自念渐老勉图世用志感一首","author":"饶与龄","text":"怀玉昔经游，星移二十秋。\n山川旧图画，俦侣散浮沤。\n无计寻丹药，何由驻碧眸。\n识途称老马，踯躅逐骅骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉山年兄薛涵所大尹留饮","author":"饶与龄","text":"忆昔偕君听鹿鸣，相期飞控骋脩程。\n春深红杏多飘土，岁后青松见几茎。\n乍雨乍晴由大造，知新知旧孰钟情。\n多君下我陈蕃榻，不厌清樽意气倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追忆游凤城寿安寺步太守心溪徐公韵","author":"饶与龄","text":"古寺沉沦不计秋，于今重建运吁筹。\n胔埋骼掩民非厉，妖寝祥兴众与休。\n雁塔镌名徵国献，莺乔借寇喜贤侯。\n山门不解坡公带，曾置青莲记胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追忆通府沈效愚夜分延饮西湖寿安寺","author":"饶与龄","text":"锦缆牵舟湖面行，淡云疏雨晚来晴。\n袛园丽象中宵见，宝炬森行分外明。\n满座主宾同胜赏，侑觞歌舞答升平。\n而今分手天南北，伫望鸿邻慰远情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"常山阻雪时有送席馔至而无酒舟中戏笔","author":"饶与龄","text":"荏苒经旬雪再飘，白驹暂系永今朝。\n青州从事徒劳我，乌有先生不下□。\n老足冻冰长缩缩，蓬头拨烬袛萧萧。\n空馀一点葵心赤，万里天门向帝尧。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过严陵滩七言绝句四首 其一","author":"饶与龄","text":"扁舟四望临安路，舟人指点富春江。\n汉家九鼎久已矣，清风犹袅钓丝长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过严陵滩七言绝句四首 其二","author":"饶与龄","text":"老脚浪长岂倨主，羊裘坚卧富春江。\n达人漫道先生果，郡里谁传姓字香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过严陵滩七言绝句四首 其三","author":"饶与龄","text":"钓迹茫茫何处觅，吉州亦有富春江。\n袛缘风韵云霄上，故遣芳名记异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过严陵滩七言绝句四首 其四","author":"饶与龄","text":"滔滔逝水东流去，千年景仰富春江。\n我欲瓣香礼像肃，祠堂缥缈白云藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆行过草萍驿五言绝句二首 其一","author":"饶与龄","text":"雨湿狐裘逗，鞭扬马足忙。\n亦知煖阁好，帝里旅怀长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆行过草萍驿五言绝句二首 其二","author":"饶与龄","text":"款语途中绪，联镳雪里山。\n乡关何处是，回首泪痕斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过严滩步友竹韵古风十四句","author":"饶与龄","text":"鼓棹桐江水，纵眺富春山。\n古祠郁岧峣，抠衣几欲攀。\n炎刘鼎祚复，故旧帝心关。\n羊裘大泽钓，徵书寰宇间。\n玄豹沐冥雾，神蛟潜深湾。\n客星不可留，山高水长湲。\n清风激千载，永伴白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过桐庐县次友竹韵","author":"饶与龄","text":"留滞春宵屡索途，萧然蔬草治行厨。\n一杯仰洒江天雪，数阕遥吟古钓徒。\n连席不妨中夜语，分携预叹一灯孤。\n天曹幸授苏湖帐，莫惜弹冠折简呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"富阳久阻风雪遥望杭城不至因思昔年游西湖今欲再游不可得适见寒鸦傍舟觅食有感而作","author":"饶与龄","text":"脩途风雪久无聊，漫向钱塘拽去□。\n因忆西湖多丽胜，何缘短屐复逍遥。\n浩然莫遂寻梅兴，陶谷空将苦茗调。\n乌鹊饥肠同旅子，江干垂翅立寒潮。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过杭城羡其富盛文明之邦","author":"饶与龄","text":"临安自古名都会，雕峻参差万井烟。\n天目钟奇龙凤舞，钱塘汇秀水天连。\n绮罗炫烂云霞锦，冠舄联蹁花绣鞯。\n更有西湖好风月，骚人题咏浩无边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]