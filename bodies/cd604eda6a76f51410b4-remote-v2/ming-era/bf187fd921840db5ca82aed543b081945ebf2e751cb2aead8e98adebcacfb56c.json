[{"title":"羊城八景 其六 越台秋月","author":"区大相","text":"辇路馀衰草，荒台千古留。\n空悬汉时月，不见汉时秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其七 白云晚望","author":"区大相","text":"白云在空山，还望山中客。\n聊持一片心，惆怅千峰隔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城八景 其八 扶桑浴日","author":"区大相","text":"叱起群龙驭，天鸡闻远空。\n东溟一杯水，洗出金轮红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浊潦骤溢水槛遣兴二绝 其一","author":"区大相","text":"桂江几千里，新水下浑浑。\n偶动乘流兴，堪浮五石樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浊潦骤溢水槛遣兴二绝 其二","author":"区大相","text":"今朝江水浊，云日汩虚明。\n我欲澄流滓，中流见太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崧台独步颇有何仰之怀 其一","author":"区大相","text":"台榭一方胜，江山千古同。\n由来涕泪处，不独有羊公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崧台独步颇有何仰之怀 其二","author":"区大相","text":"阁迥青林上，台孤碧雾悬。\n寂寥谁与晤，吟眺下江烟。",