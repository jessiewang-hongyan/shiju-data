[{"title":"闺情","author":"徐熥","text":"泪尽闺中烛，肠回锦上文。\n蛾眉羞写月，鸾鬓罢梳云。\n枕怯罗衾冷，香孤绮阁薰。\n空床本无寐，况复夜蛩闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度分水关","author":"徐熥","text":"鸟道盘云际，停车怨陇头。\n封疆分异域，关路割双流。\n地尽辞闽峤，山穷见楚州。\n多情故乡水，呜咽为含愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴江哭顾道行先生","author":"徐熥","text":"图报惭无地，哭声空震天。\n恩私诸子外，知遇十年前。\n残箧玄经秘，仪床绛帐悬。\n旧题诗满壁，一读一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邬子远还京口时邬有丧子之戚","author":"徐熥","text":"相逢俱失意，相送柰愁何。\n老去雄心减，春来归梦多。\n旧山怀北固，新泪滴西河。\n世路已如此，空为劳者歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望月有怀和陆纂父","author":"徐熥","text":"一别经圆缺，三秋望转明。\n蛾眉今夕影，鸾镜旧时情。\n貌逐清辉减，愁随素魄生。\n关山千里隔，何处照盈盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡千户袭职还吴兴","author":"徐熥","text":"龙韬堪报主，燕颔定封侯。\n挂印还乡里，挥鞭出御楼。\n归途寻越绝，行橐佩吴钩。\n戎马东南急，凭君借箸筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都门逢湛如和尚","author":"徐熥","text":"金陵留偈别，燕市忽相逢。\n不托侯门钵，閒闻禁苑钟。\n经文翻北藏，禅理悟南宗。\n行脚他乡久，空房偃旧松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访杨山甫","author":"徐熥","text":"相过即留连，因君卜筑偏。\n香销炉有烬，茶熟灶生烟。\n采得芸驱蠹，栽将柳借蝉。\n门前时载酒，来叩子云玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陆纂父暮酌程康伯花下得枝字","author":"徐熥","text":"幽斋当薄暮，移酌傍花枝。\n选树莺窥酒，穿林蝶罥丝。\n月低流影缓，风细度香迟。\n不惮频来此，交欢无几时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陆纂父山人杨山甫保御集程康伯典客衙斋看芍药","author":"徐熥","text":"异种分仙禁，娇姿冠众芳。\n当阶翻绛艳，傍砌发浓香。\n郑国佳人赠，吴宫西子妆。\n画栏春色好，不用说维扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾人倩雨中过酌","author":"徐熥","text":"故人休沐暇，穷巷过吟鞭。\n散帙钩帘坐，寻诗解带眠。\n马蹄淹暮雨，莺语乱春烟。\n自与垆头熟，不愁无酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周叔宗郁孟野俞羡长李长白黎慎甫雨集分得微霁","author":"徐熥","text":"如丝看乍歇，庭际尚萧森。\n已觉收残霭，翻疑结薄阴。\n晚山消夕晕，好鸟间新音。\n徙倚花林暮，斜阳生远岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题曹能始计部潞河公署园亭","author":"徐熥","text":"司农开别墅，一径满烟霞。\n与鹤同临水，随蜂共放衙。\n榆飘沿径荚，榴发傍墙花。\n自足园池乐，无烦到习家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金季黄山人游五岳","author":"徐熥","text":"年来婚嫁毕，五岳寄閒心。\n胜地随缘住，名山到处寻。\n孤筇青嶂老，双屐白云深。\n去矣辞尘网，高踪比向禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河别曹能始 其一","author":"徐熥","text":"悲歌燕市筑，归兴潞河船。\n作客有何意，还山仍种田。\n穷猿投散木，饥鹘倦遥天。\n以我空囊故，怜君损俸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河别曹能始 其二","author":"徐熥","text":"流落谁如我，艰危况别君。\n渡淮三伏雨，瞻阙万重云。\n杀气旌旗满，哀声鼓角闻。\n临岐双涕泪，不独为离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河别曹能始 其三","author":"徐熥","text":"昔年同献赋，此日尚沉沦。\n我有恓皇泪，君怜弃置身。\n黄尘归路客，白发倚门亲。\n不尽消魂意，哀歌难重陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河别曹能始 其四","author":"徐熥","text":"久已歌黄鸟，还劳赋白驹。\n心雄犹短剑，目断更长途。\n去住总归客，行藏空腐儒。\n故园关百虑，何敢畏驰驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河驿别周叔宗","author":"徐熥","text":"经时俱作客，此地且盘桓。\n去路黄尘满，征衣白日寒。\n吴歌聊自和，燕月暂同看。\n因悔长安陌，蹉跎未尽欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出都门留别茅平仲周思敬朱汝脩吴孝甫张孺宗赵凡夫钟山甫韩兆之吴载伯阮步文张曰肩诸君","author":"徐熥","text":"违时空献策，落魄出燕南。\n恋阙情无极，离人思不堪。\n绿杨莺睍睆，青草马骖驔。\n总是飘蓬客，何时又盍簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"济上","author":"徐熥","text":"归兴已如此，归帆尚济州。\n沙汀芦受月，江岸蓼迎秋。\n不尽闽天远，无情汶水流。\n敢辞留滞苦，其奈倚门忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太白酒楼","author":"徐熥","text":"太白久不返，酒楼犹未倾。\n当年聊一醉，千载仰高名。\n隔岸围山色，凭栏到水声。\n风流无贺监，过客若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王粹夫客淮上先归相寻不值诗以怀之","author":"徐熥","text":"我来淮水上，君已解归舟。\n逆旅无长策，天涯总薄游。\n早辞征路苦，先见故园秋。\n漂母祠前过，因之双泪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿焦山赠道林上人","author":"徐熥","text":"鹫岭傍龙宫，慈帆但信风。\n悬灯孤嶂里，洗衲乱流中。\n山静云归锡，湖平月印空。\n道林名不沗，禅理似支公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚过惠山","author":"徐熥","text":"舍筏寻兰若，斜阳古殿开。\n竹烟深似雨，松瀑响如雷。\n水逐钟声去，云从塔影来。\n清泉随意取，装得满船回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王百谷招集南有堂","author":"徐熥","text":"故人三载别，此日一尊同。\n庵度旃檀雨，池凉蘋蓼风。\n暮蝉归树急，残暑入林穷。\n座客多湖海，乡心因暂空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题姚叔乂玄散斋","author":"徐熥","text":"幽斋栖委巷，萧散寄高吟。\n笔底青山债，尊前白发心。\n俗缘閒渐减，玄理老弥深。\n三径蓬蒿满，唯容二仲寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同沈稚咸过寒山寺访旭公","author":"徐熥","text":"曲岸暂维舟，精庐访比邱。\n钟声闻半夜，杯影见中流。\n榻倚干花晚，房开万竹秋。\n相看成一笑，疑是虎溪游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘会卿保御","author":"徐熥","text":"但得筋骸健，何妨鬓发苍。\n诗成开白社，书就秘青囊。\n世事閒能遣，机心老易忘。\n时时留客醉，丝竹满高堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠沈公绳","author":"徐熥","text":"久已称三绝，真如顾虎头。\n杜门閒自得，于世澹无求。\n丘壑胸中相，潇湘笔底秋。\n沈郎腰细尽，盘礴未能休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭盐官斯学上人","author":"徐熥","text":"微尘元世界，师已厌微尘。\n满月初圆果，浮云易了身。\n昙花天外散，金骨塔中新。\n不作无生想，闻之应损神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常山道中","author":"徐熥","text":"来时逢朔雪，归路又秋风。\n客计惭羸马，乡心逐去鸿。\n喜看闽地近，渐见越山穷。\n想到家林日，篱花开几丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经旧游怀康元龙","author":"徐熥","text":"西陵分别后，踪迹各飘零。\n又见枫林赤，依然酒幔青。\n关河仍旧路，风雪忆邮亭。\n独坐孤灯下，疏砧未可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹅湖晚行","author":"徐熥","text":"一径入莓苔，前峰夕照催。\n饥乌绕树去，乳犊出林来。\n山色自然秀，野花无意开。\n村村足幽趣，差得少迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"车盘驿","author":"徐熥","text":"征途秋草遍，客子倦知还。\n岁晚缲车急，年荒水碓閒。\n峰峦青络绎，溪涧绿回环。\n落日苍茫外，何山是故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归次建溪闻郑君大讣诗以哭之 其一","author":"徐熥","text":"忽尔传君死，犹疑讣未真。\n哀来魂欲断，痛定泪沾巾。\n泉路何其近，皇天太不仁。\n高阳脩旧社，应少白头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归次建溪闻郑君大讣诗以哭之 其二","author":"徐熥","text":"送我荷亭上，相看惜解携。\n生离犹唧唧，死别重凄凄。\n世不容豪侠，天疑爱滑稽。\n魂兮招不返，歌罢数行啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归次建溪闻郑君大讣诗以哭之 其三","author":"徐熥","text":"正拟还家日，对君怀抱开。\n如何千万语，总作一声哀。\n泪不到泉壤，书难通夜台。\n或君灵爽在，知我已归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归次建溪闻郑君大讣诗以哭之 其四","author":"徐熥","text":"交游君最长，矍铄有谁群。\n对酒杯邀月，看山屐蹑云。\n贫犹开白社，老不厌红裙。\n何意经年别，归来便哭君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日载酒同陈汝翔黄伯宠惟起惟扬二弟访王玉生郊居","author":"徐熥","text":"绿酒因君载，青山与客同。\n画成真道子，隐去即庞公。\n丘壑村村合，桑林巷巷通。\n坐来香不断，窗外木犀风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜袁无竞过酌","author":"徐熥","text":"钟声排小阁，灯影坠孤尊。\n竹净云阴薄，花疏霜气繁。\n卑喧虽近市，幽僻亦深村。\n坐久儿童睡，山风自掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪屠田叔使君游仁王寺同康元龙袁无竞兴公弟分得回字","author":"徐熥","text":"钟磬近香台，鸣驺半路回。\n庄严菩萨界，善信宰官来。\n合掌缘同结，攒眉禁暂开。\n山僧能爱客，莲漏不频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄若木还莆","author":"徐熥","text":"执手向城隅，送君归鲤湖。\n风涛危渡峡，雨雪倦登途。\n遣日携书卷，消寒问酒垆。\n不须嗟伏枥，千里待名驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高贤祠成荅屠使君 其一","author":"徐熥","text":"庙貌壮千秋，英灵托一丘。\n藻蘋无俗客，香火总名流。\n白骨化已久，清魂吟未休。\n预知百岁后，同得此中游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高贤祠成荅屠使君 其二","author":"徐熥","text":"八代斯文振，全闽雅道尊。\n精灵同不灭，显晦未须论。\n权自操吾党，名非藉子孙。\n泱泱东海上，真可霸中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高贤祠成荅屠使君 其三","author":"徐熥","text":"新祠劳仰止，神理定非遥。\n五世应难斩，千秋永不祧。\n像从诗外想，魂向赋中招。\n后死吾徒在，遗风未寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高贤祠成荅屠使君 其四","author":"徐熥","text":"俎豆隆殊典，山林更有光。\n诗真传在世，没果祭于乡。\n身后荣如此，生前困不妨。\n当年冠盖者，谁敢望宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渊溪十里桥与屠田叔泣别","author":"徐熥","text":"从来轩冕泪，不滴芰荷衣。\n独有今朝别，使君先泪挥。\n地偏愁会隔，天阔恐书稀。\n望望车尘远，人人哽咽归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惟秦冬夜偶至拥炉对酌率尔成咏","author":"徐熥","text":"音从空谷听，兴似剡溪乘。\n榾柮残炉火，松膋半壁灯。\n俗情谈后减，诗草别来增。\n浊酒堪消夜，浑忘朔气凝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感 其一","author":"徐熥","text":"传闻关白死，海气绝氛腥。\n间谍防真伪，悲欢杂涕零。\n王春回雨露，天怒息雷霆。\n时事难高枕，端居莫谓宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感 其二","author":"徐熥","text":"馁虎横行甚，村氓骨半枯。\n猛应凭伥鬼，威或假妖狐。\n白昼常当道，清时敢负嵎。\n官兵虚搏击，鸡犬反惊呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感 其三","author":"徐熥","text":"久雨防时歉，囊空米价腾。\n子钱残岁急，官赋隔年徵。\n薄劣明时弃，疏慵末俗憎。\n处篱同斥鴳，未敢望鹍鹏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠本净上人","author":"徐熥","text":"信心归净土，行脚到闽天。\n度众时开讲，降魔夜不眠。\n闻钟能悟性，补衲恐妨禅。\n何日参猊座，焚香听白莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林明府先辈挽诗卷后","author":"徐熥","text":"乡录留名姓，遗图见影神。\n鸣琴瀔水曲，归榇赣江滨。\n哭墓门生老，传家嗣子贫。\n卷中哀挽客，存者更何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰陈平夫","author":"徐熥","text":"怜君多难日，知己亦销魂。\n已叹如悬磬，何堪复鼓盆。\n旧情思挽鹿，新恨听啼猿。\n为问牛衣上，添将泪几痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与黄道晦夜坐话旧","author":"徐熥","text":"零落田园后，还嗟世事更。\n眼昏妨夜读，身老废春耕。\n稻麦亏丰岁，齑盐淡此生。\n相看灯影里，无限旧时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮戏题诗稿后","author":"徐熥","text":"本以牢骚著，多因幽愤成。\n雌黄招众口，青紫误今生。\n落落无穷意，遥遥不朽名。\n万言难卒岁，掩卷独伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水明楼赠陈仕卿","author":"徐熥","text":"日日来相访，爱君幽意长。\n画题随客命，诗债逼人偿。\n听雨坐蕉径，放云开竹房。\n入林无小阮，终少七贤狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得系臂纱送陆姬","author":"徐熥","text":"红汗沾犹湿，缠绵玉钏知。\n暗香生皓腕，微晕隐丰肌。\n疑作同心结，看如续命丝。\n守宫今褪尽，情重枕郎时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题普通寺","author":"徐熥","text":"山城已在山，寺更翠微间。\n磴路危因石，杉松密护关。\n莺声无意巧，云影自然閒。\n徐步经行久，桐花满地斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄思衡广文","author":"徐熥","text":"意气贫难减，文章老更工。\n身閒贪佛日，官冷称儒风。\n夫子推杨震，经生重马融。\n剑锋销未尽，耿耿尚如虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀惟秦客粤","author":"徐熥","text":"计程当入粤，踪迹竟何如。\n马度栟榈密，莺啼簟竹疏。\n定回天外梦，谁寄岭南书。\n寂寂蛮村路，知应念索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴城览古","author":"徐熥","text":"白云犹绕旧王居，独对西风恨有馀。\n百战山河归草莽，千年陵寝总丘墟。\n月明茂苑游麋鹿，花暗荒城吊阖庐。\n况是异乡多病客，岂堪唫眺暂踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意","author":"徐熥","text":"一天秋色露华清，独倚妆台别恨生。\n锦字缄愁过蓟水，寒衣将泪到辽城。\n梦回万里金微路，肠断三更玉篴声。\n起视明河人不见，朔云边月总关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲","author":"徐熥","text":"沙碛风高敌骑侵，将军新战贺兰阴。\n塞霜晓角降王泪，汉月秋笳壮士心。\n刀上洗瘢青血冷，营前望气白光沉。\n旄头未落边烽急，肠断空闺戍妇砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人入蜀","author":"徐熥","text":"忽闻天末雁声悲，况是尊前送客时。\n白发尚怀江海梦，青山空负薜萝期。\n马经剑阁晴虹断，帆过巴川夜月迟。\n夔府城头应吊古，寒云漠漠草离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖泛舟","author":"徐熥","text":"夕阳箫鼓起中流，十里芙蓉两岸秋。\n荇带乱萦青雀舫，菱歌低度白鸥洲。\n吴山积翠斜侵郭，越女凝妆尽倚楼。\n三竺钟声听渐远，半江微月送归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮王氏南园","author":"徐熥","text":"南园精舍远尘嚣，晏坐松阴暑气消。\n鹫岭云光连古堞，马江帆影逐归潮。\n乍闻金铎当空断，遥见珠幡隔寺飘。\n日晚寒鸦栖欲尽，海风吹月上山椒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲","author":"徐熥","text":"美人家住五陵东，沟水门前曲曲通。\n帘影半邀金市月，箫声閒度玉楼风。\n旧翻小扇桃花碧，新制单衫杏子红。\n十二栏干千树柳，不知何处系青骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]