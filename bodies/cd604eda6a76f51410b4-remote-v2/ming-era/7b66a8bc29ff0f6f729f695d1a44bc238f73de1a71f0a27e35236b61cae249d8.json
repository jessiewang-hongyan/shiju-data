[{"title":"九日袁惟学邀南园登高病不赴","author":"何景明","text":"经秋予卧病，九日汝登台。\n怅望啼猿处，无由跃马来。\n暮天双雁落，寒日一花开。\n亦有杯中物，孤怀未易裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月七日同诸生出游","author":"何景明","text":"清晨招尔辈，同出眺烟沙。\n寒食孤村路，春风万树花。\n藉兰临水曲，折柳到山家。\n独少青尊共，能无愧物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日震雷山怀望之","author":"何景明","text":"九日东山上，思君江汉深。\n故园频宴会，佳节自登临。\n众壑流云气，孤峰落日阴。\n应知楚山上，独赋望乡吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日忆京","author":"何景明","text":"此日忆京华，孤城春望赊。\n云霄双凤阙，歌舞万人家。\n香脆金盘菜，寒轻綵胜花。\n繁华旧时事，回首一长嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日哭先人墓二首 其一","author":"何景明","text":"春色松楸地，凄凉望不穷。\n一哀临逝水，痛哭起悲风。\n江海无归路，尘沙有断蓬。\n一杯元日酒，空洒九原中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日哭先人墓二首 其二","author":"何景明","text":"地下今安在，人间春自来。\n空馀万行泪，不尽百年哀。\n松柏开神路，星河隔夜台。\n林乌暮啼急，伫立不能回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"社前一日上先墓","author":"何景明","text":"莽莽乾坤阔，悠悠岁月过。\n极知恩似海，空有泪悬河。\n巢燕营新垒，林花发故柯。\n春风如往日，愁到此山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春望","author":"何景明","text":"荏苒青春望，栖迟白日歌。\n柳随愁共结，花与泪同多。\n异域犹戎马，吾生只薜萝。\n萋萋春草色，依旧满山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春来","author":"何景明","text":"春来稀洒扫，门径碧苔滋。\n积雨忘昏晓，幽居感岁时。\n寒云低旅雁，城树暗黄鹂。\n独立伤春色，萧条万事悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食","author":"何景明","text":"沙岸青春雨，风吹野水涯。\n不沽寒食酒，空映古坟花。\n城郭人烟细，楼台暮景斜。\n东流尔何意，滚滚送年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明","author":"何景明","text":"碧草晴川丽，游人与渺然。\n岁时聊杖履，儿女更鞦韆。\n沙白孤城日，山青万井烟。\n风花暮无数，片片落河边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲春二日","author":"何景明","text":"荒村春甲子，暮雨散高天。\n石壁临斜景，云岩落暗泉。\n长官行问俗，父老更占年。\n早晚春涛至，相将泛野船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚晴","author":"何景明","text":"茫茫春水地，斜日满菰蒲。\n隔水云峰峻，含风雪璧孤。\n晴光催谷鸟，暝色下城乌。\n仄径渔樵过，相逢亦我徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴","author":"何景明","text":"二月已过半，三月来逡巡。\n柳叶细可采，桃花开太频。\n白马过游客，黄鹂呼醉人。\n红颜楼上女，端坐独伤春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明自先茔归","author":"何景明","text":"感慨清明节，留连野外尊。\n花明兼柳暗，万落更千村。\n黄鸟鸣官路，青山绕郭门。\n常怀九原下，悽断百年魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过袁惟学南园集饮二首 其一","author":"何景明","text":"始识南园路，垂杨一径斜。\n谁言此城市，吾意即烟霞。\n客醉迷深打，莺啼过别花。\n图书一万卷，不异子云家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过袁惟学南园集饮二首 其二","author":"何景明","text":"独坐春林暮，飞花送酒杯。\n亭阴连水曲，山照落城隈。\n万竹当阶倚，千峰绕户回。\n高人读书处，莫厌我频来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同赵先生宿山家","author":"何景明","text":"同宿京华地，今来又六年。\n那知风雪夜，复此共床眠。\n水曲邻灯照，山高石溜悬。\n中宵不成寐，话旧各悽然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘朝信西园","author":"何景明","text":"邀客西园内，知君爱醉吟。\n相看二月尽，无奈百年侵。\n春水桃花岸，高亭橘树林。\n晚来有幽意，西望白云岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶邦重山居","author":"何景明","text":"幽栖近兰若，来慰野人情。\n户外双峰秀，阶前众壑平。\n鸟鸣春树里，僧傍翠岩行。\n日暮山钟发，相随夜到城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寺僧留宿","author":"何景明","text":"留宿频经夜，虚空断俗缘。\n独吟依野衲，不寐听山泉。\n水月人间地，香灯象外天。\n何时谢城郭，来此共安禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别寺僧是日立春","author":"何景明","text":"别寺逢春日，山盘野菜长。\n老僧朝具饭，留客更焚香。\n雨暮枫花静，云寒柏树苍。\n独惭骑马去，尘事未能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出寺过胡山人家","author":"何景明","text":"细雨清沙路，经行独杖藜。\n那知白社客，更向碧山栖。\n花好围墙发，鶑娇入院啼。\n风光不能醉，吟望转凄迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮邦重山庄夜归","author":"何景明","text":"残日喧归骑，渔樵仄径逢。\n烟中望北郭，树里下西峰。\n深夜明林火，苍茫度水钟。\n朝来向城市，谁忆白云踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贤隐寺次刘朝信","author":"何景明","text":"翠壁青莲界，苍苔白石关。\n春来初出郭，日暮更登山。\n岁月频经眼，烟霞可驻颜。\n化城依宿处，自觉此身閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁挥使别墅次朝信惟学韵","author":"何景明","text":"出城山水地，朋旧共斯游。\n吟倚将军马，来乘老氏牛。\n桃花红映郭，柳色翠临流。\n寄语寻幽者，无劳此外求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游坚山阮生谈西岩险绝予未尝到","author":"何景明","text":"闻尔西岩上，经行此路艰。\n风高吹独立，云细袅难攀。\n目送千峰尽，身随一鸟还。\n更传僧八十，终日闭松关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜酌黑龙潭二首 其一","author":"何景明","text":"川流一曲抱，峭壁万年开。\n白石传杯坐，青天送月来。\n蛟龙亦自舞，鸥鹭岂相猜。\n谁识仙潭上，天留此钓台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜酌黑龙潭二首 其二","author":"何景明","text":"百顷风潭静，澄波夜转明。\n江山一壶酒，天地六人情。\n醉踏金鳌背，潜窥玉鲤行。\n龙宫月长满，何惜坐深更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留贾西谷学舍","author":"何景明","text":"独院团双桧，清阴午更繁。\n笙歌聊辍讲，市井不闻喧。\n坛杏当筵坠，阶葵夹座翻。\n怜君交谊重，数到广文园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王生馆雨坐","author":"何景明","text":"独坐王生馆，凄然岁暮心。\n高城翻落照，空院积寒霖。\n雁鹜秋飞尽，蛟龙夜或吟。\n西山旧松竹，雨雪共萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过先人墓示彭天章二首 其一","author":"何景明","text":"三宿孤坟下，肝场尔独知。\n不禁桑梓泪，难忘蓼莪诗。\n逝水有归处，白云无尽期。\n九原灵爽在，相见是何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过先人墓示彭天章二首 其二","author":"何景明","text":"少小承颜日，恩深世所稀。\n仓皇成永诀，冥漠竟同归。\n天地空形影，音容有是非。\n此身如寸草，何以荅春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同季升过李生书舍","author":"何景明","text":"避寇孤城里，君家数倒尊。\n柳边开草阁，花下觅柴门。\n台古如山郭，塘幽似水村。\n南邻张给事，常与坐黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登西岩寺二首 其一","author":"何景明","text":"西林禅诵地，石壁倚天开。\n曲磴千盘上，飞泉一道来。\n园禽巢古殿，野鹿过香台。\n共坐题诗暮，山花落酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登西岩寺二首 其二","author":"何景明","text":"野寺千峰里，游人一径深。\n窗喧石涧水，殿落翠岩阴。\n花树三春暮，山川百代心。\n天风日夕厉，难上最高岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游贤隐寺","author":"何景明","text":"寂寂春山寺，双峰昼自阴。\n行吟白云里，独慰翠微心。\n石磴悬萝暗，岩亭杂树深。\n还疑武陵口，溪水入花林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过万家庄","author":"何景明","text":"野屋水潺湲，缘崖一径攀。\n回风吹落日，腊雪满寒山。\n千嶂啼猿里，孤峰骑马还。\n苍茫云雾合，无路觅禅关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访坚山寺僧不遇","author":"何景明","text":"峭壁何年寺，重来雪路迷。\n烟霞开宝地，霄汉接丹梯。\n逼面千峰起，回头万壑低。\n无人独归去，惆怅白云西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再至寺","author":"何景明","text":"山家晚饭罢，清夜宿西林。\n古壁栖金象，花宫出梵音。\n三生石上话，万劫世间心。\n独爱寒岩柏，苍苍一院阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登坚山寺绝顶真武庙二首 其一","author":"何景明","text":"古庙坚山上，丹青碧藓封。\n游人不到处，一老自鸣钟。\n绝壁飞泉挂，危峰曲径通。\n岧峣一以望，顿觉世尘空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登坚山寺绝顶真武庙二首 其二","author":"何景明","text":"同来息心石，不避舍身台。\n洞里烟云出，窗中日月开。\n孤僧绝顶住，游客半空回。\n不尽登高兴，无人送酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀西山","author":"何景明","text":"不到西峰久，那堪病后情。\n云思丹壑卧，花梦碧岩行。\n城郭邀来往，朝廷问姓名。\n人间自多事，叹息此浮生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自山家归寺","author":"何景明","text":"暝色延归路，云中见上方。\n万山悬马首，一径入羊肠。\n暮雨横沙界，阴霞拂院墙。\n更深磬管发，身世乐何乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"近寺","author":"何景明","text":"梵宇频经处，林深入磬声。\n悬崖攀葛上，曲涧绕松行。\n花鸟还春日，楼台即代城。\n亦知身是妄，从此学无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过书院二首 其一","author":"何景明","text":"书院新开日，文旌暂过时。\n衣冠成小试，丝竹更相随。\n冻柳依高堞，霜荷傍曲池。\n夜来占宝气，应向斗牛知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过书院二首 其二","author":"何景明","text":"驻马高城畔，酣歌送落梅。\n风霜十月尽，杯酒众宾回。\n柳色含春动，笳声向晚催。\n故园无限意，行节为迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登楼","author":"何景明","text":"孟夏游兹地，登楼慰所期。\n树阴深坐客，花晚更题诗。\n满院红榴发，当檐白果垂。\n风情真可住，俗物苦相追。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过杜家庄","author":"何景明","text":"山老频邀客，茅茨隔暮烟。\n闻鸡度绝峤，立马看飞泉。\n种柳非无地，栽麻亦有田。\n谋生今已定，不用卜居篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独坐","author":"何景明","text":"独坐孤灯静，忧心倍寂寥。\n横河当户转，落月去城遥。\n泪向何时尽，魂从暗里销。\n此身虽复在，甘与岁时飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独立","author":"何景明","text":"鼓绝孤城掩，溪傍春事残。\n岸霞晴映树，汀雨暮生寒。\n风外看花尽，烟中望柳繁。\n静观时物变，独立思千端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁秀才书院芍药","author":"何景明","text":"亦是倾城色，开仍傍杏坛。\n日迟深院落，风转曲阑干。\n不恨先桃李，皆言胜牡丹。\n春华惟在此，游客好相看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李秀才圃中牡丹","author":"何景明","text":"此地无车马，名花亦自开。\n何须照罗绮，但遣绝尘埃。\n近水红云绽，凭阑白日回。\n姚黄与魏紫，空向洛阳栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李秀才书屋冬菊花","author":"何景明","text":"万树皆零落，亭亭独自栽。\n根深饱霜雪，花好烂池台。\n短鬓烦相映，孤怀为尔来。\n凡花与众草，岁暮不同开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵生书堂竹","author":"何景明","text":"爱尔书堂竹，青青耐久看。\n到门帷一径，入院迥千竿。\n两映炉烟细，霜生簟色寒。\n晚来幽独兴，题句刻琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅","author":"何景明","text":"野水无人地，寒梅独自开。\n花疏间翠筱，树古积苍苔。\n岭雪春潜至，林风香暗来。\n一枝犹可折，横笛暮休哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀贾长教坛上杏花","author":"何景明","text":"山城疏雨过，绿草暗庭阴。\n坐爱三春树，怀君双杏林。\n日长鸣鸟至，风静落花深。\n怅望高坛上，何由共尔吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"樱桃","author":"何景明","text":"满郡樱桃熟，筠笼处处传。\n千枝垂更密，万颗落仍圆。\n细写愁难破，尝新泪泫然。\n金盘赐朝士，犹忆拜恩年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芍药","author":"何景明","text":"芍药春风晚，开迟莫自嗟。\n城中虽有树，此外更无花。\n倚席低行月，翻阶斗落霞。\n佳人对瑶瑟，一为惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双柏","author":"何景明","text":"双柏种何岁，苍然盘据深。\n蛟龙犹有甲，观鹤尔何心。\n月过阴移壁，风生响度岑。\n万年烟雾里，长得护禅林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪","author":"何景明","text":"莽莽黄云起，凄凄素雪浮。\n堂深偏近烛，院迥不依楼。\n喜见漫天舞，愁看向日流。\n更将三白兆，一慰老农忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻雷","author":"何景明","text":"中宵岩电发，二月始鸣雷。\n落地殷仍起，盘空划欲回。\n蛟龙入浦溆，风雨过城隈。\n独坐明灯里，空堂万虑催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓起见雪","author":"何景明","text":"曙色空窗里，鸣禽更好音。\n幽栖忘盥栉，偃卧问晴阴。\n卷幔山云起，开门野雪深。\n不愁泥泞路，骑马度西岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"何景明","text":"疾雨冲城下，春寒入暮催。\n树明捎落电，山暗转奔雷。\n正月花狂放，三江雁乱回。\n国西兵马急，愁问羽书来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"密雨","author":"何景明","text":"密雨过清朝，空山对寂寥。\n久阴雷电蛰，旷野虎狼骄。\n鹭立清沙近，鸥行白水遥。\n眼前常见汝，俗物谩相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔樵","author":"何景明","text":"白石樵人路，沧江渔父浔。\n桃花夹两岸，松色映孤岑。\n坐傍鼋鼍窟，行穿虎豹林。\n古今问荅意，谁识邵公心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮阴侯","author":"何景明","text":"大将登台贵，三军拔帜豪。\n力能分楚汉，功本冠萧曹。\n故垒风云偃，空山虎豹号。\n独怜飞鸟叹，不及范生高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吹笙","author":"何景明","text":"寂寂花宫月，何人吹玉笙。\n响从银汉落，清遏彩云行。\n夜静疑天籁，更深入梵声。\n幽心与禅意，凄切转关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"废屋","author":"何景明","text":"废屋空山里，风沙不见人。\n坏墙惟有径，独树更无邻。\n寇盗三关逼，徵求万国频。\n江湖暮摇落，回首一沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕子","author":"何景明","text":"燕子今春到，茅堂水郭西。\n本无华屋志，难向玉楼栖。\n雨细鸣相并，风轻落故低。\n淘河莫深讶，只是为㘅泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病马六首 其一","author":"何景明","text":"柴公有名马，骑出自京华。\n峻耳批双竹，奇毛散五花。\n老能知道路，病已困泥沙。\n贵贱诚如此，长吟为尔嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]