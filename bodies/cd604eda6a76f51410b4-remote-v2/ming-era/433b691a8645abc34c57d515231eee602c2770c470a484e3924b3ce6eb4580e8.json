[{"title":"次韵王敏文待制燕京杂咏 其六","author":"来复","text":"锦貂公子跃龙媒，不怕金吾夜漏催。\n阿刺声高檀板急，棕毛别殿宴春回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王敏文待制燕京杂咏 其七","author":"来复","text":"凤池凉翠滴梧桐，白发祠官侍内宫。\n见说御前催草诏，水精帘映玉屏风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵王敏文待制燕京杂咏 其十","author":"来复","text":"契丹髯将老无依，力倦弓刀请受微。\n薄暮雪寒烧土炕，毡裘拾得马通归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次虞邵庵韵送闲上人","author":"来复","text":"佛香浮雾昼霏帘，春涧鸣泉雪后添。\n乞食归来双树底，散花如雨读《楞严》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄神乐观邓仲修仙官 其一","author":"来复","text":"天上琳宫白玉梯，别开方丈五云西。\n金花传赐仙官诰，上有乾清御墨题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄神乐观邓仲修仙官 其二","author":"来复","text":"醮罢星辰校绿章，虚坛夜夜降祠光。\n白鸾骑得朝天去，手把芙蓉侍紫皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄神乐观邓仲修仙官 其四","author":"来复","text":"紫翠房深敞石屏，神仙炼液漱清泠。\n铁符催起龙行雨，白日风雷走六丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄神乐观邓仲修仙官 其五","author":"来复","text":"自信身闲即是仙，金丹何必问长年。\n修真独许陶弘景，曾看袈裟习夜禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄神乐观邓仲修仙官 其六","author":"来复","text":"奉祠曾谒会稽山，湖曲天风振佩环。\n一色荷花三百里，洞箫吹月镜中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宋徽宗棠梨冻鹊图","author":"来复","text":"五国城头落日低，故宫南望思凄迷。\n秋风愁杀棠梨树，不及双禽自在栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送金员外归泉南 其一","author":"来复","text":"曾说西游过月支，宴酣花市踏春归。\n兜罗香带蔷薇露，犹是戎王旧赐衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车驾临蒋山于崇祷寺赐高僧斋议设无遮会谩成口号 其一","author":"来复","text":"崇禧寺前风日清，銮舆遥迓定钟鸣。\n山林有道裨王化，天地无私荷圣情。\n娄约入梁终应诏，惠琳居宋岂贪名。\n金山重感千年梦，愿济幽灵答治平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车驾临蒋山于崇祷寺赐高僧斋议设无遮会谩成口号 其二","author":"来复","text":"祗园花雨晓吹香，手绾袈裟近御床。\n阙下紫云随雉尾，座间红日动龙光。\n金盘苏合颁殊域，玉碗醍醐出尚方。\n稠叠屡承天上供，每惭无德颂陶唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同朝天宫道士朝回口号 其二","author":"来复","text":"午阴初转御桥湾，斋退从容出九关。\n天上好风重送喜，銮舆明日幸钟山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉柬周伯温左丞 其一","author":"来复","text":"学士风流玉雪标，早陪凤辇听仙《韶》。\n光分莲炬从天下，香带炉烟近日飘。\n书拟汉秦夸二篆，史修南北见三朝。\n承恩曾记东来日，绣斧光华拥使轺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉柬周伯温左丞 其二","author":"来复","text":"江淮烽火数州连，分镇东吴有岁年。\n化雨早清蛟蜃气，文星夜动斗牛躔。\n贡来南粤终归汉，书入聊城遂破燕。\n天下澄清今日望，角巾未许赋归田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉寄月彦明中丞 其一","author":"来复","text":"三月扁舟渡鉴湖，楝花风急雨晴初。\n共知出处心无愧，自信经纶志未疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉寄月彦明中丞 其二","author":"来复","text":"海上云霞明绣斧，人间奎壁焕图书。\n中兴近报王师捷，征诏行看下玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次芝轩中丞韵","author":"来复","text":"执法南从越绝居，绣衣光彩照坤舆。\n黄金遗子无私橐，白发匡君有谏书。\n远捷已飞江上羽，群凶真作釜中鱼。\n归朝定策中兴业，笑我山林与世疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赵彦徵溪山小景图","author":"来复","text":"曾泛苕溪看晚霞，红帘小艇稳于车。\n水通孤岸桥依竹，路入重林屋傍花。\n风外眠鸥惊客笛，云中吠犬隔仙家。\n秋波千顷芙蓉老，谁觅王孙旧钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡文善之官海南文昌县 其一","author":"来复","text":"琼州南去海冥冥，婺女垂光应地灵。\n洞入朱耶泷水白，山蟠黎母瘴烟青。\n邮炊每食桄榔面，蛮赋多输翡翠翎。\n定有远人歌善治，风谣纪德重镌铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡文善之官海南文昌县 其二","author":"来复","text":"九域于今总一家，文昌谁道隔天涯。\n石榴红酿蛮江酒，海漆香收瘴洞花。\n寨上人耕春作市，棠阴吏散晚休衙。\n苏公应共题诗好，儋耳泉头驻小车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵赵子将提举秋兴","author":"来复","text":"绝漠风高雨土沙，五云何处望京华。\n南征尚阻勤王贡，北泛频劳奉使槎。\n藩将戈船遥蔽海，国人弓马旧为家。\n洗兵会有承平日，社稷安危不用嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄柬玉山处士","author":"来复","text":"浮玉山前种紫芝，松萝云月共幽期。\n封侯不羡黄金印，对客长歌白雪词。\n柳浪平湖春放棹，花阴围座昼弹棋。\n从游公子多才俊，不寄新诗慰别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游石湖兰若 其一","author":"来复","text":"荷花荡西湖水深，上有兰若当高岑。\n客吟时见猿鸟下，僧定不闻钟磬音。\n雨香秋林橘子熟，云落空涧棠梨阴。\n闲来扫石坐竹里，静与山人论素心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游石湖兰若 其二","author":"来复","text":"五龙之峰云作屏，双崖削出芙蓉青。\n何人涧里拾瑶草，有客松间寻茯苓。\n林风不惊虎卧石，山雨忽来龙听经。\n吴王台榭今寂寞，秋香薜荔花冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄洞庭叶隐君","author":"来复","text":"一舸南归鬓欲华，买山湖上卧烟霞。\n尊知北海应多酒，园拟东陵亦种瓜。\n丹壑泉舂云碓药，橘林风扫石床花。\n传家自与邻翁异，只说藏书有五车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂诗 其二","author":"来复","text":"宝网金幢变劫灰，瞿昙寺里尽蒿莱。\n鸟窠无树山夔泣，不见谈禅太傅来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂诗 其三","author":"来复","text":"流觞亭子凤山阿，都护行春小队过。\n笑掷金钱花底醉，玉簪弹出《白翎歌》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂诗 其四","author":"来复","text":"荷锄耕叟饷蒸梨，家在官塘九曲西。\n白发强谈兵后事，眼枯无泪向人啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"掩关","author":"来复","text":"槁木形骸百念灰，溪猿野鹤若相猜。\n闲门独掩青松雨，笑口逢人亦懒开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题阳关送别图","author":"来复","text":"三月皇州送佩珂，柳花吹雪满官河。\n纵令渭水深千尺，不似阳关别泪多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄荃芦雁图","author":"来复","text":"稻满秋田水满汀，黄芦风急度寒声。\n太平江海无缯缴，不用呼奴夜打更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题夏圭风雨行舟图","author":"来复","text":"君游南越我西秦，尽日江头采白蘋。\n无限波涛起平陆，顺风休笑逆帆人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵仲穆春山晓思图","author":"来复","text":"树色苍凉晓欲迷，石门初入鹧鸪啼。\n桃花不隔秦人路，流出红云水涨溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答刘克勤","author":"云峰住公","text":"老来轩冕不须期，还慕林泉岁月迟。\n双眼长青惟爱客，满头都白苦缘诗。\n尚传天禄书千卷，犹对青藜杖一枝。\n无事闲来依佛日，白云深处启禅扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答王祖年","author":"云峰住公","text":"南山得话岁寒期，道合宁论会面迟。\n元亮休官能入社，少陵问法悟观诗。\n茶烹石鼎新敲火，衣挂云松旧偃枝。\n自是一闲天所放，日高尚闭竹间扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送径山隆上主回吴中","author":"云峰住公","text":"海内车书喜混同，飞云流水逐行踪。\n秋风遍乞王城饭，夜月长听官寺钟。\n物外闲情怜淡泊，灯前软语话从容。\n明朝棹指吴天杳，矫首东南送断鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石经山","author":"姚广孝","text":"峨峨石经山，莲峰吐金碧。\n秀气钟芯题，胜槩拟西域。\n竺坟五千卷，华言百师译。\n琬公惧变灭，铁笔写苍石。\n片片青瑶光，字字太古色。\n功非一代就，用藉万人力。\n流传鄙简编，坚固陋板刻。\n深由地穴藏，高从岩洞积。\n初疑神鬼工，乃著造化迹。\n延洪胜汲冢，防虞犹孔壁。\n不畏野火烧，讵愁藓苔蚀。\n兹山既无尽，是法宁有极。\n如何大业间，得此至人出。\n幽明获尔利，乾坤配其德。\n大哉弘法心，吾徒可为则。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人之松江得曙字","author":"姚广孝","text":"潮来沙碛平，月落海门曙。\n汀蒲转风叶，堤柳摇烟絮。\n江头春可怜，天涯人独去。\n有歌送君行，无酒留君住。\n雪浪没沙鸥，云帆出江树。\n回首读书声，青山不知处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿福智精舍怀南邻张羽来仪","author":"姚广孝","text":"我客怅无依，君居欣在迩。\n清谈夕散归，独卧松轩里。\n露香槛前桂，月色池上水。\n怀尔正沉沉，不知暮钟起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蠡口夜归","author":"姚广孝","text":"日没渡口昏，水风着人热。\n渔灯带萤火，微光互明灭。\n舟人报水程，路远行欲歇。\n故山不分明，目尽心力绝。\n遥想山中人，待人仍待月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"茶轩为陈惟寅赋","author":"姚广孝","text":"千苞凛冰雪，一树当窗几。\n晴旭晓微烘，游蜂掠芳蕊。\n澹香匀蜜露，繁艳照烟水。\n幽人赏咏迟，每恨残红委。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访震师不遇","author":"姚广孝","text":"波澄一溪云，霜红半山树。\n荒烟满空林，疏钟在何处？\n不遇采樵人，复抱孤琴去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和徐一夔游龙山杂赋二首 其一","author":"姚广孝","text":"翛翛一禅宫，楼台隐金碧。\n松关掩呗音，花龛锁云迹。\n群僧礼祖馀，香灯自长夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和徐一夔游龙山杂赋二首 其二","author":"姚广孝","text":"出崦不逢山，长江波淼淼。\n落日下遥汀，寒云翳沙鸟。\n延伫目难穷，孤帆来树杪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春晚坐南轩喜王山人过访","author":"姚广孝","text":"春阳势未舒，林深暮还冷。\n开轩怅久坐，独对青松影。\n石龛冱闲云，苔井响寒绠。\n惊客鸟翻翻，照佛灯耿耿。\n华畾辱远过，杂遝破幽静。\n临风笑语温，道念心已领。\n谅惟高世士，元非玩光景。\n遥送出林扉，新月悬西岭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚步","author":"姚广孝","text":"晚步出门去，林端见新月。\n牛羊下岭来，疏钟何处歇。\n行行且复伫，遥对西山雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白蚬江阻风夜宿江口兼怀徐贲","author":"姚广孝","text":"颠风江渡难，停稆依茭葑。\n涛烟翳暝光，滩月侵寒梦。\n渔归候火明，凫眠忌芦动。\n遇险更思君，陡觉离愁重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琴台","author":"姚广孝","text":"崇台起云岑，夫差日游宴。\n七弦石上弹，闲花落馀片。\n风清松答响，烟茸草成荐。\n至今想馀音，泠泠散秋院。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上方","author":"姚广孝","text":"莲宫据山椒，岧峣去天咫。\n风香花雨新，僧行白云里。\n幽沉树乐静，萧散烟钟起。\n人登石路迷，依依缘涧水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浒溪","author":"姚广孝","text":"青山两岸分，夕渡舟横口。\n夏雨欲生莲，秋风先到柳。\n声残烟寺钟，香馀茆店酒。\n相见无别人，唯逢耕钓叟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"师林精舍遇盈师夜坐","author":"姚广孝","text":"空林长掩关，閒云去无迹。\n偶来值禅侣，清谈忘永夕。\n坐久磬声沉，松堂一灯寂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车遥遥","author":"姚广孝","text":"车遥遥，行人心忙疑路迢。\n黄尘眯目神更乱，红雨点衣魂欲消。\n车声似与啼声续，羊肠难比愁肠曲。\n沙头酒家不少留，匆匆碾破平芜绿。\n妾身愿同杨叶轻，春风千里随车行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖乌曲","author":"姚广孝","text":"哑哑乌，结巢庭树枝。\n去年庭树官尽伐，主人不忍乌巢移。\n城上月明金柝罢，临风遥望乌来归。\n乌不归，主应恼，非是嗔乌情义少。\n愿汝结巢田野间，莫恋他家树枝好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题观音岩","author":"姚广孝","text":"高阁临虚如履地，长江万里来无际。\n世人可到不可留，只许禅僧仝结制。\n乱帆来往逐云飞，隔岸淮山拥翠微。\n大士岩前常宴坐，孤灯夜照客船归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采薖为馀唐卿赋","author":"姚广孝","text":"馀君抱奇言不夸，种菜拟学元修家。\n临溪筑庐竞诛草，傍路樊圃多编葭。\n长镵短夋自成列，不与文笔相交加。\n畦界条条任衡缩，沟浍一一随纡斜。\n种多不减三十品，分苗撒子时无差。\n溉灌未能亲抱瓮，设计巧欲为翻车。\n一畦既传渤海薤，五色更接东陵瓜。\n新菘脆美初斫脍，嫩瓠肥白才燖豝。\n马齿忽惊齐发苋，牛乳始识骈垂茄。\n芳心缠丝恶网蛛，老叶画籀欣涎蜗。\n自能垦土不芜秽，便可应候登柔嘉。\n长奴芟夷脚自赤，老婢采撷头还髽。\n不令筐筥混葵藿，反任鼎俎兼鱼虾。\n莼羹自适颇豪迈，□齑可办何咄嗟。\n谁云小摘畏伤指，我欲大嚼尝摇牙。\n何时携杖叩君室，且需木耳并槐芽。\n苟能真率见情亲，奚鄙酒薄兼尊污。\n一餐自足饱空腹，岂特姜桂烹鸡鴐。\n丈夫不能知此味，五鼎日食成淫奢。\n君今措事慕诸葛，蔓菁随处为生涯。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行","author":"姚广孝","text":"山前雨晴山后阴，权篱花繁萝径深。\n烧烟无数人家少，樵子两三来远村。\n断桥流水不可度，落日孤猿空候吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚过狮子林","author":"姚广孝","text":"无地堪逃俗，乘昏复到林。\n半山云遏磬，深竹雨留禽。\n观水通禅意，闻香去染心。\n叩门惊有客，想亦为幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张山人适乐圃林馆","author":"姚广孝","text":"开牖依林樾，迢迢去市遥。\n翠低承雨竹，绿碎受风蕉。\n夕岭还侵户，春流欲断桥。\n主人缘爱客，时为出山瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张山人适乐圃林馆 其二","author":"姚广孝","text":"一轩开小圃，近水更悠然。\n杏栋萦花雾，芸窗宿篆烟。\n竹藏鸠子哺，苔衬鹤雏眠。\n此地多风景，幽深似辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日重游穹窿山海云精舍 其二","author":"姚广孝","text":"地远尘难到，人家半隔溪。\n放禅还候磬，起晓却凭鸡。\n云度随山窈，泉行趁涧低。\n披丛寻藓壁，更为刻新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"日暮沙上口号","author":"姚广孝","text":"寂寂村深路，人家尽掩扉。\n平沙萦鸟篆，疏树络云衣。\n无兴从南去，多情向北归。\n老年行履倦，宿不待斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"姚广孝","text":"小小板桥斜路，深深茅屋人家。\n竹坞夕阴多雨，桃源春暖多花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张山人适见访暮归口号","author":"姚广孝","text":"隔水茅堂尘静，临溪松户时开。\n烟碧涧边非草，云白山前是梅。\n琴为知音一曲，酒缘得意多杯。\n今日乘骖且去，明朝带鹤重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙川宫","author":"姚广孝","text":"琳宫虚爽接微垣，玉树阴森隔市喧。\n日转松坛人影寂，春回花殿鸟声繁。\n仙乘风去开圜室，云带龙归锁洞门。\n福地年来犹落寞，人间消息底须论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京口览古","author":"姚广孝","text":"谯橹年来战血乾，烟花犹自半凋残。\n五州山近朝云乱，万岁楼空夜月寒。\n江水无潮通铁瓮，野田有路到金坛。\n萧梁事业今何在，北固青青客倦看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":59259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]