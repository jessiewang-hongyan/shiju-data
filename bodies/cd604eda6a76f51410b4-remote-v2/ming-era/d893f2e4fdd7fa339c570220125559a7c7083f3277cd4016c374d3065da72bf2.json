[{"title":"寿俞清庵博士八十","author":"孙继皋","text":"传经两地领诸儒，罢讲归来貌转臞。\n桃李晚依台里柏，桑麻老傍社中榆。\n筏曾渡海观能定，履惯登山醉不扶。\n那羡磻溪后车载，申公徵驾待新蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送骧宇顾丈按鹾河中","author":"孙继皋","text":"绣衣雄斧简书催，盐筴军须急上才。\n骢步暂劳衔命去，虎形争待献功来。\n传飞秋色严霜度，台俯河流底柱回。\n体国忧边今日事，贤良新议属君裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送费参军赴兰州","author":"孙继皋","text":"警急金城路，烽烟接夏州。\n送君愁落日，诸将迫防秋。\n破敌辕门誓，论兵虎帐筹。\n临流怀慷慨，结束有吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渔溪图","author":"孙继皋","text":"放艇垂竿狎钓徒，春流千顷荡蘼芜。\n不知杨子江头路，也许羊裘物色无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行得游字","author":"孙继皋","text":"病眼豁遐瞩，素心酬薄游。\n川原如往日，风气尚馀秋。\n农穫知天意，军兴费主忧。\n江湖倘无恙，吾计足扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵送王大归石沙旧隐","author":"孙继皋","text":"尔祖乘骢去，家山榛莽中。\n萧条归旧业，门巷想清风。\n乔木留残柏，孤踪息转蓬。\n悠哉此避世，人或拟墙东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿李远沙八十","author":"孙继皋","text":"腊暖江清弄野烟，四朝身老鬓犹玄。\n度关早识真人气，钓渭今同尚父年。\n丛桂两山供拄笏，梅花千树傍开筵。\n谁言除夕当明夕，柏酒春风岁岁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王母图寿浦母七十","author":"孙继皋","text":"曾看东海几生尘，寿母临觞白发新。\n蓂叶恰馀三十日，桃花才换六千春。\n宫歌宴喜疑闻鲁，台筑怀清不羡秦。\n三凤一时看比翼，天书青鸟下来频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅宿即事","author":"孙继皋","text":"风雨河流急，维舟意若何。\n岸崩人住少，野泊客愁多。\n宦迹歌行路，乡心指逝波。\n江南此三月，烟景借渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄河阻风","author":"孙继皋","text":"黄河建瓴势，溯舟良独难。\n况此春风颠，奔流吼高滩。\n蛟龙怒相攫，乌雀戢其翰。\n孤帆两岸绝，长空浩漫漫。\n所以去复止，端居不敢安。\n翻思昨日程，晴霭排青峦。\n篷底坐对之，行稳心何宽。\n因之得宦道，拙巧同一观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三义祠","author":"孙继皋","text":"古城曾不见，祠宇大河阴。\n邂逅君臣契，艰危战斗心。\n神来铁马动，祚去赤龙吟。\n结义当年事，英灵直到今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古城初见花","author":"孙继皋","text":"曲河西上动经旬，只见流沙不见春。\n何处桃花媚村落，艳阳怜杀往来人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沁方初见月","author":"孙继皋","text":"自从扬旆出青林，愁雨愁风驿路心。\n今夜河流看月出，流波千顷尽浮金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下邳初见山","author":"孙继皋","text":"好山晴日片帆移，忽似江南春泛时。\n但得蓬窗当对此，不妨官舫去迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行限帆字","author":"孙继皋","text":"画舫压春帆，春深换客衫。\n流波回叠鼓，远翠落千岩。\n草暗青湖合，鱼翻白鸟衔。\n官程行自稳，不问路仙凡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张湫晓发","author":"孙继皋","text":"官程候晓发，川柳拂船低。\n雨过防新涨，烟开辨古堤。\n莺花看逼夏，鸡犬欲闻齐。\n多少征人梦，萋萋草色迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊寺送华舍人芝台奉使西塞还乡","author":"孙继皋","text":"城阴花木隐禅扃，系马人看使节停。\n转饷已窥秦塞紫，行山犹指蓟门青。\n交情梦里占离合，世事尊前感醉醒。\n惆怅风萍不暂住，乡心今夜逐寒星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送如空游五台","author":"孙继皋","text":"离垢尔何著，情亲予意伤。\n辞天去辇毂，皈佛向清凉。\n戴笠关云白，闻钟岭树苍。\n家山亦净土，相劝早还乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王弘所南还","author":"孙继皋","text":"独客惨不乐，曰归秋色深。\n白云游子意，青鬓选人心。\n候雁征同宿，寒花去可簪。\n天涯兼岁晏，吾亦想中林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送乔二尹之任","author":"孙继皋","text":"不腆一山城，分忧借此行。\n枳栖百里寄，棠荫万家情。\n问俗应心苦，闻泉想政清。\n丞哉去何负，儒术本知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠冯太史琢庵归省","author":"孙继皋","text":"冰衔刚署领簪裾，诏许宁亲下石渠。\n过里殊荣看拥传，趋庭新庆傍悬舆。\n经曾旃厦勤翻后，彩是金绯赐著初。\n知道乘春瓯卜近，亲承温语在仙居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈稚登太学闻得孙有赠","author":"孙继皋","text":"南来君是客中身，听说生孙傍小春。\n兰桂乍怜重茁日，桑蓬偏慰远游人。\n囊携宝剑传堪永，代产明珠业不贫。\n朋好两家看再世，可能星聚比荀陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巴蜀杨方伯过里为其尊公寿","author":"孙继皋","text":"花诰重宣捧陛听，高贤永夏及趋庭。\n南山酒献官为岳，益部人占寿是星。\n彩服舞看双鹤白，玄文传识一牛青。\n巴江雪浪年年曲，似祝长生抱竹坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿薛封君","author":"孙继皋","text":"不赴公车慕草玄，一经仍付后人贤。\n薛公自爱浆家隐，居士今传洛社仙。\n花满碧鸡衔诰日，霜回骢马奉觞年。\n昆明万里重霄隔，老去翻疑雨露偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和大宗伯罗公瑞雪应祈之作次韵","author":"孙继皋","text":"南宫斋夜切星辰，周阙依稀谒五神。\n精白应祈占岁瑞，穹苍孚格见皇仁。\n凝同玉露迷仙掌，舞学琼花点相茵。\n一自上公歌郢后，国中谁解和阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和少宗伯刘公赍敕入朝遇雪次韵","author":"孙继皋","text":"曙光寒色净霏微，五位深垂想舜衣。\n灏气千门浮御苑，春晖一夜满皇畿。\n官梅绰约芬华省，禁树苍茫映粉闱。\n诏许布新元会近，欲因天瑞纪龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谭开府年兄省觐","author":"孙继皋","text":"主恩家庆傍潘舆，介寿人归秉钺初。\n蜀道天遥驱阪驭，楚乡春暖馔江鱼。\n金花诰簇云霞色，玉树庭森雨露馀。\n却想高贤会耆艾，簪裾词赋美璠玙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题秋海棠卷","author":"孙继皋","text":"春艳睡不足，秋娇翻靓妆。\n西宫亦天露，何必醉沉香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李侍御尊公七帙","author":"孙继皋","text":"白发沧江上，三朝百岁人。\n花间留胜事，李下识前身。\n经术高贤嗣，才名弱齿臻。\n匣尊鸾诰重，庭舞豸袍新。\n玉杖初传赐，瑶卮不记巡。\n蟠桃呈永日，霜橘荫馀春。\n暮景鸥盟固，仙龄鹤算均。\n犹闻颂嵩岳，欢动两河民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孙学博行状册","author":"孙继皋","text":"宫墙不可望，桃李自依依。\n遗行儿能次，高风世所师。\n青毡留讲席，黄绢待丰碑。\n万里门人泪，春云想绛帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜坐月得公字","author":"孙继皋","text":"凉月空庭得，清尊此夕同。\n行觞佳节后，坐客大江东。\n避暑思袁绍，登楼想庾公。\n相逢各意气，君莫叹飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安道","author":"孙继皋","text":"长安道，道上行人多，五侯七贵纷相过。\n黄金绾印青丝緺。\n长安道，道上行人少。\n满眼风波平地来，对面山川尚心好。\n人来人去不相知，骋智争名无尽期。\n可怜头白不醒悟，只说天西蜀道危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈复吾署教泰州","author":"孙继皋","text":"不去公车籍，聊为捧檄行。\n鱼盐通故国，桃李艳春城。\n扬子传经渡，门人载酒迎。\n朋来看胜事，片玉久知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱襟泉署教滁阳","author":"孙继皋","text":"紫阙衔恩日，青毡抗席初。\n乡心宽陟屺，山色秀环滁。\n亭古登临外，堂春讲诵馀。\n湘灵千载事，华服兆三鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和彭文学翼庵郊居对雪限灯字","author":"孙继皋","text":"客况孤云薄，禅心片雪澄。\n去移东郭履，吟傍上方灯。\n路自青门近，杯应白社憎。\n可能抛世鞅，与尔听三乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陵祀途次作","author":"孙继皋","text":"行役及春晴，春迟柳乍萦。\n青峦拄汉出，紫甸荡云平。\n车马通驰道，桥陵控上京。\n金瓯万年胜，垂拱见时清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠华上林中宇二绝句 其一","author":"孙继皋","text":"拜得新衔隶上林，春风管领夹城深。\n柏梁一自词臣集，应制荣华直到今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠华上林中宇二绝句 其二","author":"孙继皋","text":"赀郎何必汉长卿，汝亦凌云擅大名。\n莫以清时无狗监，几人曾听上林莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭翼庵博士之官昆山","author":"孙继皋","text":"一毡随牒领青衿，儒行才名众所钦。\n故国江东山似绣，诸生门下玉为林。\n玄亭载酒朋来乐，绛帐传经老去心。\n荐祢何人惭启事，弹琴空自说知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏月同诸子集管舍人新居得欢字","author":"孙继皋","text":"卜筑成新趣，招邀足旧欢。\n群英盛璀璨，孤秀出琅玕。\n令节将县艾，同心总佩兰。\n看云思结夏，歌雪觉生寒。\n席换情弥洽，杯深意未阑。\n薄游无不可，词客满长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵赠黄琴士","author":"孙继皋","text":"春色闭门深，囊琴客解寻。\n朱弦还古调，白雪几知音。\n空外寒泉响，天涯芳草心。\n相期弄岩月，吾已谢朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫宸宣对册赠管建初舍人","author":"孙继皋","text":"少年天子白衣臣，特旨传呼上殿频。\n手写山河盘日月，魂摇宫阙动星辰。\n一时綵笔空当代，平地青云致此身。\n我亦彤墀曾对字，下帘容易望龙鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待命有述","author":"孙继皋","text":"弃置元吾道，淹留自主恩。\n避人经伏腊，羁旅信乾坤。\n抚枕沧洲近，开帘绿雨繁。\n迟迟去亦得，二纪傍金门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源舟中钟方吉诸君追送因赋","author":"孙继皋","text":"肯惜归帆憩，频呼别酒斟。\n浮云客子梦，落日故人心。\n岸树纷秋色，河流杂梵音。\n无官到处好，不待住中林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为郭希所赠公赋","author":"孙继皋","text":"中丞嘉绩在潇湘，帝以趋庭美义方。\n人比林宗归式谷，天生召伯付甘棠。\n诰传北阙双龙舞，仙去重湖九鲤翔。\n共道至尊优独坐，芝原遥夜动辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边南亭太守考绩","author":"孙继皋","text":"三年书绩半桑麻，领郡风流帝所嘉。\n名高汉室二千石，歌遍江城十万家。\n到日青郊纷跨竹，从天紫诰烂生花。\n九卿特召寻常事，只许棠阴处处遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠沈禹门先生","author":"孙继皋","text":"才名蚤岁似相如，白发青衫老著书。\n门对五湖高士宅，家留八咏隐侯居。\n閒情落月酣歌外，世事浮云感慨馀。\n著屐便思随杖屦，挂冠吾亦解银鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴江夜泊","author":"孙继皋","text":"津亭晚泊客心孤，暝色山光乍有无。\n水郭帆樯依雁鹜，人家灯火乱菰蒲。\n天寒雪霰窥双鬓，岁晏烟波隔五湖。\n城里歌钟知几处，锦堂华烛醉毡毹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"光福寺看梅雨回泊印玉山","author":"孙继皋","text":"山上梅花湖上舟，雨中楼阁镜中浮。\n苍茫自爱回桡住，潦倒何妨载酒游。\n莺语不闻春半去，云容多幻晚全收。\n移家便欲谋渔父，衰鬓閒心傍野鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游玄墓山","author":"孙继皋","text":"古路危梯石径悬，空王台殿俯诸天。\n灯明震泽千波净，香供梅花万树鲜。\n鹫岭尚传持世法，龙碑犹记赐诗年。\n登临未尽尘心断，欲上绳床问四禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨泊用兼字十六句","author":"孙继皋","text":"著履飞扬甚，维舟信宿淹。\n山寒花黯黯，湖白雨纤纤。\n沾湿春光度，羁栖客思添。\n天应芳赏妒，人岂胜游兼。\n去住惭鸥乐，阴晴付鸟占。\n愁来衣带缓，欢动酒杯严。\n信使遥能待，吟情晚不嫌。\n何当出红日，香雪乱青帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游梅潭东西诸山","author":"孙继皋","text":"绝岭沿湖度笋舆，轻阴浮翠雨晴初。\n千林香雪重重破，一路仙云片片舒。\n渐老春心游转王，催人霜鬓映全疏。\n岁寒薄有菟裘计，欲乞孤芳傍绮疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日稚登元穆诸丈过山堂小集得三字","author":"孙继皋","text":"六月林亭伏日三，客来新故坐相参。\n深杯高宴疑河朔，脩竹清川想渭南。\n动地繁阴云物变，映山残照雨丝含。\n五湖渐有扁舟兴，秋到澄波净蔚蓝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵令公考绩","author":"孙继皋","text":"三年嘉绩美菰芦，为政风流与众殊。\n花满河阳辉墨绶，珠来南海映冰壶。\n春和问俗频飞盖，月朔朝天几下凫。\n不腆山城十万户，何人不颂雉将雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴司理考绩","author":"孙继皋","text":"朱衣丹笔照金昌，四海声华自楚张。\n郢曲乍传飞白雪，吴钩新试肃清霜。\n泣车下泽来鸿雁，集佩天池待凤皇。\n共道政成人作颂，采芳多挹芷兰香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邵司理考绩","author":"孙继皋","text":"五夜金科手自翻，青春丹笔几平反。\n庭惊老吏年殊少，郡有神君下不冤。\n召伯甘棠荣满路，于公驷马俨高门。\n齐天戴日闻舆诵，凤诰鸾书见主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿吴仰玄","author":"孙继皋","text":"草玄亭子白云关，心与岩花谷鸟閒。\n第五名尊骠骑上，于陵身老桔槔閒。\n春祠太乙逢初度，昼鍊青阳得大还。\n白日飞翰容易见，铜官玉女本仙山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送西僧妙智上人之峨嵋","author":"孙继皋","text":"来从西域去西川，来去从参不住禅。\n却笑东林松树子，风枝转换也年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谈囧簿","author":"孙继皋","text":"离筵歌管动朱旄，落日风烟暗宝刀。\n送客不禁攀弱柳，还朝应及荐樱桃。\n时危勋业空麟阁，年少才名自马曹。\n老我长林群鹿豕，几回吟望五云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜与林若抚即席赋得回字","author":"孙继皋","text":"秋色空堂暮，商歌醉几回。\n西风响众壑，北斗下深杯。\n世路多荆棘，人才半草莱。\n沉冥无不可，衰飒暗中催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对菊得诗字与若抚同赋","author":"孙继皋","text":"秋堂静黯黯，霜菊粲枝枝。\n有客狂能就，无官醉不辞。\n餐英嗟物换，簪艳觉颜衰。\n篱落风流在，长歌彭泽诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠若抚","author":"孙继皋","text":"异县能相过，新知好共论。\n五言今大历，十日古平原。\n抱瑟难谐俗，怀珠拟报恩。\n少年饶美业，看汝剧飞翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴云庵","author":"孙继皋","text":"辞家远作采真行，踪迹三年滞一城。\n袖有青囊山鬼避，方馀金匮市儿迎。\n姓名尚许寰中识，妻子何妨谷口耕。\n待得丹成生羽翰，白云黄鹤望吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吕布衣","author":"孙继皋","text":"老随萍叶泛沧洲，曾佐莲花幕里筹。\n上坐谈兵空日月，名山采药自春秋。\n岳楼几醉仙人酒，齐舍休弹剑客缑。\n不以时违思辟谷，帷臣亦伴赤松游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱匡庐还德清 其一","author":"孙继皋","text":"孤云不信客中贫，绿绮携将苕水春。\n却怪年来频禁酒，匡山白社识前身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱匡庐还德清 其二","author":"孙继皋","text":"九龙夭矫送归航，载得寒泉是橐装。\n家近吴兴明月峡，将泉煮茗一春香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱匡庐还德清 其三","author":"孙继皋","text":"梁溪君住一年无，半傍僧寮半酒徒。\n归去不缘愁岁晏，梅花消息在西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]