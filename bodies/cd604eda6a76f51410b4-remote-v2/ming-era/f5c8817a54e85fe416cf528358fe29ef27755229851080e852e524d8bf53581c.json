[{"title":"过分水庙戏成棹歌六章 其一","author":"程敏政","text":"济河潺潺向北流，济河㶁㶁向南流。\n官船私舶都过此，南来北去几时休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过分水庙戏成棹歌六章 其二","author":"程敏政","text":"一条河里两般风，南客张篷北落篷。\n天公只是无心子，有心人莫怨天公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过分水庙戏成棹歌六章 其三","author":"程敏政","text":"龙王庙前石作堤，马头湾脚路成泥。\n莫笑水流分彼此，只缘地势有高低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过分水庙戏成棹歌六章 其四","author":"程敏政","text":"东岸人家开饭奁，西岸人家垂酒帘。\n传道行人莫轻买，今年沽价十分添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过分水庙戏成棹歌六章 其五","author":"程敏政","text":"供应船头金弹丸，醉坐船里珍馐盘。\n有人推篷怜饿殍，大家说是秀才官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过分水庙戏成棹歌六章 其六","author":"程敏政","text":"老郎荷锸开浅洲，小儿曳缆送官舟。\n朝朝去见垂杨柳，不管流离苦到头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次荆门管河杨郎中求题水墨葡萄","author":"程敏政","text":"空中忽散摩尼珠，一一牵动骊龙须。\n鲛人泪莫尽升斗，贾胡价可论锱铢。\n居然月上蜿蜒架，真宰有心愁幻化。\n玄香隐隐凝不飞，瘦影离离巧相亚。\n良工近来人未知，日观不来还数谁。\n乳酒年来熟银瓮，客星终夜窥端池。\n关西夫子行河使，宝绘堂中了公事。\n底须满摘水晶盘，眼饱令人发诗思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过聊城县境","author":"程敏政","text":"策士知仁义，千秋一鲁生。\n纷纷当日事，春水下聊城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武城","author":"程敏政","text":"千载武城县，依然鲁水涯。\n民生如不遂，弦诵亦何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乘月夜发二鼓至甲马营","author":"程敏政","text":"晓色苍苍下武城，解舟还趁月中行。\n河流曲写之玄字，渔唱清传欸乃声。\n随处倚篷吟不尽，迩来欹枕梦难成。\n灯前未暇呼津吏，问是何年甲马营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次德州简管粮张道济主事同年","author":"程敏政","text":"一冬南去一春还，历尽征途水与山。\n却忆故人清话处，隔城相望夕阳间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"良店道中大风夜作野泊安陵达晓风息趋连窝","author":"程敏政","text":"我行沧景路，渺渺夜过亥。\n东风何太颠，势欲?鲸海。\n盘涡如阱旋，骇浪若山嵬。\n崩腾沙口决，斩剥岸形改。\n官舟浮一匏，出没渐危殆。\n牵夫屡前却，舟子失精采。\n无乃蛟龙怒，或恐鼋鼍馁。\n合力眠高桅，择地舣而待。\n家人走彷徨，船头设菹醢。\n相呼酹冯夷，亦欲诉真宰。\n狂飙俄尔恬，愁云散其叆。\n张帆下中流，击楫歌欸乃。\n起望推双篷，喜气人百倍。\n向来得失心，悠悠竟安在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别沧州守禦赵将军诗三首 其一","author":"程敏政","text":"临河高堞古沧州，一将分符得上游。\n充国由来好孙子，营平终袭汉家侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别沧州守禦赵将军诗三首 其二","author":"程敏政","text":"骨肉相违岁几更，偶然离合更关情。\n家传只有龙韬在，一卷殷勤付馆甥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别沧州守禦赵将军诗三首 其三","author":"程敏政","text":"横海军声震朔庭，土人多失旧图经。\n高原何处藏弓剑，落日寒云蔓草青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为赵守禦题溪云居士水墨龙","author":"程敏政","text":"阴风萧萧吹急雨，龙子相将乞龙乳。\n随潮上下不可撄，头角疑能作人语。\n溪云画手工不工，抚景还思陈所翁。\n旱岁安能慰民望，青天白日驱丰隆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"静海道中地名杨柳青园林隐映可爱","author":"程敏政","text":"春阴澹沲绿杨津，两岸风来不动尘。\n一日船窗见桃李，便惊身是卧游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"直沽望海","author":"程敏政","text":"击楫中流亦快哉，海门春放一帆开。\n五更日透烟霏出，万里风推云浪来。\n壮志不惊龙窟宅，奇观初识凤楼台。\n行边历历鱼盐士，倘有平时出众才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨村逆风通夕","author":"程敏政","text":"忽忽无言里，悠悠不寐中。\n短檠流绛蜡，阴牖落青虫。\n人幸窥篷月，天悭上水风。\n白河三百里，羁思浩无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"通州道中","author":"程敏政","text":"夹岸摇摇酒幔长，野人渔牧自成庄。\n商征晓集河西务，漕粟春投水次仓。\n几个鹤巢依古树，一声鸡唱出柔桑。\n眼中渐觉风光好，直北红云是帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张家湾","author":"程敏政","text":"张家湾口望都城，犹是行人半日程。\n羸马似龙谙旧主，临河相顾一长鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入都城","author":"程敏政","text":"十里红尘马首翻，眼中不改旧颓垣。\n征夫引躅犹穿巷，稚子迎欢正及门。\n襆被几时淹驿路，衣冠明日叩天阍。\n往来敢惮关河险，得遂私情是主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其一 登京口望江楼","author":"程敏政","text":"故国园林草自芳，望中情地转凄凉。\n行人莫苦登高阁，高处何曾见故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其二 途中遇郑时晖御史赴谪还家养疾二首","author":"程敏政","text":"湛恩惟待立鸡竿，岂是明时学考槃。\n身计未谐归计好，一宵清话到更阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其三","author":"程敏政","text":"尘寰渐远渐凄清，地近乡关喜气生。\n只恐诏书非久下，归来依旧马蹄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其四 自况二首","author":"程敏政","text":"千里幽怀一凭阑，君恩宁许更盘桓。\n朝中未有输忠处，肯便临溪把钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其五","author":"程敏政","text":"铅堑辛勤十四年，幸逢圣主得称贤。\n秃毫强会悠悠事，敏政当居俗吏前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其六 车瓜州坝","author":"程敏政","text":"泥途渐过车声滑，才得扶舁渡浅河。\n从此异乡谁是侣，月明孤影落澄波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其七 饮扬州嵩山寺二首","author":"程敏政","text":"醉乡□□□□□，沦落多愁笑不成。\n苦恨俗缘无了处，江村古寺偶閒行。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其八","author":"程敏政","text":"閒愁不觉过年光，只有醒时觉异乡。\n不醉多愁醉多病，一篇齐物是医方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其九 淮上对月","author":"程敏政","text":"劳生谁在定中看，境胜才知宇宙宽。\n一月解行天一匝，素娥心事问应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十 登泗水亭","author":"程敏政","text":"青山行尽入红尘，古木亭边夜向晨。\n书未隔年难得报，我来登望倍凝神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十一 歇济宁分水铺","author":"程敏政","text":"二江斜入似娥眉，华郭春光欲暮时。\n京洛路长何日到，几人相见不相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十二 临清遇雨","author":"程敏政","text":"一尊撩眼怕长迷，月欲东生日又西。\n已恨碧山相阻隔，不期风雨更凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十三 过柳青村","author":"程敏政","text":"不知园圃是谁家，开尽无名草木花。\n今日倚阑添懊恼，人言落日是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十四 有怀亡弟五首","author":"程敏政","text":"家园归省浙江东，璧碎珠沉几日中。\n尘里笙歌千古梦，悠悠无处问苍穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十五","author":"程敏政","text":"泪滴金杯不自知，天孙何约是来时。\n骑鲸别后无寻处，一步寒郊一惨眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十六","author":"程敏政","text":"月意愔愔露气微，池亭何处见清晖。\n只应梦里成胡蝶，拟共杨花苦斗飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十七","author":"程敏政","text":"风月犹应似旧清，困来终是睡难成。\n相思无计能相见，肠断城头画角声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集李绝句十八首 其十八","author":"程敏政","text":"下有娇儿上有亲，阑边为汝最伤神。\n流年渐共春华老，闻说清明在此辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送康用和南归诗","author":"程敏政","text":"矫矫丹山雏，孤飞直千仞。\n昂昂汗血驹，天闲谢羁靷。\n君子赋归欤，使我失朋亲。\n忆昔与君友，我发始髫龄。\n君气不可当，感激慕英蔺。\n虎闱驰夙声，乌台发新轫。\n威行畿甸间，事至若迎刃。\n朝纲固已肃，颓风亦云振。\n哗言倏中起，万里竟遭摈。\n终为一寸铁，蹇蹇磨不磷。\n驱驰闽海隅，再领县厅印。\n低首奉期会，坐遣民俗顺。\n霈泽岂不施，展转四更闰。\n翩然徵诏下，驿骑走方镇。\n谓君先天学，往往决悔吝。\n行当几日程，喜入九重觐。\n衣冠太史氏，相顾得豪隽。\n朅从拜命来，惊君雪垂鬓。\n在告越踰年，日日理衰疢。\n居然停禄食，有待竭忠荩。\n士节难自保，我疾可无慎。\n封章乞解组，伏阙再三进。\n云臣本孤陋，颇欲激芳润。\n少小读韦编，漫识离与震。\n挂扐有成法，筮者殆充牣。\n犬马心弗胜，此选亦太遴。\n倘讦遂臣私，实免负尧舜。\n言词既恳切，重瞳乃回瞬。\n萧萧官廨中，四鼓对馀烬。\n黎明出都门，徒步一何迅。\n平生几交游，逆旅漫相讯。\n君言幸此归，馀生绝嫌衅。\n松菊莽犹存，庭户扫还汎。\n儿子已胜耕，岂复念寒馑。\n水次分鱼租，山中乐田畯。\n稽首荷天王，恩波一朝浚。\n君才诚卓荦，君志更孤峻。\n永奉大夫欢，不愧世家胤。\n嗟彼名利场，人或以身徇。\n富贵将何为，幻若野中燐。\n是非千载后，孰是驽与骏。\n郊亭九月馀，霜气入鸿阵。\n渺渺征车行，落叶载途衬。\n送君无限情，长歌以相赆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次南京尚宝泰和杨公述职诗韵 其一","author":"程敏政","text":"忧国长思策治安，迩来微觉鬓毛残。\n牙绯当殿初书最，清白传家久耐寒。\n正论几闻倾四望，高眠犹说计三餐。\n老成终近君王侧，双佩追随应八銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次南京尚宝泰和杨公述职诗韵 其二","author":"程敏政","text":"不随桃李竞春荣，宦辙惟君守一诚。\n典瑞职当金阙近，奉常卿比玉壶清。\n宠光向晚频烦下，诗思清秋一倍生。\n拟有颂声歌圣德，怀乡宁似庾兰成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次南京尚宝泰和杨公述职诗韵 其三","author":"程敏政","text":"郭隗台边秋日明，张家湾里暮潮平。\n离筵句好开新社，分寺官閒说旧京。\n白雁叫霜先客度，黄花经雨待谁荣。\n怜予最有江南忆，把袂因君百念生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十月一日进历青宫叨预执事呈同事罗洗马","author":"程敏政","text":"文华门启日临墀，凤历初陈鹤驾移。\n卫士分行旗影杂，官僚双引佩声迟。\n万年正朔遵先纪，一代规模陋汉仪。\n海岳又开新泰运，愧无鸿笔颂重熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王而勉太守","author":"程敏政","text":"亲舍分明紫翠间，梦魂无夜不南还。\n羁鸿远隔三千里，驽马空陪十二闲。\n乡思更深云梦泽，古诗谁继陆浑山。\n家书拟说贤明府，问俗时来一扣关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张郎中彦质省亲还蜀","author":"程敏政","text":"离筵新酒白波浑，一棹西还荷主恩。\n宦辙屡经扬子渡，家园长切武侯屯。\n尘生客袂身方健，喜入亲颜齿更尊。\n小弟心情亦如此，敢忘天语若春温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陆顺之赴南京户部主事 其一","author":"程敏政","text":"征辔纷纷罥柳枝，喜君今日拜恩辞。\n短亭残暑仍挥箑，久客多情屡荐卮。\n辇下文章推甲第，江南财赋属留司。\n两京子部皆珍选，好在诸贤答盛时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陆顺之赴南京户部主事 其二","author":"程敏政","text":"不须挥手听离歌，此到南都仅月过。\n丛桂再开新府次，棣棠应发旧厅阿。\n家常问讯通邮近，公暇储书积俸多。\n小阮相逢烦致语，东朝虚席候鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"圯上仙踪送吏部黄侍郎弟叔衡南归","author":"程敏政","text":"下邳城东沂水流，水中圯桥春复秋。\n何物老翁有奇术，乃此折辱张留侯。\n往事悠悠已千载，履迹宁随浪纹改。\n莫推授受不可当，太息无人继风采。\n侯官才人黄叔衡，家居不出多史评。\n文章伯氏今少宰，远省到京无限情。\n雁声催人难久住，风雨萧萧复南去。\n水边大石堪舣舟，予固应知赋长句。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"胡忠安公挽章 其一","author":"程敏政","text":"品秩登三事，忠勋历五朝。\n衣冠存典礼，风俗被薰陶。\n泽国鸥盟解，钧天鹤梦遥。\n独留全德在，天不想风标。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"胡忠安公挽章 其二","author":"程敏政","text":"忆昔垂髫日，抠衣拜省庭。\n松筠知寿考，金玉见仪刑。\n命笔看题字，扶筇问治经。\n百年回首处，无地候台星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"半隐为濮用明教谕赋","author":"程敏政","text":"手提文印历三城，处处岩栖少送迎。\n拄笏看云惟自适，濯缨临水共谁盟。\n未容全享山林福，且得兼收吏隐名。\n芸阁梦回还独笑，六街尘拥马蹄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送唐御医致仕还嘉兴 其一","author":"程敏政","text":"早岁从徵住药坊，老来纳禄返江乡。\n闽湖战处君还记，多少征人请异方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送唐御医致仕还嘉兴 其二","author":"程敏政","text":"堂扁如心到处闻，铁厓词赋始丰文。\n还家开卷遥相忆，广巷高楼隔暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送唐御医致仕还嘉兴 其三","author":"程敏政","text":"日日门前客似麻，活人心苦鬓先华。\n此回秀水城中路，医道谁当第一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分得剑井送濮用昭兵部公差便道还毗陵","author":"程敏政","text":"毗陵东城隅，剑井千尺深。\n当年葛仙翁，驻鹤曾幽寻。\n有时灵秀硌，白虹出其阴。\n魁材与硕辅，秉毓人争歆。\n濮君兵曹彦，家住此水浔。\n奉檄向江南，薰风惜离襟。\n安舟载老母，甚遂平生心。\n颇闻井中气，耿耿发自今。\n愿保忠孝期，为子歌好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王而勉太守","author":"程敏政","text":"昔在山城暂得亲，一襟潇洒浩如春。\n通家谊欲兼师友，雅会情忘论主宾。\n南望不堪云碍眼，北来惟有月随身。\n等閒却爱听公议，藩省今思起旧人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄孙挥使千户侯","author":"程敏政","text":"辕门开近歙山阿，日日投壶事雅歌。\n养士渐能谙礼乐，逢时全不用干戈。\n梦长绕阙心何壮，住久随乡语半讹。\n犹记前时相别处，一丛车骑绕临河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题小景寄汪廷器","author":"程敏政","text":"拍岸纹溪水不浑，一间亭子傍松根。\n披图恍在芝山下，倚棹来寻断石村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荣寿堂为会昌太傅公子锦衣瓒赋","author":"程敏政","text":"醴泉乡中凤山秀，孕我景陵县太母。\n庆源衮衮生公侯，忠孝承家数元舅。\n元舅年过八十馀，发如皎雪颜如朱。\n迩来谢兵奉朝请，出入特许乘安车。\n手诏时来诏耆德，赐府潭潭帝城北。\n锦衣公子开新堂，日领孙曾候颜色。\n优游已似地行仙，眼看乔木上参天。\n讲帏史局从公旧，愿保勋名到百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邢侍郎居敬挽章","author":"程敏政","text":"楚节随恩侍紫清，棹歌声里独魂惊。\n空馀易学传三辅，无复官名署两京。\n清白已堪书太史，经纶应未了平生。\n相如老去人争羡，分赐无缘及露茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄于老千户","author":"程敏政","text":"老去将军最好文，出群名字久相闻。\n几人识面窥春色，十载思归隔暮云。\n延客酒方应自制，游山诗韵好谁分。\n投瓜拟得琼瑶报，何日双鱼寄水濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分得洁蔬供膳为黄岩谢良温孝子赋","author":"程敏政","text":"采采园蔬翠堪把，粪不污茎水清洒。\n晨炊又过午炊来，长跪奉盘供膝下。\n于乎奉亲易，说亲难。\n爱儿不脱儒生酸，藜藿到口皆成欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]