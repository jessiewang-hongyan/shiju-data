[{"title":"九日饮冰玉堂和韵十首 其十","author":"苏葵","text":"身为冰玉堂中客，梦逐柴桑花下人。\n老爱曲生成故旧，醉怜金屑弄鲜新。\n阳消阴长天何意，燕去鸿来物自神。\n倒着接䍦学山简，不知踪迹尚红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再宿分水公馆","author":"苏葵","text":"一水东西二邑分，数楹公馆傍山云。\n千盘径路人行少，两度肩舆我到勤。\n树古漫留鹃血迹，草残多印鹿蹄痕。\n明朝正上蟠龙顶，老眼犹能望帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日芸香小阁燕坐偶成二首 其一","author":"苏葵","text":"院宇无尘有落花，水晶帘外竹交加。\n书当快意频惊蠹，酒为催诗不怯蛇。\n心上乾坤偏浩荡，眼前尘土漫纷奢。\n曲阑徙倚闲思想，学到庄周亦大家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日芸香小阁燕坐偶成二首 其二","author":"苏葵","text":"庭草青青长欲齐，道人情性亦濂溪。\n绝无野马侵窗几，惟有光风拂杖藜。\n报喜报晴鳷鹊噪，呼云呼雨鹁鸠啼。\n平生颇识闲滋味，傲睨乾坤日未西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄久要乡人晦峰","author":"苏葵","text":"黑头交谊老惭疏，万里无因致起居。\n病肺问医须补导，暮年为计贵赢馀。\n山遥水远空多梦，纸短情长不尽书。\n薄宦颇能相慰藉，柏台如水绝苞苴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顺庆行台试士","author":"苏葵","text":"燕雀无声乌府幽，东风檐外彩云流。\n衔枚多士机谋壮，织锦何人手段优。\n谁似长公堪避舍，我非韩子亦低头。\n六经仁义如周道，分付诸君莫谬悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"按顺庆毕事力疾之岳池道中漫兴","author":"苏葵","text":"药石无功日皱眉，笋舆扶强问行歧。\n病来不减娄公跛，老去真同顾恺痴。\n万事乾坤犹在梦，一春花鸟未成诗。\n风流我愧人豪甚，怕有尧夫暗解颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过纪信故里","author":"苏葵","text":"投饵从容虎益瞋，休论奇物献商辛。\n可怜被衮封功日，不问降车出郭人。\n云梦有疑终赤族，荥阳休恨早焚身。\n天荒地老三巴外，树得风声在四邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端阳病足遣怀呈江景吴二首 其一","author":"苏葵","text":"几日床帏不暂离，家人疑我学希夷。\n卧将本草从头检，过却端阳不自知。\n屯否在人常大半，忧愁于我更相持。\n行藏惠迪多年悟，造化真成是小儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端阳病足遣怀呈江景吴二首 其二","author":"苏葵","text":"愠来拊髀失全肤，何物为妖不可袪。\n任强加餐如鹤瘦，未当衰老倩人扶。\n日长筠管螟蛉化，春静雕梁燕子呼。\n无限世间能疾走，相看那得不胡卢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘克让同知还湖南佥宪刘原左迁者","author":"苏葵","text":"元都过后又刘郎，开落桃花十几霜。\n贾谊正醒迁客梦，山公新上荐贤章。\n神羊风采真如故，尺蠖行藏亦是常。\n吾道不徒三尺法，凭君珍重入湖湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顺庆沈太守建岁寒书院偶留题","author":"苏葵","text":"人间多少读书处，欲固岁寒贤守心。\n隔岁草莱诛濯濯，一庭松柏长森森。\n汉儒载籍能存几，周政规模却至今。\n老病星轺三月过，欲扬洙泗洗清襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸亥六月念一日同寅诸公过予敝道看竹因留小酌遂成拙作二首索和 其一","author":"苏葵","text":"一庭苍玉欠人看，谁似王猷兴未阑。\n愿典春衣供酒盏，每迎宾从上诗坛。\n雨催苦节淩霄汉，风飏柔枝舞凤鸾。\n淇澳猗猗今不减，先生何畏切磋难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸亥六月念一日同寅诸公过予敝道看竹因留小酌遂成拙作二首索和 其二","author":"苏葵","text":"万个青青耐久看，每愁风横益凋阑。\n首阳饿叟联家谱，玉版禅师共石坛。\n只友寒松辞恶木，不栖野鸟候真鸾。\n高轩若肯时相过，百斛松花买不难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈正郎学之乡友见寄","author":"苏葵","text":"闻韶方觉郑声淫，信有朝阳彩凤吟。\n何逊悰情原洒脱，乐天诗句不钩深。\n封题寄我闻前样，缱绻知君旧雨心。\n骚雅只今谁独擅，江门风韵已消沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代贺新都杨佥宪封君七十一二首 其一","author":"苏葵","text":"不从金鼎炼丹砂，自比贞松历岁华。\n仙鹤日长窥染顶，蟠桃春近看开花。\n人间五福真如海，膝下诸郎欲拜麻。\n闲把衣冠细详品，古今能几似君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代贺新都杨佥宪封君七十一二首 其二","author":"苏葵","text":"一时桥梓羡谁家，次第清朝拜宠嘉。\n勇退自欣棋结局，晋褒人讶锦添花。\n华封往事留三祝，王母新来献九霞。\n醉后明朝无别事，东风庭院看兰芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乙斋义官亲家兼柬景弘乡友二首 其一","author":"苏葵","text":"角巾花坞又莲池，处处壶觞处处诗。\n梦入槐柯真可笑，战残蜗角欲何为。\n西山薇在何妨老，东海人归想未迟。\n莫道红尘苦迷恋，此心长傍白云驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乙斋义官亲家兼柬景弘乡友二首 其二","author":"苏葵","text":"沈檀烟袅昼垂帘，坐听飞花落画檐。\n银甲拨时鲈鲙软，玉觥流处蟹螯甜。\n诗边金谷应常占，梦里红尘也不沾。\n万里未归应有念，筋骸如故鬓霜添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸亥岁晏漫成二首 其一","author":"苏葵","text":"两丸朝夕似飞车，寒暑谁教限岁华。\n心上乾坤能了几，鬓边霜雪又添些。\n浮生底用怜疣赘，老气犹思砺莫邪。\n偶作三更吟不寐，满天凉月浸梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸亥岁晏漫成二首 其二","author":"苏葵","text":"无多日子又新年，筋力将来岂及前。\n漫道伏波能矍铄，不知颜驷已皤然。\n玉环未拜天边赐，金印何因肘后悬。\n明日西邮将用武，欲投铅椠买长鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日病中遣怀呈陈宪长二首 其一","author":"苏葵","text":"春深花发柳将齐，无限韶光候品题。\n载酒未过杨子宅，寻诗谁泛杜陵溪。\n穿林蛱蝶看将舞，出谷苍庚想未啼。\n记取兰亭修褉日，浴沂童冠正堪携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日病中遣怀呈陈宪长二首 其二","author":"苏葵","text":"荏苒韶华半已过，浴沂消息又如何。\n浣花溪上多黄鸟，濯锦桥边尽碧波。\n几日杖藜惭跛鳖，谁家箫鼓闹鸣鼍。\n花开花落悰情在，弄月吟风战病魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代送张仲明兵备宪副致政还楝庄二首 其一","author":"苏葵","text":"不恋簪缨不爱名，三公回首亦轻轻。\n楝庄当得乌台好，一醉何须四品荣。\n东海防谁争钓石，商山招个共棋枰。\n料应未辍忧君念，夜望中星倚瘦藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代送张仲明兵备宪副致政还楝庄二首 其二","author":"苏葵","text":"策马亨衢尽付天，冰清玉洁自家坚。\n邈从霄汉勾前业，刚与云霞结暮年。\n寄兴楝花看作始，盖身荷叶想依前。\n人间快意知谁在，七贵五侯徒管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和陈宪长吉夫二首 其一","author":"苏葵","text":"老茹芳菁饮蔗浆，腥荤虽在不贪尝。\n时情机械慵争巧，古样文章学漱芳。\n自信天高心不下，谁知尺短寸能长。\n空堂人静读周易，却怪营巢燕子忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和陈宪长吉夫二首 其二","author":"苏葵","text":"海螺杯自酌椒浆，何用吴姬劝客尝。\n世路也须甘半拙，物情原是忌孤芳。\n人间饱杀侏儒短，阶下寒多梐楯长。\n勘破穷通只如此，笑看夸父死于忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄乡友罗宗杰大尹时已致政家居二首 其一","author":"苏葵","text":"白头湖海愧婆娑，高致如公见几何。\n射鸭堂深明月满，养鱼池迥落花多。\n登山不必携红粉，近水还应衣绿荷。\n从此寄声公信否，鉴江分我半烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄乡友罗宗杰大尹时已致政家居二首 其二","author":"苏葵","text":"少年相约事经纶，未老公先作隐沦。\n山屐踏残花底月，海螺倾尽瓮头春。\n眼前好事三更梦，身后虚名半点尘。\n我亦本来能晓了，却遭人笑是贪嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄妻舅康子霜二首 其一","author":"苏葵","text":"钻仰还须岁月深，白沙当日想留箴。\n道从身外真何有，趣在源头却要寻。\n见兔是谁能画卦，亡羊原自不经心。\n凭君留取梅花月，归共花前快活吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄妻舅康子霜二首 其二","author":"苏葵","text":"天上人看太极图，谁于图上不糊涂。\n自从随柳傍花后，再有吟风弄月无。\n君到江门应得要，我游湖海尚迷途。\n砭愚白首心犹切，岂独横渠是丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈水部学之时读礼将从吉之京二首 其一","author":"苏葵","text":"大雅遗音我辈承，江门新绝管弦声。\n溪山瑰丽谁为主，天地寂寥公合鸣。\n某水某山浑入梦，无花无酒不关情。\n乞骸已具胸中稿，只恐先生稿未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈水部学之时读礼将从吉之京二首 其二","author":"苏葵","text":"料得三千尽废诗，如今花鸟正参差。\n西川过雁能投我，南海明珠欲寄谁。\n家学太邱还出色，官曹何逊不同时。\n老夫先与梅花约，公了经纶也未迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄久要黎汝贤致政大尹二首 其一","author":"苏葵","text":"不种桃花种菊花，渊明衣钵不曾差。\n读书教子得真趣，衒玉看人痴到家。\n禾役万丘迎雨合，橘奴千树带烟斜。\n苍髯折尽时相忆，逸处多应鬓未华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄久要黎汝贤致政大尹二首 其二","author":"苏葵","text":"旧雨篝灯在泮池，回思曾未几多时。\n膝边男女各成配，头上鬓毛俱转丝。\n久逐尘埃惭潦倒，先归岩壑得便宜。\n他年大破黄粱梦，身外浮名底用之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓蜀送泸州守亲家何君德言秩升致政东还五首 其一","author":"苏葵","text":"乞归翻荷圣恩深，四品名衔带转金。\n白首解完和氏璧，青天应信赵公琴。\n人人鲍老张长袖，个个渔郎笑直针。\n摆谢诗流浑不顾，远从三径盍朋簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓蜀送泸州守亲家何君德言秩升致政东还五首 其二","author":"苏葵","text":"秋尽巴江水蔚蓝，布帆乘月过湘潭。\n忠勤作牧喜无忝，名位付天能不贪。\n钓艇有缘公得计，宦途失伴我何堪。\n荔枝花发菟裘接，早晚当期听雨谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓蜀送泸州守亲家何君德言秩升致政东还五首 其三","author":"苏葵","text":"曾领鱼符牧两州，万家灯火十年忧。\n虚声羞拜王成爵，老计甘投范蠡舟。\n自古庙堂遗肮脏，至今岩壑属幽求。\n知公不是亡君者，时顾腰金忆冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓蜀送泸州守亲家何君德言秩升致政东还五首 其四","author":"苏葵","text":"铸颜功薄拥虚炉，欲解簪缨乞鉴湖。\n勇退此筹公早占，寻香他日我能无。\n半林花雨诗千首，七尺渔竿酒一壶。\n此是桑榆真乐处，羡谁官到执金吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓蜀送泸州守亲家何君德言秩升致政东还五首 其五","author":"苏葵","text":"少年知己老连姻，万里相休只两人。\n莫道刚肠无别泪，须知羁客易沾巾。\n忙中岁月同驹隙，梦里功名等袜尘。\n目断征帆天渐渺，却惭归计自逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中拨闷口号","author":"苏葵","text":"一年一度卧床帷，费尽囊金数问医。\n莫岁匪良灾不免，是人将老病相随。\n如何马援终身健，也有昌黎半路衰。\n翘首问天天不语，数声高诵楚累词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又代徐都阃作","author":"苏葵","text":"气夺天机不等閒，西邮公在重如山。\n楝花有信应无恙，骢马何为急欲还。\n五柳先生莲社约，四明狂客鉴湖宽。\n辕门徙倚偏惆怅，真为天家借范韩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静边寺留题","author":"苏葵","text":"远山四面列苍屏，近放溪流一带明。\n僧入定时龙不起，客寻诗处鹤初鸣。\n经多贝叶西天迩，榻有蒲团上界清。\n地远几何车马到，静边原是不虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月十八日孔章陈寅长为避暑饮于水利司既而赋此谢之","author":"苏葵","text":"微凉院宇百壶清，长日铮铮听矢声。\n左右卒投存礼乐，东南均醉失输赢。\n枝头偶语禽声碎，阶下先花菊叶馨。\n此意廓然同物我，集人归袂有蜻蜓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"按锦州日兵备郝宪副同寅召饮夜归赋此谢之","author":"苏葵","text":"何处张筵异品兼，莲花新酿蜜输甜。\n明霜义在谈偏剧，蘸甲杯深令转严。\n银箭急传更漏短，绯罗高燎烛光炎。\n醉归自为生灵喜，此日西邮有仲淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿安县行台风雨不寐用前韵遣怀","author":"苏葵","text":"尽日冲泥惫病兼，槁梧时据梦非甜。\n乌台雨急秋灯暗，赤县城荒夜柝严。\n尘土荣华均赵孟，草茅消息自羲炎。\n白头留得青毡在，归向河汾学仲淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄仲和佥宪前辈时黄致政林下","author":"苏葵","text":"五羊城下仙中人，爱酒独爱梨花春。\n青云道上付诸子，黄菊花边闲一身。\n潇洒不妨银鬓发，康强赢得鹤精神。\n巴山万里羁怀恶，归梦能无逐钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦游白鹿书院时癸亥八月十有三日也","author":"苏葵","text":"何处佳山入梦时，小桥三峡水迟迟。\n重经祠下诸贤讶，忽到峰前五老知。\n无复旧人空旧榻，几多新树漫新枝。\n萍蓬踪迹浑堪慨，徙倚巴山有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲子岁二月二十日拜进万寿圣节表文宪长陈吉夫首倡予步韵二首 其一","author":"苏葵","text":"沈檀香傍龙图起，华盖星依帝座明。\n五位冈陵常介福，万邦葵藿自倾诚。\n真同虞舜昭神化，岂独周文有骏声。\n献罢琅函偏踊跃，樗驽犹得效干城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲子岁二月二十日拜进万寿圣节表文宪长陈吉夫首倡予步韵二首 其二","author":"苏葵","text":"唐虞过后三千载，天地如今见大明。\n竽食自忻叨际会，嵩呼谁不罄丹诚。\n清清屡睹黄河瑞，翙翙常闻彩凤声。\n强摭微言鸣盛治，诗悭多愧谢宣城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张抚民一之寅长捧表北上用前韵","author":"苏葵","text":"旌旗道上风初暖，箫鼓江边月正明。\n梦切彤云忘跋涉，心悬红日吐衷诚。\n遥瞻雉扇开天仗，近听鸡人报晓声。\n朝罢从容献民瘼，定应风采压阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕后一日漫书","author":"苏葵","text":"长绳不繫日西驰，又道人间七夕期。\n织女心情桥鹊会，蓐收消息井梧知。\n三更送巧偏遗我，一片支机又与谁。\n闲倚危楼望河汉，不胜秋兴入新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和清军俞绣衣先生晓发蓬州诗韵","author":"苏葵","text":"慨然揽辔出神州，孟博应须让一头。\n节操久争冰玉洁，贤劳真作帝王休。\n人间日暖春偏盎，江水秋清月自流。\n公暇有诗轻李杜，东风花鸟实深愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和前人书蓬州行台韵","author":"苏葵","text":"户牖如心已洞开，清风犹为拂尘埃。\n雨深坡草鸣驺过，日暮庭柯宿鹤回。\n饮水信堪供我乐，鼓琴那解使人哀。\n年来眼界无遮碍，看得天池亦一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和前人果州灵泉寺留题二首 其一","author":"苏葵","text":"胜处多应著梵宫，豸衣人偶驻花骢。\n背时笋蕨从僧献，脱俗弦歌任鸟供。\n泉脉透来苍石裂，山腰封断白云重。\n闲哦百丈飞涛句，不觉声摩万仞空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和前人果州灵泉寺留题二首 其二","author":"苏葵","text":"丈六金身百尺宫，门前芳草碍骄骢。\n客怀白鹤应能会，诗料青山尽解供。\n洗耳泉声偏喜碎，障尘花树不妨重。\n西来欲了观风事，肯与山僧论觉空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书锦屏驿用前人韵","author":"苏葵","text":"曾将捷径怪终南，歧路谁重问剧骖。\n伞盖刺天应碍月，锦屏迎日自晴岚。\n风光底厌频频赏，机事何须历历参。\n笑杀触蛮三百里，不扬金鼓战锋酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲子春巴江舟中","author":"苏葵","text":"去年冬孟此行舟，一别青山又半秋。\n山色却缘三月好，江声不管二更愁。\n何当今古闲圈套，赚过乾坤好日头。\n欲著谁家双木屐，直从衡岳到罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忧旱时甲子四月富顺道中","author":"苏葵","text":"麦穗将垂秧甲舒，懒龙终日吝沾濡。\n鸡占怪得休徵少，龟坼愁看遍亩俱。\n满地农家驱崇魃，一时天地厌苞苴。\n病夫谬典吾儒事，也虑苍生釜有鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨","author":"苏葵","text":"一声雷动蛰龙惊，处处深渊睡不宁。\n起驾丰隆吸溟渤，散为霖雨济生灵。\n润回枯槁忻盈野，洗尽尘埃不到庭。\n我爱晚凉高一枕，梦寻诗过大苏亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观山","author":"苏葵","text":"看画何如细看山，山之佳处画应难。\n数拳苍石怪中怪，一片白云闲又闲。\n朵朵野花红插髻，茎茎芳草绿侵颜。\n隔林见个扶筇者，疑是神仙采药还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]