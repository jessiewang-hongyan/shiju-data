[{"title":"登西山","author":"王世贞","text":"乱削芙蓉碧霭攒，千盘转尽自成寒。\n清秋殿阁空中见，落日旌旗树杪看。\n北眺浮云生大卤，东回紫气抱长安。\n向来弓剑曾游地，万壑松风度急湍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日早朝","author":"王世贞","text":"九霄鱼钥下层关，炬火俄分豹尾班。\n宫阙香浮吹淡荡，液池冰合锁潺湲。\n充仪未展含元殿，献寿遥传万岁山。\n敢道去天身尺五，侍臣犹自望龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同僚友游崔都尉山庄分韵","author":"王世贞","text":"尺五高临杜曲天，况逢三伏胜游偏。\n夹堤杨柳凉全得，出水芙蕖晓故鲜。\n南国烟波开槛外，西山风雨落尊前。\n谁家暗度秦台引，回首朱门月可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁寺同谢山人茂秦章行人景南李比部于鳞饯李伯承明府分韵得花字","author":"王世贞","text":"长安三月芳意赊，习习柔风黄鸟斜。\n春社虎溪能远送，暮云凫舄未堪遮。\n城闉倦借支公马，江路吟逢潘令花。\n去住即看同幻迹，向来离合不须嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汝康柳州再徙澄江","author":"王世贞","text":"汝游桂岭疑天尽，更入滇方觉地宽。\n明月江帆悬万里，瘴云山树郁千盘。\n莫将诗句题蛮府，自有威仪识汉官。\n橘柚秋风今实否，高飞鸿雁满长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈子兼迁水部治通州河","author":"王世贞","text":"亲捧除书出未央，蓟门秋色满奚囊。\n亦有故人山吏部，居然新例水曹郎。\n河流雨挟千艘上，关辅云连万雉翔。\n为道阳春谁和者，于今粉署少辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈子兼提学","author":"王世贞","text":"寒食江风黄鸟斜，故人蓬鬓各天涯。\n巴中父老相如谕，峡里星河博望槎。\n剑阁梦悬千里月，锦城人醉四时花。\n独怜方朔长安米，西望经年尺素赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘青州之信阳兵备","author":"王世贞","text":"使者黄金出汉京，共看潘岳赋西征。\n淄青剑履花间发，淮蔡旌旗雪后迎。\n自昔单车消众垒，于今千骑拥连城。\n中朝文武如君少，莫使人传治郡名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶子汉赴成都令叶颇能诗","author":"王世贞","text":"明时经术鬓双华，西去啼猿万里赊。\n此际巴人无讼芋，向来仙令只栽花。\n挂帆峡里逢春雪，濯锦沙边弄晚霞。\n一自文翁能教授，至今扬马擅名家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书庚戌秋事 其一","author":"王世贞","text":"传闻边马塞回中，候火甘泉极望同。\n风雨雕戈秋入塞，云霄玉几昼还宫。\n书生自抱终军愤，国士谁讥魏绛功。\n北望苍然天一色，汉家高碣倚寒空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书庚戌秋事 其二","author":"王世贞","text":"匈奴万骑纵西山，天险谁当百二关。\n今日安危任边将，异时恩泽满朝班。\n乌边白骨那能辨，马首红妆若个还。\n冗散书生空哽咽，截书谁为破愁颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书庚戌秋事 其三","author":"王世贞","text":"汉朝宫树自苍苍，万马风生紫塞长。\n是处烽烟欺太白，几家关月恨流黄。\n千金剑客辞军垒，三殿兵符下窒皇。\n解道云中飞将在，露书何以慰明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书庚戌秋事 其四","author":"王世贞","text":"长陵松柏气成龙，极望苍然总汉封。\n槃木西来是符拔，扶桑东尽见艨艟。\n旌旗夜摄千烽偃，玉帛春看万国从。\n七萃貔貅今不乏，坐教敌骑出居庸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过巩华城","author":"王世贞","text":"今皇御跸曾经此，雉堞龙蟠控上都。\n佳气迥从陵树发，白云回望汉宫铺。\n千金徙侠东填塞，三辅弛刑北备胡。\n涕泪棘门诸将士，城头月出有啼乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张比部募兵山西","author":"王世贞","text":"九月连烽愁太阴，徵兵六传汉臣临。\n军中荡子随都尉，塞上孤儿备羽林。\n豹帐云钤挥白羽，虎符星檄散黄金。\n自来三晋多豪杰，投笔知君万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙郎中守承天 其一","author":"王世贞","text":"五马凭陵紫气中，方城南冠楚天雄。\n成周百叶称江汉，先帝千秋忆沛丰。\n将为股肱仍见召，即论汤沐竟谁同。\n兰台宋玉毋烦对，父老时时歌大风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙郎中守承天 其二","author":"王世贞","text":"汉江西望接荆门，紫马春看孙使君。\n今日帝乡私雨露，向时龙迹护风云。\n桥门玉砌銮舆下，中贵银珰御座分。\n何事南阳不可问，古来强项几人闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夕诸君见过谈及江南梅花因有作次焉","author":"王世贞","text":"腊日诸贤何水部，草堂时过数烹茶。\n西山树老惟看雪，南国梅骄已著花。\n玉笛美人吹不尽，瑶台仙侣梦还赊。\n畴能一醉罗浮约，扶杖行吟江月斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送申职方左迁莱州推官","author":"王世贞","text":"向来绨几在明光，谁借前筹计朔方。\n黄石一编天子傅，青云尺檄尚书郎。\n功名绛灌无同列，驰骋淄渑岂异乡。\n东望不须疑蜃气，橐中长铗九秋霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送瞿师道太史使大梁周府","author":"王世贞","text":"长安草色上鸣珂，繁吹春调四牡歌。\n太史授圭开赤社，宗藩如带指黄河。\n天边汉节蛟龙扰，雪后梁园鸿雁多。\n上客知君频授简，邹枚词赋未应过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送亢子益太史使饶州淮府","author":"王世贞","text":"彭蠡波涛霁雪馀，仙槎春度锦帆舒。\n淮王上客能词赋，汉使甘泉奉玺书。\n伯父尔宜仍胙土，东南今复盛簪裾。\n经行倘上康山望，高帝雄图在石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡子文太史使荆州辽府","author":"王世贞","text":"江汉诸姬近帝乡，方城紫气郁相望。\n宁因剪叶劳周史，不为包茅问楚疆。\n作赋雄风连七泽，行舟积雪满三湘。\n上林簪笔应相待，留滞何须念子长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱象玄太史使武昌楚府","author":"王世贞","text":"诏从冠冕际南天，君去湖波正淼然。\n此日包茅供岁朔，异时琼树怅风烟。\n张筵乐奏鱼龙曲，对客文成鹦鹉篇。\n归郡前驱逢负弩，青云初过陆机年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张益甫给事使怀庆郑府","author":"王世贞","text":"覃怀名胜肃风烟，仙使轺车春草前。\n山抱虎牢看作砺，树蟠狐岭若从天。\n歌风不独思商俗，为命今应继郑贤。\n归道霜驱应便发，建章宵几正筹边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送毛检讨起贬云南幕僚","author":"王世贞","text":"乾坤惨淡干戈里，封事终军拭泪题。\n苑道夜乘中贵马，关头朝听逐臣鸡。\n盘江瘴暖桐花发，黔岭云深鹎鵊迷。\n魑魅如逢休代答，赐环应有汉宫泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李新喻伯承","author":"王世贞","text":"近传陶令诗仍作，父老悬蒲并息机。\n山色巧当公府坐，瀑声晴向捲帘飞。\n凭将雁字论南北，说着蛾眉易是非。\n燕市酣歌残雪里，江城或已授春衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯郎中守广州","author":"王世贞","text":"承明初厌汉臣班，开府霜清瘴里山。\n炎荒齿革衔舻集，横海旌旗列戍閒。\n天阔羊城秋雁少，月明鲛浦夜珠还。\n试问贪泉谁更酌，不妨驻马漱潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉谒长陵敬志鄙感","author":"王世贞","text":"长陵松柏似龙蟠，象纬高垂列汉官。\n万里乾坤留剑舄，百年丰镐见衣冠。\n只今南粤虚传译，闻道西羌未解鞍。\n文帝威灵终在眼，秋风霜露不胜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜宿弘慈寺听讲","author":"王世贞","text":"夜堂趺坐转三车，倦向僧厨乞施茶。\n露净珠光翻贝叶，月寒金色涌莲花。\n凭看有相吾何染，听说无生路未赊。\n莫谓常明须震旦，金篦已许导恒沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒日游天宁寺","author":"王世贞","text":"冲寒此日城西寺，酌茗看山兴未涯。\n塔外风传群帝乐，林间雪是讲坛花。\n闻钟客散催疲马，施食僧归起倦鸦。\n襆被祗应忘说去，夜深还听演三车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄侍御按云南时方有用师之警","author":"王世贞","text":"客有乘骢白玉羁，从天六传下诸夷。\n昆池水习三千舰，益部霜驱五月师。\n飞檄春农归耒耜，停车夜垒散旌旗。\n甘泉实已垂南顾，尺羽能令奏计迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送包大中之沧州运盐幕","author":"王世贞","text":"杯酒河梁朔思严，太行飞雪拥高幨。\n市中结客谁青眼，幕下为郎旧紫髯。\n醉墨误题云母扇，雕盘初荐水晶盐。\n知君故有筹边策，三府何年辟孝廉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆伯子还吴","author":"王世贞","text":"中原文字半蒿莱，入洛人传伯仲才。\n白发向催犹著赋，黄金挥罢独登台。\n愁时天地衔杯尽，病后烟霞拂袖来。\n试听商声缘画角，蘋花一夜满江隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答汝思郎中蜀中书","author":"王世贞","text":"蜀雁书裁隔岁看，为言相忆劝加餐。\n秋登剑阁天逾峻，春至幽州日尚寒。\n末路逢人投璧少，中年结客断金难。\n射洪花底谁堪醉，西望行吟思未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜即席分赠得梁公实拈韵诗字","author":"王世贞","text":"十年岭海著沈思，今见为郎执戟时。\n白日看鸿还坐啸，青天扪虱对谈诗。\n世途汝已关心少，国士吾真折节迟。\n一醉虚堂春月色，投珠或恐未堪疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与于鳞诸子即席分赋得怀太湖阴字","author":"王世贞","text":"具区南浸女牛临，万顷沧波千尺深。\n雨霁虹桥秋滟滟，天低鼍窟昼阴阴。\n吴王列宴乌栖曲，越女明妆鼓枻吟。\n客醉向誇湖上乐，一从金马便浮沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送坐主王检讨先生之南司成四首 其一","author":"王世贞","text":"诏分仙履下蓬莱，词客俱称建业才。\n天阔星文秋剑动，江寒月色夜珠来。\n百年高议归狐笔，六代雄风满凤台。\n圣世只今谁似者，甘泉实恐问邹枚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送坐主王检讨先生之南司成四首 其二","author":"王世贞","text":"帝城春思入蘼芜，仙禁衣冠拥客途。\n十载青藜悬秘阁，诸生绛帐满留都。\n风回采石涛声壮，日上钟山海色孤。\n为问群公居守事，向来根本一愁无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送坐主王检讨先生之南司成四首 其三","author":"王世贞","text":"戎衣高帝定神州，卜洛桥门见冕旒。\n三老鸠筇分御席，诸儒虎幄进经筹。\n宫袍手赐霞同烂，天语亲传日并流。\n太学明师今不忝，白云弓剑孝陵秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送坐主王检讨先生之南司成四首 其四","author":"王世贞","text":"青春赋就侍承明，花底鹓鸿醉玉笙。\n夜静紫微催草诏，秋高太白坐论兵。\n阁中丞相曾投履，海内文章共识名。\n南去玄经堪比易，独怜京邑滞侯生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄许邦才","author":"王世贞","text":"南北声名祇共怜，乾坤容鬓尚茫然。\n出为小草官仍拙，归去长杨赋更传。\n春至云青华不注，秋来雨白汶阳田。\n飘零古剑真谁识，遥夜寒光向斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"呈司寇山阴何公","author":"王世贞","text":"天下名家有凤毛，中朝国士赠虔刀。\n青齐什二飞书下，淮海千帆转饷劳。\n相事衮衣还日月，主恩舟楫远风涛。\n何烦更藉王生语，廷尉贤声久汉曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐佥事理闽中屯政","author":"王世贞","text":"朔方诸将出祁连，宇内军储异往年。\n谁念屯田虚粤岭，即勤搜粟下闽天。\n行车粳稻排云集，开府旌旗截海悬。\n岂是故人长待诏，薄游还愧水衡钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和梁公实暮春感怀","author":"王世贞","text":"长安春尽万花稀，拍马愁随侠少归。\n畤里香烟晴不断，回中雪色昼长飞。\n时危岁月无行止，势定风尘有是非。\n吾道仅堪存执戟，故人今拟薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦园同于鳞子与子相各赋 其一","author":"王世贞","text":"千树飞花覆客杯，百年晴日此池台。\n钩帘蛱蝶携香去，浴渚凫鹥散锦来。\n醉后看人成偃蹇，归时促骑故徘徊。\n长安北望黄尘里，击剑高歌未乏才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦园同于鳞子与子相各赋 其二","author":"王世贞","text":"历历垂杨青几围，娟娟宿鹭白双飞。\n坐惊远岫停杯出，行惜残花插帽归。\n四海未妨吾辈在，孤亭仅与世人违。\n谁为忽唱江南乐，回首烟霞未拂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦园同于鳞子与子相各赋 其三","author":"王世贞","text":"蓟苑春归处处幽，陆沈吾党任遨游。\n长楸碧带千峰雨，密荇青藏百道流。\n西望风云双凤阙，北来天地一渔舟。\n科头箕踞寻常事，细酌高吟且未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送严太史请急省侍","author":"王世贞","text":"罢直晴烟散晓珂，君王侍从赐衣多。\n高堂喜极千金寿，故苑恩深六传过。\n到日夏云明震泽，来时朔雪满滹沱。\n柏梁何限词臣手，归蜀长卿待和歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过通州城庚戌秋大敌北入家君力禦却之因增筑焉","author":"王世贞","text":"日落卢龙秋色哀，连城百雉此雄哉。\n中原地划烽烟近，北斗天回王气开。\n淮海帆樯飞饷集，期门金鼓射生来。\n向看睥睨曾戈甲，今日谁论保障才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和合驿","author":"王世贞","text":"十年尘暗蓟门楼，万里风来汉使舟。\n挂席昼移横海日，鸣桡秋荡大河流。\n孤城奏角黄云合，远戍逢砧白雁愁。\n吾道岂应长踯躅，乾坤此去有沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"台郡兵起有感","author":"王世贞","text":"平生五岳意相亲，图里天台指避秦。\n岂谓乾坤归战斗，遂令湖海入风尘。\n时平不独轻前辈，难起初闻遣大臣。\n回首国恩环佩里，百年谁见请缨人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过徐咏怀古迹","author":"王世贞","text":"芒砀云深千堞愁，长城脉绝万年筹。\n英雄尽起无亡鹿，富贵归来有沐猴。\n大泽龙蛇春并斗，中天日月晚双流。\n宁知过沛亲留饮，屠贩何人总彻侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游吴江桥","author":"王世贞","text":"吴江长桥天下稀，七十二星烟霏霏。\n桥上酒胡青帘肆，桥边浣女白苧衣。\n桃花水涨月初偃，莲叶雨晴虹欲飞。\n北客风尘初极目，倚阑秋色澹忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉题书斋二首 其一","author":"王世贞","text":"束书斗酒安吾斋，西风为扫当门柴。\n即寒薜衣能护几，未贫苔钱欲上阶。\n一丁世自饶紫绶，二酉吾敢劳青鞋。\n已无故人车马迹，赖有明月时投怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉题书斋二首 其二","author":"王世贞","text":"蹉跎颜驷不敢陈，寂寂邓禹行笑人。\n酒龙千秋吐气色，文豹万里甘沈沦。\n图经山海纫为袖，客馆华阳樵作薪。\n丈夫头颅可知矣，胡不归把沧江纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津刘宪使汎舟夜酌","author":"王世贞","text":"军府严城辟向西，帅厨清酤为谁携。\n中流鼓吹潮声合，落日鼋鼍海色低。\n绝塞羽书频自警，长安封事几堪题。\n相逢慷慨俱挥泪，徙倚星河夜欲迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感","author":"王世贞","text":"卧觉应徐积渐稀，起当喻志偶相依。\n此曹往往皆肤立，我辈时时但肉飞。\n调隔云烟双过眼，事违天地一沾衣。\n名山尽可藏书在，潦倒风尘未拟归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夕同于鳞子与访公实时公实在告将归岭南分韵声字","author":"王世贞","text":"春暮和烟满凤城，茂陵词客病金茎。\n灯前古剑回霜色，杯外残花入雨声。\n尽许寸心倾国士，即论千载失时名。\n越南燕北天何限，浊酒狂歌意未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宋望之侍御按河东鹾","author":"王世贞","text":"束马谁临禹甸看，埋轮使者下长安。\n天扶底柱黄河折，地转神池白雪寒。\n异日军须盐荚议，当时谏草惠文冠。\n即看宵旰明光里，慷慨毋论直道难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送狄行人使蜀藩","author":"王世贞","text":"隐隐寒星度永安，迢迢节使下金銮。\n锦江新水迎船发，石栈浮云骑马看。\n桐叶旧馀周典礼，蚕丛争识汉衣冠。\n壮游词赋应归汝，对酒毋歌蜀道难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周岁祀孝烈皇后陵朝辞有作","author":"王世贞","text":"昨岁兹辰奉国艰，共惊霏雪点鹓班。\n六宫犹望回仙驭，中禁争传惨圣颜。\n此际金钿归别岛，早时玉盌閟南山。\n欲知天上凄凉景，日暮祠园松柏间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后朝天宫习仪","author":"王世贞","text":"玄宫雪后净芳埃，环佩千门曙色来。\n仙仗不随青帝改，瑶城疑逐化人开。\n龙鳞映日层层合，凤甃惊风片片回。\n闻道汉祠先奏瑞，岂应梁苑复论才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]