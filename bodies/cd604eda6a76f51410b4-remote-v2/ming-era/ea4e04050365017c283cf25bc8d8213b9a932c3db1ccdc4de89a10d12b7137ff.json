[{"title":"次罗绣衣坠马伤足韵 其一","author":"钟芳","text":"进止无心任所经，等闲骢马蹶朝行。\n夷途得险天终昧，痛定思危梦亦惊。\n几处弦歌虚月色，一春花柳阁风情。\n投闲欲觅飞升术，捷径惟应问曲生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次罗绣衣坠马伤足韵 其二","author":"钟芳","text":"贪看春光入草塘，玄黄羸马仆高冈。\n葵能自卫还伤足，花已分飞未下堂。\n搏老偶同驴背堕，袁生常恐雪中僵。\n游么不碍风翎劲，搏击层霄未可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送欧赐之守金华","author":"钟芳","text":"联署输君早着鞭，和风吹旐发离筵。\n封疆喜接留都胜，箫鼓争迎太守贤。\n到处江山随指点，及时膏泽系颠连。\n日薰晴屿棠阴遍，应有歌谣被管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游观音阁和思抑韵 其一","author":"钟芳","text":"危楼登遍诗脾困，清酒高歌次第催。\n树拥空苍齐石壁，江瑶晴绿上琼杯。\n老僧诵法鸣钟应，客子乘潮鼓棹回。\n归路昏黄人已醉，万家灯火烛三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游观音阁和思抑韵 其二","author":"钟芳","text":"百丈禅林合素筵，意中飞鸟共翩翩。\n不知有我还无我，却爱今贤似昔贤。\n半世烟霞方外客，一龛香火洞中天。\n角残远戍苍烟暮，并辔犹联马上篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送少宗伯杨公正叔","author":"钟芳","text":"钟山行乐未渠央，徵诏俄看出建章。\n奕世台衡关否泰，一时人物在低昂。\n职司万国纲常重，位近中天日月光。\n勋业有期头尚黑，祖风君德肯相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日联句和韵四首 其一","author":"钟芳","text":"城曲相从看彩舟，锦标争胜发清讴。\n诗篇约我频同和，江汉思君独远游。\n流水不湔湘客恨，青山空负杞人忧。\n壮怀此际全销铄，闲是闲非总谬悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日联句和韵四首 其二","author":"钟芳","text":"午日看山山更好，客子放歌飞羽觞。\n觞行深浅自随量，歌校短长殊未遑。\n坐久漏声沈鹤禁，雨馀凉气袭槐堂。\n偶然欢笑颓然醉，未学华仙已顿忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日联句和韵四首 其三","author":"钟芳","text":"天上玉京楼十二，清光应许借清郎。\n同盟偶作衣裳会，得句全输锦绣章。\n谢老爱山成痼癖，杜陵伤酒露疏狂。\n归来似觉形神瘁，净室明轩学坐忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日联句和韵四首 其四","author":"钟芳","text":"四子多情冒雨过，主人贪客醉还歌。\n情恬夜宴销华烛，辞迸寒芒逼太阿。\n一笑碧山同驻马，十年青琐忆鸣珂。\n菘葵著土皆成色，未信春光校孰多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借山亭","author":"钟芳","text":"借山学士圣能诗，滚滚波涛入妙词。\n花外蝶魂迷客主，苑边蛙吹杂官私。\n流云去宿青溪曲，过鸟来依碧树枝。\n假许何曾输郑壁，对渠清赏莫停卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禁中春雪","author":"钟芳","text":"急柝疏钟促曙光，玉娥飞舞迓东皇。\n寒欺御柳旋成幻，色衬宫梅欲堕香。\n万片袅烟迷太液，一时随辇赴昭阳。\n郊原已兆丰登候，猎骑犹闻献白狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月雨至于六月和韵 其一","author":"钟芳","text":"通宵淫雨湿衾床，起篝银缸强自将。\n寒色上侵书幌润，溜声遥引玉壶长。\n垂翎独坐莺先困，破垒无归燕亦忙。\n却爱诗人自豪宕，骚坛坚壁未曾降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月雨至于六月和韵 其二","author":"钟芳","text":"倦拥青奴卧竹床，不禁蒸郁病相将。\n片云黔黯催诗急，积雨空濛入梦长。\n比屋半颓嫠妇泣，野堤中溃百农忙。\n鼓钟忽报新晴候，忧思忡忡觉顿降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月雨至于六月和韵 其三","author":"钟芳","text":"风雨连霄拟对床，诗成重遣仆夫将。\n知深却恨论交晚，情淡还输得味长。\n瑞世凤麟聊自惜，乘风鹏鹗底须忙。\n笔端秀句如林出，任是曹刘亦乞降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月雨至于六月和韵 其四","author":"钟芳","text":"云在高楼风在床，羽觞飞动蔌满将。\n思君不见渚花冷，吹笛未终山雨长。\n鬓雪几茎催景短，词峰千丈逼人忙。\n我诗自叹如曹郐，未接齐师已办降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游牛首不果次图南韵 其一","author":"钟芳","text":"天外禅房入望深，肩舆垂发值秋阴。\n林光偶负追陪约，云片元无去住心。\n境好神仙应独擅，事违风雨亦相侵。\n诘朝有伴还乘兴，策马霜阡听越吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游牛首不果次图南韵 其二","author":"钟芳","text":"秋入园林问浅深，轻寒山色昼阴阴。\n幽寻未尽回龙势，独翥难禁野鹤心。\n望久寺僧疑有问，出迟行露敢相侵。\n漫漫枫荻凋零尽，长铗哀弹起暮吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游牛首不果次图南韵 其三","author":"钟芳","text":"谢公山屐滞秋深，山木空闻百尺阴。\n江绕石头分地脉，寺当峰顶直天心。\n乘闲却恨舆徒窘，得侣翻嫌俗累侵。\n偶见落鸦归暝色，倚楼凄切动豪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周汝和佥宪","author":"钟芳","text":"引觞相对鹁鸠鸣，临别坚留似不情。\n台省共推风力劲，节旄先指建潭清。\n地分险沮频忧国，才遇纷庬剩著名。\n晤语正酣忘日暮，石桥归马见三星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林从学少参","author":"钟芳","text":"东南藩翰控连城，参佐雄材出帝京。\n冰蘖一生留宦迹，湖山四面足风情。\n春风淮水新知己，乔木莆阳旧著名。\n人去不堪牢系马，晴云流碧道双旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽守庵罗翁","author":"钟芳","text":"坐拥溪云学钓璜，自甘岑寂度年芳。\n清时台省看群侄，白首埙篪聚一堂。\n仙驭偶随辽鹤去，尘机元共海鸥忘。\n迢迢淮上曾游地，枫叶萧森似白杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和刘竹坡自挽诗 其一","author":"钟芳","text":"林下清风薄素秋，葛巾筇杖自相投。\n门多橘柚成真隐，架有诗书是夙谋。\n樽酒放歌尘梦断，溪山经赏旧名留。\n古稀已过童颜在，行乐而今恐未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和刘竹坡自挽诗 其二","author":"钟芳","text":"鹄举从教燕雀嗤，行藏随分不须疑。\n陶园早谢功名会，融帐曾亲授受私。\n瘴海波涛伤往事，首丘风雨动离悲。\n嗟予久阁风骚笔，刚为先生一赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和刘竹坡自挽诗 其三","author":"钟芳","text":"垂白投闲学种榆，了无萦绊自冲虚。\n时从比舍含椒醑，更历东皋命竹舆。\n架列锦函孙子业，扁题佥字丈人居。\n相如自负淩云气，回指昆崙作故墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和刘竹坡自挽诗 其四","author":"钟芳","text":"昔年文场掉臂游，一官徘徊炎海头。\n门徒聚散晓窗梦，世事起灭秋江沤。\n油艟横海撼蛟室，石壁倚天寒蜃楼。\n校量夷险自足乐，况乃荣寿归山丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠吴大本举人","author":"钟芳","text":"学未成名志士羸，偶从文字得新知。\n骨奇果应千金聘，句妙终惭一字师。\n淮浦菰沉惊岁晏，陵阳枫冷觉归迟。\n游缰莫任闲抛掷，紫陌东风杏又开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游弘济寺","author":"钟芳","text":"隔江蒲苇动微寒，江上危樯俯首看。\n石刹何年收佛骨，葛巾此夕聚儒官。\n暮秋山色犹含雨，静夜风声若倒澜。\n欲访群仙问遗诀，鼎中应有小还丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和钱学士韵","author":"钟芳","text":"脉脉灵泉一派通，濒江石壁翠撑空。\n浮沉舟子波涛里，浓淡岚光烟雨中。\n上界神仙隔缥缈，五更钟磬响丁东。\n同来已办登山屐，行到山穷兴未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊日","author":"钟芳","text":"腊月冶城动春意，鸟嘤庭柏东方晞。\n雪残羸马步街稳，日短小吏休衙迟。\n挈筐办岁走村父，打鼓闹春攒市儿。\n况是江山更清绝，且可揽笔搜诗脾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送甘钦采太守惠州","author":"钟芳","text":"同荐天衢已十龄，就中离合似风萍。\n秋曹又改郎官绶，炎海新传刺史名。\n眼底波光涵帝泽，耳边言语间莺声。\n坡仙遗爱今应在，长忆金盘落月倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙亥十一月朔日食","author":"钟芳","text":"赫曦连碧净无垠，俄报亏痕一二分。\n大造岂应丰厥蔀，宣尼何怪困于陈。\n潜滋阴慝宁能久，同护阳精自有神。\n宝鼎香销金鼓罢，玉轮如旧倍光新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送许廷信司训武陵巘","author":"钟芳","text":"同是天涯旧布衣，拜官西去忍相违。\n临江已觉兰桡动，把酒休辞玉斝飞。\n醉倚湖山歌舜禹，闲披经史聚匡韦。\n儒官自足偿清兴，底必鸣珂入帝畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黄希斋才伯韵","author":"钟芳","text":"天涯游子抱瑶琴，指下难挑曲外音。\n寸草报春终有憾，浮云出岫本无心。\n寻幽喜癖陶潜径，茹糗羞谈季子金。\n老我正多盘谷兴，可能分榻坐浓阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涂主政邦王以诗见赠","author":"钟芳","text":"行藏何意听苍天，白首丘园君独贤。\n每混渔樵耽野况，顿忘宠辱觉神全。\n香分晴院疏帘外，春到寒塘秀竹边。\n却老有丹随处足，不须方外觅真传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还崖稿","author":"钟芳","text":"地尽东南是故庐，感情风物在乘除。\n道旁尚忆莱公竹，陇上多增白氏渠。\n旧日主人今在少，同时僚友别来疏。\n到家童稚迎相笑，仍是天涯一腐儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡儋州新昌海","author":"钟芳","text":"晚乘初霁渡新昌，潮落仍渐马腹强。\n薄伐共惊殳蔓草，一方从此系苞桑。\n张罝客椓林间杙，贡玉人通海上航。\n旧感萦怀歌兴发，满天霜月散新凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"节妇叹","author":"钟芳","text":"形容消瘦倦梳妆，点尽衣衾强自将。\n之死只知天可誓，此生长共影成双。\n烟横春槛愁千结，雨滴寒更泪几行。\n墓草不除门户落，谩劳青史志共姜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鳌山","author":"钟芳","text":"鹏咮高骞吸晓虹，却怜孤绝自为宗。\n舆图垂尽地十里，峰势半开波万重。\n华夏封疆分徼外，斗牛光焰直天中。\n似嫌川渎涓流细，独向重离阅会同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿归姜驿","author":"钟芳","text":"曙色熹微透壁光，披衣起坐竹窗凉。\n秋山断处群鸦没，晓吹来时万萼香。\n海曲孤云横白昼，邮亭清梦足黄粱。\n儋城四望皆林莽，谁辨东坡载酒堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始兴舟中","author":"钟芳","text":"章江秋半惨霜风，才过梅关便不同。\n浅濑渐乾舟易阁，亢阳转炽气如烘。\n湘裙浣石溪边妇，葵翣挥云陌上翁。\n怪底扶舆清淑隔，衡阳请看雁回峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落笔洞","author":"钟芳","text":"悬崖点点堕球琅，似得春秋一脉长。\n浓醮风烟观颖脱，暗书今古爱珍藏。\n阵挥拟涤千军忾，焰吐争摩列宿光。\n曾是中书头已秃，不将词藻竞低昂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽蜀府陈长史","author":"钟芳","text":"谁信妖符降玉鱼，武林东望失文儒。\n曾师临胄微言析，再相藩王吃力扶。\n五色文鸾承宠耀，半轩松鹤閟清癯。\n哀闻薇省肠应断，况是中天月色孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过九龙岭","author":"钟芳","text":"南出通津度九龙，参差乱石滞行骢。\n半晴山色犹衔雨，垂老花枝不耐风。\n市僻故宜杯斝朴，民罢底用织纴工。\n传经旧俗今皆变，惟是萑蒲未即功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古松","author":"钟芳","text":"桃李难同拟历年，秋光阅老更苍然。\n霜根裂石蛟鼍伏，铁干擘云星斗悬。\n自信美材遗远地，岂期旧物结新缘。\n他年龙化乘云去，犹有风声遍海天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂江舟中次陈少参七星岩韵","author":"钟芳","text":"碧山缭绕石瑰奇，两岸繁阴薜荔垂。\n桂水岁寒收瘴霭，火田秋熟庆清夷。\n无名老树森森秀，得意幽禽翐翐飞。\n三百六滩天上落，险夷惟有宓神知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿英利驿次壁间韵","author":"钟芳","text":"幽期何意负良缘，咫尺云津各一天。\n文绮光摇晴嶂外，佩环声落瘴江边。\n重来只恐春容老，此夜空孤月色娟。\n怀抱好开开未得，渚蒲汀芷伴鸥眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田州奏捷送张白山佥宪 其一","author":"钟芳","text":"方召全才出禁中，一时赞翊尽豪雄。\n读书已破几万卷，陷阵今收第一功。\n桂水霜清森画戟，田阳灰烬捲秋蓬。\n华风悉变雕椎旧，白雉何须九译通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田州奏捷送张白山佥宪 其二","author":"钟芳","text":"钱塘昔雨喜相逢，此夜漓江语笑同。\n愧我凡材陪峻列，爱君爽气逼秋穹。\n盗知有备萑蒲静，民自无冤狴犴空。\n甄拔谩疑边地隔，五云举目是重曈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺洪文用乡饮大宾寿六十","author":"钟芳","text":"春风桃李正开时，宾主东南两得之。\n恩自一王申旧典，身更两世见重熙。\n乡惟阳子俗俱化，时有彦方人未知。\n海屋年年益新算，凤雏还看日边飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸葛亭","author":"钟芳","text":"四山缭绕郁孤亭，亭上风烟白昼冥。\n世乱英雄扶汉鼎，功成干羽在虞庭。\n师兴渭上人归义，星陨营中地失灵。\n我欲渡泸追远略，却惭双鬓已星星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风洞","author":"钟芳","text":"苍崖千仞玉玲珑，收拾清冷向此中。\n解愠宜歌虞帝泽，控边长忆大王雄。\n晴连屏嶂层层见，路入天门隐隐通。\n巽命由来渐海宇，夕阳芳草偃秋坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿胡二峰","author":"钟芳","text":"斗柄插子月将半，主人适际悬弧辰。\n芝楼新映雪山晓，桂卣旋开云谷春。\n客底宾僚成骨肉，座间松鹤赞丰神。\n惭予一舸烟波外，清醑无因侑寿樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平南和杨文瑞兵宪","author":"钟芳","text":"号令风霆自柏台，如林貔虎镇蒿莱。\n无端列岫参天出，肯信群酋革面来。\n荻岸枕戈山月落，柳营吹角陈云开。\n纲维全仗谋猷壮，共挽淳庬一脉回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洛容有感","author":"钟芳","text":"远地苍生似白茅，无情风雨任漂摇。\n隹兵翻启戎心变，蹀血堪怜户口消。\n万灶至今屯铁骑，五乡太半集鸱鸮。\n虞山庙祀千春在，干羽犹闻格有苗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和汪少参韵","author":"钟芳","text":"峡口秾阴暗夕阳，扁舟五月莅戎行。\n气苏漓水人忘瘴，曲入梅花鸟哢香。\n赐扇正怀金阙晓，渡泸谁赠玉壶凉。\n凭君少借筹边略，席捲氛祲静远荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余吏部谪琼侨寓苍梧次谢大巡韵","author":"钟芳","text":"身世升沉信所遭，立朝危论属贤豪。\n波颓正藉千钧力，凤去还修五色毛。\n到海岂能忘魏阙，吊湘聊自托离骚。\n名传吏部潮阳旧，天柱同撑碧汉高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和汪少参南隽韵","author":"钟芳","text":"漓江相对合谈围，户外松阴接翠微。\n世路倾危如意少，风情潇洒似君稀。\n旋添清酤觥筹错，戏写新诗笔阵飞。\n西去两江钲鼓急，茫茫飘絮点征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和汪南隽月夜与余仲栗话旧","author":"钟芳","text":"追陪昔忆云霄上，邂逅今怜瘴霭中。\n适意江山随处有，异乡风味此霄同。\n时情局变除方觉，诗思澜翻醉亦工。\n久雨炎威销太半，征帆又逐五更风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和汪少参嘉会抚徭通峡韵先是嘉靖乙酉予在浔与杨兵宪文瑞议雕剿峡贼闻者悚慄惟杨与鄙意合力主之仅戮九人馀悉抚定群蛮震慑愿附籍输税告乞通峡军门乃敕予檄商舟通焉盖自韩公通峡至今六十馀年矣 其一","author":"钟芳","text":"昔年旟旐敝江来，正是潜师破贼时。\n小警能令鱼鸟畏，三驱不致犬羊疑。\n官储赋倍春郊辟，蛮峡船通夜渡迟。\n却忆筹边风月夜，蚍蜉撼树笑予痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和汪少参嘉会抚徭通峡韵先是嘉靖乙酉予在浔与杨兵宪文瑞议雕剿峡贼闻者悚慄惟杨与鄙意合力主之仅戮九人馀悉抚定群蛮震慑愿附籍输税告乞通峡军门乃敕予檄商舟通焉盖自韩公通峡至今六十馀年矣 其二","author":"钟芳","text":"明明凤诏临边日，闪闪霓旌出镇时。\n客舫鱼盐通绝险，鬼方雷电破群疑。\n城连青嶂市应小，瘴带黄茅霜却迟。\n昔衽弓镖今革面，信渠灵变未全痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"故人寄槟榔","author":"钟芳","text":"揽衣独坐窗宇凉，何物沁入秋庭香。\n迢遥寄置必佳品，指点启封聊一尝。\n君多啾唧齿牙脱，我亦潦倒须眉苍。\n何当归去逐樵隐，同看洞天苍海傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗亭道中","author":"钟芳","text":"陆川望望入罗亭，云外乡心境外情。\n涧水不停原有自，野山虽好亦无名。\n马谙旧路蹄增迅，花映斜阳色倍明。\n信宿村居问民瘼，莱芜新垦趁春晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]