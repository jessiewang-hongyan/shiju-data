[{"title":"将赴京作","author":"徐熥","text":"北望幽燕欲断魂，留连未忍别家园。\n直须三径秋光老，开尽黄花始出门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题诸友送行卷后","author":"徐熥","text":"七年三上春官日，各赋诗篇送我行。\n今日蠹鱼生满纸，主人依旧一儒生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兴田驿读邓汝高题壁诗","author":"徐熥","text":"故人半载天涯隔，得见题名胜梦思。\n今日经过驿亭里，再三吟咏壁间诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"路经武夷以公车期逼不得重游溪口别寿卿和叔二道友 其一","author":"徐熥","text":"当日仙槎九曲乘，奇峰五百恣攀登。\n此行苦为虚名累，一宿烟霞也不能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"路经武夷以公车期逼不得重游溪口别寿卿和叔二道友 其二","author":"徐熥","text":"何事人间最可哀，朔风零雨向燕台。\n白云隔断清溪口，不许红尘客再来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张去华席上听妓","author":"徐熥","text":"燕姬二八欲倾城，学得江南子夜声。\n莫遣歌喉频宛转，留将今夕唤卿卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"落第后戏作","author":"徐熥","text":"杨柳如丝草似茵，轻罗小袖白纶巾。\n紫骝嘶向平康路，妒杀春风得意人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南旺湖泛月","author":"徐熥","text":"兰舟乘月下黄河，一片清光漾碧波。\n宛似江南湖上景，分明惟欠采莲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别梁玉","author":"徐熥","text":"何物临岐系所思，佳人偷指绿烟丝。\n重来试看门前树，留得青青有几枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彭城夜泊书事","author":"徐熥","text":"十年此地几经过，数点渔灯起棹歌。\n今夜满天喧鼓角，隔江帆影战船多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中望云龙山有怀陈幼孺","author":"徐熥","text":"云龙山下泛归舟，对景空怀昔日游。\n聚散无期俱是梦，黄河依旧向东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逢从征归卒 其一","author":"徐熥","text":"远望边城战气寒，王师十万半凋残。\n但能留得生还骨，莫问金疮血未乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逢从征归卒 其二","author":"徐熥","text":"脱却从征旧战袍，梦中犹记醉蒲萄。\n从今愁说沙场事，路上逢人卖宝刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同谢于楚袁小脩汪肇邵詹淑正李季宣陈从训集谢在杭席上赠伎","author":"徐熥","text":"相逢流落总天涯，暂借清尊醉狭邪。\n坐有逐臣心正苦，月中休用泣琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬子桥别马季声","author":"徐熥","text":"秋风摇落满征帆，扬子桥边酒半酣。\n一棹芜城君独往，月明今夜我江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金阊别李二","author":"徐熥","text":"天涯摇落正深秋，一别亲知双泪流。\n不但思家心独苦，断肠今日是苏州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟夜即事 其一","author":"徐熥","text":"金阊亭下解兰桡，一水吴江去渐遥。\n秋梦缠绵浑不醒，月明齐上度僧桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟夜即事 其二","author":"徐熥","text":"枕前双泪落天涯，半是思君半忆家。\n起坐不知风露冷，一汀斜月照芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊关盼盼","author":"徐熥","text":"十年三度过彭城，燕子楼空月自明。\n欲吊香魂寻旧冢，断碑无主不知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴门戏寄陈伯孺","author":"徐熥","text":"一望蘋花十顷秋，阖闾城下久停舟。\n除将访道寻僧外，半为真娘住虎丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其一","author":"徐熥","text":"绣阁重重锁翠娥，春风帘幕度微波。\n红牙一拍芳心乱，肠断江南子夜歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其二","author":"徐熥","text":"年少谁家傅粉郎，舞裙歌扇断人肠。\n当筵一道微风起，吹出罗衣贾女香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其三","author":"徐熥","text":"独离幽阁影随身，红拂杨家是丽人。\n自有绕梁声宛转，不愁罗袜步生尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其四","author":"徐熥","text":"劈开金锁出重门，学得文君半夜奔。\n但爱风流人似玉，不知年少是梨园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其五","author":"徐熥","text":"含羞含态步迟迟，南北峰头月落时。\n此处留侬侬已住，从今莫唱恼侬词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其六","author":"徐熥","text":"金缕歌成恨几重，看君乐府演临邛。\n场中多少怜香意，今夜欢娱尽属侬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其七","author":"徐熥","text":"响遏行云是此声，况看人似玉壶清。\n蛾眉不惜从君死，只为当时一笑情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题和徐茂吴司理 其八","author":"徐熥","text":"生前憔悴死含冤，半臂犹看带血痕。\n我亦多情病司马，不知何处吊香魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葛阳道中","author":"徐熥","text":"插棘编篱小径斜，数声鸡犬出山家。\n褰帷最爱秋光好，一路墙阴木槿花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲 其一","author":"徐熥","text":"沉香亭畔敞云屏，一树垂杨拂地青。\n暂系紫骝欢莫去，盘中新有五侯鲭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲 其二","author":"徐熥","text":"帝城三月雪全消，新柳如丝学舞腰。\n何处女郎齐度曲，桃花春水赤栏桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲 其三","author":"徐熥","text":"金屋谁家罢管弦，博山沉水尚留烟。\n夜深月到流苏帐，照见鸳鸯作对眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲 其四","author":"徐熥","text":"燕子楼中午漏迟，荼蘼花影上帘时。\n含娇自起开妆阁，学取西山画黛眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"既别田叔归过渊关公署怅然有怀 其一","author":"徐熥","text":"关外车声不可闻，溪边公署闭寒云。\n从今来往渊溪路，定忆风流屠使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"既别田叔归过渊关公署怅然有怀 其二","author":"徐熥","text":"高阁三层傍水开，诗人多在此衔杯。\n从今磴道空危绝，若个诗人得上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题江仲鱼小像","author":"徐熥","text":"五色灵芝五粒松，往来长蹑白云踪。\n画师未许君丘壑，不写清溪一片峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题遇上人小影","author":"徐熥","text":"清溪流水漾松花，独倚孤松不结跏。\n安得添余丘壑相，林中同吃赵州茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题罗太学青雨轩","author":"徐熥","text":"小小轩窗匝密林，山鸠啼昼乱云深。\n飞来雨气青如染，半带松阴半竹阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题伯孺兄弟临池小隐","author":"徐熥","text":"幽居疑是子云亭，水绕柴门昼不扃。\n独卧西堂清梦远，春风池上草青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人孤凤","author":"徐熥","text":"楼上箫声久不吹，梧桐花下立多时。\n此身岂少双飞翼，不到成双不肯骑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人对局","author":"徐熥","text":"绿云妆罢下朱楼，閒向春风结伴游。\n携得楸枰连袂去，花间同赌玉搔头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题宋画宫扇 其一","author":"徐熥","text":"楼船航海事飘零，无数蛾眉恨血腥。\n团扇独留宫树影，六陵何处见冬青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题宋画宫扇 其二","author":"徐熥","text":"銮舆东下指临安，北望中原路渺漫。\n写得残山兼剩水，只留团扇与人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题宋画宫扇 其三","author":"徐熥","text":"团扇当年巧样裁，宣和殿上几徘徊。\n