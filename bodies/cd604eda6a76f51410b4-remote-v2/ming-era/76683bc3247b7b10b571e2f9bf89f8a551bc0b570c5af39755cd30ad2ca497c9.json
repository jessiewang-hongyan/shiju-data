ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂花练鹊","author":"欧大任","text":"仙冠鹊尾汉宫裁，金粟岩花日日开。\n此是淮南宾客地，白云还待八公来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山茶绿莺","author":"欧大任","text":"月冷红妆尚未残，莺声新啭禁城寒。\n綵毫入直蓬莱殿，留待词臣雪里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和施平叔题周公瑕小像","author":"欧大任","text":"褐衣人识五陵豪，綵笔凭陵气象高。\n曾醉洞庭山下月，笑从渔父诵离骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻三弟酒禅阁成","author":"欧大任","text":"和歌曾傍酒人游，不为攒眉入社愁。\n堪笑吾家癯叔子，禅时犹号醉乡侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆四弟读书岱青楼","author":"欧大任","text":"书来闻尔注离骚，海上青山对浊醑。\n织畚纬萧贫亦得，不妨长啸白云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种苜蓿","author":"欧大任","text":"陆沉自昔汉宫门，削牍闲锄苜蓿园。\n一饱岂堪持饲客，秋风天马共衔恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩侯庙","author":"欧大任","text":"风尘契合汉功臣，天以英雄出灭秦。\n莫为淮阴恨蝉冕，烟波曾作钓鱼人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛白马湖怀吴道南陆长庚","author":"欧大任","text":"一片征帆白马堤，射阳西更博支西。\n淮南二隐遥相望，谁道风流在剡溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯妹夫用唯南归 其一","author":"欧大任","text":"东床君是谢家亲，文采风流亦未贫。\n闻道阳元成宅相，衡门归去扫荆榛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯妹夫用唯南归 其二","author":"欧大任","text":"茱萸湾下广陵楼，风引孤帆不可留。\n满目离情君自见，千山鸿雁白云秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯妹夫用唯南归 其三","author":"欧大任","text":"五岭烟霞老葛巾，临行把袂各酸辛。\n汝归应访吾诸弟，篱下黄花少一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯妹夫用唯南归 其四","author":"欧大任","text":"短笛南征马伏波，海门霜色避横戈。\n青山待我抽簪日，莫遣风尘到薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中泛湖登孙秀才楼上","author":"欧大任","text":"剡水何期有戴生，高沙飞雪过邗城。\n他年黄子湖边路，画我山阴道上行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大雪夜宿应秀才园亭","author":"欧大任","text":"先生未厌一毡寒，雪里寻君对榻看。\n宁用洛阳除径至，应黉今日是袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江四首 其一","author":"欧大任","text":"黄鹄恣一举，乃在太液池。\n天马产渥洼，矫矫汗血姿。\n睥睨阊阖里，冠尽青云垂。\n何以咫尺书，行役在路岐。\n皂枥有刍豆，日夕维絷之。\n盛年不努力，贫贱宁可辞。\n决起枋榆间，啁啾亦奚为。\n落日临大江，辛苦当告谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江四首 其二","author":"欧大任","text":"击汰出江干，扬舲一何疾。\n渺渺余独征，袛役在今日。\n浮云散高楼，中天见京室。\n斯须北以南，流盻双飞翮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江四首 其三","author":"欧大任","text":"宵征江北月，旦见江南山。\n倏及新林浦，引领白下门。\n龙飞起淮甸，龟食卜洛原。\n王屋似钟阜，终南表长安。\n休明值嘉运，顾盻逢所欢。\n然诺重相许，报答良独难。\n将奏都亭记，言向郊扉还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江四首 其四","author":"欧大任","text":"滔滔江汉流，归海自有时。\n皎皎众星出，明月敛其辉。\n竞智未必是，逃名未为非。\n金马可陆沉，酣饮不复疑。\n东方玩世士，执戟岂告疲。\n井丹著高洁，磨涅难磷缁。\n平生薄禄计，果协沧洲期。\n济江且远游，乘桴得吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒孝陵","author":"欧大任","text":"万方劳我祖，百战定中原。\n涿鹿干戈戢，周京礼乐繁。\n驱除开日月，洗涤正乾坤。\n睿算千夫废，深仁万户温。\n画江盘凤阙，卜洛俯龙门。\n图像英姿奋，山河王气存。\n鼎湖云已泣，银海浪先翻。\n弓与胡髯堕，旗随汗血奔。\n夕阳原庙树，春色霸陵园。\n宫监藏金甲，祠官供玉尊。\n禹谟垂后代，尧典重正元。\n松路容趋走，文思颂帝恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访朱仲开","author":"欧大任","text":"献岁灯初试，寻君正此时。\n尺书劳夙约，斗酒赴佳期。\n江上观涛色，淮南揽桂枝。\n自今能策马，闲过习家池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴山人李太史盛秀才同登清凉山得多字","author":"欧大任","text":"问是清凉寺，南朝事若何。\n春阴屯树密，山色照江多。\n万堞开林麓，千秋散绮罗。\n且持醽酴去，醉眼送沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江东驿送陈节推赴广信","author":"欧大任","text":"劳劳送客处，离绪不堪陈。\n独喜法曹吏，今推儒行人。\n青毡经雪冷，绿绶映花新。\n讼简多诗兴，鹅湖碧浪春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵元夕五首 其一","author":"欧大任","text":"旧京门巷盛繁华，双凤衔灯出帝家。\n宝马嘶残三市月，玉笙吹过五陵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵元夕五首 其二","author":"欧大任","text":"朱帘翠袖拥秦娥，火树如山奈乐何。\n谁道春江花月夜，至今多解玉奴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵元夕五首 其三","author":"欧大任","text":"綵楼酺饮紫云升，六代繁华未足称。\n鳷鹊卢龙春色里，满城歌吹万家灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵元夕五首 其四","author":"欧大任","text":"五夜侯家锦绣筵，徵歌曲宴艳神仙。\n那能不醉金陵酒，磐石朝廷一万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵元夕五首 其五","author":"欧大任","text":"三殿鳌山引鹊桥，内庭银烛映层霄。\n都人白首游灯市，下马宫门颂帝尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同邢太史陈明府杨山人姚使君集姚鸿胪市隐园玩梅花得东字","author":"欧大任","text":"新年春色满帘栊，翠羽缤纷绕几丛。\n莫以罗浮疑岭外，且看姑射在江东。\n瑶华片片非因雪，玉貌盈盈不避风。\n却忆何郎清咏处，扬州高阁白云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盛仲交苍润轩","author":"欧大任","text":"钟阜山南访隐沦，荫窗修竹四无邻。\n馆开招隐烟霞古，园为閒居笔札新。\n三径每期羊仲赏，诸侯谁念马卿贫。\n飘飘知尔淩云气，老作公车奏赋人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无着上人青莲宇和邢太常","author":"欧大任","text":"十方持锡此中回，精舍初成树始栽。\n梵罢篱门明月上，定时钟阜白云开。\n东林竹长霞为衲，西岳莲生石作台。\n策里楞伽还欲授，许询都讲几时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白下遇冯汝行","author":"欧大任","text":"三载惊初见，天涯岂有期。\n还轺金马使，满箧白狼诗。\n行役怜鞭弭，才名感鬓丝。\n暂维京口艇，别去益相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同冯文学汝行吴山人子充夜集许太常仲贻宅","author":"欧大任","text":"玉勒拂春烟，相逢即此筵。\n清卿真似月，狂客每谈天。\n白袷梅华下，青箱薤叶前。\n五经推许氏，江左为谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"范太史杨评事携酒榼过清凉山中","author":"欧大任","text":"忝摄名山长，精庐为客开。\n爱君乘兴发，骑马到门来。\n馆阁词人笔，云霄法署才。\n金陵逢二妙，堪醉凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"袁考功鲁望邀饮","author":"欧大任","text":"置驿邀宾促，鸣珂出省迟。\n人推山吏部，吾爱郑当时。\n浊酒多留醉，清诗更解颐。\n江东容易别，敢负竹林期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同沈道士登东麓亭望谢公墩","author":"欧大任","text":"冶城北望尽烟霞，犹有荒墩属谢家。\n五十出山君莫诮，中原谈笑净胡沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登鸡鸣寺凭虚阁忆旧游","author":"欧大任","text":"士林精舍掩松扉，江左重来旧客稀。\n二十八年今几在，阁前莺啭杏花飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月十七日陈子野宅湘兰始花","author":"欧大任","text":"烟光淡沲秦淮滨，暖色絪缊楚畹春。\n谁在潇湘五千里，独持琼佩赠佳人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"市隐园夜起月下同无着上人看杏花","author":"欧大任","text":"红杏花开莺唤人，姚家园中照眼新。\n借问终南老禅客，何能不忆曲江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵遇诚意伯刘君饮酒歌","author":"欧大任","text":"君之烈祖起括苍，攀龙附凤从高皇。\n帷幄前筹决征伐，不数汉代张子房。\n论功开国居第一，汗马勋劳宁敢当。\n泰山为砺河为带，金书铁券同侯王。\n从此悠悠二百载，鼎彝虽勒恩中改。\n宁因饮酎责黄金，讵为煮盐擅东海。\n外戚金貂奉朝请，麟阁宿勋几家在。\n苗裔飘零编户同，英灵感会风云徙。\n先帝持绍功臣封，君首蒙恩拜九重。\n留侯已复山河誓，岂但褒公与鄂公。\n宿卫禁中时引见，前年军府开江东。\n刀笔何人肆媒蘖，屏居亦似蓝田中。\n我来共饮金陵市，悲歌醉把箜篌倚。\n只今烟尘满边鄙，羽林材官儿戏耳。\n至尊念君曾抚髀，问是郁离之孙子。\n竖儒不足报朝廷，酒酣拂剑君当起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠斌公","author":"欧大任","text":"六根无尘性不染，赟公八十惟真如。\n忆公少小出家日，曾以沙弥事太虚。\n太虚昔住宝胜院，执巾棒锡参禅观。\n海内陈庄此一时，从师亦得陪琴砚。\n慈航东渡到长干，天界登堂甘露漙。\n楞严圆觉俱妙解，九流遍涉增波澜。\n东吴顾老名江左，王陈谢许同文社。\n旬日每因支遁留，新诗几为汤休写。\n只今最盛秣陵才，半入人天会里来。\n东林旧事欣重睹，北山草堂先已开。\n彭泽归来陈子野，家风自是清净者。\n隐囊纱帽与公谈，长生木瓢劝公把。\n流沙西去更何时，五千文字度毗尼。\n青天缥缈真人气，东望惟应尹喜知。\n沉冥柱下藏室吏，天竺先生伯阳氏。\n青牛还候出函关，我欲问之邢太史。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后同姚元白杨惟五游城南诸寺四首 其一","author":"欧大任","text":"万叠青山绕帝城，城南竹杖喜春晴。\n游人多问华林苑，谁解长干寺里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后同姚元白杨惟五游城南诸寺四首 其二","author":"欧大任","text":"石子冈前霞满天，千枝杏花更可怜。\n江南觅得同游侣，不是诗禅即酒禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后同姚元白杨惟五游城南诸寺四首 其三","author":"欧大任","text":"木末亭西背郭斜，宝林庵是律僧家。\n春阴几日不出户，犹得闲行听暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后同姚元白杨惟五游城南诸寺四首 其四","author":"欧大任","text":"何许园林红蕊新，白门烟柳不胜春。\n旧游禅客今谁在，惟有山莺似故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登雨花台","author":"欧大任","text":"天花何日雨，台下见长干。\n塞色卢龙古，江声白鹭寒。\n双林云更落，六代柳俱残。\n祇有谈经石，苍苍绕法坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]