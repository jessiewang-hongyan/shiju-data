[{"title":"宿枫桥","author":"陈琏","text":"杳杳归心逐去鸿，江枫渔火对孤篷。\n一宵清梦何曾着，月落寒山半夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四皓","author":"陈琏","text":"高隐商山鬓已皤，清风一曲紫芝歌。\n当时不堕留侯计，汉使虽来奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游石经山见杏花偶赋","author":"陈琏","text":"村前红杏犹未放，山上花开照眼新。\n不是化工有私意，向阳草木易为春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五马图","author":"陈琏","text":"干戈载戢世平康，神骏无羁尽脱缰。\n新水满沟春草绿，风光好似华山阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子猷访戴图","author":"陈琏","text":"乘兴来寻兴尽还，何须相见始为欢。\n剡溪月落三更夜，风满寒流雪满山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徽宗蜡觜","author":"陈琏","text":"艮岳秋高日色晴，缕金盆上饮清泠。\n待看二月春光动，去其朝阳綵凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杨炼师月夜诵经图","author":"陈琏","text":"璧月流空露满庭，道人闲诵蕊珠经。\n清声琅琅夜方永，白鹤飞绕香烟听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海棠白头","author":"陈琏","text":"幽禽头白羽毛奇，并立东风第一枝。\n宋苑十题曾在首，金盘银烛可无诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄江浦教谕孙晢","author":"陈琏","text":"京华多士总能文，别后令人最忆君。\n客里不知春欲暮，龙江柳色翠于云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王谦雪月梅","author":"陈琏","text":"喜诵逋仙香影诗，偶从画里见南枝。\n冰花烂熳开无数，好似孤山雪后时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹林七贤图","author":"陈琏","text":"竹林深处集华裾，放浪从来礼法疏。\n莫倚清谈惊世俗，东门长啸有胡雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张宇初真人画为郑侍郎赋","author":"陈琏","text":"云气茫茫树色苍，千章杰木拥茅堂。\n真人跨鹤三山去，此日空留翰墨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士谦竹为崇安知县金怀赋四首 其一 风","author":"陈琏","text":"珊瑚石亚玉琅玕，摇曳云稍翠色寒。\n疑是朝真仙佩响，清音缥缈碧云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士谦竹为崇安知县金怀赋四首 其二 晴","author":"陈琏","text":"闲歌淇澳步虚庭，一炷炉烟绕翠屏。\n试写潇湘秋半幅，砚池浮动墨花馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士谦竹为崇安知县金怀赋四首 其三 雨","author":"陈琏","text":"采兰忆昔过湘浦，两岸修篁带雨看。\n此日晴窗见图画，令人清兴满江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士谦竹为崇安知县金怀赋四首 其四 露","author":"陈琏","text":"瑶台月上夜将分，劲节修仪见此君。\n一段高标谁写得，九天凉露落纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题雁图四首 其一 飞","author":"陈琏","text":"来从紫塞力犹微，逐伴排行作阵飞。\n任尔翱翔江海去，人间今日网罗稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题雁图四首 其二 鸣","author":"陈琏","text":"露下瑶天秋月明，宾鸿此日已南征。\n一声嘹唳青云外，唤起江湖久客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题雁图四首 其三 宿","author":"陈琏","text":"几行疏影带斜晖，芦渚蘋汀正好栖。\n何事奴鸣惊梦觉，平沙风露夜凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题雁图四首 其四 食","author":"陈琏","text":"随阳万里到潇湘，为爱江南足稻粱。\n饮啄无虞心自乐，忘机多承水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边景昭四时鹌鹑为周副都御史赋四首 其一 春","author":"陈琏","text":"自信生来性独灵，斑斑文采更分明。\n斗时胜负浑閒事，曾占梨园曲里名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边景昭四时鹌鹑为周副都御史赋四首 其二 夏","author":"陈琏","text":"草碧莎青照眼新，炎炎暑气政熏人。\n一双同沐清波上，偏喜毛衣不染尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边景昭四时鹌鹑为周副都御史赋四首 其三 秋","author":"陈琏","text":"粟垂金穗暮秋时，来往郊原得所依。\n曾记朝回花下见，一双飞上绣罗衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边景昭四时鹌鹑为周副都御史赋四首 其四 冬","author":"陈琏","text":"清晨六出雪花晞，枸杞子红今满枝。\n逐伴偶来贪看处，玉坡高处立多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徽庙蟹图","author":"陈琏","text":"艮岳风高天已秋，闲将缣素写蝤蛑。\n自从远狩黄龙后，还忆横行介士不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题西湖小景","author":"陈琏","text":"翠幕红楼近水边，荷花香里总宜船。\n客窗此日看图画，无复闲情似少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢万石对镜写真图为谢廷玉赋","author":"陈琏","text":"面对菱花自写神，可人风采宛犹真。\n当年亦是清谈者，不染元规半点尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老子出关图为松江陈宗仁赋","author":"陈琏","text":"道德经文祇五千，当时尹喜得亲传。\n出关又跨青牛去，万里流沙几日旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徽庙鹡鸰图为冯庸庵赋","author":"陈琏","text":"幽禽一个写来真，犹带宣和墨色新。\n二百年馀依旧好，不随艮岳化为尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牛图为毕通政文英赋","author":"陈琏","text":"水边杨柳绿阴多，引犊乌犍上草坡。\n最爱阿童骑处稳，笛声吹出太平歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泣麟图为指挥周璇赋","author":"陈琏","text":"周室东迁国事非，况逢西狩获麟时。\n素王因绝春秋笔，痛泣风前泪满颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅竹为理问程勉赋二首 其一","author":"陈琏","text":"罗浮别后已多时，山下梅花入梦思。\n驿使不来空怅望，却从图里见南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅竹为理问程勉赋二首 其二","author":"陈琏","text":"孤标才睹琅玕玉，嫩叶方披翡翠毛。\n待取岁寒风雪里，看渠奇节拂云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清河","author":"陈琏","text":"清河桥下水如苔，无数飞花近马来。\n回首玉京才咫尺，祥云五色护蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏村","author":"陈琏","text":"旌幢戈戟满郊原，饮马长河水欲浑。\n风飏酒帘杨柳外，行人遥指是苏村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任丘河","author":"陈琏","text":"波光渺渺水长流，源出桑乾最上头。\n百折千回何太急，不知几日到泸沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花园二首 其一","author":"陈琏","text":"沿堤柳色绿毵毵，春水溶溶碧似蓝。\n几树杏花烟雨里，风光恍惚似江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花园二首 其二","author":"陈琏","text":"三月春深杏正开，寻芳能见几人来。\n昨宵风雨花狼藉，无数残红点绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偏岭","author":"陈琏","text":"虎旅前驱拥旆旌，郊原极目总军营。\n可人偏岭山前景，白石磷磷水自清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滦河","author":"陈琏","text":"征车前日发雕窝，无数青山眼底过。\n此际又从沙碛去，一鞭细雨度滦河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"回回墓","author":"陈琏","text":"碧瓦重重白石门，墓碑剥落雨苔斑。\n漆灯已灭精灵散，满地西风塞草寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞外山皆桦木不闻禽鸟因诗记之二首 其一","author":"陈琏","text":"满山桦木拂云平，终日绝闻禽鸟鸣。\n海子波澄砂碛远，空馀雁影与雕声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞外山皆桦木不闻禽鸟因诗记之二首 其二","author":"陈琏","text":"出关连日傍山行，谁见苍苔点绛英。\n间有野花皆碧色，问人都道不知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李老谷","author":"陈琏","text":"五更风露政凄凄，谷口云深路欲迷。\n马上酒醒天渐曙，如何不听子规啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入居庸关","author":"陈琏","text":"远供军饷出开平，此日归来荷圣情。\n独爱居庸山水好，自临涧石濯尘缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西宁驿留别袁指挥二首 其一","author":"陈琏","text":"西宁驿外暂停骖，君向开平我向南。\n朔雪炎风天万里，相思何处觅云缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西宁驿留别袁指挥二首 其二","author":"陈琏","text":"每忆暌违滁水上，相将又是十年来。\n今朝客路分南北，尘世相逢有几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至鲁桥留别□□将三首 其一","author":"陈琏","text":"清晓方舟送我行，知君不忘旧交情。\n宝安此去五千里，两地相思共月明。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至鲁桥留别□□将三首 其二","author":"陈琏","text":"几株杨柳近河桥，叶叶偏承雨露饶。\n此际逢君应忍别，临流不用折柔条。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至鲁桥留别□□将三首 其三","author":"陈琏","text":"黄帽船头发棹歌，临流握手奈情何。\n人生离合虽常事，争似今时别意多。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其一 市桥春涨","author":"陈琏","text":"石梁跨河岸，百尺犹垂虹。\n夜来春□□，□□□□洪。\n滔滔势莫遏，滚滚声何雄。\n□□□□□，□□□海通。\n飞翔集鹅鹳，变化多鱼龙。\n□□□□□，□□兴何穷。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其二 凤台秋霁","author":"陈琏","text":"峨峨道家山，神仙有楼阁。\n灵鸟久不来，□□□□昨。\n霜寒竹实老，露重桃花落。\n遥空净氛翳，万□□神岳。\n几回候仙骖，缥缈闻仙鹤。\n日暮天风高，□□动寥廓。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其三 旗岭廉泉","author":"陈琏","text":"灵源发山麓，湛湛澄寒辉。\n素不污泥滓，时能起沦漪。\n沿涧泻瑶琴，触石成珠玑。\n来寻惬幽趣，同酌欲忘机。\n政喜清热恼，无烦浣尘衣。\n何当酿春酒，再拜奉亲闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其四 宝山石瓮","author":"陈琏","text":"伊谁凿山骨，开作石瓮圆。\n不假陶冶工，可拟金石坚。\n终日泻飞淙，积岁成重渊。\n山灵为呵护，神物常蜿蜒。\n有时起风电，白昼生云烟。\n黎民沐嘉泽，胜迹垂千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其五 彭洞水帘","author":"陈琏","text":"群峰敛苍蔼，石壁凝寒辉。\n如何乳泉下，化作水帘垂。\n光荧耀水晶，的皪明珠玑。\n月钩谩高挂，云额空自披。\n曾闻乘鸾女，浣弄湿仙衣。\n信知出天造，不假人力为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其六 靖康海市","author":"陈琏","text":"瀰漫合澜海，南与沧溟通。\n蜃气起蛟室，珠光出龙宫。\n楼台纷隐见，墟市见空濛。\n谩将化城比，还与幻境同。\n天风忽吹荡，人物归虚空。\n登州景相类，赋咏怀坡翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其七 海月风帆","author":"陈琏","text":"何年役神工，凿破苍崖石。\n幽□□□□，□□□□壁。\n涛声撼禅关，岚气满空室。\n□□□□□，□□□一色。\n风来客帆归，月出潮□□。\n□□□□□，□□开虚碧。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景 其八 觉华烟雨","author":"陈琏","text":"芳洲启兰若，沧江自环互。\n终日风雨来，长林翳烟雾。\n香凝薝卜花，翠湿菩提树。\n高僧悟禅秘，妙断往来趣。\n时闻独鹤鸣，莫辨孤鸾去。\n薄暮动疏钟，空濛不知处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"零春馆","author":"陈琏","text":"高人托冲隐，筑居琼岛浔。\n山水足佳趣，烟露惬素心。\n牙签悬锦轴，玉树映琼林。\n芸草满阶除，清香时辟蟫。\n一鸟花间鸣，间关流好音。\n感此时序易，长歌还孤斟。\n孰识个中趣，悠悠山水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黎氏祠堂","author":"陈琏","text":"有美诗书裔，由来号德门。\n分符闻远祖，冠豸见诸孙。\n兰玉春风蔼，松楸雨露繁。\n奉先祠夙搆，系族谱犹存。\n制度深详究，仪文旧讲论。\n堂阶明等级，昭穆序卑尊。\n祭器清尤洁，斋居寂不喧。\n丽牲碑已老，玉鬯礼弥敦。\n承祭推宗子，联行肃弟昆。\n蘋蘩供俎豆，醪醴注罍樽。\n缩酒茅偏洁，焚香鼎自温。\n暖光浮蜡炬，烈焰烛糁盆。\n祼奠终三献，歌谣遍一村。\n燕毛常序齿，敬祖重分膰。\n士论咸归美，乡闾无间言。\n观风有使者，我喜为敷宣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郡守王纶之任","author":"陈琏","text":"新领除书荷宠荣，双旌五马出都城。\n过家喜有亲朋会，入郡应多父老迎。\n好效刘宽施善政，肯教王霸擅能声。\n左江黎庶沾恩惠，鼓腹讴歌乐太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咸潮堤","author":"陈琏","text":"长堤高下望无穷，遏住潮头不敢东。\n护得咸田千万顷，至今村落庆年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"濠田","author":"陈琏","text":"卤潮渍岸渺无边，叠石埋陂碨礧连。\n万顷粒山推不去，翻令沧海变桑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙舌泉","author":"陈琏","text":"闻昔励布衣，寻龙称地仙。\n此井渠所发，至今出寒泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"珊瑚洲","author":"陈琏","text":"珊瑚生海底，偶为渔者得。\n至今洲畔月，长照水波赤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德生桥","author":"陈琏","text":"长桥类垂虹，苔满阑干石。\n放生谁复来，影落寒波碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙穴洲","author":"陈琏","text":"洲前风起水云腥，满眼波涛似雪明。\n欲向矶头吹铁笛，只愁海底老龙惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石鼓","author":"陈琏","text":"异事相传竟莫徵，石鱼曾说见临平。\n大明一出群阴伏，此鼓从今不复鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤凰台","author":"陈琏","text":"山上百尺台，曾闻来凤凰。\n凤凰去已久，遗迹空凄凉。\n竹实饱霜露，梧桐媚朝阳。\n于今际熙皞，凤兮当来翔。\n翩然衔瑞图，与时作祯祥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武山","author":"陈琏","text":"海濒多名山，兹山最雄特。\n盘回几千里，屹立势无敌。\n峨峨峰峦高，去天仅盈尺。\n树含不老姿，石有太古色。\n绝壁走飞鼯，枯槎聚饥鹘。\n沧溟涨天浮，纵目望无极。\n缅怀余襄公，曾此候潮夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹾场夕照","author":"陈琏","text":"虎门落日暮潮来，归鸟翩翩作阵回。\n煮海竟烧烟万灶，收盐多积雪千堆。\n溪山绚綵曦光驭，屯栅增辉霁景开。\n氛祲已销鲸浪息，不教蜃气结楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重修资福禅寺因系以诗","author":"陈琏","text":"宝安资福称禅宗，肇基廨宇地位崇。\n灵源杰阁淩苍穹，开山建阁祖堂翁。\n辟支佛光犹白虹，柏树荣悴昭神通。\n纪述幸遇东坡公，阁历世远一旦空。\n断础残碑苔藓重，全公住持愿力洪。\n忽尔思踵前人踪，经之营之材力隆。\n建造完美成其功，佛像灿灿黄金容。\n诸神拱卫貌愈恭，旦夕焚修喧鼓钟。\n勖尔居者无怠庸，期守象教扬宗风。\n丰碑贞石新磨砻，垂休纪绩应无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]