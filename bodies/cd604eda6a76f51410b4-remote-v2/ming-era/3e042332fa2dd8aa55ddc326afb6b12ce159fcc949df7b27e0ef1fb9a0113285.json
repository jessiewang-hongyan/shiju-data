t":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜雨","author":"成鹫","text":"入林疑入城，八月如盛夏。\n晓来闻雨声，急起看花架。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦入深山题诗六句醒而足之","author":"成鹫","text":"自笑半生坐井，今日始离人境。\n虽非员峤方壶，也是孤峰绝顶。\n人偷名去不追，天送閒来便领。\n分明一段奇缘，却被钟声唤醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题衣石师面壁石 其一","author":"成鹫","text":"只履已归葱岭去，祇留片石见天真。\n凭他坐到无穷际，不把眉毛度与人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题衣石师面壁石 其二","author":"成鹫","text":"当人觌面却全非，艮背相呈道是谁。\n识得本来真面目，方知衣石石为衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题衣石师面壁石 其三","author":"成鹫","text":"不雕不琢总天然，信手拈来体自全。\n妙相当知无背面，何人会得石头禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送衣石师下山 其一","author":"成鹫","text":"辜负莲花开满池，下山相问欲何之。\n但言世外閒无事，只有人间病要医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送衣石师下山 其二","author":"成鹫","text":"分付云霞护草堂，出门珍重说行藏。\n旁人痛痒休相管，好向维摩检旧方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送衣石师下山 其三","author":"成鹫","text":"何物相随药一笼，杖头明月与清风。\n老师未得全收拾，留半山僧住此中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠秋霜师 其一","author":"成鹫","text":"黑头白足便参方，归卧云林鬓已霜。\n提起铁鞋再三问，从前行脚为谁忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠秋霜师 其二","author":"成鹫","text":"当年五岳早寻师，兀兀行藏祇自知。\n眼底何曾见山水，腰包那得有閒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题海潮寺壁","author":"成鹫","text":"莫道争名但市城，名山亦复有人争。\n须知海印潮音外，别有孤峰逼太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题华封洞壁间题咏已满不容著语也","author":"成鹫","text":"黄鹤留题已有诗，山僧阁笔费寻思。\n于今欲借空王手，写作人间没字碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓子东山得名画半帧乃昔时好手绘未成幅者索予题破口占三绝书以还之 其一","author":"成鹫","text":"仙人云里掩齐纨，一段风流欲貌难。\n却似真山描不得，止留一半与人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓子东山得名画半帧乃昔时好手绘未成幅者索予题破口占三绝书以还之 其二","author":"成鹫","text":"山有云霞水有澜，虚空却被画师瞒。\n何似东山真面目，和盘托出与人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓子东山得名画半帧乃昔时好手绘未成幅者索予题破口占三绝书以还之 其三","author":"成鹫","text":"溪声山色太无端，阁笔濡毫总一般。\n不似老僧门紧闭，了无踪迹与人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送侍儿出关 其一","author":"成鹫","text":"为嫌门里出门难，结束腰包过别山。\n两片板扉由汝出，当知更有一重关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送侍儿出关 其二","author":"成鹫","text":"出门踏破古人窠，佛祖当前不奈何。\n步步但须行实地，山穷水尽也由他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送侍儿出关 其三","author":"成鹫","text":"吹毛费尽老婆心，笑杀巢居古道林。\n佛法我无相为处，凭他到处觅知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李方水还临高学署 其一","author":"成鹫","text":"三年一别一番新，几度相逢笑有因。\n僧未参方官未擢，闭门人亦出门人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李方水还临高学署 其二","author":"成鹫","text":"停车惘惘不胜情，斟酌前岐旧路程。\n古道至今成鉴辙，那堪重过辨州城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李方水还临高学署 其三","author":"成鹫","text":"海南海北总春风，处处行吟似粤中。\n想到官衙梅雨候，槟榔红遍荔枝红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]