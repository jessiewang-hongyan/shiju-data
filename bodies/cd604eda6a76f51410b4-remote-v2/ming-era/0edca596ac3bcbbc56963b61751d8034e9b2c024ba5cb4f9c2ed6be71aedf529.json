[{"title":"为丹霞一众募布","author":"释今普","text":"谁怜一众苦寒侵，犹着生衣缩项深。\n偏袒右肩还立雪，露穿双肘独行吟。\n休言游手空擎钵，长望慈云覆短衾。\n岩畔向阳如挟纩，况施千丈被遥岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王澹子居士新葺野樗亭成招集同赋","author":"释古卷","text":"未许言高隐，茅亭置水乡。\n选苔先覆地，借竹远临墙。\n辩古藏俱出，谈空兴倍长。\n因僧汲西涧，竟夕发茶香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中早秋","author":"释古卷","text":"山中暑初退，一雨便成秋。\n峰影当窗落，泉声绕榻流。\n吟兴为菊早，病起送人游。\n万籁此时动，予将何所求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹源公游西樵卜隐","author":"释古卷","text":"云中鸡犬似仙邻，欲扫何峰可避尘。\n谷口片霞窥过客，松间微月照幽人。\n竹香晚食寻烧笋，花落行单羡积茵。\n想得到时衣履湿，满山红雨杜鹃春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫玉台","author":"释古汝","text":"洪崖百尺仰晴峰，映日含烟出半空。\n爱景独寻台上路，探奇那避石头风。\n青山特矗浮云外，江水平连远树中。\n古寺疏钟催暮色，寂寥枫叶染天红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚步松岭","author":"释古汝","text":"青青如盖覆山巅，白鹤高飞云满川。\n石老年年仍密叶，江清夜夜隔深烟。\n半帘疏映投林客，一榻寒惊叫月鹃。\n日暮裴回思古处，雪霜真只爱癯仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登海螺岩","author":"释古汝","text":"青螺不住海门东，倒卓为岩插碧空。\n留得江云侵涧白，尚馀蜃气杂霜红。\n钟声过处落危石，雪意开时度软风。\n俯视千山烟树远，未知谁卧石楼中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绕丹霞山","author":"释古汝","text":"相随复自丹霞下，遍绕群峦入细看。\n绝壁过烟依石断，洄溪透草积云寒。\n傍岩蒸黍呼樵客，倚树烹泉避急湍。\n风景不当归自得，晚江流照一峰乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日山居","author":"释古电","text":"谷口残云断，花间每独凭。\n清风来短径，初日照疏藤。\n绿树黄鹂过，丹崖白鹿登。\n山中何所伴，惟此日为朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日山居","author":"释古电","text":"清凉谁不惜，林下独携筇。\n峡径无惊犬，深潭有卧龙。\n岭头云寂寂，桥畔水淙淙。\n閒倚石台上，微风吹古松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日山居","author":"释古电","text":"树里南湖白，阶前野菊黄。\n不因看好景，何事下禅床。\n望月霄旻净，澄心身世忘。\n悠然寒夜永，亭畔落微霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日山居","author":"释古电","text":"雪霁千峰白，寒光照草堂。\n围炉烧榾柮，背日补衣裳。\n境寂心逾澹，情枯道亦忘。\n柴门终日掩，无事但焚香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿准提庵和异峰大师韵","author":"释古电","text":"禅室东山下，蓬门一径幽。\n风生明月夜，露下碧梧秋。\n地僻烟光远，堂虚鹤影投。\n高僧留翰墨，清和满斋头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游五老峰访泽山大师","author":"释古电","text":"结宇五峰间，高深尽日閒。\n湖光晴入户，云影冷藏山。\n偷果猿频到，衔花鸟不还。\n幽栖踪迹绝，何幸得追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江右舟中偶作","author":"释古电","text":"断岸依残驿，寥寥一叶偏。\n生涯怜此日，心绪忆前年。\n霜落空花散，光浮水月圆。\n孤怀何所寄，支枕伴鸥眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同尘异大师作金声兄春日登丹霞对现台","author":"释古电","text":"无事共跻攀，春台坐不还。\n风驱江濑涌，苔蚀石纹斑。\n出岫云藏寺，临流花绕山。\n钟声催落日，凭眺更乘閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过春浮园","author":"释古电","text":"多少名园付劫灰，春浮花木独长开。\n门临碧水烟霞绕，路夹苍松猿鹤来。\n石槛迂回萦古藓，竹林深浅隐高台。\n乱馀相对幽岩壑，翻惜当年鼓乐催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旋庵老宿新筑幽居赋赠","author":"释古电","text":"山窗斜傍绿阴开，树色连烟过水来。\n日暮独寻花径去，潮平时见钓船回。\n檐前野果分僧供，砌下秋葵为客栽。\n老大幽怀同少壮，夜深还上妙高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游钱塘西湖","author":"释古电","text":"二月钱塘花满堤，六桥春色接城西。\n群鸥避雨投荷叶，细草和烟没马蹄。\n杖笠徘徊朱槛晚，楼台依旧白云齐。\n閒游却起沧浪思，应买湖边何处栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日喜黎寅仲张静山谢胤伊谢振万诸公过宿雷峰","author":"释古电","text":"何人乘兴远相寻，山寺披云话古今。\n观世独怜当日事，神交犹忆十年心。\n鸿过碧落风生座，鹤宿松梢月在林。\n却喜群贤同雅集，夜深凭槛一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雷峰寄不挂云兄","author":"释古电","text":"珠江山寺两忘机，一别经时坐话稀。\n旧圃夜栏花尽落，新秋寒渚月初辉。\n廊西习静尘缘少，殿外孤行灯影微。\n昔住禅房频为扫，迟君时望钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初住雷峰下院寄秋渠兄","author":"释古通","text":"鼓角喧填异上方，闭门曾不减清凉。\n閒阶雨过苔侵榻，破屋风筛树覆墙。\n乞食千家分铄釜，降心半偈倚绳床。\n莫辞雁翅城边路，小院梅花正早芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒙许休老雷峰","author":"释古通","text":"鬖鬖白发一函经，曳杖还山惜暮龄。\n空负鞭长徒策蹇，却惭绠短虑羸瓶。\n遥看楼外松添翠，近对窗前竹愈青。\n堪笑此中陪我老，昂藏孤鹤自梳翎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还栖贤留别诸同学","author":"释古行","text":"微茫春树隔晴川，独立津头觅渡船。\n荒戍尚悬高栅火，寒原那有傍村烟。\n亦知长路艰难苦，更念空山寂寞禅。\n此日分钟离院后，断鸿斜日泊江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华首台","author":"释古诠","text":"锦屏开杰阁，山到此弥尊。\n八百仙人宅，三千龙象门。\n双溪分复合，四壁寂还喧。\n大好安禅定，因之溯洞源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天华宫","author":"释古诠","text":"中原方逐鹿，地筑假王宫。\n碣卧黄龙背，阶藏朱草丛。\n松钗沾露滑，竹粉堕霜风。\n共选幽岩歇，颓垣吟夕蛩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱明洞","author":"释古诠","text":"巨石当门辟，犹存古洞名。\n洑流声渐细，灵窟地俱平。\n老鹤窥人起，奇花别俗生。\n林间朱果落，遗核又将萌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冲虚观","author":"释古诠","text":"葛仙仙履在，此地已成尘。\n客尚求丹灶，仙宜笑俗人。\n橙花閒砌落，竹鹿野田驯。\n辟谷无劳问，青房原不贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见日庵","author":"释古诠","text":"上界鸿濛异，三更日渐升。\n星河犹在树，川岳已如蒸。\n藉草眠当露，烧枯凛若冰。\n天鸡初发候，揽袂欲晨兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜乐洞","author":"释古诠","text":"天风吹万窍，坐听辨钧天。\n卜昼辞瑶席，良宵出管弦。\n吹笙自缑岭，鼓瑟来湘川。\n迥异人间世，应为何代仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大小石楼","author":"释古诠","text":"过此峰逾峻，峰形隐石楼。\n丹梯无路入，碧牖不知秋。\n怪树如人立，潈云似水流。\n若非鸾鹤背，安得陟丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卓锡泉","author":"释古诠","text":"灵泉临皓月，空水共圆明。\n一掬能探砥，千瓢任取盈。\n饮思仁智力，沁得梦魂清。\n挹取军持下，能令烦热轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"延长寺旧址","author":"释古诠","text":"皇唐崇象教，金地此中开。\n抚景寻尘迹，何年飞劫灰。\n青乌犹选胜，白马不奔回。\n自有重兴者，应须乘愿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花村","author":"释古诠","text":"恍惚香风过，携筇意悄然。\n一陂芳草地，数里夕阳天。\n疏影消残雪，多情立晚烟。\n美人清梦断，谁拥白云眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日送尘公大师住华首台","author":"释古荫","text":"名山久待辟烟霞，况是吾宗第一家。\n麈拂锦屏开罨画，龙归黄洞散天花。\n不经劫火长松直，独抱高风毒鼓挝。\n仙日拟寻堂构地，杖头凭指路欹斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋钟","author":"释古荫","text":"露浓云重漏初长，一点寒钟出上方。\n松鹤醒回潭底梦，野猿惊破岭头霜。\n悠飏暗度随秋水，濩落频惊在夜凉。\n最是龛灯孤影下，声声唤起铁肝肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送东水师住芥庵","author":"释古荫","text":"小院虽凉亦祖庭，翠苕行扫石苔青。\n园垂野果山神供，窗动高吟水鹤听。\n村近修篁穿露笋，庵犹一芥聚浮萍。\n全凭粥饭招龙象，始信名山到处灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过友人山房","author":"释古易","text":"数载匡山去，凉襟始共披。\n窗虚惟独坐，病起稍吟诗。\n药火分霜气，岩花带晚篱。\n一般寥廓意，能得几人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕","author":"释古易","text":"数声山鸟变，春色满林峦。\n寒夜坐将半，疏钟闻未残。\n身闲多事外，计拙一生安。\n明日年华改，诗情恐未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晓","author":"释古易","text":"松花深闭户，山色销寒烟。\n无事惟甘拙，何心学懒禅。\n雨馀芳草梦，月落子规天。\n堪愧龙钟叟，春来多晏眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扫花","author":"释古易","text":"荣落皆如幻，何曾生寂寥。\n高香仍带露，红影不污潮。\n水阁人烟迥，山庭鸟语骄。\n春光当自娱，明日又花朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晴窗","author":"释古易","text":"几度雨初歇，虚窗晴转幽。\n鸟啼当竹户，花上隔溪楼。\n地僻成深隐，春残忆旧游。\n今宵还有月，清影满床头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居甲子春作 其一","author":"释古易","text":"转觉成幽趣，生涯到处闲。\n溪云分半榻，野鹤共三间。\n门向疏疏竹，窗临浅浅山。\n客仍频远过，差不厌痴顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居甲子春作 其二","author":"释古易","text":"草屋频迁次，东风值早过。\n耳惭聋太晚，发喜白偏多。\n潭静雁无影，春归莺自歌。\n浮生惟一笑，不必问如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居甲子春作 其三","author":"释古易","text":"林吐微微绿，山回黯黯春。\n药栏随地得，诗思逐时新。\n瘦影堪谁似，孤怀只自真。\n呢喃双燕子，感激伴闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中菊花 其一","author":"释古易","text":"为爱高秋意，亭亭水一湄。\n寒光难入谱，秀色自成篱。\n逸士分栽处，闲僧采服时。\n山居真不易，相对足栖迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中菊花 其二","author":"释古易","text":"不寄在篱下，披离自不群。\n一秋无过客，空谷独逢君。\n叶覆烟全碧，花饶水半芬。\n登高重九近，谁共酌秋云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕遣兴次愿公韵","author":"释古易","text":"颇得幽栖趣，看山拥敝裘。\n寒潭初过雁，红叶欲遮楼。\n云水自为适，烟霞又入秋。\n与君深夜里，清思共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次江南","author":"释古易","text":"挈笠乘潮去，逢幽便放篙。\n水痕侵鹤迹，莎色上僧袍。\n胜事閒偏得，兴来吟转高。\n前村知不远，隐隐出蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日送含屿上人归杭州","author":"释古易","text":"十年频结识，两粤遍曾游。\n欲返吴门去，苕溪枕碧流。\n荷风生旅梦，荔雨湿行舟。\n从此应多作，相思南海头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题融虚师禅居","author":"释古易","text":"閒同溪上住，流水夹窗分。\n丽句频贻我，高怀每感君。\n晒经爱山日，移石扫秋云。\n早晚行吟处，松阴与鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日喜不挂师还山","author":"释古易","text":"别来频问讯，云水不离身。\n旧隐喜归日，疏林又值春。\n连朝花气早，入夜雨声新。\n无限相亲意，幽居恰近邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"释古易","text":"昨因多病悟閒身，不到颓龄作老人。\n昨岁花开今日树，新年莺语昔时春。\n常逢友至资清论，辄把诗吟得爽神。\n一领纸袍一藜杖，嘲风啸月未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偶成","author":"释古易","text":"经时何事苦吟生，藓径迟徊觅句行。\n二月东风催鸟语，一桥春水照人清。\n柳枝乍长连虚阁，云影閒拖出短楹。\n无限幽怀徒自写，昨宵犹喜鹤来声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"本洁师山房","author":"释古易","text":"閒居移得自溪西，夹路幽香异草齐。\n山枕旧窗林鹤近，壁留新句野人题。\n松枝静覆安禅处，石井斜当种药畦。\n谁说地偏来客少，苔痕不断杖头泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日书怀","author":"释古易","text":"小阁长开接海烟，高虚无际思悠然。\n多时卧疾逢人少，尽日閒吟祇自怜。\n暗数梅花过二月，偶拈芳草忆前年。\n生涯剩有巾瓢在，名岳终期猿鹤边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬谢邺门见寄","author":"释古易","text":"频年转见故人疏，来往惟君每起予。\n阁入早秋怜善病，溪流黄叶念幽居。\n田园久复谋犹拙，花木闲栽贫自如。\n昨过山中谈野事，喜添佳句寄双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送善孝师还栖贤","author":"释古易","text":"昔岁还山已过期，此行正值早秋时。\n随身惟有一寒衲，清咏无如此别诗。\n枫叶乍红湖月待，梅花才放岳猿知。\n他年若拟诛茆处，金井泉头慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠尹恒复中翰","author":"释古易","text":"早闻嘉遁辞芸阁，长羡风流一布袍。\n林叟惯寻诗兴逸，岳僧频访道情高。\n管教白发饶秋镜，别有丹砂胜绿醪。\n知是罗浮题已遍，三朝曾不出蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子规","author":"释古易","text":"春归黯黯若为情，独向青山彻夜鸣。\n故苑几回芳草没，锦江依旧暮潮生。\n烟消深树藏难定，花落残红怅未平。\n莫道空斋高卧稳，分明听得一声声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄麦大车","author":"释古易","text":"乱后相期未易逢，廿年曾记话从容。\n春花辄扫门临水，晓梦频醒犬吠钟。\n深谷未成投老计，旧溪仍愧寄孤踪。\n迟君更有幽怀在，倚杖斜阳数远峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过访含屿上人溪楼有赠","author":"释古易","text":"一从飞锡到招提，每试冬泉拟霅溪。\n笑我得閒多病后，感君高谊共幽栖。\n道情是处甘寥寂，诗思无时不品题。\n山色满楼相过近，刺桐花下柳桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同谢邺门道长山中晚望","author":"释古易","text":"瘦筇破笠共携持，犹是红芳三月时。\n数里石桥尝远讯，一春閒寺始相期。\n最怜旧垒归江燕，忍听斜阳叫子规。\n尽日与君吟眺处，独惭疏懒不成词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春谒海幢阿大师影堂","author":"释古易","text":"竹帘仍捲海涛春，竟夕低徊独怆神。\n风殿泠泠金磬静，月楼漠漠翠烟新。\n壁悬旧拂閒栖鸽，架积遗书暗锁尘。\n此地从来称法窟，到来谁不慕天亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日集海幢丈室呈乐和尚","author":"释古易","text":"海烟晴捲法堂开，词客相过次第裁。\n野寺正当逢上巳，疏钟频得共登台。\n风回鹤影移吟榻，泉带荷香入茗杯。\n自此芳踪追白社，同群还是旧宗雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬泉","author":"释古易","text":"卜泉曾见问幽林，凿破云根喷雪深。\n清冽已流千古润，徘徊遍想昔年心。\n潮来亦许寒声应，月过何妨倒影侵。\n自是不愁诗思渴，因君吟到夕阳沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春卧病邝檗庵磊园书寄山中道侣","author":"释古邈","text":"自从违旧侣，池馆少相寻。\n抱疾兼为客，祛愁强独吟。\n乳禽啼舌变，寒柳发春阴。\n久负閒宵集，草堂清夜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]