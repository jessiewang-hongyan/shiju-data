[{"title":"晓度仙霞岭关","author":"孙继皋","text":"仙霞古峻岭，早起拂岩行。\n地想留丹灶，人疑到赤城。\n关寒飞鸟隔，山晓宿云平。\n闽海篮舆外，苍茫远度情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭施龙冈先生 其一","author":"孙继皋","text":"夫子持衡日，吾生弱冠年。\n品题千古遇，文字万人传。\n薄技惭知己，明时失大贤。\n茫茫白日暮，何以问苍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭施龙冈先生 其二","author":"孙继皋","text":"太守来雄郡，诸生满学宫。\n论文多暇日，为政美清风。\n除目投荒远，伤心阅数穷。\n潸然国士泪，飘洒断云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭施龙冈先生 其三","author":"孙继皋","text":"诸侯能辟馆，多士尽升堂。\n会想如云盛，恩思化雨香。\n凄凉陵谷事，辛苦黍禾场。\n圣主新文治，今看倍有光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭施龙冈先生 其四","author":"孙继皋","text":"行服心何苦，含哀罢食新。\n生荣悲宦薄，死孝慰从亲。\n寝侍空长夜，原扃不再春。\n萧萧松柏路，相向哭门人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭施龙冈先生 其五","author":"孙继皋","text":"才大翻媒忌，名高却累身。\n神龙元不世，鬼蜮尔何人。\n宰木枝应长，残经业故贫。\n流言空半白，皎日对沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦旱","author":"孙继皋","text":"善病堪高卧，何当岁大祲。\n云兴万户望，露祷一人心。\n有待疑天意，无聊想陆沉。\n祇忧鸡骨瘦，何以厌桑林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢汪伯玉柳杯之赠二首 其一","author":"孙继皋","text":"黄玉深深贮紫霞，美人将寄自天涯。\n应知陶令门前柳，好与閒人醉菊花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢汪伯玉柳杯之赠二首 其二","author":"孙继皋","text":"河桥杨柳郁青青，折尽长条送远行。\n剖得枯瘿仍佐酒，阳关一曲一伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌夜啼","author":"孙继皋","text":"乌夜啼，啼不足，今年天旱无粟。\n何处衔来哺，母饥母饥，母饥忍否，看看月沉杨柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干曲","author":"孙继皋","text":"妾本长干女，爱在长干住。\n何事嫁商人，愁风复愁雾。\n与君返长干，妾安君亦安。\n十指百不难，莫愁饥与寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李参军兄弟自凤阳弃官归四明","author":"孙继皋","text":"挂冠何日返荆扉，携手云林世所稀。\n家在淮南搴桂去，身同贺监乞湖归。\n池塘梦是王孙草，荷芰裁为隐士衣。\n多少五陵裘马客，秋风閒却钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题季参知园","author":"孙继皋","text":"未老能辞禄，为园不出城。\n石头攒树合，湖水应潮生。\n仙梵邻僧送，春衣野客迎。\n莺花新岁梦，鸡黍隔年情。\n杯酒占星聚，笙歌渡月明。\n频过倘不厌，吾亦薄浮荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遥和吴止庵侍御登登州蓬莱阁看海上月出 其一","author":"孙继皋","text":"君上蓬菜阁，何如蹑五城。\n霜威消蜃气，月彩傍窗明。\n贝阙层波隐，琅璈半夜迎。\n将无生羽翰，汗漫友卢生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遥和吴止庵侍御登登州蓬莱阁看海上月出 其二","author":"孙继皋","text":"仙人不可望，君到即蓬莱。\n月出巨鱼避，天寒青鸟来。\n波纹迎槛入，斗柄拂檐回。\n海晏登临见，澄清赖上才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王自吾转运两淮","author":"孙继皋","text":"早晚下扬州，公除不可留。\n到官心似水，为客鬓先秋。\n煮海功何钜，看山兴易酬。\n军储待盐筴，辛苦为分忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许素行游上谷","author":"孙继皋","text":"酒催弦促鼓纷纷，都下衣冠尽送君。\n开府祇今能辟士，出关何以学从军。\n牙门骑马春随猎，玉帐论兵夜勒文。\n檄罢幕中推上客，一时才子正如云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐仰亭学博调官易州","author":"孙继皋","text":"士固各有志，官何不可为。\n传经且易水，吾道况明时。\n俗古悲歌壮，堂春讲诵迟。\n河阳花纵好，桃李亦枝枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日史思善吴文仲二比部偶集斋中分得山字","author":"孙继皋","text":"玉珂双并散朝班，人识明光奏赋还。\n春雪昨看华屋满，秋风偏放白云閒。\n佩将兰草香同握，望得金茎渴共攀。\n橐笔却怜违别久，重来仍是忆青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜管舍人顾文学过集分得删字","author":"孙继皋","text":"芳岁不可驻，逢君京洛间。\n灯花照酒落，诗草对人删。\n霜月披林白，风烟薄鬓斑。\n相过慰寒色，烂醉莫言还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜史吴二比部偶集联句","author":"孙继皋","text":"偶尔逢休沐，过从共举觞。\n寒消鳷鹊雪，暖吐狻猊香。\n人以星为聚，官今鹭是行。\n署怜花并入，朝忆玉同锵。\n露自分仙掌，云仍隔故乡。\n情真吴语剧，愁绝楚歌狂。\n剑拂霜华切，钩藏刻漏长。\n薄帷微鉴月，新律乍回阳。\n温室梅先破，名轩枣故芳。\n辖投期肯后，簪合意难忘。\n藻句骞鸾凤，雄心典鹔鹴。\n乾坤容尔醉，日月向谁忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋明府调幕江藩","author":"孙继皋","text":"拜恩随牒向天涯，趋府回乡道路赊。\n客久总怜芳草色，官閒亦爱紫薇花。\n行经秋水孤烟净，坐对寒江落日斜。\n腰下干将人自见，丰城此去有张华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和卓参军韵送陈邦珽判官忠州","author":"孙继皋","text":"惜别仍为卜夜欢，春郊那问漏声残。\n身辞凤阙分符竹，家傍渔矶忆钓竿。\n层阁勒铭他日事，横厓叱驭古人看。\n薄游不少青云业，倚醉无歌蜀道难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢管山人惠武夷茶","author":"孙继皋","text":"病渴惟高枕，谁将茗叶分。\n色馀仙穴润，香供隐人芬。\n啜似餐丹露，烹疑煮碧云。\n清风北窗下，忽见武夷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送禹江徐丈还海虞分得生字","author":"孙继皋","text":"伏阙听残御柳莺，望乡愁见白云生。\n哀荣未舍先臣泪，去住难为孝子情。\n舆转繁花回夜梦，马归芳草及春程。\n登楼不醉人将别，日出烟霏野树平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万仁甫都谏参政山东 其一","author":"孙继皋","text":"玉节朱衣下九重，陛辞春散景阳钟。\n东方骑拥星为使，四岳官同岱是宗。\n行部风云回缥缈，放衙薇月伴从容。\n保釐可道无难事，十载天书对御封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万仁甫都谏参政山东 其二","author":"孙继皋","text":"建鼓吹铙满路辉，勋名三十似君稀。\n掖垣人去仍焚草，行省春归恰对薇。\n旂转交龙摇海色，门閒千骑驻晴晖。\n令公香远星辰隔，几向朝班认旧衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管舍人御赐烛笔等物六首时丙戌新正二日王孝廉邸舍即席赋 其一 烛","author":"孙继皋","text":"宝炬荧荧出上方，小臣何幸借馀光。\n一从学士金莲送，尔亦承恩正未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管舍人御赐烛笔等物六首时丙戌新正二日王孝廉邸舍即席赋 其二 香","author":"孙继皋","text":"口含鸡舌去朝天，朝罢还携满袖烟。\n更拜宫中龙脑赐，人间初遍异香传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管舍人御赐烛笔等物六首时丙戌新正二日王孝廉邸舍即席赋 其三 墨","author":"孙继皋","text":"淡墨曾携写御笺，龙函今荷赐来鲜。\n客卿敢问中山事，点点璇霄绛露偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管舍人御赐烛笔等物六首时丙戌新正二日王孝廉邸舍即席赋 其四 画扇","author":"孙继皋","text":"彩扇含风禁里裁，午时宣赐近臣催。\n殷勤捧向同官看，当直何人画得来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管舍人御赐烛笔等物六首时丙戌新正二日王孝廉邸舍即席赋 其五 五色丝绦","author":"孙继皋","text":"佳节宫中降五丝，宫衣结束彩相宜。\n只因缕缕恩常在，愿得年年奉玉墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管舍人御赐烛笔等物六首时丙戌新正二日王孝廉邸舍即席赋 其六 笔","author":"孙继皋","text":"赐出仙毫五色霞，簪来常得侍金华。\n因君试问临池意，可似江淹梦里花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许山人自上谷还吴 其一","author":"孙继皋","text":"归路馀春在，青帆去渺茫。\n桃花新涨浅，杨柳古堤长。\n水驿看云澹，江亭贳酒香。\n军城多燕乐，明月远相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许山人自上谷还吴 其二","author":"孙继皋","text":"塞曲闻应惯，乡愁久自谙。\n人行上谷路，家住大江南。\n水涩程难算，离多酒易酣。\n相逢折花别，莫惜满头簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄寿粤南金封君","author":"孙继皋","text":"老垂白发弄沧浪，休沐人归自建章。\n星现东方桃正熟，凉生南海荔初香。\n非熊不羡乘车去，小凤重看吐诏翔。\n家傍十洲仙路近，一年花发一称觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金舍人考绩暂归南海省觐","author":"孙继皋","text":"拜恩书绩下彤闱，却忆庭趋问彩衣。\n冷局十年兼吏隐，炎方五月去人稀。\n船开建业回潮急，路绕虔州落日微。\n多少同行旧时彦，伤心独自送君归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上迷渡","author":"孙继皋","text":"江乡渺不极，风雨况迷津。\n自爱寻山径，何妨问野人。\n潮回愁欲暮，草湿想馀春。\n敢有飘零色，浮云客里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中忧旱","author":"孙继皋","text":"病兼忧卒岁，旱岂为乾封。\n敢望观涛起，何当抱瓮从。\n支离应狗马，变化或蛟龙。\n天意犹难定，东南百万供。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"霜后见菊","author":"孙继皋","text":"怪汝开何晚，嗟余瘦颇同。\n重阳已昨日，数朵尚秋风。\n彩艳微霜借，香幽数月通。\n寒英莫轻折，留对病怀中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人还乡","author":"孙继皋","text":"客久忽不乐，曰归秋色深。\n凶荒数口计，迟暮百年心。\n柳自河桥折，花曾谷口寻。\n朱弦莫中阕，终曲为知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王别驾还朝","author":"孙继皋","text":"咨牧当熙代，分忧得望郎。\n让乡尊泰伯，别驾美王祥。\n为政追风采，勤民感岁荒。\n熏心周抚字，蒿目到流亡。\n摄印频行县，弹琴不下堂。\n人欢迟剖竹，地辟尽栽棠。\n几度劳输挽，孤标见激昂。\n检装僮仆笑，占牍吏人忙。\n清绝心如水，恫深鬓欲霜。\n下车饶擘画，推毂动封章。\n凤诏看将坠，鹓班望独翔。\n借恂愁父老，攀辙百回狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠周中丞召贰南司徒五十韵","author":"孙继皋","text":"熙洽逢明后，匡扶仗老臣。\n专征雄斧钺，独坐肃冠绅。\n建社尊丰镐，生神肖甫申。\n践扬观德业，酝藉足天人。\n博物张华志，图经郭璞珍。\n龙韬樽俎辨，鸿宝枕书新。\n文武经邦手，安危许国身。\n画江劳作镇，比屋跂来巡。\n下令军容改，恢纮帝臬陈。\n望风奔墨吏，就日变黎民。\n何物孤雏似，翻同桀犬狺。\n震惊陵庙逼，骚动楚襄邻。\n借箸应无敌，提戈合有神。\n指挥鱼鸟列，面缚虎豺蹲。\n露布裁丹笔，宵衣慰紫宸。\n歼魁分玉石，赏士出金银。\n警息潢池日，欢回泽国春。\n天疑未厌祸，旱苦迫相因。\n忍见中原坼，愁看大海尘。\n商歌激云汉，雩舞畏星辰。\n此际须安辑，当机倍苦辛。\n抚摩宣泽远，痛哭上章频。\n禁掖中郎节，恩波太府缗。\n纷纶覃禹服，浩荡极尧仁。\n握斗心能运，为霖事已真。\n感时思献策，咨瘼欲沾巾。\n下上规田赋，东南籍富贫。\n租庸两税覈，积蓄九年臻。\n疏凿勤沟洫，关河禀石钧。\n河渠书井井，会计录粼粼。\n填阙师刘晏，投壶慕祭遵。\n减驺人化德，买犊俗还淳。\n根本归磐石，纲维挈要津。\n一分宽是惠，三尺法能伸。\n道契当开泰，功高为拯屯。\n度支新命重，留守旧都亲。\n万旅云屯壮，千仓露积匀。\n近闻忧发粟，谁拟学投醇。\n兵食由来急，丰凶每不伦。\n那堪怜拔距，却忘起悬鹑。\n求谤初传木，思危等厝薪。\n诏书耆老泣，盐铁大夫询。\n乡月行逾迥，民风语易颦。\n鬓苍周闵恤，心赤裕经纶。\n诹野伤涂血，登朝想抗鳞。\n南邦空忆召，河内不留恂。\n厦覆叨帡庇，庐居习隐沦。\n若为瞻赤舄，无处挽朱轮。\n政化来鸣凤，仪刑去画麟。\n惟馀岘首上，终古斗嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日送郑督使还朝席上分得风字","author":"孙继皋","text":"赴阙及秋风，秋筵落照中。\n别看岐路易，游忆曲江同。\n财赋元邦计，文章况国工。\n民艰烦手疏，归报大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日张澄斋大参邀登锡山同诸公分得山字","author":"孙继皋","text":"冠盖群公集，岩峦九日攀。\n赐萸思汉殿，落木怆秋山。\n岁事凶荒后，边尘陇坂间。\n吾生尚鸡骨，不醉鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读杨大谏理荒疏有感","author":"孙继皋","text":"十疏回天足雨霖，传来一读一沾襟。\n艰危旱后安邦计，辛苦行边吁阙心。\n恩到阳春回使节，身归霄汉领朝簪。\n皂囊更借筹边急，闻说烽烟紫塞深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白凤汀太学自颍过访梁溪临别赠之","author":"孙继皋","text":"尔来秋未暮，携酒翠微行。\n酌此惠泉冷，何如颍水清。\n路遥秋落木，节近想餐英。\n抚景兼离思，登临无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴大之粤南省觐","author":"孙继皋","text":"万里迎亲去，扬帆不待秋。\n白云游子意，芳草故乡愁。\n过岭猿啼切，趋庭鲤对优。\n綵衣棠树下，为政见风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同张参知诸公登仙蠡墩相传范大夫拂衣处得人字","author":"孙继皋","text":"出郭避尘鞅，登台思古人。\n扁舟一以去，消尽五湖春。\n酹石寒烟破，穿林倦鸟亲。\n功成吾敢望，倘许乞閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自仙蠡入舟见菊花得南字","author":"孙继皋","text":"十月尚秋色，清潭菊影涵。\n船香众客醉，花品野人谙。\n波动鸥凫没，天空鸿雁南。\n平生岁寒意，潦倒为君谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送魏锦衣恩斋礼玄岳 其一","author":"孙继皋","text":"桂岭篸宫宿上真，玉书金字押星辰。\n春帆片片焚香过，尽是游仙访道人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送魏锦衣恩斋礼玄岳 其二","author":"孙继皋","text":"斋心稽首礼玄君，帝阙天门度白云。\n一自灵峰参玉韭，不须重问五千人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕澄南邀赏樱园阻事践园樱已残","author":"孙继皋","text":"不见珠林万树红，数枝犹自缀丛丛。\n果因后摘娇晴日，客为迟来醉晚风。\n莺讶啄残窥密叶，花怜开尽感飞蓬。\n殷勤野老明年约，十八家村一棹通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登君山望江","author":"孙继皋","text":"岸花江草几回新，十载曾游迹已陈。\n坐迥诸天当落日，闰逢三月尚馀春。\n潮从来往流终古，世亦浮沉叹此身。\n不见当年珠履客，空劳綵笔醉词人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿张企楼","author":"孙继皋","text":"雨馀云白下轻鸥，散发沧江五月秋。\n身健未须烦进杖，心閒曾是学披裘。\n共占胤子能高户，若个仙人不好楼。\n续命恰馀丝缕在，年年开宴发庭榴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙竹墟之贵溪兼讯姚心庭太守","author":"孙继皋","text":"与君分手出重林，五月江寒风雨深。\n命驾自酬千里意，披裘谁识一生心。\n日长客路行堪拟，云起千岩到可寻。\n寄语休官姚太守，避人今隔几青岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暑夜同沈飞霞山人携具朱虚谷舟中分得中字","author":"孙继皋","text":"维舟傍野树，嘉会几能同。\n月逗层阴出，溪回别港通。\n持杯谈往日，移夕欲当风。\n共有云萍惜，狂歌夜正中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫蝴蝶花","author":"孙继皋","text":"蝴蝶梦为花，花开幻蝴蝶。\n紫艳双纷翻，香心不可拾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答尹春寰真定守","author":"孙继皋","text":"书传上谷雁来时，落日中原慰所思。\n守借一麾更重镇，名高三辅望襜帷。\n忧边郡阁亲调饷，怀古军城不废诗。\n分虎画麟同日事，使君身自系安危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁学博罢官归泗州","author":"孙继皋","text":"垂老去亦得，为儒道固贫。\n不逢歌巷伯，相送怆门人。\n讲罢苏湖日，归馀濠濮春。\n休官事事好，鱼鸟伴閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次龚观察毅所忧旱且苦催科得雨志喜韵时西方有警","author":"孙继皋","text":"征赋频年总不禁，忍看云汉只轻阴。\n孤城五月愁炊玉，一夜千村慰雨金。\n已办丝竿乘野水，却防门巷阻秋霖。\n洗兵天意犹难问，听说西师泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读观察南归藁有赠","author":"孙继皋","text":"汉廷循吏不如君，渤海声名天下闻。\n归路几人操白雪，畏途从古叹浮云。\n身疑去国非神武，恩许移官故惠文。\n才大可知推毂近，羽书西塞正纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]