[{"title":"王忠铭宗伯山房四咏 其四 桥头碧水","author":"于慎行","text":"石桥流水拍长堤，半似苕溪半剡溪。\n一自主人题柱别，年年春色灞陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿封御史中丞姚江邵翁六首 其一","author":"于慎行","text":"西台斧绣下觚棱，八座新阶帝股肱。\n更道高堂承内渥，一时真拜两中丞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿封御史中丞姚江邵翁六首 其二","author":"于慎行","text":"世代衣冠直汉宫，家声万石旧称雄。\n丹书映日传江上，白简飞霜出殿中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿封御史中丞姚江邵翁六首 其三","author":"于慎行","text":"清秋鹤发自樵渔，年已非熊入梦馀。\n双阙旧分苍水玉，五云重展绿绨书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿封御史中丞姚江邵翁六首 其四","author":"于慎行","text":"曾是先朝画省郎，江湖白首荷恩光。\n即看宝带浑如旧，不绾南阳召父章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿封御史中丞姚江邵翁六首 其五","author":"于慎行","text":"九十行歌阅大年，红颜春酒万花边。\n人间自有桃源隐，不到蓬莱已是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿封御史中丞姚江邵翁六首 其六","author":"于慎行","text":"綵服亲擎白玉缸，朱轓聊驻碧油幢。\n八龙自是荀家盛，就里慈明更少双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行四首 其一","author":"于慎行","text":"五云深处见仙家，十二楼头醉彩霞。\n莫倚阑干横玉笛，春风愁杀白杨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行四首 其二","author":"于慎行","text":"鵔鸃著出未央宫，粉色争看汉侍中。\n昨夜春寒沾赐酒，天香不散舞衣红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行四首 其三","author":"于慎行","text":"锦带珠袍绿臂鞲，相逢尽说富平侯。\n南山夜猎春城晚，系马新丰旧酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行四首 其四","author":"于慎行","text":"从猎期门拜射声，玉鞭骑马出重城。\n寻常借客长陵市，小吏无劳问姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"告中题斋阁红梅四首 其一","author":"于慎行","text":"花时伏枕殢归情，纸帐罗浮梦未成。\n不是宫霞分片色，空教笛里落春声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"告中题斋阁红梅四首 其二","author":"于慎行","text":"瑶台旧日侣群真，雪骨冰肌别有神。\n化作彩云销不得，多因染却汉宫春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"告中题斋阁红梅四首 其三","author":"于慎行","text":"疏枝向月倚雕阑，粉色盈盈镜里丹。\n为忆故园春色早，愁时只作杏花看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"告中题斋阁红梅四首 其四","author":"于慎行","text":"姑射山中绰约姿，嫣然额上点胭脂。\n妆成却得东君笑，不信红儿是雪儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为潘海滨处士题竹萱图二首 其一","author":"于慎行","text":"素节凌霜耐岁寒，翛翛池影夹琅玕。\n不知凤去瑶台后，长得孙枝更几竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为潘海滨处士题竹萱图二首 其二","author":"于慎行","text":"柏舟高咏事凄凉，漫树忘忧向北堂。\n此日春风转兰蕙，灵根犹自发天香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中奉寄太宰梦山杨公四首 其一","author":"于慎行","text":"为慕仙家九节筇，白云秋色远相从。\n那知黄石山头月，犹隔丹丘海畔峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中奉寄太宰梦山杨公四首 其二","author":"于慎行","text":"曾记都门祖帐开，驱将双鹤与归来。\n只今养得修翎在，海上传书日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中奉寄太宰梦山杨公四首 其三","author":"于慎行","text":"梦中山色可曾惊，陌上烟尘塞上兵。\n千树桃花月明夜，半间楼侧听吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中奉寄太宰梦山杨公四首 其四","author":"于慎行","text":"沧海西头系钓船，萧萧春雨绿杨烟。\n垂纶莫近磻溪岸，恐是非熊入梦年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归山寄贾石葵年丈四首 其一","author":"于慎行","text":"一别心知几度秋，归来相望转悠悠。\n长安旧侣多年少，马上如今半白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归山寄贾石葵年丈四首 其二","author":"于慎行","text":"陌上论交意总殷，眼中谁是峄阳君。\n如何同作东山隐，却隔山前一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归山寄贾石葵年丈四首 其三","author":"于慎行","text":"瑕丘南去路漫漫，月满山窗梦易残。\n君在沧浪秋色里，同心谁伴采芳兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归山寄贾石葵年丈四首 其四","author":"于慎行","text":"闻道君王忆月卿，徵书蚤晚到山城。\n可知昨夜东风起，碧玉峰头鹤梦惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻子冲被徵寄问兼趣早出四首 其一","author":"于慎行","text":"谷城山色五峰亭，十日相过酒未醒。\n底事西河桥畔柳，残枝又傍马头青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻子冲被徵寄问兼趣早出四首 其二","author":"于慎行","text":"西山烽火照边城，殉国何人更请缨。\n知是济南年少在，匣中长剑作龙鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻子冲被徵寄问兼趣早出四首 其三","author":"于慎行","text":"潘园无限北堂欢，捧得除书掩涕看。\n一夕烽烟劳圣主，雄心那不指楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻子冲被徵寄问兼趣早出四首 其四","author":"于慎行","text":"四十男儿报主身，时艰安得避风尘。\n功成自有抽簪日，且借青山与故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中承苏岱髯国相寄自制铜雀瓦砚戏谢","author":"于慎行","text":"磨不多时染未乾，邺都宫殿几回残。\n题名自是西园客，不必重镌汉建安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题路凤冈庭中巨石","author":"于慎行","text":"雕阑四面锁崔嵬，碣石残山此地开。\n若在钱塘江上见，何人不道小飞来。","collection":"明","notice":"","