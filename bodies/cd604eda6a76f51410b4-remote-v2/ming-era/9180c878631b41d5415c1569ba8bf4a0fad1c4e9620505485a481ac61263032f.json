[{"title":"谒李忠简公祠","author":"王原校","text":"向阳堂上俨光仪，多感龙头缔会奇。\n道派至清清献授，心源虚白白沙知。\n缒城伟绩千年重，食邑殊恩异代思。\n故里云仍能世讲，至今淑艾有馀私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过崇积博雅斋观榴花酒酷折花登楼欢赏得秋字","author":"李栻","text":"恋旧频过汝，相看意转幽。\n红深花妒日，碧澹叶含秋。\n已醉涂林树，还开风木楼。\n一枝斜倚晚，喜色坐中收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送葛从化之衡府","author":"李栻","text":"送客王门去，离心奈尔何。\n长沙天地阔，前席鬼神多。\n草木新兵色，江山旧战窝。\n畏途固如此，行矣慎风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日村居寄欧阳崇积","author":"李栻","text":"踏踏歌来世路浮，故乡迢递去还留。\n青山恋我惟觚颖，白日骄人一杖头。\n鸡犬数家浑是旧，池塘半亩不成秋。\n何时兰玉斋前酒，萝薜初衣傲十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集饮东林梁先生书舍题赠","author":"陈绚","text":"数亩新庄傍水湄，主人归隐爱渔丝。\n江枫半系盟鸥艇，堤柳低临浴鹤池。\n风度莺声声乍转，月筛花影影相移。\n繁华今古称梁苑，且对明河醉玉卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"折杨柳","author":"张守谦","text":"何处垂杨柳，边城万里天。\n青飘云外湿，翠压雾中鲜。\n粉黛愁霜落，红颜损塞烟。\n有无肠苦断，扳折付幽燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崖门吊古","author":"张守谦","text":"行殿荒凉锁瘴烟，乾坤万古见三贤。\n间关不惮勤王志，惨淡谁悲救国迁。\n无限忠魂依夜月，有时风雨洗胡膻。\n空馀波荡崖门水，遗恨前朝逝若川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中元洞","author":"张守让","text":"凭高聊极目，洞口白云生。\n屏嶂千峰合，人烟百雉平。\n披蓁寻鸟道，坐石听猿声。\n及此淮南卧，偏宜吏隐情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凌玄洞宴集","author":"张守让","text":"幽崖河朔会，共倒接䍦巾。\n岳拥薇垣近，林开画戟新。\n烟萝尘外景，岩壑雨中春。\n幸此陪欣赏，山花笑向人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题诸葛祠","author":"张守让","text":"孤臣祠宇枕江皋，遗恨吞吴与灭曹。\n寂寞忠魂何处是，江流击石阵云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春怀诃林旧隐","author":"梁岳","text":"伊昔还山时，结庐依古寺。\n绕砌植松篁，环轩披薜荔。\n春色入虞园，四顾罗苍翠。\n石池湛碧空，水暖游鳞戏。\n闭户谢嚣尘，逍遥忘俗虑。\n颇谐静者心，稍适幽栖志。\n一朝谒承明，射策不得意。\n薄宦系微躯，欲返焉能至。\n新恩讵易酬，旧业忽如弃。\n伫想春风深，落花应满地。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十五夜月同诸公饮五仙观","author":"梁岳","text":"九十秋光今已半，天河无云星历乱。\n须臾明月出东海，散落清辉遍遥汉。\n素魄盈盈桂树边，金波沐沐璚楼畔。\n坡山形胜昔称奇，良夜移尊赏最宜。\n神飙乍转三清界，玉露时披五穗枝。\n白莲池上仙踪远，玄武坛前剑气垂。\n胜游况值兹灵景，深杯拚醉忘宵永。\n且将行乐越流光，莫把蹉跎对孤影。\n君不见五仙昔日骑五羊，金丹炼就还帝乡。\n嵯峨怪石空留瑞，至今千载传其芳。\n世人局促徒为尔，牢落尘途甘没齿。\n黄粱已熟梦未醒，回看明月常如此。\n月明今夕正中天，湖海知心尽此筵。\n直须对月倾数斗，得失盈亏任自然。\n明月有圆亦有缺，人生莫漫轻离别。\n但愿金尊酒不虚，年年酩酊酬佳节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春雪篇","author":"梁岳","text":"平楚苍苍孟春月，东皇送暖严霜歇。\n共忻淑景布阳和，讵意寒威尚飞雪。\n同云惨淡冻不开，六花零乱点莓苔。\n已向赤城披素练，还过双阙洒璚台。\n霏微转觉冰天暮，轻清肯受缁尘妒。\n皎洁翻令宿鹭猜，飘扬似触栖乌怒。\n银海瑶山尽一时，璚枝玉树互参差。\n乍惊柳絮堤边起，忽讶梅花笛里吹。\n随风缥缈浑难定，流辉宛转遥相映。\n高咏空怜谢女才，扁舟祇动王猷兴。\n看看不减去年冬，万户千门积素中。\n冷浸虚堂侵几簟，斜穿曲槛照房栊。\n别有琳宫兼蕊殿，翔鸾舞凤高低见。\n云母屏开璧月明，水晶帘捲珠光现。\n皂貂狐貉不胜寒，坐拥金炉漏未残。\n重裀列鼎堪销夜，宁知僵卧有袁安。\n滴向檐端声淅沥，深闺少妇泪沾臆。\n陌头杨柳几经春，玉关迢递无消息。\n沉冥永夜复悠悠，他乡游子倍离忧。\n天涯短鬓难禁白，旅馆孤灯总易愁。\n谩道春宵好行乐，红尘紫陌虚相约。\n往来一唱郢中歌，歌长调苦翻萧索。\n徙倚空斋竟不眠，新寒仍透广文毡。\n世间那得苏司业，买醉谁堪送酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云精舍听张仲钦弹琴","author":"梁岳","text":"已得青山胜，还听绿绮琴。\n美人真绝调，游客愧知音。\n众壑风泉响，县崖雾雨沉。\n醉来频徙倚，疑听九龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用韵答黎惟仁见怀","author":"梁岳","text":"摇落惊秋暮，空庭木叶黄。\n雨馀兰渚润，风动桂丛香。\n卧病蓬三径，怀人水一方。\n何当重结社，文酒共徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春舟中即事 其一","author":"梁岳","text":"浪游淹岁月，转觉鬓毛斑。\n舟楫飘零苦，关河去住艰。\n停云思故国，贳酒破愁颜。\n芳草江南绿，王孙几日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春舟中即事 其二","author":"梁岳","text":"忽惊春事过，几见落花飞。\n贫病人堪老，勋名愿转违。\n诗从愁里赋，家向梦中归。\n去去无劳问，沧江旧业微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游寒岩","author":"梁岳","text":"一径穿林入，凭高信杖藜。\n坐临青嶂阔，指顾白云低。\n洞古龙宫閟，烟深鹤驭迷。\n胜游饶雅咏，彩笔恣留题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈士鹄赴进士举兼柬黎惟敬欧桢伯梁彦国诸公","author":"梁岳","text":"把袂骊歌越水滨，况逢秋尽倍伤神。\n风尘赤羽须看剑，世路青云好致身。\n别后几虚莲社月，到时应恋曲江春。\n蓟门旧侣如相讯，为报烟霞一葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同陈重衡熊楚伯西园听莺得萍字","author":"梁岳","text":"宿雨初收报晓晴，名园深处有啼莺。\n一杯共向花前听，百啭遥传柳外声。\n吟罢几人閒白昼，愁来孤剑按青萍。\n堪怜此会饶幽思，莫遣春愁感慨并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻海寇犯省城","author":"梁岳","text":"艨艟巨舰捲江涛，杀气凭陵海岳高。\n转战漫劳徵虎旅，谈兵虚道识龙韬。\n烽烟一望归心折，鼙鼓频听客梦劳。\n铜柱勋名堪此日，时危谁赠吕虔刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春燕京怀归","author":"梁岳","text":"长安春尽落花多，越客思归意若何。\n节序几从愁里换，家园频向梦中过。\n西京形胜雄三辅，北雁音书隔九河。\n燕市酒垆堪买醉，莫将留滞起悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得孔适弟仁和明府书","author":"梁岳","text":"别尔东来岁已周，为探奇胜数淹留。\n芳尊梦醉琴堂月，候雁书回海国秋。\n凫舄即看仙令起，鲈鱼偏动季鹰愁。\n吴山剡水佳期阻，一夜相思欲白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠微阁晚眺","author":"梁岳","text":"绝顶跻攀路不迷，醉凭飞阁访禅西。\n微茫下界诸峰小，指点平原万木低。\n丹壑烟深回鹤驭，绿杨春暖听莺啼。\n彩毫拟就登高赋，不数任翻壁上题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓过谷城寄张明府","author":"梁岳","text":"远道驱车过谷城，江天旭日转新晴。\n芳郊隐映千花丽，碧树遥连百雉平。\n春尽浦云低雁字，风和柳谷缓莺声。\n行边剩有双龙在，不遇张华祇自鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"半月岩","author":"梁梦日","text":"邑有月岩胜，月中趣几何。\n云头分璧半，窍口上弦多。\n玉洁涵娟衫，祥光映海螺。\n秋香蟾窟味，兰室臭同摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴那山闻题","author":"周光镐","text":"阴那曾负昔年期，先世盘游况在兹。\n圣谛逢梅多荫界，灵光老桧护交枝。\n逃禅我未窥三藐，醉易君今陋九师。\n几欲探奇循旧隐，萧斋阁上问庖羲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜吟","author":"周光镐","text":"萧萧暮角起城头，耿耿银河拂槛流。\n络纬声啼断复续，竹梧淅沥风飕飕。\n幽人夜半揽衣起，露堕帘栊白于水。\n空庭何处捣衣声，举头见月思千里。\n思千里兮夜迢迢，星汉西流桂子飘。\n哀鸿夜度鸣嘐嘐，客子对此朱颜凋。\n芳时易过蕙草歇，玄霜岁岁染华发。\n欲归不归胡踌躇，十年长负故山蕨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿砚亭为陈玉叔廷尉题","author":"周光镐","text":"佽飞拔剑心雄伟，直入深潭截龙尾。\n老骨年来化石嶙，西郊夜半啼山鬼。\n才子折冲尊俎旁，穷搜禹凿获琳琅。\n运斤雷电起倏忽，开函波浪摇洸洋。\n龙蟠凤翥风云变，艺苑词场共鏖战。\n定价无论十五城，著书已足三千卷。\n管城秃尽瘗山丘，墨子临岐泪不收。\n谁信石卿年已老，汉家仍拜寿亭侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日过玄武湖","author":"周光镐","text":"极目澄空际，天高水曲秋。\n残霞波上断，夕照雨中收。\n景以图书秘，天疑阆苑浮。\n何言羁物役，一似泛沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大梁道上 其一","author":"周光镐","text":"骋望中原路，逶迤入大梁。\n河堤垂绿树，节序度青阳。\n卫水浮烟暝，沙河落日黄。\n愁来看短铗，犹带蓟门霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大梁道上 其二","author":"周光镐","text":"晋魏开封地，工歌自古闻。\n雄图嗟已歇，淇水复何存。\n公子能倾士，蛾眉亦报恩。\n西风堪洒泪，若处吊夷门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渭阳马上对月","author":"周光镐","text":"马上三更月，边庭万里秋。\n清光悬渭曲，星露湿吴钩。\n风籁泉声细，天山夜火收。\n羁愁兼别思，此际转悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日閒居杂咏","author":"周光镐","text":"门径通原野，禾苗日长成。\n共欢新雨过，一望绿畴平。\n鼓吹田间部，笙簧谷口声。\n明农知不负，秋社足浮觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得徐给谏书却寄","author":"周光镐","text":"双鲤遥传采石书，南州丰度近何如。\n朱衣汉殿传封草，白苧江城问谪居。\n一出祇缘长孺戆，立谈谁道别生疏。\n赐环自是明朝事，未许灵山便结庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送荆考功视学滇南 其一","author":"周光镐","text":"十年华省叹淹留，一诏惊从万里游。\n拥节遥过荒徼地，传经犹是古梁州。\n天连越巂蛮烟晓，沼泛昆明汉水秋。\n莫问旧曹朋好在，山公谁复似风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送荆考功视学滇南 其二","author":"周光镐","text":"江干分手即河梁，驿路春风拥传长。\n考簿西京留启事，传经南服见文章。\n蛮天欲尽浮盘水，粤徼初分度夜郎。\n倘念含香同舍在，飞鸿应见几琳琅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉沙草堂","author":"周光镐","text":"一望平皋翠雨流，虚堂睥睨碧沙头。\n湘江兰芷明于玉，泽国楼台迥似秋。\n坐里芙蓉开列嶂，尊前瑶草散芳洲。\n玺书无奈频催起，猿鹤窥人怅别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百尺楼","author":"周光镐","text":"百尺楼高切太微，中藏万轴尽珠玑。\n自天题处龙章湿，奕世传来宝帙辉。\n影绕汉州波作练，光摇星斗玉为扉。\n于今竞说陈荀里，不数城南傍帝畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游万州岑公祠","author":"周光镐","text":"天开洞壑倚层湍，见说周人自考槃。\n瑶草岁深凝作石，流霞春暖液为丹。\n峰头鹤度三山渺，江上涛飞两月寒。\n碧海玄洲何可遇，白云空自长琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞练亭","author":"周光镐","text":"百丈飞泉下翠峦，孤亭爽气到凭栏。\n吹来半壁银河水，泻出长天碧海澜。\n五月炎蒸过鸟道，千山雾雨起龙蟠。\n玉毫曾入长生殿，此地虚疑近广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望锦屏山寄怀陈于韶参伯","author":"周光镐","text":"西望屏山翠几重，丈人遥在最高峰。\n玉台碧映云台月，剑阁青连锦阁松。\n绝顶振衣孤吹起，清秋染翰赤霞封。\n中原戎马频多事，此地如何稳卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出师南征渡泸河道经白马堡登晒经台","author":"周光镐","text":"九月严霜晓渡泸，征南十万握兵符。\n天垂竺国连真塞，檄过牂牁问笮都。\n象教西来传白马，狼烟秋净插雕弧。\n晒经台傍干戈地，消劫还凭佛力无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢参伯凤渚之滇藩","author":"周光镐","text":"才报羌戎息鼓鼙，又闻飞檄急朱提。\n蕃宣西去蛮烟净，剑戟回看雪岭低。\n番部但思蜀相国，偏裨还忆谢征西。\n点苍不让燕然石，一柱天南可并题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀","author":"周光镐","text":"灵关秋色白榆多，九月霜飞黑水河。\n天外雁鸿嗟阻滞，篱边松菊怨蹉跎。\n南来邛塞无烽燧，西报临洮走橐驼。\n此日三秦忧不细，禁中亲诏出廉颇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登贺兰山眺望夏元昊避暑宫在焉平虏城北则汉卫青大将台也","author":"周光镐","text":"贺兰千队驻征麾，山后山前毳幕移。\n列嶂厂天攒剑戟，重关画地守熊罴。\n夏王暑殿馀荒址，汉将高台接古陴。\n一自三城收戍卒，胡奴无复泣燕支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送春","author":"周光镐","text":"落红飞絮半沾泥，别意年年客里题。\n欲唱渭城江雨暮，阳关只在秣陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅边报偶成","author":"周光镐","text":"河阳老将惯登坛，见说天山战垒残。\n六郡于今年少在，谁将尺组系呼韩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祖洲歌为沈令公题兼送上觐","author":"周光镐","text":"浮空海岛隔尘寰，岛上真人握大还。\n夜半天鸡鸣日出，遥闻金佩晓珊珊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思 其一","author":"周光镐","text":"芳园草树郁芊绵，雨过千峰紫翠悬。\n春事祇今看又半，风光莫惜杖头钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思 其二","author":"周光镐","text":"雨霁长江曳练明，烟云岛树暮天横。\n不堪引领孤鸿断，愁听笙簧谷口声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思 其三","author":"周光镐","text":"群花眼底剧离披，绿叶朝来密作帷。\n惆怅一春同调远，楚骚长自怨江篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过武昌阻雪仲和王孙邀登黄鹤楼","author":"周光镐","text":"洞庭东下楚天浮，挂席西过黄鹤楼。\n千载白云寒冉冉，一江巴水碧悠悠。\n波摇鹦鹉洲前月，霜落芙蓉镜里秋。\n何事王孙邀授简，不堪乘兴雪中舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒武侯祠","author":"周光镐","text":"锦江十里锦城东，丞相祠堂暮霭中。\n鱼水君臣看定鼎，龙蛇风雨走虚宫。\n参天老柏巢双鹤，落日长桥饮断虹。\n一自杜陵题洒后，直令千载泣英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪山歌","author":"周光镐","text":"雪山西来，横亘天南几千里。\n排云划雾，直控穹窿而特起。\n金沙西流赤日晖，山中之雪常齿齿。\n忆昔提兵九月秋，雪风泠泠洞壑幽。\n今来筑垒当长夏，旧雪崚嶒新雪下。\n朝看剑锷倚青苍，暮落芙蓉片片霜。\n疑是昆仑浮玉海，直愁花雨下天荒。\n昨夜营头风瑟瑟，晓起嶙峋散空碧。\n三军寒色满弓韬，大将霜威攒列戟。\n虎牙门傍雪山低，越?之水背城飞。\n羽檄遥来邛塞北，旌旗直度索撞西。\n百折千盘冰路滑，崖崩石碎马蹄脱。\n偏裨握槊惨不骄，壮士定力冻欲缺。\n阴风杀气连宵起，山后山前半营垒。\n九姓青羌随汉麾，六州番部俱南徙。\n山头有海云是蛟龙宫，千寻百尺神物潜其中。\n伐鼓㧿金蛟子怒，飘风吹雹飞晴空。\n当年汉帝思汗血，西极流沙通使节。\n昆明渥水产神驹，苜蓿蒲梢归汉阙。\n于今有道服群夷，不是唐蒙建节时。\n我欲扫尽雪山砻片石，勒铭永照西南陲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赴蜀闱途次杂咏","author":"周光镐","text":"漠漠川原路，村村杜曲边。\n真看陆似海，不断水平田。\n杼轴西人赋，笙歌蜀国弦。\n当垆有少妇，惯数卖浆钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浣花溪草堂","author":"周光镐","text":"杜陵亭子浣花浔，秋色云光净远林。\n傍水芙蓉朝烂漫，缘江桤树暮萧森。\n长留天地惊人语，不尽艰危恋主心。\n自古更谁推大雅，流风逸韵到于今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙门寺次韵","author":"周光镐","text":"东望龙门入紫烟，江行十里到诸天。\n长林暑尽松风细，匹红晴飞汉水悬。\n一叩法宫心自远，况逢珠树月初圆。\n宰官现出僧休讶，不为笙歌载酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日玉峡江观竞渡 其一","author":"周光镐","text":"午日沧江白浪堆，龙舟峡口斗喧豗。\n人间胜负寻常事，独揽纶竿坐钓台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日玉峡江观竞渡 其二","author":"周光镐","text":"霏霏炎雨落晴空，峡底洪涛挂玉虹。\n鳞甲满江看竞渡，夺标眼底定谁雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵济宫落成","author":"周光镐","text":"宝箓元传大洞君，仙踪遥遍海东濆。\n曾闻石室飞丹日，又见新宫结綵云。\n紫盖翠幢看缥缈，椒浆兰醑飨絪缊。\n巫咸为报元都使，消祲无忘父老勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]