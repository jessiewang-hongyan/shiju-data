[{"title":"甲辰元夕","author":"朱诚泳","text":"今夕复何夕，蟾光喜未阴。\n笙歌嫌漏促，灯火觉更深。\n人事如朝暮，年华自古今。\n细翻新乐府，转调入沈吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日即事","author":"朱诚泳","text":"水净鹭拳沙，天空鹜带霞。\n数声楼外雁，几点树头鸦。\n露冷枫飘叶，霜轻菊吐花。\n独怜关外戍，乡思动胡笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题永寿王寿萱手卷","author":"朱诚泳","text":"谁把宜男草，移来种北堂。\n露滋鹄觜润，风袅凤翎长。\n子爱颜偏好，母看忧自忘。\n寿筵开此日，香溢紫霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹亭偶成","author":"朱诚泳","text":"自笑耽幽僻，能忘对此君。\n绿云环冉冉，苍雪落纷纷。\n晚节经霜见，秋声入夜闻。\n渭川湘水趣，未许俗人分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"瑞香次韵","author":"朱诚泳","text":"异种产南方，移来道路长。\n牡丹空国色，桂子自天香。\n雅有清癯意，浓无滑腻妆。\n岁寒怜尔在，高出压群芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有怀王尚文少参","author":"朱诚泳","text":"目断江东路，怀人独倚楼。\n蝉鸣黄叶晚，雁度碧云秋。\n诗酒添新况，园池感旧游。\n何时复相见，谈笑更绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居漫兴 其一","author":"朱诚泳","text":"藩邸多清暇，閒居爱日长。\n疏帘晴霭散，小殿午风凉。\n叠石诗中画，分泉静里忙。\n伊人有高致，宁惜共徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居漫兴 其二","author":"朱诚泳","text":"古鼎袅馀薰，空庭绝点尘。\n花香风外细，树色雨中新。\n瀹茗延醒客，裁诗寄远人。\n最便閒乐处，吾欲养吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏多雨","author":"朱诚泳","text":"时光临季夏，终日苦滂沱。\n曲径深苍藓，方塘涨碧波。\n炎威侵幌少，寒气袭人多。\n为问调元手，阴阳理若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题公子游春卷","author":"朱诚泳","text":"玉勒鞚青骢，寻春上苑东。\n绮罗明晓日，弦管沸春风。\n杨柳摇杯绿，桃花夹座红。\n鸟惊金弹落，归路夕阳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐有怀郑司寇时良 其一","author":"朱诚泳","text":"青灯孤坐久，百感雨中生。\n驻目关山隔，惊心岁月更。\n寒蛩鸣四壁，征雁度重城。\n歌罢停云句，寥寥梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51365,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐有怀郑司寇时良 其二","author":"朱诚泳","text":"湖海论心少，惟君最我知。\n几年成旷别，千里动遐思。\n细雨灯残夜，寒风叶落时。\n天涯云树隔，会晤杳难期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51366,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酒家","author":"朱诚泳","text":"香篘闻十里，人指画桥东。\n紫瓮盛秋露，青帘飐晓风。\n曲尘飞柳外，檀板响楼中。\n社鼓枫林急，村村卧醉翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51367,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔家","author":"朱诚泳","text":"烟波为活计，结屋近沧浪。\n地接黄芦岸，村开绿柳庄。\n轻蓑冲细雨，小艇系斜阳。\n斫鲙茅檐下，呼儿煮酒尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51368,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夕次韵","author":"朱诚泳","text":"蟾窟当空满，鳌山动地来。\n六街香雾合，万井户扃开。\n烟火藏机弄，灯词作谜猜。\n红妆人结伴，杳杳下楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51369,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦寒","author":"朱诚泳","text":"万象冰壶里，同云满太空。\n闭门三日雪，刮面五更风。\n羸马卧僵殍，冻鸱蹲老翁。\n铁衣犹塞外，忍对地炉红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51370,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水阁","author":"朱诚泳","text":"数椽依曲沼，高兴寓沧浪。\n鸥鹭随波戏，菰蒲近岸香。\n开窗山雨润，入坐水风凉。\n应笑长洲苑，尘迷响屧廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51371,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"烟","author":"朱诚泳","text":"似雾纷还郁，如尘散复迷。\n斜阳芳草渡，细雨绿莎堤。\n入坞笼花放，沿山瘴鸟啼。\n何时天禄阁，照坐出青藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51372,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"华山","author":"朱诚泳","text":"百里盘根远，孤高倚太空。\n云开仙掌日，鸟度石莲风。\n磅礴含元气，薰蒸妙化功。\n终南与太白，未许并争雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51373,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春雪","author":"朱诚泳","text":"入臈宜三白，春风底用赊。\n漫空欺柳絮，著树失梨花。\n顷刻成行潦，微茫没浅沙。\n眼前应有象，人事尽浮华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51374,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晴望","author":"朱诚泳","text":"浓云归远岫，霁色满层空。\n烟抹楼台碧，霞蒸草树红。\n终南随鹘没，直北隐鸿蒙。\n坐久疏帘静，凉生绿树风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51375,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"先天观","author":"朱诚泳","text":"路入无尘境，琳宫日月长。\n紫芝生白石，绿竹荫丹房。\n晓日鸾声哕，秋风鹤梦凉。\n先天参透处，斟水醮虚皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51376,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"故宫","author":"朱诚泳","text":"前代豪华地，烟尘一梦空。\n燕归宫树老，鹿去苑花红。\n辇路埋秋藓，歌楼散晓风。\n御沟犹涨腻，流出恨无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51377,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云","author":"朱诚泳","text":"肤寸起遥岑，晴空忽作阴。\n卷舒空有态，聚散本无心。\n伴鹤閒栖树，从龙惯作霖。\n蓬莱常五色，应护斗间深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪居","author":"朱诚泳","text":"南市津相近，柴门日系船。\n晓峰明似画，春水远如天。\n鹅鸭应常数，凫鹥秪自怜。\n夜来风雨恶，龙过屋山颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜","author":"朱诚泳","text":"赤日当空下，轻飙送晚凉。\n鬅鬙便露坐，沆瀣足天浆。\n扇扑流萤乱，帘浮睡鸭香。\n炎熇尚烦郁，苦乐未能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆池","author":"朱诚泳","text":"凿破庭前地，光含鉴影多。\n雨馀添小涨，风急动微波。\n冷浸一拳石，平铺数点荷。\n儿嬉同泖曲，吾亦放吾歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花影","author":"朱诚泳","text":"重重还叠叠，万卉任荣枯。\n日月照来有，亭台阴处无。\n丹青谁着笔，水墨自成图。\n只恐风撩乱，残花委地铺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过山家","author":"朱诚泳","text":"岩壑结芳邻，衡茅远俗纷。\n林深迟见日，石乱自生云。\n树影当窗翳，泉声入座闻。\n幽居同木石，鹿豕更成群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过田家","author":"朱诚泳","text":"结庐依畎亩，耕作足生涯。\n门巷閒眠犊，池塘乱叫蛙。\n园收新芋栗，墙荫旧桑麻。\n岁晚村翁会，比邻酒任赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹风","author":"朱诚泳","text":"拂拂起林梢，扶疏影动摇。\n湘娥鸣玉佩，秦女弄琼箫。\n锦箨飘香粉，青鸾舞翠翘。\n王猷当此际，尘虑定应消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绿筠轩","author":"朱诚泳","text":"一区幽寂地，寒绿万竿馀。\n秀色当窗见，凉阴入座虚。\n风帘声簌簌，雨榻梦蘧蘧。\n比管还吹凤，翩翩上玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟早起","author":"朱诚泳","text":"一枕梦魂清，披衣出户庭。\n楼头低兔魄，屋角乱鸡声。\n入市人稀到，开关戍未行。\n东方看渐白，隐隐海霞明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"惜花","author":"朱诚泳","text":"一年春正好，莫放小车空。\n绣幄笼晴日，雕阑怯晓风。\n未能辞眼底，可忍污泥中。\n百匝千回看，巡檐骇落红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晴","author":"朱诚泳","text":"长空新雨过，正及艳阳时。\n淡淡东风软，融融丽日迟。\n迷漫飞落絮，摇曳堕游丝。\n紫陌寻芳遍，莺花处处宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"假山","author":"朱诚泳","text":"凿破终南骨，移来置广庭。\n巉岩从地立，峭拔类天成。\n秀色凌苍霭，晴岚湿翠屏。\n道人幽兴远，相对每忘情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋雨","author":"朱诚泳","text":"西风吹淅沥，檐溜响浪浪。\n废沼添寒绿，疏林落萎黄。\n天边迷去雁，阶下乱啼螀。\n滴碎羁人梦，音书滞一乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经横渠镇废寺","author":"朱诚泳","text":"瞻彼空王宅，依稀旧迹存。\n雨馀苔满壁，风搅叶堆门。\n石鼎香烟断，崖碑字刻昏。\n异僧回月下，扫石忆精魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题荐福寺塔","author":"朱诚泳","text":"浮图逾百尺，突兀倚层空。\n人语半天上，鸟飞平地中。\n宝轮朝炫日，金铎夜鸣风。\n极目乾坤远，川流尽向东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51393,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"道傍废宅","author":"朱诚泳","text":"衡门终日掩，不见主人归。\n春到花空放，年深草自肥。\n颓垣多鼠穴，古砌上苔衣。\n独有梁间燕，双双似旧飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51394,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋风","author":"朱诚泳","text":"蘋末萧萧起，编茅尚几家。\n井寒梧叶堕，圃老菊香赊。\n阶下蛩声切，天边雁影斜。\n晓来青镜里，吹鬓落霜花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51395,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏春","author":"朱诚泳","text":"春光明远近，红紫正芳妍。\n野外张帷幄，风前沸管弦。\n绮罗人拾翠，騕袅客停鞯。\n落日城南路，香尘障瞑烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51396,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题山寺亭壁","author":"朱诚泳","text":"面面峰峦秀，开窗景绝幽。\n岚光檐外滴，花气座间浮。\n野鹤依云宿，山泉带雨流。\n禅心忘世虑，终日自悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51397,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"延春亭","author":"朱诚泳","text":"绕檐皆竹木，春事此中多。\n啼鸟将弦管，繁花簇绮罗。\n蝶穿红锦幛，人在翠云窝。\n若个长延得，何烦载酒过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51398,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿山寺","author":"朱诚泳","text":"胜游心未竟，日暮泊禅房。\n月转回廊白，风清法界香。\n问僧嫌偈短，听漏厌更长。\n树杪天鸡舞，钟声起上方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春寒","author":"朱诚泳","text":"浓云朝结暝，倏忽蔽层空。\n点点廉纤雨，番番料峭风。\n柳眉颦嫩绿，花脸黯轻红。\n无限融和趣，都归冷淡中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早行","author":"朱诚泳","text":"肃肃倦宵征，晨兴促驿程。\n软风随去马，残月照行旌。\n野店鸡三唱，谯楼漏五更。\n车徒经数里，河汉尚纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白牡丹","author":"朱诚泳","text":"洗却红妆面，天然粉态真。\n花王冰作骨，姑射水为神。\n缟袂迎风暖，琼杯捧露新。\n东皇嫌冶丽，别幻一般春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日久阴","author":"朱诚泳","text":"二月春如海，长空未放晴。\n林花羞褪色，山鸟噤无声。\n薄雾寒笼树，浓云重压城。\n寻芳空有约，风景太无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月蚀","author":"朱诚泳","text":"万里冰轮满，阴氛蓦地加。\n青铜微有晕，白玉渐生瑕。\n望汉群心竦，量天几秒遮。\n凭谁操白刃，为我斩妖蟆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风","author":"朱诚泳","text":"囊口徐徐起，号呼万窍通。\n秋林添病绿，春苑堕惊红。\n吹雨荒陂外，翻涛大海中。\n杜陵茅屋破，飘转瀼西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"温泉","author":"朱诚泳","text":"坎德乘阴火，灵源一气真。\n玉壶冰瑩洁，岩窦雪嶙峋。\n汩汩浑非潦，溶溶暖似春。\n衣成单祫制，来学浴沂人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事","author":"朱诚泳","text":"轩扉闲白日，槐柳荫清渠。\n阶下千竿竹，床头万卷书。\n草香薰蛱蝶，水暖养芙蕖。\n对景情无限，清吟兴有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋","author":"朱诚泳","text":"今夕为何夕，平分一半秋。\n月明梧影乱，风细桂香浮。\n碧落茫无际，银河烂不收。\n凭谁招庾亮，携酒共登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居即事","author":"朱诚泳","text":"地僻尘纷静，重门昼不开。\n虚庭团竹树，曲径换莓苔。\n阶下无人过，窗前有鹤来。\n自焚香炷坐，吟赏谩徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海棠花","author":"朱诚泳","text":"空谷有佳人，天然态度真。\n杨妃春睡足，西子晓妆匀。\n露浥胭脂湿，风飘绮縠新。\n汉宫遗恨在，应复怨花神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹","author":"朱诚泳","text":"新曲传供奉，名花擅洛阳。\n风神应国色，标格自天香。\n百草皆为隶，孤丛特拟王。\n沈香亭在否，今古笑三郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日牡丹","author":"朱诚泳","text":"万木皆萧索，何缘有此风。\n飘香同桂子，敛色陋芙蓉。\n露冷春容在，霜清晓睡浓。\n悲秋嘲可解，莫妒宋词工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日牡丹","author":"朱诚泳","text":"众芳摇落后，雪里见春红。\n煖律回寒律，东风占北风。\n林空香作阵，叶落锦成丛。\n拟与梅花匹，都忘富贵中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杜鹃花","author":"朱诚泳","text":"东风啼蜀魄，血泪染花深。\n带雨眉犹蹙，迎风力未禁。\n飘零今日怨，忘化昔年心。\n万里无兵火，根应返鹤林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"葵花","author":"朱诚泳","text":"花开如木槿，照水更依墙。\n淡白偎深紫，轻红间浅黄。\n倾心臣职分，注意道家装。\n肯被铅华涴，随风近紫阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水仙花","author":"朱诚泳","text":"仙娥游水府，肌骨是耶非。\n解佩逢交甫，凌波讶宓妃。\n清风常洒洒，香雪自霏霏。\n不作人间梦，湘魂一片飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏晓","author":"朱诚泳","text":"骄阳将出海，斜月淡无光。\n槛竹摇风细，池荷浥露香。\n辘轳鸣曙井，褦襶促晨装。\n徙卧南荣下，居然枕簟凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"昼寝","author":"朱诚泳","text":"一枕竹方床，蘧蘧午梦长。\n黑甜聊自足，清苦为谁忙。\n石晷移时刻，金炉冷篆香。\n黄粱犹未熟，人事几兴亡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春雨","author":"朱诚泳","text":"雨丝池水上，云片屋山东。\n沥沥檐花落，盈盈地脉通。\n摇村江柳绿，照槛苑桃红。\n入夜蛙声急，田家报岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟元日立春","author":"朱诚泳","text":"甲子开元旦，春深转斗魁。\n初筵浮柏叶，急琯动葭灰。\n宇宙真阳始，山川淑气回。\n青丝兼綵胜，节物自相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送春","author":"朱诚泳","text":"青帝收春律，中宵法驾旋。\n暖风芳草渡，细雨落花天。\n深树迷蝴蝶，空山叫杜鹃。\n一樽从此别，相见动经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春宵","author":"朱诚泳","text":"宫壶传漏刻，刻刻价非轻。\n杨柳风初软，梨花月正明。\n秋千微有影，檀板寂无声。\n怪底长门内，通宵梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"村行书事","author":"朱诚泳","text":"结屋临流水，柴门薜荔墙。\n四山松叶碧，一径菜花黄。\n草软牛羊卧，炊新麦豆香。\n邻翁閒聚处，浊酒话农桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"听康都阃弹琴","author":"朱诚泳","text":"金炉香篆袅，玉轸韵铿然。\n玄酒真无味，清商不在弦。\n带霜鸣候雁，和月泻寒泉。\n一曲猗兰古，将军妙莫传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邓二南还","author":"朱诚泳","text":"西来情款款，南去计匆匆。\n走马辞关右，看山过洛中。\n江湖千里隔，池馆几时同。\n亲旧风流少，长歌渭水东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"始与晋卿先生茶话","author":"朱诚泳","text":"千里神交久，新来始识荆。\n关山多宦迹，湖海重诗名。\n瑞世祥麟出，朝阳彩凤鸣。\n外台知暂驻，双佩早朝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]