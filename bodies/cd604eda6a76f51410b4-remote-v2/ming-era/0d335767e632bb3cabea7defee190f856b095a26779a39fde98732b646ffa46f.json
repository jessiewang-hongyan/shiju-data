[{"title":"滹沱冰合图","author":"张宁","text":"人心久思汉，帝主自有真。\n多难启弘业，独此邯郸人。\n穷蹙白登围，仓猝滹沱水。\n河冰纵不合，光武亦不死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苍松轩","author":"张宁","text":"种竹绕轩居，清素聊自爱。\n虽无桃李颜，不改冰霰态。\n孤松色不殊，六月寒尚在。\n倏然三径幽，凝碧如有待。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为姚公绶题丹丘","author":"张宁","text":"东方有奇士，自号丹丘生。\n超世立于独，宛若来蓬瀛。\n言从黄石公，再从赤松子。\n终始意斯在，幻境焉足跂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"友兰","author":"张宁","text":"公门盛桃李，世路多荆榛。\n温温爱兰交，吾思见其人。\n伊人日已远，比物不盈畹。\n同心澹忘言，岁月殊可晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅古春寿藏诗","author":"张宁","text":"郁郁凤凰山，生气何连延。\n有美清修士，遗世希神仙。\n高情出茫昧，独见超虚玄。\n仰瞻山木花，俯视重冈旋。\n凿石启幽閟，种槚待芳妍。\n夙怀瑕丘乐，预见佳城悬。\n聚散本元造，寿夭谁能专。\n桥山有高冢，王乔亦遗阡。\n乘鸾与跨凤，刀圭终弃埙。\n何如一生死，坦率穷高年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武澄梦萱卷","author":"张宁","text":"母在萱自好，母亡萱尚存。\n萧疏北堂下，花叶空晨昏。\n盈盈眼中泪，默默心上酸。\n眼泪犹可拭，心酸伤肺肝。\n安得百丈根，沿情及幽原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怡菊周德辉卷","author":"张宁","text":"严君去云久，手植已成荒。\n促戚远行归，顾眄心徬徨。\n言薙蔓草芜，再汲清池潢。\n玄功不遐弃，时及仍芬芳。\n故物幸兹在，慰悦如有将。\n见此聊相慰，笑舞襕斑裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画舫清游","author":"张宁","text":"摇摇书画船，渺渺三江水。\n朝披越㠐云，暮听吴门雨。\n高深洞玄黄，招邀尽青紫。\n所愧子长游，吾行未能止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其一","author":"张宁","text":"何人涉江采，得此霜前芳。\n花残见晚色，叶净流潭光。\n长路远莫致，故意不可忘。\n欲辍畹中蕙，共佩罗衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二","author":"张宁","text":"南山有佳色，束篱阒无人。\n朝为头上花，暮作车下尘。\n谁与念恒节，培溉当良辰。\n落落竟何语，把玩聊相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三","author":"张宁","text":"翛翛苦竹枝，岁晏未凋谢。\n络纬绕其颠，促织鸣其下。\n秋声入荒林，寒气逗虚榭。\n何人赋无衣，悽恻坐长夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其四","author":"张宁","text":"漏石倚空苍，弱草飏残碧。\n眷彼飞来双，栩栩飘复集。\n鸿鹄志万里，松柏挺千尺。\n洪纤各有定，非分焉所得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其五","author":"张宁","text":"么红雨馀葩，疏绿风中筱。\n虽无尤物丽，得借此君好。\n栽培良有待，开落恒可保。\n嗟彼桃李花，采折随媚草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其六","author":"张宁","text":"形色已葳垂，风神未萧瑟。\n所愧落英空，还思旧根发。\n时来已若兹，岁去犹尔若。\n殊胜汎相逢，随人满头插。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其七","author":"张宁","text":"茵蔯欲成蒿，蘼芜亦云谢。\n水涨污耶深，时蛰看已化。\n纤腰尚蜿蜒，弱翅举复下。\n婉转如有情，追逐不能罢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7107,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其八","author":"张宁","text":"暑雨滋宿蘖，五月南风生。\n时当长养节，奋臂将谁撄。\n奔辙岂足当，黄雀方营营。\n幽居事玄穆，相对悲群情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7108,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其九","author":"张宁","text":"尘境何扰扰，草野何茫茫。\n清泉白石处，几许堪徜徉。\n兰荃既荣秀，蒿莸绝交相。\n宜人不在多，百亩空芜荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7109,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十","author":"张宁","text":"今日胡不怡，过眼青春空。\n纷纷萧艾中，见此万绿红。\n蜻蜓从何来，当午停芳丛。\n物情谅有得，吾意亦从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7110,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十一","author":"张宁","text":"飞蛾值芳时，飘舞来复去。\n因风快循绕，逢花亦延伫。\n虽临扑逐威，不解摧掠虑。\n人意久安閒，相忘不知处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7111,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十二","author":"张宁","text":"尺蠖已辞茧，橘虫方化生。\n夭夭隰上枝，碧绿纷敷荣。\n覆载大有造，动植各相成。\n天机一流动，幽思穆无声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7112,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十三","author":"张宁","text":"趯趯草间虫，芃芃石边蔓。\n跳跃烟冥霏，飘飖翠云乱。\n时当绮窗纱，或近青玉案。\n卑微宁足论，寂阒聊一眄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7113,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十四","author":"张宁","text":"野草绿满地，无名自纤妍。\n不采亦不夭，幽与閒相便。\n光风濯灵雨，蛱蝶来翩跹。\n咄彼周昉图，百态空骚然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7114,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十五","author":"张宁","text":"晚家南山陲，独卧西涧草。\n牛羊所不践，樵伐非故道。\n叶落秋蛾稀，苔滋候虫少。\n烟消夕阳下，林薄淡如扫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7115,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十六","author":"张宁","text":"蜻蜓多品类，此种最灵黠。\n翅翕尾低垂，暂息即飞越。\n颇忆童稚年，扑捉伤暑热。\n至今图画间，隐手欲轻蹑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7116,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十七","author":"张宁","text":"清霜萎茂草，天以虫鸣秋。\n股动羽亦振，随处声啾啾。\n书斋闭疏雨，木落青灯幽。\n掩卷不成诵，感物令心愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7117,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十八","author":"张宁","text":"草振蝶双飞，蝶下草交动。\n无情如有情，形势偶相閧。\n貌与心不亲，情好久焉用。\n悠悠笑相逢，栩栩庄叟梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7118,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其十九","author":"张宁","text":"露白水花红，江空草烟暝。\n閒鸥忽惊去，见此孤蚱蜢。\n吐沫禁无声，卑飞水中影。\n虫沙与猿鹤，由来未深省。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7119,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十","author":"张宁","text":"飞行罕同俦，性质好幽处。\n点水缓捎花，乘风暂停午。\n疑回睛屡移，敛息翅频举。\n慎尔遇贪夫，求珠瘗当户。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7120,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十一","author":"张宁","text":"短翅不高飞，长踦不善走。\n跳踉并蟏螽，局缩居泽薮。\n三孱不满隅，匹处竟无偶。\n彼亦何人斯，蠢尔亦可丑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7121,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十二","author":"张宁","text":"园蔬叶垂尽，练裙弊无馀。\n轻扬两飘翅，清嗅双长须。\n本质夙如此，变不忘其初。\n襕斑五色文，支离守荒芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7122,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十三","author":"张宁","text":"淅沥蒹葭雨，依微杨柳烟。\n翅薄轻纱过，晴隐硝珠圆。\n宁当狎雌絷，莫受蛛丝缠。\n与物本无患，陈生有遗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7123,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十四","author":"张宁","text":"阴阴莞柳树，嘒嘒孤鸣蜩。\n惊风飒吹撼，奋翅飞迁乔。\n托体虽得所，防患亦须周。\n吟风饮清露，此道终逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7124,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十五","author":"张宁","text":"文蛾好明死，乌鲗以蔽彰。\n争如草上飞，无用亦无防。\n渴饮零露华，逝借晨风扬。\n何如蜉蝣群，朝生夕云亡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7125,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十六","author":"张宁","text":"春林盛朝爽，秋圃有暮色。\n萧疏丛薄中，缘沿何役役。\n凤鸟不时见，良骥须远历。\n斑斑被体文，甘老榛莽泽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7126,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十七","author":"张宁","text":"苍茫青草池，霢霂黄梅雨。\n清冷脱洿下，润泽非斥卤。\n鸣声慎烦聒，跳跃宜审处。\n临深纵无危，坐井非善举。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7127,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十八","author":"张宁","text":"去彼蜣螂秽，超居风露清。\n蜕囊半未脱，健臂已前撑。\n潜蛟起泥滓，厉璞登琼英。\n大小分已定，变化同其情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7128,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其二十九","author":"张宁","text":"蟋蟀已在堂，鼠妇已在室。\n凉风蕙草时，胡见幽阴物。\n仓皇若无依，短褐露肘膝。\n天荒岁年暮，感此三叹息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7129,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十","author":"张宁","text":"露滴葡萄寒，宵鸣一何急。\n鸡啼天欲曙，络纬不盈尺。\n深闺有思妇，远道多倦客。\n惊闻长夜声，掩泪心促刺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7130,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十一","author":"张宁","text":"景物此何处，野塘秋色中。\n山花惊暮雨，芦叶抱寒虫。\n旷望知谁到，幽居重此逢。\n怀人不可见，双鬓感飞蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7131,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十二","author":"张宁","text":"金谷多奇花，蝶满谢即去。\n荒园久空疏，蜂蝶亦安素。\n迟回杞菊秋，栖息松桂暮。\n所以君子交，清澹只如故。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7132,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十三","author":"张宁","text":"原野多蔓草，墟泽饶鱼虫。\n一枝与一体，入笔殊元踪。\n生憎红紫态，未觉丹青工。\n坐我林塘下，衣袂生华风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7133,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十四","author":"张宁","text":"风高芦叶残，赢露失其翳。\n鸣蜩已绝响，犹奋双斧臂。\n犹豫多积疑，蜂虿无却虑。\n君子尚勇决，成败焉足计。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7134,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十五","author":"张宁","text":"飞来锦纹蝶，采翅何翩翩。\n山花吐碧蕊，相映亦相妍。\n动植互生化，寒暑频推迁。\n生绡有遗迹，日日当吾前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7135,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十六","author":"张宁","text":"蝶有恋花情，花无留蝶意。\n东风三月时，总为春流丽。\n还开亦还落，欲去还不去。\n默诵过墙诗，重门草深处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7136,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十七","author":"张宁","text":"意会自成趣，景触良宜时。\n过影如见人，飞音若我遗。\n荒閒寂寞滨，独悟胜群思。\n此兴复不浅，名物空何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7137,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十八","author":"张宁","text":"尔雅列名称，埤雅伸疏义。\n恢恢造化功，独此亦难备。\n况当画史传，舐墨随手至。\n骊黄牝牡间，不必问形似。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7138,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其三十九","author":"张宁","text":"动听非谇语，适目无妖妍。\n诗求句律外，画索丹青前。\n尺素竟何物，居然得天全。\n相彼能事者，殆欲忘朱铅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7139,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其四十","author":"张宁","text":"乐水不论船，乐山不问树。\n不求画中物，惟耽画中趣。\n想当含毫时，粉墨不待具。\n眼光落缣素，但觉风雨至。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7140,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其四十一","author":"张宁","text":"滕王去云远，谢逸今何之。\n形迷有声画，影落无声诗。\n低回罗扇风，旋绕簪花枝。\n转眼忽不见，芹香满清池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7141,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草虫杂图四十二首为伍佥宪题 其四十二","author":"张宁","text":"形色既有托，音声寂无闻。\n乍出草莽中，昂藏若离群。\n涵濡竹露华，饱挹山花薰。\n时哉忽如许，彼美空云云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7142,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈启南云山图","author":"张宁","text":"晨兴具壶榼，言往山中游。\n倚棹陟崇冈，舒眺写我忧。\n阴云翳四垂，举目迷岩丘。\n人生百年事，行止天为谋。\n欢荣间悲辱，强半成淹留。\n眷兹山水怀，所遇亦已酬。\n自从混沌凿，土石穷雕锼。\n镌坚伐危厉，辇筑连洼湫。\n幸此玄黄间，元气常通流。\n时当巧丽馀，忽与鸿蒙游。\n行看晦暝甚，转觉巉岩幽。\n情景两相化，风雨飘虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7143,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴德翼永思诗","author":"张宁","text":"夭夭岩下椿，嫩发方自好。\n终风激零雹，凋拉何太蚤。\n伤哉三尺孤，形影为枯槁。\n虚室若悬磬，遗业忽如扫。\n遑遑二十年，赖此王父考。\n昔如风中蓬，零落随野草。\n今如辕下车，奋脱即远道。\n登堂泣孤帏，陟岵见归鸟。\n荣枯不相代，忧伤已终老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7144,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送欧员外","author":"张宁","text":"蓟城有名士，美盛元无前。\n手抉云汉华，身交文锦妍。\n目烂明月珠，口涌悬河泉。\n幽思入玄默，清臭纷兰荃。\n初辞鹿鸣宴，再坐琼林筵。\n朝主地官事，暮副郎中权。\n骐骥志万里，鸿鹄怀高骞。\n良金与美玉，适用无停延。\n遥遥吴越乡，雨涝如尧年。\n雍雍少司徒，王命来旬宣。\n行哉自求辅，得此堂中贤。\n六属倡九牧，一士当三千。\n蒙冲籍篙楫，禆曲严中坚。\n激扬水趋壑，鼓振雷行天。\n钧衡赖持举，皇度资纯全。\n遂令泥滓民，复业膏腴田。\n一朝十二解，芒锐犹森然。\n裴向多谏议，之问馀诗篇。\n时登两峰月，暂汲西湖烟。\n双旌即归路，一束携行编。\n加餐赤日饭，稳著青云鞭。\n行舟如有问，干事江南旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7145,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为胡文晖题幽篁石菊图","author":"张宁","text":"故人归田园，几许见秋节。\n修篁荫中林，时菊丛以发。\n冉冉烟中花，萧萧石边叶。\n秀色如可餐，幽馨寒不绝。\n时有素心人，同来醉明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7146,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"何都宪一乐堂","author":"张宁","text":"椿萱茂迟秀，棠棣偕春芳。\n煌煌锦绣衣，烨烨斑斓裳。\n恩封日以至，甘旨日以将。\n齐眉粹荣养，竞爽时行藏。\n载歌蓼莪咏，载诵鸰原章。\n前修有遐感，而我承馀康。\n欣抃不能已，万事真相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7147,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丛蕙图","author":"张宁","text":"二月忽已迈，庶草三春时。\n九畹有馀秀，百亩多芳蕤。\n光风转幽馥，湛露增华滋。\n筼筜拂琨璞，揭车被留夷。\n朋从汇如故，气质相交䕻。\n手抚宣尼琴，再诵骚人词。\n时哉未终老，荪芷来何迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7148,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凝香阁画菊","author":"张宁","text":"幽斋绝秾纷，时菊閒以洁。\n少好淡春芳，敷荣及秋节。\n髧鬈宁尔妆，袪袂无所撷。\n枯索绕残枝，天寒满庭月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7149,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清燕室画菊","author":"张宁","text":"佳节良易迈，贞姿益清芳。\n根依昆玉固，色并淇筠苍。\n终忘白衣酒，特立金娥霜。\n幽馨不出户，憔悴含馀香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7150,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"一山为沈兑秀才题","author":"张宁","text":"人言一拳石，积累成丰隆。\n为山将九仞，篑缺亏前功。\n巍巍圣与贤，养正由童蒙。\n登泰小天下，卓立超群峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7151,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和陈宪副扫墓诗","author":"张宁","text":"游宦日已久，先陇多违离。\n寥寥古东门，值此洪流时。\n颓垣走狐兔，宰木寒无枝。\n及目心隐只，俯仰泪交颐。\n野祭已非古，况复无恒期。\n恩封夙有泽，贫丧空无施。\n徬徨不能返，日落凄风悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7152,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南山荣寿诗寿杨方伯父怡梅翁","author":"张宁","text":"维南有崇山，盘亘自终古。\n高当翼轸间，广与衡岳旅。\n中有千岁梅，生长元得所。\n英华彻寰区，贞素贯寒暑。\n开花玉香丛，结子金色颗。\n德馨椒桂俦，滋味鼎鼐主。\n繁葩尽芬馥，再实愈清楚。\n荣封异秦松，拔萃超庾土。\n上与山同跻，下与地常处。\n蟠桃与庄椿，千岁可能数。\n焉知世奇树，亿祀老玄圃。\n卓哉同春翁，怡怡并遐祜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7153,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月二日西湖再汛四首 其一","author":"张宁","text":"春去才一日，天宇寻清和。\n湖草犹碧色，湖水馀澄波。\n安能对佳山，不饮空嵯峨。\n邻船留宿欢，皓齿发清歌。\n推窗动孤笑，吾意其蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7154,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月二日西湖再汛四首 其二","author":"张宁","text":"沿舟望湖亭，蹑屐栖霞岭。\n孤山久寂寥，荒冢郁清迥。\n渚蘋清不香，湖水浑未瑩。\n悠悠登荐心，长叹逐游泳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7155,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]