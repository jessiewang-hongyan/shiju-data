[{"title":"答潘都谏郊坛见遗之作","author":"何景明","text":"羽卫天行路，龙帷御宿亭。\n壁坛流霁月，银阙动春星。\n谏猎心空赤，逢时鬓尚青。\n极知陪从地，瞻切五云停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殿试宿礼部张子淳郎中署奉和马张二光禄乔直阁诸公","author":"何景明","text":"东殿春朝晚，南宫夜宿深。\n锁闱犹月色，开閤更松阴。\n地迥神仙接，天高象纬临。\n诸君清庙作，三叹有馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得顾华玉全州书兼知望之消息","author":"何景明","text":"地北怜为别，天南真可哀。\n同时万里去，隔岁一书来。\n水阔蛟龙出，山深杜若开。\n相思有词赋，愁绝并登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得朝信惟学书","author":"何景明","text":"稍嘉豺狼息，仍悲鸿雁音。\n故人双尺素，遥比万黄金。\n水上春花树，城边秋竹林。\n天涯暮风雨，肠断北山吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得郑继之书","author":"何景明","text":"郑生湖海去，高兴渺难降。\n累月音书数，清秋涕泪双。\n天边登越峤，雪里渡吴江。\n万水千山暮，何时到尔邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得王子衡赣榆书","author":"何景明","text":"万里一书劄，逾年传帝都。\n窜身天地远，垂泪海云孤。\n柳送燕台骏，花留汉殿凫。\n赤霄终道路，白发且江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵张郎中九日无菊","author":"何景明","text":"九日杯空绿，秋城菊未花。\n雨丛寒惨淡，风树晚欹斜。\n独客悲漂梗，隹人怨折麻。\n何时开烂熳，沽酒到君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕和以道怀弟之作","author":"何景明","text":"汝弟犹吾弟，君家更几家。\n情知思棣萼，愁与对椒花。\n酒罢看参远，灯寒望斗斜。\n相怜谢池草，明日又春华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戴生在吾语感秋思归诗以慰留之二首 其一","author":"何景明","text":"到日中元节，淹留岁渐微。\n而翁在异县，知汝苦思归。\n旅馆空弹铗，秋风未授衣。\n敝床还可宿，暂住莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戴生在吾语感秋思归诗以慰留之二首 其二","author":"何景明","text":"二十年方妙，昂藏见尔才。\n青云满霄汉，黄鹄尚徘徊。\n宝剑休轻试，家书莫屡开。\n百年深有望，吾道岂尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答汝忠","author":"何景明","text":"俱向沧江起，同怀魏阙情。\n乾坤尚戎马，我辈复簪缨。\n戢羽栖云閤，联翩入凤城。\n谁知荐贤内，今日忝齐名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过川甫","author":"何景明","text":"日午诗相约，更深马独来。\n惭非问奇客，知是草玄才。\n月柝枫乌起，霜灯竹户开。\n因思高李辈，词赋擅梁台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月二十五日会曹汝学侍御于麓堂夜归遂过侍御宅","author":"何景明","text":"东阁留樽罢，西台夜过时。\n题诗倚骢马，换酒脱金龟。\n菊院霜天静，枫城海月迟。\n向来秋寺约，还许赴佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜过饮戴时亮进士","author":"何景明","text":"琴酒杨云宅，谈玄静夜真。\n庭无旋马地，室有聚萤人。\n霜雾生阴井，风灯动夕邻。\n喧喧万车马，日出自红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐子容见过","author":"何景明","text":"三月三十日，燕京春兴悽。\n相过话远别，此去忆深栖。\n江汉今舟楫，乾坤尚鼓鼙。\n风尘归未得，送汝万行啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与王宗哲过访刘德徵兼有所怀","author":"何景明","text":"天街并马过，零雨碧氛氲。\n王子真乘兴，刘郎雅好文。\n烛筵挥玉轸，风户袅垆薰。\n忽忆横箫客，遥遥隔彩云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端阳日过子容登瞻辰楼","author":"何景明","text":"五日访南州，瞻辰上北楼。\n旌旗夹水殿，箫鼓送龙舟。\n沧海犹多难，佳辰但百忧。\n浮云暮南适，遥向楚江头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日显露宫宴集","author":"何景明","text":"九日无风雨，宾朋更远来。\n菊花催酩酊，仙侣得追陪。\n眺迥山河出，登高殿阁开。\n携游有诸妙，词赋岂吾才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登紫极閤","author":"何景明","text":"层閤重重丽，丹梯袅袅孤。\n风云上紫极，气色览皇都。\n苑静芙蕖落，城喧雁鹜呼。\n苍然见淮楚，乡思满平芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侯郎中刘主事见过对菊","author":"何景明","text":"菊树开初烂，轩窗坐晚晴。\n客非先有约，花亦太多情。\n霜艳娟娟静，风香细细生。\n天涯一杯酒，今夕对寒城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过君采次韵二首 其一","author":"何景明","text":"海内风尘隔，天边江汉流。\n昔牵春草梦，今并至珂游。\n神骏元千里，仙人自十洲。\n惭随燕雀辈，白发世间愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过君采次韵二首 其二","author":"何景明","text":"自君来此地，谓我颇同流。\n复往江湖去，宁忘霄汉游。\n龙蛇蟠海曲，鸿雁向河洲。\n从此风波隔，长安日暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"世其宅夜集同君采作限难字","author":"何景明","text":"冬夕具盘餐，明灯坐不寒。\n独怜竹叶盏，仍对菊花团。\n素月萦窗细，高云傍苑残。\n美人江国去，惆怅采芳难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕同萧执夫舍侄士饮","author":"何景明","text":"把烛开尘榻，幽寻款夜扉。\n寒城飒欲暮，风叶坐来稀。\n野兴林间竹，乡心楚上薇。\n萧条共杯酒，潦倒愧朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕刘户部宅","author":"何景明","text":"画省开云幔，西堂对雪峰。\n一年惟此会，万里几相逢。\n守岁亲灯火，朝天候鼓镛。\n江湖有岐路，漂转叹萍踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚过以行","author":"何景明","text":"伯兄难更见，爱弟复佳名。\n往日题诗客，黄昏驻马情。\n春星度北牖，暮雨到西城。\n肠断池塘草，东风亦自生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游郭氏山亭","author":"何景明","text":"旧日追游地，新年此度过。\n庭春归雪筱，洞古发烟萝。\n迟日登临倦，名园感慨多。\n风花骑马去，须放酒颜酡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月四日刘子见过二首 其一","author":"何景明","text":"入閤开尘拓，留尊对苑墙。\n杪秋馀暑湿，高树独风霜。\n岁逼乡心甚，天增病骨凉。\n自怜情兴减，不比向来狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月四日刘子见过二首 其二","author":"何景明","text":"汝病稀相见，高诗久不闻。\n侧思金石奏，喜挹蕙兰芬。\n细菊妍霜昼，繁砧乱朔云。\n萧萧秋日兴，对尔忆离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月五日与张刘崔三子约九日游法藏寺塔刘尝约游西山竟寒盟故云","author":"何景明","text":"未省重阳菊，谁邀我辈看。\n城南冇塔寺，共拟集衣冠。\n云起登台兴，风追落帽欢。\n此盟今夕定，莫似碧山寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登塔二首 其一","author":"何景明","text":"古塔层城畔，秋毫万里看。\n登高携赋客，落日眺长安。\n天地悬相抱，江山郁自盘。\n谁能绝顶上，不避北风寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登塔二首 其二","author":"何景明","text":"塔廊徐暗转，不觉此身高。\n月牖通天汉，风檐散海涛。\n望馀秋色远，登罢客心豪。\n去雁休回首，冥冥一羽毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访客鉴公房","author":"何景明","text":"病客依栖地，石房钟磬深。\n清斋忘肉食，独宿见禅心。\n閤日斜寒昼，窗云下夕阴。\n吾居亦邻并，日为过西林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋宿大兴隆寺","author":"何景明","text":"叠雪霾云磴，阴霞绚石房。\n沉冥通别理，宴息对焚香。\n暖色含初筱，迟烟散远杨。\n斋心临暮景，属意向春阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日刘薛二子过","author":"何景明","text":"林花寒不折，城雁日喧呼。\n壮觉风情减，春增旅兴孤。\n经过留翰墨，潦倒念江湖。\n未似高阳侣，垂鞭向酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过玄明宫","author":"何景明","text":"朔海风云变，玄宫日月移。\n登临逼九日，摇落倍前时。\n翠竹寒虚寝，荒藤蔓曲池。\n重看石椁地，徒有雍门悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登仁寿寺后山","author":"何景明","text":"石閤凌香岫，凭高烟雾开。\n人疑送酒客，地即望乡台。\n雁度桑乾去，云从碣石来。\n鱼龙瀚海北，万古一悲哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十月望夜刘薛二子过对月","author":"何景明","text":"院寒冬月白，城夜海云收。\n上客扳兰省，清光近凤楼。\n关山一北望，河汉迥西流。\n未见乘槎使，迢迢上斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登慈恩寺閤三首 其一","author":"何景明","text":"示到慈恩久，今来九日期。\n天寒鸿雁少，秋晚菊花迟。\n摇落悲风雨，登临感岁时。\n牛山何处是，异代独兴思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登慈恩寺閤三首 其二","author":"何景明","text":"地幽人迹少，僧至扫莓苔。\n閤迥湖光入，林昏雨色来。\n登台怜作客，入赋耻非才。\n何事临佳节，秋怀未肯开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登慈恩寺閤三首 其三","author":"何景明","text":"莫引凭高目，沧茫海色遥。\n秋空波瀰瀰，寒日树萧萧。\n关塞俱摇落，音书久寂寥。\n天涯有兄弟，犹滞楚江桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自滇蜀归李户部马舍人见访","author":"何景明","text":"官舍扫莓苔，故人尊始开。\n相违频问讯，乍见各徘徊。\n瘴疠一身在，风尘万里来。\n欲询滇蜀胜，惭愧子长才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中过李真人方丈二首 其一","author":"何景明","text":"胜地岂常得，幽盟难重寻。\n清晨驱马出，聊此息尘心。\n鸣磬秋堂湿，然灯古殿深。\n吹箫爱仙侣，缥缈隔珠林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中过李真人方丈二首 其二","author":"何景明","text":"层台暮云外，寂寂羽人居。\n积雨阶除静，含风殿閤虚。\n洞中留白日，窗下写丹书。\n即此观幽逸，能令世虑疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早入宣武门","author":"何景明","text":"蔼蔼名都会，鹓鸿共接翱。\n金貂万户客，铁骑五陵豪。\n夹道红尘满，千门白日高。\n寂寥杨子宅，随分守蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望海","author":"何景明","text":"登高望远海，万里一长吟。\n岛屿迎寒日，波涛带夕阴。\n岂无乘筏叹，亦有钓鳌心。\n去去从吾好，三山烟雾深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜集吕给事宅","author":"何景明","text":"银汉高秋露，严城月色阴。\n美人今夜酒，游子故乡心。\n乌鹊江边去，蛟龙海上吟。\n汉宫楼殿迥，莫使暮寒侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与韩汝庆行归长安望月","author":"何景明","text":"中秋高宴会，客散向长安。\n皓月千门里，青天并马看。\n明添化蕊乱，阴孟柳条繁。\n怅望高云上，何由振羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚过周进士言别闻琴","author":"何景明","text":"朱弦久寂寞，此夜拭瑶琴。\n坐对燕京酒，同悲楚客吟。\n城高下木叶，楼迥上秋参。\n别后清江夜，遥思绝代音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与孙世其过张秀才","author":"何景明","text":"长夏稀朝谒，相邀此地同。\n占晴行苑外，避暑出城中。\n翠筱含风静，苍波映日空。\n因思共童冠，归咏舞雩风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避暑存上人方丈","author":"何景明","text":"燕地炎蒸月，西林大道傍。\n上方留避暑，长日坐焚香。\n细竹轩窗静，高云殿閤凉。\n何时更乘月，过宿赞公房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出游功德寺","author":"何景明","text":"昔闻功德寺，今出帝城西。\n晚日丹梯近，秋天翠巘齐。\n荷衰犹映水，树古曲盘堤。\n十里经行地，清沙送马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿淇公方丈","author":"何景明","text":"落日罢登临，禅房秋坐深。\n不妨留枕簟，聊得谢冠簪。\n楼閤湖天影，松萝洞月阴。\n明朝又朝市，回忆碧山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天坛沈道士观中","author":"何景明","text":"夏日天坛上，登临傍九霄。\n川原一以眺，楼观郁岧峣。\n洞口逢丹侣，花间醉碧箫。\n清沙日色尽，翻恨马蹄遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张子纯宅对月","author":"何景明","text":"长安今夜月，留客此堂开。\n影落清樽里，光从玉殿来。\n苑花添帐望，邻笛助悲哀。\n幸接仙郎饮，高歌愧尔才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病居田给事中夜过","author":"何景明","text":"卧疾春天暮，相寻客夜幽。\n剧谈翻愈病，沉醉忽忘忧。\n西月低临牖，明星远动楼。\n看君上马去，犹使兴情留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雪诸翰林见过二首 其一","author":"何景明","text":"正月燕京雪，飞花落满筵。\n辉辉映旭日，脉脉向春天。\n苑草寒犹细，宫云晚更鲜。\n中原有戎马，何日凯歌旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雪诸翰林见过二首 其二","author":"何景明","text":"冉冉烟城袅，飘飘苑雪过。\n人稀春夜静，花剧暮寒多。\n置酒邀金马，开轩对玉柯。\n阳春有高调，莫惜为子歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬卢侍御见访有作用韵","author":"何景明","text":"柱史事沉冥，行骢到我亭。\n数章天北极，只字斗南星。\n坐久莺初唤，吟馀草更青。\n朱弦山水调，凄切为君停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同张仲修再过刘子","author":"何景明","text":"刘家好兄弟，邻近苑西楼。\n数有花辰会，兼成月夜游。\n留徐还下榻，访戴不回舟。\n况接张公子，诗轻万户侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过田郎","author":"何景明","text":"晚就田郎饮，高歌坐此庭。\n炎天忽云雨，西日更雷霆。\n席傍檐花湿，窗临苑树青。\n相过恋朋好，常得慰飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同崔太史张侍御饮周都阃亭子","author":"何景明","text":"公主山亭在，元戎小队回。\n碧沙沾细雨，白日映轻雷。\n已并花边骏，难孤竹下杯。\n良宵可乘兴，归骑莫频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭氏园亭","author":"何景明","text":"汉苑清霄近，名园不出城。\n曲穿阴洞入，危傍峭岩行。\n宾客冠簪盛，公侯甲第荣。\n日斜登览罢，怅望有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过孙世其时有警报","author":"何景明","text":"一自来京邑，常时过尔吟。\n飘零叹往昔，留滞到于今。\n各有江乡思，兼之边塞心。\n明星罢击柝，怅望北城阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过远夫","author":"何景明","text":"堂上炎天迥，明灯夕坐深。\n相逢浊酒醉，独怅白头吟。\n苑柳通西内，边烽起北岑。\n此时对迁客，何意复冠簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋日吕景二内翰吕田二黄门见访","author":"何景明","text":"高城下一叶，亭榭已萧疏。\n河汉生秋早，星辰动夜虚。\n玉珂停騕袅，金砚落蟾蜍。\n俱是文章伯，相看我不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游郭氏园亭二首 其一","author":"何景明","text":"仲夏一到此，主人开水亭。\n园林再驻马，台榭已流萤。\n细竹摇风牖，孤云度石屏。\n停杯更暮雨，何限北崖青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游郭氏园亭二首 其二","author":"何景明","text":"日暮北亭上，怅然秋望深。\n碧山聊柱杖，沧海未抽簪。\n苑上开云閤，窗中叠雾岑。\n长安足尘土，常过此登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过显灵宫","author":"何景明","text":"不到玄宫久，桃源更此行。\n行知瑶水近，坐望赤霄平。\n洞草秋先长，坛云昼自生。\n双双玉箫发，风引度仙城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]