[{"title":"南昌铁柱观","author":"孙蕡","text":"琳宫古邸露岧峣，云是千年此镇妖。\n方外羽衣能济世，城中仙瓮亦通潮。\n蛟龙水底蟠金锁，鸡犬云间听玉箫。\n行橐已垂思点石，祈灵坛上倚逍遥。\n无复腥风卷楚江，何年羽客受神方。\n层阴赑屃冲潮出，薄暖珊瑚绕树香。\n贝阙珠宫云杳邈，败鳞残甲水微茫。\n神游欲问苍精剑，仙意人间想未忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋次清江","author":"孙蕡","text":"初见星杓转素商，忽惊灵籁报新凉。\n云来太华芙蓉白，露满清江杜若黄。\n绝壁群真迷鹤骑，废城孤剑隐龙光。\n东还已逐莼羹兴，即倚遥天望帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十八滩","author":"孙蕡","text":"五城一别三千里，孤棹重经十八滩。\n拍岸怒涛雷喷薄，横江乱石铁巉岩。\n天阴紫蜃笼商轴，夜冷苍龙吼剑关。\n犹记平南诸将下，楼船此地凯歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张曲江祠","author":"孙蕡","text":"铁石肝肠鲠不阿，千年庙享未为过。\n胡儿反相知偏早，人主荒淫谏亦多。\n金鉴录存明皎日，玉环事杳逐流波。\n岭头手种松犹在，想见高材拄大罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕舟次英德","author":"孙蕡","text":"西清去岁侍群仙，坐候晨钟拱御筵。\n沧海头颅今四十，彤庭礼乐旧三千。\n盛寒颇似庚申夜，飘泊还逢癸丑年。\n明日扁舟江上路，梅花开遍野云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄高彬四首 其一","author":"孙蕡","text":"宦游三载黄河北，长忆蟾溪好隐居。\n火齐明珠攀荔子，银丝玉版脍鲥鱼。\n枇杷结实暄风里，橘柚垂花细雨馀。\n溪上故人今在否，来鸿不寄一封书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄高彬四首 其二","author":"孙蕡","text":"与君夙有通家好，堂上严亲未白头。\n野寺花明春载酒，清溪月朗夜浮舟。\n陶潜此日生归思，屈子长年赋远游。\n烟水五湖归棹早，为余开径碧林幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄高彬四首 其三","author":"孙蕡","text":"蟾溪溪头春水生，故人卜筑茅堂清。\n开门雨过芳树绿，对酒风来幽鸟鸣。\n我缠薄宦去乡国，君亦久客留天京。\n未知何日遂归计，重结渔郎鸥鹭盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄高彬四首 其四","author":"孙蕡","text":"蟾溪溪头潮没沙，游子十载未归家。\n柴门春老荔枝树，茅屋风吹卢橘花。\n林下举杯闻鸟雀，柳阴摇艇卖鱼虾。\n不知蓬鬓沧江上，谁遣清吟负岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀京","author":"孙蕡","text":"一官旅寓青齐北，长忆江南是胜游。\n云日九天龙虎气，莺花三月帝皇州。\n美人扶醉歌金缕，狂客挥鞭纵紫骝。\n寥落客怀归计阻，江湖烟水正悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采石太白墓三首 其一","author":"孙蕡","text":"蛾眉亭下拢扁舟，曾记王孙旧此游。\n彩笔题花留御几，锦袍和月泛清秋。\n仙都缥缈鲸为骑，贝阙空濛蜃起楼。\n亦有金龟能换酒，不知何处醉荒丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采石太白墓三首 其二","author":"孙蕡","text":"伊昔开元全盛日，词林供奉被恩光。\n鸾箫曲奏清平调，宫锦春明七宝床。\n野鹿衔花人似玉，长鲸吸浪月如霜。\n来游不见凌风处，迢递青山入夜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采石太白墓三首 其三","author":"孙蕡","text":"冠履何年堕世尘，先生元是谪仙人。\n春云彩笔惊飞燕，暮雨沧江泣石麟。\n牢落清名元不殁，衰迟大雅竟难陈。\n翛然我亦狂吟客，思杀风流贺季真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次黄州","author":"孙蕡","text":"日落放船鹦鹉洲，汉阳烟白树幽幽。\n江豚数起浪花夕，野鹤一声山木秋。\n帆影掠云过赤壁，橹声摇月下黄州。\n何因散发林皋下，得似坡翁烂熳游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次池州","author":"孙蕡","text":"向晚九华山下泊，望云遥忆宋齐丘。\n尘中曳履留仙迹，方外寻真是胜游。\n宝匣龙鸣星彩动，砂床虎跃电光浮。\n枫林影落墟坛静，何处天风鹤驭秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望庐山二首 其一","author":"孙蕡","text":"扁舟夜泊浔阳岸，隐约香炉五老巅。\n红叶天灯飞鸟外，白莲僧社断猿边。\n苍崖影合东林寺，银汉光连瀑布川。\n亦有宗雷违四想，千峰无路访群仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望庐山二首 其二","author":"孙蕡","text":"东林佛阁倚岧峣，萝径逶迤傍石桥。\n松柏千章连左蠡，芙蓉万叠倚层霄。\n琪花雪影江心见，莲社天香世外飘。\n归老倘酬仙赏愿，篮舆宁待远公招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次浔阳二首 其一","author":"孙蕡","text":"最爱清狂老司马，浔阳江上泊扁舟。\n风前醽醁开芳宴，月底琵琶唤旅愁。\n千载凄凉秋瑟瑟，四弦哀怨水悠悠。\n天涯我亦飘沦客，泪洒青衫忆胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次浔阳二首 其二","author":"孙蕡","text":"几欲香山寻九老，十年未办草空赀。\n苍苔石镜应涵月，白社莲花想满池。\n世外丛林秋似水，天涯迁客鬓成丝。\n黄芦苦竹湓江岸，独舣扁舟岁晚时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次九江","author":"孙蕡","text":"日出烟沙开远汀，白鸥南畔九江城。\n迎船山色多吴望，隔浦渔歌南楚声。\n青草瘴销云叶掩，鲤鱼风歇浪花平。\n旅怀牢落新诗少，怪得行囊数日轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄江州陈徵士","author":"孙蕡","text":"匡庐山色倚晴天，君住香炉若个边。\n松里云巢应伴鹤，竹间棋局或逢仙。\n义门诗礼京华重，翰苑文章相府传。\n岁晚王猷清兴发，凌寒思泛九江船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至储潭庙留题","author":"孙蕡","text":"五老峰微楚路分，赣滩犹礼洞庭君。\n行空铁马寒嘶露，带月苍龙夜吼云。\n琼佩倩谁招帝女，桂浆聊复奠灵氛。\n清吟寄远成孤绝，思入沧江白雁群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思岳州","author":"孙蕡","text":"渺渺孤舟江汉间，岁华摇落鬓毛斑。\n裁成方朔三千牍，博得瞿塘十二滩。\n峡口瘴深迷岳渚，洞庭风顺过君山。\n无端又是重阳节，起对黄花一破颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳州送丘祥甫","author":"孙蕡","text":"日落君山生紫烟，岳阳楼下水连天。\n苍梧夜色浮仙佩，筼竹春阴满画船。\n云路几时声藉藉，鬓丝赢得影翩翩。\n归逢父老如相问，飘泊洪州四五年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归州赠莫三","author":"孙蕡","text":"怜君万里客归州，每忆乡园涕泗流。\n百折漩涡江渚晚，千章云气蜀山秋。\n登高好作思玄赋，近水宜开醉白楼。\n闻道清时多雨露，肯令车辙久淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其一","author":"孙蕡","text":"淅淅金风霄汉间，火云犹自绕巫山。\n雨馀神女收旌旆，月朗明妃响佩环。\n万顷波光人鲊瓮，一天秋色鬼门关。\n吟魂未向三巴断，尚逐东吴画舸还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其二","author":"孙蕡","text":"赤甲白盐秋气多，黄棱黑石沸漩涡。\n惊闻楚客吟山鬼，欲趁巴童拜浪婆。\n灵雨乍晴仙掌出，雄风初动使旌过。\n金门此日瀛洲客，应已朝回散玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其三","author":"孙蕡","text":"蒲帆十幅楚王洪，百折飞流一瞬东。\n将雨峡光时隐映，小寒风气半清濛。\n秋阴淡锁黄魔庙，夕影时明白帝宫。\n寥落杜陵霜鬓客，旅怀应与此时同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其四","author":"孙蕡","text":"八阵图连潋滟堆，永安宫下水萦回。\n风云旧碛森犹列，行在荒台久已颓。\n铁马跃云嘶冻雨，木牛遗恨吼惊雷。\n英雄一去今千载，残照西风首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其五","author":"孙蕡","text":"汉相祠西江水烟，晚风平漩送归船。\n千重古锦云端石，一带空青峡里天。\n诗思每怀秋放鹤，客心那更夜闻鹃。\n凭谁为写高唐赋，谱作朝云蜀国弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其六","author":"孙蕡","text":"袅袅西风吹鬓丝，天涯独客暮秋时。\n艰虞不涉王阳道，摇落宁知宋玉悲。\n巫峡疏风明断锦，瞿塘乱石点残棋。\n相如见说馀祠庙，欲折芳香遗所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其七","author":"孙蕡","text":"白帝城荒枫树凋，关门碛石尚岧峣。\n卧龙诸葛雄风在，跃马公孙霸气销。\n万里客心云共远，九秋吟鬓叶同飘。\n谁能岁晚悲摇落，江水江花慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡秋怀八首 其八","author":"孙蕡","text":"秋菊腾香已半开，晚风香散楚王台。\n涛声触石鏦铮去，山色迎船紫翠来。\n乡国每悬他日念，禁帏深愧子云才。\n清时万里无征战，羌角宁劳送暮哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀四川二首 其一","author":"孙蕡","text":"蜀城风物冷凄凄，马上哦诗日向西。\n雪岭冰融春水绿，锦江花落子规啼。\n卧龙祠废碑横草，杜老堂空雨涨溪。\n回首胜游成往事，倚风吟断意俱迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀四川二首 其二","author":"孙蕡","text":"草堂烟树入青霄，汉殿荒台秀黍苗。\n宇宙诗名今尚在，风云霸气未全消。\n寒星夜落支机石，锦水春明驷马桥。\n花柳旧游今几载，西风蓬鬓影萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉酬四川戴佥宪文信见访","author":"孙蕡","text":"濯锦江波漾绣衣，邻翁走报入柴扉。\n雨馀门巷青骢滑，花外旌幡白鸟蜚。\n岂有雄文倾辈行，屡烦青眼顾寒微。\n游仙梦觉惊题凤，倒著山公白接篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀青城","author":"孙蕡","text":"青城观里寻真处，万树琪花映雨开。\n林鹤或乘仙佩去，洞龙时化羽衣来。\n天青紫气蟠金阙，夜冷琅风散宝台。\n几度神游高兴阻，五云依约隐蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀罗浮寄萧炼师","author":"孙蕡","text":"十年湖海厌狂游，长说仙家景致幽。\n阴洞雨龙眠白石，古坛风鹤语清秋。\n青枫化客深林静，丹鼎成虹瑞气浮。\n遥想吹箫明月夜，群仙应已下沧州。\n误解兰缨下彩峰，十年飘泊厌西东。\n秋风楚塞尘随马，夜雨吴江浪打篷。\n旅邸寂寥芳岁换，仙游烂熳几时同。\n罗浮此日南薰转，无数漫山荔子红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访单孟雄不遇","author":"孙蕡","text":"不见龙滩单孟雄，欲从山藓觅行踪。\n门前乌桕经霜紫，树杪青霞着日红。\n蜡屐定过蝴蝶洞，竹门长掩鹧鸪峰。\n桃花流水仙源近，岁晚渔郎或再逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾氏耆寿翁诗","author":"孙蕡","text":"词林每忆乡园友，曾定才名耸缙绅。\n观国倦骑沙苑马，幽栖长戴华阳巾。\n芙蓉火足龙蟠鼎，松树天寒鹤近人。\n天上归来今白发，泉南水竹愿为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀朱备万修撰谪辽东二首 其一","author":"孙蕡","text":"垂老谪官瀛海上，惊闻呜咽泪沾巾。\n长怜偃蹇难堪俗，岂信文章解误身。\n赋鵩几年留贾谊，怀沙此日吊灵均。\n无劳更用悲萍梗，见说皇家雨露均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀朱备万修撰谪辽东二首 其二","author":"孙蕡","text":"闻君远谪三韩去，万里天风裂素衣。\n圣世君恩殊未薄，畏途吾道一何微。\n金莲炬暗梅花落，鸭绿江寒雁影稀。\n我亦漂流向沧海，相思何处不依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马图","author":"孙蕡","text":"御柳西风白下时，宛龙曾见内官驰。\n可堪洪武新妆束，尽复开元旧羽仪。\n去国丹心常捧日，按图吟鬓欲成丝。\n嫖姚百万平秦蜀，不借相如一匹骑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"颜左司閒居关中别业","author":"孙蕡","text":"轮蹄不到称閒居，日伴松筠检旧书。\n云拥溪山青入户，雨添涧水绿循除。\n薇垣政颂休官后，竹简文传济世馀。\n华鬓莫劳忧岁计，几多门下带悬鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄文渊学士吴公","author":"孙蕡","text":"翰苑摛文沐宠多，又升近侍在銮坡。\n谠言屡进分香日，直笔常濡太液波。\n入相内廷称褚亮，荐贤当路说常何。\n独怜落职东迁客，远道西风鬓欲皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀朱太史芾宋舍人璲","author":"孙蕡","text":"谁怜飘泊向江关，独倚长风忆妙颜。\n老我黄尘三楚外，羡君华藻五云间。\n清时步武蜚声早，晚岁逶迤奏牍闲。\n钟阜冶城苍翠里，何由更得共跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀揭孟固","author":"孙蕡","text":"弱水神仙路渺然，欲从何处问群仙。\n金门正合客方朔，沧海宁当老郑虔。\n白玉堂前秋月冷，紫薇花上晓风颠。\n吟魂想挹天光近，凤尾游丝五色鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀萧止善","author":"孙蕡","text":"羡君旧貌吴兴帖，一变依稀逼古人。\n笔冢麟埋烟草绿，墨池龙跃雨花新。\n银钩铁画工无敌，鹘起弦惊兴有神。\n拟挹遗经誇俗眼，顾惭书法似羊欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠广东郑宪使金宝","author":"孙蕡","text":"一扫炎氛障海东，柏台明月晃丹衷。\n群黎顿使无夷习，远俗能令有古风。\n当道豺狼宁踯躅，啼饥儿女得从容。\n殊方深仰纲维肃，何日归游化育中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀碧虚观寄止庵萧炼师五首 其一","author":"孙蕡","text":"安期台下蕊珠宫，旧雨题诗紫翠中。\n五夜丹光虹贯日，四山松树鹤呼风。\n深云洞口藏金母，岁久林枫化玉童。\n吟客远游仙子去，锦桃春晚为谁红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀碧虚观寄止庵萧炼师五首 其二","author":"孙蕡","text":"为爱碧虚萧道士，十年窗下读黄庭。\n山瓶枸杞龙蛇白，石井丹砂螮蝀青。\n词客素秋吟夜月，羽人清夜礼寒星。\n别来仙赏幽期旷，谁共松根采茯苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀碧虚观寄止庵萧炼师五首 其三","author":"孙蕡","text":"飞泉作雨落寒岩，蕊阙凌天起翠岚。\n禹柏千年青蔼蔼，尧蒲九节玉毵毵。\n天游别我知谁共，世故撩人祇自惭。\n云月旧盟应未冷，可能相待解朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀碧虚观寄止庵萧炼师五首 其四","author":"孙蕡","text":"平生最有沧洲趣，一住三吴十二年。\n愁逐乱云生隐隐，梦随孤鹤去翩翩。\n寻真谩尔怀仙侣，炼药凭谁授秘编。\n目断南云心欲绝，祇今无计脱尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀碧虚观寄止庵萧炼师五首 其五","author":"孙蕡","text":"前生本是临皋鹤，长占烟霞物外交。\n几向沧洲乘野艇，更依蓬岛结书巢。\n千年果熟云明树，五粒松寒露滴梢。\n为报罗浮萧羽士，好开萝径碧山凹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三友堂","author":"孙蕡","text":"白白朱朱桃李蹊，画中仍得睹山溪。\n苍龙雾卷明珠现，彩凤风回万玉低。\n积雪匡庐纡线袜，层阴太华隐丹梯。\n幽期岁晚凭谁共，独抚新图意自迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过济南别何方伯","author":"孙蕡","text":"明公清顾情何厚，贱子华年数苦奇。\n巫峡秋涛停棹日，太行烟雨返轮时。\n春回槁木阳和盛，雀报金环岁月迟。\n明发又为千里别，暮途惟有涕沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古河思家","author":"孙蕡","text":"古河烟草暗南天，此去乡园路几千。\n燕子来时春寂寂，海棠开后雨绵绵。\n沧江水绕吟诗社，绿渚花明载酒船。\n更忆故人王给事，愁来书破薛涛笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闷兴","author":"孙蕡","text":"无柰客愁愀不醒，谁怜新舍在南溟。\n佳人花底占乌鹊，令弟沙边唤鹡鸰。\n庾岭南来云漠漠，清江东下雨冥冥。\n几回吟罢空惆怅，谩对寒梅倒醁醽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观海","author":"孙蕡","text":"海上蟠桃冬著花，蓬壶高处敞仙家。\n天寒雾雨笼鲛室，夜久星辰泊钓槎。\n神武步莲珠结凤，醉翁题竹墨淋鸦。\n连鳌未试任公手，欲借前筹纪岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戍辽渡海二首 其一","author":"孙蕡","text":"天风万里噀洪涛，惊见神峰立巨鳌。\n绀节影摇龙伯国，绣幢光拂海凫毛。\n浮空员峤随波长，绕石珊瑚出浪高。\n倘许从戎树勋业，白头归路拥旌旄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戍辽渡海二首 其二","author":"孙蕡","text":"清诗字字尽琅玕，水底蛟龙夜起看。\n未结柳船驱五鬼，又将蓬鬓犯三韩。\n灵筌降夕通仙语，海屋添筹纪岁阑。\n万里封侯期可遂，春风笳鼓入长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡海呈同游","author":"孙蕡","text":"同来文章诸钜公，昔时作宦今从容。\n不论西蜀与东广，共渡北海期南风。\n将军锦带佩双虎，左校宝刀藏一龙。\n明年奏凯答神贶，羽书归奏蓬莱宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙门岛四首 其一","author":"孙蕡","text":"忆上銮坡拜紫宸，沾恩曾醉杏园春。\n空馀姓字传江海，那得新诗泣鬼神。\n徐韨楼船风信杳，安期瓜枣露华新。\n等閒鸥鹭休相笑，犹是金莲炬底人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]