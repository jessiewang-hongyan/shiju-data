[{"title":"栖霞亭卷二首 其一","author":"于谦","text":"丹成随处是仙家，何必蟠桃万树花。\n叠膝茅亭心似水，流光满目绚丹霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"栖霞亭卷二首 其二","author":"于谦","text":"餐霞服日总虚传，识得栖真始是仙。\n独拥蒲团亭上坐，凝神遥在五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题蒲萄图","author":"于谦","text":"一夜轰雷震九垓，明珠幻出老龙腮。\n摘来酿酒三千斛，献作吾皇万寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32151,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"于谦","text":"负重那堪路更赊，行行未得到山家。\n老妻稚子应相望，回首柴门日欲斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32152,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孤云","author":"于谦","text":"孤云出岫本无心，顷刻翻成万里阴。\n大地苍生被甘泽，成功依旧入山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32153,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张灯偶题","author":"于谦","text":"客中无计可消愁，随俗张灯向小楼。\n月自团圆灯自好，老怀不似旧风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32154,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"并州元夕","author":"于谦","text":"满城灯火走儿童，万朵金莲照地红。\n独有并州倦游客，梦魂飞绕凤城东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32155,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"并州初春写景","author":"于谦","text":"塞上寻春不见春，边风日日走红尘。\n多情只有庭前柳，微弄腰肢慰藉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32156,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初春睡起写景","author":"于谦","text":"雪消土润草痕青，烟暖风柔柳带轻。\n啼鸟一声来枕上，梦回春意满山城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32157,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春客途即景","author":"于谦","text":"雨中红绽桃千树，风外青摇柳万条。\n借问春光谁管领，一双蝴蝶过溪桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渊明像","author":"于谦","text":"杖屦逍遥五柳庄，一辞独擅晋文章。\n黄花本是无情物，也共先生晚节香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳日迎驾宿新都宝光寺","author":"王绅","text":"东风扇微和，旭日绚阳春。\n晨兴秣我马，驾言出城闉。\n矫首京华道，遥遥望清尘。\n先驱曾未至，盻睐徒劳神。\n解鞍憩古刹，息虑澄吾真。\n野人好辞色，日夕罗盘飧。\n佳节获良会，慨羡诚难频。\n行当尽一醉，鼓腹歌君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和中秋对月睿制","author":"王绅","text":"天高秋正中，颢气澄太虚。\n素娥散清彩，皎皎临寰区。\n惟时明哲王，恭默万虑无。\n异香浮宝鸭，净影印玉除。\n心远景由寂，神清情自娱。\n至化基二南，令誉腾九衢。\n德尊意弥下，出入从师虞。\n圣道本宏远，尧舜犹病诸。\n愿言思太康，益进无逸图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题小香山梅花堂诗和雷门兄韵","author":"徐宏祖","text":"结庐当遥岑，爱此山境寂。\n展开明月光，幻作流霞壁。\n壁上叠梅花，壁下飞香雪。\n泠然小有天，洵矣众香国。\n香留妃子名，花洒明贤笔。\n名以还山灵，笔以表山骨。\n幽人物外缘，今古妙吻合。\n造化已在手，香色俱陈迹。\n相对两忘言，寒光淩太乙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉中漫歌","author":"徐宏祖","text":"吴妃此地将香采，此地遗名遂千载。\n香魂芳草几悠悠，泡玉连珠为谁在。\n天留名壤待名人，吾家季兄能采真。\n九龙万笏掉头过，爱此荒寂之嶙峋。\n冰雪长盟物外契，烟霞幻出人间世。\n一斧劈开混沌天，千株忽现崆峒树。\n绕屋梅花香更清，当窗竹影云俱轻。\n梅花宜月竹宜雨，一时雅致谁与并。\n我来恰值阴晴会，晓色空濛夜明媚。\n雨中移竹月中栽，客与梅花同一醉。\n不知孰主孰为客，不知是梅还是月。\n此时香色已俱空，三岛十洲竟谁别。\n自怜从来汗漫偏，将无失却壶中天。\n何如向此媚幽独，长抱月明朝紫烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月中种竹歌","author":"徐宏祖","text":"香山仙子孤山癖，爱种梅花向明月。\n花香月色两空濛，更借琅玕点幽碧。\n带雨遥分前浦云，当窗漫凿峰头石。\n移来细细记南枝，种去萧萧映香雪。\n移时雨候种时晴，透岭披峦重月白。\n初照挥锄若有神，再照清标次第出。\n一株新栽鸾凤翮，两株对舞蛟龙立。\n三株四株几十株，影摇星斗天文坼。\n一锄一杯月倒吸，一株一醉风生腋。\n当年何数竹林閒，此日真成君子宅。\n罗浮梦杳翠凝裳，湘水魂清玉为骨。\n尚忆骑鹤崆峒游，翻恨中无此香色。\n撇却手中九节筇，和云好共此闲植。\n他年酒醒竹成林，分向瑶池配丹阙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得孤云独往还楞伽山中同石斋先生分韵 其一","author":"徐宏祖","text":"秋空净无极，兀兀片云孤。\n不与风同驶，遥令雨自苏。\n卷舒如有约，尺寸岂随肤。\n我欲神相倚，因之径转无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得孤云独往还楞伽山中同石斋先生分韵 其二","author":"徐宏祖","text":"为霾并为电，弥天总是云。\n谁能绘霄汉，了不作氤氲。\n捧日开朝霁，飞霞散夕曛。\n此中无一系，何处著纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得孤云独往还楞伽山中同石斋先生分韵 其三","author":"徐宏祖","text":"出岫何幽独，悠然飏碧空。\n遥分秋水影，忽度夕阳风。\n长天不留迹，冷月若为容。\n归宿应何在，崆峒第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得孤云独往还楞伽山中同石斋先生分韵 其四","author":"徐宏祖","text":"彩霞竟何往，苍狗自徜佯。\n出没千峰迥，夷犹一壑长。\n鹜飞难做伴，龙跃岂相忘。\n不待为霖日，方令天汉章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得孤云独往还楞伽山中同石斋先生分韵 其五","author":"徐宏祖","text":"舒卷有妙理，谁云倦始还。\n垂天宁幻态，触石岂无关。\n神远群俱涣，情空迹自闲。\n始知能体物，造化掌中删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狮林灵泉 其一","author":"徐宏祖","text":"千穟明珠孰为探，灵源绝顶见灵龛。\n湛摇松影雪千尺，冷浸梅花月一潭。\n碧玉眼中丹透液，青莲舌上露成甘。\n满林不乏人天供，洒作天花润法昙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狮林灵泉 其二","author":"徐宏祖","text":"静里泉流石忽穿，峰头明月斗娟娟。\n窍通骨节凉生髓，源自头颅玉作涎。\n只道醍醐天上落，直将沆瀣掌中悬。\n青衣丹凤寻常事，谁解灵源此更偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭静闻禅侣 其一","author":"徐宏祖","text":"晓共云关暮共龛，梵音镫影对偏安。\n禅销白骨空馀梦，瘦比黄花不耐寒。\n西望有山生死共，东瞻无侣去来难。\n故乡只道登高少，魂断天涯只独看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭静闻禅侣 其二","author":"徐宏祖","text":"崎岖千水复千山，戒染清流忍垢颜。\n鱼腹卧舟宁众谪，龙华寄榻转孤潸。\n可怜濒死人先别，未必浮生我独还。\n含泪痛君仍自痛，存亡分影不分关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭静闻禅侣 其三","author":"徐宏祖","text":"客里仍离病里人，别时还忆昔时身。\n死生忽地分今日，聚散经年共此晨。\n发足已拌随壑转，到头空唤过河频。\n半生瓢饮千山屐，断送枯骸瘴海滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭静闻禅侣 其四","author":"徐宏祖","text":"同向西南浪泊间，忽看仙侣坠飞鸢。\n不毛尚与名山隔，裹革难随故国旋。\n黄菊泪分千里道，白茅魂断五花烟。\n别君已许携君骨，夜夜空山泣杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭静闻禅侣 其五","author":"徐宏祖","text":"鹤影萍踪总莫凭，浮生谁为證三生。\n护经白刃身俱赘，守律清流唾不轻。\n一篑难将馀骨补，半涂空托寸心盟。\n别时已恐无时见，几度临行未肯行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭静闻禅侣 其六","author":"徐宏祖","text":"一番魔障一番憨，梦寐名山亦是贪。\n井不及泉无论九，河难问渡尚呼三。\n疲津此子心惟佛，移谷愚公骨作男。\n幻聚幻离俱幻相，好将生死梦同参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游桃花涧","author":"徐宏祖","text":"睡足山中雨，起探云里泉。\n重崖岚掩映，复道水潺湲。\n涧是桃花旧，波摇松影鲜。\n层层声捣石，矫矫势垂天。\n吼虎深藏峡，狂龙倒挂川。\n怒疑连壁坠，宛似趁风旋。\n玉迸丝丝立，珠倾个个圆。\n石文喧旧鼓，松韵协疏弦。\n转觉一山静，遥分众壑妍。\n我来当雨后，波去落衣边。\n洒雪魂俱白，披涛骨欲仙。\n谁施开峡斧，更赖买山钱。\n巧树皆垂臂，危岩并倚肩。\n石牵绡作幕，松滴翠为钿。\n隔坞飞云屣，淩空驾铁船。\n不愁山欲暮，共与水争先。\n何必寻三峡，还须受一廛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"补小香山梅花堂诗 其一","author":"徐宏祖","text":"佳迹空山漫记吴，幽人逸兴寄髯苏。\n种来香雾三千界，削就云根第一株。\n水月遥分大士供，阴晴递换小山图。\n片时脱尽尘凡梦，鹤骨森寒对玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"补小香山梅花堂诗 其二","author":"徐宏祖","text":"幻出烟萝傍玉京，须知片石是三生。\n春随香草千年艳，人与梅花一样清。\n混沌凿开云上下，崆峒坐倚月纵横。\n峰头且莫骑黄鹤，留遍江城铁笛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 绝顶四观 其一","author":"徐宏祖","text":"芙蓉万仞削中天，抟捥乾坤面面悬。\n势压东溟日半夜，天连北极雪千年。\n晴光西洱摇金镜，瑞色南云列绮筵。\n奇观尽收今古胜，帝庭呼吸独为偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其二 日观","author":"徐宏祖","text":"天门遥与海门通，夜半车轮透影红。\n不信下方犹梦寐，反疑忘打五更钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其三 雪观","author":"徐宏祖","text":"北辰咫尺玉龙眠，粉碎虚空雪万年。\n华表不惊辽海鹤，崆峒只对藐姑仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其四 海观","author":"徐宏祖","text":"万仞同归一壑沤，银河遥点九天秋。\n沧桑下届何须问，直已乘车到斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其五 云观","author":"徐宏祖","text":"白云本是山中物，南极祥光五色偏。\n蓦地兜罗成世界，一身却在玉毫巅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其六 华首重门","author":"徐宏祖","text":"巍崖高巩白云端，翠壁苍屏路几盘。\n重阙春藏天地老，双扉昼扃日星寒。\n金襕浩劫还依定，锦砌当空孰为攒。\n何必拈花问迦叶，岩岩直作破颜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其七 太子玄关","author":"徐宏祖","text":"菡萏亭亭倒影摩，淩空忽透枕中符。\n崆峒无迹潜翻岛，阆苑有天常在壶。\n影入循环双窍迥，座归呼吸一身孤。\n从兹脱尽人间滓，两腋风生骨欲苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其八 罗汉绝壁","author":"徐宏祖","text":"列景标霞景色酣，莫将枯寂觑云岚。\n面来绝壁云常定，放出重峦石共参。\n枝借翠微栖各一，水供香积献分三。\n藏头换骨形何幻，崖霭层层露法昙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其九 放光瑞影","author":"徐宏祖","text":"灵区回合转祥轮，五色氤氲法界新。\n透却尘关空即色，翻成宝相影皆真。\n蜃楼非海谁嘘气，玉镜中天独摄身。\n转觉一山凡草木，含晖濯影遍精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 浮屠绾胜两首之一 其十","author":"徐宏祖","text":"阿育当年愿力雄，万山深处露神功。\n诸天环向尖皆合，一柱孤撑建正中。\n胜压鳌峰仙锁钥，光摇鹫岭玉芙蓉。\n峰头王母如相过，长剑崆峒此又逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 浮屠绾胜两首之二 其十一","author":"徐宏祖","text":"谁将手影布神通，仙掌淩空结构重。\n震旦名山膺九锡，巽门文笔插双峰。\n翠微四壁开生面，金粟三天现法容。\n漫向慈恩誇做赋，滇南此日壮登封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其十二 瀑布腾空","author":"徐宏祖","text":"三支东向谁为钥，疋练中悬万壑前。\n鼎足共瞻鸡在后，涛头忽见马争先。\n珠玑错落九天影，冰雪翻成双壁喧。\n我欲倒骑玉龙背，峰头群鹤共翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 其十三 传衣古松","author":"徐宏祖","text":"碧树千寻云影重，淩风老干独朦茸。\n直将秦帝登封物，常作僧伽护法龙。\n鳞甲半天猿臂舞，幢幡千队凤毛缝。\n餐冰饱雪千年炼，还共拈花一笑供。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 古洞别天两首之一 其十四","author":"徐宏祖","text":"鸾鹤空山路渺茫，重峦绝处逗云房。\n何人天外能来往，有洞花间独閟藏。\n瑶草琼枝开自落，金茎玉乳滴还长。\n神龙百尺潭时护，不许桃花出夜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡山十景 古洞别天两首之二 其十五","author":"徐宏祖","text":"洞天原不在人寰，三派东边更仰攀。\n直到万峰穷极处，忽悬双阙窈冥间。\n碧桃开落门常在，玄鹤纵横路不关。\n东向蓬莱三万里，片云时去又时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上之回","author":"周瑛","text":"上之回，乐何极，回中道路无梗塞。\n北望单于庭，西瞻月支国。\n信使往来，干戈屏息，上还宫，益修德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题义门","author":"张孟兼","text":"孝不遗厥亲，义不辞君役。\n克全兹两端，稔足久雍睦。\n世俗习浇漓，君家仍朴遫。\n世俗尚浮屠，君家尊儒宿。\n文章夙擅名，道义素积蓄。\n覃恩表闾门，用是敦颓俗。\n末学勉追随，步趋恐不足。\n漫作短歌行，聊以将颂祝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其一 桑字","author":"张孟兼","text":"我思桃源山，林谷春昼长。\n云生岩石静，花落泉水香。\n笑我不归客，何年返耕桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其二 麻字","author":"张孟兼","text":"何年返耕桑，与子种桃花。\n山中寻白鹿，石上看红霞。\n竟日得辞后，相从饭胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其三 别字","author":"张孟兼","text":"相从饭胡麻，已与尘事绝。\n致身在烟霞，此心比冰雪。\n便当赋归来，共话经年别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其四 境字","author":"张孟兼","text":"共话经年别，令人发深省。\n悠悠感飘蓬，恋恋依乡井。\n漫尔结茅屋，遁迹桃源境。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其五 仍字","author":"张孟兼","text":"遁迹桃源境，日对青崚嶒。\n涧响惊夜雨，云寒冱春冰。\n况此人事绝，沈忧岂相仍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其六 鸡字","author":"张孟兼","text":"沈忧岂相仍，浩然乐幽栖。\n山空夜花落，木密春鸟啼。\n我厌朝市居，揽衣起闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其七 犬字","author":"张孟兼","text":"揽衣起闻鸡，寤寐恒展转。\n怀亲念已频，觐主颜觉腼。\n欲寻旧篱落，听吠山家犬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其八 晓字","author":"张孟兼","text":"听吠山家犬，烟霞故深窈。\n上拂穹宇高，下俯人寰小。\n泠然风露凉，落月林开晓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其九 夜字","author":"张孟兼","text":"落月林开晓，白云散幽舍。\n翩翩笙鹤回，井井神仙下。\n中有好修人，浩歌美清夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其十 空字","author":"张孟兼","text":"浩歌美清夜，翩翩挟天风。\n采芹碧涧底，看奕青云中。\n洞口有霜瀑，飞流落晴空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其十一 山字","author":"张孟兼","text":"飞流落晴空，青云上可攀。\n念子冰雪姿，愧我尘土颜。\n长歌采芝曲，白云满前山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其十二 自字","author":"张孟兼","text":"白云满前山，杳杳入苍翠。\n风清鹤在林，夜静月堕地。\n惟有屋下泉，汨汨来何自。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其十三 鹤字","author":"张孟兼","text":"汨汨来何自，泉鸣昼寂寞。\n春暖涧草生，鸟弄林花落。\n山人盍归来，为伴林间鹤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄桃源郑徵士 其十四 猿字","author":"张孟兼","text":"为伴林间鹤，松老枝叶繁。\n石烂不复觉，丹成竟忘言。\n幽响亦何处，云萝自啼猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]