明_1.csv","pointer":768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其三","author":"唐寅","text":"芦苇萧萧野渚秋，满蓑风雨独归舟。\n莫嫌此地风波恶，处处风波处处愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其四","author":"唐寅","text":"一丛楼阁空江上，日有群鸥伴苦吟。\n尽胜达官忧利害，五更霜里佩黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其五","author":"唐寅","text":"百尺松杉贴地青，布衣衲衲发星星。\n空山寂寞人声绝，狼虎中间读道经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画（十八首） 其二","author":"唐寅","text":"独木桥边倚树根，古藤阴里啸王孙。\n白云红树知多少，鸡犬人家自一村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其七","author":"唐寅","text":"邓尉山边七宝滩，高低如画好溪山。\n十年游赏经行遍，多少名题竹树间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其八","author":"唐寅","text":"绿阴清昼白猿啼，三峡桥边路欲迷。\n赖得泉声引归路，泉声呜咽路高低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其九","author":"唐寅","text":"酒旗瘦马行人路，灯火荒鸡细雨中。\n奔走十年才歇脚，偶看画景忽消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画（十八首） 其三","author":"唐寅","text":"杨柳阴浓夏日迟，村边高馆漫平池。\n邻翁挈盒乘清早，来决输赢昨日棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十一","author":"唐寅","text":"红树青山飞白云，骖驔鞍马踏斜曛。\n眼前景好诗难胜，炼不成词恼刹人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十二","author":"唐寅","text":"雪深山路滑于苔，自跨青驴得得来。\n为是仙翁诗帖报，鹿场僧寺鲜莓开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十三","author":"唐寅","text":"端阳竟渡楚江湄，纨裤分曹唱健词。\n画楫万枝飞鹢道，朱帘十二映娥眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十四","author":"唐寅","text":"磬口山茶绿萼梅，深红浅白一时开。\n分明蛮锦围屏里，露出佳人粉面来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十五","author":"唐寅","text":"草屋柴门无点尘，门前溪水绿粼粼。\n中间有甚堪图画，满坞桃花一醉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十六","author":"唐寅","text":"黄叶玲珑映落晖，木绵新补旧征衣。\n乡关阴少悠悠思，立马边山看雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十七","author":"唐寅","text":"班荆相对语劳劳，麻已沤成茧未缫。\n又是一番春计了，瓦盆儿女共村醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十八","author":"唐寅","text":"山亭寥落接人稀，泥补柴门叶补衣。\n不起竹床头似雪，已无心去问禅机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其十九","author":"唐寅","text":"系水接天三万顷，晚山连树一千重。\n呼它小艇过湖去，卧看斜阳江上峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其二十","author":"唐寅","text":"桃李春风好放怀，斗鸡走狗夕阳街。\n看花拼逐纷纷蝶，消得青丝几两鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其二十一","author":"唐寅","text":"松萝深径积莓苔，何事荆扉夜半开。\n犬吠嘹嘹惊夜梦，月明千里故人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其二十二","author":"唐寅","text":"桃花浪暖锦层层，勤尔渔郎莫下罨。\n恐有鲤鱼鳞甲变，龙门三月要蜚腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其二十三","author":"唐寅","text":"雪压江村阵作寒，园林俱是玉花攒。\n急须沽酒浇清冻，亦有疏梅唤客看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画廿四首 其二十四","author":"唐寅","text":"柴门深掩雪洋洋，榾柮能清此夜长。\n最是诗人安稳处，一编文字一炉香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画四首","author":"唐寅","text":"黄叶山家绕会琴，斜阳流水路阴阴。\n东西茅屋鸡豚社，气象粗疏有古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画四首","author":"唐寅","text":"绿水红桥夹杏花，数间茅屋似仙家。\n主人莫拒看花客，囊有青钱酒不赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画四首","author":"唐寅","text":"乌柏经霜叶已红，东南楼阁足秋风。\n画成此景还堪咏，炼在先生短句中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画四首","author":"唐寅","text":"飞雪蔽空无鸟迹，长山颠壑有人居。\n浩浩天地知谁坐，酌酒敌寒犹读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画四首","author":"唐寅","text":"峰前千涧玉潺潺，落日层层树里山。\n一段胜情谁领略，幽人虚阁俯沧湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画四首","author":"唐寅","text":"万仞芝山接太虚，一泓萍水娆吾庐。\n日长全赖棋消遣，计取输赢赌买鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画四首","author":"唐寅","text":"野店桃花万树低，春光多在画桥西。\n幽人自得寻芳兴，马背诗成路欲迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题倦绣图","author":"唐寅","text":"夜合花开香满庭，玉人停绣自含情。\n百花绣尽皆鲜巧，惟有鸳鸯绣不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"濂溪图","author":"唐寅","text":"草苫书斋石垒塘，栏杆委曲娆溪傍。\n方床石枕眠清昼，荷叶荷花互送香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七律诗咏齐云山","author":"唐寅","text":"摇落郊园九月余，秋山今日喜登初。\n霜林着色皆成画，雁字排空半草书。\n面檗才交情谊厚，孔方兄与往来疏。\n塞翁得失浑无累，胸次悠然觉静虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居图","author":"唐寅","text":"隐居深在碧山空，涧壑才堪侧步通。\n芋栗一园秋计足，僮奴百指治生同。\n短墙甃石牢牵荔，薄酒盈坛共转筒。\n我欲相随卜居去，此身一脱花尘红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五十言怀诗","author":"唐寅","text":"笑舞狂歌五十年，花中行乐月中眠。\n漫劳海内传名字，谁信腰间没酒钱。\n诗赋自惭称作者，众人疑道是神仙。\n些须做得工夫处，莫损心头一寸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"友鹤图","author":"唐寅","text":"名利悠悠两不羁，闲身偏与鹤相宜。\n怜渠缟素真吾匹，对比清臞即故知。\n日下吟行劳伴侣，松阳梦觉许追随。\n日来养就昂藏志，不逐鸡群伍细儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"唐寅","text":"若干生命若干春，有所丰收有所贫。\n曾见趋炎堪炙手，宁抛伫艳敢成仁。\n惯随忧恨零今古，难惹英雄泣鬼神。\n费尽工夫伤老大，不如抖擞作新人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"唐寅","text":"便纵拼争反下游，随波逐浪讵惭愁。\n庸夫碌碌惟虚灭，烈士昂昂岂罢休。\n说法双关如此乐，听诗万首向何忧。\n孤芳自赏雕虫老，兴尽尘封故纸楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"唐寅","text":"培风鸟瞰只神游，闹罢琼枝又恁愁。\n莫负心期飘泊路，岂知身锁静安楼。\n形骸托与自然寄，泥壤终将分子留。\n宁垦良田三百亩，不教堆起一坟丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"唐寅","text":"无风眼界白云悠，红雨心波漾尽头。\n纷簌簌然丛脞弃，脏兮兮地秽淫流。\n栋梁本色擎天柱，蝥贼原形钓欲。\n铲却筌蹄窥远奥，拈花莞尔有何愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"唐寅","text":"古春去也怅须臾，问尔能思几日无。\n何必伤心催发白，会当动手补颜朱。\n妙龄劝赏雄浑语，达士耻随迂阔夫。\n我醉欲眠拈一瓣，今生弭忘不教枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]