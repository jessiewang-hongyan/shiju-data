[{"title":"入长安","author":"邓云霄","text":"日月舆图壮帝京，九重宫阙望中明。\n西山爽气临仙掌，北极祥云绕禁城。\n一统车书当盛世，千门弦管动春声。\n素衣莫遣缁尘染，不用先誇入洛名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京秋怀三首 其一","author":"邓云霄","text":"万里霜天数雁行，飞书随处急秋防。\n渥洼漫道来天马，沙苑仍残旧骕骦。\n大树凉回风瑟瑟，高坛秋尽月苍苍。\n年来辽左功成否？\n愁见旄头夜夜光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京秋怀三首 其二","author":"邓云霄","text":"蓟门遥望古桑乾，易水萧萧风正寒。\n昔日悲歌传击筑，近时豪客亦探丸。\n太行西枕秦关险，碣石平吞晋甸宽。\n万世皇居元此地，旧图如在掌中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京秋怀三首 其三","author":"邓云霄","text":"碧蹄未见奏铙歌，闻道东倭已请和。\n边徼岂无秦日月，旁人休指晋铜驼。\n元戎拥幕虚谈战，圣主深居实止戈。\n试问唐皇经略后，到今营垒竟如何？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋宫词","author":"邓云霄","text":"夜来风雨六宫愁，人自伤心水自流。\n但羡舞腰偏入掌，谁怜团扇正迎秋。\n黄金不买相如赋，青鸟虚随阿母游。\n基酌姮娥奔月后，何如桑女陌东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安春日","author":"邓云霄","text":"春入皇州佳气多，五陵裘马日经过。\n燕回自学平阳舞，莺啭宜调子夜歌。\n竹下步来遗翠珥，花间笑出抱云和。\n谁怜南陌人如玉，独饲春吞怨绮罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日高梁桥同门诸君宴集","author":"邓云霄","text":"京陌红尘出郭稀，清江幽竹静相依。\n拍浮人世浑醒醉，节序他乡有是非。\n混迹微名惭吏隐，忧时孤剑岂雄飞。\n江南逐客无消息，一曲离骚易湿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄钱长人讯其多病","author":"邓云霄","text":"天入钱塘路渺茫，西湖秋色正苍苍。\n采残杜若人千里，望去蒹葭水一方。\n病渴黄庭消伏枕，闭关翠柏可为粮。\n青云自古怜同调，彩笔悲君尚芰裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其一","author":"邓云霄","text":"天涯何处未归人，六载吴门梦里身。\n浮世未知谁是主，秋云遥对雁为宾。\n乾坤双鬓凋黄叶，风雨千家怨白蘋。\n最爱南墙数竿竹，青青长伴宰官贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其二","author":"邓云霄","text":"千里云遥望已终，闲来愁坐漫书空。\n他乡涕泪黄花里，故国松楸白露中。\n古堞月明乌怨夜，虚堂人静木吟风。\n秋深暗抱皋鱼泣，天地茫茫恨未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其三","author":"邓云霄","text":"宦薄能令侠骨尊，西风客思满秋原。\n久居泽国谙吴语，每向江枫吊楚魂。\n暗里含沙犹射影，时来孤鹤忽乘轩。\n少年日逐专诸巷，袖有鱼肠未报恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其四","author":"邓云霄","text":"傲吏风尘强破颜，岁星浪迹寄人间。\n那堪对酒浮黄菊，自起开笼放白鹇。\n望去乡心随雁足，愁来丛桂遍秋山。\n修琴卖药饶生事，叹息迷津欲闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其五","author":"邓云霄","text":"地脉凋残决九河，妖风犹向祖陵过。\n清谈莫效群贤饮，忧国聊为五子歌。\n云外商声传玉树，槛边秋草近铜驼。\n贾生痛哭长沙远，北阙天高奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其六","author":"邓云霄","text":"吏隐吴门叹陆沉，尘途犹觉主恩深。\n曾闻圣帝投双璧，可念中人罢百金。\n瘴疠未收迁客骨，雪霜空叩贱臣心。\n凭高怅望休回首，落叶鸣蝉半不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其七","author":"邓云霄","text":"黄榆白草乱边风，索马寻源几凿空。\n莫遣骁骑横塞外，还防敌国在舟中。\n东南输挽无馀力，西北金缯及剧戎。\n诸将长城竟谁是？\n遥传平播已论功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门秋怀八首 其八","author":"邓云霄","text":"宦海沦人倍黯然，步虚犹自梦游仙。\n谁言叶县羁王子？\n亦有丹砂化稚川。\n蜗角功名同过隙，壶中日月浩无边。\n年来悟得浮生理，闲注黄庭手自编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其一","author":"邓云霄","text":"清昼人间更觉长，坐来春思正茫茫。\n和风送暖冲炎塞，芳草连天到朔方。\n索醉难逢千日酒，飞花空乱九回肠。\n主人愁绝耽狂药，蜂蝶尊前莫更狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其二","author":"邓云霄","text":"昼漏晨钟迥不闻，阴晴消息杳难分。\n春眠任噪门前雀，野献谁将涧底芹。\n地隔蓬莱环弱水，天高阊阖锁浮云。\n自惭拙宦偏沧落，需次经年未见君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其三","author":"邓云霄","text":"亭午昏阴鸟罢啼，微风斜雨转凄凄。\n蓟门留滞嗟燃桂，越客沉吟异执圭。\n曲沼点花明锦水，轻车蹴草破香泥。\n愁来预约高阳侣，晴日芳郊酒并携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其四","author":"邓云霄","text":"客意伤春似感秋，墓田寒食忆松楸。\n少年衣马矜三月，游子悲歌起四愁。\n天远孤鸿来岭表，风轻片角落城头。\n烟尘万里迷双眼，惆怅乡关倦倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其五","author":"邓云霄","text":"西苑芳湖绕绿堤，凫鹥鸂□浪参差。\n昆明不动旌旗影，汾水空思鼓棹词。\n好鸟闲啼三殿柳，和风长护万年枝。\n萋萋碧草欣承辇，伫望花阴彩仗移。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其六","author":"邓云霄","text":"载酒郊圻晚兴慵，愁心落日满卢龙。\n金元战地存遗垒，燕赵狂徒伏旧封。\n雨后黾蛙喧水草，荒馀鸡犬罢村舂。\n谁怜问柳寻花客，欲向松门伴赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其七","author":"邓云霄","text":"寒暑京华几暗移，槐阴草色静荆扉。\n堂虚燕子从教入，日永杨花好慢飞。\n海上乡书新到少，城中车马近来稀。\n纸屏石枕堪高卧，今世谁云隐吏非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京春怀八首 其八","author":"邓云霄","text":"豺虎中原尚爪牙，氛霾飒飒惨风沙。\n也知漆室能忧国，却笑荆门独忆家。\n宛马天山肥苜蓿，宣房春水涨桃花。\n老成南北烦筹策，翘首云边待相麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其一","author":"邓云霄","text":"芙蓉水落凤凰城，台馆翛然白玉京。\n秋色平分中夜月，风光偏借此宵晴。\n霜侵桂阙仙衣冷，轮度银河碧浪轻。\n欲向银蟾乞灵药，共骑黄鹤听吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其二","author":"邓云霄","text":"西来爽气净寥天，金粟飘香集绮筵。\n青女踏残燕市草，紫箫吹散蓟门烟。\n壮怀潦倒惟杯酒，往事凄凉自岁年。\n迢递故乡临桂水，愁看两地共婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其三","author":"邓云霄","text":"广寒游罢回龙驭，金母初归欲进桃。\n露湛玉盘铺白练，月翻宫瓦涌黄涛。\n楼前佳气西山近，殿上芳尊北斗高。\n独有微臣犹待诏，青云空愧旧宫袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其四","author":"邓云霄","text":"冉冉东流竟不回，年华漏箭暗相催。\n严风乱卷胡霜去，明月还浮朔吹来。\n白草连天迷渥水，黄金无地觅燕台。\n谁怜蹭蹬龙媒老，苜蓿蒲梢晚自哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其五","author":"邓云霄","text":"海外亭亭晓镜升，仙槎谁道兴难乘。\n遥闻桂子飘灵隐，忽忆涛声满广陵。\n夜永缓倾金凿落，人闲长坐玉壶冰。\n懒随道上遨游子，裘马红尘浪自矜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其六","author":"邓云霄","text":"云叶轻盈护月华，古堂虚白晚栖鸦。\n管弦人世新番曲，霓羽天孙自一家。\n泛渚可能期太乙，占星还欲摘匏瓜。\n丹砂未就残双鬓，此夕秋思未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其七","author":"邓云霄","text":"安仁官序黯惊秋，赖有深杯缓旅愁。\n笑挽天河聊漱齿，更听宫漏促传筹。\n十年偃蹇仍黄绶，万里羁栖易白头。\n谁念倦游心独苦，故山吾拟理菟裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其八","author":"邓云霄","text":"谁家玉笛叫层云，月引馀声送雁群。\n缥缈危栏人独倚，凄清深院客先闻。\n胡床暗忆先年弄，绛帐空传旧日文。\n最是天涯肠断处，落梅残柳更纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其九","author":"邓云霄","text":"万木萧萧玉露浓，汀兰岸芷若为容。\n正邀明月留澄景，休向浮云问旧踪。\n镜里关山同一点，人间道路隔千重。\n醉乡已悟能忘世，愿向金波化酒龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其十","author":"邓云霄","text":"游尘争度七香车，河汉纵横月未斜。\n望望歌楼凉似水，行行驰道白如沙。\n清风自扫扬雄宅，胜事全归石季家。\n过眼物华真瞬息，更留馀酝待黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其十一","author":"邓云霄","text":"斗挂城头夜漏深，疏桐澹澹月移阴。\n横塘迥对双珠定，阿阁斜衔半壁沉。\n霜露不凋青桂影，海天长系素娥心。\n寒衣夫授催刀尺，又听西风一片砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其十二","author":"邓云霄","text":"醉舞狂遗白接䍠，铜鞮终夜闹群儿。\n携壶秉烛有今夕，去燕来鸿又一时。\n世上功名浑是梦，酒中贤圣乃吾师。\n君看小阮追欢处，何必风流让习池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其十三","author":"邓云霄","text":"年来氛祲未全消，暮角边声入夜遥。\n逐虏有人逾北海，寄衣谁梦到西辽？\n尘迷汉月愁飞挽，云暗胡天失射雕。\n闻道前军犹未入，不知何日起嫖姚？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其十四","author":"邓云霄","text":"塔影风动金琅珰，夜如何其夜未央。\n南楼老子兴不浅，西方美人怀正长。\n三天云水自浩浩，九秋霜露徒茫茫。\n遥把一杯酹牛女，尔独无辜限河梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京中秋十五首 其十五","author":"邓云霄","text":"坐深凉露湿征衣，星聚人间此会稀。\n共道鹓鸾依北阙，谁怜乌鹊又南飞？\n烟销六代无新曲，潮落三山冷旧畿。\n他日停云念吾党，那能不饮醉方归？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其一 春日","author":"邓云霄","text":"上巳清明乐事仍，谁能寥落对孤僧？\n兔肥嫩草堪游猎，马凿新蹄试放鹰。\n鸣镝平原弓满月，割鲜荒店酒如渑。\n好携花债酬韦曲，更制春词拟杜陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其二 春宵","author":"邓云霄","text":"醉后铜街并马行，少年游侠气纵横。\n红楼尽是宜春苑，青帝先开不夜城。\n明月自随歌扇转，长河还向酒杯倾。\n呼关竟觅平康宿，守吏何须问姓名？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其三 春风","author":"邓云霄","text":"最爱封家十八姨，年年送暖赴春期。\n忽过小苑花争笑，轻度平林鸟不知。\n似是有心邀落絮，可能无意逐游丝。\n多情宋玉新词好，为语邻娃且自持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其四 春山","author":"邓云霄","text":"山中历日杳无期，洞口春风亦不私。\n古院人闲听早鸟，空坛花落覆残棋。\n遥怜地僻春归晚，莫怪云深客到迟。\n试问刘郎经别后，天台胜事几人知？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其五 春水","author":"邓云霄","text":"江楼倚壁结花龛，夜雨摧花响石潭。\n泛泛落英明似锦，盈盈远色浅拖蓝。\n鸥群浦外行相狎，渔父矶头偶共谈。\n不用招邀淇上女，笔床茶灶兴方酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其六 春花","author":"邓云霄","text":"金谷平阳翳绿莎，感时长叹复高歌。\n看春走马休辞远，骤雨狂风可奈何。\n野日无情流水急，啼鹃渐老落花多。\n三春日日须行乐，风俗谁论晋永和？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其七 春鸟","author":"邓云霄","text":"却厌时禽太有情，名园处处变春声。\n纵饶黄口能调哢，须识东风解长成。\n啼月暗催千户晓，呼烟遥报六街晴。\n寄言挟弹闲游子，好袖双柑去听莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其八 春蝶","author":"邓云霄","text":"谁化香魂逐早春？\n徘徊南陌更东邻。\n几家芳苑堪乘兴，若个游蜂是故人。\n榻罢滕王无俗事，梦回庄叟有闲身。\n坐看残粉飘红雨，花底深杯莫厌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜春九咏 其九 春蚕","author":"邓云霄","text":"五马踌蹰久未归，陌头愁见雉朝飞。\n眠多转觉蚕无力，桑老谁怜叶尽稀？\n心绪缠绵抽乱茧，啼痕乌咽理残机。\n才成半匹输官税，又向他家作嫁衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其一 秋柳","author":"邓云霄","text":"忆昔长条踠地垂，莺花醉杀五陵儿。\n可怜鶗鴂西风急，又被关山短笛吹。\n腰瘦楚宫无过辇，黛销隋苑有啼眉。\n请君回望红亭路，谁复临堤折一枝？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其二 秋桐","author":"邓云霄","text":"欹枕西窗夜寂寥，迎秋一叶已萧萧。\n露团金井千家冷，霜度龙门万里遥。\n晚咽寒蝉怜半落，朝翻警鹤叹全飘。\n幽人无限求凰意，闲抱朱弦倚树调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其三 秋枫","author":"邓云霄","text":"逐臣何处想遗踪？\n湛湛江枫淡更浓。\n枝叶可能留岁色，丹青倏已变秋容。\n悲缠宋玉招魂句，恨结寒山半夜钟。\n闲续遗骚愁不寐，感时怀古意千重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其四 秋槐","author":"邓云霄","text":"瀼瀼玉露气萧森，疏翠残黄半不禁。\n壁水市空惟落叶，文昌殿冷岂成阴。\n婆娑坐惜殷生树，哀怨长悬庾信心。\n已悟南柯浑是梦，休将摇落动孤吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其五 秋荷","author":"邓云霄","text":"凌波独立尔应难，绿袖红绡冉冉单。\n玉井峰头秋气早，若耶溪畔晚妆残。\n房空只有馀丝绕，心苦谁怜泣露寒？\n惆怅吴儿兼越女，棹歌归去若为欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其六 秋兰","author":"邓云霄","text":"秋至怀人各一方，幽兰愁绝隔潇湘。\n采来衣袖逢多露，寄去江关恨异乡。\n远道残香容易歇，同心暗结竟难忘。\n平皋飒飒催寒急，谁倩轻云护晚霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其七 秋菰","author":"邓云霄","text":"昆明池水起秋风，怜尔雕胡傍废宫。\n弱带枯茎斜照外，沉云宿雾乱流中。\n清波零落鱼龙夜，馀粒漂残雁鹜空。\n最是秋来衿枕冷，好将温席问渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其八 秋葭","author":"邓云霄","text":"日落平沙江路长，蒹葭凝望渺苍苍。\n数声孤雁天连水，八月凉风露化霜。\n絮入秋衣如薄茧，笳吹寒夜中清商。\n扁舟江上思归客，不待浮灰已断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其九 秋草","author":"邓云霄","text":"霜风初落剪寒莎，扰扰飞萤扑野蛾。\n色接黄云秋出塞，怨深青冢夜闻歌。\n苍茫古道行人少，迢递长堤返照多。\n幂历正伤时序改，王孙归思近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十 秋蝉","author":"邓云霄","text":"门巷萧疏秋色阑，哀蝉柳外几声残。\n跳枝择翳惊还咽，饮露含风瘦更寒。\n青镜暗调秦女鬓，素丝新入汉臣冠。\n弦中杀气催摇落，夜抚瑶琴不忍弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十一 秋燕","author":"邓云霄","text":"怜汝归期道路长，好依残垒更回翔。\n向来华屋非新主，何必乌衣是故乡。\n万里风尘劳往返，百年时序有炎凉。\n休论王谢堂前事，寥落秋思易感伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十二 秋雁","author":"邓云霄","text":"落木萧萧雁影疏，西风几处怨离居。\n遥看列阵能成字，可怪经秋不寄书。\n雪窖北来边月苦，衡阳南下楚天虚。\n伤弓避弋呼群急，此日羁人意有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十三 秋萤","author":"邓云霄","text":"夜雨孤灯起旅愁，隔帘摇飏一萤流。\n谁云腐草无生意？\n忽见明珠已暗投。\n读罢虚窗千卷冷，放残深院六宫秋。\n年华代谢流光促，对尔还须秉烛游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十四 秋角","author":"邓云霄","text":"片角长鸣落晓星，雄关铁锁欲开扃。\n城头浪奏单于曲，漠北谁空老上庭？\n惨惨寒吹边草白，呜呜悲咽野磷青。\n征人正切南归梦，起傍墩台数驿亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十五 秋烽","author":"邓云霄","text":"太白旄头夜并高，胡儿牧马过临洮。\n连营百道传烽火，飞檄三边插羽毛。\n光迸流星穿雁塞，气缠宝匣吼龙刀。\n捷书早达蓬莱殿，立马千门念正劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]