[{"title":"青社驿遇同年苏比部兄北上有赠","author":"王世贞","text":"小驿灯垂烬，无言思欲飞。\n十年君执戟，双鬓客沾衣。\n白骨徵求在，黄金故旧非。\n帝京如有问，早晚北山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长山道中","author":"王世贞","text":"荒禽暮俱敛，游子尚无还。\n道路真侨治，衣冠可驻颜。\n坐销长短日，惭问往来山。\n倘数人间地，何方定是閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐长山署中","author":"王世贞","text":"觅句惊从得，呼杯幸勿空。\n句堪今日老，杯借片时雄。\n项领纷成态，腰支转未工。\n翛翛故园竹，偏在月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中槐树摇落有感","author":"王世贞","text":"婆娑两槐树，生意若无冯。\n明月不相媚，朔风时见陵。\n枝寒过倦鸟，影瘦入残灯。\n为寄云烟道，春来倘郁蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"王世贞","text":"幞被据匡床，薰炉袅篆香。\n绪风低宿树，孤月净兼霜。\n戍鼓交偏缓，寒鸡报转长。\n不眠须起舞，尘匣暗干将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜独坐","author":"王世贞","text":"庭皋澹如水，袅袅雪仍垂。\n疏竹俄相并，栖乌迥对疑。\n垆香收煮茗，漏刻过吟诗。\n宴坐将何道，沈冥识者谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李伯承迁尚宝丞却寄","author":"王世贞","text":"偶展除书读，弹冠有姓名。\n谁其尚符玺，君未厌承明。\n儤直依温树，裁诗忆露茎。\n亦知东海上，蚤晚碧云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄顺甫比部","author":"王世贞","text":"展转今三仕，蹉跎尚一官。\n重来秋署色，恐失岁星寒。\n计悟空言晚，身容薄禄宽。\n祇应骑马出，庭雪映书残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应在明迁职方 其一","author":"王世贞","text":"忽汝新参幕，仍吾旧剖符。\n事违同涕泪，身在各艰虞。\n霜霰青阳晚，风尘白日孤。\n毋将岁寒意，宛转媚春芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应在明迁职方 其二","author":"王世贞","text":"国计轻犹昔，天威重至今。\n甲兵纷属口，冠盖失谋心。\n非尔登津要，何人挽陆沈。\n故园耕钓稳，吾岂厌投簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夜有感","author":"王世贞","text":"欲尽难留日，将归末果身。\n生涯元客岁，物意向王春。\n北极龙文古，明堂象魏新。\n鸣珂又朝列，谁与念波臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峻伯将至先以诗来走笔邀之","author":"王世贞","text":"忽报嵇康驾，频呼阮籍杯。\n乾坤双眼对，海岱故人来。\n雪入朱弦尽，春留綵笔开。\n欲东虽马首，无乃一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晴与峻伯游云门既别雪乃大作赋此志之且订后约","author":"王世贞","text":"为汝双吟屐，春天强放晴。\n雪仍降野色，冰复禁河声。\n但许同心在，那妨薄宦名。\n登临事何限，花鸟莫愁争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月","author":"王世贞","text":"二月今垂半，萧条海国城。\n绪寒停客梦，初雨泄春声。\n野草青从施，霜毛白更争。\n幽居废朋好，杯酒独峥嵘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自夹山趣颜神感古","author":"王世贞","text":"千秋此夹谷，驻马意徘徊。\n苍岭锋争向，青天线划开。\n人疑悬索度，水忆建瓶来。\n回首兵车地，虚生命世才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄子将诗及拟骚见贻酬赠二首 其一","author":"王世贞","text":"盛年辞水镜，垂老即林皋。\n今古双垂涕，乾坤一拟骚。\n恩非罢官薄，骨为著书高。\n沧海茫茫在，何人问钓鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄子将诗及拟骚见贻酬赠二首 其二","author":"王世贞","text":"天末空长剑，人间自曲钩。\n啖名殊代事，吞恨大江流。\n妙手斲轮得，雄心伏枥收。\n君看扬马后，馀子尽悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昌乐道中","author":"王世贞","text":"马足萦溪转，莺歌引樾听。\n波摇积气白，山琢断云青。\n细雨农颜破，轻寒客思停。\n绝怜疏柳外，出没小辎軿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪戊午正月李公事有感 其一","author":"王世贞","text":"变态风云伏，精灵日月移。\n盖棺终不定，前席竟无期。\n画地身从入，呼天听每迟。\n如逢九泉辙，倘可问袁丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪戊午正月李公事有感 其二","author":"王世贞","text":"岂谓夔龙席，翻然百态生。\n何人善阴中，为尔出阳惊。\n骠骑新门客，尚书旧履声。\n君恩与朋好，愁绝向谁明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪戊午正月李公事有感 其三","author":"王世贞","text":"荣悴一身竟，吹嘘万象过。\n望恩人自失，分泪客谁多。\n迹削施蒿薤，魂归恼薜萝。\n闽江自清绝，不接沅湘波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪戊午正月李公事有感 其四","author":"王世贞","text":"半面坊门识，私庭迹有无。\n亦知求骏骨，或拟下鹓雏。\n名玷山公草，心违孺子刍。\n平生国士意，落落满江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其一","author":"王世贞","text":"罢吏白云省，来司青帝丘。\n当时爽鸠氏，还作东诸侯。\n其乐已千载，吾踪仍九州。\n牛山毋雪涕，要使姓名留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其二","author":"王世贞","text":"蓟苑归鸿信，春风忍尽闻。\n胙茅诸部曲，持节旧参军。\n地脉秋毫补，天颜咫尺分。\n敢辞双鬓雪，持报圣明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其三","author":"王世贞","text":"不浅清尊兴，其如白羽何。\n春声生铁马，燧色隐铜驼。\n弃掷兵才易，艰危相业多。\n微官难即解，回首愧松萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其四","author":"王世贞","text":"尚忆游燕侣，新诗好共论。\n坛成人大将，鼎立几中原。\n放逐吾曹事，飘零圣主恩。\n营丘跨海岱，不拟赋招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其五","author":"王世贞","text":"国难孤谁共，天骄晚未擒。\n九重垂北顾，万死障南侵。\n急下明光诏，多分少府金。\n汝曹须戮力，今日主恩深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其六","author":"王世贞","text":"战鹢纷如昨，频添海戍长。\n岂应齐击技，不敌楚馀皇。\n耒挂妨春雨，笳吹咽晓霜。\n野夫冠侧注，愧尔绿沈枪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其七","author":"王世贞","text":"次第人间事，毋如且挂冠。\n青云李生失，紫气汉关寒。\n宦薄差相傍，书成已倦看。\n揽衣仍嚄唶，愁见万花残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其八","author":"王世贞","text":"末展疮痍骨，徵书十道来。\n乾坤漆室叹，将相柏梁才。\n忍病医从却，忧生酒浪催。\n当时嵇阮辈，跌宕有深哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其九","author":"王世贞","text":"五马初停驾，荒城鼓角淹。\n少年聚牛酒，亡命问鱼盐。\n鸥下微相信，鹰饥或已厌。\n重来暴公子，遮莫霁威严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青州杂感十首 其十","author":"王世贞","text":"坐哂缘何事，人间百态更。\n违心仍作语，逐面暂生情。\n名岂吹嘘重，身宁伏谒轻。\n输他鹦鹉赋，垂死亦纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦尽行高苑道中大风 其一","author":"王世贞","text":"三春行已尽，万象施仍偏。\n败屋蛛凭网，荒村柳但眠。\n白如瓯脱地，青岂汶阳田。\n为语流已态，将无愧俸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦尽行高苑道中大风 其二","author":"王世贞","text":"日色虚骀荡，风沙太獝狂。\n已令花似雪，复要鬓如霜。\n薄宦春从失，将归老不妨。\n青帘浊醪在，遮莫唤谁尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行视高苑决口有感","author":"王世贞","text":"岂无淇竹楗，汹汹势难回。\n野色存鸥鹭，春心辨草莱。\n中原瓠子口，使者柏梁台。\n纵有呼天恸，天门迥未开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰安戏呈徐张二使君索会 其一","author":"王世贞","text":"不有清尊在，何当慰折腰。\n倦来时自哂，狂至欲谁骄。\n岱色家家饱，岚云日日饶。\n岂无逃暑会，乘兴未须招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰安戏呈徐张二使君索会 其二","author":"王世贞","text":"高卧成吾懒，閒居任物情。\n开门稀候吏，隐几至啼莺。\n仗酒为公事，裁诗问友生。\n城南富修竹，何处可题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日陪段侍御游灵岩寺作","author":"王世贞","text":"群峰抱兰若，孤塔界晴空。\n未沐菩提雨，时闻薝卜风。\n使星聊一驻，佛日暂相同。\n倘借支公马，长陪鲍氏骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪段侍御登灵岩绝顶","author":"王世贞","text":"径折全疑尽，峰回陡自开。\n苍然万山色，忽拥岱宗来。\n碧涧传僧梵，青天落酒杯。\n雄风别有赋，不羡楚兰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日行园","author":"王世贞","text":"使君聊一出，物色自争誇。\n小雨饱桑叶，轻阴寒杏花。\n官厨枣儿酒，乡信谷前茶。\n不必莼鲈在，吾生固未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殿卿慰予哭子有答","author":"王世贞","text":"千崖送落日，愁思满齐山。\n非尔一贻好，何人为破颜。\n月疑庭玉在，星作掌珠还。\n卷罢新诗去，依然秋闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后 其一","author":"王世贞","text":"迁官非不好，衰态暗相催。\n草色将袍去，霜华拟鬓来。\n罢衙无长牍，呼酒有馀杯。\n且了今朝事，浮生次第裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后 其二","author":"王世贞","text":"谁道长安近，山城信自稀。\n隔秋除目到，罢览故人非。\n久不关吾事，频须理客衣。\n明年官不解，妻子也应归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王丈道立登魁选","author":"王世贞","text":"十载扬雄赋，诸生伏氏书。\n下帷多讲授，摇笔自吹嘘。\n价夺连城外，锋全百战馀。\n还将短瞿问，狗监尔何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弟侄俱荐赋此寄之","author":"王世贞","text":"磊落吾宗彦，参差万里翰。\n东南自金锡，王谢有琅玕。\n痴叔殊能健，狂兄未许难。\n将无杏园色，人拟竹林看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其一","author":"王世贞","text":"选极王裴重，交仍嵇阮偏。\n怀人倡白雪，矫首向高天。\n水鉴千秋在，风流一代专。\n新诗大自好，虚借野夫权。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其二","author":"王世贞","text":"屈指青云士，谁知张长公。\n孤吟破秋色，万木避天风。\n吾党殊能作，乾坤不可穷。\n毋论广武叹，竖子未英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其三","author":"王世贞","text":"跌宕尚书省，文章日更新。\n星辰仍长物，天地独私人。\n雾豹看从晦，云龙矫莫驯。\n南山有松柏，把臂问沈沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其四","author":"王世贞","text":"牢落诗如故，浮沉了不关。\n无人自流水，余志在名山。\n忽辱隋珠引，能容赵璧还。\n相期各努力，名姓堕人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其五","author":"王世贞","text":"不独宗吴辈，人今未可量。\n名多尔自失，身在欲谁强。\n斗剑悬中岳，霜雕击大荒。\n还闻有馀勇，䟤跋少年场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其六","author":"王世贞","text":"赤日浴沧海，青天横岱宗。\n汉家两司马，吾世一攀龙。\n病起千年态，徘徊绝代容。\n齐称君误矣，寥廓或云从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其七","author":"王世贞","text":"碣石诸侯馆，中原五子名。\n高秋白马辨，下士苍蝇声。\n风雨归何处，萍蓬托此生。\n使君仍鷩起，毋乃太纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答助甫吏部八首 其八","author":"王世贞","text":"莫作呼开府，衣冠一野人。\n几逢沧海雪，三远蓟门春。\n失计贫弹铗，从心老斲轮。\n齐风如稍稍，拂袖大江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答张幼于下第","author":"王世贞","text":"玉是连城价，兰为大国香。\n无言依正则，有泪待陵阳。\n白雪元堪寡，青云祇自荒。\n总应名就日，留滞亦文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别中表丈史鸿胪还吴 其一","author":"王世贞","text":"上客含鸡贵，中朝结驷难。\n家贫郎自免，身在酒相宽。\n草色营丘雨，潮声扬子寒。\n毋论两地隔，只羡一枝安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别中表丈史鸿胪还吴 其二","author":"王世贞","text":"少住为佳耳，亲朋尽岁孤。\n官厨饶脱粟，乡味有蒸壶。\n鲁酒能尝不，齐讴可听无。\n自然留不得，秋兴满莼鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午日长山署有怀 其一","author":"王世贞","text":"孤城逢此日，还忆去年期。\n只自饶三韭，那能辨五丝。\n欲眠须引卷，触热未呼卮。\n醒醉元同意，寥寥识者谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午日长山署有怀 其二","author":"王世贞","text":"昨岁还今日，追欢得似无。\n儿偏爱蹋草，女亦解倾蒲。\n倏忽浮生过，凄凉万事孤。\n掷他长命缕，不作系双珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得舍弟试文喜其必第走笔寄之","author":"王世贞","text":"文章家不乏，今尔更纵横。\n海上鸿雁色，秋空雕鹗鸣。\n此时汉京兆，下榻吴诸生。\n无限人间事，区区一第名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄顾圣少","author":"王世贞","text":"乾坤亦有意，纵汝向中原。\n只益新诗好，那扶游客尊。\n拂衣缘躄者，垂涕过夷门。\n数尽人间事，能如知己恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病卧东禅乞休未报殿卿相国驰骑相访书此为别","author":"王世贞","text":"拟作轻离别，如君来去何。\n诸天忽示态，初地欲生魔。\n白社风流少，青林月色多。\n留将烦恼意，回问病维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别殿卿时余方有家难","author":"王世贞","text":"河流如易水，日夜荡秋旻。\n不作登车去，能无恋故人。\n霜仍飞六月，虹未入三秦。\n一掬中原泪，难从握手论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"难后答和于鳞旧贻四首 其一","author":"王世贞","text":"燕台一掬泪，归洒大江湄。\n天地藏身小，风尘厌世迟。\n生宁如李志，死敢傍要离。\n寒雨松楸夕，那堪读汝诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"难后答和于鳞旧贻四首 其二","author":"王世贞","text":"屈指人间世，名成岂偶然。\n中原方轨在，畏路拂衣偏。\n病色高千古，穷愁自一天。\n可无沮溺耒，难并汶阳田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"难后答和于鳞旧贻四首 其三","author":"王世贞","text":"偶诵招魂语，惊心往事多。\n蹉跎吾计失，憔悴此生过。\n隐迹羞丛桂，诗章畏蓼莪。\n湘江暮烟色，愁绝意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"难后答和于鳞旧贻四首 其四","author":"王世贞","text":"何限乾坤事，归来汝自酬。\n振衣沧海月，摇笔岱云秋。\n一字堪金石，孤城各斗牛。\n报书知健在，不必泪潜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答于鳞立春日斋居对雪见怀","author":"王世贞","text":"春雪覆江干，江城春未阑。\n泄云千雉合，迎日万花残。\n雁色悬秋曙，鸡声破梦寒。\n如闻郢中调，祇为和人难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答于鳞慰哭子二首 其一","author":"王世贞","text":"谢庭三秀草，此夕九秋霜。\n埋玉丼憔悴，探环竟杳茫。\n寸肠存屡折，孤客斗谁强。\n为语西河泪，情今未可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答于鳞慰哭子二首 其二","author":"王世贞","text":"拟作东门达，那堪复泫然。\n壮惭儿女态，穷入故人怜。\n岁月危看影，乾坤怯问年。\n此身真瓠落，飘泊向谁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]