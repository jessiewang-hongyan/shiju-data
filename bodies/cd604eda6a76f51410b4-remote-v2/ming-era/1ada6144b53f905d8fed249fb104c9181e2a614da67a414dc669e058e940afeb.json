[{"title":"浔阳歌十首 其三","author":"孙一元","text":"安庆合围久莫摧，中原保障有奇才。\n半夜缒城三死士，艨冲百万只空回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳歌十首 其四","author":"孙一元","text":"金陵龙虎帝王基，石作城垣江作池。\n此是先皇开国地，留都万载莫轻窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳歌十首 其五","author":"孙一元","text":"中丞就义身难屈，宪副临危骂未休。\n要令后代看臣节，白日行天沧海流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳歌十首 其六","author":"孙一元","text":"潘鹏陷贼翻行说，刘李逆谋乃助奸。\n即日尔曹皆殄灭，一时天下愧儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳歌十首 其七","author":"孙一元","text":"兵戈北指犯天阍，未到南都势尽奔。\n一夜玉颜凋后舰，珊瑚宝玦泣王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳歌十首 其八","author":"孙一元","text":"内官白面坐喧呼，尽道能开五石弧。\n临敌一时皆扑灭，貂珰铁劵岂应图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳歌十首 其九","author":"孙一元","text":"王公众道善提兵，伍守临锋气亦横。\n大战长江看掎角，成功今日是书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳歌十首 其十","author":"孙一元","text":"闻道君王统六师，蛮兵百万羽林儿。\n亲征若果临南徼，江水今为饮马池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寻天台山水","author":"孙一元","text":"桃花洞口流水源，石梁桥畔古苔存。\n山人遥赠金鹅蕊，笑隔云光无一言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夜","author":"孙一元","text":"短瓶卧壁不尽饱，宿火向人还自青。\n明日梅花应作意，春风一夜打柴扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彭济物宪副雨中访予于吴山三茅观时予方醉卧分付童子未报伫久驰归既而马上戏成一绝见寄聊复奉答","author":"孙一元","text":"颓云压山山木黄，瓦沟鸣泉檐溜长。\n政恼门前立马岌，须便水底眠知章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上分韵同咏红梅忌绛雪胭脂丹砂霞色酒晕二首 其一","author":"孙一元","text":"皎皎从来忌太尤，司花别处与风流。\n就中根拨无人会，眼底还将物色求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上分韵同咏红梅忌绛雪胭脂丹砂霞色酒晕二首 其二","author":"孙一元","text":"平生正尔拟相亲，面着无言意更真。\n红拂敢疑颜色似，清风林下谢夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入天台山留别王河秀才","author":"孙一元","text":"挝鼓发行棹相闻，我在人间是离群。\n天台四万八千丈，遥弄云泉须忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归来","author":"孙一元","text":"望望江山阻且脩，归来泉石漫夷犹。\n黄尘瞥眼无人见，输与寒蝉自管秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残冬廿八日立春","author":"孙一元","text":"酒捷不堪逢过节，天涯霜雪正沦阴。\n百年我亦何为者，也费椒盘菜椀心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汀上","author":"孙一元","text":"汀上閒云收未了，望中白鸟影留双。\n乾坤此意何人画，吟到无声月满江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题文徵明画春江图二首 其一","author":"孙一元","text":"过午轻雷风色鲜，断虹迎日破寒烟。\n鸥清沙净宜诗句，旧日仙人白下船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题文徵明画春江图二首 其二","author":"孙一元","text":"野树无人阴自合，断峰隔岸雨犹青。\n鸬鹚鸂䳵留春住，正是江南杜若汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书张山人壁","author":"孙一元","text":"寻诗冲雪过山家，拄杖铿铿石径斜。\n自笑道人无长物，酒壶随处有梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏效汪京兆西湖六首为孙道甫书于湖之南屏山居 其一 问林和靖争孤山","author":"孙一元","text":"孤山君已占多春，此日还当让后人。\n千树梅花双舞鹤，也须着我白纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏效汪京兆西湖六首为孙道甫书于湖之南屏山居 其二 和靖答不允","author":"孙一元","text":"占断孤山五百春，暗香疏影句犹真。\n六桥烟月春无数，元属梅花旧主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏效汪京兆西湖六首为孙道甫书于湖之南屏山居 其三 固争","author":"孙一元","text":"我亦归来事隐沦，山灵已许不须嗔。\n乾坤风月无常主，要有当时领略人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏效汪京兆西湖六首为孙道甫书于湖之南屏山居 其四 和靖怒答","author":"孙一元","text":"鹤化梅枯地自春，岁时伏腊荐芳新。\n苏公堤在犹从姓，能道孤山更属人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏效汪京兆西湖六首为孙道甫书于湖之南屏山居 其五 解和","author":"孙一元","text":"昔人丛桂歌招隐，今日梅花肯见分。\n放鹤开笼亦不恶，抠衣长日愿从君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏效汪京兆西湖六首为孙道甫书于湖之南屏山居 其六 和靖许分孤山一半","author":"孙一元","text":"西湖十里春无数，夫子能来意亦嘉。\n烟水平分相对住，一山明月共梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居一首僧廉一清过访作赠","author":"孙一元","text":"过晨睡起发鬅髺，雨后茅檐树色增。\n下榻裹巾开药灶，敲门看竹有山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日","author":"孙一元","text":"晚风庭院静年芳，燕子归来草正长。\n莫道幽人无一事，灌花洗竹一春忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨起见菊花盛开有怀青田令殷近夫","author":"孙一元","text":"鸟下清晨日色净，起开双户照花幽。\n故人何恋五斗粟，不共东篱万斛舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李参戎汝盛手持白羽扇见遗口占奉答","author":"孙一元","text":"盛世何劳起卧龙，山林钟鼎道还同。\n直须着我青松下，岭月溪风指顾中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长吟","author":"孙一元","text":"落日射江江气深，微云薄树生秋阴。\n青山白日足幽事，着我长吟万木林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"睡起","author":"孙一元","text":"睡起行吟日过午，葛巾芒屩水云间。\n虎头食肉非吾事，要与图南分华山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梨花","author":"孙一元","text":"露华时为洗铅妆，剪剪轻风透越裳。\n深院无人吹玉笛，秋千斜搭月如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"栀花","author":"孙一元","text":"若为秋水淡妆成，缟袂青裙似有情。\n独倚西风弄秋影，向人无语可怜生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶然成诗","author":"孙一元","text":"诗书伴我真多事，云卧天行意自閒。\n半世论交遍天下，眼中惟觉有青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢安","author":"孙一元","text":"东山已慰苍生望，别墅风流太傅游。\n醉后犹传青海舞，白鸡梦断已千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陶潜","author":"孙一元","text":"江山万里云无色，归去柴桑日已斜。\n风景满前非故物，东篱采采独黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林逋","author":"孙一元","text":"开笼放鹤空山里，岩畔梅花野兴孤。\n天子当时重封禅，西湖合着老林逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人图六首 其一 斗草","author":"孙一元","text":"草色风晴绿满坡，佳人拾翠众相过。\n衣裳带得芳鲜气，一笑归来春意多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人图六首 其二 围棋","author":"孙一元","text":"棋局当窗笑语清，雁行云阵各纵横。\n缃帘疏簟无人见，庭鹤时惊落子声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人图六首 其三 鞦韆","author":"孙一元","text":"花下罗裳映縠文，鞦韆彩架簇春云。\n回头偶道金钗落，深院风清笑语闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人图六首 其四 蹴鞠","author":"孙一元","text":"宋祖英雄靖海疆，蹴戎犹自意难忘。\n春风别苑三千处，教得宫中此艺长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人图六首 其五 弹琴","author":"孙一元","text":"翠翘云髻有风仪，坐弄瑶琴日影移。\n性格聪明谁第一，辨弦应似蔡文姬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题美人图六首 其六 题诗","author":"孙一元","text":"花影亭亭日满阶，凤笺象管句新裁。\n因风柳絮真堪拟，谁有当年道韫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"睡起效赵子昂","author":"孙一元","text":"小窗酒醒夕阳低，草色撩人思欲迷。\n曳杖起来出门去，山樱子落竹鸡啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜渡江","author":"孙一元","text":"西风吹鬓绿䰐鬖，击榜长歌酒半酣。\n野月上船灯影乱，载将秋思过江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晓","author":"孙一元","text":"薄晓鸠声初睡起，山光半落竹门开。\n清风茗椀蒲团静，细雨春盘菜甲堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诗成","author":"孙一元","text":"短几兀言情自会，一诗才就夜三更。\n灯青火冷不成梦，残叶打窗送雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"妾薄命","author":"韩邦奇","text":"昔郎年少时，妾在兰闺中。\n见郎锦城西，绿駬嘶春风。\n妾作郎家妇，郎行万里舟。\n妾心无所愿，欲作长江流。\n妾不如春月，花开到郎侧。\n郎心匪飘风，妾无倾城色。\n桃花红复红，江水深复深。\n花红强似面，水深不如心。\n流萤度珠帘，秋夜长无极。\n为郎制罗衣，泪痕密如织。\n妾始嫁郎时，永言受郎恩。\n但得郎舟回，妾愿锁长门。\n岁序不可转，六月或清霜。\n郎岂无归日，时复理红装。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"买剑曲","author":"韩邦奇","text":"千金买宝剑，百金装赤鞘。\n意欲献上方，骑马长安道。\n剑拔风尘昏，囊贮血肉腥。\n古来游侠儿，一掷双丸青。\n瀚海忆?珉，天山起鼙鼓。\n落日照辕门，将军怒如虎。\n年少气亦侠，常思万户侯。\n磨刀桑乾河，欲唱大刀头。\n金印大如斗，旌旗百尺高。\n不上燕然山，不插侍中貂。\n少小事戎行，生长亦朔漠。\n君恩重如山，铁衣轻如葛。\n朔风萧萧来，七月如深秋。\n马腾槽边嘶，笑取金络头。\n男儿介冑身，死葬昆崙山。\n却笑班将军，生入玉门关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玄庵","author":"韩邦奇","text":"大化运气机，纲维不可测。\n至性有渊源，于人见天则。\n一觉明真境，西方谈空色。\n启关走龙虎，挥神凌八极。\n是非千万载，大易重消息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂意 其一","author":"韩邦奇","text":"昆岗峻且崇，凿出双玉华。\n磨之劳沙石，坚好无纤瑕。\n制为双玎珰，组以杂玄黄。\n其价且万镒，以佩君子裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂意 其二","author":"韩邦奇","text":"贵阳长灵杉，千章百尺高。\n秋来动风色，云外起天涛。\n负此栋梁材，生之万山隈。\n世无鲁公输，千载委荆莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂意 其三","author":"韩邦奇","text":"金门多良竹，春风生新枝。\n猗猗青且坚，薄言一采之。\n物用各各殊，感之重嗟吁。\n或为虞廷箫，或为吴姬竽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂意 其四","author":"韩邦奇","text":"灼灼槛中花，日结红芳友。\n惜此妍丽资，隳折佳人手。\n幽草涧边生，春发秋还荣。\n三叹牺牛身，使我泪沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋溪","author":"韩邦奇","text":"峨峨太原山，混混晋溪水。\n山有合抱材，水有蛟螭起。\n合抱作栋梁，蛟螭兴云雨。\n栋梁无条枝，云雨或愆期。\n造化有不能，物岂无参差。\n奋飞从神龙，未必乏行施。\n遽命许旌阳，我心实伤悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渭滨叟","author":"韩邦奇","text":"西伯本事商，后车载老人。\n岂期牧之野，空有十乱臣。\n我独负鹰扬，谈笑诛商辛。\n峨峨首阳山，其下渭之滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周公居东","author":"韩邦奇","text":"周公王懿亲，进退系安危。\n居东二年馀，四海皆嗟咨。\n二公位阿衡，未见出一词。\n王以风雷变，出郊亲逆之。\n各各怀忠诚，二公心始知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹃声至","author":"韩邦奇","text":"洛阳鹃声至，尔意亦何勤。\n宋室诸缙绅，谁为达紫宸。\n莫谓禽无知，性或灵于人。\n负尔数声血，千载徒悲辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐世绩","author":"韩邦奇","text":"宗室杀欲尽，污秽蒸宸扆。\n太宗托孤心，是谁乱唐纪。\n智哉浴血儿，火烧不能死。\n火烧儿不死，于以见天理。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"骆宾王","author":"韩邦奇","text":"狄梁回凶牝，房州还东宫。\n敬业伸大义，挥戈振群蒙。\n烈烈宾王檄，如日当天中。\n宁为敬业死，不立狄梁功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张紫岩浚","author":"韩邦奇","text":"黄阁主和议，紫岩志恢复。\n听之真可人，谁有孔明腹。\n曲端既已诛，武穆见忤触。\n试使当筵舞，再蒙宣和辱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殷谢","author":"韩邦奇","text":"深源与安石，皆为士望宗。\n天子徵浩入，于以抗桓公。\n嗟嗟桓晋间，谁复识变通。\n智哉东山子，苍生戏高崧。\n感此殷谢事，成败论英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人不归 其一","author":"韩邦奇","text":"忆我莫苦吟，苦吟伤子心。\n寄子莫忘归，忘归失我依。\n清清在山泉，忽为九仞渊。\n流水不复返，我心日惨惨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人不归 其二","author":"韩邦奇","text":"客自河曲来，寄我双鲤鱼。\n长跪接鲤鱼，或有尺素书。\n剖鱼乃空腹，使我心成疽。\n生此女子身，不如委沟渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金台送士人归关中","author":"韩邦奇","text":"朔风惊客耳，归兴难攀牵。\n游缰系长柳，带剑登祖筵。\n把酒共叹息，逼侧何足怜。\n霜雪蔽天地，征裳独蹁跹。\n众芳满洲渚，老雁新饥还。\n君志在商岭，浩歌出幽燕。\n闲云落南浦，野鸟入青天。\n谁爱黄金台，不必重凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"檗谷　王侍郎图","author":"韩邦奇","text":"王子自闽来，揪愀颜色枯。\n须臾陨双泪，语我檗谷图。\n旻天覆下土，林鸦亦哺雏。\n我独失其怙，怀抱泣呱呱。\n哀此北堂人，青春抚遗孤。\n中道复弃捐，旻天降虐肤。\n晨鸡入省视，茕茕鲜盘壶。\n今也稍丰裕，肥甘逮妻孥。\n敝庐多寒暑，簟裀无褐蒲。\n冠裳锡双诰，安得奉桑榆。\n旻天覆下土，不闻予号呼。\n桐棺薄如墨，土浅且坟垆。\n兹能读丧礼，空有龙虎区。\n朝露零春华，秋霜寒如铺。\n牲醴亦嘉旨，安得奉庖厨。\n旻天覆下土，胡戾独予诛。\n空山柏如金，其味苦如荼。\n茫茫风木恨，直与乾坤俱。\n闻之重感伤，为君歌且都。\n努力树名德，毋愧曾闵徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郭遗叟　雷给舍翁","author":"韩邦奇","text":"给舍展绡帙，示我遗叟行。\n读之三叹息，乃识虚与盈。\n遗叟尚玄德，位独弗称情。\n给舍圭璋器，唾手公与卿。\n遗叟吴皋彦，早岁负才名。\n持笔谒天曹，文章冠群英。\n今观畿辅地，遍野甘棠生。\n温温清苑判，施泽先孤茕。\n挺挺松柏资，虬枝霜雪劲。\n嗤被莺与燕，视我同春荣。\n玄鹤已千仞，刷羽云霄鸣。\n郭东有梅竹，良友堪同盟。\n相随咏舞雩，心与贤圣并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"富阳民谣","author":"韩邦奇","text":"富阳江之鱼，富阳山之茶。\n鱼肥卖我子，茶香破我家。\n采茶妇，捕鱼夫，官府拷掠无完肤。\n昊天胡不仁，此地亦何辜。\n鱼胡不生别县，茶胡不生别都。\n富阳山，何日摧，富阳江，何日枯。\n山摧茶亦死，江枮鱼始无。\n山难摧，江难枯，我民不可苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中集古十六首　东岩同扉 其一","author":"韩邦奇","text":"天地身何往，故乡不可思。\n萧萧北风劲，惨惨中肠悲。\n多病久加饭，开怀无愧辞。\n眼前列杻械，报主尔何迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]