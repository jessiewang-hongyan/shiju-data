[{"title":"岁晏江行","author":"苏葵","text":"人家无远近，压酒候新年。\n一枕江行梦，千峰雪霁天。\n寒梅惟迸竹，孤鹤不群鹯。\n击楫谁来听，前汀有钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲游","author":"苏葵","text":"随柳傍花我，吟风弄月谁。\n眼赊图画迥，意远杖藜迟。\n雪重松明叶，云深竹没枝。\n忘言当此际，争敢强成诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过山村 其一","author":"苏葵","text":"之玄云外路，凹凸雨中山。\n竹密亭台隐，花深鸟雀闲。\n挂瓢巢父在，采药葛翁还。\n便欲投簪组，分渠屋半间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过山村 其二","author":"苏葵","text":"水曲山盘转，萧森野趣多。\n鹤鸣松露冷，麛卧草烟和。\n云子常时饭，霜藤异样蓑。\n乡名无告语，疑是硕人阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴","author":"苏葵","text":"溪狭直如带，林深半欲遮。\n傍花惟客棹，隔竹见人家。\n宦况随春水，诗情逐晚霞。\n所须无过分，数亩白鸥沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨深","author":"苏葵","text":"雨深何水混，濯足舞儿曹。\n云影寻常没，溪痕倏忽高。\n乾坤无砥柱，江汉有波涛。\n笑上匡庐顶，从教罔象号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春","author":"苏葵","text":"生长默成聚，时光疾转车。\n花无留树朵，草尽迸阶芽。\n何处曾宣惠，中林有列罝。\n送春多感慨，半不为韶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中即事","author":"苏葵","text":"旂常无寸业，白首愧江湖。\n不当奇男子，能甘贱丈夫。\n道穷人觉惫，时在我忘痡。\n霜月篷窗冷，篝灯看禹谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日江行","author":"苏葵","text":"春晓泛官艖，天空眼界赊。\n岸容烟截断，山影日推斜。\n花鸟随时句，江湖到处家。\n东门有馀地，思种邵平瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老志","author":"苏葵","text":"老志未消磨，常时苦切磋。\n心闲赢事省，学浅怪书多。\n未履明诚境，能祛富贵魔。\n朝闻甘夕死，鞭辟更无他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江","author":"苏葵","text":"气爽浮烟尽，秋江处处明。\n水清鸥自照，滩浅鹤横行。\n漱急尘襟静，流闲世事平。\n边头有渔父，谁称后车迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津遣怀","author":"苏葵","text":"阁棹倚江湄，湄寒透敝衣。\n喜瞻星斗拱，愁见雁南飞。\n日减晁生智，年多伯玉非。\n菁莪无寸补，碌碌笑忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题金山寺","author":"苏葵","text":"尘少僧多戒，流环地若丸。\n江涵龙钵润，月浸佛衣寒。\n罨画孤吟壮，晴明四望宽。\n谁将牙侩语，容易诮杨蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日江行漫兴","author":"苏葵","text":"采石至彭蠡，江湖千里赊。\n风帆趁朝暮，时见水明霞。\n沙鸟氄焦尾，霜芦飘朽花。\n行人更南去，直到粤天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登岳阳楼","author":"苏葵","text":"湖波馀万顷，吞吐岳阳楼。\n星汉应低接，天池或未优。\n远疑无岸起，近觉有山浮。\n图画天然妙，凭空一目收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江漫兴","author":"苏葵","text":"江行秋气肃，黄叶点征篷。\n日落山腰暝，霞蒸水底红。\n远天鸿个个，近渚苇丛丛。\n羁思无人话，移船狎钓翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残腊写怀 其一","author":"苏葵","text":"物态不常故，春光将欲新。\n谁深丹鼎术，予误白头身。\n公牍偏妨懒，官资不疗贫。\n那能如海鹤，一举离风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残腊写怀 其二","author":"苏葵","text":"历头随众换，老态自家添。\n酒不华衰貌，霜能变短髯。\n声驰犹剑吷，囊口愧锥尖。\n欲把生涯卜，成都少姓严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残腊写怀 其三","author":"苏葵","text":"予甚怪残腊，留之不少延。\n逢人闲论岁，屈指遽添年。\n邓禹缘谁笑，冯唐每自怜。\n旧盟王子晋，相候在芝田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残腊写怀 其四","author":"苏葵","text":"寥寥青史业，滚滚白头诗。\n饯岁浑忘老，逢人欲卖痴。\n耽杯惭侧弁，读易玩颠颐。\n寄语悲丝客，如今或不缁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中漫书","author":"苏葵","text":"雨敲疏竹响，风入短帘开。\n味古怜书在，谈今欠客来。\n鹪鹩能慰藉，鳷鹊漫徘徊。\n谁信清幽意，天然在柏台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静坐用前韵","author":"苏葵","text":"耽幽尘漫拂，习懒卷慵开。\n宇宙常舒豁，风花自去来。\n括囊占偶值，隐几梦初回。\n欲与孙登语，无缘上啸台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治乙丑二月宪长入觐予暂署堂事比得代就间戏而赋此","author":"苏葵","text":"大隐隐朝市，谁今是隐魁。\n雨声闲枕簟，竹色小亭台。\n高阁刑书束，常时笑口开。\n虽然赢得懒，终愧我非才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀","author":"苏葵","text":"一官才四品，白雪已盈头。\n廊庙勋名薄，乾坤笑语优。\n宁为鼓缶乐，肯作蹙眉忧。\n试问巴江水，人间第几流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴二首 其一","author":"苏葵","text":"羁愁随暑退，浊酒为秋倾。\n骤雨苔阶静，微凉薤簟清。\n远天孤鹤磨，近树一蝉鸣。\n无可供閒适，聊吹子晋笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴二首 其二","author":"苏葵","text":"天入新秋迥，无云万里明。\n露梧沾凤翥，风竹和鸢声。\n否去三阴尽，丰来万宝成。\n空庭那复事，玩易自怡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵期杨陈二同寅枉顾小叙","author":"苏葵","text":"梧桐秋色半，菰米雁声初。\n作兴凭杯酒，劳形厌簿书。\n烟花撩我甚，岁月为谁馀。\n欲枉高轩过，焚香扫敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒岳武穆墓二首 其一","author":"苏葵","text":"敷天左袒不须疑，误溺偏安失事机。\n天运未移宗社在，御衣曾付阁门归。\n书生先叩胡儿马，奸相终衔岳字旗。\n千百年来冤恨在，雨中松柏尚歔欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒岳武穆墓二首 其二","author":"苏葵","text":"伯仲之间见武侯，中原一鹗正横秋。\n诸君未痛黄龙饮，片纸翻令白日愁。\n万里长城真自坏，十年积力为何休。\n可怜壮士中兴恨，百二山河半未收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵寄故园诸兄弟","author":"苏葵","text":"霜冷天空白雁飞，凤凰台上几沾衣。\n一灯夜雨心常在，万里秋江梦亦归。\n醉客酒杯随处好，入怀人事异乡非。\n明朝又发金陵道，搔首长吟对落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伤雨","author":"苏葵","text":"东南赤子尽穷愁，两月玄冥注未休。\n百堵已乖终老计，一成多误养生谋。\n如天自信神尧德，决海谁承大禹忧。\n欲向三台问调燮，黑云犹在半空浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题琼州牛挥使静学轩卷","author":"苏葵","text":"夜半清斋默坐时，今人心与古人驰。\n光风霁月近窗几，细雨落花飘墨池。\n却縠自堪元帅荐，逢辰曾荷主君知。\n天南狼鬣通宵暗，宜把龙泉换陟釐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭天锡大尹之任德兴","author":"苏葵","text":"出饯鸱夷尽泼醅，故人发马自金台。\n牛刀有用姑先试，凫舄如飞及早来。\n翠柳未堪今日赠，碧桃须学昔人栽。\n闾阎剩有疲癃者，莫谓元非百里才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题胡人献马图","author":"苏葵","text":"皇明仁化被诸羌，坐使腥膻俯首降。\n不在将军挥斧钺，自来廷陛献骊黄。\n云中从此狼烟息，天厩新增骏骨强。\n盛事小臣今目击，贰师何用出燉煌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽宗侄勿斋","author":"苏葵","text":"阮籍平生爱仲容，招来时复自溪东。\n纵游共信身如客，永诀宁知子未翁。\n野鹤正多今日怨，闲花休绽去年丛。\n哭君无限怜君意，四十年华一梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题节斋卷","author":"苏葵","text":"闲倚西风坐一斋，笑看花卉受风排。\n平生不作浮沈态，行止宁移得丧阶。\n长乐遗名悲此老，独清馀韵在吾侪。\n百年落落谁应赏，只藉松筠会素怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄钟粤太守受知于总督秦公时用兵田州公以太守董役玺书褒奖秦公并及太守赋此贺之","author":"苏葵","text":"圣主如天雨露饶，潢池兵甲未全消。\n从来渤海才堪托，可恨楼兰首合枭。\n万里凤书褒节度，上方龙剑付嫖姚。\n凭君莫负知人鉴，麟阁丹青在后描。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过张曲江祠","author":"苏葵","text":"不是开元愿治时，可怜金鼎又危机。\n诸人未识胡儿相，一语翻招汉主疑。\n花鸟曲江供白首，风尘灵武换朱衣。\n古今用舍多慷慨，聊奠祠前酒一卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送镇国梁上舍归新会","author":"苏葵","text":"世路悠悠半是非，仲宣楼上倚斜晖。\n莺花帝里三年老，云树圭峰一发微。\n谁信浮名浑似梦，自怜为客不如归。\n何时共掬江门水，洗尽红尘旧著衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予入京日陈公甫先生曾有言见赠稿付诗邮遗之赋此寄奉用索再录","author":"苏葵","text":"茅笔亲书白陟釐，邮筒故与客舟违。\n夜深星斗虚摇落，春老龙蛇或解飞。\n风雅未应今在逸，咸韶元是古来稀。\n青天万里双眸断，一幅何因付雁归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送友南归","author":"苏葵","text":"别路悠悠过十年，此时何处送君还。\n莺花鱼藻东风里，凤阁龙楼北斗边。\n景物颇偿寻胜愿，江湖甘费买舟钱。\n迎门稚子牵衣日，芦橘杨梅次第鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事呈王子敬太史同寅","author":"苏葵","text":"世态秋云不可言，酒酣耽坐老僧禅。\n细将往事从头检，只爱浮名到手先。\n碌碌自怜蕉鹿梦，劳劳谁谢茧丝缠。\n焚香剪烛空斋静，读尽南华内外篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥除夕","author":"苏葵","text":"钟鼓楼头报岁除，五更春入敝裘初。\n桃符自把寻佳句，银鬓谁教逼老夫。\n城市人家闻爆竹，海蠡杯子酌屠苏。\n太平叨禄无裨补，只教嵩呼近御炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽刑部夏司务","author":"苏葵","text":"轩昂天地作男儿，病入膏肓不可支。\n三十六芝无觅处，百千万劫是空时。\n清朝芳誉于公狱，衰草平原有道碑。\n何事英魂堪自慰，吾人公论哭君诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓延耀侍讲母太孺人挽章侍讲之兄任主事孺人能通女范诸书","author":"苏葵","text":"读尽人间女范书，今之贤母古何如。\n霞帔朱翟双龙诰，粉署词垣两凤雏。\n玉兔夜阑仙药冷，瑶池春老碧桃枯。\n乾坤有恨愁云起，锁断三山海一隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽周少宰先君大司寇庄懿公","author":"苏葵","text":"谁将唐肆论浮生，一代殊勋百代名。\n红日倾心葵萼老，白头归梦菊花清。\n天门左角星俄暗，翁仲前头草自荣。\n人物似公真不易，直从西汉细论评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端阳偶书呈梁洗马先生","author":"苏葵","text":"又持杯酒饯端阳，四十年来未拜郎。\n章句坐慵随日忘，鬓毛催老逐茎黄。\n行藏自现侏儒节，通变谁多内史囊。\n闲向空庭玩兰蕙，一回经雨一回香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄故园久要晦峰","author":"苏葵","text":"客路风沙几转忙，长髯凋折短髯苍。\n将来好事还多少，过去浮生已半强。\n竽食自矜彤管秃，酒酣犹梦白莲香。\n知君也有相思意，明月天南海北长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与张侍御黄司厅夜坐论诗","author":"苏葵","text":"掀髯寒夜语喃喃，半醉灯前落影三。\n客邸乡音歌白雪，瓦瓶春色酿黄柑。\n如禅未解寻因果，似路谁先得指南。\n此日诗坛无李杜，望旗衔璧几人甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐漫书","author":"苏葵","text":"抖擞尘埃两袖长，空庭寂寂月华凉。\n何人世路非疣赘，此夜心斋学坐忘。\n厚薄未分东郭老，机关浑是汉阴亡。\n呼儿爚茗清毛孔，啜到卢仝四碗强。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送马汝砺秋官左迁庐州郡判","author":"苏葵","text":"得失从容信丈夫，送行聊且尽新酤。\n生涯此日浑无定，公论如君不久孤。\n南国儿童争竹马，西曹风采照冰壶。\n江山满眼清人思，笑杀虞卿别著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送乡友潘君南还二首 其一","author":"苏葵","text":"君是閒人也入京，谁将公事误闲情。\n纵看天上莺花好，只记山中鹤梦清。\n亲旧抟沙尊酒尽，帆樯归路海波平。\n头颅我愧陶弘景，欲向西樵共月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送乡友潘君南还二首 其二","author":"苏葵","text":"台佟原是爱深山，才出山来便欲还。\n漫笑词臣忧国瘦，不如高鸟背人闲。\n他乡就我三春后，旅食骑驴两月间。\n卸却肩头官担子，一筇挑月向梅关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李希贤检讨雨中见示","author":"苏葵","text":"夏日炎蒸可奈何，洗天凉雨不嫌多。\n儿童学得商羊舞，帘箔看渠石燕过。\n满目郊园回白稿，一时蔀屋喜衰皤。\n先生未就藤床睡，思和陶唐击壤歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴献臣大尹奏绩还治三首 其一","author":"苏葵","text":"世情绝口且衔杯，明日仙凫去又来。\n风雪故裘应未敝，江湖佳句正堪裁。\n轩昂不问山公启，感慨谁寻郭隗台。\n旧植桃花已成列，不妨多著一番开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴献臣大尹奏绩还治三首 其二","author":"苏葵","text":"何人豪气贯虹霓，论绩天曹首不低。\n千古江山留即墨，一时人物想祁奚。\n梅花漾月清诗梦，雪色封尘净马蹄。\n醉里送君吾亦愧，荐贤无疏漫新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴献臣大尹奏绩还治三首 其三","author":"苏葵","text":"看到圭峰又定山，一囊诗卷入长安。\n郑公台下谁知蔑，光范门前却笑韩。\n何处儿曹仍竹马，此时公论付衣冠。\n十年已破升沈闷，肯复汀洲采杜兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢吴明府为建牌坊","author":"苏葵","text":"清时竽食自惭惶，谁建江村太史坊。\n百尺檐阿留宿雾，数层丹碧映朝阳。\n高飞燕雀应交贺，晚学儿孙或激昂。\n此意几番图报称，绝无琼玖探诗囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜饮李黄门第以技马较胜负约五负者罚诗一首予数负赋此呈同饮诸公","author":"苏葵","text":"吟坛老将果谁堪，主醉留髡却忘酣。\n举觯诗筹催叠五，落机阁马谟持三。\n未从元白承衣钵，欲向曹刘问指南。\n酩酊不须论胜负，一时良会亦新谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林粉署乃翁荣寿图","author":"苏葵","text":"鹤发萧萧拜敕封，又将人瑞看人龙。\n常宜五鼎承颜养，闲借三芝益寿功。\n此日儿孙深自庆，何人风格可渠同。\n八闽不与函关近，却是青牛背上翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日偶成二首 其一","author":"苏葵","text":"摄提不与土牛期，彩杖初挥斗柄移。\n老我乾坤非有意，迎春庭院可无诗。\n天机滚滚怜刍狗，世事悠悠付奕棋。\n谁道东风无彼此，短帘才隔到差迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日偶成二首 其二","author":"苏葵","text":"寒尽今朝春又来，天机原不费安排。\n闲将彩胜谈遗事，更酌屠苏放老怀。\n花为氤氲抽蓓蕾，草知消息到根荄。\n方头未会乘时术，玄静谁疑是打乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邝敦仁之云南经藩","author":"苏葵","text":"马蹄蹀躞望乌蛮，世事茫茫道路艰。\n食禄有方怜独远，忧时无术笑谁顽。\n侵垣月向薇花冷，动幕风清燕子闲。\n明日曲肱怀旧约，梦飞先到碧鸡山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜召用遗贤白沙陈献章","author":"苏葵","text":"曾过江门拜此翁，何人风致可渠同。\n文章山斗唐韩愈，理数图书洛邵雍。\n忘世昔曾疑荷蒉，济时今始兆飞熊。\n千年廊庙求遗栋，才到卢冈百尺松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庆成宴和寅长程正之韵","author":"苏葵","text":"日射彤闱扇影开，大官供宴小臣陪。\n九成仙乐腾腾舞，百和香烟袅袅来。\n何代云龙当景运，此时鱼水罄深杯。\n料应太史明朝奏，五色祥云护玉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日和韵","author":"苏葵","text":"新烟煮酩昼冥濛，原上游人几处同。\n罗袂软拖芳草碧，玉颜深压小桃红。\n鞦韆架上钗斜燕，车马桥头袜步虹。\n傍柳随花付年少，自将诗句领春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]