[{"title":"登岳四首 其三","author":"林大春","text":"来迎者羽士，言共访仙踪。\n峡隐真人骨，峰窥玉女容。\n神林龙骑入，天路凤旗重。\n更见磨厓石，千秋纪汉封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登岳四首 其四","author":"林大春","text":"客思登临动，山光远近开。\n风烟尽东望，天地忽西来。\n城拥咸阳树，春生渭北台。\n翛然怅归路，车骑满尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"骊山除夕对雪呈卢明府二首 其一","author":"林大春","text":"马首西入秦，骊山东向人。\n腊残惊旅鬓，日晚倦风尘。\n古殿连云尽，温泉带雪新。\n长安兹不远，明发汉家春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"骊山除夕对雪呈卢明府二首 其二","author":"林大春","text":"雪意连西岳，空濛满上林。\n年华兼日暮，天意与冬深。\n暗隐珠宫色，寒流玉树音。\n阳春自同调，应入郢人吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安惠王挽词","author":"林大春","text":"天人推夙德，朝野望音徽。\n一自从游去，求仙遂不归。\n邹枚词赋尽，闽越谏书稀。\n惟有小山曲，愁随丹旐飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登灵州城楼别丘懋实二首 其一","author":"林大春","text":"昔别怜君病，兹逢笑独留。\n客中仍下榻，醉里更登楼。\n野树乘春发，沙云带日流。\n离怀当此际，况复是边头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登灵州城楼别丘懋实二首 其二","author":"林大春","text":"共有纫兰约，非关攀桂留。\n临风倚长剑，对月忆南楼。\n塞上春光满，天边清梦流。\n美人如问讯，为出玉搔头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林寺","author":"林大春","text":"客行乘夏日，霖雨带秋阴。\n云接虎溪暗，山藏莲社深。\n远公已寂寞，陶令此登临。\n胜迹真谁记，空林猿暮吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丰城逢夏子还都余尚南征","author":"林大春","text":"清夜见龙光，苍茫入豫章。\n主人复行客，游子尚他乡。\n蝉意含秋远，江声引夏长。\n明朝重相望，南北渺烟霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭张启东四首 其一","author":"林大春","text":"昔年闻汝讣，凄断恍虚无。\n今日迟予至，那堪见汝孤。\n乾坤馀短剑，霄汉哭长途。\n回首忽三载，秋坟卧绿芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭张启东四首 其二","author":"林大春","text":"五岳行堪遍，诸山入望低。\n高谈天地晚，浪迹死生齐。\n楚璧终难献，燕台怅欲迷。\n犹怀鹦鹉赋，归卧凤凰溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭张启东四首 其三","author":"林大春","text":"留滞值时危，高才合数奇。\n相看戎马日，送尔国门时。\n江汉孤舟远，秋风鸿雁迟。\n谁知当日泪，不是为生离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭张启东四首 其四","author":"林大春","text":"论交千载上，世路眼俱青。\n抗节怜徐稚，卑栖似管宁。\n南海悲朝露，西京返使星。\n归来馀一哭，山雨为凄零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过萧氏园亭二首 其一","author":"林大春","text":"远客乘秋至，秋亭四望开。\n烟霞犹小隐，岁月此重来。\n海内频书疏，山间独酒杯。\n应思旧游处，几复问昭台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过萧氏园亭二首 其二","author":"林大春","text":"蒋诩开新径，丘园已自名。\n青山来远近，碧海递微明。\n月下亭初静，天高秋有声。\n客来时一醉，谁是羊求生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赵氏墓图","author":"林大春","text":"真隐人何处，佳城此郁盘。\n玉棺曾驻马，碧树总栖鸾。\n地引山灵合，天分海气寒。\n谁怜庐墓意，千古共悲看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月居岭表得惟重书自都下十一月渡江闻惟重秋中使节入湖南却赴章水","author":"林大春","text":"书至犹燕阙，秋来汉水边。\n衣冠游楚客，箫鼓下江船。\n抵为寻张华，还应忆仲宣。\n何当乘逸兴，飞旆日南天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其一 其一荣寿堂","author":"林大春","text":"卜筑依清汉，华堂拥翠微。\n北辰严倚阁，南极蔼临扉。\n仙醴行歌席，天香落舞衣。\n愿言长此地，岁岁醉恩辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其二 其二惜阴轩","author":"林大春","text":"诗礼趋贤子，光阴仰圣传。\n言持采芝赋，来问凌云篇。\n帘燕衔书湿，檐花点墨鲜。\n窥园应未暇，须以日为年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其三 其三月光亭","author":"林大春","text":"皓魄出江东，孤亭先映空。\n老翁歌拟扇，稚子学为弓。\n宝树参差发，瑶台远近同。\n悠然谢庄赋，萧瑟起秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其四 其四活水池","author":"林大春","text":"活水开明镜，寻源坐碧澜。\n幽深接江汉，清浅入峰峦。\n王母筵方启，山公兴未阑。\n临书时尽黑，独抱夜珠看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其五 其五流觞坞","author":"林大春","text":"种竹三为径，疏泉曲作池。\n山阴元胜集，河朔更吾师。\n旋绕飞觞出，欢呼坐客移。\n酒酣还自记，不让右军词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其六 其六烟柳堤","author":"林大春","text":"春柳护春堤，春烟晓望西。\n曲声风处断，飞絮雪来迷。\n黄觉鸣莺入，白看振鹭低。\n徵君东有宅，漉酒正堪携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其七 其七三槐亩","author":"林大春","text":"春事动经丘，修槐荫广畴。\n微云澹新绿，小雨破先秋。\n本自三公贵，何须万户侯。\n兴移置堂宇，千载挹风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾徵君家园诗八首 其八 其八拳石峰","author":"林大春","text":"选石玫瑰积，真成高士峰。\n洞云盘紫柏，溪月泛芙蓉。\n宝气时能见，丹砂或自逢。\n何当访玄豹，从此驾苍龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西署白云楼为云间董原汉","author":"林大春","text":"楼上白云满，云间是故乡。\n山川辨纡曲，天地睹圆方。\n灾异谁能问，从游见不妨。\n昔人称大隐，此意一何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠顾少府顾董生舅也生于其行有渭阳之思焉请予为赋是诗","author":"林大春","text":"渭阳愁送客，车马望遥岑。\n为诵琼瑰赋，因知山水心。\n鹤飞江树渺，龙去海云深。\n时自闻吴咏，无劳怅越吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿云霄驿","author":"林大春","text":"三秋为汉使，万里度云霄。\n月下传砧急，风高拥节遥。\n浮烟收野市，宿雨断江桥。\n一梦清如水，悠悠见圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度闽关有怀","author":"林大春","text":"复此度关吟，天寒岁欲深。\n江云行渺渺，岭树坐阴阴。\n白日仍投璧，清宵有却金。\n管宁何处在，辽海忆同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上闻董原汉以言事谪戍蛮方慨然有述","author":"林大春","text":"故人禦魑魅，而我尚飘萍。\n伏阙报主日，浮湘老客星。\n瘴烟怜地远，肺病忆时宁。\n却愧群贤后，宁忘汗简青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖亭二首 其一","author":"林大春","text":"见说湖山胜，亭虚客未归。\n空怀放鹤处，尚想钓鱼矶。\n天际孤帆小，云中清磬微。\n何当返兰棹，一制薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖亭二首 其二","author":"林大春","text":"平生重高义，十载赋长杨。\n国士心应苦，王孙兴未忘。\n豪游尽宛洛，雅调杂齐梁。\n为问湖中事，松筠半已荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邹广文之潮","author":"林大春","text":"今日送邹阳，梁园芳草长。\n江行春共远，岭宿意俱苍。\n山险分闽越，天开见凤凰。\n悠然怀往路，不觉忆吾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢广文之潮阳","author":"林大春","text":"吾邑昌黎后，斯文远至今。\n由来风不薄，此去道须任。\n晓月江帆小，春云岭路深。\n逢迎如有问，为报岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨剑州","author":"林大春","text":"昔为衡岳卧，今向蜀门游。\n何得楚云雨，西之剑水头。\n霸图悲跃马，天险笑通牛。\n无路从君去，翻然思壮猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈明府改任德安德安江右冲邑也","author":"林大春","text":"复此尚方赐，犹乘潘令车。\n河阳留不得，怀县意何如。\n吴越徵兵日，东南过客初。\n人生关气象，名肯让匡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王节士卷","author":"林大春","text":"碧海烽烟起，青山转战长。\n千夫齐瞰敌，一死为勤王。\n铁骑悲秋草，金戈泣晓霜。\n犹馀英爽在，时护水西乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王长史八十二寿诗","author":"林大春","text":"戴礼名家旧，王门上客题。\n辞归非楚穆，寿考似磻溪。\n山静卿云起，江空山仗齐。\n諠传迎汉诏，今过董胶西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中访戴和陈正郎同年韵","author":"林大春","text":"同云出汉署，结驷共怀贤。\n地僻疑招隐，杯深问草玄。\n御沟低玉树，仙阙起瑶天。\n忽听朱弦奏，难和白雪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送辉县赵少尹","author":"林大春","text":"十载汉公车，共城拜秩初。\n才堪鸾凤侣，地本竹林居。\n露坐闻清啸，山行见古书。\n中原民力尽，何以佐军储。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别戴筠台使岭外","author":"林大春","text":"青门别汉使，离恨满秋空。\n气合雕龙外，名高画省中。\n园林愁积雾，岭海望长风。\n定有罗浮月，随君访葛洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送章员外佥宪广右","author":"林大春","text":"谁言五岭外，西去帝城遥。\n风物悲虞狩，江山属汉朝。\n天高法曜转，日出瘴烟消。\n千古勋名在，君看铜柱标。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将归先寄舍弟","author":"林大春","text":"壮志苦难酬，孤怀厌薄游。\n看书惊母病，伏枕泪先流。\n即日须陈疏，清秋定买舟。\n因风寄鸿雁，一为解亲愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿山海关梦为梁甫吟","author":"林大春","text":"重关对摇落，孤馆罢登临。\n海日青宵出，山云紫塞深。\n马思千里道，梦识百年心。\n未遂南阳卧，空为梁甫吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意","author":"林大春","text":"见说西征急，征夫行路难。\n初闻度辽海，复道返长安。\n传箭几时歇，寄书何处看。\n秋宵散银烛，独照锦衾寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中睡起怀刘山人","author":"林大春","text":"夙有山中约，兹行意若何。\n江村到处好，风雨暮来多。\n画舸星宵入，文帏客曙过。\n因君动幽思，清梦绕烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"林大春","text":"镇日孤舟卧，清宵坐看山。\n呼童听落叶，对月问离颜。\n楼阁行将近，帆樯去不还。\n愁心与秋水，一夜到乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蚤起得舟字","author":"林大春","text":"客鬓忽萧飕，长河急暝流。\n舳舻千里暮，桐叶一天秋。\n云净瞻南斗，风清忆上游。\n狂歌叹留滞，为待李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日奉命南征","author":"林大春","text":"促织鸣高树，微霜已载途。\n十年怀汉节，千里借兵符。\n地道遥分楚，江山半入吴。\n传闻赤壁战，烽火一时无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅夜","author":"林大春","text":"深夜候明发，重云未肯开。\n幽襟仍宛转，孤咏且徘徊。\n风急鸦声散，灯寒雁影来。\n翻思金阙路，雪里赐貂回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄州刘使君旧隐其堂上有徐相国所赠诗章在焉","author":"林大春","text":"丞相题诗处，幽人昔考槃。\n汉家新剑履，楚国旧衣冠。\n秋觉蟾光入，风知玉树寒。\n时闻山简醉，莫作习池看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题曹封君双寿异徵卷二首 其一","author":"林大春","text":"蜀道回舆日，鹿门同隐时。\n烟霞长作主，琴剑与诸儿。\n芝本商山种，桃疑阆苑移。\n名闻汉皇帝，白首载恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题曹封君双寿异徵卷二首 其二","author":"林大春","text":"逆旅悲尘世，浮生抵懵然。\n因之悟物理，早已识真诠。\n天赐齐眉寿，人思化鹤年。\n宁知终孝者，犹自泣诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上","author":"林大春","text":"经秋为北客，此日渡江东。\n隔岸花相似，看山路不同。\n虫喧时作雨，月晕晚惊风。\n独有双龙剑，苍茫吐白虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庐山道中","author":"林大春","text":"为爱匡庐好，终朝骑马行。\n低回山涧出，缭绕径花明。\n寺古僧初定，溪閒虎不鸣。\n谁能绝顶上，愁看海云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安庆渡江次韵陈推府见赠之作","author":"林大春","text":"故里今寥落，因君愁思开。\n飘飖怜独往，慷慨念群才。\n峰晓孤帆度，江昏片雨来。\n不知重会日，何处共登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东乡逢抚州陈使君以诗见别次韵奉答","author":"林大春","text":"忆别时闻政，相逢却问诗。\n已看黄犊满，似怪紫麟迟。\n江海今须会，风云重所思。\n赠君有兰芷，秋暮以为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过泰和得刘广文在潮信息其弟同诸侄携酒夜过","author":"林大春","text":"之子官犹冷，潮阳信始回。\n豺狼他日斗，鸿雁昨宵来。\n画舫凌风泊，青樽傍月开。\n故园有松桂，尽是不凡材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读杨文贞公家世德录二首 其一","author":"林大春","text":"忠贞称世笃，家学本渊源。\n相业三朝重，书香奕叶存。\n崧高生为国，宣召死衔恩。\n况是弘农后，清风可更论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读杨文贞公家世德录二首 其二","author":"林大春","text":"草昧攀龙日，朝阳起凤年。\n赐书存故老，遗训入新编。\n社稷功难并，天曹事可传。\n将来有名彦，应不愧前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忧起刘广文见招以病不赴诗以寄怀","author":"林大春","text":"相约梅花候，相过杨柳初。\n讵知多病后，犹是积愁馀。\n野兴诗从减，春风鬓欲疏。\n空怀刘子骏，应著太常书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬郑使君见访有怀之作","author":"林大春","text":"偶卧宁逃俗，长慵合避人。\n比邻时独往，意气晚愈真。\n细雨青山近，秋空皓月新。\n犹闻传羽檄，却恐到蒲轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢广文之衡阳","author":"林大春","text":"江城严鼓角，送客值愁时。\n浮海存吾道，临岐动尔书。\n山传龙度远，秋识雁回迟。\n何日岣嵝上，披云觅禹碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李参谋","author":"林大春","text":"幕府称多士，如君独擅名。\n丹心同许国，白首坐论兵。\n湖海观天象，风云结地营。\n功成忽归去，却笑弃繻生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滨海遗思卷为何潮州","author":"林大春","text":"地远沧溟北，天高揭岭东。\n共言歌召父，何意失文翁。\n庙貌烽烟后，人情涕泪中。\n犹馀韩子木，萧飒起秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"起复赴京途闻赵良弼自辽东领郡之顺德寻以母忧奔汝上因取道过其庐访之怅然为别四首 其一","author":"林大春","text":"万里惊离别，三秋雁渺茫。\n徒闻滞辽左，不道借淮阳。\n旅客悲关塞，孤臣忆庙廊。\n那堪萱草折，垂泪动江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"起复赴京途闻赵良弼自辽东领郡之顺德寻以母忧奔汝上因取道过其庐访之怅然为别四首 其二","author":"林大春","text":"夙有东都好，言过叔度庐。\n门前馀辙迹，客至见图书。\n林暖秋藏笋，溪寒夕荐鱼。\n犹怀将母意，惆怅对篮舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"起复赴京途闻赵良弼自辽东领郡之顺德寻以母忧奔汝上因取道过其庐访之怅然为别四首 其三","author":"林大春","text":"贱子嗟行役，慈闱昼掩扉。\n恨穷东海水，愁绝北山薇。\n宇内交游断，天边心事非。\n谁知当日泪，偏洒故人衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]