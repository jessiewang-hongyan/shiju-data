[{"title":"张参戎园十首 其八","author":"顾璘","text":"石洞夜何扃，云归宿杳冥。\n海天藏蜃气，山雨带龙腥。\n大隐聊同憩，高飞本自灵。\n翻然看出轴，万里震风霆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其九","author":"顾璘","text":"怪石㟏岈立，雄姿对吐吞。\n平泉三品贵，泰岳丈人尊。\n总谓云根秀，谁当砥柱存。\n定教狂老米，袍笏拜辕门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其十","author":"顾璘","text":"将军池下水，洗砚变成玄。\n地觉风流胜，人疑造化偏。\n龙蟠云共黑，鹅戏雪矜妍。\n报尔山阴县，王家旧事传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送紫光禄入贺嘉礼二首 其一","author":"顾璘","text":"十年天禄阁，白首老杨雄。\n直谏名犹戆，新诗语太工。\n遥瞻温室树，缓步禁墀风。\n应傍炉烟里，还过青琐东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送紫光禄入贺嘉礼二首 其二","author":"顾璘","text":"礼正群心协，恩覃万国欢。\n月轮重合璧，云鉴更翔鸾。\n露草沾行佩，风花扑去鞍。\n新笺文尔雅，传书九重看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"永宁寺春游和殷文济二首 其一","author":"顾璘","text":"胜侣皆灵运，名僧有道林。\n行歌穿竹径，醉舞占花阴。\n寺好偏宜古，山幽不厌深。\n春城无限酒，爱向野间斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"永宁寺春游和殷文济二首 其二","author":"顾璘","text":"有怀思痛饮，无病爱春游。\n地主全双美，禅心破百忧。\n鸟啼连树响，花落照溪流。\n莫怪城闉隔，山中醉可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿祝釐寺值雨","author":"顾璘","text":"名山堪避俗，好雨更宜人。\n尘净竹林翠，堂虚金气新。\n焚香残夜火，荐粥煮秋莼。\n转觉空门趋，能令客意亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答摄泉见寿","author":"顾璘","text":"迹忝绯衣后，心疏白发前。\n常时来古寺，独坐听鸣泉。\n露榭临花饮，星床傍鹤眠。\n有书浑懒读，将欲废丹铅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"内官坟祠","author":"顾璘","text":"寂寞近臣祠，天恩不在滋。\n冢寒长作燐，树蠹半流脂。\n未睹铭功鼎，空传护敕碑。\n遭逢固应有，王制恐非宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日与诸文士息园宴集各赋一首","author":"顾璘","text":"上客东吴彦，芳樽脩竹林。\n飞觞催染翰，列炬耀华簪。\n蕉叶暮阴合，薇花秋序深。\n清言蔼群玉，雅义重兼金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孟中丞后园","author":"顾璘","text":"客有丹霞想，官居洞壑随。\n松云沾散帙，竹月照衔卮。\n吏隐谁兼遂，风流众所推。\n时邀二三子，高咏习家池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张郎中宅晚集同孟中丞","author":"顾璘","text":"曲榭临秋水，芳筵及暮钟。\n稽康真野鹤，郭泰总人龙。\n赋接风襟爽，杯浮露醑浓。\n霜威方豫悦，玉漏合从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日郊游同刘希尹祭陈中丞墓","author":"顾璘","text":"翠壁含纤雨，丹榆醉晚秋。\n幽寻今雅社，胜槩旧皇州。\n时序登临兴，江山浩荡愁。\n侯巴情不极，肠断子云丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同刘子登雨花台","author":"顾璘","text":"登台秋色远，对酒暮云生。\n海气浮金阙，人烟接锦城。\n伫谈王霸迹，转见古今情。\n江水东流急，滔滔无尽声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送盛箴","author":"顾璘","text":"博学苏明允，多才盛孝章。\n计偕随汉荐，宾发自周乡。\n雄剑照秋水，青袍含御香。\n遗珠君莫叹，天子重明扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朱氏园对月","author":"顾璘","text":"清秋多逸兴，月出更相宜。\n城郭沧洲迥，园林白露滋。\n竹深邀送酒，鱼跃喜鸣丝。\n忍向寒光底，徒归不咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送袁经历归信阳","author":"顾璘","text":"旧业申台下，归心汝水东。\n人皆干厚禄，君独有高风。\n学圃家园侧，逃禅野寺中。\n青天云雾豁，流目送冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吕太史仲木舍对菊三首 其一","author":"顾璘","text":"客心惊日月，对尔惜年芳。\n取醉开金盏，流馨满玉堂。\n不辞霜霰苦，聊伴鬓毛苍。\n寂寂青宵半，含情傍烛光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吕太史仲木舍对菊三首 其二","author":"顾璘","text":"幽贞移楚泽，摇落对吴天。\n采采三秋后，依依独客边。\n深杯摇素月，孤烛耿寒烟。\n一别陶彭泽，何人更尔怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吕太史仲木舍对菊三首 其三","author":"顾璘","text":"飘蓬俱异域，聚面复都城。\n幽兴关时物，衰年恋友生。\n黄花堪一醉，白发苦多情。\n坐久浑忘去，邻鸡且莫鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许彦明过息园同作","author":"顾璘","text":"永日青林静，来过赋采薇。\n琴尊留晚兴，泉石借清辉。\n翠筱经年密，丹榴过夏稀。\n秋风知尚早，梁燕遽先归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"保叔寺","author":"顾璘","text":"阁饮云相对，钟鸣客倒听。\n林风兼夏爽，山霭过湖青。\n济胜身俱健，逃禅意己冥。\n诗成多秀句，转益道心灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和刘光禄观潮","author":"顾璘","text":"把酒惊潮至，鸣丝且罢弹。\n钱王莫漫射，枚客正须观。\n涛捲日争白，鲲腾天让宽。\n当筵疑溅雪，醉舞不知寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月八日饮振衣亭归有怀三首 其一","author":"顾璘","text":"胜地湖山槩，浮生啸咏情。\n崖倾松径仄，亭远石门横。\n暇日衣堪振，秋天酒共清。\n城昏合归去，林月向谁明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月八日饮振衣亭归有怀三首 其二","author":"顾璘","text":"落日山亭饮，含情迟月华。\n高秋何负我，远客正思家。\n桓老开萸酒，陶公把菊花。\n匏尊空野兴，菽水自天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月八日饮振衣亭归有怀三首 其三","author":"顾璘","text":"主客临高赏，江湖近座流。\n长筵欺短日，浊酒傲清秋。\n亭榭开新迹，风烟惬壮游。\n不知千载上，谁醉此山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠枢使李竹坡四首 其一","author":"顾璘","text":"台郡论交日，青云属望劳。\n韬钤顾荣扇，契合吕虔刀。\n王事输肝胆，军容肃羽旄。\n每从公退处，杯酒接风骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠枢使李竹坡四首 其二","author":"顾璘","text":"薇垣参下列，枢府喜同升。\n迹忝双龙起，才看一鹗腾。\n诸侯趋紫绶，直道引朱绳。\n独立将军树，谦光众口称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠枢使李竹坡四首 其三","author":"顾璘","text":"忆遂楼船后，朝天上赤墀。\n衣冠同拜舞，殿陛借光仪。\n击楫春江稳，投壶夜漏迟。\n往来行乐意，披豁慰支离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠枢使李竹坡四首 其四","author":"顾璘","text":"垂老东藩长，官联复对君。\n交亲方有数，勋业更超群。\n气压麒麟阁，春生虎豹军。\n吾方栖退舍，端坐羡风云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都城春雪","author":"顾璘","text":"白雪尔何意，经春犹漫飞。\n节移青帝令，寒逼远臣衣。\n物态伤摇落，天心惧隐微。\n客居愁不寐，开阁望朝晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答郑礼部继之","author":"顾璘","text":"寥落混风尘，怜君意独亲。\n同吟山郡雪，稍醉帝城春。\n海月通幽思，宫莺咤远臣。\n期寻石梁去，还待谪仙人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同蒋参军子云七弟英玉登青龙山","author":"顾璘","text":"蹑履青龙阜，天虚四望幽。\n山河吴楚槩，城郭古今愁。\n杯就高云泻，诗临怪石留。\n多情红叶树，邀醉梵园秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同二子宿祈泽寺","author":"顾璘","text":"寒宵宿古寺，爱尔且淹留。\n忽向蒋生径，仍登谢氏楼。\n词华依玉树，行李敝貂裘。\n为乐须閒散，那能待白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙女泉","author":"顾璘","text":"神女乘云去，灵泉满涧清。\n蛟龙馀窟宅，雷雨变阴晴。\n乐饮来浮斝，劳歌对濯缨。\n还期明月夜，同听佩环声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古银杏","author":"顾璘","text":"突兀蔽庭户，长绳那可量。\n抡材掩荆楚，问岁失萧梁。\n云实时堪结，雷枝半已荒。\n离奇难尔用，匠石转神伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画胡","author":"顾璘","text":"历历尘沙貌，棱嶒怪尔殊。\n寒云缠毳服，猛气映虬须。\n万里明王贡，群方混一图。\n追伤衰晋末，无力斩休屠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏仲昭画竹","author":"顾璘","text":"石濑涓涓水，风篁袅袅枝。\n尘途贪见画，草阁梦题诗。\n枕簟横秋薄，樽罍过月迟。\n苍林殊可老，朱绂果何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻边廷实已有三男戏寄","author":"顾璘","text":"商瞿四十后，已有几男儿。\n满目麒麟种，惊人鸑鷟姿。\n问名堪屈指，学语遂传诗。\n想像提携乐，闺中卧每迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈鲁南上陵","author":"顾璘","text":"松柏西陵路，词臣冷节来。\n衣冠瞻汉寝，弓剑拜轩台。\n细雨春山湿，明星夜殿开。\n年年挥泪地，不得长苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与太史鲁南游西山二首 其一","author":"顾璘","text":"城阙三千界，烟花一万重。\n漫乘金腰袅，同玩玉夫容。\n景色伤心丽，春光引兴浓。\n来游乘暇日，佳处合从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与太史鲁南游西山二首 其二","author":"顾璘","text":"净域藏春远，羁游出郭迟。\n马骄翻碧草，莺老宿深枝。\n行乐浮生梦，风光故国思。\n谢君催晓发，垂老遂幽期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饭普惠寺","author":"顾璘","text":"绿树邀行骑，青山拥寺门。\n不劳钟磬响，久厌市朝喧。\n解带榆烟午，钩帘竹日暄。\n老僧锄菜甲，随意具盘餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登平坡寺","author":"顾璘","text":"云里平坡寺，门临碧嶂悬。\n山河回万里，日月会诸天。\n短杖扶吾老，空林续胜缘。\n去城才咫尺，浑已隔人烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮普福寺泉亭","author":"顾璘","text":"夏木双崖合，寒流一涧纡。\n云高山路细，天远草亭孤。\n看竹无车马，浮觞即画图。\n吾侪乘兴处，不与俗人俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游花岩洞","author":"顾璘","text":"踏云寻古洞，风袂晚飕飕。\n花引三天路，山藏四月秋。\n金鳌扶殿阁，玉马戏王侯。\n曲涧东流水，滔滔入御沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月四日二首 其一","author":"顾璘","text":"午日明朝是，愁添早闭门。\n榴花新节序，芳草旧王孙。\n望渴回銮诏，名虚赐扇恩。\n幸除朝贺籍，高卧类江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月四日二首 其二","author":"顾璘","text":"客况无佳节，宸游尚故京。\n龙舟竞渡远，鹤发倚闾明。\n南苑愁移仗，西江望洗兵。\n早闻班瑞罢，家庆拜升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朱临安僧舍榴花","author":"顾璘","text":"北地花开少，红榴五月繁。\n深丛偏弄色，落日故当轩。\n白发羞春事，清尊恼客魂。\n莫教人散后，独自忆家园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57961,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀周太仆子庚","author":"顾璘","text":"伯囧脩王命，东巡遽未回。\n行台卿月好，谁与对衔杯。\n虎旅方扬旆，龙媒正选才。\n千群阅清峻，留盼及驽骀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57962,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张含还永昌二首 其一","author":"顾璘","text":"去国虚春事，还山恋月华。\n鸿飞入烟雾，龙卧傍泥沙。\n文许诸儒列，家怜万里赊。\n同临嘶马地，愁思极天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57963,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张含还永昌二首 其二","author":"顾璘","text":"汉道于今盛，君才过古人。\n少陵无近习，灵运有前身。\n鸑鷟生殊种，骅骝气自神。\n司徒真不忝，朗誉接秋旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57964,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"台郡元夜","author":"顾璘","text":"夜景团花市，春愁豁草亭。\n灯轮衔海月，火树迸林星。\n令节仍飘泊，狂歌几醉醒。\n只思梅柳曲，归卧故园听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57965,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其一","author":"顾璘","text":"抱郭青山丽，侵门碧草长。\n闲居悲物役，病起惜春光。\n看竹仍扶杖，临花暂举觞。\n莫嫌多意绪，蓬鬓已沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57966,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其二","author":"顾璘","text":"治郡衰逾懒，辞家病更悲。\n清心五湖水，归路片帆迟。\n絮舞过闲幔，蒲生满故池。\n丁宁踏青社，已过落花期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57967,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其三","author":"顾璘","text":"一月摊书卷，悠然识故吾。\n久怀沧海钓，犹系赤城符。\n竹帛书能事，丹砂却腐儒。\n携家将白发，吹笛洞庭湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57968,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其四","author":"顾璘","text":"幽兴关生物，呼儿灌果园。\n海风春易盛，林日午增暄。\n影动葡萄蔓，芽香枸杞根。\n苦嗔鸡犬恶，伐棘补篱门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57969,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其五","author":"顾璘","text":"野情随步屧，春色映罗衣。\n树彩丹青杂，花香脑麝迷。\n云疏吹片雨，江迥动斜晖。\n无限登台兴，犹嗟足力微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57970,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其六","author":"顾璘","text":"谷口新晴景，山禽满树悬。\n翻飞清浅水，群噪艳阳天。\n挟侣争巢斗，调声学语妍。\n稻粱须自爱，林外有鹰鹯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其七","author":"顾璘","text":"迢遰燕京道，音书海畔稀。\n几年劳按剑，万国忆垂衣。\n彩凤梧桐老，骅骝苜蓿肥。\n中天看太白，亭午尚光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其八","author":"顾璘","text":"久作天台吏，虚招地主名。\n云深华顶色，春远石梁行。\n药草传神圣，桃花脱送迎。\n荒凉刘阮迹，千古独含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其九","author":"顾璘","text":"尽揽群松色，聊分片石青。\n风烟兼万壑，天地此孤亭。\n发兴含萧远，吟诗动杳冥。\n废兴他日事，书记误丁宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其十","author":"顾璘","text":"三月雷犹伏，愆阴奈尔何。\n土龙行雨少，海鸟避风多。\n瘴疠忧仍剧，安危望非他。\n尚馀朱绂在，那忍议征科。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日病起十一首 其十一","author":"顾璘","text":"自怪山中住，邀人更写山。\n为期风雨夕，长对户庭间。\n雪片冲炎落，花枝积岁斑。\n殷勤谢真宰，烟景浪相悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮","author":"顾璘","text":"垄麦已青出，春风隔岁回。\n天时频自换，人事转堪哀。\n雪少冬全热，云昏昼且霾。\n傥闻关政理，调燮望盐梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春雪","author":"顾璘","text":"先腊望不至，经春何太狂。\n弄寒迟麦候，积素妒梅妆。\n客馆狐裘敝，邻家蚁酝香。\n今年好元夕，切莫负灯光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈中丞园","author":"顾璘","text":"柏府辞朱绂，蓬山敝素襟。\n楼前得湖水，庭际散园林。\n雾阁穿龙窟，风筝咽凤音。\n花时多酿酒，能费几黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"道院齐树楼","author":"顾璘","text":"梧桐高十丈，虚阁正相齐。\n户敞龙飞入，檐垂鸟下啼。\n山光开画障，人语落丹梯。\n夜有游仙到，流云湿暗题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽程良用侍御二首 其一","author":"顾璘","text":"结绶为兄弟，通家及子孙。\n高才先见夺，天道竟难言。\n玉树光埋没，江潮气吐吞。\n伤心甬东水，犹有未招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]