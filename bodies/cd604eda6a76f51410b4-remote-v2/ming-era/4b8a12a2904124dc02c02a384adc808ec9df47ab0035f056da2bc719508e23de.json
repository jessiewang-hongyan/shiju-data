[{"title":"徐汊风阻雨雪四首 其三","author":"李梦阳","text":"阻舟江柳下，信宿五湖中。\n立水偏吞雨，飞沙半逆风。\n夜樯扶岸集，渔火乱波空。\n信有悲欢异，应知易地同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊风阻雨雪四首 其四","author":"李梦阳","text":"常年遇泛客，煞厌说风波。\n雨雪空江夜，伊予悲慨多。\n沙人荷伞至，滩鸟景舷过。\n幸及投簪会，山中有薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊阻舟七日","author":"李梦阳","text":"七日北风阻，野滩舟不行。\n仆奴增饿色，妻子话征情。\n疏霰欺帘入，流澌逐浪生。\n独吟江更苦，诗罢欲三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖夜泛","author":"李梦阳","text":"烟湖迥不极，摇摇中夜征。\n棹拨鱼龙动，人冲鸿雁鸣。\n雪月物意惨，雨天寒色生。\n共有舟航事，谁深途路情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庐山冬至闻雷","author":"李梦阳","text":"小至匡南雨，空江此夜雷。\n仄忧群蛰震，急恐万山摧。\n盗贼时事苦，阴阳归思催。\n征鸿莫遽起，拟尔北同回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪夜庐山玩月","author":"李梦阳","text":"庐山万古月，几度雪边明。\n影傍素林灭，层随寒浪生。\n蔽岩疑有缺，侵鹊暗须惊。\n转恐群星妒，冰壶独自行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南康闻还山之报","author":"李梦阳","text":"傅玄非侮世，陶令合辞官。\n客路青阳逼，归心白发宽。\n江城消雪送，春雁倚舟看。\n自此茫茫去，都门昨挂冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江州雨","author":"李梦阳","text":"浔阳困李白，吾寓亦江州。\n地转涛声逆，城空山气流。\n二仪风雨积，双鬓古今愁。\n去鸟冲烟白，偏迎故国眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"霁","author":"李梦阳","text":"日霁催江色，心攀怍楚氓。\n褰帷二载过，归剑五湖情。\n霜换湓溪葛，林迁栗里莺。\n忍看复新月，庐岳夜猿鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕宜城野泊逢立秋","author":"李梦阳","text":"汉江天上水，牛女世间宵。\n自动鼋鼍影，谁传乌鹊桥。\n孤城古塞月，一叶楚门潮。\n君看西流火，分明夺斗杓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拨闷覃园","author":"李梦阳","text":"秦客楚山北，秋园古堞西。\n野风吟万木，禾径卧孤麑。\n江汉归舟迥，关河落日低。\n可留吾便醉，为爱白铜鞮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野风","author":"李梦阳","text":"山鸣野风至，汉水白萧萧。\n月滉鱼龙醒，云蒸豺虎骄。\n有家惊节物，不寐想前朝。\n万古英雄迹，江城夜寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早起","author":"李梦阳","text":"炳烛摇襄水，开门认楚山。\n风云惨淡曙，天地有无间。\n露益他乡白，秋随老鬓还。\n飞来何处鹘，逸翮绕江关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台归集","author":"李梦阳","text":"万里竟何事，三年违此都。\n短墙残菊在，别业古台孤。\n冬日低檐塔，霜风静野芜。\n但看头尽白，莫吝酒重沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台归兴","author":"李梦阳","text":"台榭归来地，江山战后心。\n城空犹募马，树在只栖禽。\n看岳晴偏近，俯河寒更深。\n风沙日日起，梁父为谁吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月十六日赴吴庄之宴二首 其一","author":"李梦阳","text":"林卧百无事，出城缘底希。\n人初正月会，春巳柳条归。\n就日蛛垂户，开尊蜂坐衣。\n不知农话久，天地一斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月十六日赴吴庄之宴二首 其二","author":"李梦阳","text":"为赴吴庄饮，因成禹庙游。\n住车惊草绿，坐石有云流。\n落日衔春峤，饥鸿集暮洲。\n巳扳频载酒，展转问花丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春赴鲍相之饮","author":"李梦阳","text":"怜汝一尊酒，要予千古台。\n年从碧草换，暖向玉杯来。\n海日连波动，江鸿带雪回。\n众宾无遽起，吾醉欲徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初春饮大道观因题","author":"李梦阳","text":"日月浮生改，山河此殿馀。\n酒因儒彦至，春入洞云虚。\n何药曾袪老，求丹尚问书。\n白头风物里，烂醉是真如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿江氏庄","author":"李梦阳","text":"黄昏水鹳叫，沙头人迹稀。\n天清看月近，野阔带星微。\n客语喧庄犬，风灯静夜扉。\n持醪忽自哂，出郭每忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题壁","author":"李梦阳","text":"客到惟鸡黍，农情爱汝真。\n隔城因下榻，圹野合留宾。\n骑苑沙明月，鞭桥柳弄春。\n忍能辞一醉，天地渐风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日佘庄感旧二首 其一","author":"李梦阳","text":"圃胜元因主，花繁更属睛。\n醉重今日酒，啼变隔年莺。\n遇树每共坐，寻香时自行。\n晚看风色异，天地一含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日佘庄感旧二首 其二","author":"李梦阳","text":"名园多感激，继至转芳菲。\n节恨清明逼，人怜故旧稀。\n暖烟低野净，云日度花微。\n莫漫愁春赏，吾今巳拂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨过","author":"李梦阳","text":"倚杖河城暮，林园雨过清。\n断丝犹舞燕，入叶巳沾莺。\n无惜声连夜，何妨坐到明。\n旱云吾欲赋，怆恻为苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雷电","author":"李梦阳","text":"雷电交冬夜，滂沱彻晓闻。\n老夫偏不寐，起立迥看云。\n湿重菊垂槛，鸣哀鸿趁群。\n明朝传太史，应有纪祥文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨客会","author":"李梦阳","text":"万物今逢雨，吾堂晚集宾。\n寒声催电至，猛力搅风频。\n坐看水平席，归防泥没轮。\n沾濡无自苦，悯悯是农人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晴","author":"李梦阳","text":"雨好晴亦好，洒然诗兴新。\n云分天欲断，日晃地如伸。\n湿入红渠重，乾回菉筱匀。\n趁时楼可上，万里不风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓","author":"李梦阳","text":"北斗脚下地，东星明渐高。\n霜初被山岳，霞巳闪波涛。\n塞雁能群过，邻鸡只乱号。\n不眠聊自待，红日上林皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早起庄上","author":"李梦阳","text":"为农起常早，每与鸡鸣期。\n露重花偏得，林深鸟自迟。\n飞星当面过，落月向人随。\n玉佩金门外，遥怜待漏时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庄上晚归","author":"李梦阳","text":"万动各有息，吾亦念吾栖。\n鸦翅昏犹接，花蹊曲欲迷。\n草堂烟火外，稚子竹林西。\n自笑忙何事，还家每宿鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋夜兴二首 其一","author":"李梦阳","text":"微风入枕簟，林卧仰看星。\n露气秋元白，天光霁益青。\n草虫攒暗壁，萤火闪疏棂。\n那解萧森节，都从一叶零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋夜兴二首 其二","author":"李梦阳","text":"犹记初朝岁，宁知遽数秋。\n庭梧碧自落，畹蕙弱谁留。\n门闭人同夜，心西火共流。\n閒眠亦反侧，霜露隔松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"深秋独夜","author":"李梦阳","text":"独夕偏闻雁，悠悠寝复兴。\n林堂下微月，风色暗疏灯。\n迟暮心难巳，悲凉气转增。\n忧来理琴瑟，肠断旧朱绳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊园省水二首 其一","author":"李梦阳","text":"莫辨田园路，聊遵水国游。\n物情真困雨，吾道本沧洲。\n避泞纡寻径，逢深屡借舟。\n草玄亭好在，坐数自来鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊园省水二首 其二","author":"李梦阳","text":"斩木聊供钓，当流且著阑。\n鸡豚各惆怅，鹅鸭尔能宽。\n松菊陶元亮，江湖陆务观。\n兼之吾过矣，鱼鸟镜中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佘园春日","author":"李梦阳","text":"市居常少出，花日复多风。\n万古繁花地，三杯感慨中。\n步畦怜小摘，攀树惜初红。\n霭霭微云外，哀哀何处鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其一","author":"李梦阳","text":"古有蒹葭客，吾今水一方。\n茅斋寒淰淰，洲渚郁苍苍。\n猎骑捎河雁，归人竞野航。\n霜高木叶下，莫拟是潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其二","author":"李梦阳","text":"坐送登临目，睛空鸟路长。\n秋云不近苑，官树自成行。\n河洛来天地，人烟接渺茫。\n采兰空泽里，彼美在何乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其三","author":"李梦阳","text":"日上秋林静，江清旅思微。\n黄叶雨后积，白酒客来稀。\n今古三川地，乾坤一布衣。\n独行吟望苦，沙鸟背人飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其四","author":"李梦阳","text":"名城急鼓吹，野处散秋烟。\n众草莽零落，孤松羞自妍。\n山川乱明水，云日媚高天。\n何事杨朱子，临岐独泫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其五","author":"李梦阳","text":"后代自今代，今人即古人。\n空传歌舞地，不见绮罗春。\n宋岳饶寒草，梁台起暮尘。\n苍茫白鹭渚，潇洒类闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其六","author":"李梦阳","text":"白马瓠子口，秋风汾上歌。\n帝乡不可见，千载白云多。\n树动江帆至，云前塞雁过。\n沧洲无尽极，慷慨有渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其八","author":"李梦阳","text":"一为梁地客，忽及授衣天。\n野静寒烟白，沙鸣暮雨悬。\n飞龙过绝浦，立马看长川。\n望望蘋花尽，鸥行若个边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其九","author":"李梦阳","text":"积雨催摇落，江村菊自秋。\n惊风振大壑，失雁下寒流。\n暗水斜穿竹，孤云晚抱楼。\n虞卿足简帙，白首傲公侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上秋兴十首 其十","author":"李梦阳","text":"不寐伤寒节，孤吟绕菊行。\n月沉李家浦，雨入宋王城。\n飒沓杨柳落，断续寒蛩鸣。\n泛泛中河艇，谁知此夜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居寡营忽忆关塞之游遂成七首 其一","author":"李梦阳","text":"牢落居庸道，苍茫六载还。\n开轩延汉使，对酒话燕山。\n鸟道增新戍，天梯护上关。\n白城烟火切，锁钥未应闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居寡营忽忆关塞之游遂成七首 其二","author":"李梦阳","text":"西崦千家落，防秋五百兵。\n山长元入塞，涧曲故穿营。\n静夜闻熊斗，黄昏报虎行。\n昔时忺历览，三驻白洋城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居寡营忽忆关塞之游遂成七首 三 沙岭为黄华东路","author":"李梦阳","text":"沙岭长园入，羊肠宛宛斜。\n石危偏骇马，草动数惊蛇。\n古树兼今树，岩花杂涧花。\n向来行塞日，亲见五陵霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居寡营忽忆关塞之游遂成七首 四 是为西路","author":"李梦阳","text":"往年趋北路，今绕泰陵西。\n昼黑垂萝密，山青禁木齐。\n独僧攀杪出，怪鸟趁阴啼。\n寂寞黄华堞，遥临古塞溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居寡营忽忆关塞之游遂成七首 五 黄华牙将张桓","author":"李梦阳","text":"孤蓬绝塞口，匹马戍程前。\n跨迥烟墩直，缘危石栈连。\n飞云下独石，逝水入潮川。\n旧对张军帅，题诗醉菊天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居寡营忽忆关塞之游遂成七首 其六","author":"李梦阳","text":"银山汤岭北，铁壁斗门边。\n虎守千年寺，人看一线天。\n赤崖崩古塔，阴洞坼新泉。\n尚记渔樵侣，长歌过马前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居寡营忽忆关塞之游遂成七首 七 弘治辛酉二月之望宿银山寺观邓隐峰诗刻","author":"李梦阳","text":"春游临绝峤，月出卧空岑。\n暂逐山中客，常关物外心。\n三峰藏净宇，百里羡云林。\n崖际劖高隐，何时一重寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜","author":"李梦阳","text":"阁幔沾初霁，云姿淡夕扃。\n凉蟾辉远树，昏堑下流萤。\n久静通幽理，沉思损性灵。\n昔人浑未达，白首著玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄书","author":"李梦阳","text":"驿使残年发，家书向夜封。\n当衢惭騕袅，涉水忆芙蓉。\n纸短情难尽，乡遥恨易重。\n孤灯迟明发，寒月下疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春宴","author":"李梦阳","text":"白首闻歌异，豪心遇酒多。\n酒当花潋滟，歌与燕婆娑。\n暝色侵台殿，春风换绮罗。\n未须愁薄暮，吾借鲁阳戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"熊子河西使回三首 其一","author":"李梦阳","text":"偶遇西河使，真传塞上情。\n一春常冻雪，千里半荒城。\n未断匈奴臂，犹勤哈密征。\n重闻帐下变，无语对沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"熊子河西使回三首 其二","author":"李梦阳","text":"绝塞田谁废，甘州稻旧畦。\n荒屯惟见兔，破屋不闻鸡。\n碛石烽烟北，祁连战鼓西。\n平生边务意，一一愿封题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"熊子河西使回三首 其三","author":"李梦阳","text":"旧说穷源使，人今出武威。\n蒲萄应啖足，沙枣故携归。\n燧火真憔面，胡尘尚黯衣。\n问君春塞雁，曾过玉门飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汴城东楼夏登二首 其一","author":"李梦阳","text":"身世吾垂老，中原此上楼。\n阴阳真去鸟，天地本虚舟。\n王屋千峰伏，黄河一线流。\n晴沙暮浩浩，羡尔自行鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汴城东楼夏登二首 其二","author":"李梦阳","text":"危楼六月上，樽酒四天开。\n俯看嵩云动，凉疑海雪来。\n峦光杯里见，岛影槛边回。\n不见芒砀气，空深吊古哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田园雨芜客过三首 其一","author":"李梦阳","text":"车马人来地，田园雨后心。\n颓垣疏柳卧，漏屋野花侵。\n稼穑悲生事，琴樽伴苦吟。\n自无农圃学，不敢怨商霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田园雨芜客过三首 其二","author":"李梦阳","text":"地下经年雨，田乾满目蒿。\n绕篱荒苦竹，小架剩蒲萄。\n阒寂人还至，壶觞兴并高。\n草途烟欲暝，犹遣贳村醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55616,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田园雨芜客过三首 其三","author":"李梦阳","text":"废坞欢能胜，群游百任为。\n持竿探乳雀，掷石打黄鹂。\n落果呼儿拾，逢花折自随。\n黄昏休拟驾，郊月巳曾期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55617,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大道观会饮三首 其一","author":"李梦阳","text":"敞阁元无暑，清林更著烟。\n人觞金像侧，马系石门前。\n碧草侵衣冷，坛花落酒鲜。\n丹青半磨灭，何处问诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55618,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大道观会饮三首 其二","author":"李梦阳","text":"殿阁生秋早，壶觞散客迟。\n蝉吟松露下，鹤入岛云随。\n尘世人堪醉，蓬莱路竟疑。\n羡门如何作，愿与跨青鹥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大道观会饮三首 其三","author":"李梦阳","text":"与客搴瑶草，开筵傍洞花。\n盘堆白石髓，觞泻赤城霞。\n静悟阴阳转，衰从发鬓华。\n看君有仙骨，倘许授丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日漫成","author":"李梦阳","text":"豪真欺酒绿，老每厌花红。\n人事年年异，春风物物同。\n云霄犹旅雁，时序又新菘。\n潦倒元吾分，金尊莫放空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人折牡丹见赠赋之","author":"李梦阳","text":"俗眼开争折，花心抱自知。\n色新兼露至，香在有蜂随。\n老病伤春日，乾坤倚杖时。\n落红纷点点，忍把出群枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客至二首 其一","author":"李梦阳","text":"宛宛酒船至，依依小队过。\n亭于草玄近，溪比浣花多。\n系马穿芳树，持杯向碧萝。\n更谋泉上饮，无遽促鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55623,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]