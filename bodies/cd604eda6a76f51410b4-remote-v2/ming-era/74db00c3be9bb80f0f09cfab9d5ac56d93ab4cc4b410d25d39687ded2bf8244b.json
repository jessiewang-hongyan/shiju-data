[{"title":"后度关行","author":"袁应文","text":"崒嵂层崖堆雪迹，云拥雄关迷咫尺。\n寒雨不断随山风，树杪泉声喧霹雳。\n微臣望关心正勤，不觉危途能困人。\n入舆坐艰时出步，路虽澝滑无浮尘。\n仆夫解事相调笑，笑我足下生青云。\n却忆来时度仙霞，岭头旱热殊堪嗟。\n今日还从大关度，风景迥异来时路。\n山川变态可能常，名利驱人各自忙。\n王阳九折难迥驭，杨朱悲泣为亡羊。\n前村烟暝方投宿，山寺鸣钟正燃烛。\n寄语山僧莫笑人，因果已定前生身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石阻风","author":"袁应文","text":"扁舟何太阻，采石自东流。\n雨雪经旬暗，风涛尽日愁。\n心飞京国路，梦绕故乡楼。\n指点骑鲸处，聊为吊古留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋对月书怀","author":"袁应文","text":"离家何许日，四见月光圆。\n时序忽已易，行人还在船。\n冻凝漕岸没，烟暝戍楼悬。\n却忆诸儿女，灯前语未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中寄怀兄弟","author":"袁应文","text":"一别已数载，逢人问起居。\n更无将去物，惟有寄来书。\n日蔼棠阴暖，山高雁影疏。\n莫教三径废，迟我共耕锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰除夕澄江守","author":"袁应文","text":"守岁他乡已十年，此宵何事不成眠。\n宦情一笑花灯下，乡绪千条柏叶前。\n青镜渐增潘氏鬓，壮怀犹系祖生鞭。\n狂歌独夜凭谁语，怅望关前思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸巳生日书怀","author":"袁应文","text":"客子伤春旅鬓飘，况逢生日转无聊。\n行藏敢信今年是，事业堪嗟去日饶。\n乡国频年劳远梦，烽烟几处未全消。\n无端却怪檐前柳，青眼看人只恁骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送临沅兵备施健所解官归粤西","author":"袁应文","text":"枫落昆池露气清，雁行中断惜孤征。\n岂缘薏苡能生谤，争睹潢池已寝兵。\n公道未须嗟白发，人生何处不浮萍。\n劝君有酒且同醉，行路难时怕独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸巳七夕寓平夷漫兴","author":"袁应文","text":"几岁他乡逢七夕，他乡何事更他乡。\n城头雨过新凉早，枕畔蛩声客梦狂。\n到处征衣愁铁马，谁家思妇倚银床。\n虚云牛女年年会，看尽明河接晓光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游飞来寺","author":"袁应文","text":"十年几度飞来寺，今日重登倍爽神。\n榻倚翠岚僧入定，树悬苍壁鸟窥人。\n檐间果落虚堂暮，竹底泉香碧涧春。\n自上半云还自笑，世人何处渡迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘中丞平山寇诗","author":"宋仕明","text":"自天秉钺控西东，雷迅霜威压世雄。\n薄伐已褫豺虎魄，先声遂挫犬羊锋。\n勿云岭外无宁宇，最幸专城有令公。\n自是韬戈铭汉石，燕然山上记肤功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园旧社","author":"冯绍京","text":"南国山川泄至文，瑞时威凤五为群。\n九天日月开真主，一代词华勒首勋。\n社夹枌榆青自耸，池环蘋藻翠难分。\n至今胜迹依然在，风雅谁能复似君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼送刘职方还留都","author":"冯绍京","text":"危楼五叠势摩霄，俯视沧溟若一瓢。\n南服车书归汉属，故台无复见任嚣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠","author":"冯绍京","text":"何年神女弄珠来，蜿蜿灵光照法台。\n四壁潮声相喷薄，诸天云影自徘徊。\n波心犹有骊龙认，刹里常闻象教开。\n秦帝不须东望幸，此间疑是小蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒李忠简公祠","author":"冯绍京","text":"烟帐遗踪此地留，先生丰望重南州。\n菊坡门下传心印，淳祐朝中展壮猷。\n正气直淩霄汉上，清风长对海门秋。\n表贤堂上瞻遗像，犹有龙光射斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登小金山","author":"冯绍京","text":"翠拥芙蓉万叠来，浈江牂水共潆回。\n能令南海衣冠盛，常作皇家柱石才。\n浪迹任随方外境，卜生休记妙高台。\n禅关静坐谈无始，何处昆明不劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"冯绍京","text":"百转丹梯历翠微，古坛灯火映岩晖。\n来经梁晋年华远，得驻名山不复飞。\n一水萦纡开峭峡，万峰回合拥禅扉。\n余心亦动幽栖念，何怪猿声黯客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梅岭","author":"冯绍京","text":"丞相遗祠倚岭岐，古松苍桧荫参差。\n千年灵淑钟光岳，一代勋名勒鼎彝。\n金鉴若悬龙扆照，玉环何至马嵬悲。\n开元旧事如追忆，羽扇清风是表仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮","author":"冯绍京","text":"四百峰头紫翠连，琪花瑶草遍诸天。\n铁桥雪霁寒梅瘦，石洞春明嫩柳眠。\n仙去尚留双履在，鹤归赢得一书传。\n侧身东望飞云顶，丹灶沙床梦亦牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白云绝顶望罗浮","author":"冯绍京","text":"石罅天开古洞幽，安期遗舄至今留。\n灵岩尚长尧时韭，丛樾中藏汉代楸。\n竟与王乔璈笛伴，不从徐市制书求。\n至今避地金银阙，蓬岛瑶池汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩祠怀古","author":"冯绍京","text":"昌黎曾搆读书台，窗对连阳八面开。\n谪宦心悲天阙远，问奇人载曲车来。\n池中洗砚波成墨，帐下凝烟色亦煨。\n山斗至今群共仰，粤南文采迥昭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊径","author":"冯绍京","text":"路入羊肠径，丹梯百折看。\n沸雷喧涧石，飞瀑响岩端。\n叱驭心徒切，垂堂戒已寒。\n丛林多枳棘，谁信有栖鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅村公馆","author":"冯绍京","text":"野铺依岩岫，门临石溜清。\n基传先代迹，里记故侯名。\n孔道当山劈，危桥跨涧平。\n人龙无复见，怀仰不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山送黎秘书还朝","author":"孙兆葵","text":"岛屿千年胜，衔杯独上台。\n江从庾岭下，山到石门开。\n贾艇依村口，渔家杂水隈。\n悠悠白日暮，潇洒绝纤埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游息洞","author":"谭士寅","text":"蹑履朝阳入洞深，苍崖碧涧净烦心。\n花然锦绮春台晓，莺啭笙簧夏木阴。\n洗遍残碑有古篆，望穷佳境上高岑。\n兴豪不尽登临意，抚掌长天一笑吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"朱守鲁","text":"福地天开胜，飞来事有无。\n东游蓬岛近，南望海门孤。\n烟艇应浮月，山灵不病吾。\n登临休感慨，且进峡江鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠谒李忠简像","author":"韩奕","text":"奇哉公之遗迹，伟哉公之高名。\n手携天柱扶金阙，力挽沧波洗玉京。\n雄裁早著龙图阁，妙策还存雁翅城。\n明珠煜煜摇星斗，人言公实应其精。\n香火先年崇报祀，至今兰若海心擎。\n余也鼓棹破南溟，暂来蓬岛叩仙灵。\n春禽想伴探花客，江水似和读书声。\n渔人自得交唱晚，僧子入定却忘情。\n自是天然图画趣，赠公千载作丹青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送侄孟郁计偕北上","author":"韩丽元","text":"綵笔蜚名早，江南复几人。\n美矣荆山玉，依然命世珍。\n天入神京远，云收北斗新。\n年来二三月，香霭一枝春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"层峦耸翠","author":"梁必强","text":"半插崚嶒半水涯，逶迤驻节叠山西。\n乘空虎岭支来远，聚翠龙池眼欲迷。\n回首三天三岛近，纵观五指五云低。\n人钟地气清高萃，奚独文章入品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青草孝贻祠堂和张子翼韵 其一","author":"梁必强","text":"栋宇千寻壮里居，如何祠下草长除。\n炉烟袅袅灵如在，水木悠悠意自舒。\n种德一心无望报，传家万卷有藏书。\n知君对此无他羡，只羡吾生乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青草孝贻祠堂和张子翼韵 其二","author":"梁必强","text":"耳外无闻车马音，白云长护宇垣深。\n心田远接槐三叶，手泽长存桂一林。\n课子才名齐北斗，承家礼教重南金。\n照人古道今犹在，唤醒人间乌哺心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登楼对菊","author":"梁必强","text":"秋声一叶桐，君复传消息。\n君对我舒眉，我慕君抱德。\n抽英何其迟，吐蕊应在即。\n浥露若迎人，含风如守墨。\n凭楼一望之，明月照颜色。\n松竹匀丰姿，栽培并南国。\n故人恰爱君，君意何默默。\n机事待秋深，黄花赛篱北。\n陶潜懒折腰，祇为君心直。\n与尔结深知，炎凉情罔极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过桃源拜三义堂","author":"梁必强","text":"千古高风在，薰人姓字香。\n齐驱神合券，相对日生光。\n信义镌金石，彝伦刻肝肠。\n有心当愧死，世态日炎凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墨鹰","author":"梁必强","text":"如窥如奋寂无声，炯炯双瞳映日晴。\n猥尔形容千古重，因知天地一毛轻。\n健为胎骨人称雅，淡作精神鸟亦惊。\n堪羡前人留色相，雄心难与画工评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹夫人","author":"梁必强","text":"欲结同心无着处，但将手足伴猗那。\n扫尘二女浑无语，稳梦三更寂不波。\n脂粉懒沾西子色，风流常逐楚天娥。\n无端一入骚人手，点污贞心奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下邀客","author":"梁必强","text":"冰轮辗破万山扃，千里招呼眼共青。\n对魄遍将肝胆照，论心不觉鬓毛星。\n却怜剑气还看剑，为惜萍踪又结萍。\n相伴光华浑不厌，醒来犹见影窥棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署事象山游圆峰寺时闻邸报","author":"梁必强","text":"人事支离任转蓬，炎凉作敌古今同。\n山僧讶我头头错，我羡山僧色色空。\n龙带浮云归古洞，犬随白鹤舞松风。\n凭高才话诸天事，月挂峰头别又匆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹景和崔白石韵","author":"梁必强","text":"高风劲节共襟期，明月清阴是故知。\n新笋似擎诗客笔，放梢遥见酒家旗。\n招邀钟子琴调凤，勾引长庚咏入鹂。\n相伴沙鸥歌白石，剪裁时有数行题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜蚊勉儿辈二首 其一","author":"梁必强","text":"怪我贪眠似困蒙，怜君唤醒主人翁。\n雷声入耳尘缘悟，尽在乾坤大觉中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜蚊勉儿辈二首 其二","author":"梁必强","text":"老夫临头耳更聪，忽惊枕上话生风。\n苍蝇儆夜君知否，顿觉蚊蠓亦化工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度仙桥","author":"梁必强","text":"羽化应无足，乘鸾事已非。\n银河须鹊驾，乔舄傍乌飞。\n赤石平如砥，丹梯稳似矶。\n凭虚升宝殿，幻境去忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华封仙榻","author":"梁必强","text":"恰似巫山二六旂，迤延州里万峰馀。\n前屏拖紫文争焕，后障垂青秀更奇。\n石室可容多客坐，仙岩应与结朋期。\n他时苇屐来游此，半买山钱半酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼　四首 其一","author":"唐伯元","text":"典衣为沽酒，典地为裁花。\n小楼新构就，明岁属谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼　四首 其二","author":"唐伯元","text":"种花莫种奇，卜筑何妨拙。\n客来归不归，楼上看明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼　四首 其三","author":"唐伯元","text":"楼前湖水平，楼外四山青。\n楼中经一卷，堪醉不堪醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼　四首 其四","author":"唐伯元","text":"白昼莺声啭，清宵鹤唳过。\n几番沉醉后，唤醒兴偏多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼又四首 其一","author":"唐伯元","text":"天地何简易，六经何支离。\n安得杨子云，尊酒共楼居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼又四首 其二","author":"唐伯元","text":"吾读稊稗篇，庄生如有悟。\n糟粕苟不存，吾道在何处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼又四首 其三","author":"唐伯元","text":"果哉糟粕矣，煨烬莫疑秦。\n韦编三绝后，谁是醒经人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼又四首 其四","author":"唐伯元","text":"醉经何可当，楼名浪标榜。\n痴迷复痴迷，前身疑象罔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其一 镜湖","author":"唐伯元","text":"若将湖比镜，湖光镜不如。\n若比醉中人，脱身堕太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其二 新篁岛","author":"唐伯元","text":"谁开湖上岛，新篁绿未齐。\n齐时应嘱付，合有凤来栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其三 西湖山","author":"唐伯元","text":"岛上楼堪画，湖山敞画屏。\n不有楼居者，历历为谁青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其四 芦荻洲","author":"唐伯元","text":"萧萧芦荻边，载酒趁斜阳。\n醉来疑作梦，捩柁过潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其五 渔沧庙","author":"唐伯元","text":"清夜闻钟鼓，朝来荐鸡黍。\n庙古不知年，沧浪问渔父。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其六 桃花坞","author":"唐伯元","text":"一坞深复深，见花不见树。\n人间可避秦，何必桃源路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其七 林副使旧宅","author":"唐伯元","text":"林公旧地馆，桥畔草萋萋。\n百年歌舞地，閒在夕阳西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉经楼八景 其八 李家园","author":"唐伯元","text":"春林翠欲流，繁芳发罗绮。\n前日是张家，今朝又姓李。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自甲申十月至戊子正月","author":"唐伯元","text":"不是忧生不学禅，持来一戒几经年。\n尘缘未了寻常事，犹向春风独自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居五戒一戒讲学","author":"唐伯元","text":"我曰予贤，人曰予圣。\n果圣且贤，相悦而静。\n况汝之德，未满乡里。\n况汝之道，未行妻子。\n呶呶哓哓，盖不知耻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二戒预外事","author":"唐伯元","text":"仁者爱己，义者正己。\n枉己直人，所济有几。\n匹夫之行，可化乡人。\n既明且哲，以保其身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三戒酬应诗文","author":"唐伯元","text":"赋性太轻，溢道人美。\n无益于人，且先失己。\n搜肠刻骨，博润笔金。\n可怜多病，老去光阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四戒赴席","author":"唐伯元","text":"小席百钱，大席一金。\n何功何能，为世所钦。\n竟日嗛嗛，疏懒难支。\n夜深人静，我读书时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五对客戒谈时政","author":"唐伯元","text":"生逢唐虞，明良岳牧。\n不学贾生，流涕痛哭。\n物之不齐，人孰无过。\n反己责躬，是我工课。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉元日八首 其一","author":"唐伯元","text":"岭峤云山外，征鸿半假真。\n一从郎署后，四见岁华新。\n冠盖迎人懒，渔樵入梦频。\n咄嗟成底事，又伴上林春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉元日八首 其二","author":"唐伯元","text":"窃禄谁家子，言归竟不归。\n高堂双白发，帝里又芳菲。\n谷送宫莺晓，烟添御柳肥。\n斑斓五色在，何处试春衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉元日八首 其三","author":"唐伯元","text":"恋阙几沉吟，为郎十载深。\n长瞻惟北斗，欲报愧南金。\n起草当年事，传经百代心。\n况逢端履庆，吾意不须禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉元日八首 其四","author":"唐伯元","text":"献赋惭司马，逢君喜帝尧。\n尚疑樽俎意，无补圣明朝。\n玉律阳方长，春风冻已消。\n胡儿休牧马，指日断天骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉元日八首 其五","author":"唐伯元","text":"献岁饶佳气，千官向紫宸。\n谁擎金掌露，最惜岭头春。\n濡滞瞻云日，艰危报主身。\n旁人休错解，张翰忆鲈莼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉元日八首 其六","author":"唐伯元","text":"岁改心如旧，间关酌去留。\n凭将丹扆献，乞伴赤松游。\n桃处人偷颗，桑时鹤送筹。\n庭闱多胜事，此外复何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]