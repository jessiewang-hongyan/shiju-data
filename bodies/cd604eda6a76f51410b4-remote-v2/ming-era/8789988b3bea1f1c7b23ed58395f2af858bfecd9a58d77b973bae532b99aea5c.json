[{"title":"过北渚庄二首 其一","author":"边贡","text":"野店长渠绕，郊扉昼不开。\n茅堂荫榆柳，沙路上莓苔。\n白鸟晴飞疾，玄禅夕奏哀。\n主人城市里，经岁几曾来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过北渚庄二首 其二","author":"边贡","text":"渚老有高趣，未衰先弃官。\n心犹壮夫勇，身且布衣寒。\n雪里中宵坐，灯前细字看。\n不知东海上，何日起垂竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再过北川别业","author":"边贡","text":"负郭稻千顷，青青遥入云。\n儿孙不解守，宾客自争分。\n剡曲舟慵泛，山阳笛忍闻。\n伤心碧堤柳，犹映白鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题白泉王子壁","author":"边贡","text":"吟兴复不浅，村中无酒家。\n圃云深映竹，墟日半笼花。\n石栅啼黄鸟，溪泉拥白沙。\n昼眠兼夕坐，非为惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卜山居成有作","author":"边贡","text":"久定华山约，今来始卜居。\n梦游曾屡到，心赏复何如。\n圃巷环高柳，渊泉抱古墟。\n从兹簪与绂，当有绝交书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过湘王故宫","author":"边贡","text":"旧日湘王府，凄凉百岁多。\n堞荒秋荠上，楼厂夕云过。\n废囿穿狐兔，深宫散绮罗。\n同行有词客，閒咏黍离歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过故山人园","author":"边贡","text":"园囿碧山隅，山人此旧居。\n豪华非往昔，冥漠意何如。\n古木巢寒鸟，残阳隐废墟。\n伤心醉游处，犹有壁间书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"家豢鹦鹉为狸奴所毙予伤之赋短律二篇书呈同志期有以慰我也 其一","author":"边贡","text":"尔本能言鸟，羁栖误此生。\n众方怜彩翠，天苦忌聪明。\n月下离群思，花间唤婢声。\n居然成往迹，留架在前楹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"家豢鹦鹉为狸奴所毙予伤之赋短律二篇书呈同志期有以慰我也 其二","author":"边贡","text":"转架藏身捷，临窗命食娇。\n愁来真可掬，魂去竟难招。\n露井流音寂，风阶落羽飘。\n醉翁元好寝，为尔立清宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石桥驿南观涨","author":"边贡","text":"夜雨山水发，奔涛盈涧流。\n石梁嗟已断，何处觅方舟。\n永路缘朱坂，馀晖映绿畴。\n登高西北望，隐隐见昭丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"由鱼料驿登岸赴荆门","author":"边贡","text":"驱马丽阳界，荆门途不赊。\n平田飞野雉，积水乱鸣蛙。\n日下西山暝，江悬北斗斜。\n荒村逢故老，停盖问桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自汉江泛舟过宜城遇风雨大作","author":"边贡","text":"短棹骛洪河，川行忧畏多。\n转怜时役苦，无奈旅程何。\n雾黑江龙斗，云腥岸虎过。\n黄昏投古驿，从此顺风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自岘山趋赴襄城不及门遂宿汉江驿","author":"边贡","text":"黄昏岘山曲，征马倦跻攀。\n雨过苍林外，虫鸣废井间。\n断崖成聚落，深巷隔尘寰。\n古驿悬灯候，重门未上关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登仲宣楼次韵陈矩庵中丞 其一","author":"边贡","text":"岧岧南郡楼，到郡此重游。\n岛没云中树，天浮海上沤。\n旌旗连戍色，鼓角动边愁。\n万里看西北，苍茫见帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登仲宣楼次韵陈矩庵中丞 其二","author":"边贡","text":"江郡敞云楼，东南据上游。\n日华浮野雪，霞彩散川沤。\n俯仰悲千古，登临起四愁。\n王师神且武，何日靖西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅西桥大复二君 其一","author":"边贡","text":"忆在中州日，曾传上苑歌。\n暮云千里隔，春草四年过。\n汉殿仍金马，秦关且玉珂。\n报章惭独晚，才力谢羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅西桥大复二君 其二","author":"边贡","text":"懒性真成癖，哀吟不当歌。\n田园自开辟，城市少经过。\n雨卧山回枕，春行柳拂珂。\n马周头渐白，无日见常何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠刘介夫举人归金乡限韵作","author":"边贡","text":"云日昼冥冥，幽人过草亭。\n客衣寒映水，归骑晚侵星。\n雨外山逾秀，霜前柳正青。\n醉翁多晏起，行李暂须停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"叠羹字韵再别承庵","author":"边贡","text":"钓鱼特作羹，载酒出山城。\n晓雨阳关恨，春风故国情。\n登台怅予独，戏彩羡君行。\n忍听碧林外，萧萧归马鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送客","author":"边贡","text":"知君意不浅，近送独绸缪。\n文字真吾契，河山且故州。\n水云虚映日，风树碧含秋。\n岳顶传诗在，谁将片石流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送章太守朝觐","author":"边贡","text":"十载乡山路不平，年来吾亦羡吾生。\n春回麦陇见鹰化，月出花田无犬惊。\n湖上野夫真浪迹，济南良守合垂名。\n古亭相别恋携手，日暮风烟含远情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王滦江","author":"边贡","text":"灯火虚堂绾梦思，月明乌鹊绕栖枝。\n真愁远道无书札，不信残冬有别离。\n江甸綵舟迎早燕，关山骢马恋芳岐。\n情多未有琼瑶赠，醉折风梅傍雪篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登天津拱北楼","author":"边贡","text":"古今形胜天津地，晚暮登临春事幽。\n冠冕八方通禹贡，河山千里控神州。\n风连碣石烟沙黯，日倒扶桑海色流。\n老病独悬戎马涕，俯身疑在岳阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄亭溪","author":"边贡","text":"梧桐覆井阴阴叶，蟋蟀鸣阶细细音。\n中夜有怀孤月迥，九天无梦五云深。\n真惭弃置逢时幸，敢负平生许国心。\n立马送君还忆远，似闻巫峡气萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"昭君出塞图","author":"边贡","text":"帝遣才人出汉宫，远投殊域为和戎。\n琵琶晚映娥眉月，觱篥寒吹粉面风。\n终夜苦心悬北斗，隔年归信托南鸿。\n征鞍倦倚聊成寐，犹在长门女伴中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中次钱江楼宪副 其一","author":"边贡","text":"两岁高堂辍问安，每逢新腊恨漫漫。\n身如野鹤真无倚，心似江梅苦抱酸。\n衣线细留春草怨，穗灯深掩雪风寒。\n他年奉檄堪垂涕，毛义从来不为官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中次钱江楼宪副 其二","author":"边贡","text":"起居深借鹊巢安，著作从教酱瓿漫。\n迟暮岁华多客感，清修家世本儒酸。\n春潜水市晴烟碧，雪抱山城午日寒。\n且欲醉眠歌习隐，不须章表乞辞官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再次钱江楼","author":"边贡","text":"布被藜床雪卧安，草堂幽迥夜漫漫。\n有怀真爱故山好，多兴不辞村酒酸。\n冲晓觑林梅恰放，趁暄行径石犹寒。\n长镵短褐无人识，白发明时老谏官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨喜晴","author":"边贡","text":"已判冥冥过此年，忽从中夜睹青天。\n云移北牗星河近，月上东林树影圆。\n游兴不愁村径滑，赏心多为渚花牵。\n朝来拟蜡登山屐，见说西峰有谪仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中","author":"边贡","text":"醉眼看馀密复疏，晓风吹散乱如初。\n一尊相对兴不浅，孤鹤伴吟行且馀。\n桥滑可须羸蹇度，泥深同感落鸿书。\n江梅岸柳俱含冻，六管凭谁借一嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祷雨","author":"边贡","text":"久祈甘雨集灵官，赫赫骄阳势转难。\n月驭漫曾离毕宿，雷车空自绕仙坛。\n巡檐卜润时看础，望极占云夜倚阑。\n迂腐似闻天鉴迩，古来王者必求端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除日次蒲汀李少宰韵","author":"边贡","text":"建业新春入故年，异乡怀抱各凄然。\n三千道路沧江外，五十光阴素发前。\n名重正须推北斗，藁成应更续南铨。\n邻西咫尺莺迁地，守岁同歌伐木篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日次蒲汀二首 其一","author":"边贡","text":"星纪初回日再元，海风吹雾起晴暾。\n五辛遥阻荒坟荐，万里空伤久客魂。\n临水稚芳争袅袅，出林幽羽故喧喧。\n归田喜卜中宵梦，拟办囊封乞主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日次蒲汀二首 其二","author":"边贡","text":"柏烟松火万家同，柳径杨堤入暖风。\n九陌管弦存旧俗，六朝山水见遗宫。\n交亲隔舍追随里，岁序惊心感慨中。\n且喜瓮头浮绿蚁，不须囊底觅青铜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日喜晴次蒲汀韵","author":"边贡","text":"人日旧京云日丽，钟山龙气郁开祥。\n腐儒推枕病忽去，野老占年喜欲狂。\n即起户帘通紫燕，早闻宫树啭黄鸯。\n多情杜甫缘何事，解道他乡胜故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次蒲汀二首 其一","author":"边贡","text":"春朝飞雪舞风回，谷日中宵起迅雷。\n腊后不教滕六出，蛰前那遣阿香来。\n深江满浸遗蝗种，厚地潜惊律管灰。\n借问化机谁转斡，只应天府近三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次蒲汀二首 其二","author":"边贡","text":"石城虎踞九关开，钟阜龙盘亦壮哉。\n地保金汤分表里，气通云汉切昭回。\n镐京本是文王土，太乙休誇武帝台。\n头白词臣窃供奉，两京清秩去还来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"端午","author":"边贡","text":"楼船不近打鱼矶，箫鼓中流听者稀。\n遥想紫宸颁制扇，真惭清禁赐宫衣。\n池亭映日榴开锦，城郭笼烟柳荡旂。\n传有湘江年少过，兰桡应吊屈平归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日有怀白岩侍郎","author":"边贡","text":"去年人日题诗处，郑氏茅堂春可怜。\n出谷早莺啼恰恰，映风寒竹倚娟娟。\n随銮并入青云上，解佩同归素月前。\n此日寂寥惊旅食，坐看庭雪抚流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月十五","author":"边贡","text":"城上旌旗闪夕光，城边戈甲俨龙骧。\n郊门月上游尘静，辇路春回细草长。\n千古再逢周礼乐，十年曾奉舜衣裳。\n行宫咫尺天俱远，愁见林鸦接翅翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋值雨","author":"边贡","text":"冉冉游云护琐闱，胧胧团月映江扉。\n停杯已负经年约，倚槛空思万里辉。\n花雨广寒真亦假，梦登天柱是邪非。\n临风谩有乘槎兴，欲访银河旧织机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东村冬日同刘王诸子步归","author":"边贡","text":"泱漭空原返照开，杖藜村径暮徘徊。\n霜苗迸土纤纤出，风叶辞林宛宛回。\n扶病可须重载酒，住家何必更登台。\n青鞋布袜沧波岸，白石歌残意转哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日恭闻车驾入都志喜二首 其一","author":"边贡","text":"八骏长驱万里翱，四方周览一心劳。\n星杓夜夜随黄幄，云盖时时护赭袍。\n朔野旧闻歼冒顿，洪都今见破宸濠。\n何人议赏功居首，玉殿承恩醉碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日恭闻车驾入都志喜二首 其二","author":"边贡","text":"至日连年帝远征，今年至日喜还京。\n登歌想像聆周雅，振旅传呼列汉旌。\n皇祚永占千岁历，圣聪明照万方情。\n灵台旧职今谁掌，不用书云纪太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春日","author":"边贡","text":"多病逢春笔懒拈，草堂高枕病垂帘。\n故人恰送鱼酒至，野老不愁年岁添。\n冉冉雪云虚照水，晖晖晴日乍经檐。\n衔杯自笑还成醉，吏隐谁能得两兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日次滦江中丞","author":"边贡","text":"伏枕惊看岁又新，卧听街市响蹄轮。\n樽无白酒元因病，屋有青山不当贫。\n向晚云霞偏弄色，得时梅柳故争春。\n闭门可是甘肥遁，懒效东西南北人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再次滦江","author":"边贡","text":"玉座香烟护衮衣，綵云飞处是皇畿。\n中朝地接千官拥，北斗星悬万国依。\n波煖御沟春浩荡，日临宫树晓云微。\n自怜朱绂淹乡土，不拜青阳入禁扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17738,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日王监察天宇过访留酌二首 其一","author":"边贡","text":"豸冠春访薜萝衣，晴日池台燕子飞。\n心为感时偏耿耿，话因谈旧转依依。\n閒过别院题青竹，却望南山指翠微。\n欲问野夫栖隐处，九槐溪上一柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17739,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日王监察天宇过访留酌二首 其二","author":"边贡","text":"笑我贪书日苦辛，爱君风采是埋轮。\n青骢独系垂杨晚，白屋长甘旧业贫。\n千里海邦开雨雪，万家山郭转阳春。\n回骖却傍黄昏路，萝月纤纤喜近人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17740,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒食郊行","author":"边贡","text":"来家疃前春可怜，芳郊迟日起晴烟。\n柳枝袅袅翠犹弱，花蕊菲菲红且妍。\n荒陇岁时还俎豆，短墙儿女正鞦韆。\n青年竹马欢游地，华发经过思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17741,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"午日","author":"边贡","text":"五月五日正阳辰，四十六年衰病身。\n天上风云同际会，水边鱼鸟自相亲。\n啸歌独得酒朋喜，疏散屡遭官长嗔。\n睡起竹林温雅颂，绿蒲青艾晚撩人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋述怀","author":"边贡","text":"银汉星稀玉宇秋，夜深乘醉倚东楼。\n天香不见云中下，槎影空传海上浮。\n狂有篇章酬岁月，懒无书信荅交游。\n羽衣歌罢蟾光冷，独送西南万里眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月八日漫成","author":"边贡","text":"萧萧秋径晚霜馀，寂寂风帘向月疏。\n浊酒旋沽还对客，小楼翻盖且藏书。\n云边露白鸿犹去，栋里巢空燕不居。\n欲向寒花问生事，为谁收卷为谁舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清明日刘黎二子携酒过访 其一","author":"边贡","text":"美人常苦费招寻，咫尺门庭万里心。\n手简忽随双鲤至，肩舆先造百花深。\n霞通苑榭明春柳，雨过桥山出暮岑。\n对酒似闻清庙瑟，一歌三叹有遗音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清明日刘黎二子携酒过访 其二","author":"边贡","text":"官舍劳君载酒寻，病多无柰踏芳心。\n孤亭岁久青松老，曲径春残碧草深。\n友义昔曾称管鲍，诗名今岂下高岑。\n黄鹂紫燕如知喜，并舞双飞接好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁除祫祭以病不与奉荅同寅白岩见怀之作","author":"边贡","text":"木榻香寒篝火融，晖晖残日隐房栊。\n天涯风俗追随里，岁暮阴阳感慨中。\n井干不消经夜雪，阶萱犹发故年丛。\n端居最忆东朝士，俎豆从容未可同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬至长陵即事","author":"边贡","text":"千峰隐隐下朝阳，复嶂层厓启曙光。\n观阙昭回森象魏，河山表里奠金汤。\n陵门月映千年树，寝殿风飘五夜香。\n长至祠臣窃供奉，拟书云物纪灵祥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日雨中登楼","author":"边贡","text":"八月黄河拟泛槎，为怜重九一停车。\n登楼恰对冥冥雨，行径稀逢采采花。\n苍树破云秋寺迥，碧山当槛暮城斜。\n乡园客路俱愁寂，传语游人漫忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元旦","author":"边贡","text":"岁首江南久客身，宦情寥落道情深。\n极知佳丽非吾土，且喜逢迎有故人。\n城上雪痕经腊在，水边梅蕊觑年新。\n呼童早蜡登山屐，莫负陶家漉酒巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸未元日泊龙江关","author":"边贡","text":"海日苍茫隐石城，正朝云物半阴晴。\n暮年岁到无亲故，旧国书来有甲兵。\n青柳白梅俱在眼，渚鸥沙燕亦含情。\n同舟楚客醒相对，坐待春朝百感生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"二月一日候朝是日予祖母寿辰","author":"边贡","text":"灯火春城漏下迟，薄罗寒透五更时。\n莺迁上谷声初转，花隔东风信未知。\n仕汉恩深惭壮业，报刘心远滞还期。\n天街望处无端喜，南极光连北斗垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"万寿节","author":"边贡","text":"綵仗凌云启曙烟，翠华含日俯晴川。\n遥怜外阃称觞地，恰是西江献捷年。\n鞶锡共欢恩似海，凯歌齐祝寿同天。\n微臣亦有迎銮曲，愿奏君王玉几前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊祀斋居 其一","author":"边贡","text":"春树扶疏夜色轻，坐深斋沐轸遥情。\n上清真气通三界，太乙祥烟接两京。\n云里佩环鸣閤道，水边星斗照台城。\n江湖魏阙瞻依切，欲草甘泉赋未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊祀斋居 其二","author":"边贡","text":"独火琴张伴独居，月华遥上閤帘初。\n怀人忽梦春塘草，侑食聊烹雪苑蔬。\n南牧烽烟时有报，北来鸿雁久无书。\n玉笙声袅炉烟细，懒听仙官说步虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"少宗伯赵类庵 其一","author":"边贡","text":"省署行云接禁庐，戒严斋沐共端居。\n箫韶恍惚闻仙乐，梦寐依稀奉属车。\n台斗上公苍玉佩，阆风仙子碧霞裾。\n六年嘉靖明禋礼，合有淮阴太史书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]