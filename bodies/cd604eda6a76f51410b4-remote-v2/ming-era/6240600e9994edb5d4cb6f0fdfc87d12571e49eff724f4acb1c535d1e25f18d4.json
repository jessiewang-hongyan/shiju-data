[{"title":"虚湖曲四胤为刘少邻赋 其四","author":"杨慎","text":"摇笔泳涟漪，蟠胸生沆薤。\n因之沧浪吟，湖亭记余迈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招董西羽","author":"杨慎","text":"朝向城中来，夕向城中去。\n独夜一微吟，攀留桂之树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄承冰壶","author":"杨慎","text":"紫翠隐丹房，仙人在上方。\n欲往疑无路，白云封点苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"普贤寺","author":"杨慎","text":"香阁影波心，丛云万木深。\n月明清梵夜，遥应海潮音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"进耳寺","author":"杨慎","text":"蛮村藏古刹，窣堵粉如云。\n寺?残僧少，鸣螺寂不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悟空庵","author":"杨慎","text":"一龛如燕凹，中有貂珰冢。\n石麟卧青芜，烟交春茸茸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太平寺","author":"杨慎","text":"忍草迷香径，空馀屋数间。\n香炉烟不起，苔蚀鹧鸪班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松隐庵","author":"杨慎","text":"松庵饶古松，露鬣交云尾。\n萝径少人行，日暮啸山鬼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金马寺","author":"杨慎","text":"东林金马寺，南亭金马关。\n往来皆马客，试问谁者贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白龙寺","author":"杨慎","text":"诗人张禺山，喜用白龙字。\n何事独无诗，留题白龙寺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗汉寺","author":"杨慎","text":"觉路花非染，灵山草亦香。\n虚空即此境，何处觅空王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太华寺","author":"杨慎","text":"古地新兰若，标峰冠彩霞。\n碧波临万顷，指点见星槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积翠岩","author":"杨慎","text":"翠岩隐玄龛，苔径无鸟迹。\n不见煮茶烟，那知有禅客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛东镇过高峣同宿作人名诗","author":"杨慎","text":"钓石崇遥岸，樵林放远山。\n东园公肯过，桃李照衰颜。\n涟渏包明月，今夕兹无还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月仪帖","author":"杨慎","text":"鸾惊开二妙，虿尾见征西。\n花蠹贉销鼊，香蟫跋认鹥。\n不逢华盖叟，谁与重??。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉台体 其三","author":"杨慎","text":"戚里盛豪华，联翩赴狭斜。\n宝阑围斗鸭，金瓦掷鸣蛙。\n归骑春城晚，风吹满路花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉台体 其四","author":"杨慎","text":"菱歌歇晚凉，桂楫隐回塘。\n珠佩双皋冷，罗裙十里香。\n锦书随绮翼，持报邵陵王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七星关渔者","author":"杨慎","text":"石涧无通水，渔舟反上山。\n得鱼随马卖，抱獭趁鸦还。\n问尔江湖兴，茫茫若梦间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"枕上","author":"杨慎","text":"君莫笑萍梗，来往上滇云。\n我本圣之徒，七十而从军。\n沱若竟何益，浊酒且酣欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧佛","author":"杨慎","text":"金仙疲津梁，云卧恣天行。\n菩萨叹退位，未尽区中情。\n二谛凭谁解，松风与水声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋情游海源寺","author":"杨慎","text":"林壑散烟霏，钟鼓喧清晓。\n日气抱峦阴，虹桥上云杪。\n离鸿海岛来，疑是三青鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨霁龙门泛舟溯流回作","author":"杨慎","text":"江干新雨晴，江缆新流上。\n船头转云峰，船尾叠花浪。\n中洲蹇谁留，渺渺临风望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其一 静观堂","author":"杨慎","text":"诏许归蓬荜，性本爱丘山。\n临水知鱼乐，披林共鸟閒。\n劳劳车盖影，渺渺隔重关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其二 中虚亭","author":"杨慎","text":"高人厌世氛，亭子枕孤云。\n宇定天光发，风清地籁闻。\n此君相对处，幽意许平分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其三 交翠庭","author":"杨慎","text":"瑶草岩姿丽，金沙海色新。\n射干翘凤羽，薜荔长龙鳞。\n谢氏芝兰砌，还联玉树春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其四 忙中閒处","author":"杨慎","text":"早岁辞芸阁，归来卧蕙櫋。\n巳寤邯郸梦，犹注逍遥萹。\n郊扉未可闭，洪崖时拍肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其五 橘乐山","author":"杨慎","text":"后皇嘉树底，香影覆秋盘。\n樵子逢王质，幽人对谢安。\n兴来歌楚颂，策杖暮盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其六 莲地","author":"杨慎","text":"太乙遥分种，红云仙岛香。\n爽气金茎上，恩波银汉傍。\n田田新咏好，留刻戏鱼堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其七 茅阁","author":"杨慎","text":"三脊羞封禅，灵琼续楚辞。\n绿樽藉芳草，彩笔赋山茨。\n千载青霞意，应同孔稚圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史萧宗乐半间园八咏 其八 浮轩","author":"杨慎","text":"宫锦换渔蓑，浮家倚芰荷。\n月邀三太白，水漾百东坡。\n击汰归恒晚，鲛人识棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自滇归高峣留别胡在轩","author":"杨慎","text":"乘风归吾庐，临水饮君酒。\n颠倒白接䍦，攀折青杨柳。\n相望片帆程，相忆能来否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避暑林亭","author":"杨慎","text":"几席近涟漪，枕簟依林樾。\n琴声歇流水，扇影却明月。\n凉襟何逍遥，炎歊坐超忽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐及泉相送至斜堰河 其一","author":"杨慎","text":"滇隅流落鬓成丝，为忆家林恼梦思。\n沃野喜看平似掌，春郊载酒正花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐及泉相送至斜堰河 其二","author":"杨慎","text":"长沟流水引都江，断岸危桥窄石矼。\n并马不知村路远，更穿斜堰渡惊泷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"菜子花","author":"杨慎","text":"菜子花如黄金色，想见兰膏春盎碧。\n贫女梳头水当油，那和襟解闻芗泽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕稍凉坐蕊珠楼即景","author":"杨慎","text":"凉牗方开一幅天，疏星点缀冷金笺。\n嗈鸣雁过横斜字，写出秋声赋一篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水仙花四绝 其一","author":"杨慎","text":"淩波微步洛川傍，合与江梅竞晚芳。\n不见当年林处士，西湖配食水仙王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水仙花四绝 其二","author":"杨慎","text":"金盏银台映绿樽，清香况复赛兰荪。\n秪应岩桂为朋辈，未许山?作弟昆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水仙花四绝 其三","author":"杨慎","text":"瑶池阿母惜幽芳，青鸟东来未许将。\n小玉双成都睡去，一枝传自段安香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水仙花四绝 其四","author":"杨慎","text":"乘鲤琴高采掇新，蔚蓝天上少红尘。\n黄姑渚畔湔裙水，不是人间妒妇津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百日红","author":"杨慎","text":"李径桃蹊与杏丛，春来二十四番风。\n朝开暮落浑堪惜，何似雕阑百日红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜浮桥成","author":"杨慎","text":"腊尾江头绽早梅，浮梁银汉亘昭回。\n不须桂楫迎桃叶，步步金莲夜夜来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夕见美人过浮桥","author":"杨慎","text":"雁齿螭头影动摇，金波玉镜夜迢迢。\n忽逢罗袜轻盈步，疑是鲛人出卖绡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳五月五大热追凉江山平远楼 其一","author":"杨慎","text":"平远江山四望开，䬃然风至似兰台。\n披襟便觉凉如洗，一任城头暝色催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳五月五大热追凉江山平远楼 其二","author":"杨慎","text":"䬃然风至似兰台，此地那容热客来。\n姑射风姿冰雪妒，班姬团扇漫多才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳元宵韩炅庵送灯","author":"杨慎","text":"多病新春减醉狂，元宵作剧懒逢场。\n华灯珍重劳相赠，绣佛前头礼定光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滇海曲 其四","author":"杨慎","text":"叶榆巨浸环三岛，益部雄都控百蛮。\n神禹导河双洱水，武侯征路七星关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滇海曲 其七","author":"杨慎","text":"孤戍平沙望大荒，边愁海思入沧茫。\n帝乡东北仙云隔，?道西南媚景长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滇海曲 其八","author":"杨慎","text":"昆明池水三百里，汀花海藻十洲连。\n使者乘槎曾不到，空劳武帝御楼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白崖","author":"杨慎","text":"云开远见彩云州，一片烟岚鸟外浮。\n还见前年山下路，密蒙花发艳新秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"素馨花","author":"杨慎","text":"金碧佳人堕马妆，鹧鸪林里斗芬芳。\n穿花贯缕盘香雪，曾把风流恼陆郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"光尊寺别张愈光","author":"杨慎","text":"万里炎荒万里身，销魂何事别离频。\n光尊寺里桃应笑，回首东风九度春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦中作宫词","author":"杨慎","text":"长信宫中夜未央，斑姬团扇画秦王。\n三更云屋西风起，翠粲红罗满玉霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"粉团花","author":"杨慎","text":"靓饰礼容腻玉肌，轻风渥露锦屏帏。\n钗头懒戴应嫌重，留取馀香染夜衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桐梓驿元夕","author":"杨慎","text":"戴石孤峰古驿门，青羌吹角报黄昏。\n三家村里无灯火，千树梅花作上元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡蝶戏真珠花","author":"杨慎","text":"漆园仙梦到绡宫，栩栩轻烟袅袅风。\n九曲金针穿不得，瑶华光碎月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山茶花","author":"杨慎","text":"绿叶红英斗雪开，黄蜂粉蝶不曾来。\n海边珠树无颜色，羞把琼枝照玉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泛滇海归感旧口占","author":"杨慎","text":"谈笑巳无钱卧月，风流不见李华仙。\n渔村酒市经游处，斜日寒林锁暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄汉州太守刘仲粟","author":"杨慎","text":"南峰桃李遍峨岷，白发门生今几人。\n东阁郎君今健否，何时同醉雁桥春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中漫兴柬泓山中溪洱皋 其一","author":"杨慎","text":"风袅芭蕉羽扇斜，云峰苔壁对檐牙。\n满城连日黄梅雨，开遍金钗石斛花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中漫兴柬泓山中溪洱皋 其二","author":"杨慎","text":"簟纹如水帐如烟，凉气先秋到枕边。\n蚊脚蝇头迹如扫，右军嬴得静佳眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中漫兴柬泓山中溪洱皋 其三","author":"杨慎","text":"青山绕屋水周堂，枕底潺湲梦里凉。\n阶下濯缨怜孺子，吾庐应即是沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中漫兴柬泓山中溪洱皋 其四","author":"杨慎","text":"雨声萧寺喜留宾，窗竹檐花更可人。\n莫道相如徒四壁，壶中犹有锦江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夕","author":"杨慎","text":"湘水鱼鳞冷簟文，博山虫篆罢炉薰。\n开窗对影延新月，坐爱金波洗火云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊申高峣中秋风雨","author":"杨慎","text":"人家一片海心浮，彷佛楼台似十洲。\n不用梯云取明月，水晶宫里度中秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渔娃图","author":"杨慎","text":"碧玉声沉?井边，绿珠魂断舞楼前。\n风流毕竟输渔父，醉拥渔娃尽日眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其一","author":"杨慎","text":"狼山原上阵如云，孟渎河边早策勋。\n水弩解清川后浪，天戈能驻鲁阳曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其二","author":"杨慎","text":"旧统边军赤水犀，新封京观是鲸鲵。\n文昌奏入中黄霁，武库兵收太白低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其三","author":"杨慎","text":"按辔收兵枫树林，绝流飞渡早传音。\n风前鹢退吴山静，月下龙吟江水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其四","author":"杨慎","text":"关山新月照鸣茄，河朔清霜淬剑花。\n塞上征夫犹万里，北京归路敢言赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其五","author":"杨慎","text":"玄草清霜饱紫骝，雕戈画戟拥清油。\n归来始识从军乐，痛定翻思在贼愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其六","author":"杨慎","text":"嫖姚身健骕骦肥，立近天家日月旂。\n忽报内庭传圣旨，挂红分队出黄扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其七","author":"杨慎","text":"鹭鼓声中晓日暾，貔貅初散凤皇门。\n才从魏阙瞻中扆，便傀容台饮上尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其八","author":"杨慎","text":"去时官柳万枝黄，归路寒葭满地霜。\n挟纩已温良月候，吹纶更作小春芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其九","author":"杨慎","text":"三军喜气失严冬，万里中原罢战锋。\n甲帐筹功星两两，午门传捷日彤彤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼山凯歌 其十","author":"杨慎","text":"无定河边望旆旃，居延城外候烽烟。\n家家喜语占乌鹊，不用金钗当卜钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡中","author":"杨慎","text":"峡里青山梦里过，晓来春比夜来多。\n开蓬试看江头路，树树残梅照绿波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望中条","author":"杨慎","text":"征马长鸣向北风，崤关回首暮天东。\n太行过尽中条出，一路青山白雪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春郊即事 其一","author":"杨慎","text":"杨柳垂垂曲永滨，骊车日日送征尘。\n春来莫怪枝条少，无限临岐折赠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春郊即事 其二","author":"杨慎","text":"果园坊里杏花开，公子邀欢载酒来。\n醉落残英千万片，马头更折一枝回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]