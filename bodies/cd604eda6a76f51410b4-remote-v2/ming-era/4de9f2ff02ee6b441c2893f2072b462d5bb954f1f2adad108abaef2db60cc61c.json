[{"title":"大中桥晚眺","author":"欧大任","text":"佳气葱芊望不遥，汉家宫殿切丛霄。\n五陵车马今何在，依旧斜阳白下桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"报恩寺塔灯","author":"欧大任","text":"九级琉璃净土旁，帝城今现玉毫光。\n因看塔火知生灭，未必高僧舍利藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟山二首 其一","author":"欧大任","text":"钟山东望碧岧峣，玉殿金门隔绛霄。\n忆自鼎湖弓坠后，万年长受岳灵朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟山二首 其二","author":"欧大任","text":"松柏萧萧御道长，金衣绣袷羽林郎。\n上陵一曲铙歌动，千骑曾闻从武皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幕府山怀古","author":"欧大任","text":"渡江五马一为龙，开府勋名勒景钟。\n西望洛阳宫殿远，河山无处不边烽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸡鸣寺塔眺玄武湖","author":"欧大任","text":"乐游苑外夕阳沉，玄武堤边秋草深。\n何处飘零江左客，不禁烟桨五湖心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆宋霖望刘用时游西湖未返","author":"欧大任","text":"姑苏城下别风烟，闻尔从师上浙船。\n遥想女儿湖上醉，浴凫飞鹭锦帆边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过姑苏访郭郡博","author":"欧大任","text":"高士传家更有诗，偶从岭外荷君知。\n平原文学推匡鼎，此去吴门一解颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同郭郡博徐茂才登郡楼望太湖","author":"欧大任","text":"青山海涌石巑岏，楼上清秋笠泽寒。\n欲挟灵威丈人去，金庭玉霤醉中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"逢沅陵客因讯胡用颐","author":"欧大任","text":"龙江阙下惜离群，岭外逢人一问君。\n回首旧游千万里，澧兰沅芷不相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得徐叔子归长沙消息","author":"欧大任","text":"三年楚客独还家，北望京华路转赊。\n从此梦中难觅汝，不知何处是长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春别曲四首 其一","author":"欧大任","text":"寂寂青楼大道边，反反朱萼绮疏前。\n可怜万里关山月，无那房栊照独眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春别曲四首 其二","author":"欧大任","text":"门前江水去来潮，独下西洲路转遥。\n夜月葡萄萦锦树，春风杨柳拂河桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春别曲四首 其三","author":"欧大任","text":"自怜机上回文锦，偏恨堂前并蒂花。\n年华不及逢君色，春信何由到妾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春别曲四首 其四","author":"欧大任","text":"蛱蝶双双度晚风，鸳鸯两两小池东。\n愿随萧史升台上，恨逐嫦娥戏月中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月十五夜将赴苍梧舟中望月","author":"欧大任","text":"客里中秋赏已违，天涯凉月倍光辉。\n却怜少妇长相忆，何事征人独未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈大赴清远兼寄杨维舟","author":"欧大任","text":"寺里题名杨柳新，君游中宿更逢春。\n遥知杨子谈经处，共向山阿忆美人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟江上戏作采莲曲三首 其一","author":"欧大任","text":"兰舟忆昔下横塘，莲花初开莲叶长。\n谁道今朝鶗鴂至，回桡愁见两鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟江上戏作采莲曲三首 其二","author":"欧大任","text":"浦口齐歌出荡边，叶残花败未回船。\n风吹罗袖沾微雨，道是无情亦可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛舟江上戏作采莲曲三首 其三","author":"欧大任","text":"雨过蘼芜绿满洲，一双鸂鶒对沉浮。\n王孙画舫归何晚，日暮湘江无那愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画美人","author":"欧大任","text":"吹罢鸾箫斗柄高，旧人惟有薜阳陶。\n翻思十载扬州月，曾照船头白锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黎惟敬寄意二首 其一","author":"欧大任","text":"肠断西风荷芰衣，搴舟日暮浦烟微。\n鄂君翠被今何在，青草湖边一棹飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黎惟敬寄意二首 其二","author":"欧大任","text":"十二巫山日欲曛，相思谁更梦为云。\n烟波渺渺孤舟远，独折疏麻一寄君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题思伯画","author":"欧大任","text":"摵摵秋风隐高树，黄叶苍苔满庭户。\n青山自有下帷人，知是广川读书处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题惟敬画","author":"欧大任","text":"雾阁芸窗白石霏，夜寒轻飏五铢衣。\n仙人合在芙蓉馆，并驾青鸾上翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山池见月","author":"欧大任","text":"月色波光静倚阑，夜深萧飒独惊寒。\n临池对影长忧别，何况天涯别后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题文太史山水小幅二首 其一","author":"欧大任","text":"绿树溪边一草堂，风流应是辋川庄。\n题诗好在芙蓉沜，独下兰桡思渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题文太史山水小幅二首 其二","author":"欧大任","text":"精舍新开剡水滨，闭门风雪四无邻。\n前溪夜静闻篙桨，知有扁舟乘兴人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送玉雨","author":"欧大任","text":"曾向君家醉玉觥，岭南今日送飞旌。\n相看只有双垂泪，马首无从拜北平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺情","author":"欧大任","text":"双燕风斜款款低，春深楼上早归栖。\n郎骑白马向何处，妾在临邛西更西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登粤王台","author":"欧大任","text":"呼鸾道上粤王台，粤王如今安在哉。\n惟有太行秋雁字，一年一度一飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"池上","author":"欧大任","text":"群鱼圉圉足池水，雨过忽添一尺强。\n移向长江看变化，云涛千顷更禁当。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郑克一","author":"欧大任","text":"故人高卧久藏名，有约来同旧酒鎗。\n闻道公车求茂异，名儒将召郑康成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题西洲精舍图","author":"欧大任","text":"精庐新卜蓼花洲，隐几萧然已觉秋。\n坞西有客期未至，日暮临流看白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月八夜山馆纳凉","author":"欧大任","text":"淅淅金风吹玉扉，夜深清露坠罗衣。\n谁言欢逐昨宵去，银渚含情似未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"班姬怨","author":"欧大任","text":"侍奉长门雨露新，不知团扇委埃尘。\n秋风燕入深宫里，惟有砧声不负人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送彭栋","author":"欧大任","text":"故人相访到天涯，十载秦关梦尔家。\n归去岭头逢驿使，相思早为寄梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同家兄公毅泊舟青萝山下忆故从兄元龙四首 其一","author":"欧大任","text":"蓑笠冲寒晚系舟，知君泉下亦离忧。\n不须浪泊他年路，已忆平生马少游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同家兄公毅泊舟青萝山下忆故从兄元龙四首 其二","author":"欧大任","text":"冒寒曾上抱旗山，逸步飘然不可攀。\n明日招魂向山上，江南摇落早知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同家兄公毅泊舟青萝山下忆故从兄元龙四首 其三","author":"欧大任","text":"忆君同泊海西津，夜半围炉酒百巡。\n今夜扁舟惟有泪，满江风雪觅何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同家兄公毅泊舟青萝山下忆故从兄元龙四首 其四","author":"欧大任","text":"死别千年无见期，平生幽恨独君知。\n萧萧松柏悲风起，犹记萝山恸哭时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"欧大任","text":"四壁萧然客计贫，药炉诗卷伴闲身。\n秋来夜夜西园月，不似同游邺下人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瘗小侄幼初于先陇下归路感伤不已","author":"欧大任","text":"一夜清霜凋玉兰，坟封三尺委茅菅。\n鸣蛩断续精魂泣，回首荒山落月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫怨和叶文学四首 其一","author":"欧大任","text":"一别增城岁月移，房栊萧瑟朔风吹。\n铜墀玉砌依然在，曾见君王旧履綦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫怨和叶文学四首 其二","author":"欧大任","text":"遥闻歌吹火辉煌，独抚流尘暗洞房。\n宫禁重重魂梦远，枕边容易到昭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫怨和叶文学四首 其三","author":"欧大任","text":"金屋沉沉积雪光，卧听宫漏近南廊。\n月华若向方诸照，应为长门滴数行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫怨和叶文学四首 其四","author":"欧大任","text":"独夜调琴荐玉杯，轻霜犹恐近瑶台。\n楚妃魏女无劳妒，洛水巫山入梦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天湖亭早梅","author":"欧大任","text":"九月天湖湖水涯，霜侵铁干影横斜。\n岭头想是春先到，已见西樵第一花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经铁泉精舍","author":"欧大任","text":"精庐时有白云封，鹤怨猿啼思万重。\n伯鸾一冢长邻近，山木萧萧传暝钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹤花","author":"欧大任","text":"瑶池前夜宴初开，风驭云軿自往回。\n为问紫姑何处去，鹤群长绕此山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观卢文卓所藏郭岩山人画菊","author":"欧大任","text":"黄华寒倚石嶙峋，画幅萧閒见写真。\n风雪独逢卢处士，江湖犹忆郭山人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜过关伯玉","author":"欧大任","text":"月照江梅雪满枝，绕堤閒咏左思诗。\n夜深乘兴那辞远，为是溪堂有戴逵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮怀古","author":"欧大任","text":"闾史无书乐府残，感时怀古泪汍澜。\n出门一笑浮云散，惟有青山不厌看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜山房听雨怀潜父彦国士鹄仲登四子二首 其一","author":"欧大任","text":"滴尽寒更睡不成，乍疑双瀑月中鸣。\n可堪独剪西窗烛，闲却山房夜雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜山房听雨怀潜父彦国士鹄仲登四子二首 其二","author":"欧大任","text":"听雨西堂夜寂寥，绿波芳草恨迢迢。\n东风解送离人梦，曾过溪南第几桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下碧桃花盛开","author":"欧大任","text":"玉貌承恩春最浓，楼头不怨五更风。\n三千珠翠无颜色，谁似嫦娥戏月中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫君谦夜过","author":"欧大任","text":"三年梦远怅如何，江海逢君秋色多。\n谁见幽人独醒去，依依残月照藤萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜访蔡子铎","author":"欧大任","text":"访君灯下砌蛩啼，月满千山霜满溪。\n从此相寻知不远，梦来应过浣花西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题关元诚所藏赵观四景画 其一","author":"欧大任","text":"千峰茅屋夐无邻，津口花开始识春。\n自是太平多隐逸，山人不是避秦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题关元诚所藏赵观四景画 其二","author":"欧大任","text":"绿树青山日未斜，镜湖一曲有荷花。\n云霞隐映开元敕，行客遥知贺监家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题关元诚所藏赵观四景画 其三","author":"欧大任","text":"秋江无客共衔杯，酤酒前村艇未回。\n自信机心忘已久，开门无数白鸥来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题关元诚所藏赵观四景画 其四","author":"欧大任","text":"蹇驴倦仆朔风寒，路远翻愁雪未乾。\n此去寻梅因觅句，灞陵桥上几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同冯用唯陈士鹄夜集郑克一宅","author":"欧大任","text":"郑庄留客有醇醪，沉醉尊前谢二豪。\n后夜还山弄明月，白云相忆在鸣皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题洞庭渔家图","author":"欧大任","text":"岳州西望洞庭山，万里烟波羡汝闲。\n湖上卖鱼仍买酒，钓船犹载夕阳还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎惟仁山房别陈宗益还新溪","author":"欧大任","text":"高楼送客夜悠悠，独立风烟咏四愁。\n归去故园谁是伴，雪晴江上一孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠江上留别孔元锡","author":"欧大任","text":"扁舟江上待寒潮，归去孤村正寂寥。\n却忆山钟谁共听，诃林寺里赤阑桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题吴而谦野客堂","author":"欧大任","text":"白首昂藏海鹤姿，翛然林下一茅茨。\n北窗似是羲皇世，惟许柴桑旧令知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬雨病滞城中送猷弟还家","author":"欧大任","text":"脊令风急正分飞，极目西津浦树微。\n旅病欲归归未得，孤城零雨自沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画酴醾","author":"欧大任","text":"涂黄妆翠出帘栊，玉脸娇来带酒红。\n可是瑶池有嘉宴，夜深低舞月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"木芙蓉花便面","author":"欧大任","text":"解佩何来路渺茫，明河天上望空长。\n江妃似怨秋风早，露下分明滴数行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕词","author":"欧大任","text":"白榆丹桂影悠悠，银汉无波月正秋。\n牛女桥边自来去，岂知人世有离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫人望幸词四首 其一","author":"欧大任","text":"玉貌临风几欲仙，掌中歌舞为谁怜。\n自知不洒门前叶，只待羊车日似年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫人望幸词四首 其二","author":"欧大任","text":"暗数佳期欲渡河，罗衣休问夜如何。\n汉宫恩泽如秋露，万岁枝头得最多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫人望幸词四首 其三","author":"欧大任","text":"同时豹尾数相随，自许当熊亦不辞。\n红粉三千各秋色，独悬明月照蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫人望幸词四首 其四","author":"欧大任","text":"碧落空歌去莫攀，彩云不散候龙颜。\n寄书为问西王母，更宴瑶池几日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春过就芝亭玩秋海棠","author":"欧大任","text":"沉香亭上酒醒迟，正是君王赐浴时。\n知尔先秋畏摇落，十分春色在蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凝秀阁前对虞美人草","author":"欧大任","text":"起舞尊前掩泪痕，芳魂何意傍兰荪。\n楚歌月下无人听，露泣烟啼恋主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"碧鉴江上与少承别后却寄","author":"欧大任","text":"一片秋波万叠山，丹枫白草夕阳间。\n征鸿只解将愁去，不见孤帆送客还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]