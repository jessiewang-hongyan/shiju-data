[{"title":"钓月为梁秀夫题十首 其五","author":"苏仲","text":"娟娟初月上，皎皎水中央。\n几处桡歌起，知公舞袖长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓月为梁秀夫题十首 其六","author":"苏仲","text":"从古蓑笠翁，云水自怡悦。\n不是先生来，江皋虚夜月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓月为梁秀夫题十首 其七","author":"苏仲","text":"兔影涵波光，浪平无钓饵。\n自学詹何翁，高蹈平生志。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓月为梁秀夫题十首 其八","author":"苏仲","text":"泮浦月色高，渔船相趁发。\n沧浪歌者谁，向此云中没。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓月为梁秀夫题十首 其九","author":"苏仲","text":"借问取鱼人，用巧如用拙。\n岂识个中心，一竿蟾光活。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓月为梁秀夫题十首 其十","author":"苏仲","text":"一钓连六鳌，千秋无一遇。\n何如溪上游，钓取天边趣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏五首 其一","author":"苏仲","text":"法士慕观音，想像如或见。\n我心观世音，常向人间现。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏五首 其二","author":"苏仲","text":"僧徒慕大佛，诵经过千日。\n大佛在我心，不在传与习。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏五首 其三","author":"苏仲","text":"齐人齐得口，不食鱼与肉。\n如何不齐心，遇事生百毒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏五首 其四","author":"苏仲","text":"古人重懿行，今人重词说。\n词说会媚人，不如甘老拙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏五首 其五","author":"苏仲","text":"上士思修身，下士思修名。\n身名俱不管，何事诵遗经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示仆","author":"苏仲","text":"薪水岁月间，勤劳徒尔尔。\n借问行路人，谁献辽东豕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都下次门人赵元默见寄韵","author":"苏仲","text":"遗经糟粕浪相闻，忆醉山在几度春。\n料得往年风味好，夕阳江口脍红鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何伯洪还乡","author":"苏仲","text":"笑谈杯酒旧交中，转眼乌纱冠世雄。\n万里计程花下月，著鞭归去马如龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其一","author":"苏仲","text":"得莫欣欣失莫悲，乐天忘分我何疑。\n丈夫胸次自磊落，作事悻悻非男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其二","author":"苏仲","text":"得莫欣欣失莫悲，一毫荣辱不须疑。\n白云舒卷自舒卷，有酒在壶斟酌之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其三","author":"苏仲","text":"得莫欣欣失莫悲，天公付与竟何疑。\n鹍鹏自大鹪鹩小，衡岳愈高沧海卑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其四","author":"苏仲","text":"得莫欣欣失莫悲，著身难自计安危。\n丁公自谓真逢汉，对面翻成是祸机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其五","author":"苏仲","text":"得莫欣欣失莫悲，是谁先我得天机。\n龙飞蠖屈真男子，局蹐人间岂解知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其六","author":"苏仲","text":"得莫欣欣失莫悲，悠悠世态野花飞。\n楼台溷厕各不等，落处随风非所知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其七","author":"苏仲","text":"得莫欣欣失莫悲，虫肝鼠臂亦何辞。\n格天事业不足侈，一片浮云过眼飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题八首 其八","author":"苏仲","text":"得莫欣欣失莫悲，隙光于我有何私。\n落花啼鸟春归去，绿鬓朱颜能几时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻陈公晦讣音","author":"苏仲","text":"芹宫长傍柳塘阴，诗酒相逢话古心。\n收拾豪华千载去，柳塘风月更谁深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和边太守送还韵四首 其一","author":"苏仲","text":"老病京郎敌郡郎，故人相见酒杯长。\n此情此意谁知得，海阔云深共渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和边太守送还韵四首 其二","author":"苏仲","text":"附骥曾陪入锁闱，别来春雨几霏霏。\n相逢又上荆台饮，宾主殷勤尽醉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和边太守送还韵四首 其三","author":"苏仲","text":"偶向云山纵马蹄，楚城风景遍东西。\n楼台处处莺花好，尽属黄堂太守题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和边太守送还韵四首 其四","author":"苏仲","text":"自古江陵是壮游，春风三日为君留。\n岳阳胜概还如旧，只少君诗写上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和边太守登城韵","author":"苏仲","text":"拂云城郭倚天楼，雄据湖湘第一州。\n扼险有人居重地，万家春色映江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花和同年李梦弼太史韵","author":"苏仲","text":"胭脂和粉染春妆，笑领春风倚短墙。\n情态逼人看不倦，梦中相忆兴犹狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔父词三首 其一","author":"苏仲","text":"有生踪迹寄沧茫，身著蓑衣住水乡。\n不识王侯高第宅，片篷高厂午风凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔父词三首 其二","author":"苏仲","text":"生长江湖寄一蓑，扁舟随日钓烟波。\n得鱼博得瓶中米，明月津头又放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔父词三首 其三","author":"苏仲","text":"白水茫茫是我家，船头明月照芦花。\n晚风吹醒江湖梦，挂起纶竿夜煮茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉怀边太守","author":"苏仲","text":"迢迢远道上荆门，曾问人家几处村。\n单骑劝农黄太守，草根犹有马蹄諠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成三首 其一","author":"苏仲","text":"觚不觚兮觚不觚，脚根无力眼模糊。\n利名总是迷人路，归去青山有坦途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成三首 其二","author":"苏仲","text":"呼不来兮呼不呼，错看溪水是江湖。\n青天白日不归去，苦雨长风欲问途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成三首 其三","author":"苏仲","text":"狙不狙兮狙不狙，羊裘人已占江湖。\n行藏本是悬星斗，不是狙公不养狙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊","author":"苏仲","text":"溪水溪毛两岸深，溪烟溪雨半晴阴。\n扁舟晚向溪湾泊，欸乃渔歌何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳顶精舍为柳上舍题用吴大参韵四首 其一","author":"苏仲","text":"白云堆里掩山扉，兀坐焚香悟化机。\n欲识天心何处是，一圈之下契玄微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳顶精舍为柳上舍题用吴大参韵四首 其二","author":"苏仲","text":"岳顶何人搆一扉，石盘钻透见天机。\n纷华世故消磨尽，一点尘埃到此微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳顶精舍为柳上舍题用吴大参韵四首 其三","author":"苏仲","text":"坐到更深月到扉，惺惺不是悟禅机。\n知君唤醒几年梦，化化生生总在微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳顶精舍为柳上舍题用吴大参韵四首 其四","author":"苏仲","text":"绕屋烟云白板扉，何人于此会真机。\n箪瓢共对颜生乐，敢道藏修得力微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到象州","author":"苏仲","text":"瓦瓶短嘴泻山浆，玉粒长腰煮饭香。\n俗朴民淳官府拙，饱餐浓饮度年光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游象山台","author":"苏仲","text":"水回山绕亦奇哉，只说甘公是俊才。\n雏凤卧龙何处觅，班班花鸟象山台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招朗司厅饮蒙以诗谢因步韵答之","author":"苏仲","text":"野簌山肴酒瓮开，衣冠谈笑不羁才。\n岛中一味闲光景，还欠三更月上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予游象山台既有班班花鸟之句朗司厅适见之以为诮己也因再咏以释其意盖岂绝望于象之无人耶","author":"苏仲","text":"象台老守亦悠哉，问水寻山日几回。\n一道涧泉烟锁断，白云庵底有寒梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈白沙对菊五首 其一","author":"苏仲","text":"月满江篱水漾沙，可人诗酒只黄花。\n采芳莫谓春山少，那得风霜晚更嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈白沙对菊五首 其二","author":"苏仲","text":"渊明无有菊花诗，诗到江门两不亏。\n我亦后来传法眼，相看休道不相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈白沙对菊五首 其三","author":"苏仲","text":"爱杀花丛郭外村，藜床移近月当门。\n酒杯不浪虚时节，正恐秋霜满鬃根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈白沙对菊五首 其四","author":"苏仲","text":"处士归来旧菊丛，风流千载到于侬。\n抹藤笑饮登高酒，犹记当年落帽风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈白沙对菊五首 其五","author":"苏仲","text":"疏篱淡淡拥秋光，晚节相看色最香。\n赖有老妻知我意，每朝沽酒遣儿尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏慈乌","author":"苏仲","text":"人间反哺擅虚名，屋角无劳搏啄声。\n安乐野田餐腐鼠，凤凰今已九霄鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉中有感","author":"苏仲","text":"宇宙纷纷势利间，相逢冠盖尽朱颜。\n老夫自爱茅檐下，洗眼东风看雪山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵景行送族人还福州韵二首 其一","author":"苏仲","text":"才到春光便有诗，野蒲新柳自依依。\n远来问族人何有，多得厓门几道碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵景行送族人还福州韵二首 其二","author":"苏仲","text":"留住沙汀系短舟，分携宗戚易生愁。\n鹡鸰惊起滩头梦，粤水闽山两地游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁应和许访继芳亭中不果赋此迓之","author":"苏仲","text":"溪槛时开待故人，故人不来看白云。\n白云散尽无消息，起望溪头日已曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"苏仲","text":"海错山毛绿泼醅，何如江店野人杯。\n短篱醉共黄花笑，尘务那容到耳来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萧太守送菊于吾邑邱大尹公公有诗索和","author":"苏仲","text":"不爱人间一撚腰，老逢花酒兴偏消。\n先生爱菊山人献，淡淡秋容手自招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馆小亭独坐","author":"苏仲","text":"院寓沈沈小小亭，棘篱花好不胜情。\n夜深月满纱厨白，坐落星河斗柄横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水仙花和黄太史韵","author":"苏仲","text":"仙子名花品亦奇，沈檀和露湿香肌。\n风流惹得人千古，何事罗敷老树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读负版传","author":"苏仲","text":"负版当年亦著名，操觚何者是留情。\n莫将只为贪婪计，欲唤人间醉者醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝","author":"苏仲","text":"鼓角惊残梦，催衣上道频。\n雁声横帽顶，马背数星辰。\n恋阙心常切，安邦策未陈。\n孤危能自立，安敢负吾君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"试院中送边太守赴总制府赞理戎务","author":"苏仲","text":"乾坤交义重，杯酒笑谈频。\n作郡年华妙，工诗格调新。\n江山才驻马，草木已回春。\n领檄辕门去，人誇策有神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘同年奉使浙西造坟","author":"苏仲","text":"玉阙颁新命，金符重旧臣。\n壮心持使节，枯骨感皇仁。\n草树连云远，旌幢映日新。\n祖筵歌赠别，分手几同寅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽徐良佐正郎","author":"苏仲","text":"运斤才放手，游刃欲通神。\n烂熳花经雨，圆光镜掩尘。\n遗芳留太史，馀燄照苍旻。\n岂学夸毗子，甘同草木春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀诸会友","author":"苏仲","text":"世路疏投分，天涯未了心。\n看云思往论，乘月谩闲吟。\n别久何年约，归期是处寻。\n江湖身万里，终是少知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对花","author":"苏仲","text":"亭前方丈地，犹种几株花。\n暖日麻姑酒，春风陆羽茶。\n芳容朝锁雾，艳色晚薰霞。\n最爱春晴好，长看兴未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读红鹦鹉偶作","author":"苏仲","text":"美质生应异，红衣独擅名。\n能言机便巧，学语性玄灵。\n定忆朱为喙，多疑血染翎。\n我惭非祢子，挥管赋难成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪","author":"苏仲","text":"冻苦燕门地，冬初雪蔽空。\n严凝毡毳薄，冷颤鬓毛蓬。\n玉树擎龙势，瑶阶失蚁封。\n无钱难觅酒，访戴兴徒浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"责子赋此自解","author":"苏仲","text":"不为痴顽怒，那知气数穷。\n省躬虽老子，得性自天公。\n每见黎民变，难教圣子聪。\n顾非湖海地，安得有鱼龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承檄往夷中途次二首 其一","author":"苏仲","text":"混沌初开后，风烟各自分。\n山中荒境界，世外小乾坤。\n居近狐狸穴，人同犬豕群。\n自从归圣化，方得染尧仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承檄往夷中途次二首 其二","author":"苏仲","text":"徼外夷人境，溪流一线通。\n山峰银笔架，石壁锦屏风。\n雾隐千岩暗，霜凋万木红。\n土丁相打话，似笑白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游君山二首 其一","author":"苏仲","text":"浅水停舟楫，轻衣渡石关。\n烟光浮晚峒，云影出秋湾。\n寺古佛亦古，僧闲犬更闲。\n落霞连老树，霜叶斗红殷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游君山二首 其二","author":"苏仲","text":"老眼看山惯，羸躯渡险难。\n日低啼鸟倦，霜重野花残。\n落叶随风舞，浓烟锁涧寒。\n不愁归路晚，天际有飞翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山寺","author":"苏仲","text":"片石生鳌背，孤汀碍水流。\n亭台先见月，风雨早惊秋。\n敲板江鼋出，闻钟海鹤收。\n停桡添逸兴，真是称心游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹夫人","author":"苏仲","text":"刷竹工倕巧，胚胎结搆成。\n混然无具体，徒尔有虚名。\n雅可供高卧，难堪托世情。\n炎凉随用舍，终是一团清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日访山家三首 其一","author":"苏仲","text":"脚根随拄杖，古洞杳青烟。\n草屋依岩绿，苔阶积雨鲜。\n茶烹山顶叶，井汲涧边泉。\n欲问逍遥事，相看□不言。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日访山家三首 其二","author":"苏仲","text":"山人山不远，望望隔云烟。\n曲径穿林密，危桥渡涧缠。\n舍旁鸡犬散，墙外竹松连。\n喜客开新酿，盆中水蕨鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]