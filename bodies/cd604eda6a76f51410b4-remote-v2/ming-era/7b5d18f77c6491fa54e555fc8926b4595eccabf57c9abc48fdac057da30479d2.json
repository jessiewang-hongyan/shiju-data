[{"title":"夏日访李少府 其一","author":"区越","text":"结庐人境两三间，近傍宫墙水一湾。\n几度寻君来小次，晚风絺绤动微寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日访李少府 其二","author":"区越","text":"诗瓢远远出林间，紫水西来转数湾。\n春过末由赓短唱，骚坛愁杀旧盟寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答汤涧松 其一","author":"区越","text":"主人呼酒入花间，野客方舟向柳湾。\n潇散正多天与健，昂藏休尽鹤同寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答汤涧松 其二","author":"区越","text":"一种花须百种勤，看花须念养花人。\n闲门半掩东风面，九老同来正及辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过钟海月先祠杂兴 其一","author":"区越","text":"原田积潦稻成空，老釜扬尘灶息红。\n谁与贫人共年谷，层楼独见树高风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过钟海月先祠杂兴 其二","author":"区越","text":"一上骚坛话未休，沾毫染翰岁将周。\n巫山巫峡多秋兴，杜老新诗字字愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过钟海月先祠杂兴 其三","author":"区越","text":"未将身世等虚舟，总是閒人也白头。\n骚客夜吟惊叶落，美人秋倦为花愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过钟海月先祠杂兴 其四","author":"区越","text":"太白诗成泣鬼神，鲍分俊逸庾清新。\n切磋斯道千年在，白首如公有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨和何雩峰遣怀 其一","author":"区越","text":"浩浩怀山势莫回，江村四望绝烟埃。\n堪怜几处为鱼鳖，黄潦惊漂栋宇来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨和何雩峰遣怀 其二","author":"区越","text":"愁闻万姓泣呼天，庐井烟沉海一连。\n亦恐尧仁忧未及，九年无水祸南边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨和何雩峰遣怀 其三","author":"区越","text":"风声号杂雨声号，上岸涛翻下岸涛。\n九夏淹霪忧不断，村南村北水周遭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨和何雩峰遣怀 其四","author":"区越","text":"酒于元亮却无怀，道在尧夫亦打乖。\n老觉希贤心独在，相思一夜遍天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤涧松诞日次韵 其一","author":"区越","text":"半酣画里看芙蓉，仿佛西湖二月中。\n冷蕊疏枝无处觅，安排杖履又随公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤涧松诞日次韵 其二","author":"区越","text":"白社非陶社未光，可堪长笛怨山阳。\n多君弄置当年调，留得横斜满树香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送莫三尹应朝 其一","author":"区越","text":"夹溪黄叶下萧骚，上濑船轻易著篙。\n风起棘林催凤翼，天开云路渐鸿毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送莫三尹应朝 其二","author":"区越","text":"明庭面奏安人略，相府亲书佐县劳。\n最是重来春有脚，岭梅消息近南梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张明府冬日召饮次韵","author":"区越","text":"大厦三冬可庇寒，老年诗酒正交欢。\n林庐欲画孤山影，风雪休关五柳门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日钟粤江邀饮次韵 其一","author":"区越","text":"云山云水葛衣裳，静处无机动有常。\n何处好风邀共酌，南来一味透窗凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日钟粤江邀饮次韵 其二","author":"区越","text":"闲时白羽但邀凉，懒着荷衣怕骇常。\n付与乡评还月旦，古来嘉会重冠裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日会林云鹤宅 其一","author":"区越","text":"拂面南风午更频，林间高阁望车尘。\n紫霞杯里千年酒，且作花前半醉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日会林云鹤宅 其二","author":"区越","text":"青门爱客献瓜频，五色离离不染尘。\n谁念故侯身未老，水边林下作閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈大云召饮次韵 其一","author":"区越","text":"图刻山阴旧本明，流杯恐亦慕虚名。\n太丘不入诸贤会，百里何人见德星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈大云召饮次韵 其二","author":"区越","text":"长溪照我鬓星星，每日寻君懒刺名。\n江阁不知长夏过，岸花闲映水花明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李铁谷召会韵 其一","author":"区越","text":"疏通渠曲引泉源，灌药多年药满园。\n岁晚只寻松竹去，冷风寒日影翩翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李铁谷召会韵 其二","author":"区越","text":"山简寻诗出汉源，习家池馆李家园。\n清音四起丹林动，白鸟群飞绿浪翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李铁谷召会韵 其三","author":"区越","text":"花来劝饮何源源，醉倒不知何处园。\n莫问解醒多少在，刘郎当日口澜翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李铁谷召会韵 其四","author":"区越","text":"先春粟粒瀹寒源，占断风光共一园。\n歌竟玉川归未得，巅崖空见两旗翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月社会和林见山韵 其一","author":"区越","text":"主人贳酒客停车，入户群山画不如。\n见说南枝标略异，又携新酿下阶除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月社会和林见山韵 其二","author":"区越","text":"又携新酿下阶除，老脚寻春少不如。\n白首相知正相乐，沙村何事欲膏车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋饮钟海月席中海月昔登山有诗众推为雅调也故因同社诸君之许诵之 其一","author":"区越","text":"扪萝共扫碧台烟，一洞天开一洞天。\n诗社称公多杰作，同来登眺更超然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋饮钟海月席中海月昔登山有诗众推为雅调也故因同社诸君之许诵之 其二","author":"区越","text":"烟云逼眼尽诗情，落笔何时造次成。\n近体看君新入格，西山从此著诗名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张井泉社约时林云鹤李铁谷不至许南溟无诗 其一","author":"区越","text":"雨洗香车七夕秋，萧萧村郭断清游。\n诸仙会有西山乐，天与晴明不费求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张井泉社约时林云鹤李铁谷不至许南溟无诗 其二","author":"区越","text":"晴郊着屐远寻诗，记得西山会有期。\n同过石桥望秋色，不知东谷有蔷薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张井泉社约时林云鹤李铁谷不至许南溟无诗 其三","author":"区越","text":"南溟水月来茫茫，何处无诗载野航。\n海月开樽望三益，不应遗响断横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张井泉社约时林云鹤李铁谷不至许南溟无诗 其四","author":"区越","text":"老怀偏爱酒浇诗，况是荷亭畅饮时。\n应怕水仙欺白发，霜天姑待菊离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈大云诞日诗召和 其一","author":"区越","text":"水绕花环寿域春，软红飞断六街尘。\n醉中谙得华胥路，始信家君酒有神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈大云诞日诗召和 其二","author":"区越","text":"山中毛颖不中书，颂祷惭来一字无。\n太酌径须从沈老，苦吟时复见黄初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d