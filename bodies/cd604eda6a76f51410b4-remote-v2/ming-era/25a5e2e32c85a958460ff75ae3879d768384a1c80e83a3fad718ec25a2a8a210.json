[{"title":"忆母","author":"殷奎","text":"底事别离苦，忽当贫贱年。\n晨昏三载隔，梦寐五更连。\n老泪寒灯下，愁容暗镜前。\n此冤无乃酷，焉得问高天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵金德儒秋怀 其一","author":"殷奎","text":"只影飘萧渭水头，凉风白雁一天秋。\n秦云未改南山色，汉月空涵故国愁。\n万古勋名随野马，百年心事付沙鸥。\n后生莫漫誇形胜，舆地而今混九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵金德儒秋怀 其二","author":"殷奎","text":"青山才见便低头，况复频伤宋玉秋。\n万户新霜添客况，一窗凉月伴人愁。\n扶摇敢附云间翼，浩荡思随海上鸥。\n忽得君诗还喜剧，犹疑老杜在鄜州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送古季初主簿之永寿兼简孟宾知县丁仁卿县丞","author":"殷奎","text":"客里难持送客杯，愁肠几度为君开。\n特科方重词章选，小试应多簿领才。\n?窟击鲜山雪盛，蜂房割蜜县花开。\n官僚转觉麻亭好，谈笑何时许一陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送宜川刘知县赴都","author":"殷奎","text":"世科怜继美，出宰重宜川。\n陶穴流移复，边城谣颂传。\n一双王令舄，五鼓郑侯船。\n目送南云晚，题诗为惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱子方之永寿访孟明府 其一","author":"殷奎","text":"十二街头雪未消，蹇驴驮醉影飘萧。\n凭君说向麻亭尹，如此疏顽可见招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱子方之永寿访孟明府 其二","author":"殷奎","text":"小车渡浅水流烟，更上长船望碧天。\n有兴欲寻安道去，秦原高处不通川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄠簿袁鲁瞻见访","author":"殷奎","text":"下马敲门月色新，语音遥认是乡人。\n驰驱王事贤劳日，问讯吾徒寂寞滨。\n白饭可能淹骑从，青灯空复伴吟身。\n平生鄠杜佳山水，便欲同游第一春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵邢之翰南行留别 其一","author":"殷奎","text":"人事那堪定，身谋政自艰。\n向隅怜一恸，满座辍群欢。\n鸠快邯笼放，鱼矜汉网宽。\n妻孥谁是寄，早早报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵邢之翰南行留别 其二","author":"殷奎","text":"一旦膺萧律，三时守楚阍。\n穷愁关月淡，幽愤海天昏。\n纪咏伤前事，归耕几后恩。\n柳州才岂拙，无用问天孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送唐彦博县宰朝京","author":"殷奎","text":"去思此日盈汧陇，试问同年得似无。\n万里关河携一鹤，五城楼观蹋双凫。\n封书客里春仍寄，别酒沙头晚更沽。\n江上故人如问我，为言归思满江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕俞玄善同宿","author":"殷奎","text":"牢落岁除辰，那堪是客身。\n娱亲三载缺，入夜百忧新。\n连榻思归伴，残灯未睡人。\n相看无一语，独有泪盈巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新年","author":"殷奎","text":"故园弟妹拜新年，应望咸阳一黯然。\n西县东城南北第，阿娘今日在谁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游雎村寺观杨太妃墓志","author":"殷奎","text":"骑驴上厓去，去到雎村寺。\n空院一僧居，荒榛几人至。\n片石卧山门，上有唐朝字。\n知是武家坟，咸亨岁中志。\n王礼葬已厚，戚苑恩更异。\n尊号换穹碑，园陵易新制。\n谁知发掘馀，此石犹在世。\n摩挲一俛仰，咄彼千载事。\n夕阳归去来，渭水方东逝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顺陵独游","author":"殷奎","text":"顺陵山下客来稀，野草荒荒日色微。\n走穴黄狐窥我过，惊场彩雉背人飞。\n厚藏自古多为累，僭制终唐竟莫非。\n读罢穹碑吾亦愧，道傍拂袖一歔欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西原游望","author":"殷奎","text":"层原横百里，一望五陵空。\n云过山城黑，风来野烧红。\n吟身驴子上，归思雁行东。\n薄暮沙尘起，令人叹转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答巩昌诸县枉顾不值","author":"殷奎","text":"空烦车马扣云关，不是先生不得閒。\n为报今朝有幽兴，半醒半醉去游山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别岁","author":"殷奎","text":"一番来咸阳，三与芳岁别。\n四方数万里，行役何时歇。\n百年要有尽，能得几时节。\n而况已过半，远道何由彻。\n愁来不成寐，耿耿到明发。\n乾艾匪他求，鱼网当退结。\n秣我枥上骓，膏我车上辖。\n努力遵往轨，无为徒惙惙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"原上早春","author":"殷奎","text":"咸阳原上春冥冥，南山北山相对青。\n山如逆旅镇长在，百年过客无时停。\n高低冈坂纵横道，今坟古墓知多少。\n年年来往换新人，恰似春风原上草。\n草枯只是一年期，人葬终无出土时。\n贵贱贤愚同一尽，何用空名万古垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月七日省牲诸陵沿道杂赋五首 其四","author":"殷奎","text":"野老门前社树青，社公无酒眼醒醒。\n春泥二月无人上，尽作城头筑土丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杜处士宅","author":"殷奎","text":"乔木苍苍北杜村，百年人物几家存。\n一枝气在冲和地，五世名全孝义门。\n壁上诗章犹未泯，碑阴谱牒尚堪论。\n不因种德何能尔，更拟流风到后昆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄谢杜德方兼简刘禀中","author":"殷奎","text":"百五无家思不聊，北庄居士忽相邀。\n石安原上春无限，杜老堂前酒正饶。\n第二回圆怜月夜，不多人醉赏花朝。\n临岐欲觅刘郎别，已入丹崖不可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安新城 其一","author":"殷奎","text":"贤王来镇陜关西，增广都城弗敢稽。\n势兼北苑一绳直，声殷南山万杵齐。\n晴角远从天汉落，春旗平拂斗杓低。\n喜看保障如磐石，为赋秦风气似霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安新城 其二","author":"殷奎","text":"纸钱如雪草如烟，百五家家上墓田。\n春去思乡浑欲老，愁来欹枕不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"施佥宪行部口占奉柬","author":"殷奎","text":"今朝出郭看桑麻，载道歌谣事匪誇。\n天上法星初弭节，人间甘雨已随车。\n丹书历历烦申诫，白简棱棱惯击邪。\n顿使西人谈美政，尽将光彩耀儒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈情一首同呈","author":"殷奎","text":"曾因才短故辞官，还得前时苜蓿盘。\n病骨支离惭倚席，客怀牢落强峨冠。\n慈闱老去家贫甚，先垄年来水啮残。\n圣主仁深恩例在，愿推馀润到荒寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白起城见榴花一株","author":"殷奎","text":"城下茨藜十里沙，城中无处觅人家。\n琼英开遍无人赏，肠断衰翁对日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题胡御史松溪小隐","author":"殷奎","text":"轩冕山林政不殊，行藏偶尔见规模。\n豸冠剩有清风在，鹤帐从教夜月孤。\n小隐谁知非大隐，故吾元不异今吾。\n黑头更上麒麟阁，松菊归来尚未芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杜曲二绝句 其二","author":"殷奎","text":"青山隔岸水平畴，高柳阴阴五月秋。\n旋汲寒泉沉碧李，横眠白石漱清流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过廉平章樊川别墅","author":"殷奎","text":"山水娱人未肯休，登临何事白人头。\n君看花木樊川墅，秪有廉泉独自流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后望终南山作","author":"殷奎","text":"万岭千崖紫翠团，山城过雨一番看。\n断云面面屏风叠，残照棱棱剑脊攒。\n华岳三峰晴戴雪，草堂六月昼生寒。\n兴来便欲扶筇去，无限归心此际宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送汉中太守费浩然朝京","author":"殷奎","text":"公昨汉中初出守，剑门犹拒万夫开。\n郡民惊悸思良吏，天诏丁宁用秀才。\n形势百城归控制，流移十载赖招来。\n颍川应有重临日，谈笑南楼尚可陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永寿县期孟明府未还","author":"殷奎","text":"秋至物情变，雨来山气凉。\n孤怀客夜水，薄宦归程长。\n平泉倦登陟，葆峰谩徜徉。\n故人期未至，岸帻上高冈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋社","author":"殷奎","text":"秋社荒山里，迎龙野庙开。\n豚蹄田父祝，鞍马县官来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东泉","author":"殷奎","text":"四山饶雨气，一涧落泉声。\n此处销残暑，还同茂宰行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"县斋对雨","author":"殷奎","text":"八月风气寒，荷衣不堪补。\n南还未成行，山馆眠秋雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟明府古主簿同游石牛亭","author":"殷奎","text":"负郭青山似我閒，相邀随意一跻攀。\n路穿叠嶂盘高下，身逐浮云任往还。\n谁约武昌游退谷，自疑柳子赋囚山。\n故林秋色归来晚，满拟婆娑数树间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"联句","author":"殷奎","text":"雨晴苔径滑如饴，乌帽檐斜屐齿危。\n一鸟不鸣秋树暗，数峰如立晚云奇。\n道傍野老邀相饮，坐上乡人别有期。\n泉石也须还我辈，丁宁猿鹤莫深疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中述怀","author":"殷奎","text":"久留永寿欲别去，如此满天风雨何。\n衣裳山外八月冷，泥水道上三尺多。\n异乡交谊足缱绻，故园归计成蹉跎。\n明朝晴阴未敢必，有酒且任朱颜酡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别后重寄永寿诸公","author":"殷奎","text":"平泉山色翠可食，留滞不知归计疏。\n一月客游风雨半，百年交契子孙初。\n南郭壶浆秋饮饯，长亭鞍马野踌躇。\n如此好怀何可别，归来注目重凭虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登乾陵作","author":"殷奎","text":"观阙倾颓石兽残，凉风侧帽话长安。\n函香不觉天能雨，移檄空怜土未乾。\n月过三原秋淡淡，云来九嵏夜漫漫。\n谁能唤起裴宫监，为说当初创业难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望昭陵","author":"殷奎","text":"仰止昭陵莽苍中，孤峰奇峭插秋空。\n因山政恐劳民力，琢石何须象战功。\n终见兰亭归御府，重闻华衮奠玄宫。\n独怜陪葬诸臣在，不使春秋祭祀同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊山家","author":"殷奎","text":"出郭已廿里，别酒犹未醒。\n野人竞遮邀，路转岩扉静。\n林沾疏雨凉，山带秋烟暝。\n借榻未成眠，予心方耿耿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵题郝士景诗后","author":"殷奎","text":"伏枥长鸣意气生，朱衣华发下瑶京。\n位从列宿图中见，名向翘才馆里成。\n古锦囊来空复美，碧纱笼去未为荣。\n大夫自有登高赋，无限丹心此际倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别南山","author":"殷奎","text":"朝夕终南望眼亲，三年欲往竟因循。\n一杯遥与山灵别，重结平生未了因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临潼张明甫置酒出所藏前贤墨迹为玩","author":"殷奎","text":"仆夫弛担临潼县，寒日晖晖卓午时。\n旌儒坑边来吊古，灵泉观里去题诗。\n荐绅谈笑时髦集，飞舄从游夜漏迟。\n珍重前贤遗墨在，为君开卷动遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸿门","author":"殷奎","text":"数家烟火新丰市，一望蒿莱戏水河。\n汉祖空怜功业在，而今与仲不争多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华州道中口占寄示陈丞","author":"殷奎","text":"少华山前乱石堤，大敷桥下白沙溪。\n霜晨顾眄欹貂帽，晴日行吟信马蹄。\n荠麦青青怜旧采，桑榆历历拟幽栖。\n举头刺眼三峰秀，县令应须一借梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗敷桥下见双白鹭","author":"殷奎","text":"飞来双白鹭，双鸣复双止。\n凝思寥廓天，弄影清泠水。\n予心慕贞洁，尘网谁相拟。\n为尔立斯须，况在罗敷里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登灏灵门重望华山","author":"殷奎","text":"灏灵门上立逡巡，华岳今朝看得真。\n巨斧削成天一柱，高标亏蔽地双轮。\n仙翁举掌能招我，玉女洗头将事人。\n何时尘缘竟了得，中峰高处去栖身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潼关送邹指挥还长安","author":"殷奎","text":"三载潼关烦出将，指挥戎阵静无哗。\n秋防帐里陈壶矢，夜逻山前拥鼓笳。\n汉阁论功名已重，秦川在望路非赊。\n五桥应有山林在，准拟题诗候小车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻叔御谪濠梁","author":"殷奎","text":"项叔为郎白首年，买牛谪去种濠田。\n书辞皎皎春成梦，灯影幢幢夜不眠。\n里巷无多交左在，班行历数几人全。\n何时破屋秋风里，依旧哦诗棹酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵洵阳金主簿子厚见怀二首 其一","author":"殷奎","text":"周南数载为谁留，风入貂裘动客愁。\n薯蓣天寒同谷晚，夫容霜老曲江秋。\n三吴梦想添新恨，万里归来觅旧游。\n亦有洵阳高士在，共将幽兴赋刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵洵阳金主簿子厚见怀二首 其二","author":"殷奎","text":"悠悠末俗竞趋尘，落落清才自绝人。\n漫与弟兄为禄隐，不将簿尉绊吟身。\n帽檐山郭冲风侧，艇子关河载雪新。\n惭愧同门相见晚，一番倾盖便相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潼关留别梦得孟云子厚希曾诸君子","author":"殷奎","text":"客里衣冠喜合并，留连三日荷深情。\n华阴县里追游好，江月亭前发兴清。\n碑记延熹充嗜古，杖分灵寿得扶倾。\n匆匆又上关东道，萍聚蓬飘叹此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬陈赞府孟云求灵寿杖","author":"殷奎","text":"长安倦客始南还，足茧那堪道路艰。\n暂借先生灵寿杖，明朝扶我过潼关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟云赠杖以诗酬之","author":"殷奎","text":"一枝灵寿落吾手，布褐纶巾便不孤。\n林下敢同蒙上赐，花前绝胜倩人扶。\n朱藤未见来南诏，斑竹徒闻赠洛都。\n支离病骨君能念，消得儿童唤老夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巩县谒宋诸陵","author":"殷奎","text":"奉先桥下水汤汤，俛仰千年一感伤。\n陵树无根流夕露，宫花有泪洒秋霜。\n青山巩固神犹惨，白塔钱塘恨更长。\n圣代方隆中夏统，故应塞北荐馨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过崤陵","author":"殷奎","text":"虢洛行三日，嵚岩历二陵。\n骑危甘下步，虎近怯高登。\n仆木崩崖底，摧轮乱石层。\n所悲秦晋事，踪迹尚堪徵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汜水关上偶题","author":"殷奎","text":"岩邑区区吝叔封，谁知相爱是相攻。\n京虽不度非难克，祭吕何曾识此公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸿沟","author":"殷奎","text":"广武荥阳战未休，故将局面变鸿沟。\n凭谁说与重瞳子，未是夭亡肯信不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入新安县境有怀顾明府","author":"殷奎","text":"才入新安趣便真，县中官长是诗人。\n三年云路离情隔，千里月明清梦频。\n栗叶满山秋实美，鲂鱼出水冻腴新。\n高斋昼寂便清供，消受民风一味淳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句","author":"殷奎","text":"风劲虎狼嘷，盘车石栈高。\n潼关䟎运急，不敢更辞劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题新安驿","author":"殷奎","text":"地势奔驰若建瓴，崎岖千里未能平。\n汉关东启遗山址，禹涧西来抱县城。\n探虎墓前闻虎过，学鸡台上听鸡鸣。\n客来自幸清时好，不识喧呼夜点兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洛阳","author":"殷奎","text":"铜驼巷陌草萋萋，金谷园林迹已迷。\n惆怅天津桥上月，更无人听杜鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑州道中","author":"殷奎","text":"甫田万顷少耕犁，茂草东西一色齐。\n寒日荒荒飞野雉，晚烟漠漠走山麑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中牟","author":"殷奎","text":"中牟县里驻归骖，客路情怀尽自谙。\n白草黄沙仍渭北，断陂流水已江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过睢州哭公暨","author":"殷奎","text":"儒效时方少，君才得暂伸。\n大邦多委重，别乘著清纯。\n安集心恒苦，谦虚政自循。\n魂归千里骨，哀动一州民。\n艺圃摧芳桂，词源失壮鳞。\n经过流涕横，不独为姻亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]