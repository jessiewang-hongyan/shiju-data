[{"title":"忆浮丘生","author":"林鸿","text":"瘴海民风异，炎荒客路难。\n午深犹见雾，臈尽不知寒。\n蚌月开晴岛，蛇珠射暗滩。\n居夷虽可学，怀土泪阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀黄玄","author":"林鸿","text":"别去情何限，忧来泪满襟。\n人皆知点玉，孰与辩疑金。\n月照吴门树，霜飞建业砧。\n最怜诗社散，悽绝独长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱大归淮养亲","author":"林鸿","text":"旅棹历淮阳，春亭酒正香。\n贤兄开绛帐，季弟侍萱堂。\n郢树侵吴近，淮流入海长。\n一杯分散后，归雁是同行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆郑二宣时往交州","author":"林鸿","text":"旅棹若乘空，春游近日东。\n遥怜沧海客，共是白头翁。\n雨霁鱼吹浪，天遥鹘借风。\n清泠台下路，樽酒几时同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张任远之颍上","author":"林鸿","text":"北谪非吾土，南归下首丘。\n遥居黄霸治，未遂赤松游。\n古柳垂春蔓，沙河急暮流。\n离分君莫叹，风壤是中州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游烟霞观","author":"林鸿","text":"不作南宫吏，来从物外游。\n閒倾松叶酒，醉度菊花秋。\n谷响疑天籁，霞绡结海楼。\n下方廛市近，俯槛笑蜉蝣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜饮王六博士宅留别","author":"林鸿","text":"王乔能爱士，留客酌胡麻。\n予亦蓬蒿者，怜君意气赊。\n碧阶流月色，绿竹拂霜华。\n明日沧溟去，云帆挂海霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙挥下第归江东","author":"林鸿","text":"灞陵杨柳色，樽酒送行尘。\n得桂都缘命，看花莫怨春。\n云霄期自远，途路别来频。\n疋马东南去，高堂有老亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送白少府送兵陇右","author":"林鸿","text":"冠冕中朝贵，风尘陇路赊。\n三军随虎竹，万里度龙沙。\n古戍冰成垒，春湟雪作华。\n天骄犹未静，行矣莫思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别陈令大有","author":"林鸿","text":"相知嗟久别，相见复离群。\n别路随秋雨，回车入暮云。\n枫林千叶落，河水数支分。\n若见空梁月，含情定忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别周彦","author":"林鸿","text":"心知三十年，此去重潸然。\n挂席趋京阙，看云别海天。\n溪桥寒吐月，驿树晚藏烟。\n仁者多言赆，希君白雪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卞从事之河南","author":"林鸿","text":"翩翩玉面骢，去去逐秋蓬。\n见雁辞闽海，看山到洛中。\n营门閒步月，宾馆静吟风。\n共说归来日，篱花已满丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄令之永宁","author":"林鸿","text":"作牧成周地，分携建业舟。\n孤灯闻雁夕，落叶度江秋。\n云路看高翥，京尘感旧游。\n离情如洛水，日夜向东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑秀才旭","author":"林鸿","text":"宁亲初戏綵，祖道又分襟。\n渐远趋庭训，偏惊去国心。\n关云遮越断，海雨入吴深。\n璧水多麟凤，期君竞寸阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游灵隐寺","author":"林鸿","text":"灵隐知名刹，龙宫最上方。\n越山当户翠，海树到楼香。\n说法观身妄，悬灯共夜长。\n浮生一何幸，乘此礼医王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿灵异上人房","author":"林鸿","text":"青莲开梵宇，白社结诗坛。\n洞古留云宿，楼虚挂月看。\n洗杯泉影落，扫石竹光寒。\n莫怪栖迟久，朋簪念二难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游方广岩","author":"林鸿","text":"玄岩太古色，恍若入鸿濛。\n一径攀跻尽，诸天杳霭中。\n云归山殿冷，月出水帘空。\n境静离言说，泠泠松桂风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荷亭夜坐分得山字","author":"林鸿","text":"池亭清夏暑，吟眺夜忘还。\n秋气月中早，晚心池上閒。\n危襟涵玉雪，幽梦即云山。\n明日清泠顶，岩扉共一攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏斋中竹","author":"林鸿","text":"托根临泮水，终异在林丘。\n色映疏帘雨，声传静院秋。\n裁冠龙箨润，制律凤柯修。\n散帙多閒日，能陪六逸游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同林秀才敏郑生烱游末山寺","author":"林鸿","text":"野寺集秋色，门閒掩古苔。\n偶寻青草径，遥入白云来。\n山叶风自落，砌花寒始开。\n幽期重九日，即此醉陶杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日宴林氏园亭","author":"林鸿","text":"故人邀客处，别墅带林塘。\n身外名堪避，樽前迹暂忘。\n鸟飞潭树暖，花落野泉香。\n乘兴留题去，西崦挂夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为释东旭咏白莲","author":"林鸿","text":"淡月瑶池夜，微风太华阴。\n翠翻擎露盖，玉冷坠波簪。\n一洗有为法，应全不染心。\n谁能招惠远，结社向东林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏雨竹","author":"林鸿","text":"闭门对山雨，隐几咏琅玕。\n滴沥明珠碎，离披翠羽残。\n烟中看叶重，风里觉枝寒。\n湘女当年泪，于今岂未乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日登平远台","author":"林鸿","text":"兰若最高处，客来开夕窗。\n诗怀秋思集，定力壮心降。\n远树青残雨，归潮白晚江。\n暝来期宿此，敛屦对寒缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送武平判簿","author":"林鸿","text":"少府朝天日，云霄一凤毛。\n已随冠冕入，暂辍簿书劳。\n晓驿驰星骑，春帆拂露涛。\n行当逢圣代，几日醉仙桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送武平令入觐","author":"林鸿","text":"作牧留遗爱，分携惜别情。\n双凫将舄去，一鹤与琴清。\n积水浮征棹，苍山绕禁城。\n悬知书上考，行见被恩荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送韦户侯伯俊","author":"林鸿","text":"青山慕侯印，弓剑挂南陲。\n月满氍毹帐，云开翡翠旗。\n林花春载酒，园竹晓弹棋。\n不独龙韬熟，文章尔更奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄菊圃都护","author":"林鸿","text":"相识成何事，相思总是愁。\n文章空潦倒，岁月自淹留。\n剑洗清潭晓，琴抽野菊秋。\n皇舆开九域，白发好封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄建溪周校文","author":"林鸿","text":"白发江湖上，雄文最数君。\n每怜金作赋，更道鹤为群。\n竹圃诸生颂，松门酒客分。\n离忧无处托，鱼雁几时闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟王维登裴秀才迪小台","author":"林鸿","text":"高台一登眺，满目白云深。\n况与林间士，俱閒物外心。\n岚光当几席，秋色上衣襟。\n更待今宵月，与君同啸吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋声","author":"林鸿","text":"淅沥初萧索，寒声处处疑。\n园林风起夜，庭院月明时。\n客思愁宵永，秋商入候悲。\n凄凉孤馆闭，乡念有谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日登石壁精舍","author":"林鸿","text":"携琴向何处，因访梵王宫。\n潭影漾秋白，枫林鸣晚红。\n涧空啼鸟寂，地僻野泉通。\n欲辩来时路，苍茫翠霭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日登湖山","author":"林鸿","text":"白日好幽寂，常登胜槩频。\n寒泉漱清沼，啼鸟乱芳春。\n极目临霄汉，虚心绝垢尘。\n及时当作乐，岁月苦催人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题夕阳孤棹送郑二之交州","author":"林鸿","text":"离亭夕景迟，游子去何之。\n白发孤舟别，沧溟万里期。\n乡心春鸟唤，旅泊夜星随。\n无限分携意，殷勤唱竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送应举议归鄞江","author":"林鸿","text":"明府才能赡，三吴旧缙绅。\n遐方得循吏，圣代喜儒臣。\n鄞水南归海，丹山东入闽。\n因知怀惠日，两地总阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李通守归镡上","author":"林鸿","text":"忆昔招谈日，清吟每自如。\n春风花下酒，秋月竹间书。\n云阙开贤路，镡津迓使车。\n咨询今有便，青眼慰寒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送绝尘上人游江南","author":"林鸿","text":"南国随缘到，应无去住心。\n听钟寻野寺，乞食施山禽。\n晒衲梅风润，浮杯瘴海深。\n远公多古迹，只合老东林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送牛道士","author":"林鸿","text":"先生有道者，曾说遇茅君。\n辟谷唯餐日，无家秖卧云。\n丹光分月色，剑气动星文。\n怅望双凫远，秋风建水濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人之京","author":"林鸿","text":"对酒临津树，伤心莫我违。\n遥悬霄汉望，独折桂枝归。\n远骑看山别，征帆带雨飞。\n送君从此去，何日玩清晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘露应制","author":"林鸿","text":"圣主开休运，神浆降帝州。\n密沾花锦重，轻拂柳金柔。\n月暗迷仙掌，宵分瑩玉楼。\n光含尧殿晓，冷沁汉宫秋。\n赤瓮劳空贮，芳林谩早收。\n无才堪纪述，何以动宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登瀛二首 其一","author":"林鸿","text":"圣世风云会，文衡日月悬。\n五星同聚井，六德共宾贤。\n射隼乘时获，登龙计日先。\n金台钟秀气，瀛海俨神仙。\n月殿森芳桂，琼林列绮筵。\n停骖三岛上，飞佩百花前。\n多士骞腾日，明良泰治年。\n始知逢掖贵，何必蹑凌烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登瀛二首 其二","author":"林鸿","text":"九州连一壤，三岛不殊乡。\n云作长安路，洲通弱水航。\n星河摇宝剑，日月焕文章。\n翠苑天葩丽，珠林蕊叶凉。\n绣楹金蝘蜓，吹榭玉琅珰。\n广乐飞蝴蝶，霓裳下凤凰。\n八珍行月殿，万寿进霞觞。\n景气吞今古，荣光接混茫。\n仰聆天语近，俯视地维荒。\n探手资玄运，扪心见赤藏。\n才非鹦鹉匹，群逐鹭鸳行。\n讵复论汾上，长专蜕骨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈明府出守南阳","author":"林鸿","text":"帝世符文治，侯邦重选臣。\n八龙开户牖，五凤出丝纶。\n地接全吴尽，风仍故楚淳。\n山容迎露冕，日色动朱轮。\n恋阙风云迥，随车雨露均。\n圣情钟草泽，一为问沈沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑孝廉之京","author":"林鸿","text":"天书下紫宫，星象动璿穹。\n丹穴锵鸣凤，青冥起渐鸿。\n弹冠千里别，倾盖一樽同。\n风雨情何极，云沙路不穷。\n津桥迎彩鹢，驿树引嘶骢。\n曙月关河迥，晴芜楚泽空。\n交情怀契阔，直道任穷通。\n知遇期皇鉴，君毋叹转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕观灯之作","author":"林鸿","text":"授历逢春正，张灯是此宵。\n雄藩誇乐事，大运属昌朝。\n锡酺千家醉，含哺万姓饶。\n兔轮开月驭，鳌极驾星桥。\n律转条风至，阳暄朔雪消。\n宛驹来騕袅，洛浦出妖娆。\n队合红尘暗，香焚紫雾飘。\n金莲燃蜡炬，玉树度云谣。\n醉态欺寒浅，欢情爱夜遥。\n愿言歌击壤，万寿祝唐尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋凌霄台玩月","author":"林鸿","text":"福地邻三岛，朋簪盍二难。\n逢秋能作赋，见月即同看。\n地迥青天近，波澄碧海宽。\n流辉初熠熠，载魄正团团。\n桂影浮山殿，珠光射石栏。\n风来金气肃，河泻玉津寒。\n捣药深凭兔，吹箫或驾鸾。\n沾衣垂露叶，散步倚云峦。\n醉饮徒倾倒，神游极汗漫。\n自然超世累，何必上天坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登翠帘山","author":"林鸿","text":"翠岭出天中，岧峣到半空。\n岁时陶令节，登眺楚人风。\n叶尽闻虚籁，天清见断鸿。\n别家沧海上，恋阙五云东。\n暂就囊萸饮，谁论戏马雄。\n醉乡可栖息，浑不记飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三教堂兰若","author":"林鸿","text":"胜地传三教，空山少四邻。\n溪流旧回合，峰势此嶙峋。\n松桂风吟夜，莓苔雨度春。\n经残萝径月，灯掩石龛尘。\n兜率疑天界，维摩恐后身。\n布金还长者，携酒属诗人。\n心远云堪卧，门閒鸟自驯。\n早祈莲社就，来此息贪嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同郑逸人宿西山寺","author":"林鸿","text":"翠壁开西麓，金宫隐上方。\n云霞横鸟道，日月焕龙章。\n桂殿丹青古，松门草木苍。\n潭空窥鸟影，夜静识天香。\n梦里观生妄，閒中历劫长。\n千山孤磬雨，一径落梅霜。\n无复悲生事，莫如礼法王。\n谛闻龙象喻，初地入清凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李长史归吴中","author":"林鸿","text":"祖道大江流，离筵起暮愁。\n山川临越徼，词赋动高秋。\n兴入张生鲙，归馀季子裘。\n家林逢雁到，旅棹共星浮。\n已说荒三径，常怀卧一丘。\n朝簪辞白发，野趣入沧洲。\n知己惭疏阔，临岐谩唱酬。\n都将平昔意，乘醉一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得征马嘶送李将军出塞","author":"林鸿","text":"侠客紫骅骝，翩翩欲远游。\n玉禾初秣晓，金勒迥鸣秋。\n思入云沙远，途经雨雪愁。\n将风残木叶，摧月下城楼。\n仆御皆惆怅，宾朋互唱酬。\n看君凭汗血，行矣取封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽胡延平","author":"林鸿","text":"位列诸侯重，身将砥柱摧。\n文章馀谏草，德望罢盐梅。\n赤子天空吁，黄堂昼不开。\n月寒蒿里闭，溪古剑光埋。\n执绋诸生恸，招魂五马回。\n谁镌镡水石，一写岘山哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈主簿稔之延平","author":"林鸿","text":"才子瓯闽彦，云霄紫凤毛。\n一朝辞蠹简，万里试牛刀。\n邑小程书简，民疲抚字劳。\n分簪嗟去国，携手恋同袍。\n白水河源远，苍山积石高。\n政成多暇日，挥翰寄仪曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄贡士登清泠台玩月","author":"林鸿","text":"山川收晚霁，暝色上高台。\n共是吟秋客，还同看月来。\n衣冠林薮逸，词赋柏梁才。\n山鬼惊联句，沙禽避洗杯。\n河低全拂树，露重稍滋苔。\n海上鲛人出，云中桂子开。\n乐游良夜剧，高兴昔人谐。\n归去金溪上，看云首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"来月池","author":"林鸿","text":"远公精舍下，碧沼湛寒泓。\n地底兼天净，波心见月明。\n桂移银汉湿，珠蕴玉壶清。\n坎满流恒止，离虚滉自平。\n禅心通观想，野客助吟情。\n已喜朝簪掷，应来此濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春游林七钦园亭得朝字","author":"林鸿","text":"星驾共招邀，春园发兴遥。\n麦风将变候，梅雨忽崇朝。\n积石开苍岛，重楼瞰赤霄。\n池晴鱼弄沫，地暖药舒苗。\n啼鸟当窗近，飞花逐砌消。\n草深初雊雉，槐细未藏蜩。\n茗椀香云滑，床琴白雪调。\n野泉堪荐醴，天籁讶闻韶。\n被褐深怀玉，裁诗拟报瑶。\n醉乡今已到，何必蹑洪乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同王校文登圣泉宫","author":"林鸿","text":"玉洞烟霞古，珠林辇路遥。\n泉香悬菊瀑，竹响度松飙。\n叠嶂分苍岛，危楼瞰紫霄。\n芳樽携就草，清梵听疑潮。\n吊古尘踪杳，观空世虑消。\n由来希习静，心境自寥寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同韩玄登宿云台","author":"林鸿","text":"野客沧洲至，乘閒上古台。\n江分平野断，树尽远天开。\n散策寻芳草，班荆坐石苔。\n秋阴将日去，雁影带寒来。\n香积雕胡饭，筵芳竹叶杯。\n相逢成暂醉，何必问蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得流泉别林山人","author":"林鸿","text":"青嶂雨初晴，流泉一派清。\n映空涵月色，入夜带秋声。\n落涧银河泻，穿云玉练明。\n引来山径润，触起野潮平。\n静想和琴曲，幽宜濯冠缨。\n滔滔常不已，酷似别君情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹林寺赋得园字","author":"林鸿","text":"医王多宝地，长者给孤园。\n入社逢僧夏，寻山到水源。\n楼开天海色，径扫石苔痕。\n碧筱巢烟鸟，青松袅露猿。\n静言依觉苑，永矣谢华轩。\n此意无人会，惟应达者论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白鹤岭","author":"林鸿","text":"青山踰鹤岭，碧海望鲸川。\n树拂扶桑日，岩栖若木烟。\n土风惊异域，星纪逼残年。\n草白寒威冽，梅开暖律旋。\n雪消泉动脉，风急烧侵田。\n病涉溪频转，乘空栈若悬。\n壮游浑漫尔，夙志岂徒然。\n恋阙红云里，归休白发前。\n长途今若折，直道古如弦。\n放逐应无愠，怀哉柳下贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿云台燕集","author":"林鸿","text":"海雨净炎歊，昏星换斗杓。\n天开青杳霭，帝返赤飘摇。\n历览龙宫迥，跻攀鸟道遥。\n碧筒通露饮，白雪度云谣。\n列岫疑看画，泠风讶奏箫。\n竹深凉气早，苔密露痕饶。\n祇树栖驯鸟，禅枝咽暝蜩。\n园红将下叶，海白欲归潮。\n北阙休通籍，东林喜见招。\n栖迟心石古，衰飒鬓蓬凋。\n失路孤生感，观空万虑消。\n漫游聊取醉，何必蹑洪乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"首春游道山有述","author":"林鸿","text":"易象忻逢泰，王春正建寅。\n梅寒将腊去，椒暖荐时新。\n地敛收藏义，天开发育仁。\n百生逢鼓舞，万类荷陶钧。\n晓沐初弹帻，春衣始振尘。\n登山游宝所，掷地礼金身。\n谷响歌林鸟，川游在藻鳞。\n青舒门柳眼，红破苑桃唇。\n坐啸风生籁，行休草荐裀。\n浊醪嗟中圣，清茗爱怡神。\n缨冕休劳梦，云山愿卜邻。\n慧灯如可续，永矣照迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]