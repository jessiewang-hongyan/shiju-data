[{"title":"睡起","author":"柯潜","text":"小阁低窗睡起时，轻风帘幕燕差池。\n水因冰泮流初滑，花为春寒开较迟。\n冒雨更无人送酒，敲门应有客催诗。\n懒随年少寻芳去，坐对垆熏读楚词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜弟邦纪至京","author":"柯潜","text":"杳杳关河万里途，远来深慰旅怀孤。\n入门笑道亲无恙，搔首翻惊岁欲徂。\n风飏灯花吟对酒，窗寒雪影坐围炉。\n爱渠意气犹如昨，欲从鹓鸾集帝梧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"涵江书院为陈暄太守作","author":"柯潜","text":"韶阳太守赋归与，重理江头宅一区。\n门外不教来俗客，座间只许著鸿儒。\n芸香落蠹书千卷，烟翠侵窗柳数株。\n想见晚凉佔毕暇，行看流水浴飞凫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送苏都事","author":"柯潜","text":"何人能武又能文，幕府元僚思不群。\n万里江湖俱作客，十年京国两逢君。\n花边听雨秋声早，马上闻钟曙色分。\n去去若逢乡旧问，官閒频自策诗勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春夜饯别则源兄还柯山","author":"柯潜","text":"客中喜见故乡人，况是吾宗骨肉亲。\n听雨偶同孤馆夜，看花犹忆八壶春。\n清樽绿酒须沈醉，瓦瓮黄齑莫厌贫。\n明发又看千里别，凄凄草色暗归津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分得玉堂讲学题送张廷玺员外赴南京刑部","author":"柯潜","text":"虎殿东头凤阁前，深沈玉署拥群仙。\n藜光夜照图书府，花气晴熏翰墨筵。\n应制裁成诗百首，赏心又作赋千篇。\n储才君已成梁栋，愧我疏慵度岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送南京户部员外林原朴先生致仕","author":"柯潜","text":"秋风吹鬓渐成丝，便赋柴桑归去辞。\n客里久怀莲社约，俸馀留得草堂赀。\n欲添诗景多栽竹，恐惹机心不对棋。\n未老乞身真自乐，世间能有几人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送进士邓珙荣归","author":"柯潜","text":"得意春风夺锦标，宁亲又喜下层霄。\n片帆归去江湖阔，两袖沾来雨露饶。\n花映驿楼香冉冉，草连汀馆碧迢迢。\n榕城门外人无数，共看鸣驺过画桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王世用还历城","author":"柯潜","text":"齐东有客赋骊驹，归去乡园水竹居。\n细雨落花香入砚，淡烟垂柳绿盈渠。\n有时邀客篘新酿，长日临窗读旧书。\n闻说郡侯能下士，常乘五马到门闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送进士钱景通赴青州堆官","author":"柯潜","text":"曾为龙虎榜中人，新拜除书下紫宸。\n要使门无投刺客，莫教庭有泣冤民。\n郊亭酒尽青山暮，驿路花明碧海春。\n名士未应淹佐郡，孤帆早晚问归津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送叶茂高赴广昌知县","author":"柯潜","text":"泮上分襟忆昔年，都门相见欲华颠。\n细谈旧事连三日，喜拜新恩下九天。\n舄化双凫春水外，琴随一骑夕阳前。\n优才况是山深处，无事长歌白雪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送侍讲陈秉中掌南京院事","author":"柯潜","text":"寻常玉署尽委蛇，何况金陵事更稀。\n閒逐春风看舞鹤，不须晓漏著朝衣。\n翠微亭上题诗去，玄武湖头放棹归。\n最喜家山回首近，频缄音信问庭帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别封编修尹公还乡","author":"柯潜","text":"韦布辞家衣锦还，都门祖道万人看。\n非因献策干明主，只为生儿拜好官。\n霜落蓟丘枫叶老，风高淮浦雁声寒。\n故园耆旧欢迎处，笑道天朝雨露宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送澄一清和尚还天宁寺","author":"柯潜","text":"游遍名山忆故山，藜筇半秃衲衣班。\n天边飞锡凌风度，江上浮杯泛月还。\n薝卜香中翻贝叶，薜萝深处扣柴关。\n他年宦辙过常郡，幸借空门半日閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题太常少卿陈公锡草堂","author":"柯潜","text":"白首归田荷宠荣，风流谁似太常卿。\n烟霞深处开新业，鸥鹭群中觅旧盟。\n溪溜寒声和梦杳，山分晴翠入诗清。\n客来懒问人间事，呼取芳樽对月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵寄题士华兄别墅","author":"柯潜","text":"山下村庄十亩馀，萧萧生计破荒初。\n香蒲细柳和云种，小屋低墙傍水居。\n春暖行穿花径杳，晚凉吟倚竹窗虚。\n陶然一笑新联就，起向芭蕉叶上书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽漳浦陈松庵处士","author":"柯潜","text":"闻说松庵处士贤，岩扉随分老风烟。\n青山对户自千载，白发催人无百年。\n蝴蝶梦中寻傲吏，蕊珠香里觅飞仙。\n吟魂不逐西风散，常在梅梢落月边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽灵济宫邵以正真人","author":"柯潜","text":"虎殿当头儤直回，寻真穿破白云堆。\n只传子晋朝天去，不见苏耽跨鹤来。\n点易窗前空皓月，步虚坛上半苍苔。\n鬼神长护青龙剑，时有光芒映上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽吴时耕","author":"柯潜","text":"可恨人生无百年，儒英凋谢更堪怜。\n花间久撤谈经席，湖上空馀载鹤船。\n琴为无人囊欲蠹，诗因有子稿还传。\n相知最是篱东菊，愁绝西风暮雨天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽黄惟器","author":"柯潜","text":"深筑溪堂赋考槃，轻蓑小艇事纶竿。\n胸无俗气吟诗好，家有清风遗子安。\n巢凤竹枯秋月冷，卧龙人去暮云寒。\n悠悠往事凭谁问，抱得瑶琴不忍弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月二十日奉东宫令旨代咏石榴","author":"柯潜","text":"一夜西风破锦囊，丹砂为颗玉为浆。\n文禽知是天家物，独立枝头不敢尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客中九日","author":"柯潜","text":"小斋无地种黄花，酒熟邻缸不我赊。\n惆怅无情秋已老，夕阳高树噪寒鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺情二首 其一","author":"柯潜","text":"深院无人独掩门，一庭花影弄黄昏。\n锦机织就相思字，半是愁情半泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺情二首 其二","author":"柯潜","text":"耿耿残灯照不眠，宝猊香烬夜如年。\n可怜帘外梧桐雨，绊惹新愁到枕边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画送陈公辅归毗陵","author":"柯潜","text":"故人归去碧山阿，茅屋深深掩薜萝。\n一榻白云眠未起，石阑干外落花多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水亭听雨为刘贡士题","author":"柯潜","text":"踏遍春山酒未醒，晚凉还上水边亭。\n小童莫唤登舟去，溪雨来时正好听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"携琴步月","author":"柯潜","text":"白发山翁住翠微，萝云长与护柴扉。\n抱琴无处寻知己，自向溪头步月归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅茶山雀","author":"柯潜","text":"绛葩玉蕊一般奇，共斗浓芳雪霁时。\n群雀惊寒栖不定，振翰欲上万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题小景","author":"柯潜","text":"一色琼瑶山径深，蹇驴驮醉晓骎骎。\n谁家楼上寒吹笛，落尽梅花何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题竹赠晋江柯秉上舍","author":"柯潜","text":"泉南奇士我同宗，晓日分携凤阙东。\n持赠岁寒苍玉节，相随一路有东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜梦家中盆梅盛开","author":"柯潜","text":"盆石蟠梅旧日栽，一枝髣髴梦中开。\n觉来迷却江南路，独带寒香两袖回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中见梅花","author":"柯潜","text":"溪桥倚棹雪晴时，一树寒梅玉满枝。\n我道梅花开太早，梅花却笑我归迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游囊山寺","author":"柯潜","text":"借榻云深处，风窗夜不扃。\n兴来吟弄月，睡起坐听经。\n鹤舞松阴碎，龙归雨气腥。\n明朝赋归去，山色为谁青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重游芝山","author":"柯潜","text":"眼底皆亲旧，相邀访白云。\n好山看不了，名酒饮都醺。\n晴旭移花影，轻鸥护水纹。\n莫谈尘世事，诗思正缤纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游梁溪","author":"柯潜","text":"何以消烦暑，临流坐石台。\n尘教风扫去，杯付水传来。\n一鸟鸣芳树，群鱼戏碧苔。\n澄怀浩无际，欲去又迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月林清影","author":"柯潜","text":"灏气涵蚤秋，月轮出东岭。\n林下悄无人，行吟弄清影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菊屏秋色","author":"柯潜","text":"薄寒著人秋欲老，粲粲篱花颜色好。\n露香霜艳散围屏，不肯凋零随百草。\n锦袍人是地行仙，林下相依晚节坚。\n好怀都付一樽酒，醉和陶诗三百篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒲弄草堂","author":"柯潜","text":"别搆草堂向蒲弄，蒲弄山高矗天起，倒影平湖三十里。\n渡头平击问奇船，门巷纷纷响珠履。\n一从观化去不来，旧基零落荒苍苔。\n高林日暮鸟相语，废圃春深花自开。\n花开花落几今古，风教何曾委尘土。\n绵绵书泽犹在人，满邑弦歌比邹鲁。\n我来曾过山之陬，夕阳驻马空回头。\n九原之魂不可作，临风一笑云悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮洗马杨维新宅","author":"柯潜","text":"小院深沉迷綵霞，傍人道是神仙家。\n春风吹绿庭前草，夜雨新开屋角花。\n花开如锦不长好，草绿如茵易枯槁。\n与尔同坚松柏姿，岁晏青青永相保。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日游西湖","author":"柯潜","text":"天风两袖下蓬瀛，十里湖光照眼明。\n行尽荷花香满舄，坐依苔石翠沾缨。\n白云飞去不留迹，黄鸟啼来如有情。\n野老亦能知爱客，短筇扶过石桥迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和周次玉除夕","author":"柯潜","text":"鸭炉香烬酒微消，笑引诗魔伴寂寥。\n漏滴寒声催五夜，天回和气入三朝。\n玉堂冷署閒烹雪，水部高才醉颂椒。\n明发趋朝陪御宴，同歌湛露听云韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"休庵为大司马王公题","author":"柯潜","text":"山斗名高玉雪标，病来渐觉宦情消。\n更呼童子囊书去，不赴邻家折简招。\n载酒有时过竹院，看山常日渡溪桥。\n笑他华发龙钟者，犹踏青霜候早朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题方廷献西轩","author":"柯潜","text":"故家孙子庙堂珍，斗室萧然寄此身。\n竹色清含三径晓，鸟声啼送一帘春。\n琴中风月常无恙，画里江山自有神。\n近已攀龙霄汉上，梦魂犹恋水云津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宋儒佥宪考绩还江西","author":"柯潜","text":"西江佥宪好容仪，六月承恩下玉墀。\n绿树轻风分手处，碧梧凉雨到官时。\n看山多上滕王阁，访古频过孺子祠。\n按节更应周列郡，清霜飞处有春熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送士华兄还柯山","author":"柯潜","text":"袅袅东风吹柳枝，宦情乡思两堪悲。\n谁知驻马分襟处，不似连床听雨时。\n祖席共倾官市酒，行囊满载翰林诗。\n无金堪寄为亲寿，只报平安慰远思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王训导赴庐州经历","author":"柯潜","text":"碧山深处有儒珍，闭户看书甘自贫。\n应诏起为天上客，拜官去作幕中宾。\n长空落日孤鸿影，岐路西风一骑尘。\n雪意浓时应到郡，梅花清映玉标人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵寄绿野朱廷聘","author":"柯潜","text":"朝天常听晓钟馀，退直归来晚漏初。\n愧我无才称近侍，怜君有道只閒居。\n山环绿野飞空翠，月满瀛洲照碧虚。\n两地相思不相见，几回翻烂寄来书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋林停车","author":"柯潜","text":"短辕载酒觅奇踪，最爱秋林紫翠重。\n昨夜清霜红入叶，又添山色几分浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题小景","author":"柯潜","text":"万雉危城压大江，疏钟几杵隔云撞。\n扁舟无数归来晚，满载滩声过钓矼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题卢侍御崇绩山水图","author":"柯潜","text":"遥山不可极，佳气日氤氲。\n老屋涵青雨，晴窗度白云。\n树临沙嘴尽，泉到石棱分。\n皓首清閒者，长吟送夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四时叹学歌 其一 春","author":"柯潜","text":"春日晴，桃花艳冶照人明。\n和风催笔思，巧鸟助文情。\n书吾为汝受尽艰辛，吾为汝费尽精神。\n何时足吾意，却使我、壮大家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四时叹学歌 其二 夏","author":"柯潜","text":"夏日长，荷盘叠翠结清香。\n薰风来卧榻，好雨洗炎凉。\n书吾为汝历尽棘场，吾为汝用尽思量。\n何时得吾志，却使我、远大文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四时叹学歌 其三 秋","author":"柯潜","text":"秋日中，桂蕊妖娇吐月宫。\n嫦娥扫云路，才子逞英雄。\n书吾为汝坐尽短檠，吾为汝闻尽漏钟。\n何时得吾愿，却使我、附凤攀龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四时叹学歌 其四 冬","author":"柯潜","text":"冬日寒，柯山不改旧时颜。\n雪拥山头白，烟笼海上滩。\n书吾为汝挑尽灯残，吾为汝减尽三餐。\n何时了吾债，却使我、心事偷閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读宋陈忠肃公传有感","author":"柯潜","text":"边尘捲风天地黑，铁骑长驱满南北。\n厓山孤主知在无，一夜愁心遍头白。\n丈夫耻作负恩生，举手擎天天已倾。\n孤城如斗犹百战，苍苍不遣功勋成。\n龙虎可骑不可扰，怒气吹人山亦倒。\n君臣大义心自明，白日青天悬皎皎。\n岭海间关草树寒，四顾无人双泪弹。\n国破家亡惟一死，首阳有薇那忍餐。\n节义文章理不烂，万丈红光烛霄汉。\n我怀往事悲复歌，凛凛英风鬓丝乱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对雪作","author":"柯潜","text":"去年腊月江南村，梅花如雪飞纷纷。\n今年饱看京城雪，色比梅花更清绝。\n繁弦急管是谁家，流苏帐暖倾流霞。\n何如金马门中客，瓦鼎敲冰閒煮茶。\n玉楼棱层银海动，自笑书生能忍冻。\n漏声催就碧窗眠，一夜寒光照清梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送检讨庄孔阳桂阳判官","author":"柯潜","text":"钟声催晓骑，寒色上重裘。\n笑别鹓鸿侣，遥临山水州。\n直言非不用，高志自难酬。\n公暇閒吟处，风清月满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游灵云寺","author":"柯潜","text":"朝回天尚早，骑马到岩扉。\n涧水流花去，山云载鹤归。\n和羹芹菜嫩，荐酒蕨芽肥。\n适意坐来久，空岚吹满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辟支岩","author":"柯潜","text":"攀云凌绝顶，一望海天空。\n野色断桥外，鸟声高树中。\n烟凝芳草碧，苔衬落花红。\n万虑都消却，长歌送暮鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送行人司正邵震使安南","author":"柯潜","text":"天王出震继虞唐，宇宙重新化日长。\n要使车书归一统，远颁正朔到殊方。\n碧天尽处通容管，瘴雨晴时过富良。\n珍重平生清苦节，莫将薏苡载归囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题和义山 其一","author":"柯潜","text":"翠袖湘裾立晓风，绛纱窗外画阑东。\n伤心玉笛声初断，回首瑶台信未通。\n满地淡烟芳草碧，一帘残雨落花红。\n年来但守芳心在，两鬓从教似短蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题和义山 其二","author":"柯潜","text":"人在蓬莱欲见难，重门花落又春残。\n惊回远梦莺犹语，题就长缄砚已乾。\n云母屏前香缕细，水晶帘外雨声寒。\n箧中旧制双纨扇，愁拂尘埃强自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三月晦日作","author":"柯潜","text":"斗室翛翛半掩扉，一春多病赏心违。\n东风不忍轻相别，吹送杨花满院飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"棠梨白头","author":"柯潜","text":"开到棠梨春事休，红情绿意总堪愁。\n双禽无计留春住，恨倚东风雪满头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望云思亲卷为史侍御赋","author":"童轩","text":"白云悠悠，在天之陬。\n陟彼岵兮，我心则忧。\n白云靡靡，在天之隅。\n陟彼屺兮，我心则思。\n我思伊何，父母孔耆。\n匪无莱衣，莫克娱之。\n匪无寸禄，远莫持之。\n王事靡盬，不遑宁处。\n瞻望白云，亲舍其下。\n亲舍其下，室远心迩。\n愿言思之，泣涕如雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"味道斋为秀才程愈赋","author":"童轩","text":"道之旨，大羹玄醴。\n君子味之，浑然斯理。\n道之腴，熊掌及鱼。\n君子味之，渊乎其微。\n于皇天命，一诚不已。\n文王大圣，不显于己。\n圣也希天，贤其希圣。\n动静或愆，为道之病。\n君子味之，是谓自持。\n朝斯夕斯，道岂远而。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":43545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]