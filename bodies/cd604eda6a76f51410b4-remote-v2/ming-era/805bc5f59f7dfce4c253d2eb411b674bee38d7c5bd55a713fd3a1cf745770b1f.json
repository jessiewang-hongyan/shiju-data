[{"title":"杂咏 其一","author":"伍瑞隆","text":"雨晴芳草满汀洲，新月如眉照画楼。\n照见佳人独眠处，水精帘卷一枝秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其二","author":"伍瑞隆","text":"莲花一朵佛中央，念遍弥陀在上方。\n昨日楼前偷看汝，不如今日礼空王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其三","author":"伍瑞隆","text":"石榴初发一枝红，楼角摇香落晚风。\n女伴临池看新月，却传春在半天中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其四","author":"伍瑞隆","text":"何处莺啼隔落花，声声吹送玉人家。\n君身可有双飞翼，不到红楼却自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其五","author":"伍瑞隆","text":"日色微红别翠裙，月光才上又逢君。\n谁知交甫怀中佩，只是襄王梦里云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其六","author":"伍瑞隆","text":"懊恼巫山十二峰，高唐欲赋未从容。\n当时绿酒银灯夜，恨听高楼明月钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其七","author":"伍瑞隆","text":"莫愁湖上柳初齐，教妓楼前草欲迷。\n九曲明珠穿不得，有君针线作灵犀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其八","author":"伍瑞隆","text":"接木移花本有师，花开木长更知谁。\n春风却自无情种，就是春风亦不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其九","author":"伍瑞隆","text":"镜里仙娥天上妆，吹箫不肯骂鸾皇。\n自身本是莲花骨，开合金池四色光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其十","author":"伍瑞隆","text":"天上星辰海上山，梅花一点雪中间。\n却教明月知踪迹，勾引王乔独往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其十一","author":"伍瑞隆","text":"流水多情去复来，绕篱穿槛到琴台。\n先生昨夜垂竿去，万朵莲花掌上开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观杨仪部画兰因寄钱□□ 其一","author":"伍瑞隆","text":"金台十五六年前，曾上宣和御墨筵。\n今日相逢品兰谱，羡君湘水谪神仙。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观杨仪部画兰因寄钱□□ 其二","author":"伍瑞隆","text":"兰法千年郑所南，文章风节照湘潭。\n只今弟子侯芭在，且向毫端试一参。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观杨仪部画兰因寄钱□□ 其三","author":"伍瑞隆","text":"所南兰法逐时新，苦是江山让与人。\n怪石瑶芝总休论，才存芳洁是花身。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观杨仪部画兰因寄钱□□ 其四","author":"伍瑞隆","text":"杨子风流继昔贤，兰心开处笔能传。\n遂令一派孤清气，飞作人间五色烟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观杨仪部画兰因寄钱□□ 其五","author":"伍瑞隆","text":"斯道难言自古来，野孤禅并斗筲才。\n从今兰谱开三日，赖汝登坛扫劫灰。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观杨仪部画兰因寄钱□□ 其六","author":"伍瑞隆","text":"钱郎去后国香残，万里同心半字难。\n惆怅对君湘浦客，聊将兰谱问平安。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事閒题 其一","author":"伍瑞隆","text":"黄粱一阵晓来风，龙眼吹残橄榄空。\n閒步长洲访春色，西河无数落花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事閒题 其二","author":"伍瑞隆","text":"荷塘簇簇白藤花，冈尾冈头十万家。\n见说横江人不渡，峭帆风紧桂洲斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事閒题 其三","author":"伍瑞隆","text":"西头南尾尽烟波，绿玉城中幽恨多。\n林步酒家休得醉，寨前芳草奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事閒题 其四","author":"伍瑞隆","text":"沙塘秋好发红莲，倚剑峰头尽日眠。\n下巷骑牛归上巷，水边沽酒过山边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事閒题 其五","author":"伍瑞隆","text":"秋风高陇不堪愁，双美桥西广渡头。\n凤岭驼山都莫问，更谁开社到瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事閒题 其六","author":"伍瑞隆","text":"石桥坑下水流澌，烈女祠前花万枝。\n借问凤凰山下月，至今犹照白莲池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事閒题 其七","author":"伍瑞隆","text":"何人移棹过江门，白石黄连尚有村。\n閒步海洲怀古处，道娘无墓可招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"述先十章","author":"区怀年","text":"隆隆嘉运，硕彦是膺。\n德沭温粹，言贲休明。\n挠之不屈，溷之逾清。\n懿型姱节，邦国之桢。\n伊予肇宗，鬼臾斯衍。\n匡翼有熊，令闻不殄。\n厥祚悠长，逮于中宪。\n受牧东瓯，崇勋懋展。\n肃后方升，岛夷搆难。\n屠民戕吏，井邑既殚。\n宾资良牧，振旅桓桓。\n挫彼狂狡，越以乂安。\n鸟尽弓藏，昔贤所慑。\n乐毅强燕，代于骑劫。\n衮钺不侔，奸回肆谍。\n遥遥副车，亶堕骏业。\n天锡纯嘏，赫濯以昌。\n笃生哲考，维珩维璜。\n丕承先烈，微直肯堂。\n跻于清庙，黼黻用光。\n粤在定陵，份份文质。\n孰佐论思，既轨既物。\n豹尾宣麻，螭头载笔。\n夙夜惟寅，昭其罔佚。\n珠辉玉灿，穆穆其容。\n爰承简命，作友储宫。\n陈诗绎典，纳诸谦冲。\n乃赞三礼，百辟景从。\n直道寡援，孤行速谤。\n谗人訾訾，清时弗谅。\n休养天閒，宸衷特贶。\n夷然引退，戒此羸壮。\n达生无我，高谊薄云。\n冥情显晦，泉石娱真。\n玄风独迈，逸藻缤纷。\n芟厥蘩秽，功在斯文。\n嗟我小子，匿瑕丛类。\n负荷不堪，濒于废坠。\n遑遑昕夕，尔勖尔励。\n缅维慎修，敢云保世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿山仙迹","author":"李士淳","text":"鞭石成羊迹已仙，奔牛印石事其然。\n丹房寂历人千载，塔影孤清月一圆。\n云里笙簧天上曲，风前缭绕座中烟。\n曾从慧远成三笑，二十年来岸谷迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朋山龙潭","author":"李士淳","text":"沧海盈虚几度更，青山姓字有朋名。\n云来远岫千岩秀，日出层崖万壑晴。\n积水成潭时作雨，依松辟谷静闻声。\n何年得遇羽衣者，夜半峰头吹玉笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"程处士祠","author":"李士淳","text":"我生处士里，酌水知源长。\n往事成千古，高名噪一方。\n祠堂新卜筑，俎豆旧馨香。\n无限相思意，东湖水正泱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"棋磐石","author":"李士淳","text":"数着分明一局残，仙人曾此暂消閒。\n山僧不解盘中意，横卧苔矶听涧泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小歇石","author":"李士淳","text":"铁桥过去便桃源，石上桃花不记年。\n寄语中原车马客，风尘暂此一停鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大歇石","author":"李士淳","text":"古木阴中说涅槃，点头尔亦解参禅。\n仙僧趺坐无尘想，何用枕流洗碧泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜山中感兴 其一","author":"李士淳","text":"坐稳蒲团一事无，上方月色出扶疏。\n老僧偏有南楼兴，笑指峰头玩玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜山中感兴 其二","author":"李士淳","text":"山寺钟声送夕阳，引来月色到东廊。\n三更梦断觅残蝶，花影重重上短墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别墅访僧","author":"李士淳","text":"竹院逢僧坐石床，风幡论罢日初长。\n泉声不似人间语，疑是楞严第一章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈司徒季父五章","author":"区怀年","text":"廓哉二仪，至道克塞。\n孰是仔肩，元夫有则。\n被仁弘义，渊毅方直。\n四国景行，其仪不忒。\n精一之旨，往哲肇宣。\n汇流洙泗，实浚其源。\n繄余季父，独刊陈筌。\n居然堂奥，德业攸尊。\n植德既丰，秉节维纯。\n绝彼奸回，济此国屯。\n乃丁阳九，越在隐沦。\n志存身晦，卓尔天民。\n丘园适贲，性学阐敷。\n朋来豫乐，斯人为徒。\n周旋謦咳，允著嘉谟。\n冥于化运，曷问荣枯。\n滔滔末世，情欲是縻。\n垫乎昏瞀，惟父振之。\n履道坦坦，慎言偲偲。\n抉微修慝，玄襟匪夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日冒雨至圣寿寺僧款予斋饭因赋","author":"李士淳","text":"千山云树昼茫茫，为爱幽期觅上方。\n钟隐峰头知塔远，水潺涧底识源长。\n行来雨色连襟湿，坐久炉烟入袖香。\n报道禅房斋饭熟，閒将食棹论沧桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴那灵雨","author":"李士淳","text":"五指峰前白鹤旋，空中锡卓祖居先。\n桥横曲涧三株树，路入曹溪一洞天。\n听法缘深禽解语，住山岁久俗如禅。\n甘霖愧负苍生望，灵雨分膏且插田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓矶石","author":"李士淳","text":"青苔点石班鳞鳞，閒把钓竿坐水滨。\n莫遣飞熊入帝梦，磻溪深处好安身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕阴雨偶成次陈园公枢部韵","author":"李士淳","text":"举酒招明月，清辉若渺茫。\n烛烧残夜泪，风送隔墙香。\n长袖偏工舞，高谈最易狂。\n荒田堪种秫，谁复问津梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丰草六章","author":"区怀年","text":"萋萋丰草，漠漠长林。\n裴回昕夕，实慰我心。\n往哲是模，岂繄自今。\n顾瞻飞鸟，爰写鸣琴。\n丰草萋萋，长林漠漠。\n裴回昕夕，我心既穫。\n火耨刀耕，资用匪薄。\n时乎不遇，考槃斯托。\n炎疢既消，景物斯和。\n招从邻曲，幽事实多。\n晤言诜诜，遂及笑歌。\n今我不乐，来日如何。\n得失之际，宣尼有言。\n苟能衡命，不讳执鞭。\n庸知所好，淡薄自耑。\n优哉悠哉，聊以永年。\n孰是保躯，而非明哲。\n漱彼清泠，荫此嘉樾。\n心遥晷驶，言念綦切。\n巧者劳劳，我任其拙。\n舍生徇物，岂情所宜。\n一丘一壑，自谓过之。\n饥则待炊，閒当命卮。\n寤寐无忝，庶其免而。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其一","author":"李士淳","text":"临流高阁塔崔嵬，秋色澄清嘉宴开。\n时序催人惊叶落，江风度曲送觞来。\n新亭入目思千缕，往事萦心肠九回。\n留得东山片石在，川陵姓字应同胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其二","author":"李士淳","text":"塔倚层崖一望嵬，登临竟日笑颜开。\n舟浮碧水孤帆远，筵对青山秋色来。\n爽籁徐鸣鱼出听，夕阳几处鸟飞回。\n曾闻作赋男儿事，好向山灵乞异胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其三","author":"李士淳","text":"振衣千仞莫辞嵬，一日登临万象开。\n山水有灵生我辈，英雄何事借才来。\n高歌一曲行云遏，斗酒百篇天籁回。\n赤壁当年前后赋，苏公应信是仙胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其四","author":"李士淳","text":"山穷绝顶已崔嵬，更向峰头七级开。\n乍见彩云浮塔去，忽闻清磬送音来。\n樽中有酒英辞醉，座上行歌能几回。\n今夕月明须共赏，休贪睡梦负灵胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其五","author":"李士淳","text":"一度登山一崔嵬，清樽共酌好怀开。\n南山秀色喜长在，北阙征书莫再来。\n鸟向枝头呼友至，风从松里送声回。\n寻常悟得庄周梦，蝴蝶亦能化夙胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涉江五章章六句","author":"区怀年","text":"江之广兮，有菱有荷。\n言往从之，爰摭其华。\n轻飔扬翔，安澜欲狂。\n江之广兮，有荷有菱。\n言往从之，爰撷其英。\n轻飔裴回，安澜欲隤。\n白石晃晃，江水潒潒。\n虽曰潒潒，中心如荡。\n惓然兴思，夫谁与我榜。\n白石摺摺，江水渫渫。\n虽曰渫渫，中心如猎。\n惓然兴思，夫谁与我楫。\n白石队队，江水汇汇。\n虽曰汇汇，中心如醉。\n惓然兴思，夫谁与我济。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其六","author":"李士淳","text":"怀人昔自陟崔嵬，好把金罍对客开。\n丹凤休教从北至，孤鸿今已望南来。\n白云黄鹄经千载，明月中秋岁一回。\n丘壑无营堪适意，林泉到处是仙胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其七","author":"李士淳","text":"东山何处最崔嵬，片石峰头眼界开。\n地僻幸无尘客到，罍空喜有酒人来。\n衰年每感逢秋至，快饮何妨戴月回。\n我欲从游赤松后，丹炉几转许成胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其八","author":"李士淳","text":"宝塔成功千载嵬，重游旧地斗山开。\n昔年朋辈半摇落，此日俊英尽后来。\n往事升沈蕉鹿梦，当场歌舞雪风回。\n从心七十宣尼事，杯酒聊将洗俗胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己亥中秋偕社中诸子登元魁塔会被饮文昌阁笙歌备奏群英咸集赋以纪之 其九","author":"李士淳","text":"泰山登后数谁嵬，童冠偕游今再开。\n鱼鸟何尝无道在，川流应是有神来。\n六爻变化呈龙马，七级高卑比赐回。\n欲识尼翁真面目，秋阳江汉总同胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"房中乐","author":"区怀年","text":"帘栊薄暮东风暖，钗凤半攲云鬓偃。\n剩脂残粉泻温汤，卧鸭熏炉香不断。\n螭文雕锁闭青闺，银烛生烟唤酒迟。\n停歌婉拍为君寿，月满疏棂醉不知。\n芙容帐底春光蓦，流苏乍解湘裙约。\n千金莫惜买良宵，妒杀铜壶催晓月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前有一尊酒行","author":"区怀年","text":"游丝婀娜萦春烟，落花啼鴂催少年。\n白驹过隙不肯驻，玉颜临镜愁相煎。\n眼中醁醹清如泉，红妆娥娥娇且妍。\n新声合节和素弦，停腔敛盼为君怜。\n为君怜，奉君寿。\n物态如秋云，前有一尊酒。\n五侯三事曾几何，愿得良时对佳友。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思妾行","author":"区怀年","text":"玉炉残篆凝雕窗，紫燕朝衔落蕊香。\n深院缟衣閒寂寂，蕙风帘捲昼初长。\n昼长君不见，花影云千片。\n苔蜗上空阶，粉蝶嬉团扇。\n团扇轻挥锦瑟尘，征鞍何处盼离人。\n香消琥珀寒孤枕，月暗蘼芜怅远津。\n远津芳草年年绿，思妾红颜那可复。\n海棠花下属清歌，离声莫作潇湘曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昌华废苑行","author":"区怀年","text":"君不见刘家兄弟擅豪雄，穗城佳丽侔雒中。\n离宫远映三珠树，别馆还依八桂丛。\n边衅坐销閒介胄，更辟昌华开苑囿。\n墨翰全收上国英，衣冠尽挹中原秀。\n南面称孤乐事多，椒庭歌舞盛纨罗。\n就中掇得春如海，楚媛吴娃愁几何。\n自谓繁华无与比，江天水戏尤堪侈。\n龙舟夜月泛晴沙，兰桨春风吹白芷。\n千秋疑冢带寒烟，陵树萧条古水边。\n独有芳菲情不耐，教人空艳素馨田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨","author":"区怀年","text":"飞光冲烟露花湿，芳丛委艳低如泣。\n闲房窈鴥閟娇春，蓦地香风愁得入。\n缫丝百箔经时断，縠幔长垂昼不倦。\n镜台钗匣生尘埃，二十四番吹未半。\n蘼芜遮地柳著黄，津头沙暖梦鸳鸯。\n可堪更问关山月，越水秦城双断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北郊行","author":"区怀年","text":"直于弦，空如捣，三城迤北呼鸾道。\n酒旗风里送征鞍，十里寒烟没衰草。\n马鬣荒碑阅岁年，青霜剥落松杉老。\n旧冢累累新冢逼，牛羊閒行眠不得。\n肖形翁仲默为情，山鸟山花怨何极。\n莫诧任嚣土一丘，紫云天远夕阳收。\n朅来井邑多横死，暴骨何曾到冢头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀","author":"区怀年","text":"胜情觉无几，系累恒苦多。\n青阳宛如昨，朱夏忽蹉跎。\n商飙流户庭，繁露沾林柯。\n哀猿啸中野，寒鸟鸣相和。\n感兹日月除，怅彼劳者歌。\n肤颜谢畴昔，不乐将奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮酒","author":"区怀年","text":"解忧惟杜康，斯语良匪激。\n况乃索居际，短歌禦岑寂。\n相对尽一升，颓然堪岸帻。\n但取快心志，何必斗与石。\n至理人莫窥，柴桑卓高识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赴都别伯兄启图","author":"区怀年","text":"严冬戒原野，群动咸休栖。\n胡我事行迈，而乃轻别离。\n别离讵云苦，所虞旷庭闱。\n林萱有馀芳，明发殷中怀。\n分情变寒律，埙篪声凄凄。\n系恋不忍前，涕泗沾人衣。\n出户三太息，仰见浮云驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙","author":"区怀年","text":"神山发石髓，蓝田产灵玉。\n揽策事长游，谁能终碌碌。\n高蹈寻丹书，彷忽穷地轴。\n西循涉濛汜，东戾晞旸谷。\n挥手弄云烟，寰区一何局。\n逸览恒超然，规观祇颦蹙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园社中赠陈集生太史","author":"区怀年","text":"离明胜文物，彪矣为国章。\n夫君中蔚起，束发膺衮裳。\n声华遍寰海，丽藻标堂皇。\n被命事輶轩，翱翔还旧邦。\n敦兹风雅谊，千秋从摴扬。\n延结迨暗泯，载笔依辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]