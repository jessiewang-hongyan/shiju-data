[{"title":"清秋忆从弟嘉言","author":"张煌言","text":"秋声萧瑟到空山，怅望惊鸿去不还！\n离别紫荆生死际，平安黄犬有无间。\n寒蚩织月思千缕，孤鹤巢云影半关。\n多少长林摇落态，独怜愁绪未能删！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中七夕，限韵得「廉」字 其一","author":"张煌言","text":"青山诗思入秋添，愁对双星韵漫拈。\n纨扇自来惊少昊，云軿何处御飞廉？\n七襄枉乞天孙巧，五纬虚传汉使占。\n要识太清尘秽净，莫将河鼓拟香奁！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中七夕，限韵得「廉」字 其二","author":"张煌言","text":"清秋一晕挂凉蟾，渺渺银潢天汉淹。\n乌鹊桥成谁问渡？\n嫦娥宫近倘生嫌。\n冰机争似云情薄，金掌依然露气廉。\n却笑儿童偏解事，排瓜掷果向钩帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又叠前韵","author":"张煌言","text":"斜风斜月正纤纤，买得秋光价亦廉。\n绣幕何人愁远别，采车今夕喜重瞻。\n星前锦似千纯丽，云外香来百和兼。\n明日内家应看巧，蛛丝金盒共谁觇！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀古","author":"张煌言","text":"伊昔东陵侯，浮沈在青门。\n种瓜皆五色，不肯负亡秦。\n故侯何足道，羞与世间群；及为文终客，教以报功勋。\n似得黄老术，知亡亦知存。\n存亡会有时，出处要有期；借问五色瓜，何如三秀芝？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居即景四首 其一","author":"张煌言","text":"结茅在山椒，面面皆丛薄；独坐微凉生，高情欲采绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居即景四首 其二","author":"张煌言","text":"平楚殊苍莽，众峰亦窈窕；清辉来扑人，引我发长啸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居即景四首 其三","author":"张煌言","text":"空青不可极，俯视但云光；众妙含其中，疑为天地房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居即景四首 其四","author":"张煌言","text":"朝光来窥床，树影缀罗帐；推枕一摩挲，天然淡墨障。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中屡空，泊如也。偶读渊明「饥驱」句，犹觉其未介；遂作反乞食诗，仍用陶韵 其一","author":"张煌言","text":"悲风变陵谷，余行将安之？\n浩然怀黄绮，烨烨紫芝辞。\n清声在金石，孤情独往来；彭泽何人斯，东篱恋酒杯？\n微禄已不耽，沾沾「乞食诗。\n」乞固自有意，可以观其才。\n吾则爱吾鼎，白云尚分贻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中屡空，泊如也。偶读渊明「饥驱」句，犹觉其未介；遂作反乞食诗，仍用陶韵 其二","author":"张煌言","text":"西山有饿夫，褰裳欲从之！\n或言举世腴，君癯宁有辞？\n流水淡须眉，天真所繇来。\n况也朝市改，志士寡深杯。\n疗饥托薇藿，宁识招隐诗！\n今古多肉食，谁为天下才？\n珍重墨胎氏，灵龟幸见贻！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中屡空，泊如也。偶读渊明「饥驱」句，犹觉其未介；遂作反乞食诗，仍用陶韵 其三","author":"张煌言","text":"三旬九遇食，我闻古有之。\n不贪以为宝，无受故无辞。\n奈何饕餮者，朵颐鼎鼎来。\n乞哀在暮夜，余羹仅一杯。\n斟酌既饱满，犹吟和陶诗。\n缅维珠树鹤，高清未易才。\n芝田谅足耕，嘉谷聊自贻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古三首 其一","author":"张煌言","text":"萧萧岩畔竹，亭亭涧底松。\n植根非不高，孤峭虑难容。\n骨肉缘枝叶，分飞类转蓬。\n非关恩义薄，根株良不同。\n越鸟栖南技，代马立朔风；藐焉长怆恻，道阻谁适从！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古三首 其二","author":"张煌言","text":"晦明本如毂，日日相推移。\n寒暄亦如环，岁岁迭乘除。\n白云自西来，告我商秋期；林皋色惨淡，蛩声哀似思。\n昔也苦炎威，今含摇落悲；天气始肃杀，草木讵能违！\n百卉欻披靡，宁复艳阳时！\n岂识持晚节，独有凌霜枝；寄言桃李子，慎勿恃芳菲！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古三首 其三","author":"张煌言","text":"百虫恒吟秋，百鸟恒吟夏；人生百岁间，炎凉倏代谢。\n常忧时命乖，荣名不相借；时命亦何尝，经纶贵权藉。\n所志岂显荣，担负容可卸；感此结中肠，揽衣起视夜。\n高天明月辉，烂熳繁星舍；愿言披微襟，幽怀得暂泻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀王愧两少司马、徐暗公、沈复斋中丞","author":"张煌言","text":"昔我曾上嘉禾岛，岛上衣冠多四皓；方瞳绿发映朱颜，紫芝一曲何缥缈！\n年来沧海欲生尘，烽烟乱矗商山道；杖履流落似晨星，天长地阔令人老。\n南望铜陵又一山，风帆千尺鲸波间；不然疑乘黄鹤去，去去麟洲第几湾？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻孤鸟而有作","author":"张煌言","text":"孤鸟、孤鸟声愊忆，风雨中宵我心恻；似闻鸟言生不辰，空山寥落无颜色。\n在昔雄飞向九霄，金眸玉爪行胸臆；巢云曾傍万年枝，击水宁需六月息！\n风云蹉跌几星霜，宛转枋榆困枳棘；东门旗鼓为谁觞？\n北海木石徒尔塞。\n杜宇漫语不如归，鹧鸪疾呼行不得；予心卒瘏予尾焦，却来山阿欲避弋。\n一饮一啄孰将雏，双飞双宿谁比翼？\n寒枝独抱月黄昏，岛树苍茫林影黑。\n横绝四海会有时，敢告羁栖还努力！\n嗟乎此鸟亦非凡，鸾歌凤舞谁能识！\n但将孤鸟伴孤臣，悠悠苍天曷有极！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入定关","author":"张煌言","text":"何事孤臣竟息机，鲁戈不复挽斜晖！\n到来晚节惭松柏，此去清风笑蕨薇。\n双鬓难容五岳住，一帆仍自十洲归。\n叠山迟死、文山早，青史他年任是非！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"羁恨二首 其一","author":"张煌言","text":"莫道轻生易，应怜速死难！\n联床皆候卒，倾座只奚官。\n鱼睨严宵柝，拘挛异燕衎。\n欧刀安得借，虎穴正漫漫！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"羁恨二首 其二","author":"张煌言","text":"孤竹羞周粟，余怀胡不然。\n暂将吞炭恨，并作茹荼怜！\n一匕分毡雪，三杯酌乳泉。\n终当从辟谷，岂羡赤松仙！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"被执归故里","author":"张煌言","text":"苏卿仗汉节，十九岁华迁；管宁客辽东，亦阅十九年。\n还朝千古事，归国一身全。\n予独生不辰，家国两荒烟；飘零近廿载，仰止愧前贤！\n岂意避秦人，翻作楚囚怜！\n蒙头来故里，城郭尚依然；彷佛丁令威，魂归华表巅。\n有腼此面目，难为父老言；智者哀我辱，愚者笑我顽。\n或有贤达士，谓此胜锦旋。\n人生七尺躯，百岁宁复延！\n所贵一寸丹，可与金石坚。\n求仁而得仁，抑又何怨焉！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将入武陵二首 其一","author":"张煌言","text":"义帜纵横二十年，岂知闰位在于阗！\n桐江空系严光钓，震泽难回范蠡船。\n生比鸿毛犹负国，死留碧血欲支天！\n忠贞自是孤臣事，敢望千秋青史传！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将入武陵二首 其二","author":"张煌言","text":"国亡家破欲何之，西子湖头有我师：日月双悬于氏墓，乾坤半壁岳家祠。\n惭将赤手分三席，敢为丹心借一枝！\n他日素车东浙路，怒涛岂必属鸱夷！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿官亭","author":"张煌言","text":"漫道诗书债未偿，满身枷锁梦魂香；可怜今夜官亭月，无数清光委路傍！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"放歌","author":"张煌言","text":"吁嗟乎！\n沧海扬尘兮日月盲，神州陆沈兮陵谷崩！\n藐孤军之屹立兮，呼癸呼庚；予悯此孑遗兮，遂息机而寝兵。\n方壶圆峤兮，聊税驾以埋名；岂神龙鱼服兮，罹彼豫且之罾！\n予生则中华兮，死则大明；寸丹为重兮，七尺为轻。\n维彼文山兮，亦羁绁于燕京；黄冠故乡兮，非予心之所欣。\n欲慷慨以自裁兮，既束缚而严更；学谢公以绝粒兮，奈群诼之相并！\n等鸿毛于一掷兮，何难谈笑而委形！\n忆唐臣之嚼齿兮，视鼎镬其犹冰！\n念先人之浅土兮，忠孝无成；翳嗣子于牢笼兮，痛宗祀之云倾！\n已矣乎！\n荀琼、谢玉亦有时而凋零，予之浩气兮化为风霆，余之精魂兮化为日星。\n尚足留纲常于万祀兮，垂节义于千龄，夫何分孰为国祚兮孰为家声！\n歌以言志兮，肯浮慕乎箕子之贞；若以拟夫「正气」兮，或无愧乎先生！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆西湖","author":"张煌言","text":"梦里相逢西子湖，谁知梦醒却模糊；高坟武穆连忠肃，添得新坟一座无？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墙角红梅，九月发花一朵，偶成四绝；时羁狱舍，用「盐」字 其一","author":"张煌言","text":"秋严霜气薄于盐，谁道官梅早放尖；一点寿阳丹的笑，不须□额卧春檐。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墙角红梅，九月发花一朵，偶成四绝；时羁狱舍，用「盐」字 其二","author":"张煌言","text":"奇葩香韵自廉纤，不压冰霜瘦转添；只恐枝头滋味贵，他年调得许多盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墙角红梅，九月发花一朵，偶成四绝；时羁狱舍，用「盐」字 其三","author":"张煌言","text":"何用高吟昔昔盐，也应索笑到巡檐；独惊梅菊争先吐，东阁东篱韵两拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墙角红梅，九月发花一朵，偶成四绝；时羁狱舍，用「盐」字 其四","author":"张煌言","text":"寒枝堆尽水精盐，欲捲孤山雪一帘；何事西风能点缀，先吹霞片到花尖！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武林狱中作三首 其一","author":"张煌言","text":"洒血今何地，红殷罟汉冠。\n云台图画杳，雪窖梦魂宽。\n岂望黄羊乳，无劳白鹿餐。\n广陵有绝操，琴碎不堪弹！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武林狱中作三首 其二","author":"张煌言","text":"曾闻古侠士，相送白衣冠。\n生死关原重，兴亡案肯宽！\n空思供橐膳，谁识报壶餐！\n羞杀无鱼铗，从今莫浪弹！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武林狱中作三首 其三","author":"张煌言","text":"文山不柴市，故里一黄冠；此意谁非屈，何人可自宽？\n羽微谁石饮，舌在任刀餐。\n今古纲常事，因吾好细弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武林狱中作又一首","author":"张煌言","text":"乾坤竟如此，刺眼尽猴冠。\n射昴天方醉，骑箕地较宽。\n难中惭馆谷，梦里忆堂餐。\n一笑甘兵解，何曾有泪弹！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲辰九月感怀 其一","author":"张煌言","text":"口碑载道是还非，谁识蹉跎心事违！\n既熟熊蹯宁复待，纵生马角竟安归。\n纶巾原当苏卿节，葛帔犹然晋代衣。\n得与墨胎相把臂，九原应不恨知希！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲辰九月感怀 其二","author":"张煌言","text":"羁縻斗室尚何为，慷慨从容我亦疑。\n岂是殷顽能革面，虽然汉阨肯低眉！\n鞲鹰踯躅堪谁语，铩凤踌躇只自知。\n莫道故人多玉碎，盖棺论定未嫌迟！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲辰九月感怀 其三","author":"张煌言","text":"棘林宛转尽针毡，便拟寒灰岂易然！\n空有沈湘魂黯黯，幸无入洛影翩翩。\n鸾刀欲下何须挽，雁帛当前不用传。\n惆怅寸阴真是岁，小楼争禁坐三年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲辰九月感怀 其四","author":"张煌言","text":"一曲铜鞮自绕梁，主宾相对不寻常。\n莫言箫管空悲墨，岂信圄囹是福堂！\n唱罢秦青谁避席，悲深凝碧且停觞。\n请君休讶河清啸，司马于今正断肠（","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝命诗","author":"张煌言","text":"我年适五九，复逢九月七；大厦已不支，成仁万事毕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"屯悬岙，猿啼有感","author":"张煌言","text":"黄叶秋风落木繁，云峰日落忆寒山。\n横流绝渡凭班马，削壁枯藤乱叫猿。\n桂树千秋怀故国，铜驼卧处泣中原。\n鳌江南望岂为远，吾欲乘槎赴楚门！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思 中夜闻筝","author":"张煌言","text":"炙凤笙，弹鹅筝，弄入阳关第几情，铜壶滴漏明。\n一更更，一星星，都是商声与羽声，离人不忍听！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思","author":"张煌言","text":"品瑶笙，按银筝，换羽移宫无限情，秋天不肯明。\n几更更，几星星，半是商声与徵声，羁人和梦听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思 秋","author":"张煌言","text":"秋山青，秋水明，午梦惊秋醒未醒？\n乾坤一草亭。\n故国盟，故国情，夜阑斜月透疏棂，孤鸿三两声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"满江红 示同难宾从罗子慕于武陵狱邸","author":"张煌言","text":"萧瑟风云，埋没尽，英雄本色。\n最发指，酡酥羊酪，故宫旧阙。\n青山未筑祁连冢，沧海犹衔精卫石。\n又谁知，铁马也郎当，雕弓折。\n谁讨贼？\n颜卿檄；谁抗虏？\n苏武节。\n拚三台坠紫、九京藏碧。\n燕语呢喃新旧雨，雁声嘹呖兴亡月。\n怕他年，西台恸哭，人泪成血！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"满江红 步岳忠武王韵","author":"张煌言","text":"屈指兴亡，恨南北，皇图销歇！\n更几个，孤忠大义，冰清玉烈？\n赵信城边羌笛雨，李陵台畔胡笳月；惨模糊，吹出玉关情，声凄切。\n汉苑露，梁园雪；双龙游，一鸿灭。\n剩逋臣怒击，唾壶皆缺。\n豪气欲吞白凤髓，高怀肯饮黄羊血！\n试排云，待把捧日心，诉金阙！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"招赵友饮禅院","author":"张煌言","text":"清酒今朝买百壶，拟邀佳客醉屠苏；玉山倒处人争看，可有连城一璧无？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕前十日，赠少年合卺二首 其一","author":"张煌言","text":"玉涡檀晕自生妍，绿帻青鞲正少年；恰是双星银汉渡，风流却占一旬前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕前十日，赠少年合卺二首 其二","author":"张煌言","text":"兰汤浴罢不胜衣，一曲菱歌百两归；自是合欢怜子夜，玉山对倚照罗帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄纪侍御衷文二首 其一","author":"张煌言","text":"忆昔同堂勉圣贤，正当国难慨沧田；桃源有路君知避，博浪无椎我欲颠。\n卧雪山中坚晚节，扬波海上怒冲天。\n赤松游在安刘后，郭、李功名史并传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄纪侍御衷文二首 其二","author":"张煌言","text":"识得深山可避秦，岂容高蹈乐天真！\n夏兴犹赖臣靡力，楚复还凭包胥身。\n应念同仇多死友，休言有母不售人。\n陆沈谁向中流砥，天阙招寻鍊石神？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海上二首 其一","author":"张煌言","text":"仗剑浮身几度秋，关河遍誓客孤舟。\n一尊酒尽千山晓，七字诗成华谷讴。\n浩气填胸星月冷，壮怀裂发鬼神愁。\n龙池一日风云会，汉代衣冠旧是刘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海上二首 其二","author":"张煌言","text":"屈指蒙尘近十秋，每怀若作济川舟。\n公卿宁忆朝元暮，士庶空余思汉讴。\n报越有君谁共难，椎秦无力独胜愁。\n螭龙岂是池中物，文叔当年自谓刘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阙题","author":"张煌言","text":"青山叠叠晚烟迷，几点疏磷断涧西；夜雨寂寥山鬼泣，春风无主鹧鸪啼。\n酒炉如故生荆棘，画栋凄凉落燕泥。\n开谢桃花谁过问，萋萋芳草牧群归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感怀步扇头韵","author":"张煌言","text":"谁复高楼醉月笳，到来天半落青霞？\n葡萄宛马风尘暗，芦荻惊鸿雪影斜。\n山寺磬中吟桂子，江城笛里赋梅花。\n可怜燕赵多游侠，不及投金一浣纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖心亭书壁","author":"张煌言","text":"风吹野火火不灭，老鸮夜啼山鬼泣；菰蒲秋晚闇汀洲，断树残枝不堪折。\n苏公堤上衰草黄，愁云惨淡锁垂杨；家家夜雨鸣砧杵，处处秋声欲断肠。\n空有好花簪不得，万条弱柳垂金色；红尘埋杀合欢枝，春风自解同心结。\n翡翠堂前明玉珰，佳人云散泣莲芳；至今惟有湖心月，犹自娟娟上粉墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"显甥奔至","author":"张煌言","text":"初闻购孺子，何幸脱芦中！\n执手哀吾姊，囊头并若翁。\n死生尽一别，忠孝已双穷！\n凄绝青山外，鹃啼血倍红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻家难有恸四首 其一","author":"张煌言","text":"仇国言终验，衰门祚亦危。\n痛心惟骨肉，耄及受参夷。\n白首青枫暗，黄肠广柳迟。\n百端交集处，能不碎心脾！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27365,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻家难有恸四首 其二","author":"张煌言","text":"家破原因我，何堪玉并焚；亢宗空有子，函夏已无君。\n左衽兴亡决，南冠生死分。\n拊棺犹未得，挥泪结玄云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27366,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻家难有恸四首 其三","author":"张煌言","text":"孤竹行吟后，家无四壁存。\n更闻宗欲坠，不但族先燔。\n蹭蹬孤臣节，踉跄孝子魂。\n愿为双白鹤，飞去叩天阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27367,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻家难有恸四首 其四","author":"张煌言","text":"淫威何太甚，原外鹡鸰鸣。\n空拟班昭疏，甘成聂政名！\n肝埋有处士，肠断是零丁。\n遥识江胥路，霜飞独满城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27368,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得故人书至自台湾二首 其一","author":"张煌言","text":"炎州东望伏波船，海燕衔来五色笺；闻有象耘芝朮地，愁无雁渡荻芦天。\n息机可是逋臣意？\n弃杖谁应夸父怜！\n只恐幼安肥遁老，藜床皂帽亦徒然！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":27369,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]