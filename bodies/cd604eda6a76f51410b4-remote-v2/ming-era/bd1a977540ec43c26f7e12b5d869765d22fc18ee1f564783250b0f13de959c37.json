[{"title":"赠王太常之闽藩","author":"严嵩","text":"未论海峤与宸居，同是君恩感激馀。\n地僻云霞三岛近，官清琴鹤一舟虚。\n省薇昼永消炉篆，山荔风香引传车。\n知尔兹行暂分手，即看宣拜紫泥书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏学士荣赐犀带并手敕褒谕贺以是诗","author":"严嵩","text":"赐犀新宠冠朝行，飞白宸奎照玉堂。\n霄汉渥恩承湛露，琐闱清论满朝阳。\n君臣合契同鱼水，廊庙抡材有栋梁。\n留与词林传盛事，要知明主重惟良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和序翁先生从游西苑视谷","author":"严嵩","text":"行宫别殿接严宸，诏赐同游禁苑春。\n龙渚泛舟呼力士，御厨分膳辍饔人。\n阳和茂对皇情豫，云汉昭回圣藻新。\n政以艰难知稼穑，共言鱼水喻君臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉诏陪祀谷祗坛西苑游瞩汎舟太液和亭溪学士 其一","author":"严嵩","text":"祗坛奠璧晓光初，法驾临畴宿雨馀。\n幕近炉烟浮羽仗，林晴花色上簪裾。\n身逢广乐钧天盛，世际淳风太古如。\n农亩起家陪帝籍，江乡春事忆郊居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉诏陪祀谷祗坛西苑游瞩汎舟太液和亭溪学士 其二","author":"严嵩","text":"仙居春汎渺银河，桃杏红芳水绿波。\n日出芙蓉开帐殿，风回笙吹绕云萝。\n汀洲凫藻荣光满，楼阁烟花淑景多。\n不是传宣承帝泽，岂缘天路得经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管银台","author":"严嵩","text":"奉使持天节，宁亲捧寿杯。\n传车寒色送，歌吹夕阳催。\n驿傍河津转，关迎陇月开。\n留欢犹未尽，计日汉庭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋练塘卷李御史父","author":"严嵩","text":"悠然练塘上，拂榻坐清风。\n绿树重于盖，澄流映若空。\n鱼来深石下，鸟度夕阳中。\n独有乘骢客，看云忆甬东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入铨曹 其一","author":"严嵩","text":"肃穆堂阶迥，阴森柏桧齐。\n吏人依鹤立，乌雀傍林栖。\n水镜悬清鉴，丝纶照紫泥。\n天曹元峻绝，何意得攀跻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入铨曹 其二","author":"严嵩","text":"炉篆销寒昼，濡毫削奏书。\n多惭华省贵，秪拟列仙居。\n心结壶冰里，恩垂雨露馀。\n如何报明主，荐士满公车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴任南礼部九卿会饯于万福庵次韵留别 其一","author":"严嵩","text":"五云回首望宸宫，感激皇恩覆载同。\n身比马牛难报主，心随江汉亦朝宗。\n镐丰故拟周京重，礼乐亲知舜典崇。\n自是臣劳均出入，岂将鸿迹叹西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴任南礼部九卿会饯于万福庵次韵留别 其二","author":"严嵩","text":"星轺驻节倚禅宫，祖席登筵八座同。\n禁苑鸳鸾劳送远，留都礼乐愧称宗。\n正逢春郭烟花丽，更屈天卿礼数崇。\n巳隔长安辞日下，独看云树赋江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过东昌寿学士许龙石先生尊翁九十","author":"严嵩","text":"地是登瀛里，春当献寿辰。\n凤书擎诰重，鹇锦制袍新。\n禄待千钟养，天扶百岁身。\n古松仍偃蹇，老鹤倍精神。\n榴色侵琼斝，椿阴上绣茵。\n欲知恩庆远，东海正无垠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安山待闸","author":"严嵩","text":"客思去匆匆，川程渺未穷。\n水生波荡漾，日出景冥濛。\n花发当春树，舟牵逆浪风。\n颇觉征途倦，情非少壮同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓行南湖寄友","author":"严嵩","text":"远树犹含雾，澄流欲飐空。\n帆樯飞鸟外，箫鼓曙烟中。\n映带江林出，萦回岛屿通。\n无因寄相忆，春草正蒙茸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重经石佛闸望岸傍阁而赋之","author":"严嵩","text":"梵阁临江记昔攀，白云苍桧锁禅关。\n波澜极浦浮高栋，雾霭疏林出断山。\n尽日帆樯经树杪，早时钟鼓落人间。\n尘劳未息堪惆怅，又送官航此路还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将至徐州风阻野泊闻陈水部拿舟来会作此寄之","author":"严嵩","text":"津程望近转离忧，高浪烟汀阻宿留。\n剡渚正怜人独往，春山真忆鸟相求。\n云飞沛里风仍起，江绕黄楼水自流。\n闻说冬曹新政好，极知才是济川舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州陈水部萃墨亭留题","author":"严嵩","text":"高浪轩中沸，层楼画里开。\n浦云千嶂合，漕粟万艘来。\n墨萃刊亭石，风歌上沛台。\n树连平野尽，江逐古营回。\n舐泽烟霞改，桓山松柏哀。\n莫倚登檈赋，还资理国才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜至淮阴中丞刘公临访遂宴台院","author":"严嵩","text":"凫渚风灯乱，传呼绣斧来。\n那知维月舫，更得近霜台。\n披豁闻高论，将明仰上才。\n华觞春漏永，怀抱故须开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴张总戎宅","author":"严嵩","text":"棨戟元戎第，文觞得暂过。\n鸟吟春树遍，花映夕堂多。\n家世张车骑，勋名马伏波。\n淮洲见明月，其奈别离何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨州别邓太仆以正因寄玄庵穆学士","author":"严嵩","text":"养拙惭吾道，兹行偶共君。\n长途欣并舫，此路惜离群。\n树隐烟中郭，帆飞海上云。\n因声寄玄老，公暇好论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泛鸳湖","author":"严嵩","text":"楼榭开烟雾，汀洲似画图。\n城阴度?窱，天影入虚无。\n岸迥传清吹，波深洗玉壶。\n兹辰春日好，留兴在鸳湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒孝陵 其一","author":"严嵩","text":"翠巘皇陵閟，青松石道长。\n百灵罗象卫，五位备冠裳。\n龙剑风尘靖，罗图日月光。\n山空飙吹急，萧飒动宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒孝陵 其二","author":"严嵩","text":"社稷戎衣起，梯航玉帛朝。\n睹河功戴禹，瞻庙祀宗尧。\n石马嘶空翠，金灯照寂寥。\n遥看钟阜上，御气满层霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宫初上 其一","author":"严嵩","text":"谬忝文昌入，虚惭礼乐司。\n居当分陕地，荣及履星时。\n位重才非称，恩深报未知。\n愿奉惟寅训，还陈匪懈诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宫初上 其二","author":"严嵩","text":"爽气澄秋朔，朝光动省闱。\n竹风来锦席，花雾上朱衣。\n北斗跻衡峻，南曹领务稀。\n圣明谟典在，万世敢愆违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何司空","author":"严嵩","text":"冬曹公报政，钟阜我移官。\n傍树开新筑，临觞叙旧欢。\n宦途劳涉历，世泽盛衣冠。\n岂乏春华好，青松耐岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠潘吏侍入觐","author":"严嵩","text":"少宰今时望，风仪八座看。\n留曹称水镜，北阙待鸳鸾。\n振舄秋尘净，登车晓月寒。\n同年满朝署，相见庆弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾户侍考绩补赠","author":"严嵩","text":"民部知名久，清朝最老成。\n松当云壑古，冰贮玉壶清。\n国计分留署，秋帆上帝京。\n赠言惭我后，叨此继同声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"序翁相公惠寄对月见怀之作依韵拜酬","author":"严嵩","text":"远传仙翰到南宫，安得清光此夕同。\n气味敢云兰并臭，瞻依真以岱为宗。\n冰衔宠带铨衡重，衮席荣跻殿阁崇。\n共贺太平今有象，德星环聚五云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留都诸司拜进元旦贺表仆忝官礼曹当职题署摄事讫敬识一诗","author":"严嵩","text":"表函遥贺谨题封，黄袱亲缄献九重。\n下土葵心惟向日，丹霄云气总成龙。\n青阳启律欢称寿，紫禁趋班忆听钟。\n八座二京分职事，涓埃无补愧登庸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵城西泛舟太宰刘公邀集","author":"严嵩","text":"叠嶂澄江绕帝州，金尊锦席在兰舟。\n正逢吏散轩裳集，况是郊晴雾雨收。\n隔岸帆樯迷浦溆，傍城楼阁带林丘。\n名都胜槩还今赏，赤壁高阳空昔游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音山燕矶临眺","author":"严嵩","text":"高云石壁相因依，侧倚莲宫临燕矶。\n画栋岩峦开险绝，沧州烟树隐霏微。\n鲸鳌吹浪三山动，帆舶乘风万里归。\n日晚川长堪怅望，天青无尽雁孤飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音山次紫岩太宰 其一","author":"严嵩","text":"危栏高栋俯江深，萝径松门胜可寻。\n祗苑白云生静思，石溪红叶动秋吟。\n遥岑不改鸿濛色，清啸如传鸾凤音。\n轩盖拥林钟磬发，山僧应记宰官临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音山次紫岩太宰 其二","author":"严嵩","text":"天末长云逐雁来，江间波浪起孤台。\n初晴风日邀登阁，胜地山河对举杯。\n著帽山公期取醉，挥毫李白故称才。\n极知人世閒情少，多谢霜前白菊开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观梅花泉同紫岩太宰","author":"严嵩","text":"闻道幽香临绝涧，偶寻遗迹一相过。\n风前雪树花难觅，岩上镌题字半磨。\n苔径客行青嶂远，石堂僧占自云多。\n尘骖此地应稀到，洞口年年长薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牛首寺","author":"严嵩","text":"绝嵿双峰天阙开，禅房幽洞锁莓苔。\n岩峦路转孤云近，松柏风生万壑哀。\n当日翠华临别殿，千年威凤起层台。\n细观惟有阶前树，历尽人间累劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓登朝天宫西阁集宴还坐东麓亭有作","author":"严嵩","text":"江郭晴烟翠且重，山城紫阁坐高峰。\n杯前木落萧萧影，天外鸿归渺渺踪。\n御气尚浮宫苑树，寒声遥送石门钟。\n偶寻玄圃逢瑶草，拟接丹霞访赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和浚川大司马","author":"严嵩","text":"雾阁云窗拂曙开，白沙青嶂绕城回。\n鼋鼍浴日江光动，龙蜃嘘空海气来。\n万事纠纷堪息驾，百年佳胜偶登台。\n运筹作赋公能事，莫厌频来把酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和紫岩太宰","author":"严嵩","text":"仙家楼阁隐嵯峨，丽景祥烟入槛多。\n剑失正怜龙久化，台空犹忆凤曾过。\n冶城遗事遥难问，卞庙精忠耿未磨。\n风物岂殊桃洞宴，阳春重和郢中歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和久庵少宗伯","author":"严嵩","text":"袅袅高云覆阁阴，冥冥宿雾映江深。\n丛篁暄带林烟碧，独雁寒随浦树沉。\n天上楼台堪怅望，水边亭槛足幽寻。\n共来佳丽金陵地，重对樽前谢眺吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和筠溪少司马","author":"严嵩","text":"冬日邀宾东麓阁，冻云檐日共凄凉。\n天连一水蒹葭净，霜落千林橘柚黄。\n暂对碧山心自逸，独攀琼树意何长。\n风烟远目增幽思，身病逢欢亦尽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大祀斋居 其一","author":"严嵩","text":"省阔南宫静，台阶北斗齐。\n露承金掌近，天傍玉绳低。\n院寂人稀语，松高鹤对栖。\n旧编閒自校，窗火照青藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大祀斋居 其二","author":"严嵩","text":"坐漏频移榻，听钟更振衣。\n月疑开宝扇，云忆闪朱旂。\n礼乐今周祀，河山旧汉畿。\n翠华天北极，遥仰六龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大祀斋居 其三","author":"严嵩","text":"露笋分朝馔，炉沉换夕薰。\n地严增阒寂，味澹谢芳荤。\n澄汉悬珠斗，层霄驻彩云。\n百辟同明德，千春奉圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大祀斋居 其四","author":"严嵩","text":"忝窃纡朱绂，栖迟记玉堂。\n钟陵山上月，重此对清光。\n白日看驹隙，青云愧鹭行。\n所嗟心寸草，何以报春阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋居奉同久庵寅长纪赠 其一","author":"严嵩","text":"松柏高姿兰蕙薰，茆斋北郭旧论文。\n宁非夙世神仙侣，华省青精更对君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋居奉同久庵寅长纪赠 其二","author":"严嵩","text":"叔度令予鄙吝消，英词往往奏英韶。\n文章巳见追前古，礼乐还应翊圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠钟石翰长 其一","author":"严嵩","text":"咫尺南宫近木天，羡君官府是神仙。\n鸾凰会整青霄翼，山水还留白雪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠钟石翰长 其二","author":"严嵩","text":"玉署清衔直似冰，文章南斗价逾增。\n古槐脩竹清阴里，散帙谈诗记我曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠介立旧寅长","author":"严嵩","text":"学省清游易岁年，留台重望借才贤。\n鹓鸾故集丹山树，奎壁还联紫极天。\n麟阔石渠须制作，碧山沧渚寄延缘。\n怀人正有停云思，抚景空弹白雪弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次紫岩太宰斋居韵 其一","author":"严嵩","text":"遥想泰坛燔璧夜，彩云晴护帝城春。\n帷宫御气临黄屋，阁道炉烟上绣茵。\n翠管银罂沾泽旧，椒花柏叶献年新。\n留曹自是均劳地，珍重台衡报主身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次紫岩太宰斋居韵 其二","author":"严嵩","text":"省阁松阴动日华，仙卿高咏兴无涯。\n正逢山翠开书幌，拟近池波著钓槎。\n阊阖北云频望阙，烟花南国更移家。\n甘盘旧学留宸眷，早晚徵纶拜宠嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次费学士斋居","author":"严嵩","text":"玉堂幽事镇相关，雪茗云篇兴未悭。\n春槛烟花迷紫禁，夕帘苍翠满钟山。\n纶闱世掌看新命，讲殿晨趋忆旧班。\n见说天庭起黄色，北扉应待凤书颁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次胡太常斋居","author":"严嵩","text":"容台斋祓静炉薰，江郭晴烟霭瑞氛。\n自识仙曹堪隐吏，偶过僚署喜论文。\n海中鹤驭通三岛，天上彤楼丽五云。\n邻并最欢依玉树，别来三日倍思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予昔在翰林礼部杨月湖汪閒斋二先生斋居邀予诗会今二公已下世矣感旧述情而题此句","author":"严嵩","text":"剑水烟云宝气消，龟峰猿鹤巳难招。\n读罢旧题空泪落，省闱风竹晚萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日群公集灵谷寺 其一","author":"严嵩","text":"青霞宿雾净朝阴，长笛洞箫悲远林。\n云窦泉流一壑静，石门路入万松深。\n回廊古壁留名画，坠叶冷风助梵音。\n此地岩峦足幽胜，岁时携酒一登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日群公集灵谷寺 其二","author":"严嵩","text":"至日上方吟送酒，尽看鸾鹤在烟霞。\n阳回嶰谷时方泰，山绕钟陵境自嘉。\n林下幽香逢蕙草，水边春信见梅花。\n习池宾客今名胜，转觉风流兴未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵谷寺次浚川大司马韵","author":"严嵩","text":"深冬翠壑尚春姿，八座舆骖共此时。\n今代珠林开净境，千年金塔礼真师。\n泉边倚榻逢僧话，树底穿云避鸟知。\n莲社虎溪俱胜事，不妨重作后游期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次久庵少宗伯","author":"严嵩","text":"上方台殿耸岧峣，望近松门路转遥。\n山抱玉陵增气色，磴盘琪树入云霄。\n岩花当日迎龙驭，涧水千年落凤韶。\n林下志公呼不起，空馀遗事说梁萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨经凤台门","author":"严嵩","text":"台凤久寂寞，门今尚得名。\n岗峦拔地峻，竹树带烟晴。\n寒日一以眺，白云空复情。\n万峰天外色，二水抱神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登雨花台","author":"严嵩","text":"雨花朝独上，寒望尽皇州。\n猎猎海风至，冥冥江雾流。\n楼台开秘苑，城郭枕高丘。\n今古浮云色，长歌寄此游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过永宁高座二寺","author":"严嵩","text":"永宁峰寺僻，高座亦为邻。\n曲径无人到，云松自可亲。\n异花飘法界，幽草发新春。\n安得遗尘事，林中结净因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送司空秦公赴召 其一","author":"严嵩","text":"又看冬省承优诏，更折春梅送别筵。\n江寺劝杯曾对雪，凤楼鸣玉再朝天。\n舟经故里迂仙棹，衣近金炉上御烟。\n想到禁庭多雨露，一时卿望尽才贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送司空秦公赴召 其二","author":"严嵩","text":"十年钟阜重游地，正喜从公柰别何。\n垂老再逢宣室召，祖筵犹唱渭城歌。\n南宫昼接天颜近，西苑春祠水树多。\n周历五曹谁得似，圣朝勋业看嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠士鸣年兄","author":"严嵩","text":"簪盍欣相倚，其如此别何。\n江湖忧思在，霄汉盛名多。\n暮渚吟蘅杜，春山隐薜萝。\n赐环知有日，行矣养天和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵岁夜 其一","author":"严嵩","text":"旧都遗俗是升平，又听盈门鼓吹声。\n柏酒竞传知腊味，土牛初献识春耕。\n万家梅柳开烟市，双阙星河隐凤城。\n萍海客游今老大，自惭癯质玷华缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]