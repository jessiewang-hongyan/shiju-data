[{"title":"陈南滨侍御奉母南还","author":"余继登","text":"浮云西北驰，越鸟东南飞。\n壮士各有怀，何为常依依。\n况有白发亲，日夕望庭闱。\n陈情叩天阍，君恩许暂归。\n板舆亲扶将，满路生光辉。\n到日敞华堂，开燕及芳菲。\n春风发朱英，照君舞时衣。\n君良悦情意，其奈心知违。\n嗟我同门友，渐看云会稀。\n今复惜君别，何以效涓微。\n处士忌硗硗，愿君聊息机。\n珍重报国身，努力奉春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯用韫学士归省 其一","author":"余继登","text":"君王方问道，学士乃宁亲。\n绿野看云近，黄金结绶新。\n更缘瞻岵意，得慰倚闾人。\n綵服皆宫锦，犹馀汉苑春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯用韫学士归省 其二","author":"余继登","text":"壮年能解绶，拜命即辞荣。\n盛事归桥梓，私心忆弟兄。\n传符明主赐，樽酒故人情。\n别后长安道，应增鸣雁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯用韫学士归省 其三","author":"余继登","text":"自与君为友，知君真可师。\n亦惭非远志，谬欲托深期。\n握手忍分去，停杯怅别离。\n无由生羽翼，相望但相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯用韫学士归省 其四","author":"余继登","text":"知君非久别，无柰亦分违。\n从此风期阻，渐看云会稀。\n南邻想高士，东壁望馀晖。\n莫向碧山去，依依恋舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王太初之金陵","author":"余继登","text":"匹马西风出禁闾，皇恩新拜大鸿胪。\n有官何必中丞节，无地不堪君子居。\n南北那非明主赐，往来可柰故人疏。\n秣陵旧迹时登眺，慷慨应伤六代馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芝阳丈候补都门赋赠","author":"余继登","text":"孤臣来绝徼，久客滞长安。\n酒典鹔鹴服，尘生獬豸冠。\n途穷感嘅易，金尽结交难。\n惟有匣中剑，西风洒泪弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芝阳被谤后抚臣疏其有功于滇仍乞补滇以酬其绩乃竟得郁林书此为别","author":"余继登","text":"凄凉伤岁暮，飘泊又春初。\n裘敝因除目，骨销是谤书。\n莫缘臣节苦，便与世情疏。\n迢递苍梧道，新恩未可虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿盖吏部母","author":"余继登","text":"高堂为寿日，游子在京华。\n岂不荣鸾诰，谁其侍凤珈。\n见萱即忆母，陟屺倍思家。\n遥望称觞处，白云映紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行","author":"余继登","text":"初晴山路滑，涧水正泠泠。\n秋老树多紫，雨馀峦倍青。\n参差高下寺，迤逦短长亭。\n村酒不能醉，寒风吹更醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王伯桢参晋藩","author":"余继登","text":"世事真堪噱，王生又外藩。\n浮沉原宦迹，陟黜总君恩。\n霄汉天谁问，风尘道自存。\n所怜白首别，黯矣各销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得续桥社长书寄赠 其一","author":"余继登","text":"相离当岁晚，相忆又秋初。\n闻雁悲游宦，怀人念索居。\n客情无复道，清兴近何如。\n自是嵇康懒，年来音信疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得续桥社长书寄赠 其二","author":"余继登","text":"近得缄来信，怜君生事閒。\n楸枰敲落月，桐韵志高山。\n旧帖临池补，新诗闭户删。\n堪嗟为客者，碌碌鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题江长信雾灵山图","author":"余继登","text":"玄武之精化为石，堕地幻作雾灵山。\n去地不知几千仞，巉岩砐砢绝人寰。\n中有广硎之水黑峪之关，天为蓟门设屏蔽，不令边人饮马于其间。\n谁哉当关，胡乃失守藁，厌人血溪量人首。\n妖氛惨淡塞垣墟，敌骑凭陵壮士走。\n一战深惭正正旗，三捷敢欺明明后。\n西台御史李汝培，铁面皂囊何雄哉。\n封书暮入明光殿，战地朝看骢马来。\n江君故是埋轮者，乘骢直抵关山下。\n空壁萧条馀釜鬵，藏尸纵横遍原野。\n怒气勃勃起神羊，寒威凛凛入弹章。\n至今六月山头雪，犹是当年简上霜。\n于戏江君谁貌汝，豸冠绣服猛如虎。\n只今东有倭西有虏，潢池处处鸣桴鼓。\n愿君揽辔一澄清，扫尽欃枪报明主。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠唐宪副母夫人寿","author":"余继登","text":"君家慈亲世难得，白发萧萧仍健食。\n江鸥海鹤比精神，霞帔云冠照颜色。\n有子今为外台臣，黄金为带朱为轮。\n已向虞廷称万寿，还从孟母祝千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘效忠巡抚延绥 其一","author":"余继登","text":"开府须人杰，维垣属列卿。\n符分竹虎去，轼拥画熊行。\n号令严刁斗，威名变旆旌。\n羡君还自愧，白首竟儒生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘效忠巡抚延绥 其二","author":"余继登","text":"宦是刘生拙，崇阶亦渐跻。\n廿年淹塞北，千骑向延西。\n小范谁堪并，大名君与齐。\n丈夫多远略，早晚破回奚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘效忠巡抚延绥 其三","author":"余继登","text":"谁云边塞地，城郭近来空。\n闻道延州将，犹称列郡雄。\n此行期破敌，慎勿但和戎。\n好使麟台上，书君第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘效忠巡抚延绥 其四","author":"余继登","text":"青油明虎帐，紫塞控龙庭。\n汉马嘶卿月，边人识将星。\n英雄头未白，事业简须青。\n莫道书生老，犹堪一勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五十口号 其一","author":"余继登","text":"五十今朝是，凄凉感岁时。\n浮荣仗马似，生事蠹鱼知。\n老觉年来甚，病惟归去宜。\n主恩惭未报，容易鬓成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五十口号 其二","author":"余继登","text":"初度逢摇落，庭柯叶正飞。\n岁华已不待，心事复多违。\n久宦惭金马，应还理石矶。\n生平何者是，敢道去年非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逐妇行送陈从龙侍御","author":"余继登","text":"莫逐妇，逐妇令妇悲。\n试问妇何悲，妾亦有所悲。\n不缘宝怅閒鸳枕，不愁艳质妒蛾眉。\n妾有一寸丹，日织五丈素。\n织作不辞劳，何事君不顾。\n君不顾兮妾无缘，妾无缘兮妾何言。\n当初拟与同生死，宁知弃掷今如此。\n妾岂愿学随风花，妾岂愿作覆盆水。\n随风花，逐水流，覆盆水，不再收。\n妾意与君相绸缪，何无何有为君求，君不悟兮妾心忧。\n出君门，沾妾臆，欲行不行长叹息。\n莫言去妇无颜色，倘君尚欲当窗织，应知去后能相忆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送常对水 其一","author":"余继登","text":"三十年前曾聚萤，与君清夜坐谈经。\n蹉跎愧我头先白，濩落看君绶始青。\n此会且?酩酊醉，明朝何处短长亭。\n天涯朋旧怜星散，厌对骊歌不忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送常对水 其二","author":"余继登","text":"太原亦是先王地，质朴犹馀太古风。\n君去好携循吏传，政成宁让晋阳公。\n桑麻处处深山里，弦诵家家明月中。\n何日仙凫飞汉室，都人应避五花骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午元日忆用韫","author":"余继登","text":"他日逢元日，开樽我对君。\n此时吾谢客，翻怪尔离群。\n懒醉长安酒，空瞻海峤云。\n弟兄寥落甚，嗒矣坐宵分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王伯桢入都志喜","author":"余继登","text":"世间万事难具陈，伯桢乃作外台臣。\n仰天大笑去不顾，抛却金紫如埃尘。\n吾辈亦是奇男子，肯令行止由他人。\n世间万事谁能保，伯桢复走长安道。\n囊中白简久模糊，腰下黄金尚美好。\n光阴去去如流水，六七年来复如是。\n当日英雄安在哉，空令姓字污人齿。\n路人共指关西子，七尺肮脏犹如此。\n春花正发玄都观，暮云空锁平津里。\n伯桢与君别来久，穷交醉汝一杯酒，胸中磊块能浇否。\n陶令当年懒折腰，陈生有日终开口。\n饮君酒，为君歌，所得漫言比仲多。\n西夏豺狼虽授首，北海鱼龙未偃波。\n中原白骨莽相望，赤子恐弄池潢戈。\n丈夫报国须少壮，问君意气今如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏柬用韫","author":"余继登","text":"问君山中何者好，君言无事常却扫。\n朝看小妇理新妆，暮督侍儿寻旧草。\n有时舞綵奉亲欢，频沾馀沥醉更阑。\n锦帐酣眠不觉曙，何能清梦到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纯之丈以予十六年官六品贻诗见笑次韵解嘲","author":"余继登","text":"宦久成衰相，官閒趁病身。\n方惭赵氏璧，敢叹汉家薪。\n愚拙应输我，才名实让人。\n浮荣今已足，有志在垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿谭中丞母","author":"余继登","text":"慈母丸熊旧，仙郎符虎新。\n去持开府节，归慰倚门人。\n榴火当樽艳，荷香入酒醇。\n添筹从汉沔，献祝指峨岷。\n早逐潘家驭，休回王子轮。\n愿将称寿意，散作锦江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有说予学禅者戏答","author":"余继登","text":"不谙贝叶编，且倾竹叶酒。\n醉中有真趣，真言吾何有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻四槐丈至","author":"余继登","text":"才凭尺素慰相思，忽报輶轩已在兹。\n握手乍看疑是梦，论心久语却成悲。\n君才岂合长林壑，此意聊将付酒卮。\n南北于今多战伐，即看明主问非螭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"连日同四槐丈饮沈御史园有感","author":"余继登","text":"昨日看花花满枝，今朝花已半离披。\n因怜聚散浑如此，始信衰荣亦若斯。\n令节正当三月候，相逢况是七年时。\n共君痛饮不沉醉，即使重来未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜月同伯桢饮直卿宅兼订会期","author":"余继登","text":"弟兄三十辈，今得几人存。\n偶逐囧卿骑，同倾学士樽。\n人占星聚里，吾喜月当轩。\n此后经旬约，期君不负言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李纳言萱庭日永卷","author":"余继登","text":"沧洲缥缈接青冥，中有仙家萱为庭。\n庭前一夜春风起，春日曈昽照阶戺。\n森森萱叶何青葱，袅袅萱花吐金紫。\n共道此花应有神，托根日与松芝邻。\n松柯如石芝如菌，芝为颜色松为身。\n可比昆崙老桃树，一度花开三千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送庄太史册封","author":"余继登","text":"楚客才名天下闻，封茅直向粤南分。\n千年带砺归宗子，万里莺花属使君。\n独秀峰含桐叶色，七星岩动剑锋纹。\n壮游处处堪乘兴，赋就应淩五岭云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王清泉刺史","author":"余继登","text":"故人多远识，早已宦情微。\n林壑但寥落，酒樽无是非。\n心轻五马贵，人羡一鸿归。\n予亦风尘倦，秋来思振衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五忆诗 其一 鲁应绍","author":"余继登","text":"应绍忘年友，怜君老一经。\n兴酣时卜夜，谈剧每移星。\n昔诧玄言白，今嗟坟草青。\n望庐思笑语，双泪为君零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五忆诗 其二 王公招","author":"余继登","text":"旅邸相逢日，开樽尚自亲。\n谁知生别后，遂作死离人。\n疾病工为祟，文章竟误身。\n故园台榭尽，零落不胜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五忆诗 其三 常子仁","author":"余继登","text":"子仁吾党彦，雅志在公车。\n词赋金同掷，丰标玉不如。\n龙年忽冉冉，鹤梦竟蘧蘧。\n幸有佳儿在，犹能读父书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五忆诗 其四 克孝","author":"余继登","text":"吾宗老伯氏，今世葛天民。\n有酒即拚醉，无财不厌贫。\n可怜泉壤下，犹是孝廉身。\n诸子近萧索，相看更怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五忆诗 其五 克敬","author":"余继登","text":"最怜克敬弟，戆直无它肠。\n不恋儒为籍，却耽酒是乡。\n醉能消日月，病乃入膏肓。\n谁复为吾益，思之倍惨伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其一","author":"顾允成","text":"只对青山不著书，鸢飞鱼跃见天机。\n嗒然隐几吾忘我，梦觉人间是与非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其二","author":"顾允成","text":"只对青山不著书，窗前绿草自菲菲。\n蒲团坐破何烦补，此意从来知者希。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其三","author":"顾允成","text":"只对青山不著书，无声无臭悟渊微。\n閒亭小阁无他事，剩与春风伴浴沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其四","author":"顾允成","text":"只对青山不著书，江门老子亦依稀。\n声声色色原无两，枉判低昂费指挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其五","author":"顾允成","text":"不对青山不著书，出于机也入于机。\n曾似有无双遣却，夜深乌鹊绕南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其六","author":"顾允成","text":"亦对青山亦著书，廓然顺意莫猜疑。\n无端并入庄生梦，蝴蝶原来便是台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其七","author":"顾允成","text":"箪瓢疏水意何如，乐在其中境转舒。\n古人冷淡今人笑，漫被浮云点太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其八","author":"顾允成","text":"浴沂风雩兴超然，童冠三三春暮天。\n古人冷淡今人笑，傀儡场中闹岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其九","author":"顾允成","text":"鹪鹩偃鼠总蘧蘧，归休无用天下为。\n古人冷淡今人笑，豆羹箪食见须眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十","author":"顾允成","text":"首阳山下日凄凄，敝屣侯封向采薇。\n古人冷淡今人笑，玄武门前血溅衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十一","author":"顾允成","text":"桐江滩上雪霏霏，独拥羊裘一钓垂。\n古人冷淡今人笑，南山又见北山移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十二","author":"顾允成","text":"五柳萧萧映绿阴，先生不知何许人。\n古人冷淡今人笑，纷纷争媚玉楼春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十三","author":"顾允成","text":"紫芝先生年六十，生平未尝见女色。\n古人冷淡今人笑，二八嫦娥不离侧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十四","author":"顾允成","text":"伯鸾卓尔似人龙，且向吴门学赁舂。\n古人冷淡今人笑，以隶相尊倒托佣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十五","author":"顾允成","text":"男婚女嫁既已毕，子平山游不复出。\n古人冷淡今人笑，儿孙马牛何时逸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十六","author":"顾允成","text":"少文好游有奇僻，老疾名山图在室。\n古人冷淡今人笑，泰山当前眼如绌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十七","author":"顾允成","text":"罗冲万金原不足，君平百钱自有馀。\n古人冷淡今人笑，却将不足奉有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十八","author":"顾允成","text":"仲蔚蓬蒿雅没人，闭门养性略荣名。\n古人冷淡今人笑，击鼓求亡大过情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其十九","author":"顾允成","text":"短褐持蔬自奉宾，驎之父子水潾潾。\n古人冷淡今人笑，反命厨人代野人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其二十","author":"顾允成","text":"一坐藜床五十年，幼安当膝处皆穿。\n古人冷淡今人笑，累褥重茵自在眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其二十一","author":"顾允成","text":"一琴一鹤亦已清，如何屏去不留行。\n古人冷淡今人笑，前呼后拥小儿惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其二十二","author":"顾允成","text":"酒或三行或五行，主宾会数而情真。\n古人冷淡今人笑，司马家风邈绝伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其二十三","author":"顾允成","text":"喜怒哀乐未发前，此中气象作何观。\n古人冷淡今人笑，憧憧思虑汹狂澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾与吟 其二十四","author":"顾允成","text":"予欲无言见仲尼，子渊终日只如愚。\n古人冷淡今人笑，咸辅颊舌口嗫嚅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒色财气四吟 其一","author":"顾允成","text":"酒不迷人人自迷，一卮一卮复一卮。\n可怜曲糵消人志，病多休道药难医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒色财气四吟 其二","author":"顾允成","text":"色不迷人人自迷，朝云暮雨狐绥绥。\n形神暗逐蛾眉耗，病多休道药难医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]