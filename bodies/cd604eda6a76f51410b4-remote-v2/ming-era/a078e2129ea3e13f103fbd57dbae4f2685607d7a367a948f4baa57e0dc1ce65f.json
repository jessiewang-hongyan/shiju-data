[{"title":"庄中元旦","author":"张嗣纲","text":"元气鸿钧转，占年拜水神。\n欢呼人事好，喜见岁华新。\n绕径桑麻密，依人鸟雀驯。\n数杯椒蘖酒，同醉太平春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日邓尚龙尚虎兄弟招游赋谢","author":"张嗣纲","text":"大埔多春兴，寻春约胜游。\n一湾流水远，三径竹林幽。\n测景桑麻地，飞觞花萼楼。\n醉归山路晚，还送碧溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬邓尚龙尚虎尚义昆弟","author":"张嗣纲","text":"昨日满香馀，梨园兴不虚。\n学翻新谱曲，閒说古人书。\n已具青盐榼，聊扳白鹿车。\n飘然无俗虑，乐意竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和四弟庄竹成林作","author":"张嗣纲","text":"小憩林塘景，尊开对此君。\n移裁方浥露，高出自淩云。\n丝笋猗猗秀，苍竿个个分。\n清阴偏狎客，把酒细论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拾大爆花","author":"张嗣纲","text":"元夜灯方撤，灵神鹤驾回。\n登坛三捷鼓，平地一声雷。\n花爆从天降，金吾彻夜开。\n祯祥原有兆，好事自然来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸亥出行","author":"张嗣纲","text":"跨马出郊坰，雕鞍向穗城。\n只披烟雾去，会见暖风生。\n射策心犹壮，弯弓眼复明。\n请缨如有路，海峤自澄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同何子观林元美饮谢宗吉崇雅斋共赋隔沼桃花","author":"张嗣纲","text":"春到园林媚，芳菲遍草亭。\n酒依池畔酌，香入案头馨。\n沼隔桃花艳，杯衔竹叶青。\n一枝含露折，移插小银瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古砚","author":"张嗣纲","text":"古砚传千载，英山石更奇。\n水流鸲鹆眼，质润鸊鹈脂。\n藏自焚书日，出逢布露时。\n右军挥兔笔，应勒岘山碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盟鸥","author":"张嗣纲","text":"星汉乘槎客，移尊画舫开。\n江山随处得，鸥鸟傍筵来。\n人与物无忤，诗从酒里裁。\n忘机堪自适，池上共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"景福","author":"张嗣纲","text":"诸天开福地，惟此石岩岩。\n佛坐蒲团静，僧归涧口巉。\n振衣千仞壁，走笔万人嵌。\n顾彼回头岸，琪花落满衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬薛碧翰仪孙招游星岩黑洞","author":"张嗣纲","text":"招游幽兴足，折屐旧康衢。\n有意窥丹鼎，留心上玉虚。\n老君何葱郁，黑洞亦崎岖。\n更欲登云路，因怀万里驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜韩孟郁著书七星岩二首 其一","author":"张嗣纲","text":"七星何峻峭，孤馆驻韩侯。\n为爱岩塘静，偏连水石幽。\n著书修竹里，把酒峡泉头。\n一鹤冲天起，飞鸣动九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜韩孟郁著书七星岩二首 其二","author":"张嗣纲","text":"漫游多墨客，著作不如君。\n业肄三仙观，旋生五色云。\n鸢飞天象道，鱼跃浪为文。\n独步凌丹顶，飘然思不群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至日与诸生别后独步星岩","author":"张嗣纲","text":"灰飞葭管日，长剑倚江关。\n过眼浮云尽，虚心白昼间。\n塞鸿天外起，岩树望中扳。\n薄暮疏钟急，探奇一往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郑帝珍就后哨","author":"张嗣纲","text":"世事赖劻勷，干戈满瘴乡。\n威名标岭峤，韬略仰汾阳。\n一旅原非少，元勋不可量。\n交欢鱼水日，功绩著旂常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳日招四弟归庄饮节","author":"张嗣纲","text":"湘潭不可见，吊古意何深。\n桂棹摇池绿，蒲觞泛柳阴。\n艾行为虎戏，笛响讶龙吟。\n庄上堪行乐，同观夺锦心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和欧阳昆季连夜明月入座之作","author":"张嗣纲","text":"青天云汉净，明月入帘幽。\n慢捲花阴叠，樽开桂魄浮。\n清风人狎坐，夜静镜当楼。\n桃李连宵宴，何须秉烛游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和见萤步韵","author":"张嗣纲","text":"青山凉夜雨，坐见湿萤飞。\n熠熠依书幌，辉辉映客衣。\n处囊惊火灼，照牍恨光微。\n车胤功成后，秋风得意归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送雷动明之任广海","author":"张嗣纲","text":"持赠延陵剑，长途且伴君。\n斗间腾紫气，海上跃龙云。\n昔与张华佩，今成雷焕勋。\n楼船工业烂，此去靖妖氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何如弟礼闱应试","author":"张嗣纲","text":"频年池草梦，几向蓟门生。\n御柳迎衣绿，宫花照月明。\n山新文豹变，浪暖锦鳞轻。\n此度京华里，春风得意鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和饮文舍弟将赴礼闱九日谒辞博士公墓偕诸子集饮云台风雨骤至次韵","author":"张嗣纲","text":"九日五云开，东南佳气来。\n扳龙人别墓，览胜客登台。\n未论寻幽兴，先看作赋才。\n片云生足下，风雨为谁催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送韩孟郁北上","author":"张嗣纲","text":"百卉露零秋，芙蓉江上愁。\n著书方去国，载酒问行舟。\n云路八千里，烟花十二楼。\n春风须卖笑，争讶夺龙头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归庄与效阳三弟对酌","author":"张嗣纲","text":"昔客三城馆，今归我草堂。\n诸孙频进酒，季弟并持觞。\n共议身家计，先忧老少粮。\n相看谈不厌，且醉菊花黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尝榄","author":"张嗣纲","text":"植榄园林下，于今四十年。\n根深存手泽，实大快心田。\n嫩肉初甘足，割苍老更坚。\n尝新能有几，聊得一枝鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦酒后与三弟观射","author":"张嗣纲","text":"寒气转亨嘉，新年感物华。\n醉看金橘树，坐对紫荆花。\n从猎人驰犬，弯弓我射鸦。\n春光须乐事，一醉是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平山刘瑞云屡约招饮因未识荆草来过访漫赋","author":"张嗣纲","text":"向来不识面，早岁已知名。\n未遂登龙愿，先传揖客声。\n迎人花灼灼，求友鸟嘤嘤。\n景物催人兴，相逢盖易倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉靖四十五年丙寅元旦得家书报喜","author":"张嗣纲","text":"岁事喜更新，年华入丙寅。\n将才求虎豹，家报诞麒麟。\n相业垂千古，曲江又一人。\n儿曹才辈出，何用数陈荀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑勖未赴试大司马","author":"张嗣纲","text":"仗剑出江干，龙光射斗寒。\n霓旌千里别，云翮九霄看。\n百发攒金簇，三才倚玉鞍。\n天廷悬大拜，知尔独登坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢李三圆因奇上方少年赋此寄谢","author":"张嗣纲","text":"手掇三元李，因风到上方。\n食桃情未洽，掷果意何长。\n欲下陈蕃榻，频倾孺子觞。\n练书如不倦，方入少年场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月念四日舟次东莞喜关彭二年丈过酌舟中","author":"张嗣纲","text":"大暑酷方去，清秋气未寒。\n天时递迁转，人事爱盘桓。\n彩鹢因公急，清尊为客欢。\n异乡逢此日，怅望白云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋对月赋寄谢宗吉署中","author":"张嗣纲","text":"山陬遥望月，怀旧独凭栏。\n皓魄一轮起，清辉万里看。\n赋诗怀谢傅，属和有潘安。\n欲听霓裳曲，身疑在广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虎门舟中赠启秀","author":"张嗣纲","text":"握手情何限，论交意独真。\n同为羁旅客，总是宦游人。\n愧我貂裘敝，如君虎帐新。\n况兼能御李，伫看靖妖氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜侄宾进庠","author":"张嗣纲","text":"游黉谁幼小，惟尔最英年。\n谒圣班从后，标明榜独先。\n父师垂义训，子弟聚豪贤。\n金马吾家旧，须先着祖鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜孙昌振进庠","author":"张嗣纲","text":"昔日称佳士，今朝喜泮游。\n墨池飞紫电，彩笔耀清秋。\n隽获青钱选，功从铁砚收。\n双亲犹未老，看汝上瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜泌龄","author":"张嗣纲","text":"提名连第一，羡尔少年才。\n书香修旧业，文献又新开。\n暂作青衫士，能无黄榜魁。\n义方犹未倦，名已达三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枯木回春","author":"张嗣纲","text":"此地多春意，油桐槁复生。\n枯枝长不朽，落叶又敷荣。\n疑是莱公竹，堪誇广宅荆。\n彼苍如注祐，好雨及时零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜诞曾孙","author":"张嗣纲","text":"行年七十四，今日见曾孙。\n世代知无量，诗书喜有传。\n愧予虽老大，期尔耀家门。\n且继书香业，千秋录尚存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太公之称","author":"张嗣纲","text":"予年近八十，喜得太公名。\n不见磻溪召，徒看渭水清。\n羽书何日歇，胡虏几时平。\n倘获龙螭兆，鹰扬万里程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感时三首 其一","author":"张嗣纲","text":"世事最难定，人心不可猜。\n羊归催客去，犬吠备戎来。\n雾暗弓还彀，宵明镜复开。\n坐看山月落，四顾重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感时三首 其二","author":"张嗣纲","text":"运转劻勷日，其如寇盗多。\n烟朝扶耒耜，雪夜枕干戈。\n食以鸠工耗，时因土木磨。\n牛园虽早竣，狗巷莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感时三首 其三","author":"张嗣纲","text":"蕞尔庄虽小，提防有老夫。\n门边三派铳，墙下几千觚。\n抟击如风虎，支更似夜乌。\n民心多奋勇，劝尔莫来图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"假馆","author":"张嗣纲","text":"斋舍新轮奂，幽深木石居。\n门前千顷稻，槛外几池鱼。\n月白堪筹策，风清可著书。\n诸生须绳勉，从此达天衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上书","author":"张嗣纲","text":"潮海蛟龙断，空山虎豹坡。\n深菁全斩刈，天树始婆娑。\n过眼浮云尽，娱情晚景多。\n一封书已上，料得太平歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遭乱","author":"张嗣纲","text":"鹰鹯时侧目，燕雀各投林。\n北窗高未稳，南亩大相侵。\n安集期未定，流离祸正临。\n翻思投字者，扰攘竟何心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别友","author":"张嗣纲","text":"临歧不忍别，分袂意难禁。\n且尽三杯酒，无忘一片心。\n山深虎豹笑，天远雁鱼沉。\n洒尽花间泪，须频寄好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆友","author":"张嗣纲","text":"早结金兰契，幽居大水边。\n浣沙非暨石，煮茗别罗天。\n解袂才三日，分襟似十年。\n小窗虚旧月，何夜复团圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枭獍","author":"张嗣纲","text":"天生枭獍性，地现虎狼形。\n好吮皮毛血，频哮搏噬声。\n大非人种类，长盗犬羊猩。\n何日阴司府，囚车监尔行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁社","author":"张嗣纲","text":"神社谷之主，迁坛坐北茔。\n一方供宝篆，百世仰金城。\n水绕人才旺，山回地脉灵。\n尧天多乐事，击壤赛升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"改路","author":"张嗣纲","text":"地势防岐路，天开聚宝瓶。\n往来常络绎，耕凿大丰盈。\n渐入陶朱宅，将游倚顿庭。\n从今门巷吉，人物总安宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞金道中即事 其一","author":"张嗣纲","text":"傲骨凭谁语，幽怀只自知。\n笋舆连远道，皀帽拂凉思。\n蕉鹿畴先觉，黄粱未半炊。\n嗟予羁旅日，麾楮寄遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞金道中即事 其二","author":"张嗣纲","text":"选胜寻芳去，驱车雨雪迟。\n乡心随旅雁，野况逐山麋。\n村叟迎旌旆，山童讶鼓鼙。\n庾关何处是，寒断鬓边丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠廖夫人","author":"张嗣纲","text":"我爱廖夫人，风流不可攀。\n黄金轻世态，青眼盻人寰。\n芳桂多含馥，灵椿不老颜。\n家庭垂训日，疑是窦燕山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端州沐佛会有感","author":"张嗣纲","text":"株树晓苍苍，钟声扣上方。\n清心和玉露，瑞气集香汤。\n古刹僧供事，诸天佛正光。\n吾亲如在日，随处见羹墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居大寒雪","author":"张嗣纲","text":"山居逢岁腊，衣薄觉严寒。\n折竹声催听，飞禽影断看。\n僮仆痴环户，牛羊懒出栏。\n最疑天气极，指日转春官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早朝大明宫","author":"张嗣纲","text":"山河襟带壮皇京，玉殿初瞻北斗明。\n五凤居尊仙仗拥，六龙御正晓钟鸣。\n文班上应郎官宿，武曜中分列将星。\n大拜久悬黄石略，前筹何惮请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄北道侍御吴用潜","author":"张嗣纲","text":"十年横卧一貂裘，誓不歼胡死不休。\n借箸自盟酬汉主，请缨谁为作曹丘。\n狼烟满目旄旗竖，雁阵惊心匣剑愁。\n何日五陵裘马共，深惭同学未封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒漂母祠","author":"张嗣纲","text":"雪霁维舟漂母祠，扪萝且读表忠碑。\n千金未受登坛报，一饭先沾进食慈。\n水浒尚存飞布迹，江干不攺钓鱼矶。\n往来多少封侯骨，疑是当年阿母遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过分水","author":"张嗣纲","text":"南湖巨浸水溶溶，昼夜如斯逝不穷。\n天设一川分上下，流随两岸别西东。\n古今消长通舟楫，岁月潺湲护禁宫。\n圣代山河资带砺，封章频下勒金龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安道中 其一","author":"张嗣纲","text":"马蹄无日不风尘，万里征途历苦心。\n揽辔津头防雨滑，披衣石角带泥痕。\n参差雁影平湖落，断续歌声隔岸闻。\n四顾关河云物异，十年世事语何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安道中 其二","author":"张嗣纲","text":"独跨征鞍万里归，彭城巉崄不胜悲。\n阴多白日迷歧路，露暗黄昏失霸矶。\n薄暮每愁风扑面，夜寒犹苦雪侵衣。\n马蹄踯躅危桥下，月断云端有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中遇东征兵船 其一","author":"张嗣纲","text":"凛凛西风扑面吹，漫空积雪下如丝。\n飞禽影绝行人少，折竹声哀过客稀。\n长铗剑鸣寒彻骨，穷途裘敝冷侵肌。\n可怜汉将东征去，多少无家未授衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中遇东征兵船 其二","author":"张嗣纲","text":"雨雪霏霏柳叶残，兵戈东下拥吴关。\n玉山影黯旌旗冷，银汉光摇草木寒。\n李愬此宵曾入蔡，范雎昔日正攻韩。\n主恩深重何时报，空请长缨倚剑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺王明府政莅新安 其一","author":"张嗣纲","text":"墨绶遥承汉诏新，分符初向粤江滨。\n单车暂尔驰青海，三异应知动紫宸。\n一路福星花满县，万家生佛泽如春。\n吾侪共有弹冠庆，北斗旗挥靖不尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺王明府政莅新安 其二","author":"张嗣纲","text":"百里初逢上大夫，清标雅望挺三吴。\n化行江汉风同美，政暇壶觞兴不孤。\n此日阶前鸣独鹤，有时云表下双凫。\n遥知淡海干戈辑，处处弦歌教泽敷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜向鸣弟黉报","author":"张嗣纲","text":"泮水涵光亦有年，喜看华馆笔生烟。\n昔时灯火催黄卷，此日衣冠映白莲。\n幸有诗书能世业，敢称门户出豪贤。\n功名本是男儿事，乐听埙篪奏几筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鬓","author":"张嗣纲","text":"六十年来鬓已斑，是非名利总无关。\n兴来吟首诗随意，乐处衔杯酒壮颜。\n境僻莫嫌茅屋小，心宽何论布衣单。\n世间多少英雄者，要买偷閒两字难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"区进士閒居之作","author":"张嗣纲","text":"东瓜满眼又葫芦，独乐园中一老夫。\n兴到有时拈笔写，客来无酒向邻沽。\n菜根细嚼随时过，竹杖閒游任意扶。\n几度倦眠山月上，梦魂应不到皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓟州兰","author":"张嗣纲","text":"一种幽兰气自芬，淡云微雨湿轻尘。\n窗窥弱质偏怜汝，幔捲奇香故袭人。\n小畹未轻三月雨，后庭先放一枝春。\n东风似解游人意，往复燕京赏更新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]