[{"title":"落花诗三十首 其二 二冬","author":"邓云霄","text":"应同神女下巫峰，黯澹伤春意万重。\n舞袖拂来还有态，游丝罥去迥无踪。\n桃蹊沙外残霞浅，梨院阶前积雪浓。\n莫道芳菲浑落尽，涉江吾欲采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其三 三江","author":"邓云霄","text":"开时还似斗新妆，瘦损丰姿意渐降。\n此日乱枝情脉脉，早时连理本双双。\n斜翻幕影摇红浪，暗扑灯花下玉釭。\n别有渔舟随水入，桃源深处吠仙乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其四 四支","author":"邓云霄","text":"枝垂红泪忍抛枝，还胜征人泣诀时。\n香歇纵伤今日幕，春归应有隔年期。\n明妃出塞终埋骨，苏武生妻竟去帷。\n试想人间长别苦，花神何事尚含悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其五 五微","author":"邓云霄","text":"探春未了送春归，万紫千红洗渐稀。\n馀艳卢姬堪?面，残香荀令待熏衣。\n乍迎丝竹临风笑，忽绕梁尘度曲飞。\n多少王孙金勒马，重来何处聘轻肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其六 六鱼","author":"邓云霄","text":"谩说繁华能久居，请看荣落有乘除。\n宠无班女曾题扇，时过龙阳亦泣鱼。\n风起青蘋千树靡，庭霏红雨一帘虚。\n还疑竹叶无颜色，邀得君王半夜车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其七 七虞","author":"邓云霄","text":"石家别业洛城隅，昔日风光近有无。\n不见留欢围锦障，但闻如意碎珊瑚。\n香消谷口春泉冷，人堕楼头夜月孤。\n试过遗基望残景，数株芳树带平芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其八 八齐","author":"邓云霄","text":"连天烟树望中迷，万片侵堤又点溪。\n鱼戏清涟吹锦浪，马嘶芳草踏香坭。\n飘残歌扇青楼晚，敛却啼妆翠幄低。\n解佩汉皋空想像，断肠人隔画桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其九 九佳","author":"邓云霄","text":"寻芳揽胜兴无涯，不似禅居意味佳。\n幻色自牵游子目，妖花难入野僧怀。\n翻残贝叶闻清梵，飞尽天香散晚斋。\n谁悟沾坭心不染，十年面壁锁芒鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十 十灰","author":"邓云霄","text":"惜花反畏花开尽，又报东君遣使催。\n楚苑雄风吹面急，梁台宝雨自天来。\n御沟流去何时尽，宫鸟衔飞几日回。\n犹有数株怜妾恨，长门留影覆苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十一 十一真","author":"邓云霄","text":"闻道青皇返玉轮，故将香雨浥行尘。\n绕沾兴庆池边笛，忽点含童阁里人。\n九十春光难再得，百千酒价岂辞频。\n寄言全盛红颜子，行乐须知贵及晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十二 十二文","author":"邓云霄","text":"谁家少妇婿从军，闲数馀花对夕曛。\n吹度西窗人独倚，泛归南浦水全分。\n风飘蝴蝶三更梦，雨散阳台一片云。\n踏碎琼瑶愁不扫，朝来还拂绛罗裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十三 十三元","author":"邓云霄","text":"舒啸高台望广原，百花今有几花存。\n从来玉貌难长姣，错恨青皇是薄恩。\n灯烛西宫虚绛帐，淋铃南内怨黄昏。\n谁能更展回春手，惆怅隋家旧日园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十四 十四寒","author":"邓云霄","text":"投辖闲园洽晚欢，紫房丹萼渐阑珊。\n过墙蜂蝶春拖去，半席壶觞带醉看。\n客下歌台珠履散，人归香径翠翘残。\n幽崖恐有孤芳在，好倩云烟护洞峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十五 十五删","author":"邓云霄","text":"千岁蟠桃春昼闲，倚云和雾杳难攀。\n瑶池宴后花长在，方朔偷来鬓已斑。\n堪叹铅华同木槿，谁逢萼绿识仙鬟。\n天台从觅来时路，流水潺潺失故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十六 十六先","author":"邓云霄","text":"冉冉东流竟不旋，花飞随马促游鞭。\n栽成满县怜潘岳，唱入回风恼丽娟。\n十里香尘迷蹴鞠，一围红玉上鞦韆。\n鹔鹴典却金龟解，还指新荷当酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十七 十七萧","author":"邓云霄","text":"狂风夜动广陵潮，逝水飘香不可招。\n波上玉颜窥晓镜，雨中珠泪湿残绡。\n瑶花仙种空存观，明月长桥渐罢箫。\n尚想龙舟游戏日，到今杨柳亦萧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十八 十八肴","author":"邓云霄","text":"枝压倡楼泣露梢，春深游客半相抛。\n娇红浪说如人面，浓绿空看覆鸟巢。\n车马不闻喧曲巷，樽罍谁共出芳郊。\n江州他日逢司马，拟诉琵琶为解嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其十九 十九豪","author":"邓云霄","text":"闲来结驷共游遨，穿尽重林步远皋。\n阵阵玉尘吹麦浪，霏霏金粉落松涛。\n青春转眼过三月，绿鬓驱人忽二毛。\n分付花前诸乐部，急催檀板和银璈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十 二十歌","author":"邓云霄","text":"淡日和风熏绮罗，清明上巳乐偏多。\n飞花恋妓娇能舞，啼鸟怜香巧和歌。\n剪彩纵难回锦树，铺茵还得卧青莎。\n大堤宴罢归来晚，素袜轻摇洛浦波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十一 二十一麻","author":"邓云霄","text":"恼乱芳心向狭斜，少儿懒困不司花。\n游春费尽缠头锦，买笑抛残击臂纱。\n黄褪蜂腰无剩蕊，红飞鹃血落谁家。\n还闻雨露深如海，掷果他时尚满车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十二 二十二阳","author":"邓云霄","text":"走马看花兴欲狂，飘零万点思茫茫。\n绕园锦绣新闻宴，委地胭脂晚罢妆。\n系日恨无长命缕，留春那得返魂香。\n五陵子弟重相问，更待明年百草长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十三 二十三庚","author":"邓云霄","text":"遥忆西川锦作城，万家香霭散红英。\n平拖柳絮浑无力，并掷榆钱暗有声。\n卓氏垆头春酒尽，薛涛填畔幕烟生。\n花溪近日凭谁浣，欲写鱼笺远寄情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十四 二十四青","author":"邓云霄","text":"祓禊江南饶胜事，暮春高会有兰亭。\n群贤载笔清如玉，曲水浮花细似萍。\n香堕觞前分片片，枝摇竹外更青青。\n风流人物今独昔，寿夭谁能混醉醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十五 二十五蒸","author":"邓云霄","text":"少年豪侠浪相矜，旋过平阳复杜陵。\n兴到酒徒空有约，春残花债向谁征。\n更开金埒闲调马，试学吴歌戏采菱。\n游罢回鞭指芳树，仓庚飞去但闻鹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十六 二十六尤","author":"邓云霄","text":"金陵自古帝王州，后主清酣恣逸游。\n狎客妖姬骄艳曲，临春结绮搆巍楼。\n庭花萧索沈宫井，玉树凄凉蔓野丘。\n日暮乌啼归古堞，莫愁湖水亦生愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十七 二十七侵","author":"邓云霄","text":"催花风雨晚森沈，千里江南永夜心。\n戴胜下时香作国，鹧鸪啼后绿成阴。\n轻飞赵后翩翩掌，低逐潘妃步步金。\n欲赠新词聊戏谑，迢遥溱洧水云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十八 二十八覃","author":"邓云霄","text":"朝来散步出城南，风水淙淙响石潭。\n残蕊树头还有几，标梅林下仅存三。\n掠枝乳燕新成子，拂叶飞蛾又变蚕。\n怅望丛花如梦里，静依松桧结山龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其二十九 二十九盐","author":"邓云霄","text":"闲阶剩馥晚偷拈，错认仙人绛雪甜。\n欲笑床空翻入户，似怜愁坐故窥帘。\n摧残眉黛芳姿减，迢递关山别恨添。\n借问嫦娥月中桂，可曾雕谢洒寒蟾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花诗三十首 其三十 三十咸","author":"邓云霄","text":"离宫琼蕊傍层岩，狼籍香魂尽坼缄。\n凝碧未经妃子折，上阳先被晓莺衔。\n生憎密叶偏笼帽，可惜轻花乱扑衫。\n还让阖闾城下树，半分颜色染风帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题谭子草玄亭","author":"邓云霄","text":"一片冰心隔市廛，闲来卜筑帝城偏。\n翛然虚室能生白，率尔挥毫学草玄。\n径外小桥澄水木，檐前远岫澹云烟。\n问奇载酒谁同醉，妙趣休将醒者传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避署露坐书怀二首","author":"邓云霄","text":"避暑闲门向晚扃，乘凉披露坐虚庭。\n微官远愧山中相，浮客空嗟水上萍。\n关塞怀人遥对月，干戈闻报暗占星。\n疮痍未息豺狼斗，时事年来不□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其一","author":"邓云霄","text":"日日可休沐，高斋常晏如。\n卧游半壁画，坐隐一床书。\n岁月闲中永，宾朋病后疏。\n门前春草合，谁识散曹居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其二","author":"邓云霄","text":"叩门云落帽，知是远山僧。\n且洗风尘足，休论大小乘。\n龙难藏一钵，鼠已啮孤藤。\n借问西来路，如君到未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其三","author":"邓云霄","text":"春残花落深，乘兴共登临。\n翠柳摇佳色，黄鹂复好音。\n游人看断续，天气半晴阴。\n寄谢采桑妇，谁轻南陌金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其四","author":"邓云霄","text":"下帘授老易，细雨洒庭虚。\n往事据梧外，闲心散帙馀。\n花飞春渐老，懒与世弥疏。\n幸接东邻子，高文一起予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其五","author":"邓云霄","text":"侯家连戚畹，裘马气翩翩。\n系腰丈二组，门依尺五天。\n已誇金作穴，宁惜埒铺钱。\n却笑南邻客，安贫学草玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其六","author":"邓云霄","text":"驱车出广陌，道遇斗鸡儿。\n上巳催游兴，春光正尔时。\n墙外鞦韆影，桃李路傍枝。\n可是王昌侣，香风处处随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其七","author":"邓云霄","text":"桑落长年悲，秋风日夜吹。\n未将云作液，那免鬓成丝。\n笑酌三杯后，陶然百不思。\n刘伶与阮籍，生愧不同时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其八","author":"邓云霄","text":"弱心馀一寸，载得许多愁。\n久客年为日，远书春到秋。\n天寒邻杵急，木落晚蝉稠。\n渐觉凉衿薄，中宵搅敝裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其九","author":"邓云霄","text":"闲来无一事，永日坐观棋。\n谱外传神秘，机深下子迟。\n手谈浑不语，柯烂已多时。\n自得仙家趣，人间未许知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十","author":"邓云霄","text":"习静高斋久，沈屙尚未消。\n移床安药臼，傍竹结茶寮。\n羸病宜跨鹤，疏慵好弃瓢。\n后来漆园吏，幽意在逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十一","author":"邓云霄","text":"远蹑西风上，层城独眺间。\n霜威初变柳，雾气欲沈山。\n泪逐南云落，心随早雁还。\n可怜三径处，芳草锁柴关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十二","author":"邓云霄","text":"客到征诗债，人来索药钱。\n苦吟侵瘦骨，旅食又经年。\n苏晋斋偏醉，维摩病是禅。\n无生欲有寄，何处问诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十三","author":"邓云霄","text":"睡癖非全懒，黄庭落枕中。\n谷神元寂静，火候在虚空。\n天上朝群帝，淮南忆八公。\n玉京眇何许，遥隔片云红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十四","author":"邓云霄","text":"读罢古思边，虚堂片月悬。\n光浮乌鹊外，影落绣帏前。\n怨妇思朝暮，征人自岁年。\n刀头空有问，破镜几时圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十五","author":"邓云霄","text":"九日登高处，西山最上头。\n乡关疑在眼，云物不胜秋。\n鼓角侵胡塞，烽烟绕汉州。\n穷边多老将，念尔未封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十六","author":"邓云霄","text":"狐兔晚骎骎，秋郊草正深。\n呼鹰看侠少，喜猎见童心。\n聚饮收残网，论功索赐金。\n官閒无薄禄，不愧伐檀吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十七","author":"邓云霄","text":"剥啄不相呼，庭除长绿芜。\n病因书是癖，人与古为徒。\n诗赋穷诸体，波澜障别途。\n沈思何所似，铁网取珊瑚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十八","author":"邓云霄","text":"吴越连三楚，东南半陆沈。\n奔涛万壑斗，野哭四天阴。\n蜃气空成市，龙宫直傍岑。\n商霖殊太急，尧警若为心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其十九","author":"邓云霄","text":"南国泪如雨，滇池血作波。\n沈冤天地老，新魂岁时多。\n谁念向隅泣，还闻鼓缶歌。\n黄金台上草，莫遣野麋过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲居杂诗二十首 其二十","author":"邓云霄","text":"扶筇到远寺，为赴老僧招。\n谈柄挥松叶，清羡煮菊苗。\n月凉如坐水，梵响似闻潮。\n白业非难就，青山信可骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"银河","author":"邓云霄","text":"终古贯天经，迢遥浅更清。\n雨云空自变，风浪静无声。\n一水盈盈阔，双星夜夜情。\n谁持河畔石，再去问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊申七夕旅思","author":"邓云霄","text":"万感集萧辰，羁怀难具陈。\n还因牛女会，远忆别离人。\n雨霁火云歇，天空秋气新。\n宦游今十载，依旧阮家贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄友人读书西山野寺","author":"邓云霄","text":"扰扰红尘地，思君在翠微。\n游人不到处，幽鸟亦忘机。\n碧草摇书带，秋风脆芰衣。\n竹窗休早掩，时有白云归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讯米君梦病","author":"邓云霄","text":"傲骨缘诗瘦，腰存尚几围。\n空囊还药里，细雨问秋衣。\n委巷余衰草，何人到叩扉。\n维摩元示病，知汝悟禅机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈仪翔年丈之抚州司李","author":"邓云霄","text":"相逢暑雨对闲扉，送别长亭叶又飞。\n易水寒风飘客泪，蓟门秋色上征衣。\n临川词赋谁堪继，贾谊才名世所希。\n莫道苦吟支瘦骨，知君战胜自能肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邻砧","author":"邓云霄","text":"寒入燕山树，清砧满四邻。\n声回缠戍角，风过乱边尘。\n驿使音书断，交河梦寐频。\n晚来休太急，隔院有离人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋社集同用飞花二韵 其一","author":"邓云霄","text":"华馆辟风扉，疏林澹晚辉。\n星随座密叶，叶共羽觞飞。\n秋色清于酒，云光薄似衣。\n良宵须尽兴，明月待人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋社集同用飞花二韵 其二","author":"邓云霄","text":"万里同为客，停杯感岁华。\n西风吹片月，秋思在谁家。\n夜久移桐影，谈深落烛花。\n明河清且浅，好泛斗边槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"施隐君诗","author":"邓云霄","text":"深居何异武陵津，一片闲云自在身。\n沮溺偶随南亩隐，羲皇聊寄北窗人。\n流年可叹如朝槿，上古谁云有大椿。\n借问辽东仙鹤去，归来城郭几回新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园秋集同用闻山二字　白露前二日 其一","author":"邓云霄","text":"落日高台对晚醺，芳尊同调自为群。\n红尘水外隔朝市，清籁林间净听闻。\n野鹤迎秋新警露，远山横翠半沉云。\n可怜一片空明界，塞北江南■未分。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜园秋集同用闻山二字　白露前二日 其二","author":"邓云霄","text":"鸥鸟还输隐吏閒，馀酣矶畔漱潺湲。\n坐来白石清流里，疑到三湘七泽间。\n夕网鱼虾翻几案，秋风蒪脍忆乡关。\n扁舟径可如张翰，词赋何须学子山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得落叶惊残梦","author":"邓云霄","text":"旅次依荒驿，山空静不闻。\n孤眠愁夜永，假寐逼宵分。\n木叶响如雨，阳台散片云。\n亦曾传綵笔，拟制宋生文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得钱塘潮排律十六韵赠钱塘卢生","author":"邓云霄","text":"曾向钱塘渡，烟销一镜开。\n潮头忽以至，地轴仄将摧。\n赤日飞睛雪，青天起暗雷。\n龙宫银作阙，鲛室玉为堆。\n组练疑横海，帆樯似泛罍。\n属娄光欲动，强弩势难回。\n东奔翻禹穴，南去蹴苏台。\n吐吸谁为此，陶钧力大哉。\n湖山澄秀气，越峤挺雄才。\n羡汝江边住，潮从笔底来。\n放歌摇彩鹢，弄月进霞杯。\n一击踰千里，相期在九垓。\n钓鳌偏有兴，向若敢轻猜。\n赋就水皆立，文成木尽灾。\n沉思牵铁网，佳句剖珠胎。\n近诧观涛作，前身或姓枚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]