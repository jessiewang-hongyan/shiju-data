[{"title":"题吴匏庵东庄诸景二十首 其六 方田","author":"石宝","text":"方田若棋局，水煖稻先熟。\n一半给官家，一半供饘粥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其七 果林","author":"石宝","text":"种果东庄头，年多不知数。\n林深少人迹，子落又成树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其八 曲池","author":"石宝","text":"池水清且涟，萦转牵曲镜。\n照见柳叶斜，不似莲花正。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其九 桑洲","author":"石宝","text":"采桑下长洲，桑叶绿如钿。\n幼妇解眠蚕，缲丝织黄绢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十 振衣冈","author":"石宝","text":"振衣复振衣，高冈出林杪。\n下见红尘飞，西望青山小。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十一 朱樱径","author":"石宝","text":"樱桃何累累，清光映寥廓。\n尽日无风吹，朱实忽自落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十二 鹤峒","author":"石宝","text":"鹤峒深窈然，竹木森四堵。\n中有幽居人，时时教鹤舞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十三 芝丘","author":"石宝","text":"种麦不种芝，芝生在中阿。\n至今芟麦人，兼唱采芝歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十四 艇子洴","author":"石宝","text":"凌波下洴水，日暮系艇子。\n大道如川流，圣人贵坎止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十五 折桂桥","author":"石宝","text":"折桂桥尚存，折桂人已矣。\n时有桥畔人，拾得桂花子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十六 白云馆","author":"石宝","text":"馆外暮云白，羽客时迎送。\n婆娑屋边树，传是梅仙种。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十七 知乐亭","author":"石宝","text":"幽士知鱼乐，临池小结亭。\n时时挥五弦，下有流鱼听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十八 耕息轩","author":"石宝","text":"耕田耕且止，垂轩坐憩息。\n非敢为惰农，应当惜牛力。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其十九 续古堂","author":"石宝","text":"延陵文章客，选地建新庐。\n指点平泉树，时称先大夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴匏庵东庄诸景二十首 其二十 拙脩庵","author":"石宝","text":"脩拙人何在，寥寥惟旧居。\n风雨棠花落，犹疑夜诵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"结交吟","author":"石宝","text":"白马载金鞍，悠悠迈城邑。\n桃蹊人不知，中有荆与棘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苔壁","author":"石宝","text":"嵯峨千仞壁，上有万古苔。\n萋萋风雨色，终不带尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李宗一扇","author":"石宝","text":"空江满秋色，回首见东山。\n旧日垂竿侣，攀龙久未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中","author":"石宝","text":"山深人迹稀，烟霁见茅屋。\n野老时时来，裴徊涧边木。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋原","author":"石宝","text":"野鹿时并走，沙禽亦双飞。\n何事秋原上，日斜人独归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春思","author":"石宝","text":"素月挂西楼，楼前春霭浮。\n罗衣试轻煖，长夜倚箜篌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中曲三首 其一","author":"石宝","text":"绵水何太急，奔流下东井。\n北登凤凰山，未晓见日影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中曲三首 其二","author":"石宝","text":"朝登青石岩，十步一驻马。\n亦有红颜人，倚马立岩下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灌园","author":"石宝","text":"开畦还汲井，勤苦待蔬成。\n不及池头草，无情日夜生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"问剑","author":"石宝","text":"铸尔亦何为，琴书得并随。\n中原多巧?，日暮尚狐疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"剑答","author":"石宝","text":"万事吾先让，临机鬼不知。\n不明兼不断，安用壮夫为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小画四首 其一","author":"石宝","text":"板桥诗老未还家，村舍儿童扫雪花。\n春酒山中犹未熟，罢吟应试小团茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小画四首 其二","author":"石宝","text":"四壁岧峣列翠屏，取凉还上望湖亭。\n醉来翻笑荷衣色，不及村南酒幔青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小画四首 其三","author":"石宝","text":"水南山北梵宫多，日暮钟声杂棹歌。\n别有幽居松竹里，春深惟拟故人过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小画四首 其四","author":"石宝","text":"山头寒瀑悬飞练，亭外平波接远天。\n秋色依稀何处见，半江风雨一林烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高宗宫词","author":"石宝","text":"月射罘罳动绮烟，合欢花下夜张弦。\n太平公主来称寿，玉带朱袍舞帝前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闺意","author":"石宝","text":"玉指金针课女功，鸳鸯屏暗蜡灯红。\n窗纱扑簌通宵响，满树桃花一夜风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春","author":"石宝","text":"萱草堂东逢立春，春风堪笑亦堪颦。\n青青盘菜思纤手，袅袅花枝似玉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题倪冬官小画五首 其一","author":"石宝","text":"花枝袅袅雀双双，昨夜东风到竹窗。\n野客情多何处写，旋挼花蕊浸春缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题倪冬官小画五首 其二","author":"石宝","text":"野鸟将雏意自真，牡丹花外往来频。\n谁知委巷茅檐下，亦有嗷嗷待哺人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题倪冬官小画五首 其三","author":"石宝","text":"春入瑶花又竹枝，依依寒雀向阳时。\n相呼相应皆吾乐，却恐鲲鹏亦不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题倪冬官小画五首 其四","author":"石宝","text":"花覆阑千金翠明，日高娇鸟睡初醒。\n不知人倚西风外，吟得新诗几字成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题倪冬官小画五首 其五","author":"石宝","text":"海榴花外往来时，大鸟劳劳小鸟饥。\n谁道吕生徒作画，分明如诵蓼莪诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玉泉亭上","author":"石宝","text":"峰岩百步翠重重，岩下春泉喷玉淙。\n章帝旧宫今不见，断霞犹出绣芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李后主画鹌鹑","author":"石宝","text":"翠袖成围紫殿深，曾看一胜抵千金。\n如何解甲临城日，不及山禽有斗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中平宫词二首 其一","author":"石宝","text":"水绕灵昆苑草春，渴乌新洒近郊尘。\n金舆罢幸天街静，白玉虾蟆自唤人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南朝宫词二首 其二","author":"石宝","text":"玉树新花夜夜开，张嫔风韵孔嫔才。\n感恩谁似中庭鸟，解咏江南草化灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贞元宫词二首 其二","author":"石宝","text":"贞元法曲被宫悬，绛䌌莲冠待管弦。\n惟有宋家兄弟别，各簪彤笔御帘前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"僧房感事","author":"石宝","text":"都言名利不如閒，多少投閒去住山。\n今日山僧还不免，人间宁是旧人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春过亨上人院四首 其一","author":"石宝","text":"试上生公说法台，落花榆荚点深杯。\n春光眼见随流水，满地黄鹂唤不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春过亨上人院四首 其二","author":"石宝","text":"近水疏藤换古稍，傍墙高柳出新巢。\n蓬门日落归犹未，要听山僧月下敲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春过亨上人院四首 其三","author":"石宝","text":"雉堞参差锁暮云，外城春水内城闻。\n风尘不落高僧梦，日日看经到夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春过亨上人院四首 其四","author":"石宝","text":"铃梵声沉昼寂寥，坐看孤鹤下丹霄。\n前身记是东方朔，恐有书从海上招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋阴","author":"石宝","text":"积霭阴阴覆苑墙，山梨病雨叶多黄。\n道人痴欲寻秋色，独立青山送夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草色","author":"石宝","text":"带烟和雨绿萋萋，水阁春深望眼迷。\n惆怅夕阳千古地，青山无语鸟空啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漫书次陈白沙韵二首 其一","author":"石宝","text":"中年虽过未扶筇，尽羡人间白发公。\n花下一壶那敢惜，江乡多雨况多风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漫书次陈白沙韵二首 其二","author":"石宝","text":"夜凉欹枕数清漏，秋早出门怜露花。\n莫道五湖归未得，山城十亩旧桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日","author":"石宝","text":"曲栏深院日初长，锦轴珠徽乱一床。\n燕子不来花又落，一年孤负好春光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新花曲四首 其一","author":"石宝","text":"翠池新种小芙蕖，欢动眠凫与戏鱼。\n试向水头经日看，好花成子定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新花曲四首 其二","author":"石宝","text":"雪骨冰丝奈弱何，碧琉璃上露痕多。\n隔阑遥见蜂窠影，应是新房映绿波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新花曲四首 其三","author":"石宝","text":"绿柄丹葩展未齐，晚风人立画亭西。\n翠衿双鸟翩翩下，应识莲花似越溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新花曲四首 其四","author":"石宝","text":"著意栽花岁又年，偶抛新菂便成莲。\n殷勤为向花神语，但愿根深子又坚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵奉答应韵二首 其一","author":"石宝","text":"春光能得几多旬，雨笠风蓑过半春。\n正自不禁萍水恨，可堪重对别离人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵奉答应韵二首 其二","author":"石宝","text":"东风不用漾游丝，小阁深愁发素时。\n满地绿苔人独坐，一林寒雨雀争枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三首 其一","author":"石宝","text":"密云欲雨不雨，桃花将开未开。\n日暮小楼凝望，江南燕子归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三首 其二","author":"石宝","text":"溪上一篙春水，林间几个流莺。\n野客半醒半醉，江南江北关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三首 其三","author":"石宝","text":"李白桃红柳绿，山长水深日斜。\n旧日谁家燕子，今年飞去谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五首 其一","author":"石宝","text":"沤篮池头独望，碧水沉沉不流。\n篱草半成萤火，残阳却傍高楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五首 其二","author":"石宝","text":"新月如钩自挂，白露成珠未圆。\n石枕藤床秋夜，高人不梦邯郸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五首 其三","author":"石宝","text":"秋江一望无际，山色坐来满衣。\n黄蝶花间独宿，林梢红叶时飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五首 其四","author":"石宝","text":"花落帘栊自好，水归溪涧空寒。\n穷达早知有命，不须待诏长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五首 其五","author":"石宝","text":"青山千里万里，白发三茎两茎。\n药味岂须台鼎，瓜田直在东陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀五咏 其一","author":"刘麟","text":"今我乐矣，叙旧以贤。\n瞻彼明德，不以厥年。\n生事匪多，尺宅寸田。\n暮色惟瞑，返照复鲜。\n君子保终，夕厉愓然。\n载我玄酒，践彼初筵。\n悠悠我心，无怀葛天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀五咏 其二","author":"刘麟","text":"今我乐矣，尘劳靡夕。\n俯仰褒然，乾坤归宅。\n冠盖各天，妻孥在侧。\n知己辰星，道途扫迹。\n空谷足音，使我太息。\n返照入林，牛羊是则。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀五咏 其三","author":"刘麟","text":"今我乐矣，自春徂秋。\n高人用息，志士乃愁。\n终风急雨，恐撼吾楼。\n楼有真人，邈不可求。\n求而得之，泛我轻舟。\n三山何许，垂老一游。\n石川野航，曰予销忧。\n龙骧虎变，挟小九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀五咏 其四","author":"刘麟","text":"今我乐矣，爰即我谋。\n陂塘雨足，上下其流。\n百年垂尽，寄兴孤舟。\n华胄玉台，浮游石头。\n群阴蔽空，百神在楼。\n此夕何夕，梦游九州。\n初随枕蝶，终执沙鸥。\n兴倦而觉，再梦再忧。\n空谷多鬼，其声啾啾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀五咏 其五","author":"刘麟","text":"今我乐矣，渐解尘缘。\n藏修还谧，始于今年。\n八十有六，十一师签。\n同生之士，艾耄涸然。\n我孙森森，玉立满前。\n仰忆宗祧，瓜瓞绵绵。\n升高有屐，临流有船。\n邀我良友，矢我新篇。\n退休于室，守真尚玄。\n不忮于人，不求于天。\n诏尔后人，勿忘勿愆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中奉答孙太初","author":"刘麟","text":"望古复望古，驾舟行远空。\n浮云日夕尽，天光上下同。\n潜鳞入渊微，归鸟正西东。\n亭亭夫容花，凄凄风露中。\n群情各有适，至理将在躬。\n日月去已多，忧伤来无穷。\n临流一濯足，顾影见双蓬。\n歌我水上心，答彼巢居翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答太初和韦苏州","author":"刘麟","text":"道存甘拙守，时艰惭幸生。\n在昔缪有寄，所至皆名城。\n感彼民物忧，违我泉石情。\n一朝印章解，归来读且耕。\n年登衣食足，心閒文字精。\n侧身鸥鹭中，尘网何由撄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"动静语","author":"刘麟","text":"客言动静机，相禅苦不了。\n无私动亦得，无欲静逾妙。\n动静能几时，去去勿复道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"携琴缅古","author":"刘麟","text":"疏疏子贱子，千载一单父。\n斯民不忍欺，厥治登太古。\n问渠何所修，得贤以自辅。\n谈笑黄虞间，岂复问齐鲁。\n孔铎本夙闻，舜弦时一鼓。\n赤子尔何知，所欲在慈母。\n吾施既春阳，物化若时雨。\n至今梧桐枝，金徽照寰宇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]