ion":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悼女侄端","author":"刘崧","text":"已谓生还遂，谁知死病仇。\n畏途携共远，故室返无由。\n弄果啼时掷，遗䙀葬后收。\n重泉应见母，汝父正多忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢李克贞送盐","author":"刘崧","text":"食淡怜吾病，分盐感子情。\n解苞惊落雪，进饭惜含英。\n远道枫初陨，閒门草屡生。\n艰难愧滋味，幽兴在藜羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遭乱","author":"刘崧","text":"遭乱无完物，还家有病躯。\n夜眠愁枕席，晚食愧盘盂。\n败壁狐狸入，虚檐鸟雀呼。\n犹传征敛急，倚杖一长吁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"食无菜","author":"刘崧","text":"岂有膏粱想，仍无食菜缘。\n馑荒宁绝物，枯旱已经年。\n青忆冰盘送，香怀雪椀传。\n喜闻春意动，荠麦满山田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻赣兵已驻万安","author":"刘崧","text":"自有重滩险，还屯外邑兵。\n江春舟楫便，城晚旆旌明。\n蚁聚方连势，鲸吞竟败盟。\n悠悠岐路叹，万一慰民情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"社日","author":"刘崧","text":"社日那无酒，时危不见春。\n闭门防过卒，烧纸赛田神。\n已叹耕锄废，终伤杀掠频。\n鸡豚久萧索，未敢怨风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重游长兴寺","author":"刘崧","text":"重到长兴寺，青山四面同。\n鸟啼花竹暗，人散户庭空。\n蒲涧千年雨，松门午夜风。\n旧游悲往日，回首各西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭元卿","author":"刘崧","text":"南郡连烽火，连皋掩素扉。\n犹闻避地去，不见渡江归。\n家废藏书散，山深吊客稀。\n同庚几人在，空遣泪沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭韦缵","author":"刘崧","text":"一死嗟谁托，馀生苦自怜。\n已悲形吊影，竟觉夜如年。\n野哭沉山月，新坟閟陇烟。\n杳无重见日，徒有泪潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刘氏西楼小集和吕仲善韵","author":"刘崧","text":"清风缘幔起，疏雨傍城过。\n酒急禁愁得，楼高奈暑何。\n卷书思共隐，学剑愧殊科。\n且可捐秋佩，无劳问晓珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重过梁塘访郭与恭","author":"刘崧","text":"一水鸣苍峡，千峰引白云。\n时危还作客，岁晏却寻君。\n事往诗仍在，愁来酒易醺。\n野桥寒日下，霜雁远初闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题彭伯圻芹寓","author":"刘崧","text":"采采芳芹去，溶溶泮水滨。\n长歌心不厌，偶寓迹非真。\n吾道伤羁旅，乡山落战尘。\n十年戎马际，独立见斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻鹧鸪","author":"刘崧","text":"尔本越中鸟，何年来此啼。\n羽毛浑自媚，言语使人迷。\n隐隐穿松障，萧萧渡竹溪。\n断肠听不得，归路日平西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题刘诚本为子彦弟作山水图","author":"刘崧","text":"画者有远意，寓之山水间。\n野航当晚急，江阁与秋閒。\n嘉树团丹壑，幽花照绿湾。\n何年谢尘鞅，杖策此中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"由雀儿岭入阆川青梁尾 其一","author":"刘崧","text":"历险非吾意，临危信此生。\n一家微命在，百里畏途轻。\n草屋怜蜂聚，松崖愧蚁行。\n喧喧豺虎急，向晚慎前征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"由雀儿岭入阆川青梁尾 其二","author":"刘崧","text":"路折千湾水，天垂四面山。\n野人初问战，过客乍投关。\n地僻烧畬遍，溪深采葛閒。\n时时听鼙鼓，怅望不知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜渡溪水见月忆流江诸友","author":"刘崧","text":"片月出东岭，野禽相应啼。\n归人爱清景，乱月渡平溪。\n草露忽已集，洞霞犹未隮。\n流江向西远，归梦使人迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对月","author":"刘崧","text":"今年十五夜，看月在流江。\n谁遣遗乡邑，犹疑接澒泷。\n水光浮战舰，山翠隐蓬窗。\n倾影那能寂，含悽对酒缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"尝山药","author":"刘崧","text":"谁种山中玉，修圆故自匀。\n野人寻得惯，带雨斸来新。\n味益丹田暖，香凝石髓春。\n商芝亦何事，空负白头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山楼即事","author":"刘崧","text":"楼出青峰上，檐栖碧树端。\n雨窗晨易白，云榻夜多寒。\n微醉时欹枕，閒愁独倚栏。\n纷纷犹战夺，托迹敢求安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄萧翀","author":"刘崧","text":"九十九顿岭，归来又几时。\n时危愁不见，岁晏最相思。\n天远惊鸿断，山空病鹤饥。\n长怀霜月夜，一笛向人吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉次吴县丞兵后见寄韵","author":"刘崧","text":"长愁怜杜子，多病愧相如。\n避地风尘里，还家瘴疠馀。\n春随南国雁，书滞北溟鱼。\n故里劳相问，于今未定居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜晏次王伯衢","author":"刘崧","text":"王氏多才彦，青云玉树林。\n金尊瑶席满，银烛画堂深。\n风雨残年梦，江湖千里心。\n感君情似海，欲醉且停斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]