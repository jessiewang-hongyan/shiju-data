[{"title":"定上人屡约游山不果近承寄示送孙景贤诗未及和答因刘进士仲炯游青原山赋此奉寄 其二","author":"刘崧","text":"送客青原路，思君白下城。\n雨花曾听法，贝叶旧知名。\n学道耽幽趣，忧时累俗情。\n莲峰几百丈，霜月想泉声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿东山下","author":"刘崧","text":"夜宿东山下，人家隔板桥。\n泉声霜下起，雾气月中飘。\n芋子兼皮煮，松枝带节烧。\n老翁年九十，起坐说前朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李掾还吉水","author":"刘崧","text":"霜草马蹄寒，晨趋别上官。\n吏推文牍简，民忆会期宽。\n水浅鱼梁出，沙晴雁碛乾。\n青云冠盖盛，似尔惜才难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答杨公平题具翕堂","author":"刘崧","text":"故里荒芜地，新堂燕鹊群。\n昔人如昨日，此意向谁论。\n樽酒欣时具，歌诗惜夜分。\n雄文兼雅韵，感激愧诸昆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"令公岩送钟庭亨归兴国","author":"刘崧","text":"令公读书处，归去又残冬。\n潭冷鱼依石，岩深鹤护松。\n穿云穷望眼，踏雪记行踪。\n明日平川道，相思隔万峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪上","author":"刘崧","text":"渡溪日已暮，回首见青峰。\n风起岩前树，霞明天际松。\n佳人期未果，幽径偶相逢。\n语语投寒暝，孤村起夕舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游临溪寺和钟学正韵","author":"刘崧","text":"涧束西流水，门临北向山。\n渡桥惊鸟散，扫石爱僧閒。\n雾薄林花紫，春深石笋斑。\n云峰如可问，杖策未须还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"承郭奉奎夜过溪上言北岩杜鹃花盛开手数枝相赠明日赋此为别","author":"刘崧","text":"故人夜相赠，手折杜鹃花。\n掩冉带华月，参差出绛霞。\n来从仙岭路，分赠野人家。\n我有游山兴，因之起叹嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"廖伯容自南溪别余将栖于武山之云峰寺明日寄此","author":"刘崧","text":"子爱云峰寺，幽栖得自便。\n朝吟还对石，夜坐更听泉。\n久住应忘客，无言或近禅。\n时时采药去，长啸白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏旱","author":"刘崧","text":"五月那无雨，今年岂有秋。\n伤时思乏食，失路竟还忧。\n圭璧闻周祀，尪巫笑野谋。\n亦怜生事拙，不见满瓯窭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看雨","author":"刘崧","text":"惨淡连遥岭，萧条入近林。\n随风初作势，度水忽成阴。\n垄穗占新沐，池荷掩旧沈。\n西楼濯冰雪，暂尔豁烦襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽钟谨独先生","author":"刘崧","text":"挥泪过东门，怀哉德义尊。\n新阡哀榇出，旧屋古书存。\n修竹仍深巷，幽花自小园。\n儒林有知己，好在立真言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谷云","author":"刘崧","text":"冉冉复离离，秋云出谷时。\n偶然随雨散，忽谩被风吹。\n岩润龙先觉，林阴鹤未知。\n何人为招隐，吟断小山诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山茶","author":"刘崧","text":"闻说真常观，山茶兀老苍。\n根盘千古盛，干拔五枝长。\n翠羽团秋色，丹砂注夜光。\n神仙谁种此，又见海成桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仙竹","author":"刘崧","text":"坛上竹珊珊，秋风六七竿。\n至今含雨色，长夏拂云寒。\n神女金丝佩，仙翁锦箨冠。\n建标应有待，曾此下青鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石仙","author":"刘崧","text":"仙子何年化，空馀石像存。\n沈沦时已异，坚朴道弥尊。\n云舄飞难去，风裾冷不翻。\n何如致云雨，从此洗乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹","author":"刘崧","text":"千叶鹤翎红，仙姿自不同。\n名传李唐后，根托帝坛中。\n霞佩分王母，金盘送玉童。\n异香留不得，长是逐天风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题溪南幽异图","author":"刘崧","text":"谁写溪南景，幽深隔翠微。\n钓船沙际出，杨柳雨中稀。\n倚竹翻书坐，穿花载酒归。\n故人浑不至，苔色满林扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十九日至二十二日雪作不止客有言是雪十馀年不见者固可喜也因赋五言一律","author":"刘崧","text":"莽莽初横野，涔涔忽满城。\n低迷浑欲暗，空阔固能明。\n积水蛟鼍伏，荒山鸟雀惊。\n十年愁不见，北望正含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中会饮分韵得花字","author":"刘崧","text":"洗盏注晴霞，张灯散暮鸦。\n残年今夕会，远道故人家。\n春入山中树，雪吹天上花。\n当筵有长袖，醉舞看欹斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山矾","author":"刘崧","text":"本自托山谷，年年春暮开。\n野人不爱惜，折送满城来。\n皓雪千枝积，香风十里回。\n故人坟上路，见尔独兴哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡江","author":"刘崧","text":"莽莽出轻艘，纷纷竟渡江。\n天宁残乐土，人欲愤遗邦。\n豺虎方雄斗，蛟龙正怒撞。\n南村愁岌岌，何处望旌幢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兵破江口途趋东原挈妻子入山道次相失复聚","author":"刘崧","text":"仓卒还相失，艰危独后来。\n乱山当日暮，长路入风埃。\n攘攘从谁问，沈沈只自摧。\n逢迎忽惊喜，相顾歘兴哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寻人家至石岭下冲雨入大村夜宿罗坑","author":"刘崧","text":"石岭重攀跻，罗坑及暝栖。\n不辞冲暮雨，政恐踏秋泥。\n亲老愁多病，儿痴睡更啼。\n艰虞戒前路，不敢候鸣鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午憩石鼓坑严复亨寓舍问米过灌塘寻康氏姊","author":"刘崧","text":"书在馀三策，钱空罄一囊。\n问人求食米，随客度山庄。\n影怯飞鸿后，啼惊猛虎旁。\n远寻康氏姊，感激意何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆故庐消息","author":"刘崧","text":"故里何人到，野堂今是非。\n毁伤宁壁立，焚荡恐灰飞。\n书帙从人把，囊琴只谩挥。\n谁怜失巢者，飘散欲何依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋旱井涸致水为劳有浚而得泉者喜而赋诗","author":"刘崧","text":"井涸仍秋旱，徒劳抱瓮人。\n偶缘淘得净，但讶汲伤频。\n欹石盘根古，寒泉积渫新。\n渴心端赖尔，回首飒风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳祠前古松","author":"刘崧","text":"偃蹇何年种，青苍暮色酣。\n半身犹直上，全势欲倾南。\n古壁龙鳞合，空巢鹤影参。\n岁寒终见尔，霜雪老能堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出社下岭望九洲流陂稻田可爱","author":"刘崧","text":"渡岭望平田，人家隐翠烟。\n村墟自鸡犬，风物似神仙。\n晚树依沙立，秋粳带水眠。\n几时驱两犊，投迹此安廛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初游长兴寺","author":"刘崧","text":"一路萦纡入，群峰迤?开。\n树连山路合，溪带石桥回。\n烟火依农屋，云霞隐佛台。\n如何千载下，不见一人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入百记望王岭诸峰","author":"刘崧","text":"何许龙移宅，犹传鹤驻骖。\n山连王子洞，水落圣官潭。\n结屋蟠虚壁，烧畬上翠岚。\n十年厌奔走，吾意托东南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中","author":"刘崧","text":"岂有人知处，白云连上层。\n入深疑遇虎，爱净欲依僧。\n风磴鸣樵斧，岩烟翳佛灯。\n如何江浦上，杀气苦凭陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒲涧奉次长兄子中韵","author":"刘崧","text":"蒲涧来何处，鸣声应谷虚。\n清宜和野饭，翠可织仙裾。\n陇近秋常灌，潭空夜不渔。\n毋令洗尘耳，吾意恋溪居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再游蒲涧与子中子彦题名于涧右之嵌壁因赋诗而归","author":"刘崧","text":"自扫涧边叶，閒通石上泉。\n绿蒲向深处，幽响忽琤然。\n题字扪青壁，长歌入紫烟。\n日长山更静，来此弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观蜜房","author":"刘崧","text":"戴主心无二，趋朝度必三。\n一衙兵卫肃，万鼓战声酣。\n事夥还分济，功成始共甘。\n伊谁失维系，荡荡纵残贪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23905,"sha256":"0e5ded52c96c