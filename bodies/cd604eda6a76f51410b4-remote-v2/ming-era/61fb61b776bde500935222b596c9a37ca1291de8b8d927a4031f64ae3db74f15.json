[{"title":"见梅次前韵 其二","author":"张弼","text":"深入交原沃壤开，层山如浪远萦回。\n昌江鱼扈收虾菜，刺竹人家捣蛤灰。\n呼雨怪禽凌壑去，寻香痴蝶逐风来。\n无端好景沦荒僻，大手何缘入品裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡泸江见梅","author":"张弼","text":"晴风兰棹拍江开，野渡经潮自拟回。\n云意独馀天使馆，春声不上越王台。\n茸茸宿霭千畦稻，点点寒枝一树梅。\n山色无烦障重叠，紫宸翘首碧云隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滩山驿中站闻鸡声","author":"张弼","text":"蕉叶盘餐刺竹房，扶蒥甘自和槟榔。\n无端山馆撩人意，墙外鸡声似故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡昌江","author":"张弼","text":"归渡昌江晓，桃花冬日浓。\n沧溟应不远，野水自朝宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早发吕瑰宿合桥驿","author":"张弼","text":"慈闱寿诞值嘉辰，游子南交万里身。\n过眼莺花长路感，留人歌吹满堂春。\n膝前綵戏能忘远，天上鸿恩甫及申。\n无计奋飞空刺促，迢迢归梦舞衣新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自合桥驿至昌江驿宿","author":"张弼","text":"北堂寿诞贺筵开，南海仙槎惜未回。\n杯泛流霞群拜舞，灯悬华月共楼台。\n隔溪春色还高柳，入座寒香送小梅。\n柰可昌江凌渡处，晓云弥望斗南隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归自昌江宿丕礼夜雨日阴多风次前韵","author":"张弼","text":"市桥江路悄风辰，度岭盘云野鹤身。\n万里怀归当寿日，百年称庆几逢春。\n山光入暮看常好，竹意笼云郁未伸。\n隐轼懵腾惊缩地，不禁山径鹊声频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归途值雨谢迎送官","author":"张弼","text":"归路交山化雨零，瘴烟消尽海峰青。\n云随旌旆龙蛇远，春度郊原草木馨。\n南北皇图原一统，衣冠清淑自三灵。\n迢迢迎送今成别，回首晴霞粲晚汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日道中五首 其一","author":"张弼","text":"东风无便到交南，草绿花香久自沾。\n为问曾经故园未，晓窗书草几抽尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日道中五首 其二","author":"张弼","text":"涉壑盘危趣亦佳，远聆清濑近看花。\n谁知又是春来日，蜂蝶纷纷乱水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日道中五首 其三","author":"张弼","text":"青苗欲秀野花开，蝶翅蛩声遍草莱。\n自是天南霜雪断，交人不识有春来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日道中五首 其四","author":"张弼","text":"苍烟冉冉绿云堆，蝶乱蛩吟花自开。\n无柰天南断霜雪，交人那识有春来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日道中五首","author":"张弼","text":"归路当春日，乘颠复水涯。\n绿云山远近，苍径屋欹斜。\n古树寄生草，寒林不断花。\n东风谁料理，容易度年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行喜晴 其一","author":"张弼","text":"曲磴盘云树杪行，总教来去几长亭。\n东风自与行人便，扫断蛮烟瘴雨腥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行喜晴 其二","author":"张弼","text":"行人行路喜山行，高下山花杂鸟声。\n更转云岩凌绝涧，石泉清思玉琮琤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再宿安博驿","author":"张弼","text":"安博初临献岁春，夜台歌吹是何人。\n重来已是伤陈迹，况复明朝万里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿北峨驿","author":"张弼","text":"十日归轺度北峨，前临关隘喜无多。\n夜来春雨鸣山溜，尽泻驮江入棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至界首关闻后使沈许何三公至","author":"张弼","text":"归心凌界首，别意在山椒。\n疆域交藩尽，风云帝里遥。\n日穿珠影动，春度鸟声娇。\n会遇重来使，悬情正郁陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏报后使三公","author":"张弼","text":"君来路，我归路，路上风光君细数。\n总来十八短长亭，一日一亭君莫苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿日","author":"张弼","text":"江南老母寿，仲子滇南游。\n季复南交使，天涯最尽头。\n三方同一念，异域耿孤愁。\n何日登堂庆，兄供弟勤酬。\n山灵如我?，岐路莫悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"左江联句","author":"张弼","text":"左江晴日溯轻舠，风物撩人兴益豪。\n山好只疑行画里，滩危真觉泛槎高。\n清樽小共掀蓬坐，侧枕频惊举楫号。\n岩集隐猿连晓树，案罗美鹧杂溪毛。\n踏青歌陋闻蛮国，浮白杯香醉峒醪。\n波漾鸭头衣借色，茗翻蟹眼鼎生涛。\n谁云石窟藏银瓮，自爱泉音度玉璈。\n雨酿薄寒襟袖爽，棹回新涨水云劳。\n子长宁尽天涯味，韩老犹焚晷后膏。\n每厌鱼腥过竹栅，生憎鸥迹占蘅皋。\n木棉花发霞欹岸，驮板津虚月满艚。\n学得芦笙童仆喜，联催钵韵鬼神鏖。\n时看落纸行鸦墨，却忆当筵夺绣袍。\n取次算程惊岁月，峥嵘承命幸逢遭。\n虚誇博望星河迥，仍鄙终军节钺叨。\n乡梦直随芳草遍，游踪还纪翠崖牢。\n声传觱篥来空谷，光露干将泣巨鳌。\n沙驿泊迟常列炬，丝桐承夜辄鸣猱。\n悠悠远思弥南极，﨣﨣前驱属右櫜。\n明到京华春正好，紫宸风暖拂旌旄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永淳","author":"张弼","text":"永淳江绕县城流，夜雨潺潺晓不休。\n三十里滩新水涨，随风一泻过横州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠沈方伯","author":"张弼","text":"宦辙重逢忽十年，苍梧春半玉山颠。\n海南江右恩如在，晚景修途操益坚。\n诏自旬宣须柱石，政从宽厚识心田。\n新云弄雨难为别，共对清樽思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹧鸪","author":"张弼","text":"闻名久矣未闻声，空历湖湘数月程。\n应是长鸣人不信，合从草莽自潜形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德庆州奠教谕李经田先生基","author":"张弼","text":"采蘋遥荐太平庄，云拥青螺万古藏。\n独立门墙增感慨，春阴桃李自成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"半仙亭","author":"张弼","text":"海螺环翠半仙亭，惆怅桃花逐雨零。\n一顷绿塘连竹屋，出山源近水常清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西坡为吴别驾赋","author":"张弼","text":"长公仙迹久沈磨，睥睨称雄合共坡。\n何自东西远相让，争墩人愧下风多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南海遇陈时雨绣衣","author":"张弼","text":"别从京国遇天涯，五岭云深岁月赊。\n宦海萍踪能几会，客途尊酒拜来嘉。\n凝霜共仰阳秋笔，犯斗虚乘博望槎。\n有待金门共斟酌，满天清露候重华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清远县荅李元复远送","author":"张弼","text":"春山晴对酒杯浓，迢递同临峡口峰。\n云意漫劳连日态，江流惭照别时容。\n独看风节遐方振，归泛星槎万里逢。\n自是离塘新涨急，可堪回棹浪花重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会监珠池傅太监于广城","author":"张弼","text":"海徼贤劳不计年，徙珠还浦暖生烟。\n空明住近三山累，端穆当怀万里天。\n蜃气侵肌应自惜，黎风杂郡祗谁怜。\n羊城邂逅当春雨，惊落风云饭颗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒南安东海府君遗爱祠","author":"张弼","text":"安南归路自南安，旧设先祠得拜观。\n岂有帡幪常在郡，何缘俎豆不烦官。\n庭前树色青青久，城上春云点点残。\n相对野翁伤感处，一江流泪正汍澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯东山寺","author":"张弼","text":"歌舞东山落日斜，碧纱常护旧龙蛇。\n廿年重到惊陈迹，感慨春云万里赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯别金莲寺壁间多先翁草墨","author":"张弼","text":"金莲山寺旧招提，指点龙蛇落殿西。\n难拟山阴□故事，双鹅留别更留题。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过小溪驿","author":"张弼","text":"小溪江水急于弦，老吏津头夜候船。\n二十五年今复到，野塘风暖早春天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九牛驿遣送者归","author":"张弼","text":"章江北注九牛深，柳色依依送远心。\n两岸莺声啼不尽，野云含雨日西沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和邓太守梦游赤壁韵","author":"张弼","text":"赤壁清风一叶舟，仙才词调可同游。\n梦回不必论今古，江逐箫声日夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵题五老图","author":"张弼","text":"痴翁笔意老于松，更为仙翁貌老容。\n庾岭披图惊一见，匡庐人醉倚高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惶恐滩","author":"张弼","text":"异域经年到，孤舟万里还。\n壮怀看入鬓，惶恐过前滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万安县访刘咸粟绣衣","author":"张弼","text":"君家世济美，我家世同科。\n岂真江邑小，并驾自无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"容斋为南安邓太守赋","author":"张弼","text":"不挍真颜子，忘情岂老庄。\n休休方寸地，云路几汪洋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韶州道中忆友","author":"张弼","text":"龙州至韶州，两见日明昼。\n自馀两月来，千里如甑覆。\n岂宜蒲柳姿，禦此阴霾候。\n我行庾岭深，君渡洞庭久。\n相思远茫茫，魂梦忽相守。\n无因一寄音，飞鸿□寒湫。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吉安郡赴范别驾宴","author":"张弼","text":"尽君一夕欢，滞我三百里。\n风波仕路间，相知亦能几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆白鹇寄鲁内翰","author":"张弼","text":"野人乞字笼鹇送，我为求诗转赠君。\n相忆前来云水阔，对鹇佳句久无闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画扇寄溧阳史巽仲年丈 其一","author":"张弼","text":"花落江城寂寂春，柴扉深锁碧山云。\n溪头有棹閒如许，忙杀斜阳欲渡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画扇寄溧阳史巽仲年丈 其二","author":"张弼","text":"鸭子滩头阁小亭，翠峦飞舞碧江横。\n何当慰满天涯望，镇日携壶独枕肱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画扇寄溧阳史巽仲年丈 其三","author":"张弼","text":"西湖游棹十年孤，独领春光省画图。\n山色岧峣波潋滟，晓窗犹似梦回初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画扇寄溧阳史巽仲年丈 其四","author":"张弼","text":"一舟还共一身轻，徙倚江山万里情。\n醉里不知春已过，落花满地杜鹃声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"□李文昭不遇","author":"张弼","text":"桃径参差曲到门，半湾流水欲成村。\n主人何处空诗案，花扑晴帘护暖云。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归至姑苏同会稽陶世和年兄晚酌","author":"张弼","text":"夜泊苏台月，微茫晓渡湖。\n野云将雨合，风力著帆粗。\n惊喜家山近，翻思客路孤。\n小铛温竹叶，相对谩歌呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南还昆山顾殿元过小亭次韵","author":"张弼","text":"观生亭上望，漠漠水村遥。\n日转树阴合，风轻草色夭。\n宦情从此薄，诗兴坐来饶。\n舞罢阶前鹤，长鸣向碧霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南还宋工部可葵顾学士东江沈大参东老宋大参樗庵唐藩幕饬轩过访","author":"张弼","text":"出还自笑迹非真，虚误平生未了因。\n松偃双青长在眼，燕调新语解留人。\n清香为致蒲樽酒，和气能回草阁春。\n万里归来惭奉使，漫携诗卷谢交亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读书乐","author":"李贽","text":"天生龙湖，以待卓吾。\n天生卓吾，乃在龙湖。\n龙湖卓吾，其乐何如。\n四时读书，不知其余。\n读书伊何，会我者多。\n一与心会，自笑自歌。\n歌吟不已，继以呼呵。\n恸哭呼呵，涕泗滂沱。\n歌匪无因，书中有人。\n我观其人，实获我心。\n哭匪无因，空潭无人。\n未见其人，实劳我心。\n弃置莫读，束之高屋。\n怡性养神，辍歌送哭。\n何必读书，然后为乐。\n乍闻此言，若悯不谷。\n束书不观，吾何以欢。\n怡性养神，正在此间。\n世界何窄，方册何宽。\n千圣万贤，与公何冤。\n有身无家，有首无发。\n死者是身，朽者是骨。\n此独不朽，愿与偕殁。\n倚啸丛中，声震林鹘。\n歌哭相从，其乐无穷。\n寸阴可惜，曷敢从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"富莫富于常知足","author":"李贽","text":"富莫富于常知足，贵莫贵于能脱俗。\n贫莫贫于无见识，贱莫贱于无骨力。\n身无一贤曰穷，朋来四方曰达。\n百岁荣华曰夭，万世永赖曰寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同袁中夫看菊寄谢主人","author":"李贽","text":"去年花比今年蚤，今年人比去年老。\n尽道人老不如旧，谁信旧人老亦好。\n秋菊总开旧岁花，人今但把新人夸。\n不见旧日龙山帽，至今犹共说孟嘉。\n去年我犹在阴山，今年尔复在江南。\n傍人错指前身是，一是文殊一瞿昙。\n花开于我复何有，人世那堪逢重九。\n举头望见钟山高，出门便欲跨牛首。\n袁生袁生携我手，欲往何之仍掣肘。\n虽有谢公墩，朝朝长在门。\n虽有阶前塔，高高未出云。\n褰裳缓步且相随，一任秋光更设施。\n天生我辈必有奇，感加雅意来相期。\n入门秋色上高堂，烹茶为具呼儿郎。\n欢来不用登高去，扑鼻迎风尊酒香。\n子美空吟白发诗，渊明采采亦徒疲。\n何如今日逢故知，菊花共看未开时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日自讼谢主翁","author":"李贽","text":"明朝七十一，今朝是七十。\n长而无述焉，既老复何益。\n虽有读书乐，患失又患得。\n患失是伊何，去日已蹉跎。\n患得是伊何，来日苦无多。\n聪明虽不逮，精神未有害。\n笔秃锋铓少，指柔龙蛇在。\n宛然一书生，可笑亦可爱。\n且将未死身，暂作不死人。\n所幸我刘友，供馈不停手。\n从者五七人，素饱为日久。\n如此贤主人，何愁天数九。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朔风谣","author":"李贽","text":"南来北去何时了，为利为名无了时。\n为利为名满世间，南来北去正相宜。\n朔风三月衣裳单，塞上行人忍涷难。\n好笑山中观静者，无端绝寒受风寒。\n谓余为利不知余，谓渠为名岂识渠。\n非名非利一事无，奔走道路胡为乎。\n试问长者真良图，我愿与世名利徒，同歌帝力乐康衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题绣佛精舍","author":"李贽","text":"闻说澹然此日生，澹然此日却为僧。\n僧宝世间犹时有，佛宝今看绣佛灯。\n可笑成男月上女，大惊小怪称奇事。\n陡然不见舍利佛，男身复隐知谁是。\n我劝世人莫浪猜，绣佛精舍是天台。\n天欲散花愁汝着，龙女成佛今又来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十八罗汉漂海偈","author":"李贽","text":"十八罗汉漂海，第一胖汉利害。\n失脚踏倒须弥，抛散酒肉布袋。\n犹然嗔怪同行，要吃诸人四大。\n咄，天无底地无盖，好个极乐世界。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十八罗汉游戏偈","author":"李贽","text":"不去看经念偈，却来神通游戏。\n自夸能杀怨贼，好意翻成恶意。\n咦，南无阿弥陀佛，春夏秋冬四季。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭耿子庸 其一","author":"李贽","text":"楚国有一士，胸中无一字。\n令人读汉书，便道赖有此。\n盖世聪明者，非君竟谁与。\n所以罗盱江，平生独推许。\n行年五十一，今朝真死矣。\n君生良不虚，君死何曾死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭耿子庸 其二","author":"李贽","text":"我是君之友，君是我之师。\n我年长于君，视君是先知。\n君言吾少也，如梦亦如痴。\n去去学神仙，中道复弃之。\n归来山中坐，静极心自怡。\n大事苟未明，兀坐空尔为。\n行行还出门，逝者在于斯。\n反照未生前，我心不动移。\n仰天一长啸，兹事何太奇。\n从此一声雷，平地任所施。\n开口向人难，谁是心相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭耿子庸 其三","author":"李贽","text":"太真终日语，东方容易谈。\n本是闽越人，来此共闲闲。\n君子有德音，听之使人惭。\n白门追随后，万里走滇南。\n移家恨已满，敢曰青于蓝。\n志士苦妆饰，世儒乐苟安。\n谓君未免俗，令人坐长叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭耿子庸 其四","author":"李贽","text":"君心未易知，吾言何恻恻。\n太言北海若，小言西河伯。\n缓言微风入，疾言养叔射。\n粗言杂俚语，无不可思绎。\n和光混俗者，见之但争席。\n浩气满乾坤，收敛无遗迹。\n时来一鼓琴，与君共晨夕。\n已矣莫我知，虽生亦何益。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿吴门 其一","author":"李贽","text":"秋深风落木，清水半池荷。\n驱马向何去，吴门客子多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿吴门 其二","author":"李贽","text":"屋有图书润，庭无秋菊鲜。\n应知彭泽令，一夜不曾眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]