[{"title":"和诸父老秋夜徐步诗","author":"陶益","text":"高秋云物喜相迎，歌板声随夜月明。\n枌社近除劳扰俗，柳营遥仗奋扬兵。\n篱边静菊撩幽兴，沙上眠鸥动野盟。\n达曙宴游人尽乐，隔林村犬不曾惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠诸父老","author":"陶益","text":"辱索群章后，虚延两月多。\n自疑诗作祟，谁遣字为魔。\n见说悲城市，悬知恋薜萝。\n仓惶此相送，何日更能歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅郁林州志有感","author":"陶益","text":"三复春秋义，遍求史氏真。\n浮名惭小子，实录叹先人。\n瑞水涵虚碧，容山吐曜新。\n按图怀远道，涕泗欲沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访油溪诗社次津庵黄少府韵","author":"陶益","text":"油溪结社白蘋秋，舴艋牵蘋溪上游。\n向夕倚篷推李郭，崇朝临径觅羊求。\n风波不入南归梦，鸿雁宁消北望忧。\n郢作孰能惭授简，独看渔父在江头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄少府","author":"陶益","text":"烟钓汀栖鹤梦遥，频年虚负小山招。\n祇嫌叔度稀相见，鄙吝而今转不消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋成对客短述","author":"陶益","text":"平生性僻苦难任，梦里徒吞五色禽。\n作赋非才惭欲死，长杨奚翅万黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别友人","author":"陶益","text":"出饯日将午，长途秋正清。\n山城临水见，野鸟向人鸣。\n别泪双行下，去帆五两轻。\n赠言吾独拙，难悉故交情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途次感秋","author":"陶益","text":"涛声齐碧落，曙色满沧江。\n鹰隼云间并，凫鹥水上双。\n行踪犹未定，褊性已难降。\n欲缉悲秋赋，飘零就客窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送客还吴二首 其一","author":"陶益","text":"断送意悬悬，吴山楚水连。\n飞仙曾见否，故老岂虚传。\n竹径清鸣佩，苔阶绿结钱。\n君归多好事，新荠荐芳筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送客还吴二首 其二","author":"陶益","text":"仆御促离筵，情殷添酒钱。\n春来人最可，此去事堪传。\n善画凌摩诘，能诗逼惠连。\n相思难尽处，江月夜窗悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠东山寺圆觉上人","author":"陶益","text":"阴深谁遁迹，寂历自为家。\n饭钵供灵液，蔬盘具异瓜。\n鹤翻松顶露，天落佛前花。\n静夜焚香炷，东林月未斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东方有一士","author":"陶益","text":"东方一士离人群，身不可见名可闻。\n使君地主休相迫，懒结鹑衣祇卧云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长饥至于老","author":"陶益","text":"长饥至老自堪贫，白屋青山旧卜邻。\n不信秦楼歌舞地，年年改换意中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸡鸣歌对宾御作","author":"陶益","text":"汝南晨鸡叫残月，连城刁斗声已没。\n千门万户逐关开，秣马膏车临路歇。\n主人但知留为好，仆夫勿谓行当早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过乡社戏和壁上韵","author":"陶益","text":"出郭遥闻下里歌，连年凋敝实伊何。\n于今戍垒无烽火，又厌秋成乐事多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观朱使君家乘题赠二首 其一","author":"陶益","text":"仙根爰自紫阳公，奕叶森森向浙东。\n越水霁涵云谷月，嵩台光接考亭风。\n清时乔木人皆仰，继世名家孰与同。\n征盖下临应露冕，九重端见渥恩隆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观朱使君家乘题赠二首 其二","author":"陶益","text":"射堂淑气满阶除，散入川原物自舒。\n野鹿并驯随远旆，彩云相映迓高车。\n家声茂著千年在，世谱弘开万帙馀。\n复羡使君才最睿，偏劳青史细行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"先人琴砖从修宅得之感而赋此","author":"陶益","text":"吾亲难得见，故物易湮沉。\n出土犹疑璧，挥锄不视金。\n焦桐寻雅约，流水待知音。\n珍重归堂上，缅焉思独深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒宴乐","author":"陶益","text":"骤风铁马响不断，吐烟宝鸭香仍满。\n群英四座鹔鹴裘，飞觞举白哪能缓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蟋蟀吟","author":"陶益","text":"唧唧愁闻床下急，飒飒又从窗外入。\n御寒无备欲何之，谋醉未能空独立。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酒后偶成","author":"陶益","text":"邻曲相邀入夜过，南风不竞孰能歌。\n醉深独据胡床月，懒向人前说话多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮冬病起对菊","author":"陶益","text":"刚风吹腊拂高台，落帽参军昔不来。\n断酒却嫌犹是病，孰令馀菊尽情开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"所思","author":"陶益","text":"有台可登，有酒可增。\n云胡不乐，远我良朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人入楚受室","author":"陶益","text":"粤岭剑光动，湘江春色浓。\n别时聊赠雁，到日即乘龙。\n路绕心千里，书回意万重。\n趋庭知有算，早晚得欣逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"想像歌为燕使","author":"陶益","text":"舟耶车耶，同旅食者谁耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪侠客夜饮有赠","author":"陶益","text":"月下长裙曳，樽前倒屣迎。\n风尘方满眼，南北转关情。\n结客无全论，谈兵剑有声。\n鸡鸣递鱼钥，起舞欲专征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹦鹉辞","author":"陶益","text":"身如杨白花，相去落人家。\n心似海断石，由来那改易。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花曲","author":"陶益","text":"寒梅破腊花争妍，香风偏惹小楼前。\n主人袖手推窗看，疏影横斜月半圆。\n笛声何处梅花落，武陵关山愁寂寞。\n对花送月抱朱弦，白雪清吟未忍眠。\n含情欲寄陇头信，驿使不来倍黯然。\n长恨梅花苦相忆，不遣寒梅近窗植。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自遣","author":"陶益","text":"山中懒学惟耽枕，云里閒吟每闭关。\n隐约较来犹有碍，姓名奚自越云山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐十九部尉二首 其一","author":"陶益","text":"征人牵马促扬鞭，弦奏倾樽兴杳然。\n目送欲随心送远，生憎榕叶渡头烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐十九部尉二首 其二","author":"陶益","text":"告别匆匆剑气雄，骊歌遥放海门东。\n不知仙尉家何处，香火情生虑转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烟雨纳闷思寄纪旭仁行台","author":"陶益","text":"烟雨暗储胥，归人恋弊庐。\n薄游非所愿，端坐欲何如。\n妄拟閒情赋，讹抄定性书。\n信州有词客，离索正愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"睹唐十州翰墨追思乃兄定江太守","author":"陶益","text":"出守多年胡独逝，为郎数札旧相贻。\n交情不逐春云散，梦想空随晓角悲。\n凤起碧霄曾比翼，桂明金屋已连枝。\n更传爰弟词章丽，此日惊看后汝期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"念游罗浮","author":"陶益","text":"罗浮东望望空频，近寄黄龙梦里身。\n烟雨莫来迷极浦，铁桥客有未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静夜偶作二首 其一","author":"陶益","text":"灯光悬榻步虚亭，自理瑶琴酒既醒。\n徙倚冒寒瞻斗柄，长林争弄露华青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静夜偶作二首 其二","author":"陶益","text":"客散徘徊夜更幽，房栊月出在楼头。\n胡奴睡美呼不得，隔竹茶烟手自抽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵送别兼忆所知","author":"陶益","text":"惜别维舟酌乱巡，石鲸夜吼渺无津。\n兵戈满月人千里，鼓角孤城月一轮。\n云绕雁书归太华，花迎鱼佩入宜春。\n从今识得相思苦，不独多吟白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"垓下歌","author":"陶益","text":"有客有客来江东，说剑论交志气雄。\n千杯入手快意尽，不惜万死求建功。\n杀青标名非所怿，但愿将坛高百尺。\n简书亲承顾重荣，金印煌煌照日赤。\n能令四海一时清，信是男儿那虚生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜四时歌四首 其一","author":"陶益","text":"清晨步远庄，桑露湿衣裳。\n共道眠蚕起，寻枝摘叶忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜四时歌四首 其二","author":"陶益","text":"采采入江围，莲船掩夕晖。\n祇愁风雨恶，不得傍潮归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜四时歌四首 其三","author":"陶益","text":"砧声起碧空，河里浣花红。\n照影入秋水，香囊裙带中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜四时歌四首 其四","author":"陶益","text":"晓雪正飕飕，畏寒懒下楼。\n何当仍盥栉，翠羽上貂裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独坐","author":"陶益","text":"三竿红日坐衡茅，顿有南山恋旧交。\n窗静不嫌蝇击纸，亭虚还许雀争巢。\n游丝远逐炉烟杳，滴露频研砚墨胶。\n寂寂寥寥何所似，玄真愧见少人嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆游普光寺次枣冈姚寅丈所寄韵","author":"陶益","text":"寺顶光摇倚碧霄，曾逢仙侣坐相邀。\n雕台抱日自突兀，宝地堆云何岧峣。\n草色欲纫湘水佩，松声疑弄浙江潮。\n莫言一别空追忆，命驾寻僧兴未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题希夷观姚韵","author":"陶益","text":"坠驴仙客爱烟霞，此是烟霞别一家。\n鼎在金坛青草没，书留玉架白云遮。\n椿芽树下舂菰米，石耳岩前煮雪茶。\n解道华阳牢?处，有莲子叶自能花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠杯流僧 其一","author":"陶益","text":"云游佛子常默然，难究何从复何极。\n但言了了即欲行，本来面目信能识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠杯流僧 其二","author":"陶益","text":"倏然乘风不可攀，渺渺浮于湖海间。\n他年五岳如遍览，石髓延尔住罗山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和西樵道中作二首 其一","author":"陶益","text":"四峰盘结宰相园，松隐楼台竹隐垣。\n小歇翳门斜石径，青天白日雨声繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和西樵道中作二首 其二","author":"陶益","text":"杖拄樵云步步高，东风吹绿旧庭皋。\n竹枝声在双鱼岭，谁采茶花不惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹤峰","author":"陶益","text":"石坂霞流逼太清，瑶台长自护题名。\n羽衣道士游何处，锡响峰前白鹿惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫姑峰","author":"陶益","text":"霓裳翠黛向春风，斗影晴娇岁岁同。\n仙子不来环佩冷，婵娟长伴水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访郑隐君不遇二首 其一","author":"陶益","text":"起病追寻白社前，清斋云树故依然。\n巾箱面壁茶瓶歇，自拨无弦对暮天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访郑隐君不遇二首 其二","author":"陶益","text":"高人晓出未曾还，石竹菖蒲自作閒。\n安得云函开玉检，即携三绝候重关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁居得故人书","author":"陶益","text":"割席何多日，分春又一年。\n迁莺声竞巧，五柳色争妍。\n逦迤深山麓，栖迟小洞天。\n书来劳款密，同病酷相连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬申闰二月对雨","author":"陶益","text":"楼前晓望雨如丝，莽莽天涯感旧诗。\n秦苑雾烟迷野径，汉城钟鼓漏江湄。\n群飞水鸟心偏逐，短缀藤蓑手自持。\n田父到来欢对语，好春从闰不妨迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代简约诸丈复象冈书院","author":"陶益","text":"负笈遥思三十年，趋陪踪迹已茫然。\n青山一别长为客，白发重逢尽是仙。\n入望晴云团旧帙，唤愁春草藉虚筵。\n俗围破后还谁健，藜杖篮舆愿独先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食同豫章邓徵君郊行","author":"陶益","text":"晨舆策东郭，鸡声开鱼钥。\n旧火断村烟，野桥阴漠漠。\n劳者多渴饥，斗酒无由酌。\n行行至斯丘，松楸惊唳鹤。\n缅想介推贤，泉台不可作。\n黾勉蹑樵踪，咨嗟怀更恶。\n矫首数峰尖，揽衣穿林薄。\n浮云迷远天，瀑水沉幽壑。\n山果掷猿猴，水魅潜相谑。\n日夕赋归来，清辞慰寂寞。\n上根宿智人，予兹欣有托。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卧病和社中志喜诗","author":"陶益","text":"春来苦旱百忧并，伏枕犹增感物清。\n近得田畴好消息，小池疏雨白莲生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别樵叟","author":"陶益","text":"采药荒原抚断碑，偶从樵叟坐移时。\n别来正想难寻处，岐路西风乱鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郁林乡亲关少宰取道还家二首 其一","author":"陶益","text":"满城追饯出江浔，一水通潮向郁林。\n北望未收游子泪，西行偏动故乡心。\n琴尊雅澹宜轻棹，云树稀微隔远岑。\n与报吾宗各努力，刺桐花发正相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郁林乡亲关少宰取道还家二首 其二","author":"陶益","text":"解缆江门未及秋，凉风先送木兰舟。\n旆旌晚曳苍梧路，冠剑晴辉绿水洲。\n杳杳停云生远思，青青蔓草结离愁。\n悬知此后南来雁，繫足应多说壮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与友人夜话次韵","author":"陶益","text":"前春伤一别，溅泪背花吟。\n此夕幸相见，开樽邀月斟。\n桑麻新事业，榆柳旧园林。\n世路风尘隔，双鸣何处砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"越堠二首 其一","author":"陶益","text":"驿程临堠堠临溪，九曲风烟迥不迷。\n过至石桥题柱地，浮云暝鸟隔城低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"越堠二首 其二","author":"陶益","text":"厚貌亭亭向远冿，连天芳草没缁尘。\n五噫一去关山暮，多少王孙认不真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发饯关少宰暮雨谩述以勉之","author":"陶益","text":"平明南望古层楼，楼外潮生送逆舟。\n去路芰荷临上客，离筵箫管泛中流。\n云山似黛晴偏出，江雨如丝暮未收。\n长孺病多须强饭，莫言吾道付沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉和王少龄风雨叙怀之作","author":"陶益","text":"曾将兰佩别金陵，此际相看意气增。\n展席定期千日酒，论交翻忆十年灯。\n空城暮雨钟声湿，卒岁寒风树色凝。\n庾信江南哀不浅，独疑萧瑟未应凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题华池精舍","author":"陶益","text":"池绕椒邱曲，书声振空谷。\n流澌烟雨深，洗砚不成绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小睡","author":"陶益","text":"方书倦阅废长篇，却扫眠云只块然。\n最恼残阳不相量，穿帘还到石床边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禅房暮雨怀许元一二首 其一","author":"陶益","text":"萧寺侨居夕启扉，佛前灯燄远微微。\n桄榔叶暗黄梅雨，苦楝寒生客未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禅房暮雨怀许元一二首 其二","author":"陶益","text":"朝随清梦忆中条，暮倚东林倍寂寥。\n欲寄贤哉旧元度，可堪听雨滴芭蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江门饯别","author":"陶益","text":"有客西归载酒从，离杯一掷恨重重。\n帆飞影尽沧江破，水色遥连若简峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思逋逖黄丈人","author":"陶益","text":"脩篁台榭俯通津，幽轧西归别梦频。\n惆怅倚阑文酒地，月痕还待旧时人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]