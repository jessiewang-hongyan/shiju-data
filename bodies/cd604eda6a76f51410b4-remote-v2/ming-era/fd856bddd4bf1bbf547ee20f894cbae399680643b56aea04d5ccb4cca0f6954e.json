pointer":18617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题朱光禄园中杂景十首 其十 快阁","author":"胡应麟","text":"中天搆层台，登临何快哉。\n披襟一长啸，万里雄风来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其一 樵","author":"胡应麟","text":"半亩疏烟合，危峰落照含。\n苍茫白云里，有路入终南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其二 耕","author":"胡应麟","text":"禾黍满前村，桑麻自成邑。\n千古桃花源，秦人馀古迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其三 牧","author":"胡应麟","text":"平野何苍苍，空林动寒影。\n扣角晚归来，斜阳堕西岭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其四 渔","author":"胡应麟","text":"隔岸远山色，苍茫生暮愁。\n孤舟烟雨际，独占楚江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题九华精舍册为颙上人","author":"胡应麟","text":"五岳行踪僻，三山去路遐。\n何如北窗外，坐卧九莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张伯起幼予邀集别墅观白公石戏赠","author":"胡应麟","text":"峥嵘十尺幽，谁辨白公留。\n试唤香山丈，时时解点头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伯起园池中鸂鶒数十头甚驯扰戏赠二首 其一","author":"胡应麟","text":"暂去三冬候，重来六月中。\n何如陇山翼，空忆主人翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伯起园池中鸂鶒数十头甚驯扰戏赠二首 其二","author":"胡应麟","text":"为笑支公鹤，凌云杳莫攀。\n羡他池上翼，飞去复飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"憩陈从训湘竹榻戏题","author":"胡应麟","text":"大梦全忘日，清音半杂云。\n蘧然修竹里，恍忽下湘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲老杜","author":"胡应麟","text":"笑杀杜陵狂，题诗欲断肠。\n宁知谪仙子，捧研在沉香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余既赋瞻堂十景矣而意有未尽复三绝句写之 其一 古柏","author":"胡应麟","text":"翠盖何亭亭，苍虬舞天半。\n恍忽真人游，金支夜璀璨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余既赋瞻堂十景矣而意有未尽复三绝句写之 其二 岩泉","autho