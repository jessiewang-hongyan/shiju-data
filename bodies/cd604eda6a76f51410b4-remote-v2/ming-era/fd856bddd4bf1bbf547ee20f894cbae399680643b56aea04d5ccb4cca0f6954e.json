:"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题大隐园芭蕉二首 其二","author":"胡应麟","text":"六翮何飞扬，含苞翳深树。\n朝来觅羽人，共跨青鸾去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程氏息园三咏 其一 绣佛斋","author":"胡应麟","text":"萧然丈室中，焚香自朝暮。\n乍夜文殊过，窗前遍甘露。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程氏息园三咏 其二 挥麈堂","author":"胡应麟","text":"盱衡长史锋，缓颊中军笔。\n门外真长来，气压孙安国。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程氏息园三咏 其三 卧云馆","author":"胡应麟","text":"愁看巫峡云，懒醉罗浮月。\n静夜楚天遥，黄陵秋万叠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渔樵耕牧图四首 其一","author":"胡应麟","text":"持竿俯碧流，莫学蟠溪客。\n白首向岐周，抛纶事西伯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渔樵耕牧图四首 其二","author":"胡应麟","text":"观棋坐斧柯，四面青山色。\n回首一千年，桃花烂春碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe