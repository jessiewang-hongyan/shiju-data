[{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十四","author":"孙蕡","text":"故人肥马衣轻裘，意气扬扬得自由。\n林下雨馀苔径滑，免劳相过碧山幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十五","author":"孙蕡","text":"多才宋玉久能诗，误对清秋景物悲。\n湛湛长江枫树底，扁舟正可学鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十六","author":"孙蕡","text":"最爱佯狂阮嗣宗，秋怀当日赋偏工。\n酣歌裸袒青林下，晚岁心期与尔同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十七","author":"孙蕡","text":"容得萧闲亦已多，敢论官绶与渔蓑。\n东流逝水西流日，百岁只消如此过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十八","author":"孙蕡","text":"雨浥琪花落满床，寂无人到读书房。\n闲中不觉青春过，静里方知白日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其四十九","author":"孙蕡","text":"呼龙种术岂无经，瘗鹤藏书亦有铭。\n独对梅花写遗恨，招魂未续楚骚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十","author":"孙蕡","text":"露气横山夕未晞，古松枝冷鹤声迟。\n东林日出西溪白，正是仙翁睡熟时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十一","author":"孙蕡","text":"欲铸钟期未买金，断丝寒縆案头琴。\n虚堂月底弹清曲，别鹤离鸾自赏音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十二","author":"孙蕡","text":"笑杀仙源避世翁，洞门犹与世人通。\n临流莫种桃花树，惹得春来着处红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十三","author":"孙蕡","text":"一自衰翁惹世哗，川原锦树敛红霞。\n关门不倩烟霞锁，却向春风怨物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十四","author":"孙蕡","text":"笑杀山阴王子猷，凌兢雪夜泛扁舟。\n地炉满着松明火，芋栗香中酒一瓯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十五","author":"孙蕡","text":"梅花不解十分清，香影撩人说姓名。\n林壑未忘居鼎鼐，老枝留子待调羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十六","author":"孙蕡","text":"山巅幽绝人稀到，柑子阴凉客屡过。\n不见晚来倾白堕，小园当奈月明何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十七","author":"孙蕡","text":"幽幽绿树团华盖，聒聒流泉奏玉琴。\n不必画堂丝与竹，自然山水有清音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十八","author":"孙蕡","text":"黄菊花开贫不厌，茅柴酒熟醉相呼。\n平生最爱陶彭泽，风味全然似老夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其五十九","author":"孙蕡","text":"柳塘昨夜雨声急，早起春水欲平桥。\n放教汀草芊绵绿，添着林花婀娜娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十","author":"孙蕡","text":"春酒独酌不成醉，可怜溪上百花开。\n花前几日南风紧，门外今朝好客来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十一","author":"孙蕡","text":"如花女儿春柳腰，高歌自驾木兰桡。\n弯弯才见初生月，隐隐斜明第四桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十二","author":"孙蕡","text":"邻屋白酒近初熟，老子尽日为花忙。\n将随粉蝶联翩舞，欲趁游蜂上下狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十三","author":"孙蕡","text":"不觉门外春已过，只说饮酒日豪吟。\n林花尽褪娟娟色，涧竹都成密密阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十四","author":"孙蕡","text":"初开草堂三五日，池上鸥鹭日频来。\n桃花枝嫩未堪折，杨柳阴疏还更栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十五","author":"孙蕡","text":"江上好景莫虚度，屋边乱红今已深。\n不是春风相勾引，道人争看日携琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十六","author":"孙蕡","text":"柏子香消昼景迟，坐调元气学希夷。\n旁人那解玄中意，文火温温只自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十七","author":"孙蕡","text":"半世为儒好自轻，狂歌浪谑斗诗声。\n内庭消尽还丹火，传得江湖说姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十八","author":"孙蕡","text":"自入珠宫捧玉宸，别招猿鹤作新邻。\n空林寂静无来客，千载丹枫作老人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其六十九","author":"孙蕡","text":"尘缘静尽觉神清，对月虚堂炼鹤形。\n采得石楠花上露，研朱自点石台经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其七十","author":"孙蕡","text":"羽步天坛礼帝居，星文拱北似连珠。\n寒云不锁丹砂井，一夜虹光彻太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其七十一","author":"孙蕡","text":"炼得梅花白雪颜，关元静夜浴金丹。\n呼龙起种春田玉，白日山精倚树看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其七十二","author":"孙蕡","text":"蒲团静坐思窈冥，清昼只诵大洞经。\n碧坛玄鹤忽飞起，琪花乱落风泠泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其七十三","author":"孙蕡","text":"天台二月风景新，石桥流水起龙鳞。\n美人相约看花去，云暖洞房仙帐春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居杂咏七十四首，自洪武十一年平原还家作也 其七十四","author":"孙蕡","text":"丹成八极恣神游，蕊阙风随鹤骑秋。\n上苑看花犹一梦，五云回首帝王州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闺思四首 其一","author":"孙蕡","text":"天上嫦娥也可怜，广寒宫里夜孤眠。\n早知人世相思苦，不若移居桂树边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闺思四首 其三","author":"孙蕡","text":"壁上斜明翡翠屏，水花零落点秋萤。\n夜阑院院垂金锁，独立苍苔望帝星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闺思四首 其四","author":"孙蕡","text":"疏棂铁马乱风飘，火冷金凫百和销。\n怪底芙蓉清漏永，不知何事苦迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其一","author":"孙蕡","text":"忆初痴小嫁君时，只道长年不暂离。\n鸳被未寒挥别泪，愁来心事悄谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二","author":"孙蕡","text":"都门不去亦何妨，行色匆匆有底忙。\n欲向碧桃花树底，牵回白马紫游缰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三","author":"孙蕡","text":"别来初种小桃花，艳蕊今成满树霞。\n辛苦远游成底事，半生赢得负韶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四","author":"孙蕡","text":"小园蝴蝶太愁侬，作对双飞趁晓风。\n已逐黄蜂过邻屋，还随花片入帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其五","author":"孙蕡","text":"不恨韶光似水流，绿池景色自生愁。\n门前几树垂杨柳，日日对啼黄栗留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其六","author":"孙蕡","text":"一段春愁未易裁，百劳飞去燕飞来。\n房栊半掩东厢里，几度山樱落复开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其七","author":"孙蕡","text":"家住长干白下间，黄头奴子识花颜。\n欲趁郎船看明月，寒潮惟到小孤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其八","author":"孙蕡","text":"青年几许谩狂游，一种相思两地愁。\n早晚郎船发扬子，相迎不惮下瓜州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其九","author":"孙蕡","text":"欲向东风诉别因，四时原自不伤春。\n薰笼靠着交疏里，婀娜浓花恼杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十","author":"孙蕡","text":"新烧铅粉作春红，病扫双蛾淡复浓。\n宫样云鬟巧妆束，不知愁里为谁容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十一","author":"孙蕡","text":"怨杀联翩白马蹄，远驰夫婿路东西。\n归来系在垂杨下，踏破春风锦帐泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十二","author":"孙蕡","text":"寄语多情燕与莺，莫劳花底弄春声。\n千吟万啭知何益，空使寒闺梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十三","author":"孙蕡","text":"阿玉双成奉紫姑，自拈香炷礼仙凫。\n郎骑白马归来日，得及庭花未落无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十四","author":"孙蕡","text":"恼杀春山怨子规，风前雨里几凄凄。\n如何只绕深闺树，不向游人醉处啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十六","author":"孙蕡","text":"睡到黄昏坐到明，只缘君去没心情。\n常时欲寄平安字，及至人行写未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十七","author":"孙蕡","text":"别眼愁容片地看，任他尘扑镜中鸾。\n腰肢不学昭阳舞，那作罗衣日日宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十八","author":"孙蕡","text":"生儿不合住京华，绮陌香衢见百花。\n云鬓绾成村妇样，只教夫婿学农家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其十九","author":"孙蕡","text":"翠竹阴中栖凤凰，绿萍深处浴鸳鸯。\n迢迢万里巴江水，比妾春愁分外长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十","author":"孙蕡","text":"故国园林玉树新，路旁休恋野花春。\n寻常世上痴儿女，只重黄金不重人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十一","author":"孙蕡","text":"仙母蟠龙隐玉台，合欢罗带下床开。\n深房内阁无人到，怎么春风蓦地来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十二","author":"孙蕡","text":"舞女歌儿滟两川，回裙掩面斗婵娟。\n那堪白马狂游日，正是青楼薄倖年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十三","author":"孙蕡","text":"愁寂偏多感物华，春寒故故入窗纱。\n无端一夜东风起，吹落庭前夜合花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十四","author":"孙蕡","text":"谁识沅湘路几千，梦魂夜夜到君边。\n春光不管愁人恨，故傍枫林叫杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十五","author":"孙蕡","text":"薄寒犹可夜藏阄，向晚何堪独倚楼。\n最是着人添懊恼，海棠枝上月如钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十六","author":"孙蕡","text":"绣线针寒不待拈，金炉香烬亦慵添。\n月移花影偏当户，风搅游丝故入帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十七","author":"孙蕡","text":"昨夜裙腰忽褪围，清晨蟢子绕深闺。\n春来吉兆频频见，定是游人此夕归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十八","author":"孙蕡","text":"试扫双蛾偶便成，容华今日倍分明。\n缘杨堤上嘶春雨，莫是吾家白马声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其二十九","author":"孙蕡","text":"见说新随蜀客船，乱漩涡里下西川。\n还闻又向潇湘去，偏是君山有夜猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十一","author":"孙蕡","text":"接得封书妾自开，分明说与便归来。\n千回枕上听春雨，几度阶前扫绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十二","author":"孙蕡","text":"不如嫁与弄潮儿，潮去潮来自有时。\n谁似阿欢无信幸，说归长是误归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十三","author":"孙蕡","text":"压梦春愁懵不醒，忽闻剥啄猛然惊。\n罗裙旋系开朱户，原是幽禽啄木声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十四","author":"孙蕡","text":"旧栽杨柳色毵毵，千里浑忘寄一缄。\n春雁高飞惟向北，不知游子在江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十五","author":"孙蕡","text":"肠断关山路转迷，房栊风气冷凄凄。\n几回愁倚高楼望，错认行人到日西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十六","author":"孙蕡","text":"灯不成花梦欲阑，素罗衾薄掩春寒。\n忽闻风响秋千索，夜半仓皇出户看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十七","author":"孙蕡","text":"虽缘远别抱忧煎，正合同心到百年。\n莫学钱塘苏小小，又随人上贩茶船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十八","author":"孙蕡","text":"闻说风涛暗洞庭，只将心事抱神灵。\n一炉香篆寒星下，学诵莲花妙法经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其三十九","author":"孙蕡","text":"月斜风细梦初回，日掩重门夜却开。\n花影乱中人影过，失惊原是小琼来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十","author":"孙蕡","text":"静夜焚香礼玉娥，杏花凉露湿衣罗。\n幽情不遣旁人解，尽是喃喃细语多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十一","author":"孙蕡","text":"闲唤飞琼学问禅，缘何于意独悁悁。\n未酬前世铅华业，来结今生寂寞缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨一百二十首 其四十二","author":"孙蕡","text":"对盘双陆打黄金，挂树朱笼赌百禽。\n不是爱他延日子，免教提起别时心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]