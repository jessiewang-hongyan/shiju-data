[{"title":"秋夜梦后作","author":"黄佐","text":"疏槐宫院罢朝天，淮海干戈有岁年。\n未厌西风吹几杖，每依南斗望楼船。\n新丰车马黄尘里，故国园林白露前。\n归梦忽醒寒漏迥，绮窗斜挂玉婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月十日奉迎大驾纪事二首 其一","author":"黄佐","text":"奏凯欢呼大驾回，一时和气满燕台。\n端门日丽龙旗入，驰道风清凤吹来。\n九庙神灵真有托，百年文运定重开。\n都人此日瞻依切，共说君王有将才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月十日奉迎大驾纪事二首 其二","author":"黄佐","text":"铙歌鼙鼓尽天声，亭旆金缯载道迎。\n上将独乘千里骏，义儿多领四家兵。\n车悬虎豹知蒐狝，架叠鲸鲵报武成。\n从此鼎彝书镇国，汉文徒幸亚夫营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝","author":"黄佐","text":"苑云城树隐苍苍，仙漏销沉宝炬光。\n露下貔貅金队冷，风前鹓鹭玉声长。\n螭头渐近闻天语，豹尾徐开挹御香。\n朝罢宫臣导清跸，空瞻团扇护君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后早朝","author":"黄佐","text":"北风吹雪静芳尘，雪霁千门丽景新。\n丹地秖闻鸣玉步，碧天疑有散花人。\n寒光掩映龙楼晓，迟日熏成凤沼春。\n归向柳边凝立久，试裁巴曲和韶钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍车驾幸太学恭赋一律","author":"黄佐","text":"豹纛龙斿拂曙烟，即随清跸下遥天。\n衮衣日月宫墙里，冠盖风云俎豆边。\n环壁波光摇宝扇，閟坛花气绕金悬。\n青衿际此欢无极，共播皇休入诵弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊祀斋居大兴隆寺与懋贤举之绳武三太史同赋二首得旗字 其一","author":"黄佐","text":"大驾迎天早练时，端门灯起禁钟迟。\n春回御气通黄道，夜静神飙闪翠旗。\n龙骑肃分千陛戟，鹤群寒并一禅枝。\n泰坛却忆追趋地，云捧珠宫月满墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊祀斋居大兴隆寺与懋贤举之绳武三太史同赋二首得旗字 其二","author":"黄佐","text":"璧月彤云澹不移，竹房花影正离离。\n僧来秖觉钟磬响，院静不知更漏迟。\n都荔有香浮剑舄，穗杨无力拂旌旗。\n夜寒银棨巡金钥，吟望圆丘有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"内阁前迎春花开有述","author":"黄佐","text":"春丛照眼见轻黄，玉署裁诗觉兴长。\n唐苑错教催羯鼓，汉宫徒自斗仙装。\n龙池日转才分色，凤阁风来细认香。\n何事偏承天泽早，结根元自五云傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其一","author":"黄佐","text":"燕京二月芳草新，天南嗟有未归人。\n清泉白石入幽梦，紫燕黄鹂鸣好春。\n三殿奔趋连日夕，九衢车马杂风尘。\n栖迟凤沼浑何事，吟望渔舟独怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其二","author":"黄佐","text":"阊阖千门拂曙开，即随鹓鹭集蓬莱。\n云边彩仗分仙掖，日下青旗绕帝台。\n扈阁风回初变柳，琳池冰泄半侵苔。\n上林春色应无限，空羡文园作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其三","author":"黄佐","text":"太液池头万岁峰，波光回合翠重重。\n神人驱石开三岛，天子乘春驻六龙。\n紫殿虚无馀御气，碧云迢递忆仙踪。\n玉凫黄鹄无消息，长听趋朝午夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其四","author":"黄佐","text":"燕台自昔兴王地，今日垂衣驭四夷。\n紫禁烟花连朔漠，黄河烽火望旌旗。\n西山积雪辉辉在，北极浮云袅袅垂。\n跂马春郊回首晚，五侯歌管未休吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其五","author":"黄佐","text":"广寒宫殿锁岧峣，汉帝神灵隔绛霄。\n阴洞夜凝龙虎气，阳林秋老凤凰条。\n金茎瑞露沾朱缀，银浦流云入绮寮。\n翠辇不来环佩冷，满庭修竹自萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其六","author":"黄佐","text":"踏青闻幸芙蓉苑，红日未高金吹鸣。\n从此宸游多乐事，向来几务太留情。\n风传羯鼓南薰殿，云拥鸾旗北斗城。\n千载太平知有象，词人先已颂河清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其七","author":"黄佐","text":"风雨潇潇闻曙鸡，春来长忆碧山栖。\n烟开篱落花光动，日暖园林菜甲齐。\n入馔江鱼供白发，泼醅芳酒对青溪。\n刺桐枝上红如锦，自在流莺尽日啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其八","author":"黄佐","text":"幕府鱼书报越裳，期门龙节发荆湘。\n北风鸿雁飞何处，南海渔樵思故乡。\n即恐军储非往日，却劳宵旰及殊方。\n平林月出闻啼鴂，击剑酣歌意转长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒康陵书感","author":"黄佐","text":"夏云销尽午风恬，目极烟霄思未厌。\n瑶水几年留马迹，鼎湖回首堕龙髯。\n泉涂寂寂山当户，松籁萧萧月转檐。\n却愧青衫虚十载，对扬无路拜宸严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"康陵禫祭有述","author":"黄佐","text":"康陵禫日宿神郊，奏格无声藉白茅。\n七庙精灵昭巩洛，二仪风雨积函淆。\n明楼灯火鹓鸾集，隧道松杉翡翠巢。\n羽猎长杨今涕泪，寸心遥与白云交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠赵景昭归广州","author":"黄佐","text":"庭闱每入京华梦，消息真从里闬传。\n慰我客怀千里外，与君交谊十年前。\n心驰珠海云随棹，路入金陵日在天。\n好向明时图远大，只今青琐重材贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮书怀次王绳武韵","author":"黄佐","text":"萧萧松院朔风侵，坐拥重裘力不任。\n蓟北暖遥花去眼，天南书断鹊惊心。\n层云此日连青琐，芳草何年卧绿沉。\n喜有王维同笔砚，清诗时为涤烦襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别吴成甫","author":"黄佐","text":"金陵此去三千里，玉殿回瞻咫尺天。\n两载风烟同逆旅，一帘霜月照离筵。\n即看会计苏江左，还有谋猷达帝前。\n闻雁裁书应有日，听莺携手是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三江毛尚书致仕归姑苏留别次韵","author":"黄佐","text":"笑别鹓行问鹤田，归来林壑故依然。\n月明震泽秋应早，柳映阊门地亦偏。\n黄阁未曾登扈圣，青山相对更怀贤。\n东曹此日情何限，目断冥鸿在远天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送三江先生","author":"黄佐","text":"吴门烟艇故知津，宝带麟衣照莫春。\n蕉鹿梦中曾玩世，莼鲈乡里最宜人。\n三朝礼乐归青简，八座声华动紫宸。\n心折此时瞻望地，潞河南下柳条新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陈虚白炼师","author":"黄佐","text":"飙台羽客宴星坛，四座罡风六月寒。\n绛节曾随苍水佩，玄田应结紫金丹。\n瑶池月冷飞青鸟，珠树云深驻彩鸾。\n知尔蓬瀛多浪迹，摩挲铜狄待谁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"董学士父母受封","author":"黄佐","text":"桂坊秋早竹书成，紫诰貤封荷圣情。\n天与北门添盛事，人依南斗颂长生。\n碧鸡山下棠阴合，丹凤楼前日色明。\n笑领龙章齐举案，一麾今觉到蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林子行归吴川","author":"黄佐","text":"莱衣将母羡君行，把酒临岐百感生。\n杨柳影凋朝雨净，芰荷香暖暮潮平。\n病身与鹤栖萧寺，归梦如云绕粤城。\n曾是同舟忍分手，岸花樯燕总关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月十七日大封宗室奉命充南渭册礼使","author":"黄佐","text":"胪陛传宣仰圣君，锡茅分器重殷勤。\n日临阁道开三殿，风递宫韶出五云。\n宝册下时经辇路，金貂行处散炉薰。\n即从北极趋南渭，怅别天边鸳鹭群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永州楼上春望","author":"黄佐","text":"萧萧梧竹弄新晴，天畔登楼眼倍明。\n湘水碧连云梦渚，粤山青近永阳城。\n三春物色怜多病，万里驱驰笑此生。\n忽忆玉河垂柳径，紫宸朝罢听流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别萧潘二通判于淡岩作","author":"黄佐","text":"五马翩翩度远岑，日浮苍翠满离襟。\n同寅合共循良传，异国仍多故旧心。\n客思渐随芳草远，春光偏入野棠深。\n明朝鼓柁营阳道，回望零陵烟树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游甘露寺同刘士奇作","author":"黄佐","text":"空香浮动翠巉岩，徙倚珠林驻玉骖。\n七泽湍声流日夜，六朝山色落东南。\n朱幡向晚情难别，碧院逢秋酒易酣。\n萧洒不知归路杳，满天竽籁起松杉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归自京师赴常斋钟子夜宴二首 其一","author":"黄佐","text":"魏阙劳君千里梦，粤巢分我一枝安。\n即看春事辞莺燕，且尽芳樽共肺肝。\n沙坞雨馀花气近，江城风定角声寒。\n相看此夕清狂甚，从此过逢兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归自京师赴常斋钟子夜宴二首 其二","author":"黄佐","text":"炉烟袅袅篆垂垂，扫径开尊恨到迟。\n亭榭风烟仍月夜，江湖花鸟况春时。\n金尊玉鲙堪留客，醉舞狂歌果为谁。\n却忆去年羁旅地，粤云南望只成悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"全节庙","author":"黄佐","text":"极目胡尘暗帝畿，楼船南去逐斜晖。\n已无虎帐鸣金柝，秖有龙潭葬宝衣。\n精卫何时填海满，苍梧终日见云飞。\n贞魂若化吴宫燕，应是年年一度归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大忠祠","author":"黄佐","text":"谁扶黄屋此长征，夷夏分明万古情。\n百粤波涛非帝宅，两厓风雨是天声。\n气吞蛇豕频挥剑，力尽驰驱尚请缨。\n再拜高祠回首地，满山松桂月微明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙酉守岁","author":"黄佐","text":"帝城鼓角促朝晖，紫禁烟花锦绣围。\n风静笙歌临路发，雪晴乌鹊背人飞。\n贪趍魏阙年华换，留滞周南心事违。\n柏叶椒花吾祝汝，明年须对老莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日早朝","author":"黄佐","text":"阁道沙堤雪未乾，马前银烛雾中看。\n疏钟欲动飞宫鹊，绛节初齐引佩鸾。\n瑞日影浮双阙表，钧天声在五云端。\n侍臣赋就阳春曲，未觉琼楼玉宇寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春书怀效陈去非","author":"黄佐","text":"曲肱作梦客不到，游丝满空春正晴。\n世事悠悠秖蕉鹿，韶光冉冉但林莺。\n蒋陵山远碧云合，郭隗台高芳草平。\n踏歌吹剑一翘首，天北天南无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题雷氏山水卷","author":"黄佐","text":"羡汝习静栖空山，苍翠无言相对闲。\n松花满地云不扫，柴门敞天风为关。\n波浮龙鳞晓澒洞，峰横豸角秋孱颜。\n丹梯倘许淩绝顶，散发醉呼黄鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜大醉言志","author":"黄佐","text":"拔剑起舞临高台，北斗插地银河回。\n长空赠我以明月，天下知心惟酒杯。\n门前马跃箫鼓动，栅上鸡啼天地开。\n倦游却忆少年事，笑拥如花歌落梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白莲二首 其一","author":"黄佐","text":"水殿盈盈万玉妃，淩波长是步炎晖。\n迢遥玉井峰头见，缥缈瑶池月下归。\n洛浦雾繁珠作佩，楚台风急翠成帏。\n若教解语应愁绝，闻道金笼锁雪衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白莲二首 其二","author":"黄佐","text":"不见红衣映绿苔，夜长疑有鹭飞来。\n蕊珠宫冷香云湿，鱼藻池深素锦开。\n太乙驭风摇翠楫，飞琼乘月出瑶台。\n露华似慰相如渴，分得金茎满玉杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陵祀次韵刘侍御见寄","author":"黄佐","text":"园陵报祀开秋序，骢马追趋出帝城。\n四塞云山随远近，二仪风雨自阴晴。\n金支掩映蛟龙色，玉殿苍凉燕雀声。\n怅望轩辕弓剑在，青霄沾洒不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳次韵答孙贞父","author":"黄佐","text":"相看京洛共缁尘，拂拭荷衣发兴新。\n江上离忧嗟易老，云间归梦恐难真。\n飞飞白雁遥怜汝，采采黄花懒寄人。\n抱病重阳正愁绝，把君诗句重逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省亲三疏获允出郭别亲友","author":"黄佐","text":"喜闻纶綍卷诗书，万里乘槎信所如。\n即办彩衣供色笑，不妨黄发老樵渔。\n临岐尚忆公家事，出郭多烦长者车。\n南北相望意无限，江空岁晚独愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文衡山致仕言归次韵二首 其一","author":"黄佐","text":"十月轩车出紫宸，三年京洛谢缁尘。\n北河冰雪偏留客，南国江山久待人。\n石室有书曾汗简，扁舟无日不思莼。\n此身直在云萝外，谁向中原惜凤麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文衡山致仕言归次韵二首 其二","author":"黄佐","text":"金銮早上乞休书，疏传当时恐未如。\n万里青冥双倦翼，百年黄发几悬车。\n阊门日暖繁杨柳，震泽春深足鲤鱼。\n知尔登临诗不废，停云回首渺思予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夜赠文徵仲","author":"黄佐","text":"即看芳草入新年，岂有椒花媚远天。\n多病独愁双鬓改，故人相对一灯悬。\n匆匆岁色归莺燕，冉冉春声动管弦。\n明日试从高阁望，阳和多在五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁亥元日","author":"黄佐","text":"朔云自绕滦河曲，燕树遥连汉苑斜。\n彩鹢独依河畔柳，新莺应到苑中花。\n三朝礼乐开青琐，万里冠裳拥翠华。\n去去沧江回首地，太平歌颂落烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客楼春望徵仲见过有赠","author":"黄佐","text":"楼外河冰春未消，旅魂吟望倦摇摇。\n骊黄有路开丹峤，孔翠何心恋赤霄。\n燕市风尘通潞渚，吴门烟月满枫桥。\n何时坐尔停云馆，幽竹繁花慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"微雨后风沙大作晚泊临清","author":"黄佐","text":"笑辞钟鼎向山林，去路尘沙苦见侵。\n万里舟航淹日月，九河风雨战晴阴。\n草堂花竹萦春梦，泽国鱼龙伴夜吟。\n心迹不教双寂寞，灯前呼酒漫开襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答廖鸣吾见怀","author":"黄佐","text":"北风吹女思悠悠，乘兴难移雪夜舟。\n建礼昔同鸳鹭序，裁诗今在凤凰楼。\n岸花樯燕催春色，洛水秦山入暮愁。\n多病可堪回首远，吏情吾已付沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁亥除夕","author":"黄佐","text":"旅馆频年过岁除，莱衣今夕乐何如。\n摇摇蜡炬轻风里，浅浅霞杯细雨馀。\n江海只便鱼入馔，烟霞惟恐鹤传书。\n等閒又被梅花恼，漏泄春光满敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦","author":"黄佐","text":"南国浮云向晓开，日华初上钓鱼台。\n东风又与縻芜绿，老屋惟应燕子来。\n万里晨昏逢岁改，三年供奉忆朝回。\n沧溟不似君恩阔，起舞尊前莫放杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"英德别杜生兄弟","author":"黄佐","text":"扁舟六月度浈水，英德县前鲈已肥。\n别尔弟兄难废酒，驱人岐路易沾衣。\n沧江急雨群龙出，古峡闲云独鹤飞。\n返棹相看情不断，倚门真觉梦同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感秋二首用南津胡宪长趣驾韵 其一","author":"黄佐","text":"淅淅秋风吹岸沙，西江迁客思无涯。\n浊醪粗饭足娱老，去燕来鸿犹念家。\n百年洛涘愧潘岳，九日龙山怀孟嘉。\n故园咫尺不归去，辜负东篱无数花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感秋二首用南津胡宪长趣驾韵 其二","author":"黄佐","text":"淅淅秋风吹雨来，自怜樗散未须培。\n水边白鸟背人去，霞外青山待我回。\n抱病江湖长对酒，侧身天地数登台。\n故园只在扁舟上，三径黄花万树梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南溪卷为佴都帅","author":"黄佐","text":"南溪分得扬之水，岩姿林霭相光辉。\n主人燕坐列霜戟，童子清歌调雪衣。\n弦琴每觉薰风入，载酒直随明月归。\n我亦沧洲曾结宇，吏情长恐与心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜对菊","author":"黄佐","text":"且随麋鹿走山林，岂合簪缨击此心。\n永夜鼓钟欺鬓短，小楼风露报秋深。\n鸾声自作孙登啸，龙卧谁为梁甫吟。\n潇洒不知贫与病，东篱元有万黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍梧初发","author":"黄佐","text":"苍梧北望尽蛮荒，云黑山青烟雾黄。\n旌旆行随日隐见，蒙冲坐觉天低昂。\n鼋鼍乘雨出岩穴，翡翠挟春鸣桄榔。\n旅怀历乱不可尽，芳草萋萋弥岸长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂林元夕","author":"黄佐","text":"何处笙歌入座闻，即看陆海在人群。\n星桥暗度重轮月，火树晴开五色云。\n湘水未逢天北使，漓江犹驻粤南军。\n江湖心事年年在，徙倚东风酒易醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横州伏波庙","author":"黄佐","text":"高滩危石锁崔嵬，长夏风烟午未开。\n南海楼船从此去，中原冠冕至今来。\n武陵一曲风尘静，铜柱双标日月回。\n千载伏波祠宇在，汉朝何事有云台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅感","author":"黄佐","text":"尘事熏心千种在，晨昏回首一星周。\n枕前风月照归梦，帘外西山窥客愁。\n短策干时何所得，薄田供岁未须求。\n他年北极怀明主，当日东陵有故侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]