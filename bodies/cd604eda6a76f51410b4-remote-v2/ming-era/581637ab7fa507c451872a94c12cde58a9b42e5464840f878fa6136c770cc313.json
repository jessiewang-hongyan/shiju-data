[{"title":"咏史 其六 介子推","author":"何吾驺","text":"每到清明便黯然，介山风雨政堪怜。\n人情信宿矜相报，莫问相从十九年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其七 韩信","author":"何吾驺","text":"虎斗龙争天地昏，穷途君自起王孙。\n风尘莫讶无知己，谁念当年一饭恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其八 西施","author":"何吾驺","text":"若耶溪畔好莲花，最似西施出浣纱。\n一入吴宫叹殊绝，当年同伴始生嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其九 卓文君","author":"何吾驺","text":"静夜相从谁得闻，怜才天下几如君。\n后来纵有淩云气，得似当垆已自醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史 其十 苏小小","author":"何吾驺","text":"流萤野火入寒原，潮去潮来独不言。\n莫向春风论小小，夜深花落总芳魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其一","author":"何吾驺","text":"身后身前总杳然，青山何便是前缘。\n但知溪上能消酒，肯信花开又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其二","author":"何吾驺","text":"树叶阴阴鸟乱啼，客携尊酒过园西。\n窗前莫管花开落，惹得閒情趁马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其三","author":"何吾驺","text":"山头月出是蛾眉，舷底歌声扣玉卮。\n一笑白云山际晚，隔溪齐和采芝辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其四","author":"何吾驺","text":"有客弹棋夜未归，却烧兰烛照柴扉。\n月光一片穿林入，半挂藤萝半在衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其五","author":"何吾驺","text":"日日寒潮浸石门，直乘小艇绕孤村。\n船头叫买渔翁酒，疏雨微风独一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其六","author":"何吾驺","text":"凭空夜宿玉虚台，静夜沈沈对酒杯。\n正好开帘延月色，却愁烟雾簇人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其七","author":"何吾驺","text":"芙蓉千树碧溪头，树下佳人独倚楼。\n惆怅不堪花落尽，秋江一曲写新愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其八","author":"何吾驺","text":"静扫山门夏日长，既烹苦茗复焚香。\n山童不识人间事，笑倚疏桐韵绿篁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其九","author":"何吾驺","text":"半亩新开绿水池，不栽青草惹涟漪。\n低头忽见青天色，无数云霞绕汉飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其十","author":"何吾驺","text":"柴门一入白云深，古树交加绿结阴。\n人语隔江听转远，岭头谁下凤鸾音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其十一","author":"何吾驺","text":"乱编芦苇小亭西，苦竹千竿夹碧溪。\n听尽鸟声春未暮，隔林还有杜鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园居吟十二首 其十二","author":"何吾驺","text":"落日垂杨送去航，朝朝浦口断人肠。\n东流不尽人间事，结得愁缘万古长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其一","author":"何吾驺","text":"微雨微晴杨柳风，画船江口采芙蓉。\n非无酒伴堪同往，怕搅黄梁睡正浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其二","author":"何吾驺","text":"问予何事独乘舟，欲访何人天际头。\n漫道希夷曾有约，石床冰簟竹间楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其三","author":"何吾驺","text":"秧青草绿树苍苍，睡醒田家煮芋香。\n借火试烹春露茗，谁人得到此间尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其四","author":"何吾驺","text":"四月春归夏火新，中流疏雨冷纶巾。\n潇潇乍似秋江上，只怪前山绿半匀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其五","author":"何吾驺","text":"杜宇留春春已归，黄鹂啭夏夏初晖。\n雨来野外翻迎送，春恨如烟尚染衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其六","author":"何吾驺","text":"新丰春瓮斗千钱，得到唾津便似仙。\n若见朝来烟雨酿，一杯初宴已醺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其七","author":"何吾驺","text":"若为载酒待嘤鸣，几见山川结友生。\n四面峰峦相对出，谁家伯仲比深情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其八","author":"何吾驺","text":"渔翁趁雨打江鱼，竹帽蓑衣乐有馀。\n我为临流歌一曲，得鱼沽酒过吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其九","author":"何吾驺","text":"大海光浮结蜃台，去来江上漫衔杯。\n隔江吴楚烟中尽，没个游人望眼开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独泛十首 其十","author":"何吾驺","text":"团团翠盖拥江流，十道泉声百尺楼。\n若向西湖访风景，有人孤枕榄溪舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠歌者","author":"何吾驺","text":"去岁凭君看泽兰，楚云今夕更邀欢。\n名从片玉声逾藉，舞袖春风不解寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上吟","author":"何吾驺","text":"芦荻洲边红蓼残，美人衫袖玉琅玕。\n维舟不为风和雨，弹指前溪去住难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午元夕六首 其一","author":"何吾驺","text":"紫陌华灯媚午天，南头挝鼓北锄田。\n耕牛欲办无薪米，卖却梅花作社钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午元夕六首 其二","author":"何吾驺","text":"竞传南陌有金铺，复道东街弦管纡。\n吐出华灯天上坠，杂烧花蕊伴龙珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午元夕六首 其三","author":"何吾驺","text":"微醉春醪弄玉笙，佳人何处听歌声。\n踟蹰缓步长街下，几拂冰绡未忍行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午元夕六首 其四","author":"何吾驺","text":"游人三五竞前途，借问侬家谁阿姑。\n侬在梅花梢下住，玉为颜色雪为肤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午元夕六首 其五","author":"何吾驺","text":"春事催残杨柳枝，明朝蓑笠又江湄。\n荡游正好穷今夜，却数闺中是别期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午元夕六首 其六","author":"何吾驺","text":"庙里佳人竟夜喧，抽签敲竹问儿孙。\n绮罗少妇深深拜，赪颊犹云感佛恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄弟","author":"何吾驺","text":"短檠灯影夜踌躇，此日初封寄弟书。\n北望长安千万里，江天回首雁群疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见大庙峡梅花有怀落霞诸子二首 其一","author":"何吾驺","text":"峡隐梅花逼酒杯，一枝犹似落霞开。\n故园万树春应早，陇上何人许寄来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见大庙峡梅花有怀落霞诸子二首 其二","author":"何吾驺","text":"层岸吹雪洒寒衣，簇簇幽香向晚飞。\n不是故人能入梦，万山明月几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霁雪过匡庐","author":"何吾驺","text":"李白欲巢五老峰，我来万里吹长风。\n明霞覆雪日光射，水晶宫在半天中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱塘夜雨","author":"何吾驺","text":"古渡空房黄叶遮，夜深思妇咽寒笳。\n钱塘江上思乡处，又被西风吹雨斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚司理座主赴内召六首 其一","author":"何吾驺","text":"才烂烟波笔掣云，一朝鸿宝动朝绅。\n昌黎文自能驱鳄，不信潮阳不借君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚司理座主赴内召六首 其二","author":"何吾驺","text":"苍松寒雪迥无尘，法雨如膏万树春。\n若问玉壶清绝处，青天空碧照璘珣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚司理座主赴内召六首 其三","author":"何吾驺","text":"波摇岳动起潮湄，万国观风此一时。\n天子欲兴周礼乐，大官先盛汉威仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚司理座主赴内召六首 其四","author":"何吾驺","text":"千年爨下得逢君，坐使孤弦绕白云。\n此曲祇今歌未得，感恩空自指秋雯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚司理座主赴内召六首 其五","author":"何吾驺","text":"谁向龙门指别途，秋风应似别情纡。\n珠宫一片波心月，得入仙舟梦里无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚司理座主赴内召六首 其六","author":"何吾驺","text":"民事纷纷日未休，东南输运似江流。\n定陈天下艰难计，早为南方借箸筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁未同诸兄弟过石门","author":"何吾驺","text":"去年相送石门潮，此日同君道寂寥。\n犹是布衣天下士，夜深明月坐吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过许四首 其一","author":"何吾驺","text":"贤达何心博令名，直缘身世早相轻。\n放勋未易酬知己，得向箕山适我情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过许四首 其二","author":"何吾驺","text":"河畔萧萧长蔚蒿，牵牛一去解尘劳。\n世人浑说皇家好，秋色于今许颖高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过许四首 其三","author":"何吾驺","text":"尘沙漠漠几千秋，盖代英雄泪未收。\n但向弃瓢寻故事，清风明月总悠悠。","c