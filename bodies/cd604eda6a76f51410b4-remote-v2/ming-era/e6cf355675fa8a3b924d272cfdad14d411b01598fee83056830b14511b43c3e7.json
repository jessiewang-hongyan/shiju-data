ter":43981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送施居一之大浦驿丞绝句二首 其二","author":"符锡","text":"疋马远从朝海去，前程何处问登楼。\n高才盛位翻多事，禄薄官微良自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨质三冠带后往陕西省父","author":"符锡","text":"冠袍新荷望长安，秦塞河山驻马看。\n游宦岂容能汗漫，宁亲应暂许盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送袁县丞 其一","author":"符锡","text":"一别韶阳九见春，梅花驿路是通津。\n尘劳忆得登临胜，锦水丹山属故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送袁县丞 其二","author":"符锡","text":"适国曾因问曲江，凤来云气接苍茫。\n悬知宫满棠阴在，不尽湘流滚滚长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈惟春重领庆元","author":"符锡","text":"摧坚陷阵事徒劳，缓辔何人誇锦袍。\n始信封侯非力致，频看鸡割试牛刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李东平二守","author":"符锡","text":"漕河东去泛仙舟，桂影婆娑月正秋。\n燕誉不妨多乐事，风流□□振前脩。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧二守之济宁","author":"符锡","text":"春色平分鲁甸馀，绿杨红杏到官初。\n河桥水漫楼船度，北使频逢好寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送武鸿胪之官德清兼寄吴兴刘太守 其一","author":"符锡","text":"吴兴邑治孰为优，少府才华不易求。\n独柰别君成企伫，王河残涨晚悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送武鸿胪之官德清兼寄吴兴刘太守 其二","author":"符锡","text":"刘侯为政本清贞，蓦地风波底自生。\n此去好凭君问讯，五湖云净霅川平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠廖太监镇守甘肃三首 其一","author":"符锡","text":"凉州西望远咸京，重镇应须得老成。\n时来满听监军使，恤苦怜贫如父兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠廖太监镇守甘肃三首 其二","author":"符锡","text":"监军拥节镇边隅，不惜千金买湛卢。\n胡儿咬指偷相问，近向祁连牧马无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠廖太监镇守甘肃三首 其三","author":"符锡","text":"羯虏何年犯酒泉，我军特满气无前。\n应知圣主弘兼爱，不重开边重守边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蕳别驾还宝宁 其一","author":"符锡","text":"万邦圭组倏来同，别驾高车自阆中。\n□绩明庭又西首，几回清梦禁城东。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蕳别驾还宝宁 其二","author":"符锡","text":"宦海悠悠两鬓星，相逢无复叹浮萍。\n名家令侄中丞是，于我犹能眼倍青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蕳别驾还宝宁 其三","author":"符锡","text":"岷峨西望郁苍苍，朝客归骖兴转长。\n满地桑麻公事简，屏车星剑与翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]