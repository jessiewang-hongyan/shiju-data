[{"title":"拟古杂体十九首并序 其八 陌上桑","author":"邓云霄","text":"当春绿桑柔，怀春女出游。\n不及秦氏女，百媚娇且羞。\n使君来，一何愚。\n停道侧，久踟蹰。\n使君不念立马疲，妾自归去怜饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其九 昭君辞","author":"邓云霄","text":"嫖姚北伐军声起，左贤祭马擐弓矢。\n汉胡格斗沙场里，伏尸如山一千里。\n不及明妃西入胡，胡庭美女皆羞死。\n翻将汉曲奏琵琶，雪碛穹庐冬见花。\n万古惟悲青冢月，谁怜诸将骨如麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十 王子乔","author":"邓云霄","text":"人道迩，仙道遐。\n不见王子乔，千年一去不还家，寂寥笙鹤令人嗟。\n彭祖巫咸前后死，玉棺何处葬仙子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十一 东门行","author":"邓云霄","text":"出东门，临大道。\n道上来往人，一行一回老。\n莫嫌相对贫，相对贫亦好。\n将进酒，强牵衣。\n云离山，几岁归。\n车轮未转肠先转，万行涕下风吹断。\n君去郊送归郊迎，黄金斗印莫相轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十二 鞠歌行","author":"邓云霄","text":"年年上巳与清明，九衢车马嬉春晴。\n琼楼弄琵琶，故作断肠声。\n何人传此曲，曲罢春郊遍青绿。\n踏青女儿年十五，纤腰如柳向人舞。\n蹴鞠蹴鞠夜忘归，归来庭畔月移午。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十三 虾䱉篇","author":"邓云霄","text":"不识三神山，乃在六鳌背。\n任公一举钓，失水翻成脍。\n谁知尔虾䱉，乃在蹄涔内。\n鄙夫营七尺，达士期方外。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十四 乌生八九子","author":"邓云霄","text":"君不见古时九日烧天红，乌生九子巢日中。\n飞上天门尾毕捕，落翅徒伤后羿弓。\n乌乃叩阍诉天帝，后羿何不念其妻。\n窃药一入月，弯弓不射还嗟别。\n兔何德兮乌何辜，世间贞女多狂夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十五 箜篌引","author":"邓云霄","text":"弹箜篌，声正扬。\n河之水，流汤汤。\n被发之叟学吕梁，有身反向鱼腹藏。\n传语此公无渡河，渡河当更奈公何，人间平地多风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十六 日出行","author":"邓云霄","text":"世上何碌碌，名利驱人不遑宿。\n君看日亦无闲时，东海西山转如毂。\n誇父誇父何其愚，与日竞走胡为乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十七 双桐生空井","author":"邓云霄","text":"井不吸，虚银床。\n桐易老，思鸾凰。\n削桐为琴扬哀音，秋思千重如井深。\n邻姑听琴夜独语，井鲋孑孑谁与处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十八 善哉行","author":"邓云霄","text":"百年何蠢蠢，少女看木槿。\n一朝失顾盼，红颜零落尽。\n来日苦短去日长，麻姑金母发如霜。\n蓬莱山下水，已种数株桑。\n感此芳时春将晚，酒朋棋伴郊游远。\n牵落日，倩游丝。\n黄鹂唤东风，为我停须斯。\n杖头休道酒价乏，隔岸榆钱飞策策。\n借问海上仙，何如此欢伯？\n歌善哉，醉方归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古杂体十九首并序 其十九 当垆曲","author":"邓云霄","text":"客来未饮酒，熏却东风醉。\n胡姬十二试当垆，见客含羞翻欲退。\n新教一曲能半能，歌喉娇涩水凝。\n豆蔻枝头花未吐，芳心一点轻于露。\n槽边㶁㶁滴酴醾，迷杀阳城下蔡儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白龙祠祷雨有应喜作长句","author":"邓云霄","text":"阳山之溪幽且深，澄潭直下千万寻。\n龙祠俯视潭之阴，彩云白雾时萧森。\n神龙犹念所生处，岁鞭列缺归省姆。\n回首吴民皆桑梓，喜霈甘霖溉吴土。\n县官为民酬若龙，春秋祀事洁而丰。\n何者肥■煽蕴隆，火旗焰焰烧天红。\n江焦汤沸冯夷宫，龙兮睡醒怒气冲。\n立檄九河与四渎，青虬黑蜧来趋风。\n云将初列阵，雨师骤发箭。\n忽虞山岳翻，乍觉乾坤战。\n郊外商羊舞欲狂，垤中鹳鹤呜且翔。\n古洞无劳击阴石，市廛何用燔巫尪。\n九扈兴歌田畯喜，苗秀青青如栉比。\n万户同欢大有年，催科幸免烦鞭棰。\n雨珠雨玉贺升平，祠下宜添喜雨亭。\n大泽不忘功德水，年年岁岁荐芬馨。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳山坞内小溪","author":"邓云霄","text":"小溪缘密条，茅屋岸东西。\n野老鸥为侣，孤松鹤并栖。\n避喧今几世，入洞昔人迷。\n坐爱烟霞晚，回桡返照低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛舟四首 其一","author":"邓云霄","text":"棹歌翻渌水，击汰复夷犹。\n吴越春江合，东南王气浮。\n鸣榔遥向若，岸帻不惊鸥。\n渺渺五湖客，烟波如可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛舟四首 其二","author":"邓云霄","text":"江练晴堪染，汀兰静自芳。\n已宜君子佩，不倩好风扬。\n折采香盈把，怀人水一方。\n轻桡徐转去，春望浩茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛舟四首 其三","author":"邓云霄","text":"洗耳疑仇俗，怀沙怅独清。\n岂知簪绂内，不异薜萝情。\n舒啸沧浪晓，观空水月明。\n乘流无住著，自在玉壶行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛舟四首 其四","author":"邓云霄","text":"闻道蓬瀛外，鲸波若拔山。\n秦皇空望幸，方士去无还。\n纵有金银阙，其如风浪艰。\n静观濠上理，心与广川闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠渔父并序","author":"邓云霄","text":"野老歌传欸乃清，和风淡荡漾仙声。\n烟波不杂市朝态，鼓枻非关去住情。\n奏急鱼龙号绝浦，响回莺鹤下层城。\n吏情未觉沧洲远，倩汝微澜为濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姑苏元夕集诸词客得朋字排律二十六韵","author":"邓云霄","text":"吴门歌舞地，乐事日相仍。\n况遇千金夕，遥临片月澄。\n条风吹凤野，新暖解鲛冰。\n绣陌香尘匝，铜街瑞气凝。\n楼台甲第敞，裘马少年矜。\n赵李皆连戚，金张各引朋。\n春思方浩荡，逸兴寄冯陵。\n共庆瑶天爽，同欣玉烛登。\n蚖脂明绛蜡，豹髓隔红缯。\n兢斗丁谖巧，争誇万毕能。\n鳌山浮陆海，星彩避华镫。\n火树家家灿，骊珠颗颗升。\n祗须惊绚耀，未易辨名称。\n锦席九枝满，兰殽百味蒸。\n初筵心已醉，列炬目为瞢。\n实从纷轮至，徘优次第征。\n鱼龙翻角觗，杆索互缘乘。\n士女写交错，笙歌鼎沸腾。\n欢声摇地轴，高响遏云层。\n蹴鞠丸随足，秋千凫度縆。\n登场重选伎，催曲迭酬绫。\n良夜真堪赏，幽怀若不胜。\n可怜花满面，岂吝酒如渑。\n虬箭停寒漏，鸡人报旭升。\n横桥无铁锁，归骑踏金绳。\n相约留馀兴，来宵更倍增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园听客弹琴","author":"邓云霄","text":"尝怪古人愚，临流偏洗耳。\n耳中本清虚，更无物可洗。\n谁为扬天籁，自入清虚里。\n此时冷冷意，片片随流水。\n曲罢两无言，林间竹风起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临高台","author":"邓云霄","text":"临高台，好风淡荡从东来。\n朔鸿已去燕未返，坐令春信空相猜。\n台前秋千兼蹴鞠，千门嫩柳如新沐。\n白马雕鞍轻薄儿，春游倦入谁家宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思二首 其一","author":"邓云霄","text":"芳树临清沼，红颜落镜中。\n催花惟丽日，莫怨雨兼风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思二首 其二","author":"邓云霄","text":"梦破纱窗晓，西园乌乱啼。\n春情纵摇荡，犹胜听莎鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹四绝 其一","author":"邓云霄","text":"纷纷红紫战春场，叵奈东风掠阵狂。\n谁道青皇不解事，故将后劲属花王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹四绝 其二","author":"邓云霄","text":"绣幄珠帘护宝栏，露华犹自怯朝寒。\n呼童暖酒浇檀晕，春色偏怜带醉看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹四绝 其三","author":"邓云霄","text":"共道名花肯让花，后于桃李殿韶华。\n寄言二八楼头女，不必先窥宋玉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹四绝 其四","author":"邓云霄","text":"轻盈似入昭阳掌，浓艳堪回照夜车。\n朱鸟池边传资讯，好将颜色付红蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芍药","author":"邓云霄","text":"幸与花王为近侍，承恩偏得倚芳丛。\n赵家姊妹低昂里，杨氏诸姨顾盼中。\n掩袖自惭当国色，向人如语怨东风。\n香车宝马春游晚，寄赠多情有蝶通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"倦夜","author":"邓云霄","text":"行云逆流月，惨淡有无间。\n世态谁能定，浮名好是闲。\n倦来凭碧簟，梦去绕青山。\n侧想沉冥子，经年长闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独游上方三首 其一","author":"邓云霄","text":"上方兰若逼诸天，有客乘飙弄紫烟。\n悟入忘言遣玉麈，坐观无相得金仙。\n三花洞里浑金古，朝菌人间自岁年。\n谁道漆园非傲吏，逍遥吾拟远游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独游上方三首 其二","author":"邓云霄","text":"重来风日正宜人，山色湖光淡淡分。\n象外烟霞闲处得，仙家鸡犬静中闻。\n空虚法界依双树，流浪尘踪付片云。\n寄语山灵非逋客，相过何必更移文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独游上方三首 其三","author":"邓云霄","text":"长日风林坐玉壶，凭栏千里散平芜。\n扁舟湖上今能否，匹练吴门问有无。\n缥渺野心凫共远，凭陵侠骨剑同孤。\n休誇作赋登高者，元是高阳旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶读东坡海外寄人书云某到贬所半年百凡粗遣更不能细说大约似灵隐天竺和尚退院后却住一个小村院于折足铛中糙罨米饭吃便过一生也得令人绝倒戏成三绝以效希调 其一","author":"邓云霄","text":"海外仙人兴不孤，烟波东去即蓬壶。\n青童能供胡麻饭，肯问铛中米有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶读东坡海外寄人书云某到贬所半年百凡粗遣更不能细说大约似灵隐天竺和尚退院后却住一个小村院于折足铛中糙罨米饭吃便过一生也得令人绝倒戏成三绝以效希调 其二","author":"邓云霄","text":"野鹤横江化羽人，德云元说是前身。\n人闲一谪无长物，最爱先生彻底贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶读东坡海外寄人书云某到贬所半年百凡粗遣更不能细说大约似灵隐天竺和尚退院后却住一个小村院于折足铛中糙罨米饭吃便过一生也得令人绝倒戏成三绝以效希调 其三","author":"邓云霄","text":"小吏红尘耻折腰，王乔葛令待相招。\n偶看海外谈天竺，自笑莱无甑尚饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春寄同社","author":"邓云霄","text":"子胥门外水空波，春事阑跚感慨多。\n对酒东风啼越鸟，怀人子夜听吴歌。\n漆园傲吏殊无赖，竹里狂生近若何。\n寄语揖仙楼上月，年来清梦数回过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晓","author":"邓云霄","text":"旭日明虚室，流光鉴薄帏。\n梦回迷晓蝶，忘却换春衣。\n百卉频开落，年华有是非。\n片云天际淡，可比宦情微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春舟中","author":"邓云霄","text":"沉水之香通太灵，虎丘新茶云乳青。\n烹茶晓汲惠山水，焚香卧读黄庭经。\n江南春暮已如此，花落清流成锦水。\n燕语莺啼大著忙，素心不寄春光里。\n一缕轻烟起博山，清风习习满怀间。\n江皋倘遇天随子，应共扁舟去不还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨己亥有水","author":"邓云霄","text":"不畏沙崩损药栏，遥邻麦秀落风湍。\n海童有意迎神女，暴雨何曾避灌坛。\n薄暮回飙吹野哭，深更哀角动春寒。\n临流欲洒疮痍泪，祗恐偏增浊水澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花二绝 其一","author":"邓云霄","text":"舞片辞蜂嘴，馀香到马蹄。\n燕回休太息，好去探春泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花二绝 其二","author":"邓云霄","text":"金谷香尘散，楼头逐晓风。\n莫言春有暮，总是色皆空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月","author":"邓云霄","text":"枕簟起秋思，夜深群动歇。\n斜倚桂树枝，徘徊望秋月。\n风吹晕渐破，露洗光仍发。\n遥念广寒人，天空云水阔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓","author":"邓云霄","text":"聊寄一枝宿，起来何所思。\n西山对高阁，爽气入支颐。\n累牍怜多事，三竿出每迟。\n夜来虚室梦，似与白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄袁伯益望江","author":"邓云霄","text":"五斗堪春酿，愁来几醉眠。\n谁能柔绕指，一任直如弦。\n风雨寸心折，闲忙两地偏。\n怜余甘拙宦，相念一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忧谗寓言","author":"邓云霄","text":"问影何所为，愀然浑不语。\n共为天地客，暂与尔俦侣。\n孤灯对不疑，皓月还同步。\n勿逢沙中蜮，半路失相顾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲火葬","author":"邓云霄","text":"夜雨啼乌黯自怜，何人忍断蓼莪篇。\n肯将儿女千行泪，尽付郊原一片烟。\n洞劫已甘投火宅，清凉无路到罗天。\n年年寒食清明节，徒向江边酹纸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门春望","author":"邓云霄","text":"王孙愁见草萋萋，客里逢春意转迷。\n几处艺兰依浅浦，谁家拾翠上平堤。\n荒台旧苑孤烟外，流水闲云野日西。\n欲写春来无限恨，东风时倩一鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠谢曰可年丈","author":"邓云霄","text":"江练平铺彩笔飞，何人不识谢玄辉。\n袖中谏猎书犹在，门外张罗客渐稀。\n李白夜郎今更远，贾生宣室几年归。\n浮尘扰扰豺狼满，奏罢离歌易湿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"久客","author":"邓云霄","text":"梁上喧双燕，逢春亦解归。\n往来看旧垒，岁月老乌衣。\n得食众雏长，窥帘傍母飞。\n吴门馯久客，对尔泪长挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门观竞渡戏作长歌","author":"邓云霄","text":"端阳新雨涨平堤，柳暗长桥莺乱啼。\n万户楼台如镜里，千门弦管喧于市。\n五丝系臂醉蒲觞，争看龙舟戏江水。\n红帘彩鹢木兰桡，锦缆牙墙奏玉箫。\n簇簇黄头歌欸乃，重重翠扇伫娇娆。\n楼船画舫纷停泊，别上江亭开水阁。\n两岸游人似堵墙，绮罗耀日相交错。\n游人开处使君来，伐鼓填填响若雷。\n屏帐駊騀张巨舫，琼筵乐部递相催。\n使君重文兼好客，当筵载笔皆词伯。\n未许丰容斗艳妆，直从险峻看标格。\n梨园曲罢报诗成，江上游龙急瞲声。\n鳞甲翻波风雨恶，江胥河伯避霓旌。\n输嬴未决雌雄队，垒鼓催桡浪花碎。\n锦标夺得快先登，两岸千人齐喝采。\n输者惭兮嬴者矜，回舟赌胜更凭陵。\n江波咫尺分吴越，往事千年感废兴。\n越兴吴废付东流，南国烟花恣浪游。\n谁向澄潭伤屈子，空余兰杜结离忧。\n湘兰沅杜长江隔，吴门还有鸱夷革。\n日暮潮来天地青，剑光袍铠如银白。\n江南士女自嬉嬉，话及前朝总不知。\n嬴输兴废浑闲事，莫怪山公倒接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏清夜吟","author":"邓云霄","text":"世上仅三乐，人间止百年。\n羲和何太苦，朝暮不停鞭。\n峥嵘火云连赤阪，入夜惟愁日车返。\n冰纱为帐扇轻纨，竹气梧风清更远。\n此时煮茗在虚亭，剥笋还窥玉札经。\n为鲧烛龙聊税驾，来朝微雨待人醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冰盘瓜藕","author":"邓云霄","text":"热思寒水玉，更忆葛仙方。\n忽对片冰皛，能生六月凉。\n甘瓜翻几滑，脆藕拂盘香。\n坐听莲歌晚，青门意更长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江村吟 其一","author":"邓云霄","text":"吴会繁华地，淳风在野村。\n桑麻连户牖，禾黍散鸡豚。\n茅屋还堪赋，江亭好避喧。\n壶觞依浅草，真乐满田园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江村吟 其二","author":"邓云霄","text":"稚子捉杨花，呼群更打鸦。\n嬉游忘帝力，耕凿任农家。\n野径飞晴蝶，平畴噪乱蛙。\n陶然上皇世，不道武陵遐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江村吟 其三","author":"邓云霄","text":"新月带斜辉，江村动夜扉。\n笛残知牧返，歌扬识渔归。\n薄雾笼波淡，疏灯隔竹微。\n孤舟同鹭宿，尘梦夕来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江村吟 其四","author":"邓云霄","text":"畚锸如云集，周防为水区。\n今朝勤妇子，他日变荒芜。\n敝裤宁堪著，新租未易逋。\n一劳真永逸，尚胜北山愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟吴宫行乐词五首并序 其一","author":"邓云霄","text":"阵扫东南一敛收，水犀十万日椎牛。\n君王气盖百二州，锦帆龙舸江中流。\n吴歈子夜风傅曲，台上栖乌不得宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟吴宫行乐词五首并序 其二","author":"邓云霄","text":"苏台高出浮云外，吴越诸山几案对。\n美人舞罢王半醉，丝管啁啾滴空翠，珠帘卷却吴江水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟吴宫行乐词五首并序 其三","author":"邓云霄","text":"斗鸡陂西走狗塘，云芽露蕊红兰芳。\n美人拾翠行采香，珠璎宝衱摇琅琅。\n归来响屟香风绕，月娥西镜森相照，天鸡不报吴宫晓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟吴宫行乐词五首并序 其四","author":"邓云霄","text":"乌啼集菀不集枯，越王行酒妻与夫。\n东南半壁开霸图，烟沉烽净一事无，今不行乐胡为乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]