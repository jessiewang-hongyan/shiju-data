[{"title":"水居漫兴 其五","author":"高攀龙","text":"绿树遮山有态，白云过水无心。\n一窗半开半掩，四月乍雨乍晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其六","author":"高攀龙","text":"黄叶疏疏门巷，寒风淅淅蒹葭。\n人在小楼隐几，夕阳忽度昏雅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其七","author":"高攀龙","text":"桃华一丛为佳，柳树几行足矣。\n行乐不务其多，人心自不知止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其八","author":"高攀龙","text":"小阁凭阑莞尔，匡床拥被陶然。\n夜半人声何处，芦华隔浦渔船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其九","author":"高攀龙","text":"一点两点村火，三声四声渔歌。\n半生得趣不少，百年好景无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其十","author":"高攀龙","text":"山人别无妄念，三余两饭便足。\n穜成百树梅华，此是穷奢极欲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其十一","author":"高攀龙","text":"靠山一亩穜竹，近水两畦栽华。\n客至莫愁下箸，二十七穜菜鲑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其十二","author":"高攀龙","text":"平沙漠漠两岸，流水弯弯几村。\n兴至便呼叶渡，归来不掩柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其十三","author":"高攀龙","text":"临水閒心便远，见山尘虑都消。\n此间益者三友，一琴一卷一瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其十四","author":"高攀龙","text":"风来柳线转媚，雨过桃华更妍。\n著履绕堤散步，自言不减神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其十五","author":"高攀龙","text":"山人作何功课，终日对山不语。\n问我此意何如，白云自来自去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居漫兴 其十六","author":"高攀龙","text":"赤日堕于西隅，白月升于东牖。\n我趁于此开尊，佩得金印如斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑母寿歌","author":"高攀龙","text":"天回地迥浩茫茫，万象昭列四气翔。\n人生其中百念长，消松至灵空彷徨。\n持握径寸寿无疆，专静沈默道之乡。\n心游至和迓百祥，有子贤哲孙枝昌。\n委运任遇神不伤，念中无营身轻康。\n春妍景淑日载阳，莺鸣华发化无方。\n子孙拜上千年觞，心知和悦乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居","author":"高攀龙","text":"有客风尘归去来，兀然孤坐水中台。\n九龙山似翠屏立，五里湖如明镜开。\n春雨蕨肥菰米饭，秋风鲈美菊华杯。\n蒹葭白露伊人在，恣向江天亦快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居独坐","author":"高攀龙","text":"独坐孤亭四望宽，夜深明月浸溪寒。\n归来山色如相许，老去秋风转自安。\n万里云霄看燕雀，百年天地有金兰。\n尸居未可言匏系，屈指山林事更难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居闭关","author":"高攀龙","text":"幽居无事不开颜，为惜春光只闭关。\n两眼情亲惟绿野，一生心契有青山。\n桃华灼灼鸟啼寂，柳絮飞飞人意閒。\n缓步溪头看落日，月明深竹抱琴还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"高攀龙","text":"万里迢迢殅色开，千秋蔼蔼野芳来。\n孤舟最喜青山伴，倦眼多为绿树回。\n邑里过时惊薄俗，衡门深处念时才。\n可怜无尽乾坤内，百念消归一酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同许静馀先生游山","author":"高攀龙","text":"新凉甘雨遍汀洲，况复山中桂树秋。\n以我中年窥静理，知君晚节解閒游。\n喜看岩竹穿幽径，爱听松风上小楼。\n满地夕阳收拾去，并将明月载归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同洪平叔游武夷","author":"高攀龙","text":"连宵阴雨长春菭，方驾山中云即开。\n峰胜正愁舟急过，滩高绝便首重回。\n排云岩竹山山出，映水春华曲曲来。\n薄暮天游最高顶，可无呼月醉深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次刘伯先闭关韵","author":"高攀龙","text":"在在名山寂寂峰，渊泉深处有潜龙。\n非于太极先天覛，只在寻常日用逢。\n当默识时微有象，到名言处绝无踪。\n洗心藏密吾曹事，长掩衡门独抚松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静坐吟 其一","author":"高攀龙","text":"静坐非元非是禅，须知吾道本于天。\n直心来自降衷后，浩气观于未发前。\n但有平常为究竟，更无元妙可穷研。\n一朝忽显真头面，方信诚明本自然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静坐吟 其二","author":"高攀龙","text":"一片灵明一敬融，别无馀法可施功。\n乾坤浩荡今还古，日月光华西复东。\n莫羡仙家烹大药，何须释氏说真空。\n些儿欲问儒宗事，妙诀无过未发中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静坐吟 其三","author":"高攀龙","text":"一自男儿堕地来，戴高履厚号三才。\n未曾一膜颜先隔，何事千山首不回。\n一静自能开百障，老翁依旧返婴孩。\n从今去却蒲团子，鲲海鹏天亦快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其一","author":"高攀龙","text":"圣贤止是学为人，学不知天人未真。\n天在人身春在木，人居天内木涵春。\n万殊精别方知义，一本穷研始识仁。\n试看天人无间处，不知天道岂知身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其二","author":"高攀龙","text":"莫为为者是真机，稍著安排便已非。\n桃自鲜红李自白，鱼能渊跃鸟能飞。\n不知本体原如是，安得工夫妙入微。\n看尽古今差谬处，只缘些子见相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其三","author":"高攀龙","text":"千圣传心一敬修，不知真敬反成囚。\n欲求一得且永得，须下千休与万休。\n疏水曲肱常浩浩，百官万务尽悠悠。\n廓然天地浑无事，一物匈中岂足留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其四","author":"高攀龙","text":"中庸二字圣真诠，来自唐虞一脉传。\n本体睹闻为入窍，工夫戒惧是天然。\n但从庸行庸言里，直彻无声无臭先。\n此是人人真本色，可怜千古作陈编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其五","author":"高攀龙","text":"格物无端成聚讼，起于知本二言分。\n但知知本即知至，格物何曾有阙文。\n本在操舟方有舵，本迷乱国为无君。\n只翻诚意一错简，涤荡青霄万顷云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其六","author":"高攀龙","text":"知本繇来义最深，须从物理细推寻。\n一灵充塞皆为物，万象森罗总是心。\n心正涓流俱到海，身修点铁悉成金。\n细穷物理无多事，只在兢兢顾影衾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其七","author":"高攀龙","text":"不将一事挂匈中，荡荡乾坤在此躬。\n恰似云开天穆穆，更如冰泮水瀜瀜。\n因无邪妄名为寂，岂为虚无即堕空。\n履薄临深缘底事，只愁无浪又生风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其八","author":"高攀龙","text":"吾儒穷理最为先，理彻心空不入禅。\n穷是十分到底处，理须一物不容前。\n六经尽向躬行譣，一字不从文义牵。\n自有豁然通贯日，方知日用是真元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其九","author":"高攀龙","text":"物物其来有定则，自然之则谓之天。\n但因在物付各物，一任纷然本寂然。\n随处家庭堪作佛，无须岩壑始修仙。\n北机实在程门显，何事庐山不细研。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十","author":"高攀龙","text":"闻道如何可夕死，死生原是道之常。\n不闻有昼可无夜，几见无阴只有阳。\n道在何从见寿夭，心安始可等彭殇。\n更于此外求闻道，蹋遍天涯徒自忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十一","author":"高攀龙","text":"万物同生形不同，犬羊人性岂相通。\n因观物性明人道，始信人伦是圣功。\n仁义非于明察外，愚蒙偏蔽事为中。\n虽云此理几希甚，两字金针是反躬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十二","author":"高攀龙","text":"天载无形触目真，羲皇两画写其神。\n六爻虽列上中下，一物彊分天地人。\n读去还知非汝密，悟来方始是家珍。\n试看爪发生生处，何但枝头可覛春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十三","author":"高攀龙","text":"见易更须知用易，圣人原只用中庸。\n刚柔见处几先吉，中正亡时动即凶。\n能惧始终皆免咎，存诚隐显悉成龙。\n莫言卜筮用为小，动静须占是易宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十四","author":"高攀龙","text":"人心偏倚道心中，凡念回旋即圣功。\n精是不迷如日照，一为不二与天同。\n笃恭为执辰居所，未发为中水不风。\n圣智聪明收敛尽，寂然不动感而通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十五","author":"高攀龙","text":"孝是修行无价珍，此身在处即吾亲。\n一禽一草非时剪，五辟三千律可论。\n仓德饮和供菽水，朝乾夕惕省昏晨。\n不分富贵与贫贱，大孝光天是守身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十六","author":"高攀龙","text":"事事精详是与非，紫阳以此示全归。\n初经勉彊须坚苦，渐近天然妙入微。\n精义无过能择善，入神还只是知几。\n须知圣学无多法，尺寸基培万仞巍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十七","author":"高攀龙","text":"言行须从拟议成，不从拟议失权衡。\n拟言本自三缄慎，议动繇于百炼精。\n率意岂真为率性，争先或恐是争名。\n须知变化方为易，变化原从拟议生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十八","author":"高攀龙","text":"朱陆当年有异同，祗于稽古稍殊功。\n存心自合先知本，格物无过要识中。\n六籍漫从卤莽过，一灵那得豁然通。\n前贤指示皆精切，后学无讹是晦翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其十九","author":"高攀龙","text":"精气为躯造化功，游魂为变浩无穷。\n如何谓死为灭尽，反落禅诃断见中。\n神化自然称不测，有无不著是真空。\n莫将空字谩归佛，虚实原于微显同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午吟 其二十","author":"高攀龙","text":"学人须自立根基，三戒当先谨独知。\n无分少壮老异境，一于财色斗严持。\n镇重常如五岳峙，防危更似九河堤。\n大廷暗室心如一，玉粹金精体不亏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至水居","author":"高攀龙","text":"何事驱车缁洛尘，归来烟水味逾真。\n寒塘古岸五衰柳，落日秋风一老人。\n兀坐冥然天地古，观书恍尔性情新。\n未须蒿目忧时事，闻道明君信直臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水居题壁","author":"高攀龙","text":"涧水泠泠声不绝，溪流茫茫野华发。\n自去自来人不知，归时长对青山月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居 其一","author":"高攀龙","text":"日煖风微杨柳斜，桃华处处点村家。\n谁人此际能閒坐，载酒东皋醉落霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居 其二","author":"高攀龙","text":"桂露瀼瀼欲湿衣，早乘残月出柴扉。\n天清木叶随风起，閒看流云坐钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居 其三","author":"高攀龙","text":"小屋深深墐北房，享荼煨芋地炉香。\n主人暴背书轩下，一卷羲经至夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"高攀龙","text":"翠霭青峰欲上楼，绿杨一带野帆幽。\n携琴时向沙边坐，閒对春风数白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛南县薛厚论妻南氏殉夫烈节","author":"高攀龙","text":"峻如南岳千盘秀，洁比中峰万仞华。\n薶骨山中应化玉，飞魂天外亦成霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"高攀龙","text":"尧舜垂裳恭己时，天然真色复何为。\n欲知性善无言妙，此处端倪尚可窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和叶参之过东林废院 其一","author":"高攀龙","text":"满目蒿莱三径荒，秋蛩吟处旧升堂。\n党人不死倾葵藿，一饭君恩不可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和叶参之过东林废院 其二","author":"高攀龙","text":"竹径茅斋此日居，藤稍橘刺欲教祛。\n白云片片浴流静，黄鸟声声树影疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和叶参之过东林废院 其三","author":"高攀龙","text":"城头曾筑小方台，四望长空万象恢。\n今日荒墟惟草色，春风依旧有情来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赏华","author":"高攀龙","text":"春风无恙一登台，犹见桃华满径开。\n无计可留华再住，明年华发约重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得薰风入菡萏","author":"毕自严","text":"微风起青蘋，吹入芙渠畔。\n翠盖相招摇，红妆争历乱。\n伫观绰约姿，忽讶天香荐。\n中有鹓鹭群，唼喋时隐见。\n高怀忆茂叔，昕夕起留恋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夹竹桃","author":"毕自严","text":"竹操一何坚，青青冬不渝。\n桃夭一何艳，灼灼春华敷。\n尔且兼得之，绿葩间红跗。\n三岐依彩槛，五出曜琅玕。\n竹兮饶媚态，桃兮耐岁寒。\n回风聊萧瑟，朱翠舞珊珊。\n余本素心人，常作嘉卉想。\n兀坐手一编，长日恣欣赏。\n夜月照前除，对尔更神爽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月季花","author":"毕自严","text":"花开惟一度，尔独占四时。\n几番新雨后，绿叶发华滋。\n春明伴桃李，夏至映榴葵。\n秋争霜菊艳，冬斗雪梅姿。\n高低互隐见，深浅总葳蕤。\n节序暗中递，红颜无老期。\n灿灿夺朝霞，而堪荐玉卮。\n聊植中庭畔，悠然慰我思。\n安得骚人笔，烂漫写新辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河东请告归涂咏怀","author":"毕自严","text":"行年四十六，通籍念复三。\n自揣无寸补，滥竽至藩参。\n驰驱南北遍，世味短长谙。\n况兼愁病侵，久已万虑澹。\n双九不我待，五斗安足淹。\n盛名难副实，造化忌取贪。\n一朝仗慧剑，抉破蚤抽簪。\n从兹事南亩，优游老岩嵁。\n积书富万卷，俯仰恣幽探。\n此身轻蝉翼，苦去乃得甘。\n止足远殆辱，汉代有高谈。\n进退当自决，任人笑予憨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩惺庵中丞久视楼","author":"毕自严","text":"老氏育先天，发皤颜若童。\n驾言西极游，紫气满关中。\n绪出五千言，著名河上公。\n犹龙仙驭远，谁复叩玄风。\n畔援汨天真，优游伏鸩戎。\n妍媸浑莫辨，五色令人懵。\n所以羡长年，而无久视翁。\n中丞蚤闻道，泥滓起冥鸿。\n中外勋名满，飘然晦厥躬。\n辞荣赋考槃，问道慕崆峒。\n避俗营真境，楼居焕以崇。\n社中同志侣，杖履镇相从。\n卉态看皆幻，心柔气亦融。\n灵光葆太和，返照见真空。\n澹漠神愈王，希夷体自充。\n机缘日以啬，性命日以丰。\n朝彻澄如水，谷神寿比嵩。\n我来登此楼，俨入清虚宫。\n快聆长生秘，欣承鍊性功。\n俯瞰名利客，撩乱扑春虫。\n松柏与龟鹤，会极数有终。\n独兹久视诀，历劫将安穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留计移疾获请咏怀","author":"毕自严","text":"观光忝昔幸，解组嫌今迟。\n自嗟姜桂性，兼之蒲柳姿。\n七尺猥承匮，四牡几载驰。\n晚荷储糈寄，寻缀纪纲司。\n未几叨敷扰，奚以报鸿慈。\n禄厚责弥重，汲深绠莫支。\n筋力空殚竭，膏肓悲暗滋。\n匡弼况未效，其如青史嗤。\n坐是乞鉴湖，烟水聊自怡。\n窃庆拜明纶，从此免素尸。\n贝丘宵梦绕，岱麓春云垂。\n华膴非所愿，衡泌可乐饥。\n永矢南郭隐，长谢北山移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送康庄衢少司农擢南大司寇","author":"毕自严","text":"知君莫如我，送君难为别。\n岂无阳关情，未语喉先咽。\n念我发云短，持筹担莫辍。\n物力值寒俭，欲舞肘已掣。\n天幸假我公，埙篪如夙结。\n夷险与同舟，浅深共厉揭。\n谈笑亦先忧，念兹在涸辙。\n肝胆照松筠，金石镌齿舌。\n朝对巫山云，暮见峨眉雪。\n元气浑浩溟，风韵自爽洁。\n法曜忽南移，帝简在名杰。\n旧都繁华地，雅镇惟素节。\n谁谓汤网疏，明允可立折。\n九府泉流清，三章约法晰。\n惟此有本人，纲整而目截。\n天阙山最高，秦淮水更冽。\n山水有知音，声价为君设。\n北指是斗杓，袖然冠九列。\n钧衡岂相私，霖雨待手挈。\n惟祝君此行，得情慎勿悦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石隐园怀古","author":"毕自严","text":"天地为蘧庐，光阴成驹隙。\n名誉等浮沤，冠簪亦陈迹。\n世网空劳劳，礼法殊役役。\n所以贤达士，雅有烟霞癖。\n山简迷目花，赞皇醒酒石。\n李白桃李园，谢朓青山宅。\n缔思古人风，堪作今人格。\n余今凋朱颜，何须恋赤舄。\n抗疏谢轩冕，跣足践蓬藋。\n筑屋治场圃，宾云友泉石。\n赋性本清真，秉心矢皓白。\n阶前饶葱茜，架上富坟籍。\n黄鸟鸣林皋，蠹鱼侵几席。\n醴酒恣欢娱，山蔬供烹炙。\n焚香理素书，悬榻迎山客。\n维石性最坚，从不受磨折。\n余隐誓效之，腐鼠安能嚇。\n不羡公与侯，何心仙与释。\n宁知春与秋，并忘朝与夕。\n斯为石隐园，吾以适吾适。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]