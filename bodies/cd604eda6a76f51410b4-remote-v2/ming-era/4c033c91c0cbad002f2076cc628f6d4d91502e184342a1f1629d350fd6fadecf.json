[{"title":"邑侯龙坡黄公秋科应召入帘","author":"张天赋","text":"循吏囊中脱颖尖，文章政事两相兼。\n渊源家学无双美，山斗声名有具瞻。\n薇省檄催天宿驾，棘闱班列水晶帘。\n宁昌士类甄陶下，鹗荐奚容祝再三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝成祝寿","author":"张天赋","text":"整饰梵宫效我劳，云房待漏集英豪。\n山呼声彻低阊阖，香雾清分湿笏袍。\n列爵岂云南殿远，举头便见北辰高。\n万年君子昭明戒，一统乾坤入浪淘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为朱少溟代铭钟","author":"张天赋","text":"仙境人间有路通，西江云外远来钟。\n少溟助我生花笔，古刹从今作古风。\n文物声名归甄录，乾坤海岳共昭融。\n白头楚客归来晚，老鹤玄猿喜再逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李府清园陈别驾归田咏六首录三首 其一","author":"张天赋","text":"云歛长空月转闾，衡门如水梦安舒。\n边防猷壮周天老，竹马风高□□□。\n塞草可怜春捲绿，花村不见吏催租。\n江莼一旦兴归思，八邑号留动念无。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李府清园陈别驾归田咏六首录三首 其二","author":"张天赋","text":"未了乾坤一局棋，白云桑梓梦相糜。\n无情草木皆知德，千里豺狼已息威。\n世态自怜还自笑，道傍谁是更谁非。\n罗浮一点中天月，光送台前五马归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李府清园陈别驾归田咏六首录三首 其三","author":"张天赋","text":"治郡功勋仰大成，古今王道揔平平。\n九天雨露更时润，千里桑麻尽力耕。\n和拂柳风春荏苒，清高梅月影斜横。\n高深德泽同山水，岭海何时歇颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次白沙师祖和吴明府韵奉陶令三首录二 其一","author":"张天赋","text":"遑遑宵旰几曾閒，貌瘦怜公未解颜。\n强梗喜看藏虿毒，穷厓多赖济艰难。\n棠阴白日偏摇绿，暮夜黄金不到关。\n春满江山留百里，孤舟明月放歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次白沙师祖和吴明府韵奉陶令三首录二 其二","author":"张天赋","text":"化工无迹自安閒，入口刀圭可驻颜。\n观水却怜如水少，看花容易种花难。\n用停炉火抽添注，跳出乾坤梦觉关。\n老鹤巢松明月上，海头光逐暮潮还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢林吾滨先生过访","author":"张天赋","text":"謦欬深承洗渴尘，草堂秋色满庭新。\n八闽声价如山重，万古斯文一脉亲。\n天地纲常归范冶，蛟龙云雨起江滨。\n怀君几夜神交处，纸帐梅花入梦频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乔迁送别邑侯黄龙坡 其一","author":"张天赋","text":"天风万里忽移幢，酌水江头荐我公。\n借寇每怀春有脚，迁莺今恨惠无终。\n梅花香衬人如玉，金勒光摇马似龙。\n别后青霄遥送目，荆门郢树月当空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乔迁送别邑侯黄龙坡 其二","author":"张天赋","text":"弦歌声闹正绸缪，宿驾天迁动别愁。\n留犊悬鱼遗厚爱，攀辕卧辙叹痴谋。\n斟残玉斝情难继，唱彻阳关泪欲流。\n翘首此行摅底裹，陆沉经济展神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元宵","author":"张天赋","text":"天意从人放暖晴，鳌山灯灿夜风轻。\n笙歌远隔穷厓淑，春色偏从閒处生。\n五夜帝城天不禁，遐方边境柝还声。\n阿谁桃李门墙盛，岁岁春风次第迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄支隐士","author":"张天赋","text":"华山高枕卧希夷，花落花开总不知。\n鼎沸火销丹熟候，月明风送鹤归时。\n刘伶每作三年醉，王质长看一局棋。\n仙掌九霄多玉屑，欲凭山鬼借疗饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次东粤张掌教春日韵 其一","author":"张天赋","text":"路到分岐情似苦，时逢开泰物皆春。\n江城椒酒堪酬节，驿路梅花可寄人。\n试把兔毫挥翰墨，谩劳鸡骨占年晨。\n儿童拍掌熙明景，白发何堪老此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次东粤张掌教春日韵 其二","author":"张天赋","text":"酒到令催方打快，诗当兴到便生奇。\n傍人山鸟歌春调，垂露岩花滂水湄。\n光吸谪仙杯里月，清交明道柳边飔。\n虚舟视世浑无我，散发中流自坦夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次东粤张掌教春日韵 其三","author":"张天赋","text":"脚债百年浑未定，烟花六合却无涯。\n佳山丽水随情款，晴日和风纳岁华。\n啼鸟立梢春对语，游鱼到处水为家。\n罗浮还忆醉仙子，红脸朱唇衬晚霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登镇江金山寺","author":"张天赋","text":"江心突兀应天心，莫则高兮莫测深。\n鼋听梵音多出没，花含烟雨半睛阴。\n风摇古木玄猿笑，月照寒潭万劫沉。\n随忆十年前夜过，青天白日喜登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丰城剑江驿怀西塘岳翁二老之作","author":"张天赋","text":"炊臼堂年以塞翁，乔门喜我更乘龙。\n庭闱菽水春生色，宗庙蘋蘩岁献恭。\n冷暖半生多阿母，显融此日忆先公。\n剑江佳气冲牛斗，斜倚孤篷诉寸衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张家坊以道浏阳寓宝林寺遗浏上人","author":"张天赋","text":"湘水衡云道路曼，暂投琴剑憩禅关。\n一檐花影一檐竹，四面湖光四面山。\n青野谩酣黄鹤梦，白云常伴老僧閒。\n孤城未入浏阳境，民瘼原来想一般。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樟树取道浏阳遇聂凤冈惠酒赋此谢之","author":"张天赋","text":"笑浪长驱入楚城，芙蓉江上放秋英。\n抱琴到处知音少，倾盖河人眼着青。\n梅咏我惭廷秀业，天涯谁泯项斯名。\n宦情耿耿浏阳境，刍牧求全副圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵自悼","author":"张天赋","text":"落落浮生恨不晨，浪看风景几番新。\n日边红杏皆增色，江上芙蓉未识春。\n季子惭无田负郭，范丹甘受甑飞尘。\n白头老吏浏阳马，鞭向当年汉辙循。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次惠安张后江掌教济宁韵 其一","author":"张天赋","text":"一种灵根楚畹兰，香风分送到江湾。\n红妆已领青鸾喜，白发空惭野叟漫。\n人世半遭诗酒累，乾坤谁透利名关。\n凭君何处堪消目，翘首东头望泰山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次惠安张后江掌教济宁韵 其二","author":"张天赋","text":"自笑空担楚客名，衡山岳麓未曾经。\n道吾遥想骑黄鹤，浒子徒思过洞庭。\n却敌日中搥鼓进，赈饥夜半唱筹声。\n极惭万里孤臣拙，驽力无缘答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送东峰何节推北行","author":"张天赋","text":"欲赆无钱愧我囊，祇凭长揖送河梁。\n孤臣万里朝天子，遗爱千年在岳阳。\n泉石岂容閒杖履，国家端属振纲常。\n殷勤分付桥头柳，夹道风流到帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送宗兄南林北行","author":"张天赋","text":"骊驹扰扰闹离筵，送客观光到日边。\n风雨百年家国话，云程万里杏花天。\n乾坤人物无今古，车马风尘看后先。\n他日成功在何处，丹青辉映看凌烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济宁登太白楼忆友人李和山","author":"张天赋","text":"今古何人最上流，乘风此日快登楼。\n一川花柳情怀旧，六合烟云眼界浮。\n力士已曾输跪膝，夜郎谁复望归舟。\n和山踪迹知何处，兴在白云天际头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过雄县","author":"张天赋","text":"海上飘来万里篷，岸登今过县之雄。\n一湖春水桃花浪，夹岸沙堤杨柳风。\n琴剑半生踪迹杳，江湖此日庙廊通。\n举头咫尺天门近，拜祝重华日正中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮安黄河舟中避风寄天仙火星庙","author":"张天赋","text":"笑入天仙境界奇，紫枝瑶草半离披。\n禅床静听功夫杂，丹灶抽添火候移。\n风软柳梢莺啭滑，月明松顶鹤归迟。\n乘云万里罗浮客，邂逅空怜识面眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮安大雪","author":"张天赋","text":"二月十四淮安雪，彻望嵯峨白玉楼。\n叫月子规含夜恨，怯寒柳眼带春愁。\n参差四野皆银树，错杂黄河尽宝舟。\n谩笑老天欠收拾，琼花轻放逐风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石桥世医卷","author":"张天赋","text":"杏满庐山万树红，飞花流水石桥东。\n宅前奔犬寻朱孺，车上悬蛇学华公。\n橘井香泉春不断，稚川丹灶火长烘。\n试看洗药桥头水，谛认原来一样同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟冬送十八童生谒先师庙","author":"张天赋","text":"十八衣冠聚泮黉，天教喜鹊报声声。\n门墙栽植盈桃李，罗网收来总俊英。\n遥拟元功同佐汉，更犹仙子并登瀛。\n清浏文运应回泰，争继圭斋播令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潦浒市次梅花山人壁间韵","author":"张天赋","text":"匹马穿云绕曲坡，秋声天外雁横过。\n万年宝鼎归姬运，五色云龙驾馺娑。\n雨后应知山有色，风恬始息海扬波。\n何时醉倚棠阴绿，回听黎元鼓腹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"往长沙府送浏阳庠士入应督学岁考至东屯渡遇邦伯夏凫溪先生命回县治事已对应公请免而委同寅东嵎李三尹代之先是自十九夜发舟至廿二通宵烛花不落光焰非常果得此报喜吟一首","author":"张天赋","text":"客舟连夜烛开花，气魄辉煌实可誇。\n顶盖团团如月上，傍生冉冉带风斜。\n遥思太乙浮莲叶，更想张骞泛汉槎。\n驻足东屯听消息，凫溪辞我入长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次刘野航训韵","author":"张天赋","text":"白日怀君写寸私，江花江草让江离。\n凤凰允矣今时瑞，山斗巍然后学师。\n蔼蔼融和皆雨露，循循雅饬尽皋夔。\n香飘兰室无穷处，咫尺门墙慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临江赠归善大尹陶双洲年兄","author":"张天赋","text":"远抱孤琴未解囊，子期倾盖便相忘。\n五云共领明时宠，野草深惭八桂芳。\n指日鹅城沾雨露，他年铁面带风霜。\n太平天子中兴佐，赫赫功名竹帛扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰复过宝应湖","author":"张天赋","text":"湖水茫茫一叶舟，壬辰更及甲辰游。\n问津徒抱穷源志，泣玉空怜为国谋。\n纸帐飘摇千里梦，野鸡撩乱五更愁。\n鸳鸯自别天南北，相对青山唱白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次双湖共酌金华酒韵","author":"张天赋","text":"乾坤嘉会斯文酒，与子同欢实偶然。\n大道岂销秦火里，好怀多在柳风边。\n须知一贯原无贯，莫向先天更觅天。\n何日振衣千仞上，乘风来往任翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次后江韵答双湖掌教停舟不行","author":"张天赋","text":"懊恨盈怀此木兰，日移跬步两三湾。\n邹邦鲁壁空挨过，湘水衡云远望漫。\n昼永浪歌虚岁月，夜清徒梦到乡关。\n灵舟近喜逢仙客，拭目孤篷仰斗山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰承乏来浏重脩欧阳圭斋先生南山书院次先生韵一首","author":"张天赋","text":"凤诏飞来墨未乾，南阳龙卧岂能安。\n乾坤局面随时异，鱼水君臣自古难。\n华国文章名望重，逼人正气色芒寒。\n我来瞻拜如知己，祠宇更新改样看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄刑科罗给事近山先生","author":"张天赋","text":"太平天子坐朝堂，紫阁黄扉白昼长。\n四海共瞻尧日月，百年重睹汉冠裳。\n金兰昔日誇同利，朝野今朝恨异方。\n翘首楚天徒怅望，一缄飞递入南昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀","author":"张天赋","text":"白发潇潇忘老身，陶然无虑任天真。\n浅青掩赪山辞臈，嫩绿摇风柳放春。\n淑气洪钧催宿鸟，狂歌新酒醉幽人。\n孔颜何处寻真乐，沂水春风气魄新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲冬朔早山行","author":"张天赋","text":"早起驱驰雪未消，半生踪迹叹徒劳。\n江山已觉眼前异，笔砚还将袖里韬。\n对镜谩惭霜鬓满，纵帆犹喜浪头高。\n临风笑问老梅树，春信何时报草茅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄大埔胡大尹","author":"张天赋","text":"星斗文章仰老成，庐山飞舄越山城。\n邻封有幸同沾化，循吏何人独擅名。\n明月一天无犬吠，清风百里有琴声。\n鱼书便达情犹歉，何日登龙慰识荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刁时泉会试","author":"张天赋","text":"雷雨充盈动越南，神龙一跃起刁潭。\n九霄变化功无际，四海沾濡雨尽甘。\n天禄瑞光来太乙，唐虞景象喜涵三。\n野人鼓腹穷檐下，林密山深乐旦耽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中送李澄江会试儿喻代饯","author":"张天赋","text":"庄上梧桐结实时，翩翩丹穴凤来仪。\n一天精彩昭文瑞，八表风声仰世奇。\n神物冲霄舒健翮，虞庭叶律际佳期。\n病夫目极阳关下，敬遣豚儿饯一卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独坐写怀","author":"张天赋","text":"兀坐幽亭秋气清，神光南面喜新晴。\n芙蓉冷处自颜色，蟋蟀静中閒语声。\n翠盖潇疏金错落，寒泉溜亮玉琮琤。\n无言岁岁黄花约，笑把茱萸酒漫倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钓台仙迹","author":"张天赋","text":"洞口溪头古钓矶，仙翁坐迹绝真奇。\n清风明月曾同伴，翠藓苍苔永不迷。\n云影天光波上下，桃花柳叶岸东西。\n何年乘鹤杳然去，春满人间鸟乱啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游洞口钓台漫兴","author":"张天赋","text":"洞口桃花几落开，乾坤人物已尘埃。\n昔年知是谁持钓，今日还教我坐台。\n红树枝头风袅袅，绿杨影里鸟喈喈。\n狂夫白首长沙客，拂破浮云跨鹤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅八月约大田胡同登钓台次旧韵 其一","author":"张天赋","text":"啸侣排云上钓矶，寒潭秋水色清奇。\n山林有约蹊初辟，朝市无心路欲迷。\n乐事今朝追洛下，仙踪终古擅名西。\n柳梢小鸟知人意，掷破金风弄巧啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅八月约大田胡同登钓台次旧韵 其二","author":"张天赋","text":"扫却苍苔坐满矶，青山绿水送清奇。\n且同白酒盈樽饮，莫惹红尘两目迷。\n笑舞婆娑歌洞口，酌归酩酊过湖西。\n夕阳牧笛声嘹亮，惊起寒鸦古木啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次洞口桃花几落开之韵 其一","author":"张天赋","text":"江上芙蓉带笑开，钓矶光润净无埃。\n寒潭皎皎涵秋月，芳草萋萋绕古台。\n满眼行云甘雨细，数声啼鸟好音喈。\n笑看舞鹤留人醉，座上清风次第来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次洞口桃花几落开之韵 其二","author":"张天赋","text":"洞门雨歇乱云开，万里秋旻绝点埃。\n几树青风彭泽柳，一天明月子陵台。\n栖松幻鹤安身稳，隔岸黄鹂好语喈。\n归去妻孥笑相问，无鱼空坐钓台来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯春游国泰岩 其一","author":"张天赋","text":"春日寻游国泰岩，岩花垂露滴纤纤。\n千峰拥后松遮绿，一带当前水绕蓝。\n昼永野云迷鹤榻，夜清明月浸寒潭。\n七旬踏破神仙路，打约登临更再三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯春游国泰岩 其三","author":"张天赋","text":"天上清风山上岩，红尘隔断绝毫纤。\n春容艳冶花如锦，秋色澄鲜水似蓝。\n地拥金莲峰叠叠，云迷玄洞府潭潭。\n霍山太乙兼麻石，何处人间更有三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯春游国泰岩 其四","author":"张天赋","text":"东北从来有古岩，笑收光素靡遗纤。\n归巢老鹤千山梦，攀木玄猿两手蓝。\n万里风云腾凤翮，九天雷雨震龙潭。\n豪怀一曲梅花调，谩把冰弦试弄三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆麻石岩次前韵 其一","author":"张天赋","text":"谁将灵斧劈灵岩，幻出蓬莱极巧纤。\n莺弄笙簧声合调，山开图尽色拖蓝。\n白云匝地迷丹灶，黄蝶穿花落碧潭。\n麻石霍山兼国泰，清虚光景一无三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆麻石岩次前韵 其二","author":"张天赋","text":"外拥旋螺内碧岩，梵钟云外落声纤。\n鸟啼林壑如歌调，雨洒冈头点翠蓝。\n松顶清风鸣夜瑟，花梢香露滴寒潭。\n三岩堪恣平生乐，海上从渠岛有三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游霍山太乙岩次前韵 其一","author":"张天赋","text":"独上崔嵬天际岩，茫茫海面望中纤。\n东头桃树西头李，今日张颠昔日蓝。\n乔木千寻巢老鹤，飞泉百尺落寒潭。\n他时拟向寰中立，俯仰乾坤共作三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游霍山太乙岩次前韵 其二","author":"张天赋","text":"飞上循州第一岩，飘飘忘却此身纤。\n心从此地堪行乐，桥在何方唤作蓝。\n野地野云迷野榻，秋霄秋月落秋潭。\n尊前倾倒浑无算，不必拘拘大道三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游霍山太乙岩次前韵 其三","author":"张天赋","text":"乾坤开辟此灵岩，垂露空中石掌纤。\n山霁云烟千丈带，峰西苔藓一堆蓝。\n月明洞口钟停杵，风捲桃花浪起潭。\n太乙一中天造化，一能生二二生三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题大埔户年兄曾梅平寇录三首录二 其一","author":"张天赋","text":"循良烨烨吐才华，满县弦歌满县花。\n四野沾濡逢好雨，一天清白落孤霞。\n高名在昔回山斗，利器于今益国家。\n三寨笑看齐解甲，栽桑栽柘又栽瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题大埔户年兄曾梅平寇录三首录二 其二","author":"张天赋","text":"风雨昔曾家国话，海滨今听武城歌。\n一方按堵月当户，三寨投戈雨满蓑。\n有脚阳春随处到，无边功德尚厓摩。\n祇怜借寇天违愿，骢马潇潇振玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]