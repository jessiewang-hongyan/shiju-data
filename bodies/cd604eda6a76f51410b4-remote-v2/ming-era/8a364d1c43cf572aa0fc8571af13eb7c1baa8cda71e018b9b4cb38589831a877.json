[{"title":"神乐观会次邓司徒韵","author":"周伦","text":"幽径霓裳列羽仙，仙人煮茗瀹幽泉。\n苍梧翳翳栖鸾树，青野迢迢养鹤田。\n棋局对人聊待客，笙歌行酒漫巡筵。\n山房胜赏消长昼，未必桃源是洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苦雨","author":"周伦","text":"雨过黄梅水满塘，野萍随涨翠浮堂。\n药阑徙倚鱼翻鬣，花径閒行鹤理裳。\n愁借酒杯聊自况，笑凭棋局竟相忘。\n捲帘忽见西山色，鸦背林梢带夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清凉寺避暑次吴宁庵韵","author":"周伦","text":"殿阁清凉接太空，薜萝深处隐花宫。\n登临此日琴樽在，指点前朝感慨中。\n紫雾昼腾钟阜气，沧江时引建康风。\n絺衣羽箑堪乘兴，未必东山羡谢公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送朱拱辰还昆","author":"周伦","text":"故人千里相逢日，公暇时登江上台。\n忽买归帆向湖海，可堪羁客送樽罍。\n诗中景象凭谁写，舍后林扉懒自开。\n紫蟹香粳莫深恋，秋风还拟挂帆来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"八月十五夜月","author":"周伦","text":"露坐晴空禁漏寒，仙人飞镜上云端。\n银蟾汎汎光流白，金粟纷纷子落丹。\n千里酒杯同潋滟，万家华彩各团圞。\n搴衣儿女遥南指，目极征鸿共倚阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斋居","author":"周伦","text":"斋居长日爱幽偏，筠馆清虚更可怜。\n碧袅檀烟风细细，翠摇松影露涓涓。\n雁书塞上何由达，龙驾云中定巳旋。\n夜半漏声灯月里，玉珂天路佩珊然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿管儒珍方伯七十","author":"周伦","text":"方岳栖迟楚甸安，更推高谊早休官。\n辞金未道前无震，烂手缘知后有宽。\n松径试持新玉杖，荷衣无换旧犀鞶。\n横塘万树梅花发，一醉长春取次看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同邓司徒饮蒋中丞三友轩次韵","author":"周伦","text":"竹阴斜日满台青，席地何烦锦作棚。\n翻覆棋枰惊世态，倡酬诗句话平生。\n松风池上听游鲤，梅雨林梢起坐莺。\n漫尔开轩对樽酒，清和光景岁寒情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王兵侍质庵致仕","author":"周伦","text":"十五题封乞罢官，再陈方荷圣恩宽。\n昔年南北尘初洗，今日山林梦始安。\n村里人归添酒伴，客边秋及几花看。\n济时秪恐推耆旧，矍铄还须上马鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新晴宴归次韵","author":"周伦","text":"忽收山雨放新晴，春宴归来欲二更。\n花炬分移天路迥，绣袍沾拂露华轻。\n兴高未觉良宵永，诗就何惭太瘦生。\n骑入天街徐按辔，行瞻宫树斗杓横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"周承德除养利州守即乞致仕","author":"周伦","text":"半百灯窗未放閒，一官初檄遂封还。\n眼明秋水雏丹凤，身衣春云绣白鹇。\n天地尘埃人世外，江山风月笑谈间。\n迷途自讶为官在，两鬓年来己渐斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送洪弘齐都宪考最北上","author":"周伦","text":"镇重留都奏最时，正逢仙仗赐鸠期。\n霜威坐见台乌凛，野兴行将海鹤随。\n语燕风樯春渡稳，游丝晴旆午光迟。\n庙堂此日珍耆旧，泉石何劳起梦思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"己卯还自留都九日同顾孔安李仁山并儿子凤鸣登卧云阁次韵","author":"周伦","text":"谢却尘途半日忙，卧云同上旧游堂。\n凭虚树杪江光见，返照峰前塔影长。\n笑整危冠笼晚鬓，醉将衰面助春阳。\n十年九日千山外，何处亲朋共此觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯下赏菊","author":"周伦","text":"更漏沈沈客满筵，旋移黄菊素屏前。\n即开尊酒聊乘兴，乱发灯花若斗妍。\n看去醉疑蒙紫雾，折来香欲动华颠。\n相看记得长安夜，对影题诗又五年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡江","author":"周伦","text":"钲鼓声高江雨收，锦帆轻飏渡江舟。\n金焦不负青春色，天汉遥分碧海流。\n旅梦烟霄双过雁，虚名天地一浮鸥。\n朝来无限瞻云思，几度回看北固楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登歌风台","author":"周伦","text":"歌风廿载登台兴，此日还停北上船。\n沛井尚存终自冽，汉碑中断已重镌。\n白沙碧草犹春色，落日荒亭几暮烟。\n总道当年思猛士，韩良何事学神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张都宪敬亭还宣城","author":"周伦","text":"解组归来欲避名，翻传舆廪下承明。\n兴从泉石诗俱逸，身远尘嚣梦亦清。\n叠嶂峰前春树渺，黄金台下曙云平。\n谢家兰玉森森起，回首犹馀报主情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大理寺芍药次韵","author":"周伦","text":"系马槐阴午未归，翻阶红药正芳菲。\n开帘白日影摇座，绕砌和风香袭衣。\n采石载将醪正美，东瓯携得蟹仍肥。\n从容退食还赓咏，棘寺门閒讼牒稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"一云次王守溪阁老韵","author":"周伦","text":"石磴崔嵬路折旋，崎岖历尽是平田。\n高林忽送催诗雨，深涧遥分悟道泉。\n僧为知名如旧识，地疑曾到岂前缘。\n万竿修竹参天起，欲借琅玕纪岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天平山","author":"周伦","text":"十年不到天平寺，云白秋清山更奇。\n落木声中森万笏，古台高处有穹碑。\n鸣钟未入支郎院，下马先瞻范相祠。\n祠下云泉流不住，悠悠千古动遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病得凤鸣家书","author":"周伦","text":"直北关心病卧时，无端消息尽堪疑。\n白鸿一声叫已急，黄犬何处来翻迟。\n电雷昨夜忽复静，雨露兹晨还自乘。\n沈疴浃月顿觉解，觅纸起坐题新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游清凉寺二首 其一","author":"周伦","text":"树里僧鸣客到钟，翠微深处系青骢。\n九天日月瞻依外，万井烟花指顾中。\n王气春围丹凤阙，卿云时护紫霄宫。\n省台无事休衙早，此日登临有数公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游清凉寺二首 其二","author":"周伦","text":"春日春山偶出游，山扉晨启径松幽。\n花宫日丽金轮转，鹫岭云开画拱浮。\n潭影浸空高塔午，泉声吹雨半林秋。\n澄江万里鲸波静，碧柳青蒲销战舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江巡晓行","author":"周伦","text":"缭绕江流逐岸斜，西来巫峡海东涯。\n竹帘篷户船船月，山馆云亭处处家。\n波净试摇天上橹，风恬真隐浪前花。\n天边绛节予方领，银汉如乘八月槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过东梁山西梁山","author":"周伦","text":"东西万古石梁存，潮落潮生几处痕。\n一水中流通鹢棹，两山相向过龙门。\n楼台依约高藏寺，烟树迷茫下有村。\n风便未登聊问俗，诗成秪自引壶尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅视水操","author":"周伦","text":"龙江阅视水军营，十万貔貅画鹢轻。\n鸟阵云盘秋宇净，鲸波风定早潮平。\n三山遥接旌旗动，五夜初严鼓角声。\n野色渐分天欲曙，扶桑东望紫霞横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜","author":"周伦","text":"一池霜后净无萍，影落云天万里明。\n敧柳渐疏风外影，过鸿遥曳塞边声。\n萤光篝火寒无燄，蛩语机丝懒亦惊。\n底事夜来清不寐，月明铃柝震高城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次答静斋巡抚见寄","author":"周伦","text":"池上秋生树杪声，匆匆夜席话君行。\n青尊拟罄三山酒，白日孤悬万里情。\n五两风帆心共远，九华云物思俱平。\n舟从采石楼前过，倾圮犹馀太白名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"红心驿","author":"周伦","text":"行行长路夕阳催，望望红心探马来。\n腊意未舒堤上柳，春光先著陇头梅。\n青烟林匝栖乌下，白雪坡盈猎骑回。\n两日和风上貂帽，壮颜无待玉壶开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"利国监驿","author":"周伦","text":"坐倚南窗对铁山，铁山无冶旧名閒。\n谯楼驿舍孤村外，滕国彭城两界间。\n尘路崚嶒天漠漠，石梁敧断水潺潺。\n何人为国输筹策，冀马重开十二闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十一月廿六日拜南刑部次月廿七日陛辞寓曹氏园亭","author":"周伦","text":"霜天未解潞河冰，暂向城南一驻旌。\n云漏尚惊高阙报，风埃聊对野塘清。\n不将门帖通台省，漫有诗篇记姓名。\n时枉诸公遥问讯，天涯谁道近春明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南寺读毛文简诗有感","author":"周伦","text":"旧游曾记榼殽蔬，屈指重来十载馀。\n珠树玉梅春似昔，野情僧面老犹初。\n画楣文墨皆陈迹，青草蛟螭总漫墟。\n莫笑随缘西竺语，一茶清世有谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卫河怀陈佥宪","author":"周伦","text":"清源秋夜下长河，独客孤舟月色多。\n浊酒未缘倾宿好，高才那得听新歌。\n南都梦绕同台署，东阙天教接佩珂。\n忽忆毗陵旧分袂，薰风回首廿年过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重到法司","author":"周伦","text":"贯城门迥未须寻，光景依稀昔似今。\n杨柳绿乘春路远，薇花红放午堂深。\n无边跃鲤翻清沼，不断鸣鸠唤紫林。\n何意重来图画里，丹年无补愧初心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日","author":"周伦","text":"九日郊原喜放晴，黄云满地正秋成。\n松山落叶随风下，花径浮香逐马行。\n远水接天开四界，高林栖寺隔重城。\n醉来移席冠犹整，安得风流似孟生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"官舍","author":"周伦","text":"官舍真兼吏隐清，绕堤高树水泠泠。\n嘉宾不厌频携酒，别院犹堪小结亭。\n天际青山排闼至，花间黄鸟枕书听。\n省堂多暇休衙早，迟日春风静掩扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东园燕集用前韵","author":"周伦","text":"一庭风雨送新寒，公子留宾欲尽欢。\n深酌黄金行酒斝，俄传白玉送春盘。\n城头夕漏频催柝，烛下歌钟巧弄丸。\n命驾要归归未得，枭卢相博兴还宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中书怀再用前韵","author":"周伦","text":"病馀虽较怯风寒，坐拥炉薰也自欢。\n卧篆木鱼谁剥击，闭门窗虎独回盘。\n青囊解缚收诗草，碧瓠随题简药丸。\n风色湖山还好未，云司三日簿书宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄陈相鹤","author":"周伦","text":"重忆山人閒到老，移居又住玉山西。\n尘嚣不到青松杪，鸥鸟常来白石溪。\n醉敞絺衣朱鹤伴，笑簪高帽玉鸠齐。\n予归拟结谈诗社，是处登临要品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"焚黄值雨雪","author":"周伦","text":"夜来春色到山家，贲及林邱改物华。\n五殿未缘酬一得，九原何意宠三加。\n千峰雨合膏为润，万里云同玉作花。\n黄燎音容在何处，空馀涓滴酹茅沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过彭城","author":"周伦","text":"洪涛一过彭城下，漠漠烟沙白鹭汀。\n水落漫无平野绿，山围不断半天青。\n子房直往祠前渡，司马难从洞口经。\n一夜老夫眠不去，推篷落落数星明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日隔风天津","author":"周伦","text":"满江风浪正重阳，船泊天津接大洋。\n北望烟沙宫树渺，东来凫雁海云苍。\n霜螯入市肥堪馔，腊蚁开尊醉不妨。\n回首吴山黄菊在，几时能学孟嘉狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阻风良店驿","author":"周伦","text":"南征十月对南薰，良店栖迟思欲焚。\n播弄樯乌尘碛起，浮沈水鸟浪花分。\n一杯细引寒船月，千里遥悬煖阁云。\n缩地无缘南北去，儿孙聊复慰殷勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨后入关望都门","author":"周伦","text":"丹阳百里入关来，雨后冲泥险道回。\n陇麦畦畦沾土湿，山花种种向人开。\n檐边乳鹊将雏至，树里鸣鸠唤妇回。\n七里高冈更西望，春云缥缈凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三疏乞休伏奉俞旨用韵有述","author":"周伦","text":"九天昨日降黄麻，老得辞官兴转赊。\n何处红尘迷客路，一江清涨到侬家。\n有棋尽可消长昼，无柝能催赴早衙。\n掉背出门那得碍，君恩难道不堪誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋日秋汀归田诸老见过","author":"周伦","text":"金风忽动野堂秋，梧竹萧萧爽气浮。\n可待月来光正满，偶逢宾至雨初收。\n盘餐江上鲈堪市，尊酒床头酿巳篘。\n分付儿童扫松径，露台高处恰登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜","author":"周伦","text":"秋夜飞萤拂树明，水边深坐葛衣轻。\n金风顿觉尘襟净，玉露还同野思清。\n小院梧桐流月影，半窗灯火读书声。\n何人苦被浮名累，车马翩翩欲二更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十四日立春荅高归田见寄","author":"周伦","text":"明夜上元今日春，春风今岁太逡巡。\n正传生菜盘行玉，还看灯花烛贮银。\n令节并临增胜事，小筵频启对芳晨。\n独惭郢调难为和，满院琼瑶雪色新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瓶梅结子","author":"周伦","text":"南岩携赠一枝梅，插向瓷瓶土不培。\n冉冉幽香浮几案，青青嘉实自根荄。\n玉盘未足琼瑶荐，金弹翻令燕雀猜。\n回首和羹虚鼎鼐，不须移向日边栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待月次韵","author":"周伦","text":"移席风亭月渐高，半开冰镜半云涛。\n举杯欲便随秋浦，作赋何能似水曹。\n一曲关山心自远，数茎衰白鬓空搔。\n坐深不觉归来晚，玉露凉生透锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石湖上方寺","author":"周伦","text":"湖上名山紫翠中，上方钟梵有琳宫。\n林浮锦树山光发，水落沧江海气通。\n双洞钵龙收夜雨，九霄笙鹤任秋风。\n向来簪弁都抛却，巳觉禅心万劫空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邓尉山房","author":"周伦","text":"行看一水来天目，坐见千峰涌太湖。\n啼鸟不知游客至，闭关惟有定僧孤。\n镜中水月俱清寂，象外烟云乍有无。\n胜地久怀来较晚，买山真欲辨青蚨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽张直芳","author":"周伦","text":"张君拜官如谪官，柳州之南行复南。\n荒服圣朝深雨露，瘴江终日自烟岚。\n长途旅榇情何极，落日啼猿听不堪。\n泪掩寒原歌楚些，满林松槚碧相参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天灯","author":"周伦","text":"入云华表缀春灯，落落浮光破晦冥。\n游径未须檠桦烛，照书何必聚囊萤。\n碧纱窗迥临秋月，画阁帘开晃夜星。\n漏断六街人迹静，北窗犹自读遗经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日","author":"周伦","text":"归来至日三年过，物色年来好应期。\n红著江梅初点点，黄肥园橘尚垂垂。\n五纹旋续针头线，半局能添指下棋。\n忽报前星照天下，一阳来复正当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊戌元日试笔","author":"周伦","text":"赐归天下降黄麻，忽漫今经五岁华。\n曙日楼台收海雾，早春梅柳净烟沙。\n试挥霜管新裁句，细汲山泉旋煮茶。\n儿女满前高宴会，玉尊金胜颂椒花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凤鸣五十","author":"周伦","text":"建议但知当日是，升沈那复悔前非。\n行藏如此颜何厚，心事无端笑独违。\n特遣罢官辞殿陛，翻令供职到庭闱。\n百年弧矢春同醉，不厌茅堂隐竹扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题缨溪草堂","author":"周伦","text":"背郭高林开草堂，堂前潭水即沧浪。\n鸥凫泛泛澄波静，云石泠泠白昼长。\n试濯冠缨歌孺子，却疑图画对潇湘。\n仙郎莫负澄清志，尘海烟沙正渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翠微阁","author":"周伦","text":"病足登临老更艰，人扶阑曲费跻攀。\n凭虚试眺前年景，移席重看旧日山。\n风阁崔嵬云外远，雨楼岑寂翠微閒。\n明朝晴霁还须到，分付禅僧莫闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登新楼","author":"周伦","text":"一上新楼百摺梯，捲帘苍翠玉峰齐。\n天光照落书边幌，海气潮生槛下溪。\n荏苒烟霞通宇宙，逶迤城郭见东西。\n千年身世青霄际，何必桃源访路迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王君美林亭看梅","author":"周伦","text":"底事春来日日阴，强移栖息就花深。\n行经薄霰穿香径，望隔寒云带碧岑。\n水面仙裾来似梦，城头羌笛杳无音。\n自今幽兴林亭熟，再过肩舆不用寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"独坐","author":"周伦","text":"老来身世澹无营，独坐虚堂万虑清。\n静看溪云兼树霭，细听泉溜带江声。\n喜贪书卷慵仍掷，量怯壶樽浅亦倾。\n见说仙家閒不去，也消长日对棋枰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五日雪","author":"周伦","text":"薄海寒云酿雪飞，逶迤城堞玉龙围。\n蝗知入地深无数，柳见乘丝冻觉肥。\n春瓮未开浮蚁动，冰澌初解泛鸥稀。\n老夫正尔抛书卧，高兴何人款竹扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三月二十五日懋鲁携酒东园看花","author":"周伦","text":"看花去岁竹阑边，今日花开恰似前。\n抱病秪疑虚几杖，逢人翻欲共周旋。\n啼莺落絮供长昼，把酒论文及暮年。\n来岁春光如复在，行厨应许再开筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]