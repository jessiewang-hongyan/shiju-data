[{"title":"山居秋日用杜韵八首 其七","author":"邵宝","text":"信今传后两无功，老去心情静坐中。\n梦里岩松过急雨，吟边庭草汎光风。\n沧波野鸟秋能白，篱落幽花晚亦红。\n敢学少年行乐地，北堂趋走未成翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居秋日用杜韵八首 其八","author":"邵宝","text":"绮塍五里亦逶迤，北望平畴接华陂。\n揖客共摩新石刻，赠人还折古松枝。\n履违东省声全隐，几失西堂梦不移。\n坐久却忘归路晚，蒹葭江上露初垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀姜佥宪若虚","author":"邵宝","text":"西江共校荐贤书，回首风尘廿载馀。\n顾我文章非晦父，知君礼乐自横渠。\n洞前鸣鹿苹还茁，柱底降蛟窟已墟。\n病客江南时感旧，三门寥落绝双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马巡按访我山中精舍","author":"邵宝","text":"山中忽枉乘骢客，千古清泉一啜馀。\n幽兴未题青竹句，閒情方试白茅书。\n观民节已因君重，经国怀还为我虚。\n曾向许昌祠靳老，汝南回首思何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答马巡按","author":"邵宝","text":"病难下拜惟投刺，吏散行台静复扃。\n且止共惊桓典节，无冤方赖释之刑。\n人间故重观风使，天上元垂执法星。\n簪笔螭头须老手，一言深望折盈庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答王郡公","author":"邵宝","text":"松籁清传阁外声，郡公诗到户初扃。\n青溪洞远频纡节，碧树阶深久措刑。\n世上无心风动草，天边有象月从星。\n平生一管春秋笔，老吏曾闻在汉庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"超然堂用韵答陈子引","author":"邵宝","text":"茶山居士惠山行，六月虚堂昼不扃。\n何处清风能此客，向来大暑似繁刑。\n吟筇缓待东山月，征旆遄朝北斗星。\n秋草满前无刈者，应将茂叔认吾庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中漫述用韵","author":"邵宝","text":"千帆竟日南还北，堂在危厓坐不扃。\n玉枕为谁增地价，松醪从此失天刑。\n蒸蒸漫指云为雨，落落虚传石是星。\n使者采诗还自赋，清风应许到彤庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中遇静观","author":"邵宝","text":"一秋风日今日好，我向山中看白云。\n观水亭前初送客，听松楼下又逢君。\n放翁健笔何难试，公瑾醇醪本自醺。\n独上层台待明月，绮塍归去夜应分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"董侍御访我超然堂","author":"邵宝","text":"观风使者入松关，为向閒人问太閒。\n潦尽正怜秋后水，云深偏爱雨中山。\n陈郎节指西川去，马子帆朝北斗还。\n更欲与君寻古刻，南岩石上洗苔斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭节庵归有作","author":"邵宝","text":"髯翁哭罢正愁眠，问我铭旌倍黯然。\n万事百年君子论，一行数字路人传。\n登廷奉对皆才选，行省参知有政权。\n指日生辰期不到，古稀真信杜陵篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"生日避客山中客有过者作诗谢之时新作精舍之街赋以兴焉","author":"邵宝","text":"节近登高新路开，山中冠盖有朋来。\n酒因母病未敢受，诗到秋清正合裁。\n微月初悬看作镜，新泉曲引待流杯。\n送君东上蓉湖棹，青眼还留点易台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"超然堂","author":"邵宝","text":"新种梧桐待凤凰，廿年犹记梦中祥。\n日长合有人高卧，山浅还应地善藏。\n平野星辰多夕观，少微云雾更江乡。\n一声清磬中峰起，误道朝庐近未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦思鲁","author":"邵宝","text":"秋酌薇堂别思遐，喜占春信对灯花。\n向来武爵辞君锡，此去文章为国华。\n寒岭乔松方挺节，晚园硕果亦回芽。\n遥知京邸承欢地，刚说辞家又到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽钱信之","author":"邵宝","text":"哭罢希翁幸见君，相思长隔荡西云。\n高名未向廷中荐，佳句时从社外闻。\n数约不来仍旧榻，一词难诔有新坟。\n秋堂愁共咸郎语，军帐峰高日易曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周治中","author":"邵宝","text":"骥足风尘一展开，士元何啻治中才。\n劳如晋鄙阳城在，清自关西伯起来。\n书考适逢龙虎榜，送行还上凤凰台。\n幽明黜陟非吾事，惟有新诗与子裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月望日登顾氏山园","author":"邵宝","text":"登高长恐主人留，今雨乘閒到上头。\n双眼乾坤容万里，五湖风日属三秋。\n旧坛荒落随陵谷，新径逶迤入亩邱。\n薄暮题诗下山去，塔烟西接剑光浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送莫如山应王郡公纂修之聘兼柬陈廷猷","author":"邵宝","text":"岁晚携书谒郡侯，侯方燕坐对春秋。\n两生有道时非汉，二国无徵礼自周。\n歌采康衢今日颂，传留廉吏后人修。\n多情若问西山路，古树阴中涧水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王郡公朝正告别","author":"邵宝","text":"三年两度谒承明，廉节应多动圣情。\n家梦未能忘绿野，官箴真不负苍生。\n有凰偶集黄非伪，无鹤相随赵亦清。\n不用千秋寻汉典，观风人已识公卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄山东巡抚陈中丞","author":"邵宝","text":"两年三劄汴台时，回首东藩几梦思。\n疏为斯文还白鹿，书从何日更青藜。\n泰山我负登高愿，沧海君成望远期。\n相寄不烦缄鲁缟，汉封坛上有秦碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石澜为天台僧明统作","author":"邵宝","text":"水向石边方急流，禅心如月照源头。\n百川倾注三千界，一滴生成七万秋。\n鱼跃鱼潜忘密藻，花开花落对閒鸥。\n吾泉堪濯还堪饮，独听沧浪起远洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"施平乐暨盛氏两都运过访超然堂","author":"邵宝","text":"我作新门待客开，山中秋晚数翁来。\n坐临岩壑笛三弄，游返江湖酒一杯。\n论世已非空里阁，怀人最是月中台。\n说蛇说虎真惊耳，起听寒泉步石台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠徐岳峰少邃用邃翁韵二首 其一","author":"邵宝","text":"数月旬宣疏几通，南来忧思对山翁。\n祗缘萱幄迎非便，不谓薇垣养未隆。\n老鹤正须惊独夜，冥鸿未许溯长空。\n北巡曾到苏门否，拜罢姚公拜邵公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠徐岳峰少邃用邃翁韵二首 其二","author":"邵宝","text":"伊昔相知自浙中，百年心事一经同。\n斯人海岳真钟秀，何处江湖不效忠。\n严濑水声风激烈，钱塘山色雨空濛。\n北堂莱舞从容地，识破人间道与功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中漫成","author":"邵宝","text":"李绅台南还筑台，陆羽泉西泉复开。\n泉边偃息看水逝，台上淹留待月来。\n一杯对客秋将尽，千古怀仙海欲回。\n漫恐岁寒霜雪至，超然堂下有红梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱太常使毕还朝次韵","author":"邵宝","text":"也知昼锦非君志，至乐无如使过家。\n祝捧御名天只尺，祀成殷礼国光华。\n紫薇省下迎周节，黄鹤楼前返汉槎。\n十月东风如有意，漕湖宅近大江涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀罗台州兼柬余郡推","author":"邵宝","text":"十年雅意属台州，珍重罗侯代顾侯。\n勘易客来缘我送，采诗人去为谁收。\n东郊灵雨春中驾，北极明星海上楼。\n政暇从容对参佐，郡推元有古风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄顾大参华玉","author":"邵宝","text":"近逢左辖问参知，尚忆山中访我时。\n岂是西湖无好景，秪缘东省有佳期。\n一方暂试经邦手，千古还纡尚友思。\n闻说柴墟遗稿在，故人已为付棠梨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄余郡推鸿宾","author":"邵宝","text":"东桥去后复文川，山长能邀又二年。\n过岭不携清献鹤，在庭应出惠通泉。\n半江月坐巾峰上，万古碑看阙里前。\n二月春风来旧客，还将美政向予传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄夏德树","author":"邵宝","text":"赤城山房不可到，但见客带烟霞来。\n孺子歌残三击节，羲皇梦醒一衔杯。\n少微夜隐江边雾，蓬岛春连海上台。\n二月西轩重下榻，可无新句为予裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄叶侍御一之","author":"邵宝","text":"手植松楸渐有阴，三年读礼草庐深。\n泪缘感物沾欧表，歌待成声和舜琴。\n海上鱼龙秋共蛰，山中乌鸟夜初喑。\n起居近得黄岩令，巾帻峰高玉尔音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少傅王公书来谓贞节碑制有泰山之遗不胜愧叹","author":"邵宝","text":"吾碑敢学泰山碑，不谓溪翁谓似之。\n天地深恩明主诏，春秋巨笔傅臣词。\n石钟追动蒲牢角，风榭馨香柏树枝。\n山鬼自今须敛避，文星五夜照南离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻钱工部讣","author":"邵宝","text":"老人星照昆承水，一夜顽云忽掩光。\n片纸仙方空入梦，百年诗冢竟流芳。\n远游司马曾高览，大隐东方亦善藏。\n待取东湖碑出后，还将经济问贤郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日","author":"邵宝","text":"人日占人古有之，淡云疏雨日光迟。\n梅呈红蕊寒犹茹，菜剪青丝冻欲萎。\n野老独斟泉酿酒，绣衣还寄草堂诗。\n冉泾桥畔元宵市，步月看灯有所期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷日阴寒微雨寄友用前韵","author":"邵宝","text":"春来何处去何之，江郭寒多意故迟。\n梅亦有情争欲吐，草应无力暂如萎。\n迎盘送菜吴人俗，拔剑弹琴杜老诗。\n最是三桥灯市近，与君先订上元期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小井田成","author":"邵宝","text":"三代遗风一慨然，聊将幽事遣閒边。\n细分颜巷曾收井，小灌张渠未买田。\n荒入草茅憎隙地，馨生黍稷愿丰年。\n如闻新制遒人铎，击壤歌中见古天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日山中漫成","author":"邵宝","text":"避风避雨梦中过，晴丽其如此日何。\n坐石观泉随我意，煮茶烧笋听僧歌。\n晚添积翠云边浅，春逐残红草上多。\n忽报西轩居士到，向来离恨一销磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戴进士巾山行","author":"邵宝","text":"四十年前戴此巾，几回清梦隔风尘。\n谁知道路閒边目，还看山林病后身。\n蓬岛客参诸老社，曲江图入九峰春。\n相逢莫道无同志，见说伊川已有人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"坐燕居亭怀莫如山","author":"邵宝","text":"观物年来眼近真，燕居亭上有閒人。\n雷声连送两朝雨，花事顿消三月春。\n木芍药阑青草长，石菖蒲沼绿波新。\n南沙有客应同兴，何日相过洗渴尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新晴出郊之惠山","author":"邵宝","text":"步出西郊见暮春，树头红尽绿初匀。\n上方下界无游女，北坞南冈有逸人。\n山色倍增今雨碧，泉声转入近池真。\n竹根处处惊雷动，忠定祠前数箨鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行纪事","author":"邵宝","text":"策杖来看雨后泉，老僧相迓寺门前。\n残红梦里空三月，新绿阴中又一天。\n风转北溪随爽气，日冲西岭破浮烟。\n公孙携酒先期在，更有诸君在别船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹永平于德","author":"邵宝","text":"十载昌言动庙堂，永平假守似淮阳。\n西垂阅实初旋节，东甸巡行又出疆。\n田里情于台省近，江湖心与阙廷长。\n汉家千石还登相，消得人称一字良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送喻武昌宜之","author":"邵宝","text":"虎符龙节照洪波，中老曾经此地过。\n两志共知文献在，百年将谓武昌何。\n眼明每引黄楼望，听远如闻赤壁歌。\n况有玉泉家学在，黑头功业未蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾泉州与新","author":"邵宝","text":"一时三守邑多贤，佳报先从海上传。\n直谏曾惊他日震，清修应比此山泉。\n凤凰仪羽非无地，黍稷馨香是有年。\n五马双旌元贵重，朝廷异数况高悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题石龙书院","author":"邵宝","text":"石龙岩下有人龙，万卷图书一亩宫。\n久信横渠崇世禄，始知若水称仙风。\n地当南斗瞻依处，道在东山卧起中。\n忽忆台州三忆句，欲招方石慰涯翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华从龙在祗陀馈鹤顶梅次韵","author":"邵宝","text":"十个梅题鹤顶丹，僧家澹泊助清酸。\n病须入药非无用，老负调羹正未安。\n他石倚云风骨瘦，我泉落涧露华寒。\n报君欲拓唐人篆，雨蚀莓苔迹已漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热二首 其一","author":"邵宝","text":"旱忧民物热忧身，独卧虚堂老病人。\n态似儿童欣水石，情如野客懒衣巾。\n云中树色披图幻，山下泉声入梦频。\n短壑青松空在口，肩舆曾不到东津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热二首 其二","author":"邵宝","text":"若岁大旱今真逢，狂魃骄舞生炎风。\n云霓数日无片影，罗火太阳同一宫。\n虚堂坐我独心静，涸野悯农皆力穷。\n群龙懒卧呼不起，手弄杨枝空百童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟巡江夜游泉上纪兴和韵","author":"邵宝","text":"弭节山中为饮泉，登临亦复吊前贤。\n天风吹酒起高兴，水月入诗成警联。\n润下故应穷远海，静清还独浚微涓。\n病夫未得相从去，一见新篇一缺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴东湖司空","author":"邵宝","text":"老谢尚书返旧堂，百年吾道益增光。\n洞庭南去还裴野，震泽东来有召棠。\n调剂口曾尝药苦，经纶手复理芸香。\n深秋一得沙羡报，回首苍梧梦转长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孙九峰司徒","author":"邵宝","text":"九峰山里寄书来，珍重司徒手自裁。\n出处四朝今旧德，沈酣三礼古遗材。\n爱公欲徒吟诗社，老我时登点易台。\n喜接贤郎难答拜，愁看江上雁飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画寿孙九峰司徒","author":"邵宝","text":"别公十有五年来，渴思纷纷不易裁。\n南极一星犹正色，苍松万丈本奇材。\n谁云雪酒非春酒，我爱云台是钓台。\n江上飞鸿多未达，隔年须待汉槎回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得雨","author":"邵宝","text":"旱气蒸人酷如火，今霄雨来何沛然。\n坐令四境尽沾足，行见百谷皆新鲜。\n闾阎自喜得口食，官府不忧徵税钱。\n吾徒无能却有幸，斋阁日高犹自眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次朱士光见寄","author":"邵宝","text":"百年文字偶相知，情到南畿按节时。\n淮郡竟烦长孺卧，长沙益起贾生悲。\n蛾眉众诼非今日，豸角群邪有夙期。\n千里鹤坡何处所，秀江回首不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢冯佥宪移竹用李文正公韵","author":"邵宝","text":"茅竹曾闻避市尘，十年两地不轻分。\n平生直节真吾道，何处清风不此君。\n自保霜筠青似玉，须留雨叶翠如云。\n数挑山土勤舆力，西向梁溪望夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠传神吴芳远","author":"邵宝","text":"谁家阿堵点能真，四十馀年不数人。\n临颖笔端饶气槩，泰和象外妙精神。\n閒留我在心千古，老遇君来貌一新。\n骨相山林今已定，不劳物色向风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得余鸿宾简","author":"邵宝","text":"曾闻退易不闻难，六十年来系一官。\n风木声中悲岁短，云鸿仪处爱天宽。\n援琴欲鼓还清泪，运甓无劳亦素餐。\n君未弃臣臣自病，衷情须向疏词看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜王内翰以诗为问用韵奉谢","author":"邵宝","text":"迂僻平生敢自豪，愧将虚誉动时髦。\n篱边秋色南山近，岩畔晨香北斗高。\n日月照应无间隙，乾坤报未有丝毫。\n感君相问无能答，病足支筇重抑搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉怀素翁先生","author":"邵宝","text":"旧隐归来长薜萝，江湖风雨两秋过。\n山中岁月空閒在，天下经纶奈老何。\n酒熟漫邀邻叟饮，诗成还对社翁歌。\n二泉病客怀思渴，安得南飞酌海波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜送客","author":"邵宝","text":"酣饮其如客去何，冉泾桥畔漫经过。\n惟君画妙心偏苦，而我居閒鬓亦皤。\n巷柝有声人语静，塔灯无影月明多。\n中秋更起登台兴，古华峰前一浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻管大夫欲招予乡饮因检壬申年辞谢高侯见招之作用韵奉呈","author":"邵宝","text":"苍苍余发视茫茫，七十年将病莫当。\n杖屦不支新步履，衣冠空忆旧班行。\n三章未已终辞阙，一拜犹难敢上堂。\n欲谢招徕贤令尹，赓歌还愧昔时狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张山扫墓归途有作","author":"邵宝","text":"山南山北扫寒烟，旧冢新碑二百年。\n红叶似花霜醉后，青山如黛雨妆前。\n数峰影阁竿头日，十里光沉镜里天。\n最喜无风溪路稳，沙鸥来往候归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜介夫刘大参至","author":"邵宝","text":"十五年前别故人，西南川陆每驰神。\n初心道德君无负，晚节山林我亦真。\n杏树坛边怀旧雨，梅花国里认先春。\n安成去后长悬榻，诗话于今又一新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]