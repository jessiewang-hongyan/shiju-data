th":"明_2.csv","pointer":8074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈沂赴南京卫幕 其四","author":"王立道","text":"清秋欲尽送将归，路绕铜门失翠微。\n杨柳不堪摇落后，伴人残菊尚依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈沂赴南京卫幕 其五","author":"王立道","text":"三载曾趋青琐班，春风时忆舞衣斑。\n雁飞江浦寒烟断，彷佛舟移见旧山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈沂赴南京卫幕 其六","author":"王立道","text":"惠山泉品逼中泠，阳羡仍留楚颂亭。\n种橘煮茶应不俗，懒看踪迹逐浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑翁还广 其一","author":"王立道","text":"燕山雨雪一冬足，越峤烟花三月多。\n綵鹢忽随春岸远，东风斜日水增波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑翁还广 其二","author":"王立道","text":"凤诰新沾天北阙，骊驹遥驾海南邦。\n浓花细草催行色，一夜春帆过曲江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]