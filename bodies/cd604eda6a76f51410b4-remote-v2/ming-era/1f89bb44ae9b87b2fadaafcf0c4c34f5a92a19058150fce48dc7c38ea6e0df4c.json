[{"title":"咏山中桂","author":"区大相","text":"金粟香飘玉露披，巃崧多发倚岩枝。\n深山远道无人折，独对秋芳咏楚词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望九疑 其一","author":"区大相","text":"何处湘山望里悲，九疑千载有遗思。\n寻常一带愁云锁，不遣行人到更疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望九疑 其二","author":"区大相","text":"零陵南去有珠丘，当日皇英湘水留。\n九处云山无路觅，至今瑶瑟使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望九疑 其三","author":"区大相","text":"昔闻虞帝治垂衣，五月南巡遂不归。\n当日夔龙谁护从，更无人挽翠华旂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云洞流觞","author":"区大相","text":"满壑云藏太古天，仙书元未有人传。\n我来载酒岩前石，风扫松花出洞泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经碧云村","author":"区大相","text":"门掩松溪石路斜，碧云开尽见人家。\n客来惯煮胡麻饭，春到先收谷雨茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中言志 其一","author":"区大相","text":"行尽清溪到几峰，峰头精舍有云封。\n功名不爱通侯赏，乞得閒身伴赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中言志 其二","author":"区大相","text":"柴扉竹里掩斜晖，童子山前采药归。\n满地藤花閒不扫，风来吹上钓渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中言志 其三","author":"区大相","text":"茗园烟袅绿云鬟，花底朱扉映竹关。\n风月自来歌舞席，不知何处是东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中言志 其四","author":"区大相","text":"莫道山家事事慵，看云看水费持筇。\n新栽松树能留鹤，小引溪泉即卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中言志 其五","author":"区大相","text":"竹树阴森带茅屋，山客归来酒初熟。\n有时一卷黄庭经，独对岩前千丈瀑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中言志 其六","author":"区大相","text":"一道飞泉挂碧峰，石桥流水出深松。\n山僧自扣山门磬，知隔前溪第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田家吟 其一","author":"区大相","text":"农务虽閒未敢安，近来生事日艰难。\n旧租未了新租急，又责金钱供内官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田家吟 其二","author":"区大相","text":"东邻贳酒劳西邻，百日方闲一日身。\n莫笑田家欢乐少，汉家天子尚忧贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田家吟 其三","author":"区大相","text":"春雨新晴田事初，邻家相劝把犁锄。\n昨闻城市迎中使，应赐南中父老书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田家吟 其四","author":"区大相","text":"海内传闻有赐酺，醵钱相就醉枌榆。\n诏书又报天南下，不是宽租是索租。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高要陈簿给事军门以绢索诗赋赠","author":"区大相","text":"丞相第中扫门客，将军营里佩刀人。\n怪来鸾凤翻栖棘，肯使骅骝不绝尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其一","author":"区大相","text":"东南佳丽号名都，吴越山川入帝图。\n地拟汴杭开上苑，天留明圣作西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其二","author":"区大相","text":"金陵东渡更龙蟠，越水吴山画里看。\n尽说江南好行乐，谁云江左是偏安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其三","author":"区大相","text":"汴水何如越水头，南人行乐北人愁。\n湖山在昔多临幸，士女犹如习宴游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其四","author":"区大相","text":"都城万雉若云翔，梵宇琳宫蔽日光。\n对表两高成玉阙，中开三竺是金堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其五","author":"区大相","text":"长江南渡驻龙旗，淮泗年来少出师。\n东海尽为资福地，西湖曾作放生池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其六","author":"区大相","text":"东临禹穴北吴关，万乘旌旗云水间。\n谩道秦皇好巡幸，南来不及会稽山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其七","author":"区大相","text":"土风元比汴京和，花石何如艮岳多。\n传道先朝游幸日，六桥芳草翠华过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其八","author":"区大相","text":"秦皇临海海涛生，钱氏射江江水平。\n自此馀杭为内甸，更将淮北作长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杭州歌 其九","author":"区大相","text":"海门东阻控波澜，天目西标更郁盘。\n泽国即为吴旧国，临安非复宋长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过和靖宅","author":"区大相","text":"惆怅高人鹤不回，独行幽径咏閒苔。\n春来旧宅无人问，空发孤山几树梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤山","author":"区大相","text":"疏竹寒梅对茗垆，白云明月此山孤。\n山前一带红尘路，从遣游人踏绿芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行九里松向天竺","author":"区大相","text":"步入春溪九里松，南屏如画障芙蓉。\n遥知金界焚香处，天竺峰头朝暝钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤山看梅","author":"区大相","text":"素赏殊非桃李人，深藏疑避绮罗尘。\n自从逸客高吟后，湖月溪烟几度春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖上楼对雪遣兴 其一","author":"区大相","text":"淡扫平湖十里光，瑶堤宛转属虹梁。\n千林玉树花争发，不信孤山有暗香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖上楼对雪遣兴 其二","author":"区大相","text":"冻袅松云洒竹烟，梅风吹度小窗前。\n朝来画舸门边系，错认王家乘兴船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖上楼对雪遣兴 其三","author":"区大相","text":"临水寒梅照雪新，西湖何谢石湖春。\n年来胜事消磨尽，两处谁为清赏人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂曲 其一","author":"区大相","text":"城外朱楼映晓霞，酒船伎舸各穿花。\n少年尽日出行乐，薄暮还寻苏小家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂曲 其二","author":"区大相","text":"平湖一带绕山根，山上禅宫湖上村。\n逋客宅边招隐士，鄂王坟上赛忠魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂曲 其三","author":"区大相","text":"妆楼舞榭属回堤，垂柳垂杨拂水齐。\n可惜西湖千顷浪，更无人解钓清溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂曲 其四","author":"区大相","text":"泛舟湖上仰神仙，桂楫中流兴渺然。\n好是米家书画舫，元非越女芰荷船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂曲 其五","author":"区大相","text":"当筵窈窕善吴音，能唱新词动客心。\n忽听阳春传雅曲，是谁湖上发高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过皇店","author":"区大相","text":"皇家新店跨神州，泉府虽盈万姓愁。\n今日何人忧国计，独劳天子自持筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪漫兴 其一","author":"区大相","text":"春满前溪花水香，三峰历历对茅堂。\n寻常莫遣柴门闭，看取山光下夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪漫兴 其二","author":"区大相","text":"野寺疏钟报夕曛，寥寥仙梵隔溪闻。\n山僧送客临溪水，还向山门礼白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪漫兴 其三","author":"区大相","text":"谷口生烟上翠微，孤亭晚坐数鸦飞。\n隔林樵子遥相问，今日观棋谁后归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪漫兴 其四","author":"区大相","text":"拄杖穿林出每迟，板桥凝望去何之。\n柴门流水花间月，正是云溪春暮时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"携酒啸台作 其一","author":"区大相","text":"淇竹泠泠涧水清，美人截作凤凰鸣。\n高台曲尽彩云没，何似当年长啸情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"携酒啸台作 其二","author":"区大相","text":"嵇琴阮啸各名流，千载遗风仰未休。\n怪却苏门孙处士，当时何少醉乡游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太和宫杂曲 其一","author":"区大相","text":"百寻铁锁系雕阑，千折瑶阶莲步难。\n露洗玉颜溅霓服，风吹雾鬓拂星冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太和宫杂曲 其二","author":"区大相","text":"青鸟书归度海霞，斑龙车引上真家。\n榔梅树下多成实，仙李峰头解作花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太和宫杂曲 其三","author":"区大相","text":"瑶阶步步整金莲，密语低声诉上天。\n罗帕捧来酬醮礼，金钗施尽当香钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太和宫杂曲 其四","author":"区大相","text":"琼台金阙郁重重，上界常教雷雨封。\n一片仙云凝不散，夜来还过二茅龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太和宫杂曲 其五","author":"区大相","text":"小童学炼白朱砂，轮向天坛扫落花。\n玉管金炉解迎客，碧云遥指太清家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大雪日微霰下庭看小儿积霰为戏","author":"区大相","text":"小雪初过大雪晨，微云微霰点轻尘。\n谁言蓟北无花日，亦有江南咏絮人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题袁客金台览胜卷","author":"区大相","text":"我为闲官缚此身，君应我事作游人。\n马蹄踏遍金台胜，消得尘途几斛尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"聊城 其一","author":"区大相","text":"秋草寒原旧业虚，却秦存赵片言馀。\n无端更射聊城箭，多是英豪习未除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"聊城 其二","author":"区大相","text":"谈笑功名节概稀，古城残垒对斜晖。\n年来羞道纵横计，走马城南射雉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嵩阳院观汉封三柏","author":"区大相","text":"嵩阳宫外柏三株，汉帝遗封今记无。\n翠霭尚留龙驭远，青天时有鹤群呼。\n年深饱历风霜色，世渺全荒玉检符。\n欲问兴亡千载事，不知人代几荣枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游少林值雨","author":"区大相","text":"清昼入门春雾浓，坐深檐溜递疏钟。\n泉声欲过三花树，云气常生二室峰。\n入夜萧条清客梦，翻阶滴沥滞游踪。\n明朝儗趁嵩高目，好放晴光随杖龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫竹洞","author":"区大相","text":"雾磴回青嶂，松门历翠微。\n来寻紫竹洞，坐待白云归。\n怪石淩秋屐，长藤挂衲衣。\n兴移凉籁发，疑挟凤笙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄和沈纯甫比部游崆峒岩 其一","author":"区大相","text":"域外名山此郁盘，青天孤剑倚巑岏。\n石坛过雨瑶花静，丹壑含风玉乳寒。\n藜杖自穿云雾入，苔碑先拂薜萝看。\n绝怜空谷稀人迹，尘外逢君一笑难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄和沈纯甫比部游崆峒岩 其二","author":"区大相","text":"把酒萧条眺远峰，削成青壁秀芙蓉。\n书传有客拾瑶草，日下何人鞭玉龙。\n树杪秋阴凉籁起，岩前黛色暮烟重。\n非缘谪籍邻幽杳，石上争题逸士踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游梅庵 其一","author":"区大相","text":"松门长日闭烟霞，扫石焚香诵法华。\n禅客到来无所见，水晶宫里玉莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游梅庵 其二","author":"区大相","text":"解带山门对夕晖，白云不住鸟惊飞。\n山僧若道心无染，散落天花亦满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其一","author":"区大相","text":"天监下民，正直是与。\n孰任奸慝，而司世矩。\n周周之族，亦衔其羽。\n乃如之人，不恤其侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其二","author":"区大相","text":"缉缉谗夫，实善中人。\n中藏憸贼，外示密亲。\n如虿斯螫，如犬斯狺。\n皇天祸淫，孰逃尔身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其三","author":"区大相","text":"施施谗夫，胡言之厚。\n甘言谀辞，亦孔之丑。\n君子攸行，遭汝疾诟。\n邦家之覆，亦在利口。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其四","author":"区大相","text":"毁玉为珉，诬舜为蹠。\n云胡不造，负此谗慝。\n在昔有训，顽谗是堲。\n奈何邦家，长此蟊贼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其五","author":"区大相","text":"俨斯恪斯，我仪孔嘉。\n惕斯勤斯，我德靡瑕。\n爰敕我躬，日闲我家。\n庶几夙夜，以保靡他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其六","author":"区大相","text":"天之方蹶，良士祚之。\n民之多艰，良士阜之。\n四国有难，良士辅之。\n祁祁良士，谗人恶之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其七","author":"区大相","text":"道之丧矣，谗人是命。\n俗之讹矣，谗言是听。\n夫惟仁人，去谗远佞。\n放之流之，四国是正。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其八","author":"区大相","text":"嗟余小子，不早是图。\n傲此正直，玩彼奸谀。\n毁防延盗，世谓之愚。\n比之匪人，不亦伤乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其九","author":"区大相","text":"高林致风，盛德来毁。\n云胡否德，而蒙谤诽。\n我仲我季，正直是履。\n恶佞嫉邪，为端是轨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其十","author":"区大相","text":"昔在公车，偕我仲季。\n邂逅三汪，声同气契。\n剖文析义，其言孔惠。\n久要不忘，眷尔离袂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续刺谗诗 其十一","author":"区大相","text":"有鸟在梁，亦曰在原。\n煌煌哲兄，急难斯存。\n彼美汪生，汝亦昌言。\n谁谓友朋，不如弟昆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼","author":"区大相","text":"海上何年大药成，苍茫岛树近东瀛。\n烟霞似挹浮丘袖，风竹宜调子晋笙。\n仙去坛荒丹井在，客来云起毒龙迎。\n凭谁共拾金光草，十二楼光近五城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺","author":"区大相","text":"烟波缥缈散花台，祇苑初传鹦鹉杯。\n岛上一珠悬照乘，江中双树辨如来。\n林开碧嶂孤城转，水合青天两岸回。\n已泛仙槎逃苦海，欲乘灵气望蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"定朝鲜","author":"区大相","text":"皇赫怒，命东征。\n千翼举，七萃行。\n渡绿江，援王京。\n鳌足断，海波平。\n扶桑拂，旸谷升。\n旭日中，仰大明。\n戮群倭，定朝鲜。\n武功振，文德宣。\n櫜弓矢，戢戈鋋。\n藩服固，王会全。\n祥瑞降，诸福骈。\n祝圣寿，万斯年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉溪垂纶","author":"区大相","text":"孤村流水涨秋山，绿树风微鸟共闲。\n钓罢玉溪垂落虹，白云偏护石羊关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]