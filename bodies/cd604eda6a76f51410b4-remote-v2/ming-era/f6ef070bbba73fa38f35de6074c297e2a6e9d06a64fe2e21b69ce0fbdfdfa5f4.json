[{"title":"梅雪轩","author":"陈琏","text":"闻道轩居好，□□□□□。\n□□□□□，梅放近阳春。\n香气侵书幌，寒威迫□□。\n□□□□□，□□见情真。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽乐","author":"陈琏","text":"云黯□微星，俄闻丧老成。\n帐寒秋鹤怨，窗曙晓猿惊。\n已失丈人行，空留逸士□。\n□□有贤嗣，郁郁见佳城。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽封□□□□□公祐得乡邑称纯孝，声名迈古人。买书因教子，酿酒为筵宾。宠命颁新至桂林","author":"陈琏","text":"桂林自昔最宜人，况复清时雨露新。\n昭代礼文初复古，隆冬天气煖如春。\n衣冠士族从来盛，庠序儒风自昔淳。\n我忝一官司教铎，期将斯道觉斯民。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"訾家洲怀古","author":"陈琏","text":"泉石涓涓树色苍，应如杜甫浣花庄。\n裴公遗址荒秋草，柳子残碑卧夕阳。\n咫尺郡城连雉堞，几家茅屋枕鱼梁。\n我来怀古空惆怅，独立西风野水傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游刘仙岩有怀","author":"陈琏","text":"晓出南关道路赊，洞门幽胜信堪誇。\n若非勾漏神仙府，定是清溪道士家。\n天上蟠桃经岁月，岩前瑶草足烟霞。\n刘郎去后无消息，留得丹炉伏火砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽道士龙碧潭尝住神乐观","author":"陈琏","text":"承恩曾到蓬莱殿，归住空山岁月深。\n海上青骡今不返，炉中白兔竟难寻。\n乡人共舍刊碑石，弟子能留买地金。\n云暗洞门春已老，碧桃花落昼阴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和主文晏彦文试院韵","author":"陈琏","text":"深深试院远羲炎，罗袖生凉汗不沾。\n红湿胭脂花带雨，绿摇翡翠草当帘。\n敲推得意诗怀好，去取无私笔法严。\n他日扁舟归鄂渚，几多道路报邮签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送灵川知县杨彦通考满","author":"陈琏","text":"文采风流杨令尹，一官政满上京畿。\n栽花岁久成花县，制锦功完又锦衣。\n伯起家声谁得似，大年才业世应稀。\n莫言倾盖论交晚，何事临流更忍违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽广西左布政使费公斗南公号南轩","author":"陈琏","text":"承宣三载镇雄藩，一疾胡为隔九原。\n记我旧曾瞻北斗，哭君今又到南轩。\n庙堂美政归公论，岭海苍生感厚恩。\n精爽不知何处去，声名赫赫著微垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送行人戚存心","author":"陈琏","text":"亲传天语出枫宸，驿骑南来度海云。\n芳誉蚤闻登上第，高情还喜重斯文。\n花前酌酒惊春晚，灯下评诗觉夜分。\n只恐明朝天上去，未知何日更逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳溪为千秋峡刘巡检赋","author":"陈琏","text":"刘郎种柳柳成堤，村后村前树已齐。\n白浪翻江看马浴，绿阴绕屋听莺啼。\n绝怜花发春三月，恰似冬来雪一溪。\n料得近时巡逻暇，青鞋布袜任东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"陈琏","text":"客梦初回酒正醒，揽衣行步月华明。\n心怀桂玉思乡土，身寄江湖忆弟兄。\n桂子风清秋满树，藕花露冷夜三更。\n自怜天上灵槎远，时见银河几曲横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄地理先生赵思立","author":"陈琏","text":"先生真是地行仙，来住人间九十年。\n对酒有时招鹤舞，寻山何处访牛眠。\n黄花满圃秋容淡，白发盈簪雪色鲜。\n闻说青囊多有验，不知今日有谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七星岩","author":"陈琏","text":"六丁何年开翠岑，穹窿石室高千寻。\n烟生丹灶火常在，花落碧桃春又深。\n倚岩怀古成浩叹，扫壁题诗还自吟。\n日华月华去已远，玉笛谁能传妙音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琴鹤轩为宜山孙大尹赋","author":"陈琏","text":"林下轩居无限清，虚棂面面常不扃。\n孤桐三弄晚风细，老鹤一声秋月明。\n高山流水谁解听，玄裳缟衣真有情。\n可怜清献去已久，独羡使君能擅名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小柏","author":"陈琏","text":"小柏堂前数十科，风来翠色已婆娑。\n栽培岂但膏腴美，长养偏承雨露多。\n弱干渐成龙虎势，乔松拟结凤凰窝。\n他时特立青霄上，霜雪纷纷奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽梅岩区以齐先生","author":"陈琏","text":"蚤年应招觐枫宸，归向山中卧白云。\n高节能同徐孺子，清名足继杜徵君。\n岩梅老去春何在，墓草荒来路莫分。\n江海诸生情最切，不堪闻讣泪纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月初三秋丁斋宿偶赋","author":"陈琏","text":"暮雨初收夜气凉，黉宫如水漏声长。\n金莲光粲频添烛，宝篆烟浮屡换香。\n礼乐明时严秩秩，弦歌深夜尚洋洋。\n喜逢圣代崇禋祀，勉效涓埃答素王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄富川知县张纯","author":"陈琏","text":"富川令尹才华好，派出韶阳宰相家。\n蚤步玉堂曾视草，迩来山县又栽花。\n天连五岭闲宵柝，日上三竿罢早衙。\n圣主临轩思致治，莫随勾漏问丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莲社图","author":"陈琏","text":"义熙人物总英贤，道契机缘岂偶然。\n五老峰前同结社，三生石上共谈禅。\n雨馀瀑布飞晴雪，日出香炉生紫烟。\n千载高风无觅处，空将仪像画图传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿马王阁都纲胜义天精舍","author":"陈琏","text":"夜宿招提听暮钟，上方楼阁翠重重。\n碧梧影转瑶阶月，丹桂香传玉宇风。\n支遁文章当世重，远公心事许谁同。\n终宵极论无生话，始悟人间色是空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊清溪和董伯琪韵","author":"陈琏","text":"十载江湖载酒行，异乡又觉岁华更。\n孤舟夜雨三更梦，万里风云几日程。\n宝篆香消银叶冷，砚池冰合雪花明。\n兴来笑把吴钩舞，未信鸡鸣是恶声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒张余二公祠","author":"陈琏","text":"乾坤清气流不息，岂但岳降能生申。\n丹丘自昔产鸾凤，南荒未信无麒麟。\n曲江相业世所重，武溪文章时共珍。\n英风凛凛起予慕，接武前修当有人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过梅关有怀张丞相九龄","author":"陈琏","text":"大庾峨峨何壮哉，羊肠石磴荒苍苔。\n天教此岭限南北，公凿一关通往来。\n听猿林下风日好，驻马林边云雾开。\n怀人不尽千古意，丹心飞绕黄金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登梅山阁","author":"陈琏","text":"岁当辛巳腊月暮，高阁淩云试一登。\n雪里梅花红淡淡，天边松树翠层层。\n关门疏凿思文献，锡杖飞来记慧能。\n挂角招提今在否，试将往事叩山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大姑山","author":"陈琏","text":"玉立湖中孰敢攀，何人唤作大姑山。\n半弯新月开眉黛，一朵晴云拥髻鬟。\n自喜乾坤同寿算，何须灵药驻容颜。\n平生持守孤高节，肯学英娥不复还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过庾岭遇雨","author":"陈琏","text":"儿时闻说大庾岭，今日驱车带雨过。\n白石政如鲇背滑，青山又似犬牙多。\n崎岖难着寻梅屐，断续唯闻伐木歌。\n张相祠前闲小憩，一声猿啸出烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过洞庭","author":"陈琏","text":"江豚出没湖水腥，寒泽嗈嗈凫雁鸣。\n舟人候风五两正，蛋子捕鱼舴艋轻。\n衡湘南去几千里，吴楚东来多少程。\n欲向君山吹铁笛，只愁□□□□惊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄鹤楼怀古","author":"陈琏","text":"百尺阑干瞰水隈，吕岩遗迹半荒苔。\n檐飞晓日天应近，门锁春风昼不开。\n夏口波光将绿绕，汉阳树色送青来。\n紫箫吹彻还惆怅，不见仙人骑鹤回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓过黄州","author":"陈琏","text":"黄州楼头雪未晞，猎猎寒风吹客衣。\n征帆此时向东去，行李何日从南归。\n青山几点烟际出，白鸟一双江上飞。\n欲访坡仙旧游处，倚篷回首思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过赤壁","author":"陈琏","text":"炎祚将移苦战争，周瑜曾此破曹兵。\n江流不尽英雄恨，山色犹存今古情。\n孤鹤声寒秋万顷，东坡梦断夜三更。\n神游故国知何处，半壁清风吹月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过五云驿","author":"陈琏","text":"倚篷镇日看云山，回首俄经过万安。\n草色绿迷春雨细，花枝红怯晚风寒。\n乡关迢递三千里，客棹夷犹十八滩。\n遥念倚庐亲望切，此身无计托飞翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢恩出偶成","author":"陈琏","text":"随班晓入谒金鸾，面对天颜咫尺间。\n身披赐衣深雨露，手提教铎重丘山。\n王通千载称高士，杨震当年亦冷官。\n自愧菲才何以报，平生惟有寸心丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉天门朝贺","author":"陈琏","text":"天子龙飞登大宝，衣冠虎拜集虞廷。\n群臣喜际风云会，万国重瞻日月明。\n河洛定闻龙马瑞，朝阳应见凤凰鸣。\n舞阶已喜干戈戢，四海从今乐治平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承天门听赦","author":"陈琏","text":"昨夜金鸡动北辰，五云阙下听丝纶。\n金泥照耀传天旨，冠冕从容拜紫宸。\n四海氛埃俱荡涤，明廷治化喜更新。\n小臣接武夔龙后，愿效华封祝圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"车驾谒孝陵随侍有感","author":"陈琏","text":"文武衣冠肃礼仪，谒陵盛典重今时。\n九重久切松楸念，此际尤深霜露思。\n瑞霭霏微生辇道，荣光烜赫动旌旗。\n小臣稽首陈歌颂，不愧周人清庙诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝","author":"陈琏","text":"天街雨过浥香尘，金殿初开曙欲分。\n露湿霓旌穿柳过，风传韶乐隔花闻。\n诸候入贡陈方物，圣主临轩重礼文。\n幸忝儒臣逢盛治，愿歌天保答皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圣节早朝","author":"陈琏","text":"华渚虹流寿域开，衣冠济济近蓬莱。\n丝囊光映千秋绿，仙酝香浮万寿杯。\n风细炉烟常缭绕，日高扇影自徘徊。\n此时何幸沾恩泽，醉插宫花侍宴回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉柬翰林侍读学士王公达善","author":"陈琏","text":"璧水传经自昔年，瀛洲此日喜登仙。\n儒官旧说词臣贵，学士原兼内相权。\n晓簉鹓班联玉笋，夜归琼署赐金莲。\n也知许国怀忠荩，一寸丹心铁石坚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李迪除晋府典宝","author":"陈琏","text":"五云阙下拜新除，千里王门喜曳裾。\n汉代文章推贾谊，梁园词赋重相如。\n趋朝亲捧黄金宝，退食闲工玉箸书。\n别后故人应注想，平安莫惜寄双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高铭归广东省亲","author":"陈琏","text":"凤凰城头初日明，尚舍省亲辞玉京。\n金陵酒香花欲语，杨子潮来江有声。\n怀英每切白云念，令伯独深乌鸟情。\n高堂鹤发喜无恙，行看彩衣称寿觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谷城知县杜思道","author":"陈琏","text":"谷城令尹著能声，三载弦歌似武城。\n千里稽勋来吏部，一朝复任出神京。\n甘棠满院舆人颂，官柳盈堤属吏迎。\n归到黄堂公事简，清风重听宓琴鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾幸朝天宫醮坛和永春侯韵","author":"陈琏","text":"斋居宣室致深思，法驾从容出玉墀。\n琪树才看甘露降，璇霄又见庆云飞。\n天香霭霭浮龙衮，仙佩珊珊集凤池。\n万国臣民沾圣泽，喜闻词赋颂明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用王编修韵柬定岩僧官","author":"陈琏","text":"到处曾栽惠远莲，鸡峰来住又多年。\n久知戒行闻天下，喜有声名著日边。\n贝叶经翻松下石，昙花香泛竹间泉。\n承恩常到蓬莱殿，手绾袈裟近御筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太祖皇帝挽诗","author":"陈琏","text":"鼎湖龙去众凄然，云暗苍梧万里天。\n虞舜升遐原有数，华封祝寿竟虚传。\n当年仁育齐高厚，此日哀思罄幅员。\n伫看史臣修实录，神功圣德著瑶编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿龙泉寺","author":"陈琏","text":"归鹤翩翩带夕曛，上方钟磬隔林闻。\n不眠一夜听春雨，起视四山生白云。\n深荷远公知好客，独怜支遁最能文。\n长年安得闲来此，芳草坡前数鹿群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏武牧羝图","author":"陈琏","text":"子卿远使单于国，一牧羝羊十九秋。\n塞上草生春屡过，泽中冰泮水交流。\n龙沙别去劳清梦，汉节持归已白头。\n太史论功真不愧，当时何必计封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王宪副考满","author":"陈琏","text":"北望金陵路几千，漓江冠盖集琼筵。\n桂花雨湿朝天旆，杨柳风迎上濑船。\n声誉已闻霄汉上，封章行奏御街前。\n悬知书最承新渥，好寄平安自日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登尧山","author":"陈琏","text":"几载尧山负赏心，忽逢佳节强登临。\n白云极目家何远，黄叶满林秋又深。\n杖屦徐行怜草色，壶觞列坐爱松阴。\n且将酩酊酬清景，何用闲吟慨古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乡饮","author":"陈琏","text":"欣逢四海承平日，秩秩宾筵列讲堂。\n总谓圣朝兴盛典，要令风化遍遐方。\n笙歌间作声音美，俎豆敷陈礼数详。\n我忝儒官叨胜会，自惭无德颂陶唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄庆远卫指挥姜仲文","author":"陈琏","text":"藩翰由来重武臣，如公才器更无伦。\n喜闻拜命加新秩，行见推恩及远民。\n充国筹边先蓄积，仲升抚士务宽仁。\n弯弧挟槊真馀事，好立奇勋继古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古岩书舍为叶仲立赋","author":"陈琏","text":"古岩胜景知何处，遥在沙棠紫翠中。\n春树阴垂萝薜雨，秋林香散木樨风。\n石镌鸟迹千年在，水浸龙湫一窍通。\n书舍夜寒灯火粲，文光千丈贯晴虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙泉道中遇雨","author":"陈琏","text":"策马晨经七宝龛，羊肠路小石巉岩。\n雨来已湿青丝鞚，云过常随白氎衫。\n十里好山浑似画，一溪新水政如蓝。\n鹧鸪啼急东风恶，客况诗怀两不堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王给事中奉使琉球国","author":"陈琏","text":"金门给事总名流，奉使咸推陆贾优。\n亲捧纶音辞凤阙，远持玉节去琉球。\n彭湖波静皇风畅，三屿山明瘴雾收。\n他日远人应侯问，好言圣化迈成周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张真人贺圣节回龙虎山","author":"陈琏","text":"龙虎真人上界仙，桂旗兰盖惯朝天。\n承恩长到黄金殿，侍宴曾陪白玉筵。\n午夜星辰回使节，西江烟水送归船。\n京华岁岁期相遇，来祝吾皇寿万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姚给事中升湖广参政","author":"陈琏","text":"朝端给事总能文，献纳才名最数君。\n宠命荣加三品秩，诰绫光绚五花纹。\n春回凤阙天应近，雪霁龙河曙欲分。\n此去薇垣参大政，好摅忠荩答皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送礼部郎中胡远升江西参议","author":"陈琏","text":"阙下文星焕紫虚，多君词藻似相如。\n鸣珂晓待金门漏，染翰时翻石室书。\n拜命初辞天禄阁，之官远赴斗牛墟。\n旬宣政要求民瘼，行见封章奏玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱正思归省","author":"陈琏","text":"都门相送柳依依，千里家山几日归。\n铁瓮城中春酒熟，钱塘江上鲤鱼肥。\n也知孤馆弹长铗，不似高堂戏彩衣。\n愧我宦游淹岁月，梦魂夜夜绕亲闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"致仕工部尚书严公震直哀挽","author":"陈琏","text":"盛年际遇荷恩荣，一旦登庸列上卿。\n风裁棱棱高百辟，忠诚耿耿著明廷。\n名垂竹帛应难泯，神寄丹青宛若生。\n愧我年来感知己，临风些罢不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄致仕宗人府经历黄子中","author":"陈琏","text":"使君家住桥亭上，致政归来乐事多。\n新竹阴连烧药灶，落花香度煮茶锅。\n吟诗每付门生写，载酒还容好客过。\n不得相随共谈笑，月明清夜奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江公子大潜归临安","author":"陈琏","text":"闻道临安风景好，凭君问讯近何如。\n钱王台榭久芜没，逋仙梅花今有无。\n物态人情那异昔，湖光山色想如初。\n他时登览定相忆，烦寄一封云锦书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄司业张公玄略时车驾幸太学","author":"陈琏","text":"昔日春官小宗伯，几年胄监少司成。\n弥纶治道多成绩，乐育贤才重有声。\n文运兴隆关气数，朝廷尊异在耆英。\n悬知许国心逾切，期听朝阳綵凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄成均诸先生二首 其一","author":"陈琏","text":"闻道銮舆幸辟雍，千年盛事此时逢。\n极知圣主恩荣重，共喜天朝道学崇。\n礼乐独称今日盛，车书已见万方同。\n嗟予莫缀班行行，空有丹心恋九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]