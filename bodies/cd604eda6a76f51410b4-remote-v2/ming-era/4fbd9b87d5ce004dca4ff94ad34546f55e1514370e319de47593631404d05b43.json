[{"title":"忆城东寄饯行十友","author":"吴与弼","text":"联镳接轸忆城东，绮席珍盘别醑浓。\n南北云泥悬隔久，高情常在梦魂中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10168,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寄夏官群彦","author":"吴与弼","text":"司马群英嘉惠深，联名锦轴重南金。\n当时愧失抠趋礼，别后难胜怅望心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10169,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王经历刘都事","author":"吴与弼","text":"外氏零丁一转蓬，欲从何处问孤踪。\n盍簪得遂平生愿，总属王刘雨露功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10170,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉题怀宁伯双骥图 其一","author":"吴与弼","text":"汗血俱曾成大功，丹青凛凛著英风。\n人间自有男儿事，杰出方名世上雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10171,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉题怀宁伯双骥图 其二","author":"吴与弼","text":"竞功双骥大功成，造父王良总擅名。\n设使当年无伯乐，何由千古著雄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10172,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寄忠国公令郎君","author":"吴与弼","text":"侨居几欲拜兰阶，多病因循愧夙怀。\n翠竹碧梧霄汉迥，五云深处望三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10173,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寄广宁侯二郎君","author":"吴与弼","text":"曾接亲庭花萼辉，亭亭玉树映金芝。\n圣明文教超千古，万轴牙签好及时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10174,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄太常高博士","author":"吴与弼","text":"杰作铺张天地心，大音寥阔国之琛。\n清风明月停云处，不信人间有古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10175,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄太学郑助教","author":"吴与弼","text":"自古文章贵作家，夫君当代富才华。\n案头夜夜增光艳，留与儿孙仔细誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10176,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄汤教谕","author":"吴与弼","text":"丽句流传众所钦，称扬太过实难任。\n虽云甚矣吾衰也，馀齿犹宜座右箴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10177,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寄南康郡侯","author":"吴与弼","text":"一接沙头金玉相，时从舟子话龚黄。\n几时一鼓沧浪棹，细和匡山白鹿章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10178,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沼上芙蓉花开","author":"吴与弼","text":"去年花盛客天涯，今岁花开人在家。\n万事只应随分好，不须憔悴对年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10179,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"作远书罢卧自得亭","author":"吴与弼","text":"群缄裁罢一身轻，又向高秋卧此亭。\n遥想故人天上梦，可知衰病日伶俜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10180,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拜表归途中作","author":"吴与弼","text":"记得重阳拜表归，乾坤清气映晴晖。\n红黄山果惊新候，又喜题诗野水湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10181,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青云亭","author":"吴与弼","text":"欲得灵台拔俗氛，特将亭子倚青云。\n朝朝剩汲寒泉润，细点明时辅世文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10182,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游塔山","author":"吴与弼","text":"去岁兹晨发望江，风帆夜泊小姑傍。\n来游此地怀萍梗，红树新晴候欲霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游天使峰","author":"吴与弼","text":"天使峰头境绝奇，重游恰近小春时。\n晴明风景尧天媚，安得情怀不赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游綵云山","author":"吴与弼","text":"选胜归时兴未阑，微吟更坐綵云山。\n出尘亭子休孤负，须把遗经日此摊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄郡庠陈广文","author":"吴与弼","text":"滥窃时名负愧多，劳君两辱碧山阿。\n墨池泮水宵来梦，红树西风寄短歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄邑庠陈广文","author":"吴与弼","text":"荐辱馀光烛草莱，琼瑶久矣负高怀。\n孤吟几对黄洲月，芹水清风不易裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日","author":"吴与弼","text":"岁华又值一阳生，豫汛庭堂贺太平。\n万壑金鸡天欲曙，四檐霜月雨初晴。\n学随年长嗟衰迈，道与时亨荷圣明。\n间傍溪梅寻嫩蕊，新诗兴绪绕虞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游三峰尖","author":"吴与弼","text":"晴明又喜蹑云烟，旧迹来游兴浩然。\n心事满怀题不尽，长吟回首五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贺吴营元氏驻节亭成","author":"吴与弼","text":"积李崇桃烛令辰，双溪雄峙一亭新。\n百年胜事光先躅，千载清芬激后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题新斋壁","author":"吴与弼","text":"莫怀端合惜年华，莫枉閒工事算沙。\n收敛寸心归寂寞，芸编堆里是生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同邱孔曼游胜览亭","author":"吴与弼","text":"积雨初收远岫明，盈眸生意黍苗青。\n偶乘佳兴良朋共，细咏新诗向此亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游霓旌亭","author":"吴与弼","text":"一历青云眼倍明，群峰联络自天成。\n迟回磐石忘归去，谁共斜晖俯仰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆前年今日","author":"吴与弼","text":"前年今日拜宸旒，天语亲承锡命优。\n几度忸怩疏薄质，洪钧浩荡若为酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆前年今日","author":"吴与弼","text":"前年今日拜文华，疏薄惭叨过宠嘉。\n谢病曾无一字补，可胜衰眼日添花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆前年今日","author":"吴与弼","text":"前年今日说中庸，内阁群英眷注浓。\n分惠御桃尝主客，归鞭姜米步从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七月二十六日作","author":"吴与弼","text":"流光一飞电，夙志良堪羞。\n末契何所托，尘编日遮眸。\n窗得竹林幽，亭有荷池胜。\n浅薄谅何为，于焉托馀命。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"车泰使归喜而作","author":"吴与弼","text":"山暝风高雨打衣，敲门知自玉墀归。\n椿萱綵服千重庆，台阁云笺万丈辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"敬梅轩为杨侍讲题","author":"吴与弼","text":"云坞琼枝处士栽，玉堂诗卷映三台。\n肃焉敬止哦吟处，难写孤芳万古怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆前年今日","author":"吴与弼","text":"前年今日急邮程，时向街头慨武城。\n此际独吟仍独卧，满怀秋思向谁倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆前年今日","author":"吴与弼","text":"前年今日达龙湾，人在沧江杳霭间。\n夜傍石头城系缆，旧游触目是乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆去年今日","author":"吴与弼","text":"去年今日五更兴，旌旆翩翩度野亭。\n精白一心悬北极，肃恭拜表进虞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"览戊寅日录作","author":"吴与弼","text":"竹窗时止亦时行，谁共清风明月情。\n忽忆前年今日兴，登高人在石头城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沼上亭玩芙蓉花","author":"吴与弼","text":"今岁花开幸粗康，虽贫却乃士之常。\n秋亭玩罢归来好，竹影扶疏旭日凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆前年今日","author":"吴与弼","text":"前年今日荷皇恩，冠盖盈庭客满门。\n霜鬓荐惊新岁月，涓埃未荅志空存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游山诗","author":"吴与弼","text":"小春风景日清妍，游衍乡园又一年。\n身幸平康心寡系，杖藜随处咏尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后游山诗","author":"吴与弼","text":"昨日登临兴未穷，重游喜得数生同。\n峰头徙倚忘归处，诗在云烟杳霭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄万叔璨","author":"吴与弼","text":"赤涧松楸迹久荒，荐劳青眼意何长。\n琼瑶未报身衰迈，几向南云梦北堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日讲堂朝贺","author":"吴与弼","text":"金鸡催曙鼓声雄，济济班行院肃雍。\n迎福共瞻刚长日，尧天欢舞万方同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"偶傍溪头咏落晖，烟村清眺意迟迟。\n低回细忆前年兴，逐一閒歌驿道诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书郑伉卷子毕偶成","author":"吴与弼","text":"残经讲罢慨虞唐，步月归来兴未央。\n诗卷写阑吟更好，又挥馀墨两三行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"德政歌","author":"吴与弼","text":"我忆弦歌武城宰，流风馀韵今安在。\n卓哉吕侯英妙年，碧梧翠竹何娟娟。\n却金海隅光使节，寒露玉壶浸霜月。\n牛刀小试鸣南州，长天雕鹗横高秋。\n丹诚烱烱慈仁父，反风灭火并伏虎。\n琴堂有教肃簪裾，犴狱虽设期空虚。\n南邻北里童与冠，含哺鼓腹相泮涣。\n春郊桑柘涨丛丛，秋原禾黍迷西东。\n邻封野人拜佳政，乐与舆人共涵泳。\n桃李阴阴清昼长，牙签玉轴森琳琅。\n列圣群贤屹相向，蓍龟指南如视掌。\n河海何曾择细流，泰山固不辞土壤。\n百尺竿头事若何，濯缨一曲沧浪歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠四老归进贤","author":"吴与弼","text":"花县仁风日念兹，黄眉冲雪到茅茨。\n予攸好德何能尔，信是人人共此彝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重庵歌为陈子宪题","author":"吴与弼","text":"借问仁者何乐山，巍峨屹立天地间。\n以木巽火是曰鼎，君子正位以凝命。\n浮生岁月疾于飞，庵中心事其奚为。\n去斯二者将安归，萧萧华发映黄眉。\n不远百里求新诗，咏歌付与孙与儿，奕叶仰止庵之楣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜感怀","author":"吴与弼","text":"曾赋山房一味清，沉吟旧梦转多情。\n千山万水迷归路，羞照秋霜鬓数茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同胡冕陈凤宿路口铺","author":"吴与弼","text":"乡情诗思共悠悠，烛尽宵阑立未休。\n记得丁宁檐际语，好来芸馆话春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚坐自得亭","author":"吴与弼","text":"春田课仆暂亲农，亭子閒来坐晚风。\n幸得微躯能勿药，崇桃又见一年红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题程佥宪骢马行春诗卷","author":"吴与弼","text":"行行无用避桓骢，霜雪何妨雨露功。\n缘道生灵迎望处，铁冠遥在万花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题全归诗卷","author":"吴与弼","text":"遍历儒冠四十年，荣膺上寿际尧天。\n跬步敢忘曾氏教，临深履薄日乾乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送原宪使考迹赴天官","author":"吴与弼","text":"清笳急管拥崇台，万里风云接泰阶。\n花柳漫村春似海，伊谁一访少陵才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重宿吕坊龙归寺","author":"吴与弼","text":"曾为松楸此寓居，二旬风月体舒舒。\n天上归来重宿处，青灯细看旧时书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿杨溪","author":"吴与弼","text":"疾风飞雨宿杨溪，虚室孤吟忆旧时。\n不是本原深且厚，云仍何幸至于斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨溪晚眺","author":"吴与弼","text":"一水逶迤抱竹居，群峰稠叠映天衢。\n迟回独散平桥步，二百年前是我庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拜山泉先生墓","author":"吴与弼","text":"长从家集慨穷经，述作尤深感至情。\n巴冈遗陇低回处，饱挹山泉一味清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立秋","author":"吴与弼","text":"茅屋秋风已满林，老怀却忆少年吟。\n丈夫壮志今何似，空感平生灯火心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄傅裘","author":"吴与弼","text":"洗墨池边佳问来，月窗重感故人怀。\n几时池上翚飞好，伫见新碑向竹开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送傅裘北归","author":"吴与弼","text":"扶疾秋山百里来，桑榆细写别离怀。\n式微歌罢情如海，共喜新碑吉日开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游罗原冈诸族侄咸在","author":"吴与弼","text":"上下罗原冈上路，西风斜日共跻攀。\n新诗付与吾儿道，奕叶当思继述难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重宿经舍寺","author":"吴与弼","text":"重宿招提觅旧游，百年心事在松楸。\n江村送客归来好，明月清风咏素秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自杨溪过葛藤科","author":"吴与弼","text":"港下归鞭问葛藤，名科山水总含情。\n朋游迎送秋江晚，古渡寒流月影清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓枕偶成","author":"吴与弼","text":"戊寅此日吟淮水，辛巳今朝病故园。\n时序暗随生纪换，寸心依旧五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枕上偶成","author":"吴与弼","text":"万事随缘不用忧，好将行止范前脩。\n当兹岁晚尤宜惜，独对黄花咏未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊寅此日","author":"吴与弼","text":"戊寅此日度真州，坝上閒书几字留。\n薄暮喜投扬子宿，青山近接石城秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辞家口占授诸生","author":"吴与弼","text":"我去寻师适楚邦，归期应在日初长。\n残书破砚须深护，跬步分阴好自强。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"狭原道中","author":"吴与弼","text":"小春风雨路初乾，又向名原话考槃。\n却忆十年前胜事，门前骥子踪游观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿北泽","author":"吴与弼","text":"云坞濛濛湿不开，长途行李后先催。\n前山寓宿询名姓，曾向龙潭问学来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"北泽道中","author":"吴与弼","text":"濛濛宿雨又开晴，僮御奔忙四体轻。\n红树青山溪曲屈，胜游随处是诗情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湓源道中","author":"吴与弼","text":"度坳蹑岭一徐行，回首双峰独注清。\n更出前村舒病眼，时从牧竖得源名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重宿墨池傅氏","author":"吴与弼","text":"洗墨池边正己堂，问舟西去又投装。\n儿孙总解隆先执，更把前题续两行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿桂林","author":"吴与弼","text":"冒雨冲泥宿桂林，卑尊奔走事师心。\n一壶春酒谈经罢，独咏青灯坐夜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次前韵寄示儿","author":"吴与弼","text":"到处虚名动士林，平生孤负秉彝心。\n过情却更忧吾子，新造从兹冀日深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠进贤吕茂宰 其一","author":"吴与弼","text":"薄劣何劳谊薄云，野桥迎候度朝暾。\n绵绵却忆宵来雨，谁道荒村拥令君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠进贤吕茂宰 其二","author":"吴与弼","text":"西去寻师学士家，远劳旌旆驻晴沙。\n分岐细话男儿事，珍重清芬百世誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题正心斋","author":"吴与弼","text":"涵养工夫敬是宜，鉴空之体本如斯。\n须知道理平铺在，顺应何容一点私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿三江口","author":"吴与弼","text":"雨脚朝来又似麻，问舟并午踏晴沙。\n平林系䌫推篷处，星月交辉杂綵霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]