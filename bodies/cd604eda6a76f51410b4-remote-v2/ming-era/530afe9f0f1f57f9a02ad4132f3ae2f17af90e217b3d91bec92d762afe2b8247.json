[{"title":"留别伦右溪十咏 其四 浴日亭","author":"王渐逵","text":"窅然天地起玄思，浴日亭边忆汝时。\n此去蓬莱知不远，金银宫阙碧参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别伦右溪十咏 其五 朱明洞","author":"王渐逵","text":"羽驭飙轮何处依，归来应与稚川期。\n罗浮月色明如昼，万树梅花开雪扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别伦右溪十咏 其六 九洲湖","author":"王渐逵","text":"曾着烟蓑下九洲，共将心迹蔑羊裘。\n湾前钓得鲈鱼脍，十月山村酒正篘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别伦右溪十咏 其七 灵洲","author":"王渐逵","text":"几年山馆住栖霞，八十雪僧共一家。\n夜半迦陵音大切，满空寒翠落天花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别伦右溪十咏 其八 海珠","author":"王渐逵","text":"天从北极中央见，月向群山到处明。\n翻忆廿年观海意，榕阴高卧听潮声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别伦右溪十咏 其九 深明馆","author":"王渐逵","text":"曾共移居卜筑心，携壶相问数相临。\n何当跨鹤同归去，翠竹桃花春正深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别伦右溪十咏 其十 阆风台","author":"王渐逵","text":"白云高并阆风台，花竹阴阴护径苔。\n重忆石池曾觅句，惠莲群从总多才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹿洞","author":"王渐逵","text":"徒几从骈荫，寻源上急湍。\n驻云窥石刻，回鹤认儒冠。\n太守还留客，诸生半候门。\n肩舆时取兴，归路任黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖贤桥","author":"王渐逵","text":"爱尔栖贤地，虹桥驾碧漪。\n洞传唐李勃，碑刻宋淳熙。\n落日闲丹壑，长风怯葛衣。\n欲穷庐阜顶，五老会相期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹿有怀平嵩刘同年和玉溪","author":"王渐逵","text":"佳人在浚谷，婉娈美容姿。\n玄露荫瑶草，玉洞环青芝。\n旅石自成磴，方流以为池。\n林深不可见，筇履遥相逢。\n猿鹤守空山，白云还候期。\n无为渡虎溪，溪流漫多岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖贤桥再和玉溪韵","author":"王渐逵","text":"值性癖幽豁，临流爱兹泉。\n幸遇同心友，肴酌相周旋。\n丹崖散云俦，明汉通瑶川。\n乔松生涧底，灵珠产澄渊。\n所以庐阜峰，自昔称多贤。\n我亦慕陶者，赠子南山篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同济美王郡守游通天岩","author":"王渐逵","text":"肩舆渡丛翳，群峰送秋妍。\n石磴峭青壁，丹梯郁盘旋。\n遐荒迥万里，谁云可通天。\n大宇浩杳冥，寓目俱云烟。\n兹游亦奇绝，邂逅非徒然。\n长啸响山谷，萧风起林巅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中寄黄樗亭社长二首 其一","author":"王渐逵","text":"文砌疏棂曲径依，淡烟芳荫堕游丝。\n石池无限桃花发，飞去黄鹂唤子规。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中寄黄樗亭社长二首 其二","author":"王渐逵","text":"寻春须是及春时，红紫千山映酒卮。\n莫待春归却成恨，冱林溟雨漫霏霏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别郑东溟同年 其一","author":"王渐逵","text":"磊落东溟子，为官迟尔期。\n十年犹未转，五马得深依。\n落日桑麻课，春风岛屿诗。\n何时苍海上，相对拾珠玑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别郑东溟同年 其二","author":"王渐逵","text":"玉扃馀闲散，灵纵漫眺游。\n星岩敞丹穴，蓬阁瞰瀛洲。\n海水几清浅，云槎任去留。\n帝阍归召近，苍佩待螭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安德道中杏花盛开感而赋此","author":"王渐逵","text":"一从羁客落天涯，两见青春管物华。\n黄鸟相呼如唤友，杏花虽好不为家。\n平川渺渺际烟树，远戍悠悠隐暮笳。\n惟有萝峰旧时月，傍人深夜印晴沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李三洲中丞六首 其一","author":"王渐逵","text":"去年重九月，疏乞归田园。\n荏苒忽半载，羁栖尚盘桓。\n乃知一有系，所志弗获颛。\n黄鹄举遥汉，白鸥泛回湍。\n星辰历起忽，浩川长漫漫。\n捐置苦不早，叹惜夫何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李三洲中丞六首 其二","author":"王渐逵","text":"玄春变时叙，频夜梦故乡。\n故乡亦何为，母氏在北堂。\n白发遥倚门，兄弟罗其傍。\n廿年侍羞馔，一朝异飞翔。\n燕越邈脩阻，尺书非所将。\n飙车何时驭，我心悲以惶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李三洲中丞六首 其三","author":"王渐逵","text":"蚁丘幻山岳，腐草化为萤。\n大运古所然，谁能测降升。\n人生不满百，岂不在荣名。\n桃李媚春风，皋兰被秋荣。\n斗酒共相慰，迟明解宿醒。\n劝君且尽醉，明日非所营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李三洲中丞六首 其四","author":"王渐逵","text":"吾质禀孱弱，畏此朔风多。\n雨雪屡以遭，漫漫际关河。\n重裘亦云袪，盆燄日相过。\n岂无徇国志，奈此冱寒何。\n狐貉栖北山，葛藟生南坡。\n物性各有适，为用知匪讹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李三洲中丞六首 其五","author":"王渐逵","text":"越城结诗社，朋旧日相亲。\n未及三周星，形迹多暌分。\n讵知一别后，何时还同群。\n人生百年内，欢乐难几辰。\n仙人不可期，求者迷其津。\n愿言结终好，永作同心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李三洲中丞六首 其六","author":"王渐逵","text":"圣世崇作述，礼乐嘉虞周。\n猃狁窥朔方，檄书动明旒。\n嗟予蹇迂谬，抗颜出山丘。\n一朝上封事，疾者如寇仇。\n文犹既已违，武志亦未酬。\n慷慨动悲歌，但为识者羞。\n居诸忽已遄，冥心更何求。\n九十行带索，荣公乃吾俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送伦穗石之留都","author":"王渐逵","text":"局曹闲杂协高情，何逊才名重两京。\n王谢宅边闻燕语，雨花台上听鸡鸣。\n秋深牛首题应遍，月到秦淮句转清。\n休向六朝寻旧事，满堤烟柳障台城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘石桥之江西廉宪二首 其一","author":"王渐逵","text":"十年荒徼尚留名，阅尽风霜见老成。\n旌阳剑气应常在，为扫妖氛答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘石桥之江西廉宪二首 其二","author":"王渐逵","text":"南浦秋深正忆君，西山爽气净风尘。\n豫章亭上多高士，应有当年下榻人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中寄李三洲","author":"王渐逵","text":"西蜀方回舟，八蛮随安㘘。\n两晤樾森楼，一对珠海寺。\n如何廿年交，匆匆复相离。\n惠我书数箧，玄文更深秘。\n山中诵且绎，念子不能寐。\n何时预扫云，共语观水记。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中寄冯次冈","author":"王渐逵","text":"忆昔洛澄里，竹阁深微凉。\n款语迟刻烛，披衣起联床。\n讵意十六载，睽异天各方。\n徘徊樾森楼，悲观共登堂。\n青春庆嘉衣，浩首怜故乡。\n童稚倏已惊，主宾浑相忘。\n环列驻清荫，逶迤转回塘。\n景色夕更佳，为乐讵未央。\n愿言常见亲，眷藉君子光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张宪长过访诗以谢之","author":"王渐逵","text":"问俗惊看到野人，怀贤今喜得相亲。\n荒林已见无留暑，冻雨应先为洒尘。\n礼介岂堪从委巷，青山久不拜朱轮。\n三吴明日空回首，愁对文星入望频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答伦右溪云谷之约","author":"王渐逵","text":"云谷我所慕，眷游迟其期。\n霖雨倏以霁，岩壑储清辉。\n亭亭云上楼，霭霭岚中扉。\n朱实垂前荣，互萝翳其篱。\n溽暑无留辙，凉风有深居。\n忆我同袍友，取乐方在兹。\n瑶篇愐盱枉，凝神忽相随。\n会晤期不爽，对景起长怀。\n短章答嘉惠，伫立增怅咨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻伦穗石归诗以迓之","author":"王渐逵","text":"苦忆春曹伦穗石，三秋不见愁年华。\n才誇海内怜閒扃，诗满江南识大家。\n归来且食端午粽，别移惊见新园花。\n更闻云谷荔枝熟，好栖越秀餐丹霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其一 齐云山","author":"王渐逵","text":"下界尘嚣隐万家，中天积翠敞烟霞。\n何时更有清泉约，共试卢仝七碗茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其二 紫帽峰","author":"王渐逵","text":"美人家在女牛东，玉洞玄关几万重。\n我欲乘鸾时一访，莫教岩畔紫云封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其三 宝盖山","author":"王渐逵","text":"宝盖参差映石台，茅斋遥傍翠微开。\n谈真道士携琴去，问字门生载酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其四 九日山","author":"王渐逵","text":"寂寞空山歌采芝，菊花开遍雁声迟。\n一尊散发峰头卧，和得文公九日诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其五 梅花山","author":"王渐逵","text":"地有梅花非俗境，山栖贤哲是灵基。\n暗香疏影无边趣，好似罗浮月上时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其六 莲花峰","author":"王渐逵","text":"濂洛孤标太华斋，是谁传向入闽西。\n先生独坐看无极，霁月光风共一溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其七 高士峰","author":"王渐逵","text":"解徂归来万劫空，小山兰桂已成丛。\n逢人不识秦居士，只向溪头问紫峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其八 金粟洞","author":"王渐逵","text":"帽峰原是小瀛洲，金粟相传玉洞留。\n逢着紫霄烦一问，化书何事属齐丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其九 清源洞","author":"王渐逵","text":"源头清彻浩无涯，西岸蒸桃染绛霞。\n岩外风尘浑不到，莫将流滓腻飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空山吟十咏有序 其十 东湖","author":"王渐逵","text":"举杯邀月自开颜，烟水冥冥净四山。\n不着羊裘湖上去，恐将形迹落人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘颐斋道人歌","author":"王渐逵","text":"颐斋道人性冲泊，萧然远慕桑柴风。\n有时幅巾去入社，脱纵世外凌孤鸿。\n吟诗不作烟火气，遣兴每陟罗浮宫。\n何当共约飞云顶，三峰上界看鸿濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻龙子吹箫","author":"王渐逵","text":"龙子自吹还自清，箫声遥与凤和鸣。\n夜深此乐凭谁会，莫怪山人着意评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日田园漫兴","author":"王渐逵","text":"圈牛眠犬自村家，淑气晴烟改岁华。\n人日已过还谷日，梅花开尽见桃花。\n抛书扫榻惟耽枕，戒酒逢人祇啜茶。\n津口不遥渔子熟，旋将舂米博鱼虾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其一","author":"王渐逵","text":"旧时邻舍已生疏，此日归来得尽娱。\n田父隔村谈款曲，旋刍新酒摘园蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其二","author":"王渐逵","text":"多时种树已成丛，屋角墙头地不空。\n拂瓦轧墙犹不忍，留遮炎日待凉风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其三","author":"王渐逵","text":"高畬车水力难强，近筑荒陂水圳长。\n佃子喜欢相对语，今来不怕旱来妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其四","author":"王渐逵","text":"田头五亩接生涯，半莳茄瓜半莳茶。\n莫道耕园强种树，荔枝龙眼更多花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其五","author":"王渐逵","text":"接得绯桃谨护持，那堪生意太迟迟。\n祇缘冈土多黄瘠，春到开花仅一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其六","author":"王渐逵","text":"旧买黄牛学教犁，每凭田叟得持维。\n儿童争报喧门径，今岁新生一㹀归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其七","author":"王渐逵","text":"近来海贼不惊村，官府犹呼窃闸门。\n暂约社闾休紧禁，上元灯好得相观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其八","author":"王渐逵","text":"溪头谷日罕逢人，历日通书迥不闻。\n欲作牛栏脩茧箔，几回溪畔待春分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其九","author":"王渐逵","text":"雨涨咸潮欲退时，沙螺?蚬正交肥。\n长歌逐队来江口，知是儿童下水归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句十首 其十","author":"王渐逵","text":"村家处处整犁蓑，才入春来百务多。\n却爱有情双白鹭，柳塘无事日相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠程玉峰","author":"王渐逵","text":"阁皂新添碧玉峰，罗浮孤影对相容。\n葛洪已熟三千鼎，禦寇还乘几日风。\n沃渚露寒秋色瞑，青丘云迥鹤声雄。\n尘嚣未脱冥冥翮，竟日驱驰愧尔同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邵端峰方伯之山东","author":"王渐逵","text":"曾是君王侍从臣，石渠文藻动儒绅。\n廿年湖海空馀梦，六省台垣重看人。\n遥忆灵光能作赋，即看汶水更知津。\n观风南国堪谁采，野史名山只自论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其一","author":"王渐逵","text":"白日青天迥不沦，帝王中国自传神。\n庄周万古堪长罪，幻说西方有圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其二","author":"王渐逵","text":"汉儒糟粕汨天常，寥落侵侵入晋唐。\n至宝眼前浑不识，却从胡黠乞馀光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其三","author":"王渐逵","text":"云谷归来夜未央，绕篱黄菊映秋芳。\n閒陪无极翁迟坐，风月满庭花正香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其四","author":"王渐逵","text":"击壤吟成梦已非，每因康节畅玄机。\n閒随安乐窝边去，带得先天一片归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其五","author":"王渐逵","text":"洛源清彻溯明河，浩浩春风散碧波。\n洙泗若为分席坐，不知颜闵竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其六","author":"王渐逵","text":"壁立崚嶒万仞翱，伊川今古更人豪。\n却怜逐影寻声者，浪说当年帽䇶高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其七","author":"王渐逵","text":"考亭一脉本轲丘，著作遥知为世谋。\n却怪虚谈狂谬者，摘从枝叶倍寻搜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其八","author":"王渐逵","text":"大道人人本自存，每于居处得真诠。\n不知扇颂缘何事，却蹈西方竖佛门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其九","author":"王渐逵","text":"万派源头一贯之，入门朱陆未应岐。\n鸣冤定论浑多事，只向人间管是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十","author":"王渐逵","text":"台上阳春日半晖，石翁寻乐已忘机。\n溪头忽遇程夫子，长笑吟风弄月归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十一","author":"王渐逵","text":"八百僧同了性缘，谁知行者得心传。\n当时若解真空幻，碓下应须出圣贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十二","author":"王渐逵","text":"了悟由来迥未融，须知外内本无空。\n舞雩三省曾家业，到底何人得所宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十三","author":"王渐逵","text":"六经群圣本宗元，派出新枝尽子孙。\n翻笑世儒痴自异，错将苗孽作根源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十四","author":"王渐逵","text":"尽逃贤圣向禅求，杨简风狂更可忧。\n始信象门山径别，卜商流派有庄周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十五","author":"王渐逵","text":"名利滔滔逝不还，是谁于此更开颜。\n人间尽遂浮生乐，梦觉元来第一关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]