[{"title":"陵祀 其二","author":"王世贞","text":"回合宫墙出，分趍礼数同。\n夜归千嶂里，春度百花中。\n列宿俱垂野，洪涛并在空。\n出游神意肃，石马自鸣风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅友 其一","author":"王世贞","text":"颖考元工俗，来讥阮氏狂。\n诗何预成败，酒颇碍行藏。\n雄白元难守，雌黄未易当。\n先生但吟醉，荅尔意茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅友 其二","author":"王世贞","text":"稍为耽诗酒，都忘世路难。\n诗凭千古在，酒放一身宽。\n湿束豪雄小，途深礼数安。\n那能事斯语，便欲弃微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同于鳞茂秦集韦寺水亭分韵得重字","author":"王世贞","text":"偶成春服始，挟侣问幽踪。\n芳草近寒食，空林闻午钟。\n惊波双鸟出，迷路一僧逢。\n欲竟名园者，停杯感慨重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简茂秦","author":"王世贞","text":"飘梗真难系，垂杨未可攀。\n君名去留外，吾道是非间。\n且白人前眼，凭苍客后颜。\n萧然一长揖，诗句满春山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过秋曹后怀棘寺旧欢寄谢诸丈人 其一","author":"王世贞","text":"棘寺饶期集，怜予齿最卑。\n暮云催握醑，秋雨听弹棋。\n攀附多先达，风流并我师。\n不堪今咫尺，相望即天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过秋曹后怀棘寺旧欢寄谢诸丈人 其二","author":"王世贞","text":"兴爱提壶语，归从款段催。\n落花风后径，芳树雨中杯。\n禄薄存交谊，官閒见吏才。\n未愁西省隔，折简即能来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过秋曹后怀棘寺旧欢寄谢诸丈人 其三","author":"王世贞","text":"忆尔郫筒酒，来从蜀客船。\n开尊须尽日，促席解忘年。\n懒即隗俄坐，酣仍鼓跌眠。\n只今云省夜，茶椀对残编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻卢生将出狱志喜 其一","author":"王世贞","text":"闻道游梁狱，斯人实可悲。\n红颜翻自累，白璧转堪疑。\n失意乾坤小，孤踪雨露迟。\n向来吹黍律，开落竟由谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻卢生将出狱志喜 其二","author":"王世贞","text":"骨立卢生在，群销好自支。\n膏焚独明日，灰暖再然时。\n鹦鹉元惊众，鹪鹩未稳枝。\n江湖去仍广，勺水借恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻卢生将出狱志喜 其三","author":"王世贞","text":"此际狱中剑，曾逢雷令非。\n提携终奋迅，拂拭有光辉。\n一旦雄心托，千年国士稀。\n凭将报恩用，不作化龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧之楚","author":"王世贞","text":"西来为传法，南下岂离群。\n夜梵神鱼响，秋空法雁闻。\n浮杯洞庭月，飞锡衡山云。\n若向黄梅去，心香一寄焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"憩弘慈寺空上人房","author":"王世贞","text":"下马叩空门，逢僧礼白云。\n为心一萧散，别路自尘氛。\n犬避昙花席，鼯餐贝叶文。\n大都论佛性，难作有无分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许解元悼妾 其一","author":"王世贞","text":"带有同心在，丝将续命迟。\n泪偷埋玉地，心折赐珠时。\n解幌风从入，钩帘月自垂。\n安仁故亡恙，不那鬓成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许解元悼妾 其二","author":"王世贞","text":"天上仙期迫，人间别恨深。\n吹箫不同去，步幄杳难寻。\n入梦惊纤玉，闻香剩郁金。\n都将可怜意，留作断肠吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许解元悼妾 其三","author":"王世贞","text":"十五绣鸳鸯，妆成赠阮郎。\n蛾眉西岭月，鸾镜九秋霜。\n小雨流苏暗，阑风锦簟凉。\n欲从天外觅，谁遣返魂香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许解元悼妾 其四","author":"王世贞","text":"云鬟白玉酥，人道胜罗敷。\n所念前鱼泣，宁知别鹤孤。\n同心误綵繸，如意妒珊瑚。\n往日西陵柏，萧萧长夜徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小理花榭漫兴 其一","author":"王世贞","text":"谢客冠长解，抛书酒渐亲。\n陋甘为圃问，拙忆灌园人。\n引瀑全宜暑，栽花已过春。\n忽惊摇落思，高柳暮蝉新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小理花榭漫兴 其二","author":"王世贞","text":"小树僮能接，繁花手自修。\n闭门疑在野，积雨乍成秋。\n万事何青眼，诸公岂黑头。\n还嗔妻子问，祇为俸钱留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小理花榭漫兴 其三","author":"王世贞","text":"落落孤松树，空斋意敞然。\n谁来醉明月，独坐看青天。\n解发步兵啸，披襟中散弦。\n那能畏官长，骑马问流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小理花榭漫兴 其四","author":"王世贞","text":"握管真凭我，衔杯不让人。\n风尘世已甚，慷慨复何陈。\n岁月持螯手，朝廷食肉身。\n无为互嘲诮，各自有沉沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐圜任福宁吏目","author":"王世贞","text":"禄薄君休问，闽天可计程。\n呼儿看蜃市，对客注鱼经。\n岩雨任公白，山云天姥青。\n萧然坐州幕，鸟雀下空庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题 其一","author":"王世贞","text":"转目风尘色，人间睥睨过。\n官贫为具少，儿病检方多。\n时论俱戎马，乡心几薜萝。\n毋劳问推毂，吾意亦从它。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题 其二","author":"王世贞","text":"案牍吾何厌，形骸久就拘。\n聊因对樽酒，相与得须臾。\n宦路皆先达，诗名岂病夫。\n乞归犹未敢，清梦或江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜师锡比部夜来自南留酌有赠","author":"王世贞","text":"三载传书札，相逢恐未真。\n应门欢旧仆，屈指问交亲。\n鸡黍贫能具，莺花晚更新。\n相看素衣在，天地久风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣兴 其一","author":"王世贞","text":"日月真萍梗，乾坤任酒卮。\n独行身外计，苦思鬓间知。\n得路车惊辙，争栖鸟剩枝。\n小儿能学语，不遣诵吾诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣兴 其二","author":"王世贞","text":"浩浩乾坤里，支离未可凭。\n孤踪病妻厌，高卧鄙夫能。\n归计乡音薄，微官世态增。\n讨论多战伐，或恐在坚冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安初月 其一","author":"王世贞","text":"长安半轮月，霜色满金河。\n侠客闻刁斗，天山一剑过。\n横穿郅支塞，归骑晓星多。\n忽忆卢家女，流黄欲罢梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安初月 其二","author":"王世贞","text":"青楼狭邪妇，秦月照眉鸦。\n荡子嫖姚幕，寒霜作鬓花。\n功成万户赏，莫向枕边誇。\n西去金张里，生来将相家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪比部迁庆阳守问之","author":"王世贞","text":"吾爱汪夫子，虬髯凌紫烟。\n诗仍我辈读，官得众人怜。\n北地逢贤守，匈奴可近边。\n几时驱马发，雪里渡秦川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"群盗 其一","author":"王世贞","text":"赤子吾焉忍，兵戈见绿林。\n横行锋可近，不杀意仍深。\n江海思骸骨，朝廷问腹心。\n谁云大臣在，家国共沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"群盗 其二","author":"王世贞","text":"天遣文安盗，狼山一夕风。\n深恩是先帝，急难有群公。\n身世吾何晚，乾坤事未穷。\n岂堪辽左戍，吹角月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题东皋隐居四首 其一","author":"王世贞","text":"世路已知晚，山花长见春。\n曾为独醒者，归学耦耕人。\n小妇能蚕事，诸孙理钓纶。\n青天五柳下，藜杖一閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题东皋隐居四首 其二","author":"王世贞","text":"菰城秋欲老，儿女亦欣然。\n罢社金香酒，迎寒雪色绵。\n登场鸟雀下，出市鱼虾鲜。\n兴发苕溪畔，长吟梁甫篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题东皋隐居四首 其三","author":"王世贞","text":"偶来天目卧，修竹自成居。\n飞瀑面衡宇，青山手道书。\n花间谢车骑，镜里出樵渔。\n不学于陵叟，桔槔恒晏如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题东皋隐居四首 其四","author":"王世贞","text":"犊外收春雨，松间候夕舂。\n比邻过流水，燕坐数诸峰。\n白帢野人狎，篮舆刺史逢。\n愀然云色变，或恐出从龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁寺同诸子饯别公实 其一","author":"王世贞","text":"上方期不住，初地已成赊。\n握手苍梧阔，题诗白日斜。\n坐深闻圣乐，别至散天花。\n归向曹溪路，新诗悟后誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁寺同诸子饯别公实 其二","author":"王世贞","text":"白足逢高侣，黄金说胜缘。\n雨时龙象出，星外佛灯悬。\n斯物能千古，吾人各一天。\n还应斗间气，相望并森然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜饮柴生","author":"王世贞","text":"吾晚耽刘毅，枭卢一掷回。\n天风吹帻堕，海月趁杯来。\n醉习时人态，狂容傲吏才。\n思从市中侠，走马度章台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"濮阳李明府自新喻再寄予诗兹以觐事驻城外属时禁方严不得出视怅然有怀","author":"王世贞","text":"晓露沾凫舄，寒星识雁臣。\n君行濮上路，予忆郢中人。\n河岳成跬武，天涯岂比邻。\n解严须努力，春事日方新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江","author":"王世贞","text":"秋江有殊色，木落芙蓉鲜。\n飒尔一鸿去，天空波淼然。\n偶来维楫步，忽忆伐檀篇。\n欲采谁堪寄，徘徊空自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张虞部伯启左迁常州别驾 其一","author":"王世贞","text":"与说当年事，孤臣奋欲飞。\n乾坤淹带甲，风雨促征衣。\n事定殊文武，权归互是非。\n所论宁远谪，惜尔寸心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张虞部伯启左迁常州别驾 其二","author":"王世贞","text":"国难徵兵日，君恩佐郡年。\n郡横秦望雨，兵入蓟门烟。\n众谓波相及，吾知道固然。\n还期保障意，兹地股肱偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张虞部伯启左迁常州别驾 其三","author":"王世贞","text":"冠盖无容地，萧然一郡丞。\n孤帆下扬子，秋色满毗陵。\n白日垂难问，青云傲可凭。\n汝能勤抚字，夫岂愧飞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张虞部伯启左迁常州别驾 其四","author":"王世贞","text":"把袂翻轻别，沾膺自感时。\n主恩迁地近，吾道小臣宜。\n月迥延陵剑，潮平太伯祠。\n古人崇退让，今子莫凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十四日夜同茂秦于鳞子与子相集灵济宫公实馆分韵得灯微二字 其一","author":"王世贞","text":"欲暝天全白，将规月渐升。\n龙衔员峤烛，星灿紫微灯。\n绮色深三殿，钟声散五陵。\n醉须携兴住，春事日相仍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十四日夜同茂秦于鳞子与子相集灵济宫公实馆分韵得灯微二字 其二","author":"王世贞","text":"夜色瑶宫映，华灯玉树依。\n参差见花发，历乱觉星微。\n禁籞通沉火，仙音度羽衣。\n还看醉来夕，缇骑禁全稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春同于鳞公实访谢茂秦华严庵 其一","author":"王世贞","text":"吾与二三子，行游览物华。\n暖仍幽径雪，寒未给园花。\n客熟能为黍，僧贫只施茶。\n更愁归兴促，骑马问人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春同于鳞公实访谢茂秦华严庵 其二","author":"王世贞","text":"白社迟安石，青林叩远公。\n乾坤吾辈在，身世几时同。\n草树寒辉后，松杉暝色中。\n重来应烂漫，一笑虎溪风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有秦生者尝尚鲁翁主后流落死京师其友李子为治后归之","author":"王世贞","text":"昔侍灵光日，红颜白玉珂。\n恩深百岁少，贫至一身多。\n故旧生涯在，悲欢隔世过。\n还逢脱骖者，沾泪向江河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问讯梁公实 其一","author":"王世贞","text":"问讯梁公实，声名未寂寥。\n病何关药饵，贫岂任渔樵。\n十载能吾辈，同心正久要。\n边书况昨日，散捷紫宸朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问讯梁公实 其二","author":"王世贞","text":"汝病风尘外，吾衰景物中。\n词人歌太乙，酒客卧新丰。\n弹铗心犹嗜，驱车路转穷。\n飘然五噫咏，天地一梁鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其一","author":"王世贞","text":"得汝三年内，那能一日忘。\n谁知浪惊喜，翻为助悲伤。\n处处难开眼，时时总断肠。\n病夫骨髓尽，未数泪千行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其二","author":"王世贞","text":"一病无旬日，奄然丧此身。\n何心吾在世，无计尔为人。\n昨抚犹如玉，今看已作尘。\n平生娱弄物，触着暗伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其三","author":"王世贞","text":"眉目真如画，聪明解读诗。\n见人为礼法，依母倍恩私。\n事事俱堪系，声声未忍离。\n不眠仍起唤，星斗夜空垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其四","author":"王世贞","text":"月月山东使，平安两字存。\n昨来见书到，半是忆儿言。\n汝爷心已折，汝祖念弥敦。\n说到伤情处，青天日自昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其五","author":"王世贞","text":"动止能如意，欢啼并可亲。\n纵无千里足，堪慰百年身。\n得食先分姊，更衣必示人。\n难挥汝爷恸，闻者亦酸辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其六","author":"王世贞","text":"不禁西河眼，悲深渐欲枯。\n逢人失应对，散帙强支吾。\n颠倒还疑梦，依稀或类呼。\n谁将二女慰，转见一身孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其七","author":"王世贞","text":"见汝娟娟静，谁能不解颜。\n身唯识燕市，骨仅返吴山。\n痛入啼呼外，逢应梦寐间。\n如怜泣成血，他日见探环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其八","author":"王世贞","text":"芝兰春已折，庭馆昼空沉。\n判老江湖骨，难窥天地心。\n入门伤几案，跨马畏朋簪。\n欲问容身地，茫茫不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其九","author":"王世贞","text":"可爱俱无迹，唯馀一痛伤。\n招魂归杳旷，追路失苍茫。\n万事甘人下，馀生怕日长。\n泪痕罗幌底，斜月映如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡儿果祥诗十首 其十","author":"王世贞","text":"慰藉诸亲旧，殷勤强破愁。\n斯文一身在，远道二亲忧。\n感极神俱竦，声吞泪复流。\n忘情岂我辈，分已愧庄周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公实能数学未许予上寿也书此自解","author":"王世贞","text":"聊寻攴覆者，何日尽予年。\n万事俱人后，那能此独先。\n汝云无蔡泽，吾道岂彭篯。\n不见青门土，千秋谁更贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子相在告以诗问之时予抱沉忧之疾久矣 其一","author":"王世贞","text":"吾久违朝谒，君何抱病同。\n诗成无万事，吏任有群公。\n今古荣华外，行藏感慨中。\n想应填巷辙，门掩白云空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子相在告以诗问之时予抱沉忧之疾久矣 其二","author":"王世贞","text":"尔病犹能赋，挥毫捷有神。\n浮云愧知己，细雨向吟身。\n伏枕谋逾拙，缨冠性岂驯。\n倘怜长醉意，不减独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入临皇太子","author":"王世贞","text":"蓟北逢春尽，千门积雪多。\n忽闻俱痛哭，竟已接讴歌。\n月隐中峰岳，星摧幼海波。\n可如王子晋，骑鹤一来过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送戴同年令闽","author":"王世贞","text":"怜君似安道，而我愧王猷。\n清夜数相过，玄言时自酬。\n宦游轻别路，作吏更南州。\n山阁荔枝熟，毋忘西北邮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱大","author":"王世贞","text":"钱起名儒术，兼为医者师。\n论心或不愧，缘病得相知。\n乘遽君何往，飞觞醉不辞。\n莫言离别易，看取鬓边丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]