[{"title":"和许龙石同年会诗三首 其三","author":"孙承恩","text":"从前岁月等虚过，此夕传杯话昔科。\n不讶萍蓬飘转易，独嗟兄弟仳离多。\n鬓毛莫计纷如雪，意气须教老不磨。\n黾勉及时期报主，只今吾已愧蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和艮所留别韵","author":"孙承恩","text":"久别风标喜再瞻，客斋话对雨廉纤。\n高怀自喜清閒胜，舆论同嗟岁月淹。\n会有徵书还棨节，且将行色冒寒岩。\n阳春已是难为和，况复新章韵更严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答王舜钦送别诗韵二首 其一","author":"孙承恩","text":"吾道都来出处间，清朝敢谓直躬难。\n衰慵病每思丹饵，猿鹿心惟恋故山。\n天诏宠临愁莫避，冥鸿飞去羡难扳。\n何当恳乞终投隐，日与溪翁野老班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答王舜钦送别诗韵二首 其二","author":"孙承恩","text":"野性从来水石间，仕途祇觉病躯难。\n种放误教徵北阙，谢安自合卧东山。\n白发愁予增感慨，丹崖无路可跻扳。\n吾人出处原无定，巢许伊周若是班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕舟中二首 其一","author":"孙承恩","text":"又报天孙渡鹊桥，银河清浅路迢迢。\n剩将欢聚勤渠意，一慰佳期岁月遥。\n翕散千年谁识测，神光午夜记飘摇。\n却思小院当年夜，坐看长空月晕消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕舟中二首 其二","author":"孙承恩","text":"灵鹊何年叠作桥，桥横银汉望迢迢。\n须知终古常相偶，便隔经年未是遥。\n云旆晓分天漠漠，星轺风汩影摇摇。\n乾坤此事终茫昧，质向巫咸惑未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大参沈凤峰进表事竣言还次少湖韵致别意","author":"孙承恩","text":"客怀何处向人论，除却君亲孰是恩。\n满眼交游嗟我老，到头名姓几人存。\n朝天已罄南山祝，定省行称北海尊。\n忠孝羡君今日事，不堪挥袂别都门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仆衰年病体复来都下情兴可知再用韵一首并呈凤峰一笑","author":"孙承恩","text":"向来心事得同论，去住谁非荷圣恩。\n老我惭随英俊后，怜君独见故交存。\n风尘宦海嗟萍迹，笋蕨茅堂忆旧尊。\n执手临岐意无限，为君离思到家门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚戌仲夏予赴召北上石川张子饯于江浒同舟至金山别去顷复寄予以诗草草依韵附谢二首 其一","author":"孙承恩","text":"扁舟忆昨沧江上，远饯多公契谊真。\n共惜才贤犹野渡，独惭浅薄滥朝绅。\n百年未了君亲愿，一事无成老病身。\n欲和阳春抒报谢，莫宣勤恳重逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚戌仲夏予赴召北上石川张子饯于江浒同舟至金山别去顷复寄予以诗草草依韵附谢二首 其二","author":"孙承恩","text":"江舟话别年惊换，驿骑传书意更真。\n老我与时终枘凿，病躯何日谢冠绅。\n千篇不尽山游兴，百岁谁拘物外身。\n有待金焦从笑傲，留连杯酌不论巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昨赋寄谢石川银台二律误传司寇顾箬翁吟几辱和赠草草奉答 其一","author":"孙承恩","text":"慕蔺从来荆识新，不嫌疏率谅予真。\n公才自合当经济，老我宁堪束佩绅。\n泉石每牵归隐兴，莺花偏笑苦吟身。\n追陪何日容倾倒，较了诗联较酒巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昨赋寄谢石川银台二律误传司寇顾箬翁吟几辱和赠草草奉答 其二","author":"孙承恩","text":"宿德还钦藻思新，大篇短咏尽天真。\n独将巨手匡时政，共仰清标式缙绅。\n北阙风云增逸气，东吴山水铸元身。\n独惭浅薄门墙远，领教无由月几巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答龙田次石川诗韵见赠二首 其一","author":"孙承恩","text":"徵书昨起来京国，老况乡愁意总真。\n只可茅堂时听雨，那堪枫陛更拖绅。\n故园松菊应无恙，宦海风波几脱身。\n乞得君恩赐归隐，湖山佳处日登巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答龙田次石川诗韵见赠二首 其二","author":"孙承恩","text":"斯文宦邸笑言亲，每说吴兴想像真。\n千古岘山青泼黛，四时苕水碧纡绅。\n篇章妙发风云思，岁月聊需道义身。\n有约石川同子践，金焦我是第三巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归田和答吴石湖","author":"孙承恩","text":"辛苦平生报主身，不堪老病疏归频。\n酬恩未有涓埃补，赐允兼蒙德意新。\n世味已抛庄蝶梦，故园犹及乳莺春。\n残生畎亩无馀事，击壤康衢祝圣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵家值海寇作祸遣怀简石湖","author":"孙承恩","text":"老去归来百靡求，一犁准拟事西畴。\n清朝策杖閒闻鸟，向夕呼童饱饭牛。\n散适秖堪元亮卧，乱离翻得杜陵愁。\n百年乐土烽烟遍，何处深山可暂游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张石川书来约会杭城议共远游","author":"孙承恩","text":"故人约我事清游，兹兴年来百不留。\n曾欲天台观瀑布，遂登庐岳访浮丘。\n枯筇短屐三高墓，明月清风八咏楼。\n屈子子长非我事，一区何处不夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居述怀","author":"孙承恩","text":"老去田园是素心，归来偏爱草堂深。\n隔林啼鸟关清兴，匝径脩篁生昼阴。\n病体尚须勤药食，閒居时复解冠襟。\n优游岂敢忘君德，况复延宾有赐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰三女并示甥大道","author":"孙承恩","text":"老去儿孙念转亲，孤嫠贫苦爱尤真。\n蜂粮自可供馀岁，蚁穴犹能庇此身。\n卜筑且教堪止息，拮据宁为惜心神。\n万间大庇何为者，触事宁无感慨频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠马鹤沙竹拄杖二首 其一","author":"孙承恩","text":"我已衰慵合杖时，年高子杖复何疑。\n向平山水应难续，彭泽郊畴尚可追。\n采药远村连近坞，寻诗西崦复东篱。\n冰霜亦未全渠仗，自有诸孙善护持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠马鹤沙竹拄杖二首 其二","author":"孙承恩","text":"淇竹遗君五尺强，瑩然员泽更贞良。\n古藜曾记来天禄，灵寿无誇出建章。\n叩胫独昭千古训，挂钱何用一生狂。\n葛陂故事将无有，鬐鬣依然合慎防。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"录诗与王存斋代柬","author":"孙承恩","text":"老去篇章日厌思，多君命录荷君私。\n荣华过眼空成梦，出处关心敢自欺。\n长日小窗时点染，清秋灯火几唔咿。\n不堪棐几尘君笥，料得床头覆瓿宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读儿侄除夕和章喜赋","author":"孙承恩","text":"岁事匆匆又适新，团圞此夕话酸辛。\n承传喜见成三世，骨肉算来能几人。\n率尔不嫌吾句拙，赓章总见汝情真。\n宁思异日追思切，一读吾先一怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季秋廿八日与冯南江诸公饮张鹤仙宅二首 其一","author":"孙承恩","text":"有约来过仲景家，东风旧院寂无哗。\n清谈得与三贤共，曲槛还馀数朵花。\n世故惊心空有涕，乾坤回首莽无涯。\n传杯不尽东君意，早见城头集暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季秋廿八日与冯南江诸公饮张鹤仙宅二首 其二","author":"孙承恩","text":"喜共高贤接笑歌，何须长袖舞傞傞。\n眼前局面更张易，意外真诠感悟多。\n老骥忘心悲栈道，冥鸿何处挂虞罗。\n独嗟衰谢流光速，无计能回东逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和沈凤峰閒居述怀四首 其一","author":"孙承恩","text":"端居茅屋日常閒，独看云霄倦鸟还。\n解组悔当迟数岁，移家恨不住深山。\n诗哦大雅如承面，门拥清风只自关。\n不用长生羡蓬岛，神仙元只在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和沈凤峰閒居述怀四首 其二","author":"孙承恩","text":"匝合檐花柳拂溪，小窗浓雾入沾衣。\n间关并坐交枝稳，泼剌时穿密藻依。\n经济已非今日事，衰慵深愧素心违。\n惟将出处求无悔，敢谓微长赎百非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和沈凤峰閒居述怀四首 其三","author":"孙承恩","text":"避寇从前此卜居，草玄亭子卧龙庐。\n孱躯未得添新健，病眼时能阅旧书。\n尚有乡闾推齿德，未应踪迹混樵渔。\n客辕不到门常闭，老懒将迎本自疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和沈凤峰閒居述怀四首 其四","author":"孙承恩","text":"散适田园不系身，乾坤无已一陈人。\n愁逢秋晚愁偏剧，爱到孙曾爱转亲。\n北斗太山还夙仰，清风明月是佳宾。\n幽居养得心恬静，不着人间半点尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题董子元紫冈草堂","author":"孙承恩","text":"沙痕海迹见崇冈，冈上幽人结草堂。\n浦响候潮喧枕席，门高乔木带风霜。\n庭阶旧识乘骢至，宅里今看表凤翔。\n莫怪诗书流泽远，直从汴宋溯源长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写怀和答何柘湖二首 其一","author":"孙承恩","text":"梦想无缘到帝京，药炉茶灶对来清。\n病馀久谢文章债，老去难忘儿女情。\n北涧支筇看逝水，东郊把盏听流莺。\n云山泉壑非无兴，其奈时艰畏出城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写怀和答何柘湖二首 其二","author":"孙承恩","text":"宦达愁闻说上京，茅斋赢得梦魂清。\n山人习静教调气，衲子谈空苦废情。\n狂死刘伶常荷锸，闲来戴老去听莺。\n兼旬阴雨无聊甚，莫怪经春不出城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵赠柘湖","author":"孙承恩","text":"作赋声华拟二京，风标冰雪照人清。\n共推道气超时彦，肯把襟期混世情。\n钟阜有云堪拄笏，杨园无树不啼莺。\n想应独对长干月，多少清光满凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江独钓图","author":"孙承恩","text":"木落天空秋气高，一江凉吹鬓萧骚。\n等閒未试屠龙技，漫把渔竿学钓鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸葛武侯像","author":"孙承恩","text":"崎岖百战割山河，天命其如已去何。\n万古不消忠义气，至今凛凛压岷峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面三首 其一","author":"孙承恩","text":"湿云狼籍水悠悠，茅屋人家竹树幽。\n野鸟不知缘底急，飞先渔艇过溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面三首 其二","author":"孙承恩","text":"乞得君王小镜湖，扁舟同载只奚奴。\n年来自信机心绝，底事惊开水面凫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面三首 其三","author":"孙承恩","text":"四山屏立水微茫，恰与三人共一航。\n惆怅鸱夷呼不起，自敲渔榜答沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画水仙","author":"孙承恩","text":"凌波尘袜恐非真，今古传闻解佩人。\n惆怅仙魂招不得，蕊珠宫里自秋春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟宫词","author":"孙承恩","text":"一别羊车岁月深，几番花下立沉沉。\n近来宵旰多无暇，枉费长门买赋金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题小画","author":"孙承恩","text":"江头冻云宿不捲，薄暝寒雾迷前津。\n草阁瀹茗坐无夜，恐有扁舟乘兴人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳图","author":"孙承恩","text":"一曲琵琶月下过，凄凉心事欲如何。\n江州不是遭谗日，未必关心独泪多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瀛洲图","author":"孙承恩","text":"西阁宏开列俊髦，百年文运此时遭。\n坑焚试看秦天子，容易乾坤属汉朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送竹本与杨季玉二首 其一","author":"孙承恩","text":"廿年前与此君盟，春雨龙孙逐队生。\n我已从来饱风味，为君邀致草玄亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送竹本与杨季玉二首 其二","author":"孙承恩","text":"知君雅意亦邻渠，判尽芳菲总不如。\n从此清风数竿足，子云亭作子猷居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闺怨","author":"孙承恩","text":"罗袜轻移下玉除，木犀花下立踌蹰。\n西风日有南来雁，不见平安一札书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君怨二首 其一","author":"孙承恩","text":"闻说中朝丧贰师，安边宁有嫁蛾眉。\n妾今远嫁何须计，可惜君王损国威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君怨二首 其二","author":"孙承恩","text":"掩泣临行致一言，妾身万死不须怜。\n圣朝不杀毛延寿，还有奸人学蔽贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓台诗次韵","author":"孙承恩","text":"脱屣功名把一竿，羊裘曾动客星寒。\n云台寂寞今何在，万古嵯峨只钓滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹十峰便面和韵二首 其一","author":"孙承恩","text":"扁舟江上暮潮平，白露横空鹳鹤鸣。\n为问行歌都市客，风尘能得似君清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹十峰便面和韵二首 其二","author":"孙承恩","text":"頫仰乾坤笑屈平，无端江上自悲鸣。\n扁舟随处堪容与，便是求鱼也自清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面次顾东江韵二首 其一","author":"孙承恩","text":"幽人结屋江之湄，占断清风无少时。\n何日扁舟成独造，为君重和考槃诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面次顾东江韵二首 其二","author":"孙承恩","text":"舣棹和风江竹湄，晚潮作雨欲来时。\n白云堆里看山坐，何处乾坤不属诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同张石磐侍御游沈氏山庄三首 其一","author":"孙承恩","text":"短棹追游坐日间，嵚岑佳处亦跻攀。\n探奇觅胜真成癖，才了观湖又到山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同张石磐侍御游沈氏山庄三首 其二","author":"孙承恩","text":"观水观山事亦清，却于来往太劳生。\n我欲携之置湖上，幻出君山看洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同张石磐侍御游沈氏山庄三首 其三","author":"孙承恩","text":"海上移来小朵云，清虚不着世间氛。\n何当少借三年住，洞里吹箫日共君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶作三首 其一","author":"孙承恩","text":"高眠不喜出门前，偶出多因俗事牵。\n一笑今朝羞失脚，固知终是不如眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶作三首 其二","author":"孙承恩","text":"贫来甑里欲生尘，说与旁人肯信君。\n浩笑不须成戚戚，垄头禾黍渐堆云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶作三首 其三","author":"孙承恩","text":"生平不解倩东风，尽道东风着意浓。\n今日到来成一笑，东风原是不如侬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日睡起偶书二首 其一","author":"孙承恩","text":"柳摇东风绿芽吐，百舌调声日当午。\n鸟飞不尽碧天长，青山缺处云来补。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日睡起偶书二首 其二","author":"孙承恩","text":"青山不碍草堂云，云里书声隔户闻。\n最喜前溪流水阔，门前鸥鹭日成群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中闻时事有感五首 其一","author":"孙承恩","text":"江湖廊庙自区区，稽首皇猷轶有虞。\n此夕忽惊传邸报，无眠终夜只长吁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中闻时事有感五首 其二","author":"孙承恩","text":"明庭抗论意弥坚，只分微躯毕九泉。\n笃信亦知成底事，却尤前哲误诸贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中闻时事有感五首 其三","author":"孙承恩","text":"即使程朱今复生，也须旧说一番更。\n若还究竟昆崙顶，姬孔明明有法程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中闻时事有感五首 其四","author":"孙承恩","text":"百年后死痛无涯，地下宁追执论差。\n云暗九疑天路杳，欲从何处诉重华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中闻时事有感五首 其五","author":"孙承恩","text":"一灯幽燄照蓬窗，吾道从违孰主张。\n独起披衣夜中坐，静听疏雨落寒江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"珠泾睡觉口号","author":"孙承恩","text":"纷纷饯别醉深杯，忘却离愁笑口开。\n夜半睡魂和酒醒，一时依旧上心来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行六桥堤","author":"孙承恩","text":"万顷秋光一岸分，芰荷香里踏斜曛。\n周遭矗矗群峰合，半是青山半是云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行口号","author":"孙承恩","text":"远水微波簇细纹，乱帆高下挂斜曛。\n江边牢落居人少，一带青山映白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]