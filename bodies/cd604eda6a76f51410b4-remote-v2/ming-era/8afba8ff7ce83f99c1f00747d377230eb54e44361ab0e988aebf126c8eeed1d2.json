[{"title":"宫词 其五十三","author":"江源","text":"小殿寒消又见春，内园花柳色匀匀。\n君恩亦有阳和意，何恨宫中未幸人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其五十四","author":"江源","text":"懒把双鬟绾绿云，北风衾枕且浓薰。\n辟寒金赐昭阳女，肯许馀恩妾半分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过严先生祠堂","author":"江源","text":"归去桐江觅钓舟，百年经济亚伊周。\n故人脱解如汤武，谁谓先生不肯留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扇面山水次东陵韵","author":"江源","text":"细雨空濛津树合，小桥迢递水烟通。\n春风杖屦寻诗客，不在孤山定剡中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"快阁次文丞相韵","author":"江源","text":"万里间关执汉幢，百年誓不此心降。\n匿孤今日难存赵，击楫何人更渡江。\n忠愤填胸终死国，皇天无意再兴邦。\n可怜快阁题诗处，千古风云护夜窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊扬州次伍子和韵","author":"江源","text":"晚呼舟子泊江沙，怀古思乡讵有涯。\n越岭何年还杖屦，隋宫无处问繁华。\n帆樯水国三千里，灯火楼台几万家。\n自叹不才非博望，频年来泛海天槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李正夫对月遣怀韵","author":"江源","text":"天上银蟾几缺圆，人间离合亦同然。\n狂歌自叹乾坤窄，醉倒不知衾枕偏。\n何用功名钟鼎上，但教欢乐酒樽前。\n禁城咫尺人如玉，赋到蒹葭第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠许天爵二首 其一","author":"江源","text":"十年不见许眉州，京国相逢感旧游。\n奏最喜承天子问，论心重上叔宽楼。\n曾闻父老甘棠咏，好是龚黄旧日流。\n欲比吾兄冰蘖操，蛾眉山月一轮秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠许天爵二首 其二","author":"江源","text":"五马双旌历两州，瞿塘三峡旧经游。\n使君不减黎侯政，蜀士重铭远景楼。\n交谊几年仍旧雨，归舟十月是安流。\n锦城消息烦君寄，万里相思易白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾总戎邀饮兴国寺次邵同寅汝学韵","author":"江源","text":"佳境真如阆苑西，清风冠盖一时齐。\n飞觞于我频频劝，落日催人故故低。\n独爱松间千岁鹤，不闻云上一声鸡。\n僧房暂息心如水，洗我烦襟万斛泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次邵汝学韵谢顾总戎","author":"江源","text":"箧里兵书束素丝，将军幸际太平时。\n投壶尽日延宾客，推谷何年惬梦思。\n弦管满城欢士女，芙蓉开匣走妖魑。\n糗餈惠我深将德，谁谓崇儒不在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈邦直司训之宜山","author":"江源","text":"弟子群中最白眉，十年南北叹睽离。\n探穷今古书千卷，不得姮娥桂一枝。\n酌酒与君多旧话，赠言于我有新诗。\n行行勿薄宜阳教，坐拥春风拟浴沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺郑同年叔亮生孙次邵汝学韵","author":"江源","text":"我爱贤孙似玉枝，呼公正是黑头时。\n君看英物为家宝，我赋新诗当贺仪。\n通德门前排俎豆，分甘堂上足娱嬉。\n他时定继箕裘业，便是君家久远期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸葛孔明祠二首 其一","author":"江源","text":"将相兼权盖世豪，南征北伐岂辞劳。\n功名讵料三分汉，筹策深知十倍曹。\n炎祚已随天运改，中原遥隔蜀山高。\n荒祠再拜瞻遗像，古木春风野鸟号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸葛孔明祠二首 其二","author":"江源","text":"三代遗才独有公，草庐倾盖识真龙。\n委身不负君三顾，讨贼先陈疏两封。\n独恨吞吴成间隙，非于取益未从容。\n莫将功业论成败，犹得千年绍汉宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日省中即事","author":"江源","text":"绿槐风细乳鸦飞，坐看砖阶树影移。\n性懒最宜公事少，日长谁促簿书期。\n二毛敢谓淹郎署，十载深知负宠私。\n纸帐梨床饶午睡，起来三复伐檀诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双挽卷为同寅罗时泰赋","author":"江源","text":"阿翁节义梁鸿辈，而母贞风德耀贤。\n北阙封章光死后，西涯文字述生前。\n凤毛冠佩彤池上，马□松楸益水阡。\n谁竖丰碑高数尺，道傍骑马看新镌。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧宗鲁赴任二首 其一","author":"江源","text":"京华几度长相忆，消息传来解百忧。\n今日开怀燕市酒，十年听雨郭家楼。\n簿书叹我淹兰省，教铎怜君到吉州。\n寄语故人杨举子，荔枝阴底莫迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧宗鲁赴任二首 其二","author":"江源","text":"先生规范任从容，教历延安两郡中。\n坐见文风千里浃，不知吾道几人东。\n蘼芜满院看生意，苜蓿堆盘胜晚菘。\n料得杏花坛上讲，故交应有士希同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中感怀次前韵 其一","author":"江源","text":"久雨都城泥没膝，不知行路可能忧。\n有时潦水浸蜗舍，无限阴云碍凤楼。\n薄劣未能裨上德，莼鲈何敢忆南州。\n闭门隐几成枯坐，空愧渊明任去留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中感怀次前韵 其二","author":"江源","text":"马蹄终日走尘容，世事都归感叹中。\n谁学魏公归邺下，独教王子隐墙东。\n十年征路徒悲梗，五亩何年更种菘。\n欲寄此身天地外，不知今古几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林思绍尹莆田","author":"江源","text":"莆田县里初分宰，郭隗台前此送行。\n落日离心催发轫，春风回首忆登瀛。\n豪门书劄从今绝，原野莱芜趁雨耕。\n莫道政成人不识，口啤传诵自分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张邦兆归蜀省亲","author":"江源","text":"诏许宁亲蜀道归，路人争看此男儿。\n暂趋白发承颜地，正想金门待漏时。\n万里山川新綵服，百年忠孝旧家规。\n如君此乐今能几，陟岵无烦更赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次邦兆乃尊方伯韵二首 其一","author":"江源","text":"松菊苍苍石竹斑，阿翁归老此中闲。\n叹人趋走风尘里，输我从容水石间。\n勇退尚怀□主术，旬宣犹记济时艰。\n箕裘有子能传业，燕乐挥金且莫悭。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次邦兆乃尊方伯韵二首 其二","author":"江源","text":"卧看诸子舞衣斑，几个如公便得闲。\n绿野心情绳检外，剑门山色有无间。\n千年幸际明良会，十载深知稼穑艰。\n三径日开供叹咏，菊松无复诮诗悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姚应龙令新喻","author":"江源","text":"西江大邑称新喻，出宰多烦我辈人。\n黄甲旧承天上赐，碧桃新长县中春。\n青霄事业酬明主，赤子疮痍任此身。\n见说东洲居士在，日闻清论莫嫌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁惟敬省兄还五羊","author":"江源","text":"江南客子省兄归，正值长安二月时。\n冰泮潞河春水阔，寒辞燕市日光迟。\n孤舟夜雨彭城梦，千里晴云瘴海思。\n相送何须折杨柳，为君三诵渭城诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过徐州有感","author":"江源","text":"使旌又向彭城过，细柳薰风旧路蹊。\n舟棹下洪湍水恶，仆夫牵缆和歌齐。\n沐猴人去遗墟在，放鹤亭空落日低。\n我欲凭高望京国，白云烟树眼中迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊萧伯铉太守","author":"江源","text":"义气何曾让古人，历扬中外廿年春。\n度支财赋轻刘晏，刺史循良共信臣。\n镌石有文彰令德，传家无子拜荒坟。\n仁人寿矣成虚语，我恐皇天亦不仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄玄璧下第归江南","author":"江源","text":"京华灯火三年业，岭海风波几日还。\n不为功名浑落魄，只缘亲舍久违颜。\n八千里外归莱采，一寸心先到庾关。\n回首杏园春更好，看君骑马曲江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次江太守留别韵二首 其一","author":"江源","text":"五马翩翩出帝京，马头红日万山明。\n才攀杨柳何边别，便忆梅花岭外情。\n赵抃素琴随处好，江淹别赋向人鸣。\n诗成我后怜才涩，和得阳关第几声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次江太守留别韵二首 其二","author":"江源","text":"使君惜别醉瑶京，三尺吴钩照胆明。\n归马想应谙旧路，淩江今已忆高情。\n心悬魏阙瞻齐政，道便乡关见自鸣。\n回首庾关逢北使，折梅千里寄新声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽懒斋处士","author":"江源","text":"俯仰无惭乃大佳，山中泉石老形骸。\n年逾七十颇称意，儿亦英奇不挂怀。\n芳草池边春梦短，少微天上夜光埋。\n耆英会里盟诗社，唱和于今少懒斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴指挥致仁卷","author":"江源","text":"辽东老将功成后，洗马春流解铁衣。\n百战山河无旧梦，满庭歌吹舞新姬。\n班超老去心犹赤，王剪归来鬓已丝。\n见说宁馨真将种，尽将韬略一传之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次赵提学游白云寺韵","author":"江源","text":"不到白云今几秋，幸陪骢马得同游。\n青山绿水仍依旧，涧草汀花不管愁。\n万里乾坤归眼底，百年忧乐到心头。\n劳君惠我阳春曲，自叹非才也唱酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别同年曹时中佥宪","author":"江源","text":"两顾劳君宪节来，几年怀抱到今开。\n青樽且对故人酌，画舫何妨候吏催。\n杨柳谩从南浦折，梅花先寄北人回。\n同年聚首又何日，千里相思未肯灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒张文献祠","author":"江源","text":"开元贤相誇姚宋，蹇谔输公第一流。\n抗疏不容牛氏相，覆师先识羯奴谋。\n曲江祠古千年祀，揠月堂空一土丘。\n再拜遗容出门去，萧萧林木不胜秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴二首 其一","author":"江源","text":"秋去冬来伤岁暮，南驰北逐叹涂穷。\n百年得丧心如铁，一路风霜鬓易蓬。\n故国关山诗卷里，异乡人事酒杯中。\n江湖廊庙忧盈抱，不独思家意万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴二首 其二","author":"江源","text":"不独思家意万重，百年怀抱几人同。\n东南财赋少刘晏，西北干城谁耿恭。\n数十舟航寒水外，寻常猿鹤暮烟中。\n满前摇落皆堪赋，谁谓悲秋宋玉工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿玉山布政分司值雨言怀","author":"江源","text":"微省清宵寂不哗，北风如割透窗纱。\n慈乌绕树呼寒雨，童子挑灯落夜花。\n怀玉夜寒更漏永，邯郸枕暖旅魂赊。\n可怜贾岛忘情甚，却望并州即是家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹轩为致仕萧方伯题","author":"江源","text":"英雄老去辞微省，勇退归来卧竹轩。\n养得孤高淩雪霰，却将苍翠洗嚣烦。\n元乡直许重开径，袁尹从教数到门。\n回看金张歌舞地，东风桃李几曾存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李硕夫乡思二首 其一","author":"江源","text":"宦辙频年鬓欲华，红尘况味有何嘉。\n十年儿女灯前话，百越风烟梦里家。\n江北不堪悲橘枳，岭南谁复寄梅花。\n令人苦忆陶家宅，五柳阴阴傍水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李硕夫乡思二首 其二","author":"江源","text":"马蹄无日不东华，谁道吾兼吏隐嘉。\n五岭交亲疑半鬼，十年萍梗叹无家。\n庭培桑梓添新绿，手植橙梨发旧花。\n昨夜梦归归未得，暂凭官职作生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李硕夫韵答陈仲芳乡思之作","author":"江源","text":"太平天子协重华，似我非才亦宠嘉。\n郎署十年惭致主，使车千里敢言家。\n行囊不贮蒲萄种，远信空裁茧纸花。\n直比长安时极目，蓟云燕树杳无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次官汝清伤雨韵","author":"江源","text":"久雨淋漓水溢城，汗渠何处觅深情。\n九逵迢递埋车辙，八表空濛恼客情。\n平地黍苗随汨没，逆流鸥鸟任纵横。\n遣愁三酌麻姑酒，不学沉酣阮步兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次官汝清留别韵","author":"江源","text":"岐路东西且莫分，呼童沽酒醉荒村。\n相知不用时看剑，世事无凭只闭门。\n少曰功名成老大，百年天地等朝昏。\n从今想见须倾倒，莫待流光镜里奔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张仪部企翱留别韵","author":"江源","text":"看花长忆旧时情，萍水重逢眼倍明。\n谁惜文园病司马，未容杜曲老元卿。\n关心丘垄十年别，到手功名一羽轻。\n留得此心忠赤在，不妨头上鬓星星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过严先生祠堂","author":"江源","text":"故人不是汤文辈，此老徒追伊吕风。\n桐水有情群野鹤，谏垣无意补山龙。\n云台芜没空名汉，钓石峥嵘尚属公。\n我过祠前三稽颡，千年香火俨遗容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次尹宣文赠行韵二首 其一","author":"江源","text":"梅子成坡我复来，十年怀抱一时开。\n舣舟江浒二三日，拍手尊前几百杯。\n花径叹谈忘主客，柳营旌节肃风雷。\n洪都庾岭还相接，从此逢春为寄梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次尹宣文赠行韵二首 其二","author":"江源","text":"音书两寄玉京来，喜甚灯前浣手开。\n夜月池台千里梦，春风弦管十年杯。\n北溟奋激淩霄翮，南粤声名吼地雷。\n更贺边城无一事，大开东阁咏官梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵答周司训","author":"江源","text":"千里神交不约来，叹颜今日为谁开。\n尊前莫作离群恶，江上仍携送别杯。\n赠我好诗淩鲍谢，看君高义迫陈雷。\n故人期我和羹业，浅薄惭非传说梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵答林司训","author":"江源","text":"好似乘船访戴来，一时倾盖壮怀开。\n相逢未拟偿诗债，揖别先须送酒杯。\n东郭白云西郭树，南山红日北山雷。\n天涯正尔相思苦，江上何人奏落梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵遣怀","author":"江源","text":"便道乡关喜往来，堂名画锦对江开。\n綵笺通姓门前客，青眼留人月下杯。\n卷里诗歌多沈谢，座中朋旧半陈雷。\n逢人不是无消息，大庾如今未有梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次林司训赠行韵","author":"江源","text":"不用逢人说独贤，酒杯诗卷亦神仙。\n幕天席地刘伶趣，爱国忧君杜子篇。\n白水青山行客景，凄风淫雨早秋天。\n热官十载成何事，不及先生一冷毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次邝时用韵留别二首兼寄黎景升 其一","author":"江源","text":"三年云水伤离别，几负诗筒走传邮。\n桑梓春风怀穗石，甘棠今日颂严州。\n低昂世事棋翻局，摇荡乡心浪打舟。\n抚掌叹谈兼对酒，一宵风雨为君留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次邝时用韵留别二首兼寄黎景升 其二","author":"江源","text":"一别故人经几秋，恨无黄犬作书邮。\n不知今夕是何夕，却在严州说广州。\n宿草雨荒严子宅，布帆风送富春舟。\n金华半刺清如玉，安得高谈竟日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读诸葛孔明传","author":"江源","text":"三顾隆中方释耒，君臣鱼水欲何如。\n刘朝旧物期兴复，汉贼中原誓破除。\n血食竟能延赤伏，忠贞不负托君储。\n区区陈寿何为者，千载谁平入寇书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陈处士","author":"江源","text":"人间重见太丘贤，月旦评书又独先。\n取友直期千古上，贷贫那惜万金捐。\n少微星殒光沉浦，华表鹤归秋满天。\n子姓多贤公瞑目，百年何用戒平泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次新喻分司壁韵兼寄邹济时佥宪","author":"江源","text":"观风随处驾星车，又是江城三月馀。\n雨勒石榴红未放，天晴蒙草碧初舒。\n案头检阅新刊例，囊里搜寻旧读书。\n叹我宦涂犹跋涉，山中高兴欲何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘尚书夫人哀挽","author":"江源","text":"夫人贞淑关睢德，万女群中亦绝伦。\n夫子经纶唐宰相，儿曹纲纪汉台臣。\n北堂雨雪淩谖草，南涧风烟怨藻蘋。\n坐享人间全盛福，东风八十八回春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次弋阳分司黄九成韵","author":"江源","text":"画船又过大江东，回首云霄限九重。\n今日何才裨国计，十年无策补山龙。\n擘菱南旺时方暑，饮菊西安岁渐冬。\n明日前程何处所，布帆东浙挂秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵送麦景实","author":"江源","text":"葛溪聚首未三月，把擘尊前可厌重。\n江上星槎惭博望，眼中豪气见元龙。\n一声白雁送霜信，满树黄柑催早冬。\n明发不堪南北别，看君千里驾长风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周天叙出使于闽顺道省亲","author":"江源","text":"我爱君家鬓未华，可人文采际亨嘉。\n八千里外新持节，三百人中旧探花。\n征旆远飞闽海月，綵衣仍过越南家。\n平生却叹乘槎客，肯把蒲萄载使车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次郑侍御从俭见寄韵","author":"江源","text":"节概生平百炼金，冰清不许一尘侵。\n□□宪府谐清论，献纳君门露赤心。\n草绿都门春色早，雪消淮甸暮流深。\n相逢把手又相别，莫惜平安两字音。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]