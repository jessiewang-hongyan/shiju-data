[{"title":"东山别业为梁少傅赋","author":"欧大任","text":"策蹇寻君出郭偏，逍遥公后见君贤。\n著书已满山中笥，爱月闲挥石上弦。\n清梵屡闻黄竹寺，寒溪半出白云泉。\n谢安恐为苍生起，深锁松筠又几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄幼章邀游巢云轩","author":"欧大任","text":"壶榼幽期在竹扉，黄花三径晚依依。\n草堂鹤待人归久，蕙帐云深客到稀。\n觅句泉边供茗细，清斋林下折菘肥。\n出山愧谢陶弘景，争得当年便拂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同士鹄贤甫三水夜泊","author":"欧大任","text":"青枫习习三江口，旅泊欣逢二妙才。\n客梦偶随浈水去，塞鸿新度蓟门来。\n孤城闭月秋砧急，野戍临江晓角催。\n跃马听鸡还此日，十年奔走在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻苏黄门饮黎氏山楼佳句见及和答一首","author":"欧大任","text":"衣冠洛下几追随，一出风尘怅别离。\n北海清尊多好客，南楼明月负佳期。\n归与不为鲈鱼脍，隐矣谁招桂树词。\n献纳近臣劳记忆，腐儒真愧故人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病后","author":"欧大任","text":"经年疲病愧蹉跎，尚可樵薪醉且歌。\n佐锻每于灌园后，挥锄长是带经多。\n霜清狮岭劳场圃，雨过龙津理钓蓑。\n已笑杜陵忧太早，归朝筋力定如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文太史九十寄上","author":"欧大任","text":"山中杖屦道弥尊，曾忆当年一扫门。\n天许东吴开寿域，人从南海望台垣。\n书传掌故儒宗学，酒洽乡人圣主恩。\n汉室辟雍还酳爵，苍颜黄发老乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黎惟仁见寄","author":"欧大任","text":"卧病芙蓉溪上村，心期无地与君论。\n社中僧散归庐岳，渡口人来问鹿门。\n岁晏鱼鸿愁莫至，径荒松菊喜犹存。\n报书欲访安期去，四百名山好避諠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄龙孟采文学","author":"欧大任","text":"谈经东郡未蹉跎，惆怅其如远别何。\n万里塞鸿传信少，三年山雪下帷多。\n城临古木陶丘镇，窗送孤帆马颊河。\n闻尔春风入京洛，早传消息慰沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元后夕顾玄纬官舍宴集","author":"欧大任","text":"五夜尚馀镫市兴，一尊仍引褐衣閒。\n星摇海上常朝斗，阁倚城头每见山。\n曙色渐分旌旆外，春声多在鼓鼙间。\n顾荣不是江东客，只恐承明计日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同顾玄纬游石虹湖","author":"欧大任","text":"谬敬宁劳一坐倾，石湖犹得伴君行。\n风烟半入刘王苑，山海周遭赵尉城。\n帆外日斜平楚尽，鸥边冰断早潮生。\n彤云北望朝台路，赋客江南万里情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁戊山人返闽中","author":"欧大任","text":"白日乍逢勾漏令，青山归觐武夷君。\n手扶藜杖经溪雪，囊贮荷衣度海云。\n绛节只将鸡犬去，赤霄终远凤皇群。\n虹桥宴后还来否，祇恐璈笙不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘道颐夜过滋兰精舍见访","author":"欧大任","text":"杨生欲卜岷阳宅，谢史将归石井山。\n好事特来频载酒，故人相见一开关。\n春声宝瑟风前泛，溪影青蓑月下还。\n别尔不胜南浦望，鹤岑长在白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黎吏部惟和岭下见寄","author":"欧大任","text":"北去关河信息稀，岭头曾见几鸿飞。\n别时驱马遵原隰，到日听莺入省闱。\n阊阖云霄双玉舄，江湖烟雨一荷衣。\n君今且上山公启，宁得逢人问钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄梁舍人思伯","author":"欧大任","text":"紫宸肃穆拜恩时，裴瓒风神众所推。\n春满龙池三月雨，日高鸡树万年枝。\n看花右掖封章少，视草西台刻漏迟。\n共识平津能待士，由来东阁几人窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游狮岭龙岩遇雨宿田舍","author":"欧大任","text":"山北山南近可游，农谈西夕偶淹留。\n茅茨喜就田更宿，鸡犬愁闻里正求。\n鼓吹雨沉莎泽冷，管箫风袅豆篱秋。\n陶公拥耒怀千古，束带宁堪见督邮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬黄幼章见寄","author":"欧大任","text":"历落生涯只钓矶，城中车马到应稀。\n溪园得雨缃梨熟，水国先秋紫蟹肥。\n别久林僧频有约，病多酒客每相违。\n劳君尺素能题寄，谁向襄阳问布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗明府改教荆州","author":"欧大任","text":"九十九洲烟水流，到时应及渚宫秋。\n马融绛帐今犹在，陶令清尊谁共游。\n天畔看山明月峡，风前散帙曲江楼。\n城西茅舍君堪赋，莫道荆南未可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飓风涨落招晋安王山人","author":"欧大任","text":"沧波洗屐出柴关，渔钓何人到此间。\n江水未漂何胤室，竹林深掩戴颙山。\n三轮公调年来异，四壁家徒日共闲。\n泾上樵风今可帆，夕阳长望一蓑还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同潘少承入西樵山卜居铁泉精舍二首 其一","author":"欧大任","text":"鸡犬薪蒸共一车，入山真与世情疏。\n家随子季移秦望，粮学通明食禹馀。\n瓠叶尚堪供享射，秫田那得废耕锄。\n植林开涧吾生事，谁向名山问著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同潘少承入西樵山卜居铁泉精舍二首 其二","author":"欧大任","text":"山泽神交二十年，素情台尚得君贤。\n閒游径就天峰去，晏坐醒寻海石眠。\n风起于菟看杏地，露寒阿对灌蔬泉。\n闭门白发萧萧在，何事虚名世上传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过云谷洞","author":"欧大任","text":"豹林只隔数峰西，涉涧寻君月未低。\n简子深秋停露照，鞠侯清夜过云啼。\n泉香石铫聊堪煮，松响风琴不用携。\n谁见幽人独来往，寒光明灭在前溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓登玉廪峰","author":"欧大任","text":"独吹铁笛一临霞，青玉坛边散晓鸦。\n洞逼金华羊是石，岭疑缑氏鹤为花。\n瀑前木客支茶灶，云里山都问酒家。\n莫遣移文羞涧壑，周颙真欲老天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由烟霞洞登大科峰绝顶","author":"欧大任","text":"灵气飘飘满石坛，峰头长啸九秋残。\n大荒风起千松乱，碧落天高片月寒。\n羽客共将金偈答，山僧闲把玉书看。\n难向外人言此乐，白云深恋鹿皮冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中忆惟敬内翰思伯中舍","author":"欧大任","text":"故人昔共此栖迟，瀑布峰前忆别时。\n骑省谁能怜国宝，士林今已得山披。\n清猿自和斋中磬，野鹿閒窥石上棋。\n回首白云多出岫，独看秋雁一相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送蔄尊师往郴州","author":"欧大任","text":"仙官南去洞庭南，衡岳诸峰更一探。\n黄石早为松子客，青童曾是木公男。\n羽衣轻举淩苍雾，毛节遥瞻入翠岚。\n甲子从今三百后，东门楼上望苏耽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答丁戊山人武夷见寄二首 其一","author":"欧大任","text":"去年勾漏始归来，太姥虹桥待尔回。\n海送羽车占异气，石藏金匮识仙才。\n汞铅几处留丹灶，脯炙何时共酒杯。\n莫向岩头吹铁笛，幔亭风急万山哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答丁戊山人武夷见寄二首 其二","author":"欧大任","text":"玉椷何处寄新诗，消息惟应海鹤知。\n三洞丹经瞳炯炯，万峰黄帽鬓丝丝。\n云浮飙室朝元地，月过天坛礼斗时。\n为问青精何日至，山禽将献赤龙芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何元朗","author":"欧大任","text":"曾闻子季移家处，小阁云深手自关。\n良常不隔神仙宅，秦望犹传大小山。\n金马直来孤梦远，银鱼焚后一身閒。\n知君颇有梅花句，岭上何时寄驿还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潮州萧君达偕郑国彦方邦哲张子晦过访以诗见诒用韵兼酬四子","author":"欧大任","text":"客邸逢君醉几回，岂缘乡国共衔杯。\n西京正待张衡赋，南海谁如赵德才。\n楯鼻自将飞檄去，刀头何必问书来。\n清秋最是披襟日，更约双骖上汉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕出城访董山人","author":"欧大任","text":"城里歌钟几万家，独寻阒寂到烟霞。\n路逢草屩知居士，山隐铜鞮问伯华。\n碧鉴海环赪石起，黄冈峰引白云斜。\n骖驔归骑犹携客，醉向祇园火树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同何太仆泛舟作","author":"欧大任","text":"桂楫飘飘珠浦前，上书宁待鉴湖田。\n归同宾客居閒口，恩在君王赐告年。\n月下锦袍江祖石，烟中翠被鄂君船。\n乘风直到金银阙，谁道淩虚不是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王总戎东征","author":"欧大任","text":"汉将征蛮旧策勋，提兵东下阵如云。\n珠旗明月天边出，玉笛秋风檄外闻。\n幕府功多横海战，楼船令待伏波军。\n即看捕虏驰还奏，只以升平答圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬戌七月十五夜同诸亲友泛舟佛教海","author":"欧大任","text":"赋成忆在楚江干，今夕何夕斯游难。\n自操兰桡波里白，不禁枫叶霜前丹。\n水落石出鲈鱼上，月明星稀乌鹊寒。\n醉倚柁楼望天末，西风萧萧羌笛残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登观海楼送陈士鹄北上","author":"欧大任","text":"西风平楚莽萧萧，天畔登楼正泬寥。\n万户砧声催夕照，千帆涛色送秋潮。\n青山谢傅相将去，白首冯公尚未招。\n此地明年重忆汝，佩萸应在紫宸朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同陈潜甫叶伯埙吴叔颐罗见参吴伯纶罗曜文梁仲登夜集吴氏池亭时余将北上得秋字","author":"欧大任","text":"浊醪犹有鹔鹴裘，下马张镫且暂留。\n客路风尘双短鬓，宦情天地一孤舟。\n袂分此夜清溪月，书寄何时白雁秋。\n别后荆南君莫赋，肯令王粲滞江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登快阁遂谒山谷祠和石刻十韵","author":"欧大任","text":"千峰匡岳亭亭立，万里澄江滚滚来。\n文水远流诸港入，禅官高阁半云开。\n川原日照新楼橹，城郭烟侵废草莱。\n旧邑飞凫留玉舄，几时孤鹤下山台。\n浮沉谩忆神仙令，留滞空怜太史才。\n尊酒囊琴皆寂寞，斜阳归雁独悲哀。\n年深短句馀残墨，迹古遗碑翳绿苔。\n肃肃祠堂犹俎豆，翛翛图像已尘埃。\n高风一代人何在，长路孤舟客自回。\n双井白杨应咫尺，不堪西望独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出云谷关泛樵湖","author":"欧大任","text":"三关迢递指津途，舍策庄前问钓舻。\n泽豹未能终隐矣，山猿其奈怅归乎。\n蓼江南下龙江近，一曲西沿九曲殊。\n闸里泉流肥晚稻，渚边霜色冷秋菰。\n陆洲租税惟莲实，百滘园林半木奴。\n风物蕳村遥可见，雁群急水乱相呼。\n帆飞似有冯夷导，川静无烦海若驱。\n落落沙坪低草树，茫茫江浦散鸥凫。\n萦纡涧壑疑蓝水，回合风烟似鉴湖。\n康乐未忘彭蠡望，右丞犹恋辋川图。\n曾经驻舄情何限，更着浮槎兴不孤。\n咫尺仙山何处是，夜来魂梦绕清都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八月碧桃花十韵","author":"欧大任","text":"塌羽南飞秋欲暮，西风归路正萧萧。\n城边落雁惊枫叶，江上清霜折柳条。\n岂意蓬门留晚照，故教桃萼媚春娇。\n恍疑玉岭峰头见，乍似霜林树下飘。\n水碧着枝偏淡淡，华秾拂槛更夭夭。\n武陵路远寻源入，度索山深涉海遥。\n游客成蹊应已少，幽人无限不须销。\n名亭尚爱无双句，载酒还过第五桥。\n露井不堪摇落后，缃园犹及艳阳朝。\n螃螗见说多灵实，便理扶桑万里桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴而待守归州","author":"欧大任","text":"汉室分符属俊良，喜君得郡古丹阳。\n去时佩印辞京邸，到日题诗出射堂。\n大别东连荒梦泽，潜江南下乱潇湘。\n三休竟望荆台远，九辨空思汨水长。\n熊绎旧邦留荜辂，灵均遗庙洁椒浆。\n竹枝渐习巴渝曲，月峡遥归蜀客航。\n几处种山还采蜡，何人驻马问耕桑。\n拔河应笑祈农异，竞渡堪怜习俗狂。\n百里芜城夔子国，千家菰米楚人乡。\n讼庭山鸟时时下，燕寝江蓠冉冉香。\n露冕褰帷真此地，浮云征雁自殊方。\n吴公治行推高第，禁掖行瞻日月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中过大庾岭","author":"欧大任","text":"横浦关门下，秦时塞上沙。\n高楼吹玉笛，片片是梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉枕山","author":"欧大任","text":"山幄盘紫逻，石床白云过。\n鸡犬天上稀，惟有仙人卧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何天宿鸥溪别墅四首 其一","author":"欧大任","text":"岭北荆榛路，城西浦溆深。\n白鸥时自下，知尔海翁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何天宿鸥溪别墅四首 其二","author":"欧大任","text":"袯襫未能舍，桔槔曾不持。\n汉阴机已息，谷口隐何疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何天宿鸥溪别墅四首 其三","author":"欧大任","text":"颇适濠梁兴，谁云不似鱼。\n山中缃帙少，惟有漆园书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何天宿鸥溪别墅四首 其四","author":"欧大任","text":"导水章江入，看云庾岭开。\n柴门君莫闭，日许问奇来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同王武昌詹侍御游西华山","author":"欧大任","text":"南峤飘幡地，西华载酒年。\n使君携客去，何似谢临川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉祐寺与禋公别","author":"欧大任","text":"开社白莲秋，出山余暂游。\n君忆柴桑客，江边一倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠苏四赴安西","author":"欧大任","text":"苏卿西度漠，征马别踌躇。\n汉使长安远，无忘雁足书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访蔡世新","author":"欧大任","text":"墨池呼鸟食，书架傍花开。\n奇字虽能问，惭非载酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吉州别萧曙","author":"欧大任","text":"高浪黄牛石，长亭白鹭洲。\n岭头千里水，何事入江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕王阁送邓巴州二首 其一","author":"欧大任","text":"南浦不可望，潇湘何处秋。\n好将明主意，露冕入巴州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕王阁送邓巴州二首 其二","author":"欧大任","text":"君去西川路，知余滞楚乡。\n巴江书莫寄，九派是浔阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南浦驿送少室山人之襄阳二首 其一","author":"欧大任","text":"嵩少何年出，遥寻庞德公。\n宁知高士宅，只在鹿门中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南浦驿送少室山人之襄阳二首 其二","author":"欧大任","text":"远别伤春日，襄阳路更西。\n习家池尚在，堪听白铜鞮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水次逢碧桃","author":"欧大任","text":"桃叶复桃花，秦淮是汝家。\n渡头风雨夜，惆怅忆天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖口忆子文","author":"欧大任","text":"日落劳延伫，江长动远思。\n汀洲采兰杜，惆怅欲遗谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南京三首 其一","author":"欧大任","text":"金门迎王气，丹阙俯神州。\n苑柳摇春殿，宫鸦拂曙楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南京三首 其二","author":"欧大任","text":"江左开基日，山河入地图。\n千秋龙虎国，万里帝王都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南京三首 其三","author":"欧大任","text":"青云鳷鹊观，赤日凤皇台。\n司马文园病，谁言献赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秦淮","author":"欧大任","text":"玉树歌已残，秦淮不堪泊。\n女墙明月高，江枫夜深落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登报恩寺塔","author":"欧大任","text":"塔倚长干寺，经传白下僧。\n六朝城市尽，江涌佛前灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋博士邀饮凭虚阁玩月","author":"欧大任","text":"高阁月初朗，他乡酒易酣。\n今宵同作客，不记是江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵应观玉皇阁临乌龙潭","author":"欧大任","text":"台城遣恨多，山阁今独倚。\n玉笙何处来，月照乌龙水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海天僧同余过朝天宫周道士馆不值道士","author":"欧大任","text":"谁言匡阜远，亦似石城西。\n观主今何去，殷勤过虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扬子江上寄伦膳部","author":"欧大任","text":"夷犹望京邑，江月听秋潮。\n谁念扁舟客，新林向版桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溧阳孙生邀游三山饮听江楼二首 其一","author":"欧大任","text":"风引孤舟行，登楼听呜咽。\n春江万里流，半是巴山雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]