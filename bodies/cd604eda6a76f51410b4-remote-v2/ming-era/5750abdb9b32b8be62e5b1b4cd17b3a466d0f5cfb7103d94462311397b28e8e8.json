[{"title":"途间赠王都宪公度","author":"倪谦","text":"禁垣宪府历亨途，慷慨当朝翊庙谟。\n大节一生存正气，元凶万死有馀辜。\n边尘汛扫收戈甲，国计常充送舳舻。\n勋业岂徒垂太史，丹青麟阁看新图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刘司训产双生子题兰桂同芳卷分韵得徐字","author":"倪谦","text":"明月双擎掌上珠，兰香桂馥蔼庭除。\n为奇为偶数无定，寝地寝床欢有馀。\n昨夜紫光方照室，今朝佳气又充闾。\n行年四十非为晚，赋命应知有疾徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和许太常彬宅赏芍药诗韵","author":"倪谦","text":"零落残红逐砑光，君家庭院有馀芳。\n花凝晓露胭脂湿，叶逗薰风蜚翠香。\n低傍画阑争逞艳，远胜砥柱独回狂。\n只疑昨夜嘉宾散，遗却尚书紫荷囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴司务天爵从蒋都宪巡抚贵州","author":"倪谦","text":"万里巡边佐宪臣，春风一鹗振青云。\n荣循旧是江东俊，温石今空冀北群。\n百粤停骖消瘴雨，五溪飞檄靖妖氛。\n化行徼外恩威布，应向明时早策勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刘医官原博挽诗","author":"倪谦","text":"蚤继簪缨赋蓼萧，奇材雅望重清朝。\n国风共许千年在，剑气俄惊五夜消。\n济物参苓遗药笼，传家珠玉富诗瓢。\n春来绿遍王孙草，堪叹吟窗閟寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽葛节润","author":"倪谦","text":"君家兄弟玉连枝，何事霜风数见欺。\n客路旧怜归衬远，乡关今痛讣音迟。\n一朝永诀成千古，两地相违仅二期。\n有酒莫浇原上土，凤毛相对不胜悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐瑄御史按蜀","author":"倪谦","text":"绣斧分巡出凤池，使星五夜拂参旗。\n岷峨江水元通楚，邛笮民风旧近夷。\n谕蜀岂劳司马檄，入夔应忆少陵诗。\n临岐不尽同年意，伫看澄清体睿思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送镇江钱医官","author":"倪谦","text":"拜官归去沐恩偏，医国功应奏十全。\n药自赭鞭知异品，方从金匮得真传。\n鍊砂尚仗炉中火，摘橘还分石上泉。\n为想江城春市里，杏花如雨一壶悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"景泰壬申九月初六日，经筵讲退，蒙召至文华殿。皇上负扆而立，面垂顾问，赐楮币一千贯。复遣中官赐雪花梨及鲜果一笼，荷恩感激赋此以识","author":"倪谦","text":"中官宣召入文华，虎拜丹墀沭宠嘉。\n双玉不移留独久，重瞳屡顾语尤赊。\n内庭翠楮裁云叶，上苑仙梨酿雪花。\n仰荷恩颁深感激，天光辉赫照贫家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周德元还昆山以文学举阻于例而归","author":"倪谦","text":"冥鸿风便偶高骞，路阻云程尺五天。\n故国迢遥足归梦，礼罗疏阔竟遗贤。\n莫言张翰莼偏美，须信相如璧自全。\n寄语山灵勿相拒，草堂已赋卜居篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画赠平江侯南京镇守","author":"倪谦","text":"久镇清泉著庙谟，召还仍命守南都。\n金龙洒翰新颁敕，铜虎临戎再剖符。\n万井苍生沾霈泽，一心清节湛冰壶。\n分携辱在相知后，聊写微情寓画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李保章宗善","author":"倪谦","text":"太史三年谒帝廷，言归秋日正冥冥。\n霜沾行李城南路，风引征帆泗上亭。\n金阙云霞朝倚汉，玉衡牛斗夜占星。\n重来洗耳谈天术，漏咽岩扉拟共听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张节之主事赴南台","author":"倪谦","text":"怅别音尘十五年，青云科第愧卢前。\n两京兄弟谁能及，一榜交亲子独贤。\n晓日朝端双佩委，薰风江上片帆悬。\n官曹见说清如水，剩有新诗白下传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴中进士知清流县","author":"倪谦","text":"除目新颁出凤楼，荣看宰邑向清流。\n莫言虎榜三春客，只博花封百里侯。\n天上圣心需抚字，海滨民力困诛求。\n君家宦业多循吏，会见功名指日收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送童轩给事还南京","author":"倪谦","text":"金榜香名擅甲科，夕郎三载近銮坡。\n青年贾谊才华富，素悃匡衡谏疏多。\n两袖天香丹凤阙，一帆春水白鸥波。\n锦游乡国真堪羡，把酒临岐柰尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江湖胜览为王景和赋","author":"倪谦","text":"万里江山一短篷，壮游随处豁双瞳。\n三湘洲渚推敲外，百粤风烟笑傲中。\n赤壁梦回秋月白，金台望断夕阳红。\n京华刮目惊相见，非复东吴旧阿蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢定襄伯郭公登惠马","author":"倪谦","text":"渥洼神骏齿初齐，惠我来从紫塞西。\n素鬣梳风流电疾，玉花照夜白云低。\n千金未许论高价，万里何当试逸蹄。\n从此朝天骑去稳，不愁风雨汨涂泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题竹","author":"倪谦","text":"金壶素楮墨淋漓，写出扶疏带雨枝。\n湘浦啼痕秋作点，淇园翠色晚含滋。\n窗前把酒閒吟处，篷底停桡独听时。\n沧海新波添几尺，长竿欲系钓鳌丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏宝剑赠董侍御","author":"倪谦","text":"身佩吴钩百鍊钢，芙蓉出匣耀寒芒。\n断蛟直欲趋东海，斩马何劳借上方。\n怒斥奸邪惊落胆，气淩豪侠凛飞霜。\n平生致主凭三尺，星斗遥看夜有光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刘詹事宗器挽诗","author":"倪谦","text":"先生廉介著孤标，步玉登金志不骄。\n久擅文名高一代，曾挥史笔记三朝。\n胄筵德望追前哲，宫尹清班接上僚。\n委蜕翛然成永诀，芳魂空赋楚辞招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓宿大胜寺诗次韵","author":"倪谦","text":"清晓联镳驻宝林，禅房花雨坐来深。\n上卿酌酒陪高论，老衲焚香话夙心。\n供食频分香积饭，闻经时渡海潮音。\n不因修祀承朝命，此地何由共盍簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题周秩教谕哭兄诗卷","author":"倪谦","text":"见说君家好弟昆，伯埙声断几朝昏。\n紫荆堪恨花先陨，义竹空悲节自存。\n鸿雁秋风吹别思，池塘春草役吟魂。\n诗成要识情深浅，衫袖重重是泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡克容上舍南还","author":"倪谦","text":"挟策聊为上国游，故乡归去属深秋。\n黄花佳景多清思，青镜流年正黑头。\n科目从知非力取，功名须信待时收。\n相如珍重连城璧，他日重来价定酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送柯状元归省","author":"倪谦","text":"宫花六见落厅槐，乡思临风不易裁。\n旧业暂容辞翰苑，新衔却喜换符台。\n名从黄甲抡魁早，身约青春作伴回。\n綵服宁亲多乐事，秪应清梦绕蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西池草堂为周仪宾英璧赋","author":"倪谦","text":"西池池上草堂幽，门对波光一镜秋。\n卜宅也知同杜甫，观鱼聊复似庄周。\n怀人高兴歌沅芷，玩世閒情狎海鸥。\n白藕作花真可爱，家声无忝绍前修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽何忠节和何太守澄韵","author":"倪谦","text":"硕德长材素有馀，豺狼宁意与同居。\n苌弘不化千年血，苏武空传万里书。\n义重丘山惟自守，光争日月许谁如。\n皇家锦诰褒忠节，奕奕双桓在故闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题楚府于教授菜圃卷","author":"倪谦","text":"躬曳长裾也自嘉，却从老圃托生涯。\n汉阴抱瓮无机事，涽□蹲鸱有岁华。\n紫芥放花晴舞蝶，碧茄成子雨鸣蛙。\n閒来如作冰壶传，露夜黄齑谩自誇。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送韩旸布政致仕还越","author":"倪谦","text":"阳春到处辄回苏，老去辞荣乃丈夫。\n已负盛名垂汗简，只馀清节湛冰壶。\n归田早办欧公录，赐地应分贺监湖。\n鹤骨松姿行益健，幽寻不必倩人扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽萨侍郎琦","author":"倪谦","text":"翰苑编摩二十年，容台典礼荷乔迁。\n为臣报国才须尽，哭子还乡病已缠。\n四尺孤坟嗟自掩，一椷遗藁竟谁传。\n可怜宦达俱成梦，追忆平生倍怆然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周先生分教崖州","author":"倪谦","text":"□崖南涉□中洲，此去传经是胜游。\n月映珠光浑有泪，云连蜃气总成楼。\n莫言土俗兼黎獠，会使儒风变鲁邹。\n有待化孚趋觐日，恩波重沭凤池头。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿徐溥编修父六十号荆南渔隐","author":"倪谦","text":"荆溪之南有渔叟，手理钓丝今几霜。\n秋风拥蓑芦叶老，春雨放棹桃花香。\n六旬华发介繁祉，七月绮筵生嫩凉。\n玉署贤郎致遥祝，寿辞为寄水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其一","author":"倪谦","text":"青宫出阁正年芳，礼蕝先当习太常。\n翰学八人期会合，宫花一夜巧铺妆。\n珍羞旋簇筵前绮，金印初封肘后黄。\n独乐争如能与众，共将高咏送清觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其二","author":"倪谦","text":"玉署藏春发旧芳，细推花数象纲常。\n八枝相应攒新朵，三色齐开逞盛妆。\n嫩叶翻风梳鸭绿，香须倾日撚鹅黄。\n菲才何幸承清赏，到手宁辞潋滟觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其三","author":"倪谦","text":"三种天葩各献芳，策名容可袭凡常。\n锦拖宫样袍初制，玉琢琼华带始妆。\n放蕊竞当炎夏赤，托根终近省闱黄。\n颜红更爱群仙侣，沾醉瑶池阿母觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其四","author":"倪谦","text":"少年曾探杏园芳，今见名花忆往常。\n綵襭蒸霞浓有态，玉杯擎露淡无妆。\n华筵欢赏倾醽醁，佳句赓吟写硬黄。\n气运隆昌吾道泰，静观物理谩传觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其五","author":"倪谦","text":"兆协文明夏始芳，昔贤何乃视为常。\n凤池培得千金种，鳌禁堆成百宝妆。\n近侍曾闻亚姚魏，品题今喜赖苏黄。\n调高春雪知难和，引兴还须釂巨觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其六","author":"倪谦","text":"四朵围金昔吐芳，八花簇锦胜閒常。\n梅询谩说薰香袖，何晏徒劳傅粉妆。\n地切清华依日月，气钟灵异本玄黄。\n不须远论韩公事，千载能无慕此觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其七","author":"倪谦","text":"太史挥毫纪异方，意同麟简不书常。\n数符元恺知呈瑞，会集夔龙为洗妆。\n内省花容真富贵，词林才气总骊黄。\n吟安独愧偏疏拙，举白堪浮绿蚁觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其八","author":"倪谦","text":"省药元超百卉芳，几年寥落喜归常。\n士逢圣主垂情眷，花被天工着意妆。\n壶谱雅歌鸣鲁薛，诗盟高会及江黄。\n太平宰辅仙儒辈，自合公馀醉玉觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其九","author":"倪谦","text":"艺苑英华久漱芳，连篇捧诵句超常。\n不资诗伯风骚体，争慰花神锦绣妆。\n玉液满斟恩露渥，紫微高应德星黄。\n时和已卜丰年象，后乐何妨各尽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内阁李学士赏花诗 其十","author":"倪谦","text":"胜日追陪与宴芳，会开真率具家常。\n畅怀内酒频斟酌，照眼仙姿任点妆。\n宝篆当筵焚吐白，玉瓶堆案拆封黄。\n明年此际期重盛，问讯花神酹一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清溪蘸玉便面为孙廷璧户侯题","author":"倪谦","text":"玉枝半落水晶宫，泠浸琅玕翠色浓。\n照影疑翻丹穴凤，腾身惊化葛陂龙。\n淩波仙子烟中度，解佩湘妃月下逢。\n一握清风欣入手，洒然凉意满襟胸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送支立司训京闱较艺毕还毗陵","author":"倪谦","text":"麟经褒贬究宣尼，较艺京闱属命题。\n深院下帘朝品藻，明窗批卷晚然藜。\n桂香偏喜从人折，日色宁教过眼迷。\n乡榜已开公道显，此行清誉许谁齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠朝鲜陪臣工曹判书朴元亨还国","author":"倪谦","text":"曾于文字久相知，赋敌杨雄思不羁。\n楚国包茆频入贡，虞廷彩凤喜来仪。\n东藩地远山川隔，北阙天低雨露垂。\n归去观光知有得，襟怀应负子长奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日游宣府李挥使北园席上步于景瞻韵二首时天顺庚辰六月也 其一","author":"倪谦","text":"野花园草竞芬芳，坐爱南薰透葛凉。\n饮量任开千日酝，醉魂犹到五云乡。\n原思自信贫非病，杜甫谁知老更狂。\n倒着接䍦浑不省，路人争说自高阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日游宣府李挥使北园席上步于景瞻韵二首时天顺庚辰六月也 其二","author":"倪谦","text":"绮席风生酒气芳，清酣何必按伊凉。\n得朋自喜皆同志，为客宁愁在异乡。\n归思空怀弘景逸，行歌堪叹接舆狂。\n举头瞻望长安近，一片丹心独向阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和韩都宪诗 其一","author":"倪谦","text":"身婴缧械出君门，远谪穷边泪暗吞。\n触祸只应当薄命，含污何以雪沈冤。\n未言息壤宜投杼，欲诉旻天惜戴盆。\n感荷力全垂死际，拊心恒愧莫酬恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和韩都宪诗 其二","author":"倪谦","text":"肯为权奸启倖门，祸机阴中只声吞。\n南冠独受羁囚苦，东海谁明孝妇冤。\n直道不容还似柳，小才见杀已如盆。\n丈人何幸怜枯鲋，呴沫时沾勺水恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再和前韵荅韩都宪 其一","author":"倪谦","text":"昔承诏狱下黄门，五百严刑气若吞。\n虐焰相陵将致死，皇威虽近敢称冤。\n女生不见门悬帨，妾殒空怜坐鼓盆。\n幸得投荒离虎口，北行深荷九重恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再和前韵荅韩都宪 其二","author":"倪谦","text":"边塞穷居荜作门，举家脱粟强须吞。\n千金剑利甘遭折，六月霜飞苦抱冤。\n堕地何殊星化石，洗天惟待雨倾盆。\n安能释系归田里，没齿衡茅颂圣恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再和前韵荅韩都宪 其三","author":"倪谦","text":"待漏曾陪紫禁门，气豪云梦羡胸吞。\n持平难解奸臣忿，忍耻常怀逐客冤。\n望眼空悬栖凤阁，澡身欲借洗头盆。\n喜逢伯乐能知己，朝夕能忘国士恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"锦衣狱中有作追录于此","author":"倪谦","text":"不才自保一生无，祸中阴谋恣矫诬。\n贡院本期登俊造，圜扉何意齿囚徒。\n通宵不寐更三鼓，终日相亲火一炉。\n圣德好生疏禁网，肯令冤滥及非辜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵于景瞻百样娇 其一","author":"倪谦","text":"雕阑频倚暗销魂，其奈风前百媚存。\n春醉半醒霞晕薄，晓妆初罢粉香温。\n淩波仙子娇相倚，解佩江妃笑欲言。\n宜化彩云归阆苑，纷纷凡卉敢同论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵于景瞻百样娇 其二","author":"倪谦","text":"群芳秾丽不沾埃，六月才从塞北开。\n玉颊争妍偏惹恨，锦苞凝艳半含胎。\n雨滋巫峡行云倦，风引昭阳侍宴回。\n可是多情怜国色，殷勤分种客窗栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵于景瞻秋怀五首 其一","author":"倪谦","text":"暝云寒雨暗亭皋，范叔谁怜为解袍。\n涉世逢屯宜自遣，谋生多计亦徒劳。\n小窗字画临羲献，孤馆诗笺究郑毛。\n图史相亲如故友，窥人况有月轮高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵于景瞻秋怀五首 其二","author":"倪谦","text":"塞垣榆落早惊秋，雁影砧声总是愁。\n客里诗情元亮酒，天涯乡思仲宣楼。\n抵金书信凭谁寄，画虎功名付道谋。\n身堕穷边俄二载，不知何日大刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵于景瞻秋怀五首 其三","author":"倪谦","text":"萧瑟西风送晚凉，千山摇落寄他乡。\n烽烟时警深边戍，燐火宵明古战场。\n蝶梦悠扬云杳杳，萍踪飘泊海茫茫。\n久知身后名无用，莫羡杜陵黄四娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵于景瞻秋怀五首 其四","author":"倪谦","text":"百雉孤城夕照明，班超空动玉关情。\n尖峰刺眼呈秋剑，灵籁伤怀鼓夜笙。\n陟险自怜盐骥苦，知机不及海鸥惊。\n中宵睡醒烦忧集，卧听朝鸡戒晓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵于景瞻秋怀五首 其五","author":"倪谦","text":"愁边得句口能占，荼蓼亲尝味转甜。\n风挟尘沙欺病目，雷驱山雨扑穷檐。\n秋来倍觉丹心壮，老去频看白发添。\n喜决天池无限水，不令辙鲋一毫沾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡鍊绣衣昭君词 其一","author":"倪谦","text":"昭阳常向梦中归，无羽何由得奋飞。\n愁压眉山慵对镜，病消肌玉不胜衣。\n伤心白草呈秋色，极目黄沙起夕霏。\n真使妾身能制敌，汉家良计孰云非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡鍊绣衣昭君词 其二","author":"倪谦","text":"万里空看汉使归，羞随骄子效于飞。\n穹庐马湩初尝酒，寒碛貂裘为换衣。\n忧思酿成云黯淡，啼痕散作雨雰霏。\n琵琶苦调和羌管，举目堪怜事事非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡鍊绣衣昭君词 其三","author":"倪谦","text":"旅雁年年去复归，此身陷敌若为飞。\n心情流水趋沧海，世事浮云变白衣。\n出塞哀笳声袅袅，当筵角旋舞霏霏。\n阳关北望伤神处，蔓草寒沙道路非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]