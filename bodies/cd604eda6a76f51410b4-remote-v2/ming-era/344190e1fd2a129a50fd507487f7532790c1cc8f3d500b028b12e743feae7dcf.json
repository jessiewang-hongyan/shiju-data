[{"title":"赠王四槐宪长 其三","author":"余继登","text":"男儿出身常事边，何如归种洛阳田，宝刀卸却但高眠。\n且喜手中银不律，羞杀跨下铁连钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王四槐宪长 其四","author":"余继登","text":"寒风吹折蓟门柳，劝君但尽杯中酒，赤胆空言大如斗。\n向来枉费张君舌，此去好闭陈生口。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方扩甫至涿鹿闻贵阳之命不及一晤而去书此道怅惘之怀","author":"余继登","text":"黔岭盘江客路长，君才岂合老风霜。\n上书北阙忠为胆，驱马南天瘴是乡。\n铜柱何时标粤地，竹符此日走蛮王。\n相逢咫尺还相别，离恨应随到夜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送少司空李棠翁老师之金陵 其一","author":"余继登","text":"留都吴建业，常伯古司空。\n礼乐归宗匠，经纶属国工。\n晓云随去马，秋月听征鸿。\n时有怀君梦，清宵入汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送少司空李棠翁老师之金陵 其二","author":"余继登","text":"众望归台鼎，王言作朕虞。\n积薪嗟自汉，乘传且游吴。\n胜可探三岛，閒堪赋两都。\n秣陵馀王气，怀古见雄图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送少司空李棠翁老师之金陵 其三","author":"余继登","text":"去去辞金马，行行向石头。\n台高曾宿凤，官古旧名鸠。\n南北皆荣遇，江山足壮游。\n独令桃李士，日夜望仙舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送少司空李棠翁老师之金陵 其四","author":"余继登","text":"昔校陪京士，曾看吴苑花。\n今参玄武部，还泛大江槎。\n世路疲行役，风尘老岁华。\n栖筠原重望，日下看宣麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史应之给事使汴 其一","author":"余继登","text":"暂辍明光草，遥分大国桐。\n双旌来日下，四牡向天中。\n宝剑含秋水，金函耀彩虹。\n梁园如有赋，枚叔未为工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史应之给事使汴 其二","author":"余继登","text":"去矣游何壮，嵩墟本帝京。\n河山千古胜，带砺万年盟。\n芳草迷周泽，祥云拥汴城。\n夷门久寂寞，何处问侯生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方户部之金陵 其一","author":"余继登","text":"十月燕山道，潇潇风正寒。\n故人从此去，偃蹇寄微官。\n世事凭谁论，天涯好自宽。\n相看惟涕泪，聊尔劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方户部之金陵 其二","author":"余继登","text":"官是度支吏，人称画省郎。\n此行非落莫，吾道足徜徉。\n地胜当龙虎，台高有凤凰。\n知君能汗漫，赋就莫相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"费国聘入贺还蜀 其一","author":"余继登","text":"别久情偏洽，欢多别转难。\n风尘堪堕泪，霜露好加餐。\n路入蚕丛杳，山当鸟道盘。\n锦官千万里，何处望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"费国聘入贺还蜀 其二","author":"余继登","text":"吾党论英妙，惟君意气雄。\n入朝歌宴镐，献寿竞呼嵩。\n名以游燕大，文从谕蜀工。\n怜才明主意，迟尔建章宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重修乾清宫奉慈驾还御制题","author":"余继登","text":"阊阖重新接紫微，九重天子奉慈闱。\n云连画栋开金殿，日射雕楹敞玉扉。\n仙鸟翩翻迎綵仗，炉烟缭绕上霞衣。\n遥知定省承欢处，寿曜弧南映晓辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过燕子矶","author":"余继登","text":"燕子矶头山色幽，燕子矶前江水流。\n矶上老僧无一事，年年此地看行舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登凤凰台台上有石甚奇前为陈光禄移去竟沉江中","author":"余继登","text":"李白游白下，曾为凤台吟。\n凤去几千载，台名直至今。\n我来登此台，秋色亦已深。\n高台久荒凉，古木尚阴森。\n但对骢马客，不闻彩凤音。\n游览未终竟，斜日下高岑。\n好雨从西来，凉气袭我襟。\n台上有奇石，闻向江中沉。\n利令石可移，恻焉感予心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭题玄兔卷应制","author":"余继登","text":"玄霜捣就化仙姿，跃跃今看在圃时。\n喜向天门标上瑞，还从月窟应昌期。\n精涵水德由来异，色借烟光觉更奇。\n染素知逾千岁质，披图拟荐万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭题大阅图应制","author":"余继登","text":"我皇神圣能绳祖，威灵赫奕超千古。\n岭表烽销瀚海清，犹自忧危思耀武。\n三月三日天气和，五云高捧翠华过。\n地动轰雷奔铁骑，丽天晴日照金戈。\n辕门此际军威震，伐鼓鸣钲闻远近。\n七校争誇貔虎姿，十干正演龙蛇阵。\n纵横叱咤逞豪雄，角射当场技尽工。\n健儿惯使千斤弩，侠少能开六石弓。\n健儿侠少纷驰逐，夹道旁观俱詟服。\n冠军原不让嫖姚，扛鼎何须羡贲育。\n桓桓赳赳壮皇威，妙略英风播九围。\n久闻关塞铙歌唱，坐见边庭羽檄稀。\n太平日日谋桑土，战士人人沾雨露。\n天下虽安未可忘，吾王一豫真为度。\n只今将卒如云屯，禦敌年年更苦辛。\n九边愿普投醪惠，万载常歌挟纩仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭题画鹿应制 其一","author":"余继登","text":"匹练开仙籞，良工赋象奇。\n甡甡看逸态，麌麌见灵姿。\n太液泉明处，长杨木茂时。\n试观町疃迹，知是恋恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭题画鹿应制 其二","author":"余继登","text":"玄圃深钟瑞，宜春旧擅名。\n异毫留墨润，黝质照人明。\n饮渫形何适，眠荃性不惊。\n宛然灵囿里，神物表休祯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭题画鹿应制 其三","author":"余继登","text":"曾见白环异，仍留宝绘传。\n锡名徵百禄，阅世已千年。\n苹野娱嘉客，蓬山伴列仙。\n衔花金令爽，献寿傍琳筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭题画鹿应制 其四","author":"余继登","text":"本是仙家畜，今归册府藏。\n冰纨呈宝箓，星毳散瑶光。\n晴树纷供翠，秋芝细吐芳。\n上林无羽猎，群友任徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢东麓祠部廷杖为民南还","author":"余继登","text":"燕山雪花大如手，层冰欲裂阴风吼。\n车轮摧折马不前，卢郎此日东南走。\n卢郎尔去莫销魂，尔力犹能叩天阍。\n幽谷不回白日照，星辰乱落红尘昏。\n红尘昏，浮云驰，嗟哉世事竟堪疑。\n精诚自分山可移，山鬼窃笑精灵窥。\n汉庭不闻贾生痛，泽畔谁怜屈子悲。\n卢郎卢郎尔何为，上帝待尔以不死，尔归且韬胸中奇，慎勿狂歌叹五噫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴太华宪佥买燕姬赴蜀赋赠 其一","author":"余继登","text":"燕姬年十五，弱质不胜春。\n得侍吴郎寝，何言宋氏邻。\n舞馀娇欲尽，妆罢态逾新。\n行路应相问，儿家疑姓秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴太华宪佥买燕姬赴蜀赋赠 其二","author":"余继登","text":"别母辞乡国，踌躇谁忍分。\n愁看桃叶渡，泪点石榴裙。\n月貌娇夫婿，风流属使君。\n若经巫峡路，或恐化行云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游崇真观","author":"余继登","text":"偶来游玉宇，不为觅金丹。\n尘世纷挐苦，人生休暇难。\n聊同羽客话，暂卸侍臣冠。\n石窦流泉出，泠泠入座寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感","author":"余继登","text":"皇都色未曙，车马已喧阗。\n侠客纷携弹，妖姬惯数钱。\n王侯罗甲第，戚里斗繁弦。\n不似股肱郡，萧条绝暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过江陵故宅","author":"余继登","text":"高门馀故宅，荒径但新萝。\n巷僻无车马，庭空散绮罗。\n树残微有叶，池浅不生荷。\n富贵皆尘土，豪华那足多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中","author":"余继登","text":"病多偏易懒，独坐漫踌躇。\n即死不称夭，倘生真是馀。\n一身原自幻，万相总成虚。\n何事拚微命，依依老校书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长门怨","author":"余继登","text":"长门寂寂不胜春，忍听君恩处处新。\n亦有黄金堪买赋，羞将宠爱托词臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居","author":"余继登","text":"寂寞村斋里，春深日觉迟。\n药残呼仆斸，背倦倩儿捶。\n户外鸟啼树，井边犬护篱。\n地幽无客至，閒检杜公诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长信宫","author":"余继登","text":"可怜长信已春回，总是无人花亦开。\n莫道天街常寂寞，入帘犹喜燕飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻蝉 其一","author":"余继登","text":"高槐遥借隔林青，树里鸣蝉乍可听。\n记得年年当此日，一般流响过閒庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻蝉 其二","author":"余继登","text":"午夜枝头时饮露，斜阳叶底惯吟风。\n儿童最爱声清切，愁杀悲秋白发翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣","author":"余继登","text":"自君之出矣，罗幔为谁熏。\n忍见博山上，蛛丝结网文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭题百子图应制","author":"余继登","text":"宫中多乐事，百子竞欢趋。\n知是燕禖应，欣看龙种殊。\n人人阶下玉，队队掌中珠。\n共讶冰为骨，还疑玉作肤。\n娇痴原不妒，游戏总堪娱。\n约臂黄金串，缠身锦绣襦。\n螽斯徵瑞庆，麟趾叶祯符。\n长信浑无事，閒听歌凤雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿徐封君翰检端铭之父","author":"余继登","text":"忆昔年当龆龀时，与君诸弟相游嬉。\n君时文章光陆离，淩云有赋众所奇。\n投分未登孺子榻，论交已受季方知。\n三十馀年疾如驶，予发种种已如此，君今头颅可知矣。\n闻君年开六帙馀，骨格清奇鹤不如。\n教儿已作凤池客，携室同向鹿门居，君今不乐将安须。\n春花发繁红，秋樽湛芳绿。\n鸠杖双携灵寿筇，紫箫共度长生曲。\n何必怀金纡紫谒帝庐，又何必求仙问道访茅屋，如此五年愿亦足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高仪部谪中部令","author":"余继登","text":"聊沽燕市酒，送子向延安。\n南省名逾重，西人胆欲寒。\n一鸣成斥马，百里暂栖鸾。\n但保丹心在，无嗟行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕送常廉庵北上","author":"余继登","text":"浮名驱子去，慷慨向瑶京。\n宝月照离思，春星伴客程。\n绿樽聊共醉，青眼定谁明。\n自愧杨中侍，无能荐长卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宁云田备兵独石","author":"余继登","text":"中朝节使行边日，犹是单于款塞年。\n剑气夜寒青海月，笳声秋断赤城烟。\n北门尺堠遥连晋，上谷层关迥抱燕。\n闻说汉庭论保障，黄金雀印待君悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿何封君","author":"余继登","text":"罢郡归来二十年，采芝斸药老林泉。\n斑衣亦是山中相，野服真成河上仙。\n驯鹤时看陪杖履，冥鸿久已破云烟。\n嵩峰尚有王乔在，明月应来證太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送易君选守兖州","author":"余继登","text":"骖驔宝马逐风尘，喜报除书岁岁新。\n北阙双符分紫绶，东方千骑拥朱轮。\n人从水部知何逊，帝为名邦借寇恂。\n有日黄金飞汉诏，看君露冕自行春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望夷门 其一","author":"余继登","text":"驱车上夷门，怀古三叹息。\n可怜虚左宾，独有窃符策。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望夷门 其二","author":"余继登","text":"朱亥诚勇士，侠气淩秋云。\n何事袖中椎，不椎秦将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得双塔寺","author":"余继登","text":"宝塔参差插帝都，琳宫对耸玉浮图。\n慈云拥处轮疑转，明月悬时影不孤。\n白马双双来异域，黄金叠叠起灵枢。\n莫言久已成灰劫，犹有胡僧夜拜膜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐肖及请告南还","author":"余继登","text":"去年我别君，河桥樽酒醉斜曛。\n今年君别我，古道双旌纷婀娜。\n欢会何少别离多，把袂相看泪交堕。\n君厌承明庐，翻然赋閒居。\n归云一万片，片片随君车。\n白云亲舍知不远，游子天涯今始返。\n十年曳裾亦已迟，一旦抽簪未为晚。\n与君交结与君亲，仲氏吹篪伯氏埙。\n羊质笑我终难达，龙性知君不易驯。\n长安华毂者谁子，尽教繁盛常如此。\n岂无肝胆向人倾，世路悠悠几知己。\n君嗤腐鼠腥，高步入青冥。\n顿觉客游恶，能使客心醒。\n亦知富贵等朝露，可柰兄弟如晨星。\n世间万事无不了，白日红颜空自老，君辞荣禄何其早。\n茎露调来丼旨清，■鞋踏破云林晓。\n送君行，为君道，君归预把山石扫。\n有日寻君易水滨，十日平原共倾倒。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送慈溪潘学博","author":"余继登","text":"薄宦向何处，东南甬水边。\n春风开绛帐，寒色上青毡。\n博士原潘岳，诸生得郑虔。\n广文官舍静，明月好谈玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿石介峰母太夫人时介峰新有操江之命","author":"余继登","text":"凤诰翟褕出汉庭，慈云冉冉护辎軿。\n金仙原注长生箓，宝婺今连执法星。\n春色喜看萱草绿，东风频想荔枝青。\n中丞新领吴门节，大有江鱼荐醁?。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许静峰备兵清源","author":"余继登","text":"古人勖明德，今人惜离居。\n离居岂不惜，明德良足图。\n烈风吹征衣，送君城南隅。\n君行向清源，坐拥双熊车。\n清源何壮哉，交交名利途。\n帆樯下大河，车马纷长衢。\n厨传日丰盈，田野日荒芜。\n昔予疲行役，过此长太吁。\n对食不能餐，单车屏前驱。\n今岂异昔时，民或益以瘉。\n宪府自崇邃，安能顾田庐。\n谁为洒春霖，一使劳者苏。\n君负彩凤姿，况握竹虎符。\n行当念穷黎，宁复甘华腴。\n先哲有遗言，示我以良谟。\n诗人戒戎作，大易谨衣袽。\n君行慎勉旃，于以慰区区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遇斋毅庵文所小饮敝居遇斋能谈玄修赋赠","author":"余继登","text":"天涯宦迹许谁亲，且喜开樽对故人。\n浮白尚馀年少兴，谈玄欲驻老来身。\n须知尘世生原幻，莫道丹经诀是真。\n今日与君聊尽醉，仙家几见有词臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘效忠再起备兵阳和","author":"余继登","text":"不有唐冯在，谁论魏尚功。\n君才堪秉钺，此去复临戎。\n尘净龙城月，烟消狐塞风。\n亦知燕颔相，未合老隆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张端叔大参之大梁 其一","author":"余继登","text":"何意明光客，驱车出蓟门。\n汉庭谁补阙，梁地尔参藩。\n中外皆王事，风尘总圣恩。\n寸心期不负，此去更奚论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张端叔大参之大梁 其二","author":"余继登","text":"河桥三月暮，春色晓氤氲。\n黄鸟方求友，青樽却送君。\n魂销燕市酒，心折太行云。\n兄弟飘零甚，天涯忍更分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张端叔大参之大梁 其三","author":"余继登","text":"无以赠行役，看君空泪垂。\n向来惟令德，此后但相思。\n古道存交谊，深情怅别离。\n连床风雨夜，何日是前期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张端叔大参之大梁 其四","author":"余继登","text":"苍茫望不极，天上落黄河。\n君向中原去，应从此地过。\n孤身真浪迹，九曲尽风波。\n莫仗怀忠信，艰危世路多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陈太常母夫人","author":"余继登","text":"青青堂上萱，郁郁堂前桂。\n萱兮正芬蒀，桂生何蔽芾。\n秋风生桂枝，馨香为国瑞。\n托根在天墀，雨露时其霈。\n双承雨露恩，持以献堂背。\n雨露日以繁，萱花日以蔚。\n孤根比大椿，挺挺八千岁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱太史养淳册封周藩","author":"余继登","text":"昔予祗行役，驱车向中原。\n中原饥馑馀，氛祲日以烦。\n白骨乱如麻，黯然销神魂。\n朱门郁萧条，哀哀诸王孙。\n君今复持节，翩翩过夷门。\n不知周遗民，今有几家存。\n况今旱为虐，五月黄尘昏。\n知君负经济，雅志念黎元。\n当其授简时，应为废朝飧。\n莫以董贾笔，虚负邹枚言。\n愿赓云汉篇，归来达至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日饮用韫宅遇雪兼赴刘工部之约 其一","author":"余继登","text":"子云拙可嗤，佳节甘萧索。\n喜得同心人，相招共相乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日饮用韫宅遇雪兼赴刘工部之约 其二","author":"余继登","text":"故人交如兰，故人酒为薏。\n交深酒更佳，何妨为君醉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日饮用韫宅遇雪兼赴刘工部之约 其三","author":"余继登","text":"醉来兴太狂，六博閒笑语。\n风雪解留人，门外深几许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日饮用韫宅遇雪兼赴刘工部之约 其四","author":"余继登","text":"踏雪觅刘郎，相看成一笑。\n不如王子猷，空返剡溪棹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄友人鲁生同原 其一","author":"余继登","text":"独爱同原子，昂藏一丈夫。\n蚤逃博士籍，急返步兵厨。\n六帙身方健，百年事易徂。\n鹴裘何用惜，好付酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄友人鲁生同原 其二","author":"余继登","text":"不受儒冠误，知君意颇真。\n心能识故我，名已让他人。\n谢傅登山屐，陶公漉酒巾。\n只今吾愧汝，碌碌尚风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]