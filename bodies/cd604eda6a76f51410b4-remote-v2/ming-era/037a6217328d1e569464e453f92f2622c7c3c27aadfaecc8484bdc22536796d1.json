[{"title":"王令招游虞山","author":"王世贞","text":"鸣驺向城市，缓带复郊坰。\n海色遥吞白，天光自与青。\n汝无惭地主，吾敢应山灵。\n便欲依岩卧，停杯问摘星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南轩远眺示王令","author":"王世贞","text":"凭轩此高眺，眼底意苍然。\n一气千江合，孤踪万象先。\n席移将堕石，琴起欲飞泉。\n不分王明府，能令胜地专。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过子游虞仲祠","author":"王世贞","text":"一代言文学，千秋虞逸民。\n列星垂气象，沧海绌经纶。\n太上有立德，其先不辱身。\n遐哉不可见，吾请事斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"散步","author":"王世贞","text":"饭罢欲何适，独行扶兴长。\n出门青草径，随地绿萝庄。\n麦浪摇晴旭，松云逗晚凉。\n炯然鸥数点，吾意渐相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈指","author":"王世贞","text":"屈指同心客，经年省署稀。\n岂皆吾道拙，或与世情违。\n一醉乾坤是，孤吟岁月非。\n祇应罢簪绂，甘老薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乱后初入吴舍弟小酌","author":"王世贞","text":"与尔同兹难，重逢恐未真。\n一身初属我，万事欲输人。\n天意宁群盗，时艰更老亲。\n不堪追往昔，醉语亦伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"参省吴君挂冠之后以时难膺檄募兵耀武虎丘 其一","author":"王世贞","text":"元戎夹铍队，晴日试吴阊。\n吹绕千花发，旌从万树张。\n霜文散组练，海色满馀皇。\n谈笑飞书去，沧波定不扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"参省吴君挂冠之后以时难膺檄募兵耀武虎丘 其二","author":"王世贞","text":"自尔龙韬偃，谁当羽扇麾。\n据鞍还草檄，横槊更谈诗。\n禄食群公擅，戎衣野客疑。\n功成不问赏，应向鲁连知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与抑之游虎丘寺","author":"王世贞","text":"风至开山阁，云归卧佛床。\n薄岩施屐易，疏竹进床凉。\n醉益狂奴态，游偏傲吏长。\n兴酣公莫舞，秋色起干将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昆山别张通参丈人","author":"王世贞","text":"风尘吹逆旅，天地老垂纶。\n共醉青山色，偏伤远道神。\n离前多怯酒，乱后各怜身。\n欲作披襟话，秋霜鬓易新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄宗子相 其一","author":"王世贞","text":"先后成归客，艰难有避兵。\n地偏穷遣信，天坼异浮生。\n桂树云常合，桃花水未平。\n何当徇微禄，愧尔向时名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄宗子相 其二","author":"王世贞","text":"明月邗沟水，飞花绕郭多。\n闭门时辈远，开卷古人过。\n旧社谁能继，新诗各自歌。\n更论燕市饮，相顾邈山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高邮别表兄盛生","author":"王世贞","text":"留君更前路，樽酒暂流连。\n故里人将尽，他乡语欲偏。\n帆来湖上雨，鸟散渡头烟。\n家国今何限，深愁眼剧穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访李丈修撰子相考功承二君见候不值有感","author":"王世贞","text":"谁道嵇康懒，携琴载酒杯。\n仙舟空不见，日暮独徘徊。\n桂讶淮南近，帆疑剡曲来。\n知当动星象，不必拟三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再示子相","author":"王世贞","text":"会梦时能作，今来恐未真。\n独行邗水上，天阔四无邻。\n别后长如此，幽怀可具陈。\n腰间有雄剑，拂拭气还新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子相草堂夜话 其一","author":"王世贞","text":"世途诚浩荡，吾党亦浮沉。\n见汝栖淮海，雄心自古今。\n偶成全豹隐，忽漫一龙吟。\n不有安期驾，云深可易寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子相草堂夜话 其二","author":"王世贞","text":"剪烛频相藉，邻鸡月又新。\n隔年唯一笑，回首竟何人。\n湖海神偏王，云霄梦未真。\n所嗟从此别，辛苦易沉沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子相草堂夜话 其三","author":"王世贞","text":"闻道青莲客，新乘五马车。\n亦知多忤世，无那转怜渠。\n长揖难官长，高吟恐簿书。\n因逢同病者，北望更踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十六夜泊彭城与张给事廷槐月下小饮","author":"王世贞","text":"此夜彭城月，清光万里寒。\n河流天地合，山色古今看。\n桂树香徐吐，金樽漏易残。\n与君聊一醉，途路失艰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十七夜饮月下因怀昨年亦淹此地","author":"王世贞","text":"昨岁逢兹夕，徐方月下船。\n客途今又到，秋色去仍偏。\n岸帻风霜里，开尊鸿雁前。\n不堪频远望，南北总潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻彰德寇起志感 其一","author":"王世贞","text":"此际潢池警，横行自豫方。\n孤城压晕黑，千骑宿霾黄。\n衷甲谋非拙，横行势可当。\n如闻天下险，或恐向敖仓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻彰德寇起志感 其二","author":"王世贞","text":"南北殊忧难，中原近若何。\n向来论守相，或恐致兵戈。\n枳棘春偏晚，风霜暮自多。\n始闻徵渤海，垂白竟蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻彰德寇起志感 其三","author":"王世贞","text":"汝辈劳宵旰，徵兵几道闻。\n虎符新使者，猿臂故将军。\n鼓叠漻堤浪，旌连亳社云。\n只今惟一战，白羽莫纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登太白楼","author":"王世贞","text":"昔闻李供奉，长啸独登楼。\n此地一垂顾，高名百代留。\n白云海色曙，明月天门秋。\n欲竟重来者，潺湲济水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏燕京南陌","author":"王世贞","text":"落日散平楚，馀春留远阡。\n问津礼樵叟，下马拾榆钱。\n白挟千峰雨，青迷万灶烟。\n笛声丛薄内，宛似太湖田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王生下第秋归","author":"王世贞","text":"婆娑蓟门柳，来往惜年华。\n楚客停舟夜，胡姬卖酒家。\n枻歌南去近，书雁北行斜。\n此际毋挥泪，秋风江上花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚戌秋有约吴峻伯不就赋此","author":"王世贞","text":"汉树淹边月，天都拂塞尘。\n九关虚虎豹，层阁望麒麟。\n社稷群公手，兵戈一介身。\n请缨还请剑，慷慨涕沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日游弘慈寺僧祈雨乞午斋而出","author":"王世贞","text":"此日依莲社，真成戒酒杯。\n胡僧多宝座，士女献花台。\n说法老龙去，随缘甘雨来。\n冲泥予不厌，骑马夜能回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁寺晨起即事","author":"王世贞","text":"小榻栖兰若，朝来得纵眠。\n依依上窗日，隐隐隔墟烟。\n偶转昙花径，閒翻贝叶编。\n随缘可度日，无意更求禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙河桥","author":"王世贞","text":"何年鞭禹石，突兀亘沙洲。\n山接垂虹势，波穿偃月流。\n寝园高自见，车马迥生愁。\n不敢题红叶，知他达御沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初葺省中西亭 其一","author":"王世贞","text":"仲长慕清旷，潘岳赋閒居。\n吾亦闻斯语，畴能返故庐。\n得閒聊假息，随意试抽书。\n公署长如此，金门大隐馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初葺省中西亭 其二","author":"王世贞","text":"固爱春阴好，兼愁秋雨声。\n以兹无所植，独坐有馀清。\n岸帻浮云度，摊书落照明。\n避人吾已足，何事更经营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汤少府子重","author":"王世贞","text":"彭泽古达者，簿书安可羁。\n逢人羞作吏，竟日坐谈诗。\n春暖花源寂，云深药径迟。\n圣朝如可恋，未有去来辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家君楚中信","author":"王世贞","text":"不见衡阳雁，新年入夏初。\n忽逢江上信，疑是梦中书。\n楚甸春衣薄，燕山夜枕虚。\n白云犹在眼，凝望意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋日柬汝钦博士","author":"王世贞","text":"昼馀公事简，独坐候斜阳。\n偶却琴书扰，时闻花草香。\n清斋予不厌，别思尔俱长。\n后夜知谁醉，惟言恨太常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题朱象玄小猕猴","author":"王世贞","text":"南中荣木食，怜尔滞长安。\n幸托王孙号，羞带楚人冠。\n意轻全欲窜，毳弱未禁寒。\n宁无离群叹，得食暂成欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山道中有感","author":"王世贞","text":"驱马度潺湲，声从乱叶间。\n高秋出远戍，落日满诸山。\n寝殿金为室，长城玉作关。\n垂衣先帝业，回首愧朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"濮阳李明府自新喻再寄予诗兹以觐事驻城外属时禁方严不得出视怅然有怀","author":"王世贞","text":"万里君南去，新诗得共誇。\n如何近帝里，转似隔天涯。\n霜白枫难改，云黄日易斜。\n还期载春酒，同醉洛阳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠明竺上人","author":"王世贞","text":"竺师震旦秀，天骨何昂藏。\n一雨万流合，斜阳千岭苍。\n坐来杨枝水，忽发梅檀香。\n拟问西方路，人天并杳茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻寺僧","author":"王世贞","text":"且莫呼檀越，还携贫里箪。\n无法可施汝，将心何处安。\n石床凉睡足，僧饭午钟残。\n闻有函经在，能留次第看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"推案作苦息而试笔简子与","author":"王世贞","text":"推案轻过日，趋曹易逼年。\n故交咸卤莽，时态乍留连。\n满地疑词笔，千秋岂吏权。\n忍判从此际，著意媚风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭宋郎中文明 其一","author":"王世贞","text":"关左班初罢，楹间梦已长。\n古今殊顷刻，笑语落冥茫。\n露被先生妇，挥金同舍郎。\n征途冰雪里，谁不为沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭宋郎中文明 其二","author":"王世贞","text":"忆昨清源里，高秋驷马停。\n犹然称节使，忽尔返刍灵。\n素旐寒仍发，朱扉雨自扃。\n新阡数行柳，谁复记青萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同子与正叔夜过顺甫","author":"王世贞","text":"臈意深难尽，春光缓未回。\n日馀归案牍，天阔仅楼台。\n寂寞耽吾党，荣华逐世才。\n莫为残漏惜，过尔易徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绿尊草堂为沈君赋","author":"王世贞","text":"君是休文裔，忘忧祇绿尊。\n飞花翻作径，野竹自为藩。\n客有携琴过，童知荷锸言。\n壮心燕市酒，相对共销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其一","author":"王世贞","text":"忆昨江城暮，椒花耐晏眠。\n异乡春较缓，佳节意翻怜。\n馀食趋童稚，深杯拨岁年。\n坐来残漏紧，骑马问朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其二","author":"王世贞","text":"节物燕京盛，兹看太惋然。\n荒荒羁臈色，衮衮竞新烟。\n忆语须同日，传觞有各天。\n干戈竟何限，骨肉渐随缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至京喜仲芳尚在","author":"王世贞","text":"不谓夏台畔，能留复至今。\n朝廷宁仗汝，天地独无心。\n北极瞻逾切，中原畏转深。\n茫茫蓟门树，暝色满秋阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日意不怿折简徐魏二子过饮","author":"王世贞","text":"客岁添殊易，生涯问转难。\n塞云经晚变，燕日到春寒。\n世眼翻相白，吾颜岂重丹。\n且呼班尹醉，北斗任阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀容城生","author":"王世贞","text":"已决千秋事，还馀万死身。\n避人应有惜，谈尔竟难真。\n鸟雀同迷岁，荆榛可望春。\n不知缧绁畔，谁与授书频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姜君之衡山令","author":"王世贞","text":"尔去神明宰，青山治不难。\n祝融天一线，石柱雨千盘。\n雁自南荒尽，凫还北极看。\n中台今太史，应识汉郎官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月八日城西访徐尚宝出使还","author":"王世贞","text":"遇尔城西陌，初停四牡驰。\n乍晴为谷日，今雨正瓜时。\n暝色过谈易，春泥策蹇迟。\n畏闻乡井事，群盗乱如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访汝厚善果寺","author":"王世贞","text":"客居兰若远，为尔特相寻。\n宦迹容颜在，离怀鬓发深。\n暮生高殿角，春入古槐阴。\n更有弥天话，能淹不住心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日郊游有怀于鳞","author":"王世贞","text":"春甸堪吟醉，何妨藉草留。\n醉扶天地语，吟压古今愁。\n钜鹿山层去，卢龙日乱流。\n将心向谁剖，真觉此生浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠魏顺甫","author":"王世贞","text":"此道榛芜日，谁当草昧才。\n用专愁鹘视，心远钓鳌回。\n狂简缘吾得，声名舍众裁。\n须令屈宋后，岳色重崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与子与诸君即席分赋得瓜","author":"王世贞","text":"缑圃垂玄骭，雕盘荐绿沉。\n疑萍耀朝日，过麝失春阴。\n黄台太子咏，青门故侯吟。\n假彼寒暑候，消予荣辱心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赋得鱼","author":"王世贞","text":"湖海群分寄，悠然意与深。\n相教惟出入，于道有浮沉。\n未展垂天翼，犹纡立极心。\n宁知子非我，聊复恋蹄涔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同子与顺甫游姚园分韵四首 其一","author":"王世贞","text":"小苑停游骑，春衣试缓风。\n地容啼鸟合，天借乱崖通。\n草色已骄绿，桃花难禁红。\n科头仗解醉，非是学山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同子与顺甫游姚园分韵四首 其二","author":"王世贞","text":"休沐知余简，幽期细讨论。\n共誇韦氏曲，遥并辟疆园。\n落日驱诗语，高天下酒尊。\n暂来应有悟，丘壑此身存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同子与顺甫游姚园分韵四首 其三","author":"王世贞","text":"尔辈成三益，园亭胜颇兼。\n春云催淡荡，寒暝阁廉纤。\n黄鸟惊搔首，幽枝出捲帘。\n莫愁归骑促，残日挂峰尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同子与顺甫游姚园分韵四首 其四","author":"王世贞","text":"事事心相契，难知可易忘。\n片云为碣石，残雨即沧浪。\n草重杯堪席，花肥蜜欲房。\n醉来须袒跣，知尔恕吾狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恨","author":"王世贞","text":"零落先朋旧，艰危但甲兵。\n陆沉应有任，瓦解向谁明。\n展转疑吾道，低回愧此生。\n不知巫峡水，流恨几时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨翁","author":"王世贞","text":"达者王孙后，清时乐未涯。\n诸贤典属国，千树素封家。\n邻竹肩舆过，春云席帽斜。\n兵戈未须念，源水秘桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳同茂秦子与顺甫游姚令园分韵 其一","author":"王世贞","text":"上巳游中得，园亭兴未涯。\n蜂须低罥蕊，雀乳细穿花。\n水曲青丝笮，林间白鼻騧。\n亦知催暮景，宁忍掷春华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳同茂秦子与顺甫游姚令园分韵 其二","author":"王世贞","text":"小苑能栽竹，同心有握兰。\n爱看春水漫，贪惜酒杯难。\n日缓桃花暝，天留薜荔寒。\n未须论节序，休沐便为欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳同茂秦子与顺甫游姚令园分韵 其三","author":"王世贞","text":"故人同载酒，策马问柴桑。\n鴂候千花乐，蚕阴百草香。\n共惊醒后字，还促醉馀觞。\n君借春波浣，缁尘已建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明","author":"王世贞","text":"此日长安陌，光辉自玉珂。\n禁烟寒旧少，愁鬼岁新多。\n满地谋生拙，殊方逼逝过。\n未须推物理，天地竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦吟不就呼酒解之戏成一首","author":"王世贞","text":"万事从吾好，新篇取次裁。\n畏难聊罢笔，遣兴且衔杯。\n宿鸟放歌起，明蟾深坐来。\n得酣须就枕，童稚莫相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"微雨独醉","author":"王世贞","text":"谢客门应惯，呼尊手自斟。\n但随儿女戏，未少丈夫心。\n暮景重云就，春寒细雨侵。\n笑他穷阮籍，持底学浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]