[{"title":"送石太守简之高州一首","author":"黄省曾","text":"相晤即相别，春樽饯客归。\n岸无垂柳折，席有断云飞。\n道在行皆得，名芳远亦辉。\n片帆催五马，翘伫思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴人席生归乌镇旅寓一首","author":"黄省曾","text":"念汝昔为客，谁知客处家。\n一违吴苑月，十落异乡花。\n暂理苏台酒，寻催霅上槎。\n五湖桑梓绿，瞻否洞庭霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆子玄游东鲁一首","author":"黄省曾","text":"南国巳春暮，君行向北云。\n星江浮客影，日观讨仙群。\n忽怆兹晨别，翻疑前岁分。\n归来竹窗下，欣把纪游文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客还新安一首","author":"黄省曾","text":"草绿新安郡，天春问政山。\n吴门三月里，桃李送舟还。\n老动乡关思，新开江海颜。\n程潭高隐地，应共白鸥閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惜别一首","author":"黄省曾","text":"欲别更淹留，摇摇江上舟。\n片时杯共把，千里影孤投。\n行子若蓬转，居人惟梦求。\n宜看恋国水，不作背乡流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送皇甫礼部子安使中都省亲还京一首","author":"黄省曾","text":"眷阙肃輶轩，辞家怅祖筵。\n云霄搏九万，礼乐职三千。\n奉使劳方展，宁亲孝复全。\n予怀重情旧，驰送学流川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戴公江鹢巳发买舟追送二首 其一","author":"黄省曾","text":"闻道东旌发，离情浩不收。\n水知随去鹢，山亦恋行舟。\n想像经鸥渚，微茫过虎丘。\n别颜须一接，乘暮进江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戴公江鹢巳发买舟追送二首 其二","author":"黄省曾","text":"烟柳依依绿，征舠不可扳。\n倾城多祖席，把酒有江山。\n朱日悬行旆，青云照旅颜。\n徒令怀德者，愁思不能閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李侍御北上一首","author":"黄省曾","text":"骢马饯朝天，还台动綵旃。\n入京心象阙，别国思山川。\n芳草迷舟外，杨花乱席前。\n断云如可把，赠取佐离弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小岁日大云禅房听琴作梅花弄一首","author":"黄省曾","text":"岁纪巳言迈，空持白雪名。\n谁知祗树里，忽有梅花生。\n一抚客心霁，再弹山月清。\n何当坐幽阁，为写幽兰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓思一首","author":"黄省曾","text":"梦罢明灯在，鸡频晓月残。\n名惭高士久，病惜往龄宽。\n朋好偏教隔，妻孥不庇寒。\n伐檀诗重把，宁使古风阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮江泛一首","author":"黄省曾","text":"晚棹回江色，云空桃李稀。\n春山愁里过，不得玩芳菲。\n兴以沙鸥逸，杯看堤柳挥。\n莫教红日落，留照谢公归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日长安客思一首","author":"黄省曾","text":"白马长安客，黄金帝国台。\n乡心片月挂，旅阁五云开。\n乱乱杨花思，深深芳草杯。\n如何北回雁，不带锦诗来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚辰迎春日金果晚翠楼小集一首","author":"黄省曾","text":"青苑迎东气，朱楼衔午杯。\n竹筵逢早集，山日属春开。\n入岁翻年惜，怜时作世哀。\n吴宫杨柳色，行见碧条回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"首夏集陆芝新斋一首","author":"黄省曾","text":"小筑春初搆，芳樽夏始开。\n榻随苍竹下，客与白云来。\n岁月无留迹，林花有旧栽。\n一堂栖短发，于此且尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日蒋子携樽过草堂宴集一首","author":"黄省曾","text":"蒋翊携樽至，招寻觉尔贤。\n暑残苍竹径，秋入白云天。\n小饮过凉鸟，高吟及暮蝉。\n杯深虽酩酊，爱客敢求眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕一首","author":"黄省曾","text":"独帐成双室，云河作雨川。\n镜宫逢夕启，梭宇会宵悬。\n灯九欢相照，针多巧竞怜。\n凄锵天汉曲，偕凤入雕弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日和皇甫子安一首","author":"黄省曾","text":"登陟随乡俗，浮舠出古城。\n鬓催餐菊兴，肠断插萸情。\n壑午云姿丽，湖凉日气清。\n物华皆洒泪，空复爱佳名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕池上一首","author":"黄省曾","text":"季月逢占火，佳辰迨曝经。\n竹间还七客，河际复双星。\n接露欢衔酒，看云懒乞灵。\n苑虫秋韵切，催候警予听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日五更起坐不寐一首","author":"黄省曾","text":"檐雨午宵歇，室灯凉焰明。\n寝兴将百念，蟋蟀听残声。\n老态闺人识，新歌候物成。\n鸡鸣催九日，一感佩萸情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十五夜月有五色华晕二首 其一","author":"黄省曾","text":"圆魄度秋旻，金辉皎夕闉。\n不将三藉壁，若御五成轮。\n扇举裁纨丽，波含濯锦新。\n庆云如得把，堪赠北堂人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十五夜月有五色华晕二首 其二","author":"黄省曾","text":"满月漾昭回，澄辉穆气催。\n望宫华缀幕，飞镜彩妆台。\n作晕龙文杂，为图凤色开。\n凉风寒殿早，天锦定应裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪咏和皇甫子俊二首 其一","author":"黄省曾","text":"晼晚岁其暮，飘飖雪态回。\n花从九天落，春向一林催。\n拂户疑惭絮，临园若妒梅。\n阳春歌妙曲，宛入郢门来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪咏和皇甫子俊二首 其二","author":"黄省曾","text":"白雪无栽植，弥空自吐葩。\n萦盈金户皎，缭绕绮窗斜。\n坠来增别绪，销处感容华。\n更复攀瑶草，还如卫叔家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后对月和皇甫子循二首 其一","author":"黄省曾","text":"瀰野雪初集，云端皎月开。\n不知天上桂，何恋陇头梅。\n尘积轮言度，纨披扇取裁。\n春城此时眺，谁不谓瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后对月和皇甫子循二首 其二","author":"黄省曾","text":"缤纷飞雪暮，天月阆风过。\n映台悬玉镜，融沼溢金波。\n谢翰才抽赋，徐弦更入歌。\n若教乘访棹，奚啻上银河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月十五立春和皇甫子约二首 其一","author":"黄省曾","text":"玄辔犹遵陆，青阳巳动灰。\n如何一片月，并作两时开。\n淑景乘寒御，芳飙借腊回。\n韶光原自速，何用隔年催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月十五立春和皇甫子约二首 其二","author":"黄省曾","text":"在钟方应吕，观斗忽随寅。\n何意凋零日，番逢丽藻辰。\n未开调柏酒，先作对芳人。\n似天勤万物，早与布阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五日宴中南家兄园一首","author":"黄省曾","text":"中夏家星聚，清园选乐方。\n雨华增宴沃，天景并恩长。\n照槛嵇林绿，生池谢草芳。\n庭阶芝秀满，终暮玉琴张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕一首","author":"黄省曾","text":"独酌未成醉，初宵壶巳乾。\n坐临风漏远，吟倚雪帏寒。\n贫贱人情见，江湖岁月宽。\n明朝清镜里，犹作卧龙看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕有思一首","author":"黄省曾","text":"红楼隔鸾幕，绿窗孤凤弦。\n河星一不度，闺月两虚圆。\n千里梦相积，数书心未传。\n芳宵新玉箸，知挂镜台前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺二月金昌亭眺集一首","author":"黄省曾","text":"九十半芳辰，江山淑霭新。\n文舟交谑女，宝马竞游人。\n绿满蘼芜甸，香浮杜若津。\n欲留桃李色，特与两重春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新饰斋中作一首","author":"黄省曾","text":"小构吴宫畔，鲜云绿野披。\n药苗巳弥蔓，杨柳尽成丝。\n凤凰集玄上，鸳鸯加屋垂。\n于此就贤业，蓬蒿何足悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲申春正月嫁女感述一首","author":"黄省曾","text":"弱息待良耦，及笄归丈夫。\n早能闲内则，今已习刘图。\n祗益春愁阔，将令老眼孤。\n婚期渐来逼，难割凤凰雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀五岳五首 其一 嵩岳","author":"黄省曾","text":"太室登封地，言携宝镜求。\n云笙过子晋，星鹤下浮丘。\n石髓春杯服，仙床夜枕留。\n箕山知不远，兼得访巢由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀五岳五首 其二 泰岳","author":"黄省曾","text":"东岱摽秦观，遥空青未休。\n鸡鸣看日出，策秘想函求。\n雾阙中天峻，黄河足下流。\n稷丘君若在，吾与拥琴游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀五岳五首 其三 华岳","author":"黄省曾","text":"翠壁五千仞，山经昔所论。\n不愁攀铁锁，深欲倚云门。\n日月双崖照，星辰万壑翻。\n修羊悬石榻，时啸洗头盆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀五岳五首 其四 衡岳","author":"黄省曾","text":"紫带潇湘水，青高翼轸天。\n五峰摇素月，九井散灵烟。\n玉髓春山好，金芝福地偏。\n南巡无舜辙，花路想依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀五岳五首 其五 恒岳","author":"黄省曾","text":"玄岳留青塞，迢遥未得攀。\n虎风吹桂绿，龙月照芝斑。\n棋石春台静，琴空暮岭閒。\n毋禽烦报语，行觅雁门关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠荅学仙一首","author":"黄省曾","text":"鸿术居吴市，云装想翠津。\n欲看楼是玉，须厌宅为尘。\n草异人间药，花非世上春。\n赤松曾授诀，过我问玄真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠尹生一首","author":"黄省曾","text":"尹喜有仙骨，蓬丘生好怀。\n白云看欲举，紫气望将来。\n上草杯霞觅，真图洞日开。\n五千须早诵，浮鹤谢红埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬孙太初过访草堂一首","author":"黄省曾","text":"别业回溪上，孙登野服过。\n山泉交户牖，花鸟带江波。\n白日中园静，清云客席多。\n鸣琴送归棹，閒月在高萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠闾锦衣珍一首","author":"黄省曾","text":"兴御清筵发，心当绿酒豪。\n始逢知骥步，一语见龙韬。\n念国调飞马，看云拭宝刀。\n半酣多战气，失喜挂麟袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重逢方太古有赠一首","author":"黄省曾","text":"旷隔金华彦，劳思茂苑春。\n此逢青眼客，重见白头人。\n德隐丹丘凤，名华赤水麟。\n中林清日月，长与孔郎亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠高山人瀫谈海游一首","author":"黄省曾","text":"以尔神情好，龙波泛舸前。\n一樯标赤日，万里阁青天。\n目急沧溟岸，心摇紫峤仙。\n近山占白鹭，欣把玉杯传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安荅左舜斋一首","author":"黄省曾","text":"我浮长淮棹，君驾太行车。\n红日不辞远，金门来献书。\n绿樽邀叔夜，明月报相如。\n芳草燕台路，欢求意有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安赠苏允吉一首","author":"黄省曾","text":"吴帆挂缅缅，齐马驱悠悠。\n皆抱鸾鹤思，同遵凤凰楼。\n开子一樽酒，破我三年愁。\n欲写玄晖赋，行将雅德酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北极庙逢汾州禅师德舟谈玄一首","author":"黄省曾","text":"芳殿高桐入，青郊秀麦过。\n弥天逢释子，大地语山河。\n花氏王城悟，鹏耆法辨多。\n一灯明石室，金界自为歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山阴陈鹤有七载之别抱痾既瘥来顾草堂惠我绮箑古篇赋此以荅一首","author":"黄省曾","text":"越柳昔悲折，吴樽今喜开。\n扇遗灵月至，诗惠凤珠来。\n黄鹄将心换，丹砂夺鬓回。\n相逢七年外，文酒各频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有好鹤者贻之以诗一首","author":"黄省曾","text":"客有洲居者，飘然鹤与群。\n晓唼侵丹藻，秋飞乱白云。\n杖馀苔径候，琴半月床闻。\n作书虽不解，犹恐是苏君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠隆玺禅师一首","author":"黄省曾","text":"自解无为法，常调鹿苑琴。\n定中酬万用，尘里湛孤心。\n万里无依锡，虚囊不取金。\n须知四真果，应得證于今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠冯隐君一首","author":"黄省曾","text":"历苦遘真诠，求山养大年。\n未成栖福地，常自挈壶天。\n迹市心惟白，龄衰鬓且玄。\n尘嚣吾所厌，对尔意超然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王敬止侍御一首","author":"黄省曾","text":"上国中林老，先朝法从臣。\n道虽藏侧翅，名已播批鳞。\n闭户文章贵，开园花鸟新。\n惟邀贲丘者，芳酒共嘉辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅王将军惠松二首 其一","author":"黄省曾","text":"灵木幽居少，携来四影清。\n苍颜添露径，翠麈落云楹。\n凌岛叶如剪，悬萝条遂轻。\n不须双阙面，新益许由情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅王将军惠松二首 其二","author":"黄省曾","text":"宛似少陵宅，四松三尺强。\n影才低万木，神巳压群芳。\n今日堪摩抚，他时自栋梁。\n清霜任繁集，翠盖拟森张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠方士一首","author":"黄省曾","text":"采药常游国，还丹不计春。\n宝书传海客，黄散济时人。\n玄俗留红市，涪翁寓绿滨。\n三千何日就，挥手拂飙轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠无爱上人自南海来求山栖一首","author":"黄省曾","text":"师也丛林秀，嘉年截爱河。\n无生成般若，不染出娑婆。\n珠性明浮海，云山照宅阿。\n谈玄排二语，高坐未能过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"处州太守张叔载访予西湖山中走笔荅此一首","author":"黄省曾","text":"经始中丘隐，三春在竹林。\n云朝供桂酒，风夕助兰吟。\n佩服搴湖上，糇粮采涧阴。\n殷勤逢五马，宛是昔年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金昌送刘司寇节一首","author":"黄省曾","text":"淮海同杯酒，吴门此再逢。\n虞卿忘相贵，贺监有仙踪。\n江草看前远，烟山别后重。\n还期访岳日，招尔祝融峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻黄宗伯谈平定大同事立赠此篇一首","author":"黄省曾","text":"单马赴边岑，来旬荅圣心。\n赤臣劳按节，青塞慰沾霖。\n镇日开恩色，胡云扫阵阴。\n古言麟阁者，应可嗣芳音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄万民望总戎一首","author":"黄省曾","text":"管密高牙建，参图燧鼓清。\n看花鳷鹊观，散马凤凰城。\n肘后探符秘，天涯念友生。\n金陵有美酒，百斛伫同倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅顾元庆一首","author":"黄省曾","text":"隐尚贪成癖，幽寻爱历奇。\n石门唯岭带，萝室有花披。\n歌好游仙赋，杯清问竹期。\n子真君不愧，谷口慰相于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑启范御史过访草堂一首","author":"黄省曾","text":"佩绣新停盖，藏轮旧仰骢。\n子麟辉薜巷，公雅挹芳风。\n就简飞霜白，随轩吐日红。\n春催天上客，翘首忆台中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读吴子文短赠一首","author":"黄省曾","text":"季重凌云气，为文史汉俦。\n态以千言变，工于一字求。\n款关多学子，拥彗有公侯。\n每尔灵珠握，游扬羡不休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠茅顺甫进士归吴兴一首","author":"黄省曾","text":"羡尔吴兴彦，登庸入紫闉。\n妙才惊国老，青岁冠时人。\n浮玉门闾大，苕溪气象新。\n还携帝城色，归作故乡春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与周子以言一首","author":"黄省曾","text":"世路巳如此，劝君长隐休。\n一箪堪自足，三径复何求。\n奏酒永红日，著书销百忧。\n玄衿淡无慕，真可傲王侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠武进士万民望转漕北上一首","author":"黄省曾","text":"虎帐临沧海，龙韬入大科。\n禁云留拂麈，天月引鸣珂。\n报国孤心急，封侯逸气多。\n班生今老矣，见尔愧如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予慕游五岳久矣程子乃先我登嵩华高篇寄及感而赋之一首","author":"黄省曾","text":"结发思寻岳，君先嵩华游。\n凤笙曾几听，莲壁向何留。\n日得高天照，云看万里流。\n霞篇一披诵，恍倚二峰头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]