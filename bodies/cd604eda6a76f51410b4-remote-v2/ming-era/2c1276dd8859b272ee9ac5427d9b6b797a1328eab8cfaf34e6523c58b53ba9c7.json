[{"title":"于郡城送明卿之江西 其一","author":"李攀龙","text":"江上青山满谪居，还家莫恋武昌鱼。\n君王日下求贤诏，忆尔还开谏猎书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"于郡城送明卿之江西 其三","author":"李攀龙","text":"长安二月绾垂杨，为尔踟蹰五骕骦。\n今日故人投辖地，况逢山色满邢襄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"于郡城送明卿之江西 其四","author":"李攀龙","text":"高斋秋色满西山，梅福当年此抱关。\n君到豫章劳问讯，汉家迁客几人还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郡斋同元美赋得桥字","author":"李攀龙","text":"山色秋停使者轺，孤城何处不萧条。\n请看襄子宫前水，依旧东流豫让桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄伯承","author":"李攀龙","text":"才子含香满玉墀，仙郎赋就几人知。\n只今西省空相忆，扬马风流自一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄茂秦","author":"李攀龙","text":"谁惜虞卿老去贫，平原食客一时新。\n怀中白璧如明月，何处还投按剑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄顺甫","author":"李攀龙","text":"江汉秋风万里生，浮云不见鄂王城。\n于今楚调无人和，忆尔还高白雪情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄余德甫","author":"李攀龙","text":"使者衔恩入楚天，秋风吹动豫章船。\n孤帆遥挂浮云色，西望长江落日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅殿卿","author":"李攀龙","text":"扁舟归去五湖春，愁见红颜掌上新。\n明月自闲歌舞地，秋风憔悴捧心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅元美","author":"李攀龙","text":"萧条鹦鹉赋初成，偃蹇当年一祢生。\n屈指中原馀子尽，非君谁见孔融名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汝思见过林亭 其二","author":"李攀龙","text":"自买南山种秫田，几回留客瓮头眠。\n与君今日拚沈醉，莫笑陶家乏酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五日与殿卿游北渚 其一","author":"李攀龙","text":"青樽画舫㟙湖滨，风俗遥传楚逐臣。\n潦倒只今君自见，那能长作独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五日与殿卿游北渚 其二","author":"李攀龙","text":"五月五日榴花杯，故园故人北渚来。\n君今不饮红颜去，那有长丝系得回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬殿卿长史夏日过饮 其一","author":"李攀龙","text":"萧萧风雨北堂寒，客似高阳复罢官。\n君但能来长夜饮，不妨人作酒徒看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬殿卿长史夏日过饮 其二","author":"李攀龙","text":"故人深愧子云才，风雨茅庐昼不开。\n寂寞已甘车马绝，君今载酒为谁来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬殿卿长史夏日过饮 其三","author":"李攀龙","text":"白云湖上华阳山，那得相看不醉还。\n明日蓬蒿三径没，谁怜长史在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬殿卿长史夏日过饮 其四","author":"李攀龙","text":"美酒新开琥珀光，还堪潦倒故人傍。\n已拚十日平原饮，怪尔能飞五月霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月同殿卿登南山 其一","author":"李攀龙","text":"满天鸿雁雨纷纷，浊酒黄花把向君。\n莫道龙山高会后，风流今少孟参军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月同殿卿登南山 其二","author":"李攀龙","text":"茱萸美酒玉壶殷，此日逢君一醉还。\n愁见孤城秋色里，不知风雨遍空山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月同殿卿登南山 其三","author":"李攀龙","text":"处处登高白发新，年年陶令罢官贫。\n萧条岂少东篱菊，不见当时劝酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月同殿卿登南山 其四","author":"李攀龙","text":"黄花萧瑟雨中寒，摇落东林木叶丹。\n不是故人能载酒，祗今秋色好谁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日东村偶题 其一","author":"李攀龙","text":"西风萧瑟病相如，高枕从他世上疏。\n莫道浮云多变态，还将秋色到茅庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日东村偶题 其二","author":"李攀龙","text":"五柳青青醉里春，那能长作折腰人。\n情知纵酒非生事，昨日罢官今日贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月八日东村送元美","author":"李攀龙","text":"浊酒枯鱼自不贫，黄花况复席边新。\n明朝纵及龙山会，那得长逢落帽人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和荅殿卿冬日招饮田间 其一","author":"李攀龙","text":"白眼风尘一酒卮，吾徒岂足傲当时。\n城中年少空相慕，说着高阳纵不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和荅殿卿冬日招饮田间 其二","author":"李攀龙","text":"白云湖上北风寒，茅屋萧条两鹖冠。\n我自能怜华不注，推窗君试雪中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄慰元美 其一","author":"李攀龙","text":"幕府千山蓟北青，朗陵宾客夜充庭。\n即今无恙荀文若，着膝犹堪当一星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄慰元美 其二","author":"李攀龙","text":"少妇红妆玉箸寒，清秋银烛对阑干。\n无情最是它乡月，不就仙郎掌上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日闻明卿之京为寄","author":"李攀龙","text":"十载浮云傍逐臣，归来不改汉宫春。\n摩挲金马宫门外，谁识当时谏猎人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄怀元美","author":"李攀龙","text":"塞北江南万里长，各天兄弟正相望。\n谁将匹练吴门色，哭作燕山五月霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仲鸣蒲桃","author":"李攀龙","text":"万颗蒲桃照玉盘，西施乳滴露华寒。\n故人更比相如渴，不向金茎夜夜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王中丞破敌辽阳凯歌四章 其一","author":"李攀龙","text":"匈奴十万寇辽阳，汉将飞来入战场。\n直取单于归阙下，论功那更数名王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王中丞破敌辽阳凯歌四章 其二","author":"李攀龙","text":"万里横行大破胡，沙场西北汉军孤。\n不因骠骑能深入，知有阴山瀚海无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王中丞破敌辽阳凯歌四章 其三","author":"李攀龙","text":"再领楼船护海滨，三持节钺扫边尘。\n怪来长得君王宠，自是麒麟阁上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王中丞破敌辽阳凯歌四章 其四","author":"李攀龙","text":"中丞万马下榆关，拂海旌旗破敌还。\n幕府秋阴连杀气，散为风雨暗燕山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为刘伯东题王母图寿太夫人","author":"李攀龙","text":"翩翩五凤五云开，客自金门侍从才。\n六月海东桃又熟，亲随阿母汉宫来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"劳别子与 其一","author":"李攀龙","text":"武林山对海门开，不枉登临酒一杯。\n十载故人零落尽，有谁还为度江来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"劳别子与 其二","author":"李攀龙","text":"马卿元自汉词宗，天子同时叹不逢。\n总为故人邀贵客，故将车马过临邛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张明府见惠榴柿 其一","author":"李攀龙","text":"床头春酒百花香，醉里谁知柿子黄。\n想道故人消渴久，秋来为摘满林霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张明府见惠榴柿 其二","author":"李攀龙","text":"谁遣明珠掌上来，秋风吹笼石榴开。\n若非金谷园中树，定是河阳县里栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅右史问山中与谁把苦","author":"李攀龙","text":"依然浊酒竹林傍，那道穷途便不狂。\n白眼生平君自见，可能容易入山阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"见火齐镫问是右史持入梁","author":"李攀龙","text":"火齐春镫七采装，谁投明月向梁王。\n也知照乘珠犹在，不是先容不敢张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中简许郭 其一","author":"李攀龙","text":"山中酒熟住山中，早晚羊何诣谢公。\n莫道白云终日在，及看秋色向丹枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中简许郭 其二","author":"李攀龙","text":"金牛谷里树苍苍，一入千峰但夕阳。\n浪迹莫愁难问讯，题诗多在朗公房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙曲","author":"李攀龙","text":"一听黄竹写歌钟，人醉秦台十二重。\n琪树花开巢孔雀，瑶池水煖出芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过刘簿山斋","author":"李攀龙","text":"万壑千山入户重，秋来三径少人踪。\n不知君在莲花府，得似芙蓉第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿林泉观","author":"李攀龙","text":"盥漱焚香坐翠微，烟霞犹在芰荷衣。\n怪来不作人间梦，一夜寒泉拂牖飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄谢茂秦","author":"李攀龙","text":"老去长裾满泪痕，秋风又曳向何门。\n可知十载龙阳恨，不道前鱼亦主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东村同殿卿送子坤赴选 其一","author":"李攀龙","text":"青云明日羡翻飞，应念陶家独掩扉。\n君最往还知五柳，何曾送客解依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24738,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东村同殿卿送子坤赴选 其二","author":"李攀龙","text":"短褐怜君又远游，如今白璧好谁酬。\n座中楚客曾三献，才说连城泪已流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24739,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东村同殿卿送子坤赴选 其三","author":"李攀龙","text":"老去看花上苑春，怜君不厌草堂贫。\n预知猿鹤愁无主，更属南怜卧病人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24740,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其一","author":"李攀龙","text":"蓟门城上月婆娑，玉笛谁为出塞歌。\n君自客中听不得，秋风吹落小黄河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24741,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其二","author":"李攀龙","text":"白云何处不漫漫，欲寄绨袍蓟北寒。\n依旧西山秋色里，知君此日转愁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其三","author":"李攀龙","text":"匣里龙泉北斗文，携来燕赵客如云。\n自言此剑千金买，不是穷交不借君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其四","author":"李攀龙","text":"闻道红颜镜里新，还堪客子斗青春。\n秋来纵带风尘色，犹是行吟泽畔人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其五","author":"李攀龙","text":"江南风雨梦扁舟，蓟北燕花傍酒楼。\n无那故人摇落尽，教君何处不悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其六","author":"李攀龙","text":"落魄初看逐客情，风流又似弃繻生。\n路傍年少从他问，不必停车说姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄元美 其七","author":"李攀龙","text":"渔阳烽火暗西山，一片征鸿海上还。\n多少胡笳吹不转，秋光先入蓟门关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重寄元美 其一","author":"李攀龙","text":"十载交游满帝都，五陵年少避呼卢。\n只今惟有张公子，匹马时时过酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重寄元美 其二","author":"李攀龙","text":"南冠君子系京华，秋色伤心广柳车。\n此地由来多侠客，不知谁是鲁朱家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重寄元美 其三","author":"李攀龙","text":"北斗阑干南斗低，啼乌三匝凤城栖。\n万年枝上秋风起，飞入中丞署里啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭子相 其一","author":"李攀龙","text":"故园秋色广陵间，闽海悠悠自不还。\n纵使芜城愁易老，那能长客武夷山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭子相 其二","author":"李攀龙","text":"清秋不尽客依依，梦里闽天挂剑归。\n莫向延平津口度，恐惊风雨二龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭子相 其三","author":"李攀龙","text":"扬子江寒月影孤，秋风吹落射阳湖。\n故人欲洒临江泪，湖上明珠竟有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭子相 其四","author":"李攀龙","text":"大江千里日滔滔，秋色遥看入梦劳。\n莫道故人枚叔少，悲君已厌广陵涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答潘润夫病中见赠 其一","author":"李攀龙","text":"高秋伏枕㟙湖滨，憔悴谁怜似楚臣。\n怪尔红颜青镜里，潘郎本自玉为人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答潘润夫病中见赠 其二","author":"李攀龙","text":"湖上青山对浊醪，故人遥望白云高。\n愁中那得无秋兴，赋就看君已二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"涌泉庵","author":"李攀龙","text":"锦阳川上女僧家，红树萧萧白日斜。\n弟子如云人不见，可怜秋老玉莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王中丞 其一","author":"李攀龙","text":"主恩三遣护三边，骠骑功名破敌年。\n不谓汉军能失利，犹堪起冢象祈连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王中丞 其三","author":"李攀龙","text":"旌旗海上似云屯，大将登坛国士恩。\n白马只今成过隙，千秋匹练曳吴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王中丞 其四","author":"李攀龙","text":"铁马萧萧日色黄，边声杀气满渔阳。\n谁知一夜旌竿折，摇落中丞柏上霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王中丞 其五","author":"李攀龙","text":"三月渔阳大出师，君王按剑捷书迟。\n鼓声不为将军起，岂独封侯是数奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王中丞 其六","author":"李攀龙","text":"莫道江南梦里遥，白杨明日便萧萧。\n门人尽爱伤春句，不拟招魂与大招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王中丞 其七","author":"李攀龙","text":"昨夜烽烟海上青，犹闻麾下取龙庭。\n一时雄剑无精彩，遥指燕山落将星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别元美 其一","author":"李攀龙","text":"北风吹雁雁群呼，泗水西流白日徂。\n不见浮云千里色，知它何处是姑苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别元美 其二","author":"李攀龙","text":"白云愁色满吴门，疋马孤舟不可论。\n一自河梁携手后，至今犹有未销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏赠张茂才 其一","author":"李攀龙","text":"自爱花枝掌上红，蛾眉如月绾春风。\n须知粉黛随时变，多恐张郎画未工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏赠张茂才 其二","author":"李攀龙","text":"张郎新制合欢衾，醉拥红颜烛影深。\n别有洞房双玉妾，吹箫自和白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":24767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]