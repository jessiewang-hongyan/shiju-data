[{"title":"八柏环青","author":"王猷","text":"五桂燕山独擅芳，三槐曾羡晋公堂。\n如何八柏环青翠，寒入郊原色尚苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坞涵春","author":"王猷","text":"寒梅几树傍江隈，香满梢头并腊开。\n遥忆明年春更早，上林须寄一枝回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔矶钓月","author":"王猷","text":"拟向溪头弄晚涛，荔林斜月印江皋。\n矶头未可轻投饵，只合长江钓巨鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玄关镜水","author":"王猷","text":"曾寻真诀叩玄关，动静相忘水镜间。\n满鉴波光澄彻处，坐临清夜不知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星槎晚泛","author":"王猷","text":"晚泛溪头博望舟，银河秋水淡悠悠。\n归来未暇君平卜，知有文光犯斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后二日同诸先达陪谢石渠邑侯龙潭观竞渡","author":"王猷","text":"浴兰出城隅，挂席蟠虬宅。\n以兹鸣琴豫，况值升平乐。\n搴帷开醉颜，四野喜呼跃。\n追随傍凫舄，扁舟疑李郭。\n川广素涛扬，霞光锦帆错。\n龙潭一何奇，水石相喷薄。\n峡峻灵掌擘，岩巉鬼斧凿。\n雾深崖隐蛟，沙碧渚栖鹤。\n伊谁吊沅湘，双龙射日焯。\n夺标卷溟澥，触浪排山岳。\n观者如堵墙，珠帘连绣幕。\n金波映采鹢，玉滟摇青雀。\n歌吟遏行云，箫鼓阗苍漠。\n绢纨既媚好，容冶复熏灼。\n搴芳采芰荷，结佩制荇若。\n绸缪挥兕斝，对酒且吟噱。\n颜酡岸帻高，赋就风云剨。\n良会足千秋，眺望最廖廓。\n冶化洵有象，棠阴愿永托。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪春同唐金颖寅丈省耕郊外同憩清源洞小酌赋此 其一","author":"王猷","text":"干戈犹未起疮痍，又值郊原草绿时。\n官骑偶缘灵雨出，杖藜因爱石泉移。\n平畴风起追秧马，野岫春生战茗旗。\n愿得时和诸讼简，双柑长此听黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪春同唐金颖寅丈省耕郊外同憩清源洞小酌赋此 其二","author":"王猷","text":"曲磴纡回鸟道垂，平临霄汉俯冯夷。\n春游渐觉流莺老，东作频催布谷知。\n欲向云霄生羽翰，且从潭影鉴须眉。\n降心静向仙翁语，欲采山花插一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪春同唐金颖寅丈省耕郊外同憩清源洞小酌赋此 其三","author":"王猷","text":"九十春邀一日閒，与君聊此共跻扳。\n层城睥睨多临海，村落萧条但向山。\n醉墨客书苍壁上，采茶人笑白云閒。\n清商爱听泉声聒，月上丛林未拟还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过建昌陈虚谷明府留酌","author":"王猷","text":"天涯树色似河阳，永夜逢君话故乡。\n性僻向怜多感慨，时危还许共劻勷。\n檐低珠斗催霜月，缸剪银花促客觞。\n潦倒不知归梦远，醒来仍是傍官杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题春日载阳卷寿虚舟邓大参初度","author":"王猷","text":"旭日正晴明，遥天祝颂声。\n孤思先帝许，分部百蛮平。\n曲奏南飞雀，乔迁出谷莺。\n趣装群望切，未便洛英盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬月舟过闽滩 其一","author":"王猷","text":"一叶危滩下，寒流带落霞。\n峰环金谷帐，石浣越溪沙。\n有响云惊阵，无风浪喷花。\n舟轻行独稳，滩险似平沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬月舟过闽滩 其二","author":"王猷","text":"怪石无心险，飞泉得意流。\n湍狂疑捲电，涛怒不惊鸥。\n骨瘦玻璃净，情多曲折浮。\n醉歌时击楫，客况尽夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜南行","author":"王猷","text":"沉云暗浦雨萧萧，黑夜冲泥踏小桥。\n归去恐防前路滑，敲门续火照行镳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠送冯嶰谷出关","author":"王猷","text":"卧龙谁肯老沉吟，万里从戎国士身。\n欲洗英雄埋骨恨，更酬圣主筑坛慇。\n防胡岂藉羁縻策，仗剑期空绝漠氛。\n为语玉门关外将，东南民力竭如焚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过抚州状元岭","author":"王猷","text":"玉皇曾自捡瑶篇，畀汝云中第一仙。\n丹翠晨开常捧日，危峰直撑欲扶天。\n磨崖未受秦朝禅，凿石犹传宋代年。\n搔首凭轩还北望，微茫尚似有狼烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日留别知友","author":"王猷","text":"寒江落叶逐高低，一片孤帆带夕晖。\n遥忆故人清兴在，笔床茶灶可堪携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别怀章玉兰二首 其一","author":"王猷","text":"痴情欲割又徘徊，眉锁巫峰黯不开。\n忽见垂杨遮道送，可堪回首望章台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别怀章玉兰二首 其二","author":"王猷","text":"歌阕阳关唱竹枝，月明千里遏云飞。\n无端忽和将归引，不是王孙也湿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀吕玉枝","author":"王猷","text":"淡淡蛾眉映碧波，双眸无奈别情何。\n裁书怕寄南来雁，恐惹湘云湿更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过潜山哭谏议丁年兄","author":"王猷","text":"清时忽报哲人摧，驻马潜山泪满腮。\n白简未传平虏草，玉楼先召谪仙才。\n谁家吹月三更笛，对此临风一酒杯。\n怅望辽东华表上，何时能得令威回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺词","author":"王猷","text":"几年捣素忆从征，欲到辽西梦不成。\n自是枕寒难得寐，枝头休错怨啼莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲","author":"王猷","text":"望幸君王辇不来，香尘甘自老青苔。\n当时幸有和亲约，得向呼韩笑口开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水舂","author":"王猷","text":"水晶仙子下凡间，曾向滩头弄佩环。\n何处深闺遥借杵，却赢心力整双鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏鸬鹚","author":"王猷","text":"曾辞巢鹤羡江鱼，吞吐由人不自舒。\n却笑生涯随水鸟，低垂甘啖唾残馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海上受降 其一","author":"王猷","text":"白浪兼天春渺茫，降旗一片水云张。\n直凭青帝行新令，便繫长鲸莫跳梁。\n天净帐开悬海月，潮平弓挂在扶桑。\n从今高坐安澜上，快睹朝宗百谷王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海上受降 其二","author":"王猷","text":"蛮烟蜃气一时清，天外恩波霁景生。\n怜尔潢池骄赤子，想堪海国寄干城。\n流云野浦供横槊，落月沧溟照洗兵。\n此日卖刀忙买犊，水田归去及春耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题函谷关图寿外父尹文亭七十一初度","author":"王猷","text":"寥寥宇宙间，咄咄古今裹。\n游者可为纶，飞者可矰矢。\n至若乘风云，犹龙有老子。\n商周几阅代，柱下寄藏史。\n西归为谁来，独为关尹喜。\n将与溟涬游，道德落陈纸。\n上下五千言，字字抉玄秘。\n无名天地根，尔乃是道纪。\n虚心与实腹，剌剌含至理。\n知雄以守雌，涉世混尘滓。\n玄同究旨归，守朴而已矣。\n世衰朴亦散，大道久沦弃。\n纷纷知巧场，窍凿浑沌毁。\n战争蜗角名，攘夺蝇头利。\n嗟哉彼世愚，劳扰何时止。\n焦灼膏火中，长生安可冀。\n如何得长生，试请问李耳。\n此老意云何，不过静者是。\n吾翁尚玄默，不共世俗靡。\n便腹贮大真，冲虑契玄旨。\n与物忘町畦，出口泯臧否。\n息机娱林泉，厌喧避城市。\n岸帻南山云，濯足矶头水。\n客来一杯酒，客去仍隐几。\n醉乡并梦境，此外皆尘秕。\n全生得要术，汗漫托无始。\n人拟葛天民，我曰有道器。\n青牛西去后，黄老恣麈尾。\n无心合道真，千古如翁几。\n倘逢皓发人，关尹若舟起。\n欣睹玳筵开，东来佳气紫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松石图歌寿三爱兄七十又一","author":"王猷","text":"沧田变海蒲柳朽，世间何物可耐久。\n请问千岁绿发叟，叟云看汝古洞口。\n洞前大石高嵯砑，脚下儿孙若拱候。\n寒侵热炙总不知，惟带苔衣几寸厚。\n自来丘壑久寂寥，呼得长松作贞友。\n长松漏雨几十围，牙爪拿天与雪斗。\n大干偃仰鳞甲秃，小枝犹学青蛇走。\n老椿萱荚耻作群，只与此石长相守。\n忆昔女娲炼石补罅天，缘何遗尔落山薮。\n又闻祖龙梁父侈封时，滥职大夫尔何有。\n生公挥麈点尔头，辟谷留侯后尔后。\n石似钝兮松似幽，石安静兮松色秀。\n石产芝兮松有苓，磊砢偃盖真佳偶。\n吾家风植介与贞，坚心劲盾君知否。\n直须劝尔一杯酒，请君移入我图中，吾将持此为兄寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东湖杂诗","author":"陈熙昌","text":"乍浦瀛壖曲，遥连芦沥场。\n迎船桑叶白，系缆菜花黄。\n塔影开初地，钟声落上方。\n孤城非铁瓮，先事慎提防。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹元甫招饮携谢阁同祝孟型","author":"林枝桥","text":"绮阁初开面面屏，疏梧修竹绕檐扃。\n石纹衣露重添皱，山色逢秋一样青。\n奇字翻从载酒识，高歌偏得倚云听。\n却疑楼上临风处，两水双桥接杳冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中望二梁","author":"林枝桥","text":"江心双劈洗云根，水气峰岚并作痕。\n盘处抺空分远黛，望中拔地夹天门。\n沿涯鱼国数家艇，傍麓人烟双树村。\n长堑繇来称险固，兵戈消息易销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"句容道中","author":"林枝桥","text":"一抺林峦雾霭迷，秣陵句曲竞东西。\n峭桥雨滑酸驴石，毁寺堂虚卧象泥。\n翠上染帷胎秫腻，绿纷垂线弱杨齐。\n与人指点茅君路，望裹皈依先杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白纻山作二首 其一","author":"林枝桥","text":"桓公酣宴地，罗绮骄春丛。\n舞态馀回雪，歌声逗结风。\n宾客三千醉，杂沓待鸣钟。\n繁华能几时，转瞬成蒿蓬。\n双鹤阵云寂，丹凤梁月空。\n时时见樵牧，指点认故宫。\n驰景信靡停，秉烛亦已悤。\n寄谢世间人，为乐及从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白纻山作二首 其二","author":"林枝桥","text":"兹山未称高，群阜胡若挹。\n当其歌绕时，云霞四面集。\n响戛忽若低，衣飘复如袭。\n洒酒滴春华，至今芳草湿。\n灼灼芙蓉姿，尚染胭脂汁。\n宾从纷流水，委蛇朱履趿。\n颐指山岳颓，风云惟呼吸。\n不是孟参军，谁能不失色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自姑苏取道吴兴将抵桐汭沿江舟中览眺谩作","author":"林枝桥","text":"亭午发胥门，暮泊宝带桥。\n回首望荒台，风雨何萧萧。\n忽见吴江塔，尖峭入云霄。\n江神鼓浪迅，伏怪谢阴骄。\n村火倏隐见，橹音乍忽超。\n推篷一盱衡，烟光澹晚潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送虞素心省丈奉使江南便道归省","author":"林枝桥","text":"兰省风流清暇多，兴能一石饮无何。\n仪成汉署绵为蕞，驭叱吴山黛送螺。\n长荡湖边春濯柳，清风桥畔雨肥萝。\n只今制作须孙叔，未得贪眠安乐窠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明韩景圭同年招同诸省丈高梁桥游集","author":"林枝桥","text":"绿杨裀草嫩相怜，花暖丝柔入午天。\n临水莫言无荡桨，游缰权作木兰船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟游星岩诗次李长度韵","author":"林枝桥","text":"振衣不觉已嶙峋，缘是崚嶒置此身。\n光发井龙崖角石，旋如磨蚁岭腰人。\n暗中钟鼓传虚响，洞裹烟岚翳早春。\n欲问往来诸桨楫，沥湖无语净铺银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"流霞岛","author":"林枝桥","text":"霞片铄金红，坚顽不可扣。\n流向寒潭侧，左右列门户。\n门户划然开，隐见蕊珠台。\n香炉就石洼，半面蚀藓苔。\n花宫钟鼓响，冷然发遐想。\n两手擘披间，抉破盘古障。\n障裂见天隙，白日众星历。\n影入潭底深，如在昆仑脊。\n惝恍落虚无，来路转模糊。\n东西忽易向，所认石塔孤。\n紫霞君安在，金函发秘盖。\n授我长生文，千秋泛灵海。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"看北海碑","author":"林枝桥","text":"掌故半信疑，图经杳难按。\n龙门积石间，疏凿有崖畔。\n显兹七曜古，谁为斩荒蔓。\n昔在五代初，居圉浑未判。\n贞观及开元，踵接词臣窜。\n每读题壁诗，吊古馀泚汗。\n北海诚天人，独漉掞天翰。\n发挥岩壑幽，顽石点头看。\n向来冗葛藤，居然一刀断。\n如彼老充国，聚米罗前案。\n一览星目境，何翅身陟玩。\n玉韫并珠含，媚艳耀云汉。\n千秋一片石，对语增悽惋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三元阁眺湖荡","author":"林枝桥","text":"茫茫浑显气，天地通水府。\n融结判三元，鸿濛开万古。\n中天郁崔嵬，迥阁栖灵护。\n下临千顷汪，沟塍间斥卤。\n败苇梗弱流，枯菱咽隘窦。\n远见数渔人，冒寒施罩罟。\n亦有小兰桡，倾欹胶浅浦。\n兜底潜蛟虬，横空掠雁鹜。\n窗破风刮面，槛矮仅及股。\n极目海天长，入耳籁号怒。\n悠悠郁孤情，凭虚散八宇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三仙洞","author":"林枝桥","text":"磴道何岧峣，虚堂莽萧瑟。\n上有餐霞人，意閒貌古洗。\n中者腹便便，卸襟带不结。\n或历落嵚崎，支离如自失。\n或佩古青萍，草屦轻袍帻。\n情态虽各殊，总与人寰别。\n道人不洒扫，空砌堆乱甓。\n巧栋閒窜鼠，破帷或走虱。\n岩中诸香火，狞者烂金壁。\n独有古仙真，柴门掩白日。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游石涧不果","author":"林枝桥","text":"迟日莺花风转舒，况兼幽壑迥清虚。\n欣闻似得新名友，想见如看未读书。\n日隘沮洳才一发，肺藏砢礧可千馀。\n谁将巧妒泥游屐，我老还期卜隐居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得牡蛎墙","author":"林枝桥","text":"个个水仙甲，层层叠砌安。\n笼烟银色界，簇粉白旃檀。\n藓积蜂房翠，苔侵鹤翅瘢。\n那堪闺阁夜，斜照月明寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集何文起池园同何卜禧赵弼之二首 其一","author":"林枝桥","text":"近取诸篱壁，从誇在涧阿。\n花殷带榭曲，池旷贮天多。\n石缝斜穿蔓，茶寮低就柯。\n移尊无不可，著处有烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集何文起池园同何卜禧赵弼之二首 其二","author":"林枝桥","text":"历乱钱含菊，累垂金郁柑。\n傍松石选拙，移柽径饶南。\n尽境还施塌，抛区也著龛。\n知君经济意，大略见林潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日同社中诸子泛舟","author":"林枝桥","text":"戒鹢待洄溪，分鸥日未西。\n暑烦宜雨破，潮满觉天低。\n看竹沿江坞，听经到准提。\n停桡问谁子，槐柳与娄齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜书怀次韵","author":"林枝桥","text":"素影俄飘沧海东，瑶台银阙望来空。\n云移欲拭寒呵铙，弦紧疑将乍满弓。\n醉倚疏屏犹怯喘，梦回孤榻忽生风。\n清辉未可私怡悦，水竹参差思不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居","author":"林枝桥","text":"旧篁鞭雨笋才生，疏柳战风梢欲鸣。\n僮懒翻怜雷鼠迹，归村聊得煮鱼羹。\n当阶海鹤驯呼食，近郭山禽狎打更。\n野屋探泉殊不远，支持红叶办茶铛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起四首 其一","author":"林枝桥","text":"儿童啯啯街头哗，线断风鸢挂秃槎。\n好幅深秋新画谱，澹烟疏柳隐寒鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起四首 其二","author":"林枝桥","text":"病来一月倦登楼，楼上青山好在不。\n只恐莲花秋削尽，瘦顽空露小能洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起四首 其三","author":"林枝桥","text":"壁上枯桐久不弹，青山萧瑟水空澜。\n欲寻个裹寒空意，只在稀微秋树间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起四首 其四","author":"林枝桥","text":"黑云一缕起潮门，散作淫霖日夜昏。\n雨掣风掀犹未息，茫茫何处觅山村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与李羽甫索秋海棠漫成二绝 其一","author":"林枝桥","text":"未讶风流俭铁枝，偏嫌荏弱是垂丝。\n零星少许拈秋意，清杀襄阳五字诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与李羽甫索秋海棠漫成二绝 其二","author":"林枝桥","text":"疑紫疑红裛露开，胭脂凌乱著瑶台。\n谁言绰约肌冰雪，不带人间卯酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清浪园访黄君常次壁间韵","author":"林枝桥","text":"韵人风味貌于园，金谷兰亭空复传。\n正好楼台临睥睨，依然淳朴一山川。\n淙淙涧道寒鸣玉，叠叠林鬟翠抹妍。\n柳暗花洲吞剩雨，风回竹坞嫁馀烟。\n中流巧叱初平石，疏脉微通玉女泉。\n衔果鸟王时触槛，听琴鱼阵不惊船。\n亭安岛角疑崩下，桥影湖心似倒悬。\n封径苍茫寻仲蔚，移情萧瑟有成连。\n非因近刹才知梵，讵为安心始习禅。\n深幕有宾真净友，閒亭清课得胜缘。\n云生草树迷鹙浦，水长菰蒲乱鸭田。\n问字但能长载酒，何分清圣浊为贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日早朝","author":"林枝桥","text":"万户氤氲曙色开，九天宫殿肃蓬莱。\n珂迎北阙春风集，笏抱西山日影来。\n周室衣冠瞻洛水，汉家云物望灵台。\n共传问夜劳当宁，不待鸡鸣管簟催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖怀古","author":"陈正蒙","text":"曾随蜀道上青天，万里罗浮更叩玄。\n桂酒酿成堪乐圣，糁□□罢好逃禅。\n半生学士真奇遇，前世德云有夙缘。\n罗带水边山似剑，月明何处挟飞仙。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别平南四景 其一 乌江濯清","author":"林淳","text":"流水桃花绕县城，玉琴弹彻韵偏清。\n旅魂已化南飞雁，谁复悠悠问濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别平南四景 其二 燕石巢云","author":"林淳","text":"石燕何年俯水涯，绿萝深琐暮烟遮。\n乌衣门巷浑无恙，归去天南别有家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]