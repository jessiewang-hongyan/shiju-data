[{"title":"用前韵简聂文蔚大司马","author":"尹台","text":"夏胜初辞汉繫年，冯唐那复宦情牵。\n青霄事业遗经在，白首功名治郡传。\n洛下久閒司马社，山中漫忆介推田。\n雅音寂寞饶新谱，清庙怜公朱瑟弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许元复秀才还吴中","author":"尹台","text":"童稚论交已二毛，相思吴楚隔风涛。\n空怜明月悬珠佩，未向黄尘拭宝刀。\n仲蔚蓬蒿贫岂厌，元龙湖海气称豪。\n此归且理求羊径，莫学扬雄辨字劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉次许宗鲁中允九月二日居庸佛阁同仇将军登宴二首 其一","author":"尹台","text":"绝域烟沙莽白登，凭高风日快虚澄。\n烟烽万里元秦塞，王气千秋自汉陵。\n北伐声威方电迅，西来将士已云蒸。\n危关岌嶪青莲宇，看取三军剑舞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉次许宗鲁中允九月二日居庸佛阁同仇将军登宴二首 其二","author":"尹台","text":"出塞嫖姚紫幕开，中丞玉节此追陪。\n香林合驻名贤履，宝积堪标上将台。\n谷蠡帐依高阙动，桑乾水破大荒来。\n淹留漫听军中乐，矫首狼胥意独回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱太史得使襄藩用闵宿宗伯旧冬韵赠","author":"尹台","text":"岘曲千山簇碧尖，大堤晴柳扑风檐。\n仙槎信有人凌汉，卜肆那无客姓严。\n旧索仍垂堪自慰，长裾往曳亦谁嫌。\n还归若奏东南事，篚贡应言困缟纤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李丈贡金得省","author":"尹台","text":"万里南滇指北燕，驱驰贡篚足风烟。\n黄金叹阻招材日，白发欢承戏綵年。\n归兴浦云生解缆，愁心江草动离弦。\n向来共学人今几，愧我淹栖凤阁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送全太史奉使得省母致寿","author":"尹台","text":"玉节朱旄海曲归，金钿白发倚春晖。\n人间日月开仙帨，天上风云动綵衣。\n甬水春波鱼入馔，燕河夜雨雁于飞。\n文华榜士今无几，莫使鹓行叹久违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宫论王允宁视篆留院用介翁少师韵","author":"尹台","text":"彤垣綵笔绚缤纷，鳌抃鲸吞思不群。\n敢拟怀珠邀汉女，漫陪鼓瑟赋湘君。\n银鱼昼亸秦关日，画鹢春浮济水云。\n此去三山暂延首，虞韶凤鸟定先闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王佐之行人使徽府因便省觐","author":"尹台","text":"玉节西驰指孟津，桃花柳叶炫深春。\n嵩云并引朱旄丽，洛日遥辉綵服新。\n茅鬯缩庭将汉典，桐圭建国感周亲。\n应知蔡仲光前德，不负天王大训陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢茂秦","author":"尹台","text":"禁柳疏阴澹晓晖，青春其奈送将归。\n烟尘近访黄龙塞，云海仍思白鸟矶。\n壮迹诗篇聊自纪，豪情杯酒向谁挥。\n也知天地伤多事，肯信扁舟易息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王侍御赴南台因便还省","author":"尹台","text":"尔家旧傍郢中台，二父声华动斗台。\n岁月独惭元礼士，云霄向识仲容才。\n花明滹北丝骢出，草绿湘西绣斧回。\n四海风尘惊在目，公车皂牍几时开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初晴用韵答康莆田","author":"尹台","text":"袅袅晴云天际还，初秋物意倍相关。\n疏青自映高低陌，湿翠浑流远近山。\n久客欲归难引兴，深愁对此暂开颜。\n虚帘把酒吟佳句，更觉羁情易破悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太宰唐公哀词","author":"尹台","text":"汉阁麒麟思画日，萧关虎豹慕威年。\n持衡四海方逢圣，抱疾三春忽问仙。\n国论喜伸忠彦疏，家声应振敬夫贤。\n扁舟细雨南归夕，怅望风神瀔水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送全太史告省得归","author":"尹台","text":"海甸犹飞格斗尘，河关南望渺伤神。\n虚传井邑青烽暗，苦忆庭帏白发新。\n此去萱花欢献綵，莫攀桂树想藏身。\n龙沙雁塞方多事，倚剑须思叱驭人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送都谏姜公赴广东参政","author":"尹台","text":"十年旧直侍龙光，万里新麾动鸟章。\n南海元开秦尉宅，曲江旧绕相君堂。\n青山览古迹堪问，碧草怀贤思不忘。\n遥想旬宣停赤驷，应传丽句遍遐荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吕太史侍亲还桂林","author":"尹台","text":"华省仙裾此暂分，重闱綵服曳烟氛。\n相将杖履随黄叶，宁复川原感白云。\n计日湘鱼供美馔，何时衡雁寄高文。\n南归我动九疑兴，早晚招君鸾鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大巡吴公赴江西","author":"尹台","text":"银鞍骢马紫缨垂，赋别还同把玉卮。\n法从今朝辞日驭，使华若处驻霜麾。\n西江天净鱼龙水，南浦风凋鸟鹊枝。\n此去阳君随绣斧，应知白屋少颦眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴都阃赴浙镇","author":"尹台","text":"将军才气振江东，虎竹新分向越中。\n组练乍明湖岸月，旌旗先掣海门风。\n旧都自识仪文盛，大镇今看节制雄。\n见说鲸鱼犹跋海，须君一建伏波功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴太史奉使代藩","author":"尹台","text":"玉节金函出塞垣，朱衣白鸟照边村。\n云中吏拜孤峰驿，雪外人迎古碛屯。\n汉代河山新典册，周家盘石旧宗藩。\n归朝伫听汾阴赋，莫学枚生吟兔园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴西张太史使江藩","author":"尹台","text":"京国论交几过从，郊筵惜别奈残冬。\n冲寒裘马今朝发，献岁莺花若处逢。\n桐叶剪圭周建爵，菁茅分社汉传封。\n归将锦节停乡邑，玉笥高开紫雾重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨太安人寿词","author":"尹台","text":"华发金钿相映清，仙闱綵服拜长生。\n蜀中自昔称尧叟，洛下于今识彦明。\n向日萱花能媚晚，经冬桂树独含荣。\n霜丛满院吟慈竹，并作缑笙引凤声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仪真送欧君之任粤中","author":"尹台","text":"扬子津头白水波，送君其奈旅愁何。\n三春泽国怀归思，万里江楼听别歌。\n青草瘴阴迷合浦，黄梅雨气接牂牁。\n相将并棹重难得，目极天南云雾多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登庐山天池寺","author":"尹台","text":"匡庐秀出九江水，揽结天池翠几重。\n万壑云开青锦绣，千峰日照紫芙蓉。\n危林袅雾晴兼合，飞瀑垂虹断忽逢。\n北望长安忻在目，朝氛莫遣蔽高舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"佛手岩","author":"尹台","text":"佛手奇岩俯窈微，长江云浪漭相围。\n石危讶有高僧住，松老能招独鹤归。\n槲叶鸣随龛庆发，藤花飘逐乳泉飞。\n茅庵绝壁无人见，忽听林间启竹扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕子矶","author":"尹台","text":"燕子危矶俯帝城，高秋携眺独含情。\n云中双阙苍龙隐，天际孤洲白鸟明。\n放浪吾生元水石，栖迟微宦漫簪缨。\n忻逢胜地同淹赏，灯火归舆夜柝鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音岩寺阁","author":"尹台","text":"危岩曲磴袅云端，峻阁穹林互郁盘。\n寺暝虎闻啼绝壁，江晴蛟出舞回湍。\n群公燕暇聊今集，四海登临此壮观。\n忽忆天兵南伐日，舟师几出定波澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿徐东园锦衣七十","author":"尹台","text":"异姓王孙今代闻，风期千古信陵君。\n神仙第宅元霄汉，宾从笙歌自水云。\n种竹凤台留客看，买山燕渚与僧分。\n斲轮岁月从今数，赤篆长开蕊箓文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自大茅宫入上下二宫缅然有怀仙之感书似句樊令及文学胡子","author":"尹台","text":"大茅西下华阳路，石磴幽花好自开。\n令尹青牛何处觅，仙人白鹄几时来。\n星文半夜垂银阙，云气中天捧玉台。\n千古骑龙谣独忆，欲从沧海问蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒唐太史应德陈桥庄二首 其一","author":"尹台","text":"一入陈桥棹即迷，深源何异武陵溪。\n支离未厌壶丘病，寂寞仍耽颍水栖。\n旧剑床头长缑蒯，新书案侧欲嘘藜。\n微言更及玄筌理，不记参横晚日西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒唐太史应德陈桥庄二首 其二","author":"尹台","text":"几岁风尘海甸昏，如公那得独衡门。\n焚鱼学士迹空秘，衣白山人礼自尊。\n桂树攀援聊赋隐，桃花开落竟忘言。\n英雄出处元无定，不见南阳与渭村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辱应德枉答用韵再赠二首 其一","author":"尹台","text":"十年学道与方迷，退守真惭老氏溪。\n下士谁抽青笈秘，高贤久作碧山栖。\n三江采秀常舟楫，五岳寻仙独杖藜。\n强托著书能暂许，五千文字定传西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辱应德枉答用韵再赠二首 其二","author":"尹台","text":"妖鲵吹浪海沙昏，蜃浦摇氛暗国门。\n白面书生谁解武，绿林群盗故称尊。\n握奇自识才元辨，抱灌终知寂不言。\n豺虎纵横纷在目，可容閒卧碧云村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮南九日有怀寄宝应廖明府","author":"尹台","text":"九日淮南繫客舟，无边云雾蔽沧洲。\n万方多难孤尊对，千里辞家一剑留。\n木叶漫惊公子思，菊花聊慰旅人愁。\n长吟忽忆神仙令，目极飞凫天际头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴馆长督学湖南","author":"尹台","text":"玉节东驰向楚围，南州衿佩早知依。\n洞庭春浪鱼龙变，衡岳朝阳凤鸟归。\n此去皋比烦指授，即看绣斧动光辉。\n词才旧擅相如丽，莫向梁园赋雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘集湖出倅广平","author":"尹台","text":"柳色微黄映客衣，长安雪后见春晖。\n欲辞旧馆鸿先至，正别新年燕忽归。\n故里经心那送远，芳郊对酒怅相违。\n卢龙近在邦畿内，合有声华动帝闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大司马聂先生辞政南归用少师相公韵二首 其一","author":"尹台","text":"二十年来大司马，几人得上乞休书。\n寇公许国心元壮，范老忧时计未疏。\n紫阁星辰辞听履，青原花竹引归舆。\n冥鸿浩荡终难慕，目极江湖思渺予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大司马聂先生辞政南归用少师相公韵二首 其二","author":"尹台","text":"抱瓮从来恶说机，握韬今换钓纶归。\n功成不叹身难退，道在宁论事屡违。\n天上心閒云鸟阵，山中梦近薜萝衣。\n谁怜华省孤吟客，独倚西楼看少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱象元司业赴南雍","author":"尹台","text":"槐风麦雨飐新波，三月楼船放玉河。\n南极星辰迎佩近，旧京桃李在门多。\n云开钟阜围青锦，天静玄湖湛碧罗。\n欲赋重游那可复，羡君环佩到烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送费符卿奉使荆藩","author":"尹台","text":"十年符省侍君王，几曳银绯到旧乡。\n玉节近承丹凤诏，金函更拜紫鸾章。\n三湘夏过黄梅雨，七泽秋迎碧菼霜。\n莫待梁园飞雪度，好驰星驷报明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"砺峰公之陟南礼侍也余在金陵日引跂然迄左一觏兹余改北雍公入觐得觏无几复别去不能无慨然于中者作诗叙往用抒积思云耳","author":"尹台","text":"久矣金扉载笔从，每嗟词赋擅雍容。\n那摇北固烟中旆，仍别西清雨外钟。\n柳曲樽罍经岁忆，花边笑语几时逢。\n蓬莱出入神仙地，目极天南綵雾重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秋官刘大夫赴常德太守","author":"尹台","text":"五马长鸣碧柳烟，武陵春色画轺前。\n青山露冕迎花入，白水飞旌映树悬。\n少日鹿苹联省席，清朝鱼藻并宫筵。\n论思虚薄惭何补，紫绶相看华发年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万太宜人七十寿诗","author":"尹台","text":"华发金钿映晚晖，自天纶诰下重闱。\n悬知赤绂牵新梦，不奈斑衣阻独归。\n七十宴开青雀至，八千路绕白云飞。\n题诗寄祝庭萱寿，瑞婺光芒动紫微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈太史奉使淮藩便觐","author":"尹台","text":"龙函宠锡贲宫袍，凤藻亲题白玉毫。\n自识沂公怀素志，由来秦国望先朝。\n晓云庐岳观飞瀑，夜雨湓城听落潮。\n归拜锦堂承綵觐，高车不羡蜀都桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送亢太史提学河南","author":"尹台","text":"法垣华耀吐文昌，斧节今辞白玉堂。\n嵩少风云生气色，洛瀍草木动辉光。\n新衔薄试儒文效，旧局同推史学长。\n本是紫皇香案吏，仙裾伫曳御炉傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万太史奉使唐藩便觐","author":"尹台","text":"太宰高风振盛朝，羽毛羡尔接青霄。\n通家谊厚怜交久，并署情亲惜别遥。\n桐叶剪圭将去节，薇花照馆迟归旄。\n过庭正及江鱼美，捧馈应纾孝思劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送兴化李太史奉使衡藩便省","author":"尹台","text":"省元昨占西江盛，馆职今分东观荣。\n独捧金函辞禁籞，遥将玉节下仙城。\n帏褰海岱晴云度，旆指徐淮暑雨清。\n圣主恩深不可及，莫吟黄叶滞秋程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月二十七夜同年宴集内射所酒阑步东台观月慨谈往昔愀然兴感赵文属倡句不揣敬呈郢削","author":"尹台","text":"二十年前旧月明，长安杯酒此同倾。\n星河影动高秋兴，弦管音传少日情。\n四海声华前辈老，几人功业后时名。\n酒阑忽感英雄事，却忆终生曾借缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宗媪谭孺人六十","author":"尹台","text":"云阳佳气动江乡，宝婺星辉映北堂。\n竞喜萱丛开晚色，更看兰叶袅华光。\n湘娥色应金飙转，缑女箫流綵雾长。\n试问瑶池宴阿母，鹤钿今数几茎霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自彭城入沛书感录似张元敬水部并寄周允文提学","author":"尹台","text":"余帆北指沛公乡，矫首彭城在夕阳。\n击筑久无秦子弟，歌风今有汉篇章。\n千年往事河山改，万里秋归草木苍。\n井邑萧条徒极目，可堪赤甸比遐荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿童太夫人六十","author":"尹台","text":"南国朱萱开锦席，仙郎遥动白云思。\n东征几读曹家赋，上寿先函鲁颂辞。\n捧日金芝含晚秀，倚风玉树发新枝。\n莫言莱綵违千里，展觐行将鸾轴随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄子元东归诗","author":"尹台","text":"童稚情亲竹马前，心期暗许合龙泉。\n烟波一别三千里，云海相思四十年。\n往事真成伤白首，清歌聊为解朱弦。\n即将挂绂寻仙侣，定拟逢君雁荡边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同大司马张公少宗伯康公少司马石公振武营宴集二首 其一","author":"尹台","text":"振武新营禁苑开，河山佳气动蓬莱。\n洛中幸见周王制，江左谁当谢傅才。\n风定荷香浮几席，雨晴竹色净樽罍。\n百年胜会应难数，剑舞淹留未拟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同大司马张公少宗伯康公少司马石公振武营宴集二首 其二","author":"尹台","text":"幕府亭偏暑气微，帝郊云物淡晴晖。\n虹边雨过秋阴断，鸟外烟横霁色归。\n岁月虚惊诸葛阵，风尘久化士衡衣。\n何时海上停征檄，白羽青林得自挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱封君双寿诗","author":"尹台","text":"白发蕲川二老人，绮筵开对玉台春。\n赤桃东熟初成献，青雀西飞讶有神。\n华露暗滋孟宅竹，古烟长映窦庭椿。\n紫泥天上颁非远，綵服行将鸾轴新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林太常考绩北上","author":"尹台","text":"南省清卿羽旆驰，功书名奏九重知。\n惊看去驿梅花发，想及归轺柳叶垂。\n仍世史藏司马记，名都赋载左思词。\n文华选士今无几，汉阁图勋重尔期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨南郛太史自金陵将之句容诗以送之","author":"尹台","text":"二十年前旧馆僚，风尘鸾鹤见高标。\n翛然句曲山中往，径赴华阳洞里招。\n谢客三江忻独泛，尚生五岳讵辞劳。\n应逢此地餐霞侣，共和骑龙白日遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠和杨太史用孙宗伯韵","author":"尹台","text":"昔年曾谒大茅君，清梦长依白鹄群。\n此去缑笙霞外待，相将剡棹雪中分。\n汳泉碧草生春雨，建业青山隔暮云。\n为恨相思不相见，因风好遣尺书闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜酌南郛太史辱以诗赠次答","author":"尹台","text":"白首中朝岁月深，滥陪簪履在词林。\n许身敢比卞和璧，竞世羞怀季子金。\n裘马故人劳问讯，风尘老鬓对萧森。\n青灯漫尽十年话，旧事樽前不费寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀大茅道室因南郛往谒寓讯","author":"尹台","text":"忆昔南游访道群，几升元界拜元君。\n鼎窥未煮丹铅药，笥阅无名蝌蚪文。\n服气青芝长不厌，礼星玄鹤每先闻。\n茅龙欲借难成许，空留华阳一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答方湛一","author":"尹台","text":"海内吾当愚者兄，元潭一笑得平生。\n六经谁作片言了，万古汝留双眼明。\n此去风尘弹赵铗，须倾江汉洗吴兵。\n干时学道随能事，我信安期不世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未元日","author":"尹台","text":"旧京冠佩集仙扉，曙色先流簇仗辉。\n四纪升平看舞鼚，九重端拱坐垂衣。\n椒花颂献宫门远，柏叶尊传禁省违。\n敢以周南留滞惜，但歌宵雅祝皇闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少东锦衣灯会病不及赴次孙宗伯韵二首 其一","author":"尹台","text":"信陵公子夜开堂，宴客张灯水槛傍。\n自放梅风入绮户，仍邀竹月下银塘。\n花边锦炬参差影，树里星毬点缀光。\n却笑病愁难料理，卧怜箫鼓竞更长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]