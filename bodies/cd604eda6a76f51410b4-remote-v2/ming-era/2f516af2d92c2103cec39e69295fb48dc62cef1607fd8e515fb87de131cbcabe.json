[{"title":"西河","author":"尹台","text":"西河日夜羽书驰，直北风烟尽虏陲。\n列校岂屯秦斥隧，诸边虚绕汉旌旗。\n休思骠骑封狼日，恐逼单于祭马时。\n闻道凶门推毂少，翩翩纨裤拥新麾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任太夫人寿诗","author":"尹台","text":"谏议昔归奉綵舆，起居今得傍承庐。\n金钿白发行相映，玉衱朱衣座不虚。\n帨引萱丛回献舞，杯含婺彩散门除。\n寒萝亦有长年蔓，欲比贞松故不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄材伯学士赴南院","author":"尹台","text":"太史新悬学士鱼，鳌宫南入是仙壶。\n閒牵锦缆白门去，绝胜金珂紫阁趋。\n季子物情周列国，左思词赋盛三都。\n亦知静理经纶业，定有奇猷翊帝谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿钱御医六十","author":"尹台","text":"黄扉通籍自何年，圣济宫中鹤发仙。\n簪绂行藏逢六十，刀圭功力过三千。\n山中橘树侵云长，海上桃花炫日鲜。\n知望燕山思綵服，莫停吴泽滞牙船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱丈出谳四川","author":"尹台","text":"乍看按狱钱塘郡，又见详刑汉竹城。\n吟草几拥湖月白，法文今动蜀星明。\n春馀剑阁花应少，雨过瞿唐峡尽平。\n皇泽只今周绝域，可令冤讼有缇萦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居西巷次宗弟员外德卿","author":"尹台","text":"绮阁朱楼烂九衢，门开曲巷自回纡。\n短椽聊足此中寄，广厦能忘天下须。\n玩世漫依金闼隐，懒朝真怯玉墀趋。\n他年倘使元文就，别觅扬雄宅一区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆俨山学士南归","author":"尹台","text":"鳌禁儒仙尚黑头，疏承恩许赋沧州。\n旧林白鹤应相待，幽谷黄鹂得并求。\n紫阁讲筵悬凤幄，青宫宾闼罢龙楼。\n此行暂别蓬莱苑，还访扶桑万里秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿溶溪刘公六十","author":"尹台","text":"溶水东流双浦深，溪山几曲称幽寻。\n从教六纪阶蓂变，不废三秋篱菊吟。\n早试青囊留笥记，晚遗缥帙薄籯金。\n悬知绕席班衣舞，清宴长开锦树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日偕甘文学懋献游洞辱诗次韵并申后约","author":"尹台","text":"冬日洞门引兴长，瑶华忽捧快余望。\n圈中自识无遗画，删后谁知有剩章。\n洛社烟花还旧约，舞雩童冠况成行。\n铿然舍瑟前贤事，此意春风未可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题白鹰","author":"尹台","text":"玉刷清秋迥，雪翻碧海孤。\n无因击大野，仄立动愁湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖次韵二首 其一","author":"尹台","text":"四月过新雨，西湖罗绮春。\n荷花娇绿水，妒杀采莲人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖次韵二首 其二","author":"尹台","text":"歌筵长白日，舞袖亦青春。\n试看西湖上，能游有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"开云楼望岳","author":"尹台","text":"熙阳含景丽，积雨散层阴。\n因忆开云日，悠然思古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大湖北山四亭题句 其一","author":"尹台","text":"黝然一潭碧，对此澹若空。\n物象从生灭，泓涵自不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大湖北山四亭题句 其二","author":"尹台","text":"孤亭接混茫，高睨众象表。\n不以登高独，焉知视下小。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大湖北山四亭题句 其三","author":"尹台","text":"半壁倚嶙峋，下俯幽潭色。\n潭色与壁阴，渟洄不可极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大湖北山四亭题句 其四","author":"尹台","text":"万木互阴森，幽泉细迸泻。\n借问亭坐人，何如驭风者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕梁歌二首 其一","author":"尹台","text":"悬水掀风起白波，吕梁险势其如何。\n长鲸怒跋三门石，贱妾劝君无渡河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕梁歌二首 其二","author":"尹台","text":"万里河流九曲奔，飞湍千尺下龙门。\n等閒人心不似此，白日雷涛暗处翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词四首题陈侯东华送别图 其一","author":"尹台","text":"东华晓日照江楼，冠盖云屯拥画舟。\n借问南阳诸父老，谁能挽取旧岑侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词四首题陈侯东华送别图 其二","author":"尹台","text":"蓼花新涨动孤城，千尺虹梁截岸横。\n欲系仙帆无那远，中流箫鼓望双旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词四首题陈侯东华送别图 其三","author":"尹台","text":"三年为政似君无，人道莱芜釜有鱼。\n留得家携青色犊，升朝自驾旧来车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词四首题陈侯东华送别图 其四","author":"尹台","text":"竹枝词和古桐乡，去思浑牵江水长。\n遥忆东华松独倚，残株犹足比甘棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"光山逢刘致卿副使因忆其兄太守二绝句 其一","author":"尹台","text":"十年芳草惜离群，海上朱幡忆暮云。\n何意归轩停楚泽，万山黄叶独逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"光山逢刘致卿副使因忆其兄太守二绝句 其二","author":"尹台","text":"双垂紫绶绾专城，人羡君家好弟兄。\n借问霜飞今夜斧，有无池草梦中生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虞塘晓发二首 其一","author":"尹台","text":"绝岭朝霾云气霏，日高林际始含晖。\n层萝窈窕闻鸡犬，知有人家在翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虞塘晓发二首 其二","author":"尹台","text":"径石杈枒走乱流，颠敧古木亦相樛。\n危峰仄叠几千转，缥缈惟看白雾浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行四绝之一","author":"尹台","text":"秋花映路开无数，可爱深红间白枝。\n不听疏林黄叶坠，风光浑道是春时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归兴二首用少宰张文邦先生韵 其一","author":"尹台","text":"招隐漫怀南国士，移文应笑北山群。\n乡心千里惊黄叶，客梦三秋动白云。\n不奈鹡鸰天际急，可禁蟋蟀雨中闻。\n江鱼向晚堪垂钓，玉鲙何时入馔分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归兴二首用少宰张文邦先生韵 其二","author":"尹台","text":"薄伎谬承金马诏，虚名敢厕玉堂群。\n鞲鹰仄目空绦縼，野鹤深巢但水云。\n有客孤桐谁共理，故人尺素阻相闻。\n并飞亦是随阳侣，霄汉那言羽翼分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀用前韵二首 其一","author":"尹台","text":"久狎山中猿鹤伴，翻猜池上凤鸾群。\n蓬莱晚照流仙气，碣石秋阴动朔云。\n白璧招贤成往叹，黄金好士只空闻。\n岁残兰芷能无变，霜露留夷恐不分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀用前韵二首 其二","author":"尹台","text":"忆昨名山窥阴绝，霞情雾思邈仙群。\n金房暗想丹床火，玉笈虚霾石阁云。\n缑曲鸾骖违夙许，辽西鹤使断今闻。\n岩扉岳户何曾闭，咫尺烟霄路莫分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张通政归吴中","author":"尹台","text":"牙绯暂罢银台入，绣匦谁将玉墄陈。\n范老江湖应独念，谢公山水转须亲。\n辞秋旅燕惊逢主，背冻高鸿解趁人。\n此去知多张翰兴，鲈鱼莫遣滞纁轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次汶河水部李古容君枉访因招集池亭有作","author":"尹台","text":"钜野冬寒独客舟，霜天乌几对长洲。\n忻承水部高轩过，忽为池亭竟日留。\n江海喜通秦职贡，烟霞归问楚林丘。\n丈人才力原兼济，宴笑知怀天下忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵柬应参政二首 其一","author":"尹台","text":"十月风霜在客舟，沙鸥犹戏水中洲。\n渐看洛下贤人起，敢恨周南太史留。\n今日朝廷谁四岳，野人巾履只孤丘。\n甘棠况荫江藩地，折羽宁怀弱鸟忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵柬应参政二首 其二","author":"尹台","text":"客路相将济水舟，蒹葭杨柳亦汀洲。\n翛然剡曲孤航对，何羡山阳累日留。\n性僻常怀高士社，兴豪欲访羽人丘。\n须公事业酬明主，共拟长吟消百忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事叠韵复答二章 其一","author":"尹台","text":"海内谁当济巨舟，十年君赋白蘋洲。\n谢公端为苍生起，裴相休言绿野留。\n河朔未归唐斥堠，烟沙犹蔽汉原丘。\n龙翔虎跃须今日，汗马能忘西北忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事叠韵复答二章 其二","author":"尹台","text":"甲士今归横楫舟，南交珠翠走炎洲。\n谁悲野哭千家是，突纵天骄万骑留。\n月黑青燐摇断碛，沙寒白骨挂荒丘。\n愿提壮士从公起，为挽天河洗国忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衡岳高年卷寿李给事珊祖八十","author":"尹台","text":"白发苍颜混紫冥，芙蓉天柱玩葱青。\n几看日月悬芝巘，长啸烟霞动草亭。\n岳侧合题高士社，天南宜应老人星。\n古今八十元称少，况见闻孙扬帝庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨出钱塘张缮部持酒邀别有作","author":"尹台","text":"黯黯冬云愁不开，霏霏暮雨急相回。\n天寒雁趁沙边宿，岁晚人从海上来。\n去国虞卿仍独往，忧时刘向秪空哀。\n因停水驿南归棹，聊醉沙村草阁梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浙行台山石红梅甚奇酒中赋呈蒙泉","author":"尹台","text":"太湖奇石紫杈枒，屈纽红梅万萼花。\n香扑冻帘浑舞雪，气烘晴院欲蒸霞。\n高唐神女酣丹幄，洛浦仙妃倚绛纱。\n便与暖云成异锦，共君裁赋颂春华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬寅元日舟中作","author":"尹台","text":"文昌宫观郁天盘，鳌署仙扉切禁銮。\n三十入承金马诏，追趋常傍玉螭阑。\n投簪霄汉去朝远，倚剑江湖行路难。\n忽忆正朝冠佩集，侧身长望五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何太守招游青原病辞不赴有作","author":"尹台","text":"一宿青原五岁华，珠林遥望邈川霞。\n山中寒桂应千尺，石上古藤今几花。\n拟向空门遗世想，还将净业寄禅家。\n熊轓枉沐招邀使，惭对秋云滞短槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白坡太守秋日招同诸君子游青原山寺用壁间韵二首 其一","author":"尹台","text":"病客新秋一破颜，秪园名刹旧青山。\n古池云定佛心住，幽谷鸟鸣人意关。\n长拟鹿裘安草卧，讵期熊轼对荆班。\n微吟醉倚林端阁，指点江湖千里间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白坡太守秋日招同诸君子游青原山寺用壁间韵二首 其二","author":"尹台","text":"矫首风尘暂息颜，出城车马动秋山。\n短桥明月底须待，虚谷白云殊未关。\n杖策每怀招隐士，投簪何意梦朝班。\n漫陪五马娱今宴，留咏青原曲水间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艾陵沈侯夙有里南石洞之约许行日践之诗以代招","author":"尹台","text":"一鹤仙亭久著名，双凫汉殿报长征。\n沙村车马得无竞，石洞烟霞空复情。\n背壁丹芝含晚媚，入山瑶草发冬荣。\n洪涛锦席飞千里，转眺诸峰邈紫清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日登虎塘诸山用韵答莲坪先生二首 其一","author":"尹台","text":"暖日千家散綵云，尚思仙岳访元君。\n未忘黄绶山中约，先遣苍衣谷口闻。\n司马豪游怜独阻，仲长幽计许谁分。\n石田茅屋堪相老，矫首同观天地文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日登虎塘诸山用韵答莲坪先生二首 其二","author":"尹台","text":"拄杖今朝弄白云，何如春雨吊湘君。\n山居疑有秦民避，林卧曾无蜀士闻。\n锦石寒花寻共得，瓦盆浊酒兴能分。\n他年倘定扬雄宅，不撰玄家九数文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠都阃督漕北征","author":"尹台","text":"旧帐江城虎旅分，新符水饷飒千军。\n旌旗自动鱼龙影，部曲元知蛇鸟文。\n海内谁纡刘相计，关中吾忆耿公勋。\n楼船将士江淮集，羡尔才猷独不群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷日观小园梅竹次彭秀才庠二首 其一","author":"尹台","text":"试探园林春几许，酷怜梅蕊故先知。\n看临小阁遥思汝，折向寒篱欲寄谁。\n天远微吟聊独狎，雨残香梦亦多时。\n未忘水部扬州兴，苦忆仙郎回凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷日观小园梅竹次彭秀才庠二首 其二","author":"尹台","text":"数竹经冬青不乱，高枝自可宿鸾凰。\n那无求仲同幽径，喜有王猷共野堂。\n翠袖天寒愁自倚，黄陵道远怅谁将。\n七贤六逸豪游地，矫首长云思杳茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伯兄以首春次文学彭君庠三诗垂示敬和志感 其一","author":"尹台","text":"脉脉春檐细雨声，病馀何意讯椒罂。\n梦回池草诗先报，思入荆花眼倍明。\n调比古弦谐怨适，音同哀玉扣幽清。\n弹冠未胜吹篪乐，知耻吾能后薛彭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伯兄以首春次文学彭君庠三诗垂示敬和志感 其二","author":"尹台","text":"阊阖祥云万里开，蓬莱佳气九天回。\n烟花苑陌莺应至，冰雪关河雁几来。\n忆在汉宫陪法辇，并持春酒献天杯。\n沧江一卧惊多岁，怅望文昌接上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伯兄以首春次文学彭君庠三诗垂示敬和志感 其三","author":"尹台","text":"久谢朝簪栖野径，漫携藜杖立江楼。\n虚无烟雨愁中合，想像湖山意外浮。\n幸有棣花得相媚，那无萱草为忘忧。\n春原痛洒松楸泪，霜发晨梳忽半头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王丰城惠顾山中作","author":"尹台","text":"卧病沧江空复春，久将名姓混垂纶。\n山中泉石无新侣，天上风云有故人。\n岂意特烦青雀舫，萧然远访白菟巾。\n匡扶帝业须君辈，歌咏终归畎亩臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次答一山宗胄见寄之作","author":"尹台","text":"经年谁扣草玄庐，州部阴阳信卷舒。\n风暖槛花粘鸟?，雨晴阶藓蚀虫书。\n疏狂阮籍谁能那，简傲嵇康故不除。\n桂树山中攀易得，王孙招隐意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孔怀楼为徐草窗作","author":"尹台","text":"倚楼谁抱角弓悲，老去元方鬓已丝。\n梦草青春成往事，看云白日亦多时。\n荆花历历垂新影，棣萼离离偃故枝。\n肠断鹡鸰偏作意，孤飞背立水烟湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居二首 其一","author":"尹台","text":"鸬鹚溪水接通津，野屋萧疏未厌贫。\n风暖柳条浑弄色，雨晴花蕊不经春。\n何嫌近宅无三径，自喜端居少四邻。\n玩世幸容臣朔隐，底须陛楯老风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居二首 其二","author":"尹台","text":"新成草阁称幽居，况有流泉溢暗渠。\n网客青虫能狎客，钩帘黄鸟解窥书。\n南山扣角歌堪放，北阙悬珂梦已疏。\n独忆美人蓬岛隔，无由江海讯双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗宫赞达夫惠寄移居之作次答四首 其一","author":"尹台","text":"一丘暂遂中林卧，数亩还成僻地居。\n可爱泉声流户近，时看云气动窗虚。\n川原栗里怜相似，风俗鹿门叹未如。\n庞老陶公今寂寞，拟将身事寄农书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗宫赞达夫惠寄移居之作次答四首 其二","author":"尹台","text":"久辞禁籍寻耕陇，莫问仙闱锁秘居。\n独抱遗经惭究始，有怀往代恐成虚。\n并飞野鹳元相引，数至浮鸥底自如。\n人意且忻谐物性，未妨终日偃琴书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗宫赞达夫惠寄移居之作次答四首 其三","author":"尹台","text":"古道欲追谁可访，今生长恨不同居。\n烟云莲洞青春静，花鸟桐皋白日虚。\n晚接襟怀知茂叔，早惭词赋慕相如。\n向披尺素传云鲤，闭户曾闻息著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗宫赞达夫惠寄移居之作次答四首 其四","author":"尹台","text":"已谢荣名甘草茹，真成幽迹抗林居。\n御风列子泠然善，隐几南綦㗳尔虚。\n秪笑儒流遗自性，竟从禅谛觅真如。\n玄珠象罔迷求索，始悟斲轮欲弃书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西昌别陈子虚符卿","author":"尹台","text":"肝胆平生问几投，夫君高谊故无俦。\n堪怜紫阁同归日，竟混青门大隐流。\n身世风尘双短剑，行藏江海一虚舟。\n时清凤鸟嗟罗罻，白发商歌起远愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈子虚少卿刘虞让大尹送余庐陵志别","author":"尹台","text":"长川急雨下轻舟，烟草离离自唤愁。\n托契漫怜年少日，论交常向古人求。\n陈遵旧谊推先辈，刘协新文绝后流。\n早晚飞鸿过京邑，幸题尺素慰沈忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庐陵别李年兄","author":"尹台","text":"楚水吴山恨不同，十年踪迹竟西东。\n云间雪草迷朱雁，白下烟花阻碧骢。\n长病马卿聊暂起，多忧贾傅未辞穷。\n麟台凤阁终贤俊，伫看飞名玉匦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]