[{"title":"秋日閒居 其一","author":"区怀年","text":"閒资副墨欣赏，颇豁秋深病怀。\n供具茶烟芋火，栖迟竹坞茅斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日閒居 其二","author":"区怀年","text":"弈侣消閒一局，禅宗了悟三车。\n俄闻户外香发，不觉窗西月斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日閒居 其三","author":"区怀年","text":"引晦声华易损，投闲物累应疏。\n试看东篱黄菊，秋来诗兴何如？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日閒居 其四","author":"区怀年","text":"倦倚丛隈怪石，微吟屐底青莎。\n饶他绂冕荣宠，胸次能閒几何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画 其一","author":"区怀年","text":"春融远树飞翠，昼永晴川落霞。\n天外藜筇鸟道，云中鸡犬人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画 其二","author":"区怀年","text":"层峦鹤径虚引，隔浦鱼舟自闲。\n落木桥边草阁，斜阳径里柴关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"?东杂咏","author":"区怀年","text":"独树溪边钓侣，孤村浦上田家。\n废市寒生暮霭，晴峦隐带秋霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝 其一","author":"区怀年","text":"酒帘风劲碧梢寒，南陌花光媚眼看。\n惆怅谷莺呼不起，腰枝赢得倚阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝 其二","author":"区怀年","text":"映水长条故故柔，彩虹桥畔系扁舟。\n轻阴似管离人意，一夜回塘带雨愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其一","author":"区怀年","text":"紫贝青裳思不任，日南珠树惬冰心。\n空山百卉羞零落，自展瑶华对夕阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其二","author":"区怀年","text":"不逐东风桃李春，独含贞素待幽人。\n疏姿晚映寒岩碧，草阁烟篱次第新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花 其三","author":"区怀年","text":"晓风谁建妙香幢，衰鬓终怜素影双。\n山鸟不知林气蔼，乍疑晴雪照蹊窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游丝曲 其一","author":"区怀年","text":"无限晴光春可怜，几堪萦日复萦烟。\n碧桃红杏休相妒，留与封家作锦缠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游丝曲 其二","author":"区怀年","text":"纤影微茫散远空，多情一陪是东风。\n落花扰乱浑无赖，又掠斜曛水槛中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎春曲 其一","author":"区怀年","text":"粉黛如云夹路看，傍帘花气透中单。\n香风集处邀闲止，春在朱门十二栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎春曲 其二","author":"区怀年","text":"家家红楮贴宜春，一簇香风几簇尘。\n十里花光匀绣箔，不知谁是断肠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏十锦花 其一","author":"区怀年","text":"六街凉雨洒秋烟，漫蹙东风散宝钿。\n疑是凤楼誇手笔，益州新寓擘鸾笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏十锦花 其二","author":"区怀年","text":"绡纻歌翻郁水滨，月罗湘縠委红尘。\n樽前若问花消息，步障还邀十里春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙引","author":"区怀年","text":"月窦云房閟药芽，香风迢递泛胡麻。\n阮郎归去春山寂，闲杀碧桃千树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕市狭斜行 其一","author":"区怀年","text":"杏花飞尽紫骝嘶，官道疏槐角未齐。\n何处青帘供唤酒，当垆多在玉河西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕市狭斜行 其二","author":"区怀年","text":"十千酤酒醉如花，赚得娼楼第一家。\n调笑不知春漏促，月明犹自按琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯夕看烟花","author":"区怀年","text":"芳菲何处最撩人，不损香车宝勒尘。\n华月两阶风色蚤，梨云梅雪竞催春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈宗伯招集灯酌","author":"区怀年","text":"银烛青烟散绮霞，柳塘环映玉堤沙。\n芳尊水榭邀明月，不数扬州万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏荔枝 其一","author":"区怀年","text":"芒种家家听子规，邀欢何处柳塘西。\n香风十里嘘长夏，万簇红云酿火齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏荔枝 其二","author":"区怀年","text":"乐府曾占第一班，赐衣赢得耐朱颜。\n何人更倚沈香榭，裸玉裎酥辍牡丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"素馨花","author":"区怀年","text":"却忆晨鸡报晓妆，舞衣旋带露华香。\n朅来误入青闺伴，欲谱琵琶先断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红素馨","author":"区怀年","text":"离宫春草莽萧萧，碧树啼鹃对寂寥。\n回首可怜花郭暮，几堪愁醉玉容销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪杂咏 其一","author":"区怀年","text":"荷蓧沿溪数百家，桔槔声里见流霞。\n春畦绿满呼耘草，谷口谁曾问落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪杂咏 其二","author":"区怀年","text":"屋边流水漫垂纶，不树桃花亦避秦。\n何事平津报开阁，五湖烟棹属闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪杂咏 其三","author":"区怀年","text":"沧桑回首刹那间，长日能消绮季闲。\n歌罢紫芝人寂寞，坐娱枰局对空山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阮溪杂咏 其四","author":"区怀年","text":"丘壑忘机道亦存，石函书罢偶窥园。\n鸦啼古木炊烟起，卧听南庄刈稻喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清夜游二首 其一","author":"区怀年","text":"烟扉罗幌护钟重，灯火人家远寺钟。\n何事月明双鸀鳿，海棠花下睡初浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清夜游二首 其二","author":"区怀年","text":"扑面浮香度浅溪，水光花落夜猿啼。\n行云踪迹知何处，十二峰头月正低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采菱","author":"区怀年","text":"八月寒塘静不波，暗香微掠妒颦蛾。\n木兰双桨归何处，霜入蓬根野鹜多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晚鉴江书怀 其一","author":"区怀年","text":"晓寒谁念客衣单，宿雨藤窗曝未乾。\n十亩闲田堪种秫，蒯缑何事向人弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晚鉴江书怀 其二","author":"区怀年","text":"炊烟微掠凤山西，逆旅看山草阁低。\n清浣不禁迟暮色，刺桐花落杜鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春 其一","author":"区怀年","text":"紫驼宫锦玉连钱，南陌春风别去年。\n唯有越王台畔草，销魂依旧带寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春 其二","author":"区怀年","text":"北里歌钟咽尉城，昏鸦啼处总关情。\n朝来粉榭嬉春曲，半杂芦笳塞上声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居 其一","author":"区怀年","text":"高树啼鹃度晚风，渚烟晴挹蓼花红。\n虚窗不用分榆火，强半田家委巷通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居 其二","author":"区怀年","text":"曲桥通处有垂杨，南堰风微黍稻香。\n秋雨黑甜呼未起，枕边流水听沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏初记闷","author":"区怀年","text":"梅雨溪窗锁寂寥，子规声里暗魂销。\n琵琶莫按清商曲，愁绊东风弱柳条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从云路村取道入云端 其一","author":"区怀年","text":"晓发双峰石窦边，翠微晴色带炊烟。\n凌空直欲寒飞鸟，不数安期控鹤年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从云路村取道入云端 其二","author":"区怀年","text":"迂疏曾寄鹿麋踪，愿拾仙蒲餐紫茸。\n行尽石苔幽绝处，更携瓶策到中峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山夜别梁非馨","author":"区怀年","text":"暗雨疏灯此别君，相思何地更停云。\n明朝又上浈江路，枫落寒艭未忍分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醒后书壁","author":"区怀年","text":"高卧榆枌十亩间，小窗移枕对溪山。\n莫嫌鸥社閒来往，悟得忘机梦亦閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登宝月台望定山诸胜","author":"区怀年","text":"凌晨遵北郭，曳杖远尘事。\n崇宇一跻攀，悠然成小憩。\n平畴澹以旷，流览极无际。\n丛茜互蔽亏，晴峦婉相媚。\n崖壑露奇峭，洞户争瑰异。\n峨峨引秋旭，杳杳落空翠。\n变现发奇赏，清芬抉幽邃。\n讵直艳游观，已识栖真意。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阿坡岩","author":"区怀年","text":"迤逦蹑云过，灵岩讯阿坡。\n径偏游屐少，山迥牧场多。\n曲窦斜晖入，层崖古字磨。\n还期烂柯者，幽事竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛沥湖","author":"区怀年","text":"碧筱苍烟一镜开，轻鸥无恙掠波来。\n渚香十里漫留客，山色数重看举杯。\n稼事渐缘秋水落，渔歌都傍夕阳催。\n搴芳何处扁舟远，欲撷荷衣未可裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神符玉峭","author":"区怀年","text":"薄霭明霞绣作堆，嶙峋如绚莽烟开。\n云边五马行春驻，天外三山换影来。\n题字直看高岌嶪，磨崖先拟破莓苔。\n君家胜事元堪侈，海国名花几度栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端溪杂咏","author":"区怀年","text":"云去谷能幽，云来涧初白。\n惟有山中人，解指云踪迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度蓬壶径口占","author":"区怀年","text":"绕杖藤花拨暂开，嶙峋高处见崧台。\n轻烟未许湖光静，犹掠晴峰倒影来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"区怀年","text":"积泪销遗枕，残脂剩藁妆。\n青裳春已断，碧玉恨何长。\n扑蝶閒歌扇，骑鱼出井梁。\n宝奁芳句在，惆怅墨花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冶城","author":"区怀年","text":"晓出西州道，遥见荒城陴。\n荒城久芜没，楼觐空逶迤。\n试问城者谁，云是阖闾儿。\n范铁俾神工，霜花动寒威。\n一朝按剑怒，齐越供鞭笞。\n燖盟走诸侯，謦欬风云驰。\n诸暨负薪人，艳艳当华姿。\n酣歌上苏台，嫔御失光仪。\n长夜何未央，般乐及水嬉。\n霸业日以坠，决裂不复支。\n属镂谢孤忠，茂苑游鹿麋。\n风流如可回，千秋挹鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵","author":"区怀年","text":"朝望樵山巅，暮止樵山麓。\n路回苍蔼深，天外散鸣玉。\n谷口绚秋霞，半是经霜簌。\n坐此清冷中，顾见毛发绿。\n峭壁有奇文，目瞑不敢读。\n此意无人知，藜床了心曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚辰知贡举登明远楼和监试二侍御韵","author":"黄锦","text":"嵬嵬招贤宫，明远连双阙。\n仰观星可扪，远瞩神超忽。\n爽气西山来，奎光相互发。\n巀嶪摩层霄，风云何郁浡。\n忆昔燕昭时，黄金市骏骨。\n隗也一先鸣，群骥争驰突。\n鹿走崇台荒，龙兴天马出。\n世代几彫枯，弓旌宁间歇。\n我来同贡举，辟门将鼓揭。\n才短愧汲深，济川叹无筏。\n登临发浩歌，此身恐陨越。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛巳秋奉命偕成国新乐及礼臣同相孝陵值成国寿日排律言贺中元后一日","author":"黄锦","text":"暑退中元后，祥开岳降初。\n月轮谦有受，川德盛方潴。\n爽气翔高宇，凉飙动六虚。\n槎浮凌蜃泛，药捣傍蟾茹。\n阿母乘云驭，群仙降玉除。\n为传青鸟信，言奉紫霞书。\n有馔多麒脯，无觞不露湑。\n涟漪烽树发，飘飏凤笙嘘。\n舞奏霓裳袅，歌赓桂棹徐。\n婆娑今半百，笑傲历千馀。\n孝寝行将近，河流委以纡。\n皇皇钦简命，赫赫戒衣茹。\n剔攘存桢干，封培禁铄锄。\n龟螭增宝碣，金石炳玄庐。\n返旆朝丹阶，承恩锡路车。\n南山歌乐只，北海庆华胥。\n带砺永无极，冈陵同宴如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五凤楼前拜领诰命和李晓湘韵","author":"黄锦","text":"朝瞻初旭紫云浮，彩凤衔书天际头。\n文武两班森虎拜，衣冠三世见鸿庥。\n可知移孝先庭训，自是承家重祖谋。\n叨沐君恩深似海，此生图报可能不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳节赐百官宴先数日仍赐讲官酒馔","author":"黄锦","text":"珍赐频颁出上方，欣逢重九有辉光。\n糕团白雪花为酿，酒浥金茎露作香。\n每饭可能忘帝德，开尊并喜际萸觞。\n因思落帽缘何事，抖擞衣冠正席尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端午赐宴纪事是日上御五凤楼凭栏天颜密迩仍有排律","author":"黄锦","text":"长安嘉节是中天，圣主临轩五凤前。\n宴拌冰棱知却暑，酒传薄酝足延年。\n枭羹不羡汉官赐，粉线何劳唐女穿。\n此日酣歌逢盛典，小臣为纪蓼萧篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坐门议百官助马","author":"黄锦","text":"坐破门毡意已枯，床头还得酒钱无。\n空将苜蓿求天马，谁是筹沙却狡图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊辰奉差靖江南海祭告过通衢官梅阁步扁间韵 其一","author":"黄锦","text":"罗浮春梦客中稀，此夕相逢醉落晖。\n阁上每留馀韵在，衢前且喜抗旌归。\n花开岁晏堪玄赏，实可羹调别众菲。\n景仰遗踪怀往事，高山入望白云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊辰奉差靖江南海祭告过通衢官梅阁步扁间韵 其二","author":"黄锦","text":"二十年前此地过，相逢驿使更如何。\n梅增旧干莓苔老，阁满新编岁序多。\n几度月明香撩乱，数声笛奏影婆娑。\n我来正值深秋候，早晚寒芳上雪柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李二何年兄 其一","author":"黄锦","text":"忆昔公车初发程，多君学问已充盈。\n鹿鸣宴里谁骧首，雁序群中我应声。\n自逐风尘惊骏骨，早从坛坫主齐盟。\n而今老大怀知己，肯负忠信过此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李二何年兄 其二","author":"黄锦","text":"万里风烟接凤城，鼠忧那复见明明。\n却思满地承恩诏，好似祥云罩太清。\n天汉有章谁得报，波臣无血祇空盟。\n即看星使今何在，洗耳春和听鸟嘤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林紫涛按楚视师护陵","author":"黄锦","text":"乘骢声价重宣云，揽辔今看涤楚氛。\n百二山河归汉表，千秋陵寝奠江濆。\n从来挞伐先谋略，可念苍黎久溺焚。\n此去搀枪须扫尽，岣嵝天畔好铭勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄石斋年兄谪编户归闽 其一","author":"黄锦","text":"平生负伊吕，此去混樵渔。\n吾道非耶是，行云卷且舒。\n芳兰淹腐井，款段服金车。\n勿叹升沉隔，庄周一梦蘧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄石斋年兄谪编户归闽 其二","author":"黄锦","text":"来作朝阳羽，归应纵壑鳞。\n蛾眉偏见妒，夜月漫生嗔。\n安石登山剧，子云载酒频。\n北窗高卧后，谈笑论天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读林季冲先生钦视祖陵颂","author":"黄锦","text":"南都钟阜称丰芭，虎踞龙蟠瞰江水。\n脉浚茅山百二峰，祥开帝统三千纪。\n忆昔高皇弓剑藏，千官拜舞俨趋跄。\n森森石笋迎人立，郁郁长松摩天阊。\n相传岁久网渐疏，守人不戒等蘧庐。\n伐木穿窑燔活火，起土成呰龙脉锄。\n更有泗洲祖陵地，后峡开池专小利。\n蠢蠢小民何所知，不勒贞珉悯无忌。\n天子惕然念水木，大开中殿咨钧轴。\n皇华酌酒满金杯，赐出内镪资路宿。\n特命元勋成国行，懿亲新乐同于征。\n学士亦有宗伯在，周爰咨度毖经营。\n琅琅天语涣大号，镌碑竖碣表厥道。\n须令耳目赫然新，勿令后犯频入告。\n三臣衔命出京邸，臣亦叨恩拜南礼。\n好正追随恣讨论，其奈乡心牵万里。\n自别家园已六春，乌伤雁断长悲辛。\n安得仙人缩地法，携手同看钟阜云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予为孝廉游南岩数十年往矣通籍后久客长安每思旧胜如隔蓬壶丁卯冬奉命还家辱友人招饮于此见多改观且及结绿先兄欣赏之事怅然不胜今昔之感漫纪一律","author":"黄锦","text":"二十年前续胜游，西湖歌舞几更秋。\n乍疑紫气来函谷，恍历星坛到帝丘。\n路转千盘林壑窈，天邻北斗瑞光浮。\n忽听哀雁风中断，把酒相看泪不收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]