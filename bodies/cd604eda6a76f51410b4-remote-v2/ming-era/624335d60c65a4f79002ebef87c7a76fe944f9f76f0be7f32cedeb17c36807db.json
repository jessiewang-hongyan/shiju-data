[{"title":"雨中同周建岐祝奉宇步秦氏园","author":"张维斗","text":"新水荡行舟，朦胧云树幽。\n诗吟蜡屐雨，竹响画廊秋。\n冷艳墙边发，奇香天际流。\n园丁何处问，寂寂锁重楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"运河舟中即事","author":"张维斗","text":"篷底昏昏蝶梦醒，河流方驶正扬舲。\n树遥萦盼烟笼湿，鱼贱争餐水带腥。\n魏阙忍忘头半白，吴山将近眼先青。\n芒鞋欲踏川原上，孰是江南处士星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归家","author":"张维斗","text":"趱日归来习隐禅，观看蓝沈映云笺。\n羞将墨绶铜符梦，搅破苍林白石眠。\n梧际鸟吟蝉和语，窗前竹荫月斜穿。\n钟山移檄应难到，此地栽花浓欲然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄沈诚甫兼柬泽源禅师","author":"张思安","text":"春山雨后共谁登，酒兴诗豪老更增。\n明日杖黎寻惠麓，白云深处有高僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题潇湘图","author":"张思安","text":"三湘曾遍历，山色翠嵯峨。\n江上车尘少，云中梵宇多。\n危桥人懒渡，小艇客频过。\n白首归来后，披图赋短歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"镜光石","author":"张九方","text":"团团峰顶石，作镜自谁何。\n拭岂须人力，悬常藉女萝。\n冷光侵日月，清影映山河。\n终古无昏蚀，都凭岁月磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和钱启新先生丽泽堂即事","author":"张梦时","text":"伊席高谈立雪严，红炉点后若为添。\n六阴尽处堪观复，一线生时得益谦。\n妙脱陈筌非墨守，直探玄奥是心占。\n先生象像惺千古，好共吾侪细细拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谈信余复惠山古迹感赋","author":"张云鸾","text":"往哲留题处，幽人费讨寻。\n细莎迷旧迹，斜竹长新阴。\n六代青山色，三唐白雪音。\n徘徊烟景暮，怀古意何深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读求贤诏恭纪","author":"张缵曾","text":"珰焰弥天震九阍，剪除榛棘扫乾坤。\n百年养士思先帝，一诏求贤拜至尊。\n臣本草茅常引领，人非木石尽衔恩。\n鱼盐版筑风云气，洒涕重招楚泽魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"见樵者作","author":"张琦","text":"苍绿满山碛，乱红飞野烟。\n丁丁弄山斧，触手香于荃。\n荷锸带月归，老鹿洞口眠。\n携壶跨鹿去，飘若山中仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重过顺上人禅院","author":"赵纲","text":"寂寂禅关闭，寻师此复来。\n千花随雨散，一径踏云开。\n鸟下传经院，龙参说法台。\n欲吟还未就，端愧谢公才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望金山","author":"翟宏","text":"削金浮玉碧崔嵬，中截洪流四面开。\n万里江声连滟滪，一峰秋色接蓬莱。\n鹘盘塔影天中见，钟带潮音树杪回。\n不用登临重回首，老龙吟处且衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春夜读书有感","author":"周子义","text":"浩浩迁流默默成，人持何物与争行。\n风云不测阴晴变，日月回还昼夜生。\n但看雪埋柯不改，岂徒雷动蛰能惊。\n千秋圣哲飘然去，谁识微言是客程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送何小坡致政还信阳","author":"周子义","text":"海鹤远罝网，冥鸿谢鞲笼。\n人间千丈丝，安能絷游龙。\n所以达命士，脱迹尘嚣中。\n藐兹盈尺组，曾是羁我躬。\n何侯东海彦，司牧早奋庸。\n一麾指淮右，载旆佐汉东。\n斯民有父母，国论方尔崇。\n朝宗甫竣事，高蹈随赤松。\n薄言戒行李，云归天目峰。\n惜此远行别，不得少从容。\n载歌骊驹词，聊以抒我衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登鸡鸣山寺","author":"周炳谟","text":"琳宫突兀鸡鸣岭，极目风烟天地宽。\n山叠乱峰来北岳，水连千峡入桑乾。\n谁人禾黍溪边种，几处牛羊谷口看。\n塞下只今歌乐业，幕南昨日到呼韩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武城谒子游祠","author":"郑伯兴","text":"古庙空山远，荒城细雨过。\n千年犹礼乐，百里绝千戈。\n日暮苍烟迥，春深碧草多。\n疏钟云外起，仿佛听弦歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"塞上","author":"郑伯兴","text":"绝塞万山秋，筹边更筑楼。\n马肥春苜蓿，人醉卧箜篌。\n图画云台列，功名铁柱留。\n上公蒙宠异，方赐紫云裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"念奴娇 五十自寿","author":"陈于泰","text":"榴花照我，笑疏狂双眼，时青时白。\n种柳移松堪伴侣，世上软红都隔。\n二乐名园，三秋命阁，半亩溪干宅。\n杜衡兰芷，有时散发行摘。\n暇则烂醉高歌，清风明月，倚户招为客。\n江左夷吾应好在，那用东山复出。\n伯玉知非，买臣幸贵，两者谁相易。\n近来陶写，老怀丝竹闲适。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭卢思马二首选一","author":"堵允锡","text":"丹心报国气如虹，争羡书生万里功。\n养士百年凭一战，筹边三策仗元戎。\n燕颌已矣身难赎，马革嗟哉恨不穷。\n遥望将军酣战处，贾庄落日起悲风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿菰川侨居有感","author":"堵允锡","text":"湖山不改旧风流，万顷波光照荻洲。\n听我好禽当日句，怀人芳草接天愁。\n半生蕉叶难为梦，一树梧声忽到秋。\n大笑开颜原不易，倾尊莫负故人留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛太湖","author":"杭淮","text":"一叶烟波艇，如乘银汉槎。\n秋来万里兴，浩荡属谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西行回度滇池","author":"杭淮","text":"西行苦历险，落日放舟还。\n海草微茫际，沙鸥出没间。\n烟青金马寺，天远碧鸡关。\n诸岭云端出，如看震泽山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"打牛坪驿诸葛孔明迎春于此","author":"杭淮","text":"亭因卧龙旧，犹载打牛坪。\n耕战纡经略，春秋几送迎。\n野花空晚落，蔓草自春生。\n怅望三分迹，流传后代名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清平道中","author":"杭淮","text":"亦知春久去，花尚满陵冈。\n小朵穿篱白，微风过马香。\n清平蒙伐罪，苗獞识尊王。\n盐米通吴蜀，人今无异方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"镇远喜即舟","author":"杭淮","text":"连山雾不开，壑转一溪回。\n汹汹奔湍下，蒙蒙细雨来。\n巫山疑有峡，滟滪不成堆。\n撇旋看舟子，乘流亦快哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中登楼","author":"杭淮","text":"节序黄梅候，朝阴午不开。\n浮云暗山去，急雨洒城来。\n高艳红葵湿，低翔白鹭回。\n洗心亭咫尺，烟霭拥层台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠溪干公八十","author":"杭淮","text":"黄金横带发如银，年跻八十逾精神；三月生辰好时节，高楼结绮临长春。\n白鹿献花来在户，蹲蹲舞兮坎坎鼓；持问南山松与柏，寿算与之谁比数。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新正二日发宜春次王阳明韵","author":"杭淮","text":"宜阳山前莎草痕，春泥释释水流浑。\n客行远道无停毂，人拜新年不出村。\n三日暄蒸北风作，清明阴霾江气昏。\n野馆萧条亦足赖，梅花为我招吟魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经盘江次刘元瑞韵","author":"杭淮","text":"逾冈陟岭兼多病，腊尽春来不记程。\n瘴水巳知多客泪，穷山只是有人行。\n缘崖昼雾愁俱黑，触马春花眼一明。\n西蜀未知天下险，老夫筋力尽南征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘羙之太守赴铜仁","author":"杭淮","text":"园柳何青青，江草萋以碧。\n送子适万里，执手情脉脉。\n嗟彼云中雁，翱翔依沙碛。\n不为稻粱谋，何以有南北。\n努力慎所之，悠悠岂终隔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早发巢县暮宿金城寺","author":"杭淮","text":"烟霭市上青，霜露草根白。\n日出鸡尚鸣，墟落溪南北。\n涉野多寒风，枯杨何萧索。\n山川莽迢递，岁晏道路迫。\n王事苦未休，惨澹逾郡国。\n暮逢禅房幽，且复舒枕席。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王阳明谪官龙场驿","author":"杭淮","text":"白日野中微，浮霾结朝阴。\n送子远行役，踯躅伤我心。\n岂无良朋俦，不如子同音。\n寂寞投穷荒，谁能念浮沉。\n愿为双玉轸，相随丽瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阳羡茶泉","author":"蒋如奇","text":"城南佳气日徘徊，胜遂清芬到碧隈。\n闲坐一泓争共鉴，经春百草避先开。\n贡题上品珍天府，锡卓芳流净戒台。\n自是荐新勤长吏，几人不道采茶回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游善权寺","author":"邵璨","text":"玉带桥边辍榻来，桧香松暖寺门开。\n饥猿隔涧窥红果，老鹤沿阶啄紫苔。\n豪客漫夸诗胜偈，高僧自说镜非台。\n軞车历遍黄金界，九斗坛前趁月回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鹧鸪天 香囊记","author":"邵璨","text":"一曲清歌酒一巡，梨园风月四时新。\n人生得意须行乐，只恐花飞减却春。\n今即古，假为真。\n从教感起座间人。\n传奇莫作寻常看，识义由来可立身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛太湖","author":"沈晖","text":"野老春湖上，高台夕照间。\n天边时白鸟，烟外忽青山。\n神禹功何大，陶朱去不还。\n古今无限意，流水自潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题大潮寺","author":"沈晖","text":"太湖西拥大潮山，万丈青莲一水环。\n佛殿高凌银汉表，禅房多住白云间。\n散花龙女乘风去，乞食山僧带雨还。\n记得攀箩登绝顶，仰探月窟俯尘寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陪庄孔旸游大潮寺","author":"沈晖","text":"踏遍烟霞到上方，忽惊身在白云乡。\n湖山东望连天远，风雨西来满寺凉。\n病不胜衣怜瘦沈，诗能入妙爱蒙庄。\n十年江海悲离别，此地谁曾共一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与沈仲律登大潮寺仍用前韵","author":"沈晖","text":"三年疲笃各殊方，一笑何期在我乡。\n促席喜闻深夜雨，登山况及早秋凉。\n白云黄叶前朝寺，流水柴门野老庄。\n世事茫茫付身外，相逢且醉菊花觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游张公洞二首 其一","author":"沈晖","text":"湖父镇前春系船，张公洞里去寻仙。\n青山绿水真如画，紫笋红菇不论钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游张公洞二首 其二","author":"沈晖","text":"出洞归来日已低，水村山市晚烟迷。\n行人问我来时路，笑指孤云鹫岭西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏夜悼亡","author":"沈晖","text":"青雀西飞竟不归，芙蓉犹剩旧罗帏。\n山斋十日黄梅雨，谁与熏笼夜焙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹山","author":"史懋锦","text":"冥搜携伴窥山腹，鬼斧神工眩心目。\n鼋鼍之窟蛟龙宫，飞仙羽客纷游踪。\n岿然足山当湖冲，上有古刹淩空蒙。\n登峰放眼渺无际，浮乾荡坤开心胸。\n秋云明净秋飙爽，三万六千平入掌。\n水天相接涵虚无，点点青螺波下上。\n莫向桃源问仙谷，石床丹灶在幽瞩。\n谁道竹山无足奇，竹山之奇在山足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"善权寺龙眼亭","author":"吴正志","text":"山深入寺僻，得亭始得路。\n夹道护苍松，行行欲回顾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乾元岕","author":"吴正志","text":"绝壁藏深坞，仙台俯碧空。\n数篁一萧瑟，我欲御长风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠内兄万子信六十","author":"吴正志","text":"常书履声今寂寞，兄妹几人递萧索。\n如君真似鲁灵光，甲子重新貌绰约。\n当年志气薄虹蜺，朋辈操觚尽推却。\n数奇未得致青云，才大翻嗟同瓠落。\n谨厚犹存万石风，闭门窃笑魔风恶。\n有时兀坐学冥心，有时留客恣欢谑。\n晚得名驹汗血流，骎骎欲绍箕裘泽。\n风流曾记少年豪，一朝忽屏闺中乐。\n以兹君独取其赢，始信人身有大药。\n山榴初红篁解箨，祝辞满堂舄交错。\n肺腑之交谁似予，为君感叹酬三爵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南岳","author":"吴贞吉","text":"结宇依空谷，秋来多白云。\n前山浑无赖，日日下斜曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玉女潭","author":"吴贞吉","text":"潭水碧于蓝，中有蛟龙宿。\n山雨欲来时，树树惊飞瀑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"善权洞","author":"吴贞吉","text":"空际碧于澄，探奇拂曙登。\n千年藏古雪，五月遂无冰。\n梦去疑庐阜，醒来得武陵。\n依稀星汉近，怅望六朝僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游张公洞","author":"吴仕","text":"洞府青霞上，云屏仙掌开。\n金支非幻影，玉女此香台。\n白日天门皎，玄泉地底洄。\n恍然鸾鹤驾，时与朗风来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游善权","author":"吴仕","text":"离墨西来气郁葱，金堂突兀起云中。\n巉岩尚有风雷迹，刻画谁知造化工。\n人境鬼区元不远，碧天沧海宛相通。\n何时更结长生侣，谩向仙源一探穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过万氏别院见旧题有感","author":"吴达可","text":"郭外寻春胜，幽怀浥酒卮。\n涧从峰外落，云向竹边移。\n野客多新味，山僧半旧知。\n不堪追往事，日月逝如斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张渚归舟","author":"王超","text":"落日半帆收，张溪古渡头。\n花明汀树雪，香冷渚莲秋。\n碧浪摇樯影，青山枕舵楼。\n曾知风景好，记此一停舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游南岳","author":"王超","text":"南岳禅宫林木稠，肩舆此日试追游。\n山僧漫见客来喜，啼鸟不知春去愁。\n封禅碑残苔藓合，洗肠池在石泉幽。\n此行未尽登临兴，又逐归云度岭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金鹅峰","author":"王超","text":"金鹅秋色净尘氛，每忆登临赋夕曛。\n一径曲通琼岛上，两峰高并翠屏分。\n禅宫远近皆红叶，鸟路苍茫半白云。\n许我结茅曾有约，山灵不必重移文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祝英台碧鲜庵","author":"许大就","text":"女慕天下士，游学齐鲁间。\n结友去东吴，全身同木兰。\n伯也不可认，洁已殉古欢。\n信义苟不亏，生死如等闲。\n蛱蝶成化衣，双飞绕青山。\n舍宅为道院，祝陵至今传。\n当年梳妆台，即汉风雨坛。\n嵯峨石壁下，遗庵名碧鲜。\n春秋荐苹藻，灵响来珊珊。\n晴天披石发，恍惚见云鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"巴女词","author":"谢遴","text":"巴川积水极岷峨，巴女明妆艳绮罗。\n为语秋江风浪急，断肠休唱《木兰歌》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铜官山书斋","author":"谢遴","text":"坐卧深林里，窗开别一天。\n山腰埋宿雨，石面泻流泉。\n路尽云犹触，村分树尚连。\n烟霞吾所恋，只此可忘年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"河间道中","author":"谢遴","text":"犹复驱车去，行踪何处留。\n闾阎移马厩，市井割鸿沟。\n草湿王孙泪，尘淹季子裘。\n那堪鬼车鸟，风雨夜啾啾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋旅集","author":"谢遴","text":"共作悲秋旅，翛然话久时。\n灯寒扶影瘦，酒薄上容迟。\n慨叹吾生事，苍茫午夜思。\n几人还赋月，孤客倍凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闲居偶咏","author":"谢遴","text":"不扣南山角，牛衣且索居。\n雨深三径草，门掩一床书。\n醽醁愁难剪，吴钩恨有余。\n半生真梦幻，踪迹老樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山行阻雨","author":"谢遴","text":"山才经雨洗，顿改昔时容。\n峻可百千仞，横惟三四峰。\n暮云争鸟道，返照破苔封。\n多少尘劳意，翛然杖野筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清江晓发","author":"谢遴","text":"星影堕寒溪，蒲帆半折西。\n留人昨夜雨，絮别此时鸡。\n牢落颜难壮，参差梦不齐。\n遥怜小黄鸟，恰恰隔林啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"富庄晓发","author":"谢遴","text":"催客村鸡早，连朝辙未停。\n酒无千里力，寒极半程醒。\n老马冲残月，孤鸿唳小星。\n山中招隐地，辜负日高扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"将进酒","author":"王廷陈","text":"丁福运，际昌期。\n歌太平，圣无为。\n坐明堂，奏咸池。\n酌醴泉，餐灵芝。\n寿万年，天与齐。\n县谏鼓，燔刑书。\n微能录，小过除。\n吏廉明，民安居。\n三年耕，必有一年之馀。\n绝争讼，无嗟吁。\n新不间旧，愚不妒贤。\n人不习佞，朝不信谗。\n菑害不作，和气充然。\n壮士服畴，陇却走马，以粪其田。\n不闻父哭子，道逢多华颠。\n皇心大悦，日弹五弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]