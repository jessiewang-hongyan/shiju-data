[{"title":"登瓜州酒楼留别","author":"王逢年","text":"枫树清霜恋客杯，日高京口曙烟开。\n帆飞细逐通州下，江影青浮北固来。\n击楫关心鸿不到，登楼何事角频哀。\n秋风黄叶平原里，此去遥应首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海上岁朝作","author":"王逢年","text":"落魄平生误计然，春归无恙杖藜边。\n梅花雪坞留残腊，泽国砧声带旧年。\n沧海鱼丽空战舰，乌衣燕子过烽烟。\n五陵冠佩追趋日，野老如持汉节偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌 其一","author":"王伯稠","text":"月寒蟋蟀鸣，独向空庭步。\n金井双梧桐，花上有清露。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜四时歌 其二","author":"王伯稠","text":"北风昨夜来，大雪忽三尺。\n不愁送侬寒，但愁断炊迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西乌夜飞","author":"王伯稠","text":"何处惊栖乌，扑速忽飞去。\n侬家树自好，乌那不肯住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长干曲","author":"王伯稠","text":"月出江头白鹭飞，江花采罢湿罗衣。\n侬家住在长干里，自唱莲歌伴月归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长安道","author":"王伯稠","text":"白日照驰道，高天双阙开。\n黄金丞相阁，清吹五侯台。\n马蹴香尘起，花藏翠幰来。\n新丰白首客，弹铗夜歌哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大堤曲","author":"王伯稠","text":"清江出明月，月白江花寒。\n微风吹侬歌，懊恼愁杀欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"莫愁乐","author":"王伯稠","text":"春风吹石城，日日唤花开。\n可怜花上月，不唤莫愁来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兰若即事","author":"王伯稠","text":"兴来时野眺，小立倚柴扉。\n一雨清波动，双林片月归。\n山䶉藏竹语，水鸟出花飞。\n不觉空烟暮，濛濛翠湿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和韵","author":"王伯稠","text":"春风千里忆佳期，镜里空怜玉树姿。\n惊梦暗憎鹦鹉唤，避人偷寄伯劳词。\n月窥翠幌愁相语，花入珠帘恨自知。\n争信文园憔悴客，渐宽腰带鬓如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明日风雨过士登斋中小饮得花字","author":"王伯稠","text":"清明萧瑟送春华，短屐欣过仲蔚家。\n小语轻寒来燕子，半含微雨出桃花。\n蝶飞幻梦何须较，蚁尽深杯可再赊。\n浇却北邙坟草湿，白杨愁鬼哭烟沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日过子问郊居二首 其一","author":"王伯稠","text":"叶舠百转入幽溪，灌木苍藤夹岸迷。\n一缕炊烟小犬吠，柴门忽出竹丛西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日过子问郊居二首 其二","author":"王伯稠","text":"映竹缘溪三两家，阴阴树影日将斜。\n翩翩黄蝶穿疏蓼，唧唧秋虫语豆花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"听沈二弹北曲","author":"王伯稠","text":"燕歌撩乱夜弦鸣，诉尽青楼恨别情。\n四十年前明月夜，梦回曾听断肠声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"薄暮步溪上见茆舍前桃花盛开","author":"王伯稠","text":"娇靥枝枝破浅红，暮寒无语向春风。\n谁来花底多情立，白发如丝一病翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"周子居幽居不遇","author":"王伯稠","text":"寂寂柴门深自关，幽禽相唤语青山。\n墙头含雨桃花色，半出青葱春树间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠歌者","author":"王伯稠","text":"尽说青楼碧玉家，舞风歌月斗铅华。\n自从误识樱桃后，懒看阊门路畔花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青楼曲","author":"王伯稠","text":"日长深院小榴开，懒斗红妆傍镜台。\n偏爱双双飞燕语，自开珠箔放归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凉生豆花","author":"王伯稠","text":"豆花初放晚凉凄，碧叶阴中络纬啼。\n贪与邻翁棚底话，不知新月照清溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其一","author":"王伯稠","text":"秋风九塞静狼烟，铁骑千营夜醉眠。\n大奏钧天酬上帝，君王法驾在祈年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其二","author":"王伯稠","text":"西内词臣和柏梁，天书飞动赏辉光。\n谁怜一铗新丰邸，弹尽秋风白发长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其三","author":"王伯稠","text":"纷纷游客似雕翻，一技俱能猎异恩。\n牛饮总污丞相席，沐猴争戏五侯门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其四","author":"王伯稠","text":"欲醉胡姬耐笑看，驼酥千盏不辞乾。\n忽雷抱向青楼月，拨出《凉州》夜雪寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其五","author":"王伯稠","text":"燕山自古接胡沙，大有胡风入汉家。\n小妇拍鞍能走马，儿童捲叶学吹笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其六","author":"王伯稠","text":"玉蝀金鳌跨夕阳，风清海子碧波长。\n荷花千顷无人采，落尽仙姬镜里妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其七","author":"王伯稠","text":"射虎屠龙意气豪，纵横年少见吾曹。\n老来梦断长安事，落日捞虾傍小舠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追昔感事八首 其八","author":"王伯稠","text":"高枕青山计未贫，空林幽鸟伴吟身。\n谁能更抱齐门瑟，老觅长安解听人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨花篇","author":"朱阳仲","text":"江南二三月，杨花竞芳华。\n寂寞长条攀折尽，绿丝飞来千片花。\n千片飞飞西复东，白雪晴云昼溟濛。\n风吹满空翳白日，散入千家池馆中。\n池馆楼台媚春昼，珠箔重重散花柳。\n白玉筵中拂画衣，琉璃杯里沽春酒。\n落日千家春酒阑，飞花拂拂玉阑干。\n高处余风常不定，低边日气转犹寒。\n秦女楼中妆镜寂，王孙道上相思忆。\n讵将春色报深闺，还惹游丝度南陌。\n南陌深闺两地情，惜此飘扬花性轻。\n焉知落地为香土，更怜入水作浮萍。\n香土浮萍那堪数，虚令春色年年度。\n今年已见柳花残，明年复见杨花吐。\n愁杀龙沙千万山，春来春去损朱颜。\n祇被杨花恼妾睡，不教清梦到燕关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒食行","author":"朱阳仲","text":"谁家墓头作寒食，野棠离离间古柏。\n香毂辚辚拜扫归，日暮风吹纸钱白。\n纸钱不到黄泉路，岁岁化为坟上土。\n人生苦乐百年中，笑杀荒山石羊虎。\n西家女儿哭未休，城东又作踏青游。\n满地花枝斗芳草，还嫌落日催归早。\n待得明年寒食时，又来挂纸一沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"双溪曲","author":"朱阳仲","text":"脉脉溪路遥，泛泛落花娇。\n人心不如水，相随下河桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖采莲曲二首 其一","author":"朱阳仲","text":"五月芙蓉浦，花开胜若耶。\n若将湖作镜，应照妾如花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖采莲曲二首 其二","author":"朱阳仲","text":"玉腕摇轻楫，红莲暗绿波。\n花深欲无语，棹转忽闻歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳枝辞","author":"朱阳仲","text":"广陵杨花辞故枝，各自空条雨后垂。\n羌笛不知春自去，分明一曲月中吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出塞曲","author":"朱阳仲","text":"雪尽洮河月满营，胡儿羌笛奏边声。\n春风不到单于塞，何事梅花夜夜生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长门怨","author":"朱阳仲","text":"春尽长门凤辇稀，宫莺百啭绕蔷薇。\n落花千片如红雪，飞入昭阳作燕泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长干曲","author":"朱阳仲","text":"美人家住汉水滨，夫婿从军久向秦。\n江口寄书无便使，客中多是洛阳人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都台纪事四首 其一","author":"王养端","text":"九五黄宫八百姬，臣工拜舞贺昌期。\n春回灵囿时颁历，香蔼瑶坛夜受釐。\n河渭吐吞秦日月，岱华扫荡汉旌旗。\n清平乐事何由识，柳暗花明出锁迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都台纪事四首 其二","author":"王养端","text":"二月皇州春事稀，玉堤琼榭尽芳菲。\n农官夜候馣寔降，苑监朝供苜蓿肥。\n宝盖拂云双凤集，衮衣浮日六龙飞。\n山人无路将芹曝，拟傍台阶颂紫微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都台纪事四首 其三","author":"王养端","text":"彩雾氤氲覆禁城，西山旭日始分明。\n大官入捧丝纶旨，女史来收馆阁评。\n白凤青霞开宝宇，金盘玉碗散朱樱。\n南郊昨介清和节，遍赐莲花报化生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都台纪事四首 其四","author":"王养端","text":"翰墨初呈金马门，群贤此日荷宸恩。\n细封紫蜡传仙仗，高矗红云俨帝垣。\n麟阁晓浮花气暝，虎帏春动日华暄。\n台官忽奏文昌见，天子亲临策士轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丽情曲","author":"蔡宗尧","text":"兰房过雨蕙径空，绿云蔼蔼怀春风。\n欹枕牙床睡初醒，胭脂汗湿罗衣红。\n鸳鸯牵绣丝未歇，软瘦香肌倦如雪。\n玉麟堕地浑不知，流苏夜暖斜明月。\n珠帘半卷春日高，海棠飞起双蝴蝶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河套","author":"蔡宗尧","text":"胡虏昔何在，遥闻将士讹。\n何曾亲吉甫，遽欲夺蓬婆。\n浪议轻痈溃，成功幸石磨。\n未知廊庙计，终始果如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋思二首 其一","author":"蔡宗尧","text":"长莎肥马映征轩，飞骑边头入报喧。\n只见烟尘从远碛，不知胡虏猎平垣。\n残兵破鼓伤辽水，绝塞悲笳泣楚猿。\n最是书生犹将略，属镂赐后竟谁言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋思二首 其二","author":"蔡宗尧","text":"断云残柳接狼烟，极目氛埃自黯然。\n紫塞苍茫能立帜，黄河容易可投鞭。\n须知据险人持戟，莫使冲风马避膻。\n胜算终摧高阙耸，遥藩荒破犬羊天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感咏","author":"蔡宗尧","text":"海国凉生吹雨花，西门十里即天涯。\n山衔落日孤云细，林着疏风翠筱斜。\n湖海壮心惊白首，庙堂清议属乌纱。\n洛阳年少空前席，宾客梁王忆汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其一","author":"张元凯","text":"时序有代谢，晦朔若循环。\n灵景歘以驰，六龙杳难攀。\n舜华曜曦林，蜉蝣息夕寰。\n流运感人思，履世云孔艰。\n菌芝想霞外，孔翠悲笼间。\n栖遁托素业，韬精保朱颜。\n迅彼云螭驾，迟尔冥鸿还。\n长揖当涂客，去矣归空山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其二","author":"张元凯","text":"阊阖有高楼，岩岩临万雉。\n财赋五都雄，声利三川侈。\n千花含碧城，九衢回绿水。\n拂云韶頀音，照地明光绮。\n我世授一廛，蓬蒿吴趋里。\n闭户岁月深，凉风日夕起。\n驰光娱乐散，幻景繁华徙。\n至哉物外游，超然忘所履。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其三","author":"张元凯","text":"大运若转毂，鸿钧回化光。\n穷达须有命，顺时以行藏。\n君子或豹变，大人或龙翔。\n谁为鼓其机，所过神无方。\n南箕下人间，帝命弼有商。\n何知肖形者，宛在版筑傍。\n济旱霈霖雨，调元摄阴阳。\n乃识宇宙事，固吾分所当。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其四","author":"张元凯","text":"吾友好名士，居然抱明哲。\n硕人赋考槃，圭组良不屑。\n朝刈中原葵，暮采西山蕨。\n陟岭高云旋，濯水空潭澈。\n白璧不可为，宁以青蝇缺。\n皎皎机上丝，岂同缁尘涅。\n独有孤松树，苍姿照白雪。\n异彼夭桃花，甘以色取悦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其五","author":"张元凯","text":"毁誉不可校，荣悴安能期。\n飘风逐浮云，恍惚万象移。\n头白失塞马，衣文附灵牺。\n不为智者虑，则为达士嗤。\n名勋盖一世，世改人不知。\n区区千金子，徒戒垂堂为。\n矧乃草莽间，暂借鹪鹩枝。\n得酒尽舒啸，短鬓春风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其六","author":"张元凯","text":"天上白玉虹，延袤十万里。\n昭回下紫溟，飞来跨瑶水。\n仙人挟之游，飘飖靡所止。\n祖骞寻河源，浮槎适孔迩。\n长揖银汉间，相遗赤虬履。\n乃饰双明珠，加缘五色绮。\n提携未轻著，纳令授孙子。\n千载俟风云，一附鸾鹤起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其七","author":"张元凯","text":"英雄树大业，端倪莫可循。\n出处更险夷，变化驱鬼神。\n释来有莘野，投竿渭水滨。\n潜龙岂久淹，跃渊始见鳞。\n落落屠与钓，相继拥朱轮。\n尺蠖具至理，其屈求以伸。\n蠛蠓能飞扬，灵贵矧乃人。\n大禹惜寸晷，分阴当自珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其八","author":"张元凯","text":"楚人云千金，不如布一诺。\n由也以片言，折狱良不错。\n忠谅在人耳，隐然闻谔谔。\n对谈恒借躯，万乘遗如屩。\n所以国诸侯，不负布衣约。\n意气吐白虹，千寻走寥廓。\n今人徒嚣嚣，此道委沟壑。\n仲连宁蹈海，岂独秦风薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其九","author":"张元凯","text":"凉风起昨夜，大火忽西移。\n蟋蟀啼近床，流萤飞入帷。\n白发竟盈把，丹砂尚无期。\n朝散陆贾金，暮披张衡诗。\n四愁郁不开，万金亦奚为。\n叹息竟无语，俛视川波驰。\n孤怀易成感，失路多所疑。\n朝绯犹可典，日日倾芳卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十","author":"张元凯","text":"屏居卧南冈，策杖遵行苇。\n凉风吹絺衣，澄江澹生朏。\n纵睇秋旻高，云英何韡韡。\n感时鸣蟋蟀，阅世遗葑菲。\n鹤岂愿乘轩，龟且聊曳尾。\n侘傺辞帝阍，偃蹇伴山鬼。\n庞公荷耒耜，君平谢筐篚。\n白首抱明德，斯人岂不伟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十一","author":"张元凯","text":"玄霜凋碧草，熙阳媚红芳。\n地道顺天施，不违物理常。\n蛾眉对尊酒，螓首临镜光。\n綵树栖鸑鷟，绿波荡鸳鸯。\n荣华销逝景，娱乐安久长。\n南山孤生柏，结根丹崖傍。\n贞干回造化，叶叶生馨香。\n愿借黄鹄翼，与之同颉颃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十二","author":"张元凯","text":"朝为清庙诗，暮作明堂赋。\n赋剪秋空云，诗濯锦江露。\n织成文绮霞，挂在珊瑚树。\n声价比南金，光耀掩大璐。\n缄之赠所知，无媒得君路。\n从兹失颜色，飒如枯蓬暮。\n遂令弃中衢，咄嗟谁复顾。\n杨意若可逢，薄言一往愬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十三","author":"张元凯","text":"仙人佳何许，迢迢白玉京。\n弱水悬碧海，赤城凌太清。\n昨遇壶中公，引我接容成。\n倒著苍凫舄，横吹紫鸾笙。\n泠然饮一勺，丹液融金茎。\n手拈赠三花，回车下蓬瀛。\n归来见乡井，偪促还自惊。\n招邀向时鹤，跨蹑游八纮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十四","author":"张元凯","text":"灼灼芙蓉花，开在秋江侧。\n彷佛临镜妆，嫣然好颜色。\n美人日暮来，搴裳娇无力。\n甫采聊自佩，再采还自匿。\n欲以寄远人，明我长相忆。\n浮云天外驰，长江限南北。\n搔首无一语，仰看双飞翼。\n踟蹰怯独归，烟水微茫黑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十五","author":"张元凯","text":"结发慕遐躅，息驾怀幽奇。\n去来山林客，寤寐濠梁期。\n岸沙皓明灭，陂冈郁参差。\n坐弄霞上月，载采岩下葵。\n野酌草昧中，素襟松风披。\n蹈海鲁仲连，逃山介子推。\n遗荣终自爱，任智亦何为。\n向来冥寂意，唯有孤云知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十六","author":"张元凯","text":"有士客长安，三冬有旨蓄。\n射策苦不收，归来卧空谷。\n对我长歔欷，悲风生林木。\n未得平津延，已见咸阳逐。\n一言足取相，奚必三千牍。\n无歌可指凤，有赋元因鵩。\n徬徨亦何为，唯共穷途哭。\n展也诗人言，蔌蔌方有谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十七","author":"张元凯","text":"雨散无聚时，河奔无还流。\n岁月不我与，逝矣难再留。\n隙驹真促景，富贵焉可求。\n欲追凌风翮，云中无轻舟。\n卫霍甫青鬓，功业等山丘。\n广也七十战，白首不得侯。\n成固由天幸，败亦匪人谋。\n嗟嗟惜日短，秖为达士羞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十八","author":"张元凯","text":"吾祖产濠梁，偶成风云会。\n潜壑攀飞龙，薄海生霖霈。\n底定锡大封，骠骑功居最。\n桓桓镇南国，天子赐旌旆。\n祇受不世赏，山河元砺带。\n本从代邸功，汗马同丰沛。\n瓜瓞延秦吴，两地滥冠盖。\n茕茕余小子，岁月微禄赖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂诗二十首 其十九","author":"张元凯","text":"东海有佳人，矫矫云中姿。\n回翔自千仞，翻然斯来仪。\n光彩照四极，声华驰九夷。\n凤凰世希有，众人乃见疑。\n归巢弇山颠，孤踪蓬瀛期。\n曰余久沉冥，附翼惊以嬉。\n遗我绿绮琴，饮我白玉卮。\n卮酒良取醉，琴调罕所知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]