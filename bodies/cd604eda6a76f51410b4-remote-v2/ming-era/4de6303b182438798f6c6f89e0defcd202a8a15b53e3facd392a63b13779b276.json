[{"title":"七月三日午刻走笔","author":"霍与瑕","text":"风日争秋客路遥，小山孤枕思寥寥。\n龙江雷雨来何暮，鹢舫炎蒸苦不消。\n孟浪半生空自瘁，奔波双鬓为谁凋。\n新诗倚棹邀灵贶，一朵祥云沛泽饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔答何次澜见寄","author":"霍与瑕","text":"十载江湖不记还，今携妻子入樵关。\n熹微烟火饶新赏，管领风花得旧间。\n独对兔蟾秋淡荡，不闻鸡犬夜平安。\n山中合有诸仙在，行访真诠驻壮颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天香草堂见梅","author":"霍与瑕","text":"寥落城东旧草堂，标枝几处蘸荒塘。\n喜看春色随长至，遂有梅花傍短墙。\n夕照熹微横瘦影，山风断续递寒香。\n殷勤把酒同欢赏，迟尔和羹待岁阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤山社会逢海屿初度","author":"霍与瑕","text":"东风送暖到仙城，幽谷纷纷求友声。\n初度可谁逢社会，十年而长是邹兄。\n新诗落落饶春思，雅量汪汪不世情。\n且莫沧洲偷摘果，碧桃今始放红英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山偶笔","author":"霍与瑕","text":"鹧鸪何事唤纷纷，歌在湖山万顷云。\n燕雀岂知鸿鹄志，凤凰曾与鹜鸡群。\n饥乌腐鼠人间世，瘦鹤肥鹙天所分。\n龙见豹藏皆自得，肯将鹏鴳诧苍旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪弼唐尊师祀云谷次日山间父老来宴","author":"霍与瑕","text":"二十年前荐素蘋，曾随大老步天门。\n衣冠滚滚非前度，故旧萧萧有几存。\n夹院泉源垂瀑布，一堂风致共清樽。\n山间父老依然好，醉唱山歌彻远村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承卢星野教闻谤毋辩小诗谢教兼申来樵旧约 其一","author":"霍与瑕","text":"削迹樵西旧水涯，关心明月到山时。\n去年叠叠攀跻约，此夜悠悠音信迟。\n九十春归花伴鸟，几回怀放酒兼诗。\n巾车紫盖三城外，何日来过慰远思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承卢星野教闻谤毋辩小诗谢教兼申来樵旧约 其二","author":"霍与瑕","text":"归去皇皇何所之，东风入院已多时。\n千岩鸟语烟霞古，一路花香春雨迟。\n独向松根横卧榻，谁于竹叶乱题诗。\n凭高未共登临赋，搔首阑干空远思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承卢星野教闻谤毋辩小诗谢教兼申来樵旧约 其三","author":"霍与瑕","text":"楚客离骚古有之，滋兰树蕙及良时。\n园围十亩风烟足，地近三山春日迟。\n丹凤冈开新洞府，九龙泉洗旧歪诗。\n采芳尽日空盈掬，路远无因寄所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承卢星野教闻谤毋辩小诗谢教兼申来樵旧约 其四","author":"霍与瑕","text":"竹杖芒鞋随所之，风光正是暮春时。\n雨中吠犬闻全未，世外呼牛应不迟。\n野店流连偏足酒，山花狼藉故饶诗。\n穗城更有无言教，三复悠然起我思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵","author":"霍与瑕","text":"万树桃燃一洞霞，结茅洞口是谁家。\n不知天地此何世，惯见春山开乱花。\n石窦引泉鸣碧玉，药炉有火煮丹砂。\n年来九转功将就，普济群生应未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读谭二华翁荐书有感自述","author":"霍与瑕","text":"自是人间薄命人，祇应云水寄閒身。\n萧条野鹤躯偏瘦，歌啸蛰龙诗可嗔。\n三载虚沾慈尸禄，廿年犹忆帝都春。\n天涯知己恩难报，空付悲吟泣鬼神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东湖","author":"霍与瑕","text":"隐隐青青水外山，有人卜筑水山间。\n一天风月招邀遍，百岁光阴舒啸閒。\n日出波光摇钓艇，春深花影落渔湾。\n归来赋就寻丘壑，我亦樵西今闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓秀才见寄 其一","author":"霍与瑕","text":"四壁岩崖鸟道斜，千寻绝顶得山家。\n居人似不闻烟火，托屋恍疑栖绛霞。\n漏石清泉风振玉，点林红叶锦添花。\n胡然关外渔郎到，岂有芳桃出水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓秀才见寄 其二","author":"霍与瑕","text":"乱峰盘薄翠周回，万绿阴中小径开。\n洞里风香偏足桂，山间秋色故侵苔。\n诗篇得意聊千首，觞酒输人任几枚。\n客子相过无厌数，一尊倾尽一尊来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓仰泉偕侄访余山中索诗座上作","author":"霍与瑕","text":"云锁樵关晚乍开，廿年知己过荒台。\n豚鱼远致青山盒，酒醒频倾碧涧杯。\n竟日高谈陪二仲，好风吹暖韵三槐。\n我能剧饮君须醉，隔海重烟雨又来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔附寄安寓方田二表","author":"霍与瑕","text":"石榻漱云欹午梦，柴门过雨急前滩。\n烟连古洞春如昨，碧滴交梢夏欲寒。\n九万因风嗤鹖鴳，十三乘醉种琅玕。\n寄声安寓方田子，早晚来游共采兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月廿日琴沙偕方田诸君泛舟赏荔用前韵 其一","author":"霍与瑕","text":"紫气朝来西入关，呼童早起落前滩。\n残星几点野风细，晓鹊数声山月寒。\n带露孤征沾旖旎，移阴久坐遍琅玕。\n丹霞树底饶清话，气味真如幽谷兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月廿日琴沙偕方田诸君泛舟赏荔用前韵 其二","author":"霍与瑕","text":"閒向樵西第一关，拿舟急水旧时滩。\n三江滚滚浪花碎，一路阴阴风树寒。\n绿野有堂依碧渚，青霄无碍信琅玕。\n算来直是幽寻懒，十九年前此看兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月廿日琴沙偕方田诸君泛舟赏荔用前韵 其三","author":"霍与瑕","text":"寻真偶出翳门关，五月扁舟共碧滩。\n江浦雷声惊老梦，琴沙风色入秋寒。\n水云身世欣清酌，烟火山家荐绿玕。\n从此采芳来往惯，丁宁畦父为栽兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月廿日琴沙偕方田诸君泛舟赏荔用前韵 其四","author":"霍与瑕","text":"桂棹飘飘溯水关，与君游遍六州滩。\n西江浪涌蛟龙喜，南国风多菡萏寒。\n十顷初黄收豆麦，两溪高碧耸琅玕。\n数声晚浦尤堪赏，互答渔舟歌木兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄莱轩见怀依韵奉谢 其一","author":"霍与瑕","text":"避暑西峰俯太荒，山高人静日偏长。\n最宜古树依檐碧，更有閒花满涧香。\n风采久疏怜旧雨，晚阴谁共纳新凉。\n再三歌讽阳春曲，清韵悠悠绕野塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄莱轩见怀依韵奉谢 其二","author":"霍与瑕","text":"崎岖寻壑亦经邱，陇豆畦姜处处稠。\n浊酒清溪聊独酌，故人新赏几淹留。\n自甘涉世随呼马，肯信忘机好狎鸥。\n空谷白驹供逸豫，焉知天外有公侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄莱轩见怀依韵奉谢 其三","author":"霍与瑕","text":"离索经时思渺茫，怀人山院苦天长。\n古岩过雨云犹滴，老树著花风亦香。\n拄杖寻芳偏足句，移杯傍竹不胜凉。\n更怜野趣无人共，翡翠时窥清浅塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄莱轩见怀依韵奉谢 其四","author":"霍与瑕","text":"珍重仙城老太邱，篇诗寄我锦云稠。\n续貂有句祇堪哂，得兔忘蹄可莫留。\n笑看烟霞追放犊，閒依云水侣浮鸥。\n橘洲荔圃年年熟，肯羡人间千户侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桥梓长春","author":"霍与瑕","text":"何处人间两地仙，斑斓歌舞入新篇。\n筵当秋序黄花瘦，老饫春风白发鲜。\n雨露千山桥伴梓，闽江万里水连天。\n好将寿考作人雅，去赞台莱杞李妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓仰泉挽歌 其一","author":"霍与瑕","text":"初夏翩翩小洞游，别来书信几绸缪。\n不胜古意依云壑，更有新诗到广州。\n知己忽传星陨夜，哭君狼藉叶飘秋。\n精神许健成归尽，泡沫真如尘世浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邓仰泉挽歌 其二","author":"霍与瑕","text":"昨日书来字太遒，拟于云谷拜中秋。\n秋风已送千岩寂，君子何之九曲幽。\n槐梦句成诗有谶，山家鳖熟酒谁瓯。\n一翻歌罢一翻恨，蒿里萋萋叶露稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸿映闽逵 其一","author":"霍与瑕","text":"老梦不知湖海阔，秋衫遥带岭南云。\n汀洲到处兰花满，风月常时桂子芬。\n当路福星人万仞，临流孤啸鹤离群。\n殷勤为语震堂子，清世今方好致君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸿映闽逵 其二","author":"霍与瑕","text":"话别正悬三岛月，赠行聊借五溪云。\n云横清海波踰静，月满黄连酒更芬。\n有客中流新击楫，何人塞北旧空群。\n寒江唱罢采莲曲，一曲秋风远送君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其一","author":"霍与瑕","text":"清明佳节出都门，暖日和风肃骏奔。\n万国衣冠共玉帛，亿年陵寝镇乾坤。\n瑞蔼四山围锦树，灵泉千仞落云根。\n天藏地设真奇胜，帝祉应知奕叶繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其二","author":"霍与瑕","text":"微雨三更清路尘，晓来山郭物华新。\n朱衣衮衮都前辈，骢马萧萧多近臣。\n树影参天金殿古，溪声动地玉桥春。\n升中子夜人神协，细听虞韶笙磬匀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其三","author":"霍与瑕","text":"追随大老献椒浆，得采蘋花拮早芳。\n千里山河开法界，八陵烟景入诗囊。\n腐儒旧有忧天癖，妙剂谁酬疗世方。\n望断五云空极目，不胜幽思俯沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其四","author":"霍与瑕","text":"当年独抱意寥寥，此日凭高感慨饶。\n峻岭以西连朔漠，皇陵之外即天骄。\n至尊诹策典谟在，大将分符节制遥。\n最是密云安稳地，祇今烟火亦萧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其五","author":"霍与瑕","text":"缥渺关河纵大观，白羊沧海势如鞶。\n千层嶂设无穷险，万里城高终古完。\n岂有军需增百万，尚云兵事转艰难。\n可怜汉武诸名世，多出降奴牧竖间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其六","author":"霍与瑕","text":"闻道西山佳胜地，念年劳企欠登临。\n好春好日陪仙侣，疏雨疏风度远岑。\n绿酒湖亭供永话，幽花石洞覆繁阴。\n那知背郭尘嚣外，别有高山流水音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其七","author":"霍与瑕","text":"袅袅垂杨几处村，悠悠驱马过平原。\n野花啼鸟有何意，芳草王孙空断魂。\n三十年前存旧稿，八千里外隔椿萱。\n凭高一度一惆怅，极目南天多白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明谒陵遂游西山 其八","author":"霍与瑕","text":"穹崖崒律更逶迤，看到西岩渐渐垂。\n回合诸峰梵宇出，参差丛树碧云低。\n满溪桃李花初放，近水蘋蘩叶未齐。\n好景独怜归骑促，再游应及九秋期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别 其一","author":"霍与瑕","text":"携手忽惊袂转分，三城灯火旧比邻。\n仙舟泛泛桃花水，祖席离离杨柳春。\n折柳暂翻梅岭曲，看花莫溯武陵津。\n秋风吹罢鹿鸣管，又是金台射策人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别 其二","author":"霍与瑕","text":"长安风细静无尘，门对西山结近邻。\n殿阁五云清禁迥，烟花三月玉河春。\n忽闻蓟北吟庄调，又向江南问楚津。\n知到羊城过粤秀，倚闾犹有未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别 其三","author":"霍与瑕","text":"羽仪廊庙见元公，羡尔徊翔六翮雄。\n礼乐明明新国子，簪缨滚滚旧家风。\n潞河冰送江南鹢，庾岭云归塞北鸿。\n赋别不堪乡土思，一尊聊共海门东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东平阻雨观画闻莺漫兴","author":"霍与瑕","text":"五老何因坐翠岑，閒花满地亦关心。\n黄莺声乱绿杨细，白鹤书来碧海深。\n古院有苔侵短砌，夏云将雨落穹林。\n征夫自笑蹉跎惯，信宿何妨且朗吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桐城夜雨甚烈次日喜晴","author":"霍与瑕","text":"东海苍龙腾夜雨，平明犹自下沉沉。\n烟迷细柳望无际，泥踔征舆苦不禁。\n官驿几回成独坐，客途千里漫孤吟。\n晚山晴霁果何意，迟尔秋原作旱霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上弦月","author":"霍与瑕","text":"少小迄今尚慕仙，无端世网苦牵缠。\n八千行路天中伏，两度离家月上弦。\n喜见缁尘随雨静，漫乘凉露带星眠。\n明朝又蹑高人躅，应是邯郸旧有缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"景州晓行","author":"霍与瑕","text":"景州夜宿迅风雷，景州晓行天地开。\n禾黍穗含时雨润，芝麻香逐好风来。\n浃旬爽气偏宜客，半点淄尘不上怀。\n应是真仙朝帝阙，封姨青女预安排。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙亥被命出山别三城诸君子","author":"霍与瑕","text":"十载眠云古粤州，强扶衰病策勋猷。\n春江画舫风生鹢，晴日花堤羽拂鸠。\n故旧关心遥水隔，光阴催鬓有霜浮。\n奔波半世成何事，回首真惭马少游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雷雨即晴用韵","author":"霍与瑕","text":"斜风斜雨洒纤纤，一洗江南九夏炎。\n庭院落花红欲暗，莓苔封砌碧相兼。\n天空乍觉微雷过，海阔不知新水添。\n公暇偶看湖口稻，高低同是有年占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉别黄碧川大参归番禺四首 其一","author":"霍与瑕","text":"黯黯同云雨脚纤，正宜高阁涤新炎。\n忽惊天上雷霆迅，遂使人间聚散兼。\n谈虎每怜色独变，画蛇偏恨足多添。\n赐环应见皇恩重，试听啼乌午夜占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉别黄碧川大参归番禺四首 其二","author":"霍与瑕","text":"三年威惠遍洪纤，晋秩苍梧火正炎。\n岂谓狼胡蹄载跋，因之熊掌味难兼。\n关心忍听离歌苦，聚首深嗟别绪添。\n便欲与公同握粟，卜居寻向泰人占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉别黄碧川大参归番禺四首 其三","author":"霍与瑕","text":"昼绣飘飘罗带纤，暂于榕下避天炎。\n行藏用舍人难定，离合悲欢事每兼。\n墟市笼烟风致远，池塘过雨涨痕添。\n看馀鱼鸟秋光满，好玩羲爻变豹占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉别黄碧川大参归番禺四首 其四","author":"霍与瑕","text":"碧水湾湾树影纤，同堂真有弟兄炎。\n黄蕉丹荔香殊绝，沉李浮瓜味且兼。\n乡曲旧知牺酒共，社中新喜豸冠添。\n鸡声唤醒东山梦，早慰苍生安石占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王震所宪副 其一","author":"霍与瑕","text":"烟纤纤复雨纤纤，烟雨无端更冷炎。\n乍见霜麾遵海耀，忽听雷鼓与风兼。\n龙光善世应随遇，豸绣便身自可添。\n努力加餐迓新宠，天王明圣不须占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王震所宪副 其二","author":"霍与瑕","text":"匆匆岁序转洪纤，昨日春寒今日炎。\n幸际休明连月侍，惊看文字五花兼。\n自嗤弱絮空中舞，岂有奇葩锦上添。\n最沐怜才频说项，可堪分手聚难占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔奉别陈省斋 其一","author":"霍与瑕","text":"十年鸂鶒锦纤纤，风彩朝端旧赫炎。\n折槛丹心非石转，搴帷赤舄有山兼。\n闾阎旷见神君化，户口欣看女伴添。\n岂谓亡猿林木及，鼋夫元自不容占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔奉别陈省斋 其二","author":"霍与瑕","text":"皇恩浩荡遍微纤，暂可归帆一避炎。\n越水秋风莼鲙足，江门朝市菜虾兼。\n鹤胫任阁偏宜瘦，凫颈从生安用添。\n早去北垣司锁钥，彤庭还应五云占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月二十朝","author":"霍与瑕","text":"醒梦巡檐行且吟，四更人静漏声沉。\n月乘云度汉微没，风与日争秋浅深。\n苔藓砌间晴上篆，石榴花底暗飘金。\n忽惊时序槐黄近，侧耳天南鸿雁音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺省亭殿下新居兼谢见赠 其一","author":"霍与瑕","text":"倚空楼阁众同誇，画栋雕甍接太华。\n七世藩垣王子宅，万年屏翰帝孙家。\n竹苞春雨千寻碧，桂树秋风几院花。\n应有谪仙来受简，落成诗绘满天霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺省亭殿下新居兼谢见赠 其二","author":"霍与瑕","text":"天孙令望更堪誇，风比清和月比华。\n两汉旧传为善乐，盛唐谁作大方家。\n架中长贮三皇典，笔底时开五色花。\n自愧疏狂承制作，法星堂上灿明霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕王阁宴集括阁序送张宪长小圃年丈北转 其一","author":"霍与瑕","text":"绣闼雕甍几度秋，江湖襟带自悠悠。\n逢迎千里仙人馆，宾主一樽帝子洲。\n声断衡阳惊雁阵，响穷彭蠡唱渔舟。\n骖騑上路扶摇接，捧袂今辰且共游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕王阁宴集括阁序送张宪长小圃年丈北转 其二","author":"霍与瑕","text":"万里晨昏奉百龄，迷津舸舰亦趋庭。\n淇园绿竹今青笋，邺水朱华旧紫荆。\n临别赠言惭短引，遥吟逸兴盻长亭。\n襜帷暂驻龙光射，日下长安驰彩星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发南浦别郊饯诸丈","author":"霍与瑕","text":"宦情乡思两漫漫，深谢移尊带雪寒。\n去日苦多来日少，别时容易见时难。\n云连断岸迷遥树，风引高帆过急滩。\n回首滕王江阁畔，不胜愁绪抚阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日喜晴用韵","author":"霍与瑕","text":"春光淡淡水漫漫，人日晴晖减旧寒。\n卜岁应知民事泰，乐天宁怨路行难。\n酒杯入夜邀新月，箫管乘风过远滩。\n二十三回来往惯，真能一一数江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]