[{"title":"藏杏为医者赋","author":"陈琏","text":"一坞千株杏，春来喜著花。\n托根真得所，生意自无涯。\n鸐背沾红雨，莺声隔綵霞。\n几时林下去，相对饭胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题曹氏贞节卷","author":"陈琏","text":"曹女唐家妇，孀居两鬓蓬。\n素心同玉洁，无梦妒春红。\n誓守共姜节，能存陶母风。\n阿谁传美事，歌咏属诸公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范先生从军云南二首 其一","author":"陈琏","text":"范子侯门客，英英志不群。\n束书来别我，仗剑去从军。\n夜醉湘江月，朝吟蜀道云。\n安边应有策，行见立奇勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范先生从军云南二首 其二","author":"陈琏","text":"鞍马辞乡邑，长亭复短亭。\n弓盘苍兕角，箭插皂雕翎。\n罗逻歌难和，巴渝曲好听。\n云南天万里，几月到边庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和少司成张公玄略喜新竹韵","author":"陈琏","text":"碧筱拂檐端，森森玉几竿。\n四时不改色，六月自生寒。\n笋茁含斑箨，丛深集翠鸾。\n烦君常爱护，晚节拟同看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浦氏家山图","author":"陈琏","text":"浦氏幽栖处，山中屋数椽。\n翠寒烟外树，璚响石间泉。\n李愿依盘谷，王维住辋川。\n君家诗礼盛，应是子孙贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初至龙兴寺斋宿赠无为禅师兼东海藏主二首 其一","author":"陈琏","text":"我爱禅师好，长斋养性灵。\n开窗分树绿，挂衲近松青。\n鹤警云间锡，龙听月下经。\n安心应有法，自可引修龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初至龙兴寺斋宿赠无为禅师兼东海藏主二首 其二","author":"陈琏","text":"偶到招提境，斋居兴独清。\n竹风消暑气，松雨滴秋声。\n挥麈谈无倦，焚香坐到明。\n相逢似相识，犹恐是三生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郊偶赋","author":"陈琏","text":"试马郡城东，双旌飏晓风。\n柳堤萦嫩绿，苔径落残红。\n作郡逢时泰，忧民愿岁丰。\n自惭无善政，何以慰良农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽谷","author":"陈琏","text":"窈窕通村郭，阴森接树林。\n雨晴千嶂丽，云过半山阴。\n地胜名幽谷，亭高号醒心。\n多因公务暇，载酒此登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"国子司业张公玄略哀挽","author":"陈琏","text":"蚤佐春官政，曾施经济才。\n暮年居璧水，一旦赴泉台。\n太史书遗事，诸生赋八哀。\n音容从此绝，无复寄诗来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽国子助教费公良弼","author":"陈琏","text":"学行推前辈，功名际盛时。\n伏生空有女，伯道竟无儿。\n白璧埋黄壤，清霜悴紫芝。\n讣来偏感慨，挥泪写哀词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和听雨李司训游琅琊寺韵","author":"陈琏","text":"古寺春初至，荒郊草未青。\n鸿来留雪迹，鸐舞堕霜翎。\n壁有太古画，函多西竺经。\n山僧无俗念，相见即忘形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"橘斋为张良医赋","author":"陈琏","text":"种得苏耽橘，斋前绿满行。\n树深苔石古，花落井泉香。\n药笼参苓富，芸窗岁月长。\n传家阴骘厚，著效有奇方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"爱日堂为任允迪赋","author":"陈琏","text":"久负淩云志，常存爱日心。\n双亲期百岁，一刻值千金。\n绕膝斑衣粲，介眉春酒深。\n喜能躬孝养，声誉重儒林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送来安徐知县仕禄","author":"陈琏","text":"大尹青云彦，三年政有成。\n公勤归士论，宽厚得民情。\n芹泮弦歌盛，棠阴讼牒清。\n此行书上考，阙下沐恩荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁太仆维南","author":"陈琏","text":"国朝崇马政，考牧得才良。\n群厩龙媒盛，郊原苜蓿香。\n房星常炳焕，天驷自煇煌。\n太史书成绩，千年著耿光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送太仆寺主簿苏公望","author":"陈琏","text":"匆匆动行色，官驿祖筵开。\n别酒红螺泛，春衣白纻裁。\n潮生杨子渡，云绕凤凰台。\n考绩应书最，承恩及早回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄彭用拙","author":"陈琏","text":"我爱彭徵士，幽栖云水乡。\n竹深琴席润，花落墨池香。\n新赋惊鹦鹉，清诗咏凤凰。\n明时需俊彦，宁许久韬光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送太仆少卿党公以文考满","author":"陈琏","text":"相送出城南，春深绿政酣。\n花前开祖帐，柳下集朋簪。\n滁水澄新碧，淮山净翠岚。\n锦还应有日，重此候归骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄指挥镇守淮安","author":"陈琏","text":"东楚古形势，雄名天下闻。\n羽山青近海，淮树绿屯云。\n藩干新开府，将军旧策勋。\n筹边风致在，公暇好论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿尉氏县乾明寺","author":"陈琏","text":"禅房闲假榻，风物政凄凄。\n霜月窥窗小，天河映户低。\n宵寒频警鹤，村远渐闻鸡。\n明发夷门道，流尘逐马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花堂","author":"陈琏","text":"坐对寒梅树，何殊白玉堂。\n花开万点雪，枝老百年霜。\n月下横疏影，风前度暗香。\n公馀清兴发，时醉紫霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客夜","author":"陈琏","text":"午夜浑无寐，开帘月色新。\n此时思弱弟，几载别双亲。\n雁过秋将暮，鸡鸣夜向晨。\n功名怜我拙，何以继前人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈司训仲矩","author":"陈琏","text":"司训稽勋去，今朝遽别滁。\n江山新雪后，风物暮冬馀。\n祖席频呼酒，行囊只载书。\n临岐忍分袂，握手重踟躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽郑节判叔成","author":"陈琏","text":"东浙旌门产，南谯学者师。\n传家惇孝友，为政尚仁慈。\n夜月黄粱梦，西风薤露词。\n阶庭森玉树，足慰九原思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度关山","author":"陈琏","text":"东风吹雨过，岚气湿人衣。\n路小缘崖上，云低傍马飞。\n山含翠色润，泉散玉声微。\n回首滁阳近，甘棠绿作围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送熊审用回京","author":"陈琏","text":"倾盖情偏好，临歧意独勤。\n使轺从此去，驿路到江分。\n扬子潮通海，钟山翠入云。\n归朝应显秩，锦诰五花纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵子和昆仲","author":"陈琏","text":"我爱贤公子，人誇好弟兄。\n才名双璧重，世利一毫轻。\n种竹频开径，看花懒入城。\n何时共尊酒，细话别来情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄左善世鹫峰禅师","author":"陈琏","text":"滁上暌违后，相寻屡失期。\n无由聆法偈，空自渺予思。\n天界云霄近，毗卢景像奇。\n几时趋丈室，煮茗细论诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄定岩僧录","author":"陈琏","text":"僧录声名重，高风不可攀。\n久居灵谷寺，只在紫金山。\n斋设伊蒲供，朝联玉笋班。\n平生无俗念，心共白云闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁秉章","author":"陈琏","text":"羡子丰城彦，相逢喜不胜。\n词华丹穴凤，襟度玉壶冰。\n家世人争重，才名众所称。\n此行宜自奋，莫待鹤书徵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿登封马县丞公廨","author":"陈琏","text":"城郭年来静，官衙夜不扃。\n照窗松炬烂，入座柏香清。\n山近云偏重，秋高月倍明。\n哦松人未至，尊酒忆同倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水帘洞","author":"陈琏","text":"城外小蓬莱，天然图画开。\n路从花影过，人自柳阴来。\n洞古藏烟水，碑残蚀雨苔。\n白头陈道士，留客意徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吏部主事刘浚","author":"陈琏","text":"学行原高峻，才华更老成。\n柏台留伟绩，郎署著能声。\n夜断黄粱梦，神游白玉京。\n风姿无复睹，挥泪倍伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潮州指挥王祯","author":"陈琏","text":"一自官戎卫，英英著美誉。\n先茔欣已就，旧学莫教疏。\n烽堠绝狼燧，恶溪无鳄鱼。\n况闻军令肃，民庶总安居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归省","author":"陈琏","text":"冠盖出瑶京，依依惜别情。\n潮生扬子渡，舟发石头城。\n驿路三千里，乡关几日程。\n兕觞称寿处，人讶綵衣荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽王主事母","author":"陈琏","text":"教子成名宦，居孀亦有年。\n甫能膺禄食，遽尔赴重泉。\n素守共姜节，能追孟母贤。\n定知铭墓者，应有笔如椽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁氏存仁堂","author":"陈琏","text":"攻医能愈疾，克己在存仁。\n一念无非善，满腔都是春。\n杏林长茂硕，橘井自奫沦。\n庆泽来应远，馀波及后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽张少卿母","author":"陈琏","text":"教子已成名，慈闱重有声。\n平生守贞静，垂老喜康宁。\n禄养丰甘旨，褒封沐宠荣。\n云何遽仙逝，闻讣独伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李给事省亲","author":"陈琏","text":"几年居侍从，日得近清光。\n予告天恩重，还家道路长。\n霜寒汀树老，雪霁野梅香。\n綵服趋庭日，双亲喜寿康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"锦江别意","author":"陈琏","text":"冠盖集旗亭，骊驹动别情。\n霜晴锦江净，天近雪山明。\n出峡闻猿啸，浮湘见雁征。\n九重多雨露，行见沐恩荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅轩为弟廷宾赋","author":"陈琏","text":"闻道轩居好，寒梅已着花。\n暗香来几席，疏影映窗纱。\n宴集欢无已，吟哦兴复佳。\n客中怀胜赏，忆尔倍思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追挽处士张仲琛","author":"陈琏","text":"曲江文献裔，东邑种庵孙。\n芳誉今犹昔，佳城俨独存。\n白杨沾雨露，宿草自朝昏。\n太史书潜德，雄词贲墓门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐母刲股","author":"陈琏","text":"闺阃芳仪著，生平四德全。\n当夫垂死际，刲股竟能痊。\n吉兆符霄梦，同堂乐暮年。\n词臣有佳传，不愧万人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双节堂为锡山朱靖赋","author":"陈琏","text":"一自共姜后，谁能赋柏舟。\n今看双节美，可与古人俦。\n共矢心如石，相看雪满头。\n观风有使者，行听达宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽袁忠操","author":"陈琏","text":"鄞邑簪缨后，兰坡早有声。\n方期登仕版，遽尔赴泉扃。\n竟负生前志，空留身后名。\n桃源冢新建，过者为伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鸿胪寺严寺丞考满","author":"陈琏","text":"威仪人所仰，声誉众皆传。\n涖政经三载，稽勋觐九天。\n瑶觥倾别酒，绮馔簇芳筵。\n此去应书最，承恩到御前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浣花别意为姜生赋","author":"陈琏","text":"相送浣花溪，郫筒喜满携。\n扁舟过江左，几月度辽西。\n椿府行当见，萱堂惜暂暌。\n此心关去住，别意重凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万竹轩为萧廷玉赋","author":"陈琏","text":"分得淇园种，年深长万竿。\n露华凝翠羽，雪色映琅玕。\n案上琴书润，窗间枕簟寒。\n不徒瞻劲节，还喜报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽祠祭郎中孙恕","author":"陈琏","text":"显宦已多年，胡为病莫痊。\n司徒书伟绩，太史志新阡。\n宰木滋寒雨，佳城锁暮烟。\n无由浇絮酒，些罢倍凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柯尚舍永思堂","author":"陈琏","text":"双亲已沦逝，游子极哀思。\n岁月嗟云迈，音容竟莫追。\n长兴风木叹，久废蓼莪诗。\n蚤晚膺华秩，显扬知可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂轩为弟廷贵赋","author":"陈琏","text":"兔窟移栽远，灵根阅岁多。\n黄金攒细萼，碧玉长新柯。\n入座天香至，窥帘月影过。\n待予休致日，花下共婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行营即事四首 其一","author":"陈琏","text":"忽传边燧举，复见羽书驰。\n万乘亲征日，群臣扈从时。\n将军威胜虎，士卒力如貔。\n不日平胡虏，欢声洽四夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行营即事四首 其二","author":"陈琏","text":"旭日辉黄钺，清风肃白旄。\n熊罴方奋跃，犬豕竟何逃。\n天净旄头落，宵寒太白高。\n小臣叨扈从，独念圣躬劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行营即事四首 其三","author":"陈琏","text":"令出军威肃，恩敷圣泽饶。\n六龙扶日驭，千里击天骄。\n拟见胡尘净，终期祲气消。\n颁师行有诏，道路蔼歌谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行营即事四首 其四","author":"陈琏","text":"师行已逾月，何处是开平。\n天暝雕声惨，沙乾马足轻。\n辕门瞻左钺，驰道望前旌。\n共睹军容盛，行看朔漠清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和颍上知县廖谟行营即事四首 其一","author":"陈琏","text":"督运赴边陲，承恩出禁闱。\n偶看风絮起，疑是雪花飞。\n龙驭升黄道，鸾旌度翠微。\n六军行奏捷，齐唱凯歌归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和颍上知县廖谟行营即事四首 其二","author":"陈琏","text":"终宵味六韬，何用梦三刀。\n为荷恩荣重，宁辞运饷劳。\n旄头看已落，太白出何高。\n露坐听刁斗，霜威袭锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和颍上知县廖谟行营即事四首 其三","author":"陈琏","text":"万乘驻龙沙，雕戈耀日华。\n令传新赐节，袍拥旧蟠花。\n营起军威肃，兵行阵势斜。\n旌麾来队队，光采绚朝霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和颍上知县廖谟行营即事四首 其四","author":"陈琏","text":"大驾亲征日，云车驾六龙。\n列营皆上将，护跸有三公。\n自是天威重，行看朔漠空。\n万邦归圣化，应似水朝东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"开平道中二首 其一","author":"陈琏","text":"自入开平道，方知异土宜。\n驼蹄供客饱，马潼醉人迟。\n日暮雕声惨，途长马力疲。\n阴山在何处，极目塞云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"开平道中二首 其二","author":"陈琏","text":"自入开平道，西风一夏凉。\n饥驼鸣石碛，老马放沙场。\n雾起连山黑，尘飞障日黄。\n不因亲扈从，安得到毡乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孝陵陪祭","author":"陈琏","text":"此日逢冬至，淩晨谒孝陵。\n钟山腾瑞霭，辇路列纱灯。\n宝殿香烟盛，璇霄夜气澄。\n仰怀先帝德，歌颂愧无能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孝陵卫齐宿祭钟山二首 其一","author":"陈琏","text":"夜宿将军府，喜看松桧幽。\n风声随树起，云气近窗浮。\n雅集知难得，清谈自不休。\n眼中无俗物，座上总名流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孝陵卫齐宿祭钟山二首 其二","author":"陈琏","text":"夜宿将军府，襟怀自洒然。\n香清爇沉水，茗美瀹新泉。\n露下林光净，风来竹影偏。\n行当去陪祀，此际意虔虔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和吏部黄尚书喜雪二首 其一","author":"陈琏","text":"腊八才过后，同云暗碧空。\n玄冥司令肃，三白报年丰。\n道蕴诗方就，袁安睡政浓。\n何如黄冢宰，高咏画堂中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和吏部黄尚书喜雪二首 其二","author":"陈琏","text":"琪花开玉树，瑞叶散瑶空。\n对此知冬暮，因之卜岁丰。\n灞桥吟政稳，剡曲兴何浓。\n立雪程门者，声名满洛中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽翰林王学士达善","author":"陈琏","text":"穷经成皓首，报国有丹心。\n师训传高第，文章著翰林。\n名留青史在，玉瘗白云深。\n忍读天游稿，西风泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽翰林徐修撰孟昭","author":"陈琏","text":"霄汉声名重，诗书学业精。\n玉堂新进秩，璧水旧传经。\n青史名空在，黄粱梦不醒。\n鄱阳归葬日，风露湿铭旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]