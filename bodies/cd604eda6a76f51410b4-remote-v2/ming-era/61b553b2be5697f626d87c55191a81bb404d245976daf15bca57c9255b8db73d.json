[{"title":"如梦令 夜月","author":"沈宜修","text":"月晕天边常有。\n心绪浑如中酒。\n酒醒是何时，楼外乌啼杨柳。\n依旧，依旧。\n赢得梅花消瘦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 秋暮","author":"沈宜修","text":"平野遥连湘渚。\n暮色凉生碧树。\n待望月华明，愁听闲宵风雨。\n无绪，无绪。\n最是寒烟数缕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 寒夕","author":"沈宜修","text":"风月天边长美。\n佳兴如之何矣。\n萧瑟满疏林，惯与愁怀相倚。\n何似，何似。\n枫落年年流水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思","author":"沈宜修","text":"路漫漫，恨漫漫。\n竹叶撩风送响繁。\n凄清满画栏。\n夜将阑，漏声残。\n看尽馀灯伴晓寒。\n愁怀欲遣难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点绛唇 代人写恨","author":"沈宜修","text":"满日秋光，厌听反舌啼声■。\n泪流多少。\n回望巫山杳。\n几度思量，落得空烦恼。\n须知道。\n断肠难告。\n总付平波渺。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点绛唇","author":"沈宜修","text":"往事堪悲，断魂最是风光好。\n又弹别调。\n再续应休了。\n待欲抛开，忍见双欢笑。\n清灯悄。\n黄花愁老。\n恨逐西风晓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"沈宜修","text":"飞絮江干雨乍晴。\n风前密叶缀红英。\n落霞偏映夕阳明。\n不为春愁慵簇蝶，自多闲闷恼啼莺。\n断肠魂梦两无凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"沈宜修","text":"槛外游丝树树穿。\n断肠柳色最连天。\n春分偏为闷婵娟。\n细雨自留金钿梦，野花偏衬玉骢烟。\n暮霞飞尽月明边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水龙吟 冶城感旧","author":"沈宜修","text":"西风昨夜吹来，闲愁唤起依然旧。\n苔钱绣涩，蓉姿粉淡，悴丝摇柳。\n烟褪馀香，露流初引，一番还又。\n想秦淮故迹，六朝遗恨，江山不堪回首。\n莫问当年秋色，琐窗长自帘垂绣。\n淹留岁月，消残今古，落花波皱。\n客梦初回，钟声半曙，雁飞归候。\n便追寻、锦字春绡，多何与寒笳奏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19393,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水龙吟","author":"沈宜修","text":"砧声敲动千门，渡头斜日疏烟逗。\n莲歌又罢，萸房将采，愁凝翠岫。\n巫峡波平，蘅皋木脱，粉云凉透。\n叹无端心绪，台城柳色，难禁许多消瘦。\n古道长安漫说，小庭闲尽应怜否。\n红绡雨细，碧栏天杳，三更银漏。\n塞雁无书，清灯空蕊，但馀绿酒。\n想当年、白傅青衫，还倩泪留双袖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19394,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点绛唇","author":"叶纨纨","text":"往事堪伤，旧游绿遍池塘上。\n闲愁千丈。\n暗逐庭芜长。\n自古多情，偏惹多惆怅。\n添悽怆。\n寒宵淡月，一片凄凉况。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19395,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 代闺人春愁","author":"叶纨纨","text":"罗巾拭遍伤春泪。\n夜长香冷人无寐。\n独坐小窗前。\n孤灯照黯然。\n关情双紫燕。\n肠断鸳鸯伴。\n无奈武陵迷。\n恨如芳草萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19396,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 春阕","author":"叶纨纨","text":"轻风庭院将寒食。\n海棠雨过娇无力。\n春思暗萦人。\n春愁更断魂。\n梦迷芳草远。\n殢酒屏山掩。\n胡蝶扑花忙。\n深闺日正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19397,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三字令 咏香扑","author":"叶纨纨","text":"疑是镜，又如蟾。\n最婵娟。\n红袖里，绿窗前。\n殢人怜。\n羞锦带，妒花钿。\n兰浴罢，衬春纤。\n扑还拈。\n添粉艳，玉肌妍。\n麝氤氲，香馥郁，透湘帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19398,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉楼春 立秋","author":"叶纨纨","text":"微云日暮庭花紫。\n一叶飘轻淡罗绮。\n扇惊长信泣佳人，山冷苍梧悲帝子。\n楼前莫问相思字。\n深院萤飞照砧杵。\n西风燕去几时归，秋梦芙蓉江上水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 秋怀","author":"叶纨纨","text":"尽日重帘垂不卷。\n庭院萧条，已是秋光半。\n一片闲愁难自遣。\n空怜镜里容华换。\n寂寞香残屏半掩。\n脉脉无端，往事思量遍。\n正是消魂肠欲断。\n数声新雁南楼晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"百字令 秋怀","author":"叶纨纨","text":"秋光潇洒，正清江收潦，芙蓉写颊。\n扇影辞人凉入苧，叹故国经时别。\n月皎风凄，梦回花谢，多少乡情切。\n凭高对酒，幽怀几度凄结。\n无奈窗户萧条，闲情冷落，篆缕销金鸭。\n客梦悠悠何日了，旧恨新愁万叠。\n病骨支离，年华屡换，罗袖长啼血。\n可怜双鬓，应知一夜堪镊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 春恨","author":"叶纨纨","text":"窗外梅花落素英。\n隔帘啼鸟弄春晴。\n断肠芳草又青青。\n独倚画鸾愁日暮，半笼金鸭怯寒生。\n闲思心事暗伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"风雨闲庭锁寂寥。\n又看春色一分消。\n翠屏斜倚思无聊。\n梦觉情踪无处问，闷来心绪最难描。\n殢人残病恨今朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"一段春慵晓镜中。\n怕闻花气入帘栊。\n夜来思遍旧情踪。\n粉蝶迷残烟草绿，晚风落尽海棠红。\n凭栏千里暮云重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"叶纨纨","text":"闲闷闲愁不自持。\n几回消尽又如丝。\n小庭惆怅日迟迟。\n细雨斜风寒食后，子规残月梦回时。\n此情试问有谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉蝴蝶 感春四首 其一","author":"叶纨纨","text":"满目韶光明丽，东风拂拂，花影悠悠。\n帘卷重楼十二，禁火初收。\n草青青、游人金勒，春寂寂、深院银钩。\n暗香浮。\n谁家陌上，几处津头。\n凝眸。\n天涯信断，王孙何处，闺梦多愁。\n双燕无凭，日长凭遍小红楼。\n对莺花、满怀幽怨，临宝镜、几许情柔。\n空消受，月寒锦帐，香冷衣篝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉蝴蝶 感春四首 其三","author":"叶纨纨","text":"景色秾芳清昼，游丝无力，袅袅轻柔。\n欲挽春光同住，堪笑难留。\n碧烟侵、旧时罗袖，红香淡、独自妆楼。\n绣帘幽。\n弄晴啼鸟，唤雨鸣鸠。\n多忧。\n凭高一望，江南春色，千古杨州。\n回首繁华，断肠都付水东流。\n黯魂销、一番怀古，空目断、万缕新愁。\n几时休。\n绿杨芳草，春梦如秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水龙吟 次母韵早秋感旧，同两妹作","author":"叶纨纨","text":"秋来忆别江头，依稀如昨皆成旧。\n罗巾滴泪，魂销古渡，折残烟柳。\n砌冷蛩悲，月寒风啸，几惊秋又。\n叹人生世上，无端忽忽，空题往事搔首。\n犹记当初曾约，石城淮水山如绣。\n追游难许，空嗟两地，一番眉皱。\n枕簟凉生，天涯梦破，肠断时候。\n愿从今、但向花前，莫问流光如奏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水龙吟","author":"叶纨纨","text":"萧萧风雨江天，凄凉一片秋声逗。\n香消菡萏，绿催蕙草，烟迷远岫。\n浪卷长空，云轻碧汉，薄罗凉透。\n恨西风吹起，一腔闲闷，那胜镜中消瘦。\n寂寞文园秋色，这情怀、问天知否。\n檐铃敲铁，琅玕折玉，听残更漏。\n淡月疏帘，小庭曲槛，且还斟酒。\n算从来、千古堪悲，何用空沾衫袖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"捣练子 暮春月夜","author":"叶小鸾","text":"春寂寂，月溶溶。\n落尽红香剩绿浓。\n明月清风同翠幕，夜深人静小窗空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"后庭花破子 夜思","author":"叶小鸾","text":"朝来烟雨繁。\n金炉香缕翻。\n坐久还慵立，眠多愁梦烦。\n掩重门、落花流水，依稀随断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"生查子 送春","author":"叶小鸾","text":"风飘万点红，零落胭脂色。\n柳絮入帘栊，似问人愁寂。\n凭阑望远山，芳草连天碧。\n深院锁春光，去尽无寻觅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点绛唇 夏日雨景","author":"叶小鸾","text":"竹径深深，流云晓度罗帏静。\n雨丝几阵。\n满地桐花冷。\n湿翠侵眉，纤晕苍苔影。\n看无尽。\n绮屏人映。\n一片潇湘景。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 早春","author":"叶小鸾","text":"灯夕初过冷未平。\n乍看今日试微晴。\n东风已解向人迎。\n梨蕊几时飘弱韵，柳条如欲荡柔情。\n隔墙何处按歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 春夜","author":"叶小鸾","text":"柳絮飞残不见春。\n近来闲煞惜花心。\n无聊独自步庭阴。\n紫燕未归馀画栋，黄昏先到怯囊琴。\n灯花月影两深深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 前夕","author":"叶小鸾","text":"风透疏棂景色清。\n凄凄四壁怨蛩鸣。\n夜深微湿露无声。\n砌上落花和月落，帘前明月近花明。\n又看河汉半斜倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮","author":"叶小鸾","text":"繁云遮住瑶天月。\n绣屏围处珠帘揭。\n风度绮罗香。\n秾姿映画堂。\n银花开火树。\n一夜星移曙。\n莫羡管弦声。\n还愁月未明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 小窗前梅花一树正开，为风雨狼籍，作此志悼","author":"叶小鸾","text":"嫩寒初放枝头雪。\n倚窗深夜窥花月。\n晓起卷帘看。\n飘零满画栏。\n飞残千点白。\n点破苍苔碧。\n风雨几时休。\n巡檐索共愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诉衷情 秋夜","author":"叶小鸾","text":"蛩声泣罢夜初阑。\n香润彩笼残。\n多情明月相映，一似伴人闲。\n灯蕊细，漏声单。\n透香寒。\n萧萧瑟瑟，恻恻凄凄，落叶声乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"减字木兰花 秋思","author":"叶小鸾","text":"暮虫凄切。\n独倚疏帘清夜月。\n怅望瑶台。\n不见飞琼步月来。\n秋光如练。\n江上芙蓉开欲遍。\n流水残霞。\n断送西风入鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清平乐 命红于折秋海棠花","author":"叶小鸾","text":"断烟撩乱。\n霁景穿庭院。\n草色苔痕添一半。\n染得秋光堪玩。\n流苏帐晓花开。\n海棠几蕊簪来。\n昨夜熏笼香冷，新寒多上妆台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洛阳春 咏柳","author":"叶小鸾","text":"无数灞陵桥畔。\n离人泪染。\n一生空自管销魂，只赢得、腰肢软。\n陌上栏头长见。\n翠丝分线。\n和烟几度荡斜晖，误紫燕、归来晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浪淘沙 春闺","author":"叶小鸾","text":"终日掩重门。\n莺燕纷纷。\n昼眠微醒觅残魂。\n强起亭亭临镜看，重整双云。\n倦倚碧罗裙。\n又早黄昏。\n侵阶草长旧愁痕。\n惟有垂杨千尺线，绾住馀曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹧鸪天 春怀","author":"叶小鸾","text":"日上花梢睡未醒。\n绣衾香暖梦留人。\n依依柳眼天边碧，澹澹山眉镜里青。\n无意绪，惜娉婷。\n绿阶芳草伴愁生。\n东风吹梦知何处，空听流莺槛外声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虞美人 看花","author":"叶小鸾","text":"阑干曲护闲庭小。\n犹恐春寒悄。\n隔墙影送一枝红。\n却是杏花消瘦、旧时风。\n海棠睡去梨花褪。\n欲语浑难问。\n只知婀娜共争妍。\n不道有人为你、惜流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 春闺","author":"叶小鸾","text":"春半馀寒犹未褪。\n雨雨风风，赚得清明近。\n杨柳垂腰消酒困。\n海棠点靥藏春晕。\n一树桃花红雨阵。\n片片飞来，铺尽苍苔印。\n燕子不归难借问。\n东风易去还因甚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"千秋岁 即用秦少游韵","author":"叶小鸾","text":"草边花外，春意思将退。\n新梦断，闲愁碎。\n慵嫌金叶钏，瘦减香罗带。\n庭院悄，只和镜里人相对。\n过了秋千会。\n荷叶将成盖。\n春不语，难留在。\n几番花雨候，一霎东风改。\n肠断也，每年赚取愁如海。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧芙蓉 秋思","author":"叶小鸾","text":"曲径绕苍苔，秋意平铺，萧散无数。\n澹日移阶，几度寻花误。\n西风怨、露草寒螀，夜天凄、霖林烟树。\n隔桥杨柳，翠减长条，犹自依依故。\n青山云去杳，红楼日、又催暮。\n罗簟生寒，漫引新桐句。\n池塘映、芙蓉一叶，帘幕惊、海棠疏雨。\n阑干凭遍，妆台渐冷，黯黯无语空凝伫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉蝴蝶 春愁","author":"叶小鸾","text":"梦破晓风庭院，粉墙花影，睡起恹恹。\n几日双娥，愁损镜里春尖。\n看尽他、莺梭柳线，都织就、雾锦云缣。\n最难忺。\n催花小雨，依旧廉纤。\n堪怜。\n韶光淑景，芊芊芳草，寂寂钩帘。\n燕子归来，花香都向绿琴添。\n散闲愁、流红泛去，消酒困、湿翠飞黏。\n怯春衫。\n香烘袅袅，袖护掺掺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"疏帘淡月 秋夜","author":"叶小鸾","text":"窗纱欲暮。\n渐暝色朦胧，暗迷平楚。\n断雁凄哀点点，远天无数。\n苍烟染遍西风路。\n剪江枫、飘红荻浦。\n画栏东角，疏帘底畔，徘徊闲伫。\n漫赢得、长宵如许。\n又锦屏香冷，绣帏寒据。\n满耳秋声，长向树梢来去。\n萧萧竹响还疑雨。\n悄窥人、嫦娥寒兔。\n壁摇灯影，空阶露结，怨虫相语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 辛未除夕","author":"叶小鸾","text":"风雨帘前初动。\n早又黄昏催送。\n明日总然来，一岁空怜如梦。\n如梦。\n如梦。\n惟有一宵相共。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令","author":"叶小鸾","text":"雁唳西风天际。\n槛外梅花香细。\n今夜与明朝，试共相看不睡。\n且睡。\n且睡。\n守岁何如别岁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏莎行 闺情","author":"叶小鸾","text":"意怯花笺，心慵绣谱。\n送春总是无情绪。\n多情芳草带愁来，无情燕子衔春去。\n倚遍阑干，斜阳几许。\n望残山水濛濛处。\n青山隔断碧天低，依稀想得春归路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏莎行","author":"叶小鸾","text":"昨夜疏风，今朝细雨。\n做成满地和烟絮。\n花开若使不须春，年年何必春来住。\n楼外莺飞，帘前燕乳。\n东君漫把韶光与。\n未知春去已多时，向人犹作愁春语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水龙吟 秋思，次母忆旧之作，时父在都门","author":"叶小鸾","text":"井梧几树凉飘，满庭景色仍如旧。\n啼鸦数点，斜阳一缕，挂残疏柳。\n有恨林花，无情衰草，风吹重又。\n看轻阴带雨，天涯万里，楼高漫频搔首。\n记泊石城烟渚，落红孤鹜常如绣。\n轻舟画舫，布帆兰枻，暮云天皱。\n水静初澄，蓼红将醉，早秋时候。\n对庭前、萧索西风，惟有寒蝉高奏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水龙吟 秋思，次母忆旧之作，时父在都门 之二","author":"叶小鸾","text":"芭蕉细雨潇潇，雨声断续砧声逗。\n凭栏极目，平林如画，云低晚岫。\n初起金风，乍零玉露，薄寒轻透。\n想江头木叶，纷纷落尽，只馀得、青山瘦。\n且问泬寥秋气，当年宋玉应知否。\n半帘香雾，一庭烟月，几声残漏。\n四壁吟蛩，数行征雁，漫消杯酒。\n待东篱、绽满黄花，摘取暗香盈袖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其一 烟墩孤树","author":"佘翔","text":"海上旧烟垒，频年罢举烽。\n但有孤树影，带月舞龙钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其二 海寺疏钟","author":"佘翔","text":"墟里黄昏候，投林鸟雀哀。\n渡头钟隐隐，风送普陀来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其三 白水渔歌","author":"佘翔","text":"一水接沧溟，六鳌秋可钓。\n试听欸乃歌，吾亦发长啸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其四 沧洲樵隐","author":"佘翔","text":"东海涌三洲，负薪堪自老。\n吾生澹荡人，更欲搴瑶草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其五 六桥夜月","author":"佘翔","text":"彷佛西湖上，烟波锁六桥。\n美人明月夜，好泛木兰桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其六 三江雪浪","author":"佘翔","text":"海门烟雾深，忽见秋涛起。\n欲折扶桑枝，乘潮去万里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其七 榕阴连陌","author":"佘翔","text":"积翠尽阴阴，风吹十里响。\n上栖白鹭群，下映青苔壤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其八 涧水流花","author":"佘翔","text":"淙淙涧里水，不啻鸭头绿。\n有时流落花，疑是桃源曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其九 平畴三塔","author":"佘翔","text":"宝塔镇东方，亭亭三鸑鷟。\n云中挂暮蟾，海上射朝旭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲十景 其十 芳树孤台","author":"佘翔","text":"嘉树郁成阴，孤台眺苍莽。\n长笑似苏门，白云自来往。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉阶怨","author":"佘翔","text":"玉阶无人行，监宫日日扫。\n夜来望四星，白露沾秋草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"葛仙井","author":"佘翔","text":"昔时炼液人，凿井湖山侧。\n即今井中泉，犹带丹霞色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]