[{"title":"送人之辽阳 其一","author":"区大相","text":"北风十日吹胡桑，貂裘为客去渔阳。\n马上宝弓如满月，腰间匕首似悬霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人之辽阳 其二","author":"区大相","text":"吴客酣歌出蓟门，阴山猎火照河源。\n因声寄语辽西将，今日胡儿正负恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别山上人以佛前盆菊见贻","author":"区大相","text":"净土移根供佛前，本来幽意合栖禅。\n从今处士山窗下，日对楞严诵几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同林咨伯汪公干黄汝纶秋日僧房对菊 其一","author":"区大相","text":"停策僧家茗椀香，西风扫叶满绳床。\n官閒每有寻幽赏，静对寒丛开竹房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同林咨伯汪公干黄汝纶秋日僧房对菊 其二","author":"区大相","text":"纵酒由来欲废禅，寻僧又复到篱边。\n不分秋色谁为主，自抱幽閒结净缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同林咨伯汪公干黄汝纶秋日僧房对菊 其三","author":"区大相","text":"蓬鬓西风几岁华，禅堂啜茗对丛花。\n相逢斗酒无三径，倚杖西林日又斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送即墨赵丞","author":"区大相","text":"即墨遗封渤海头，齐城七十照高秋。\n更须龚遂收耕犊，不用田单教火牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入西山 其一","author":"区大相","text":"山叶初齐水满汀，晓风吹雨过湖亭。\n泉声只在花深处，不是閒人不解听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入西山 其二","author":"区大相","text":"寻山累日踏花行，讲席香台积渐平。\n钟磬寥寥水南寺，乱泉犹作雨花声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过友人玉河官舍","author":"区大相","text":"玉河草色正薰衣，下马官斋昼掩扉。\n客共主人清话久，莺啼深处雨霏霏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送范子乔还杭 其一","author":"区大相","text":"钱塘佳丽古名都，行乐他乡得似无。\n弦管楼边花柳暗，赠君呼酒过西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送范子乔还杭 其二","author":"区大相","text":"故人家在上湖滨，二月湖光思杀人。\n君过六桥携酒觅，桃花犹似去时春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁武库赴临洮 其一","author":"区大相","text":"男儿报难在沙场，八月边秋塞草黄。\n帐下千声期灭虏，军前杀气已淩霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁武库赴临洮 其二","author":"区大相","text":"擒胡必用金城策，破虏还须武库才。\n毳幕远移青海曲，羽书先过白龙堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平胡曲 其一","author":"区大相","text":"休兵解甲卧沙场，归马离鞍苜蓿香。\n报导将军百战力，欢传天子万年觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平胡曲 其二","author":"区大相","text":"汉将乘秋西击胡，阴风万里扫穹庐。\n海涛怒作三军气，沙雁排成八阵图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从军行 其一","author":"区大相","text":"鸊鹈刀映角端弓，生长沙场胆气雄。\n上马扬鞭辞不顾，边书夜出建章宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从军行 其二","author":"区大相","text":"雪花千里乱飘蓬，逐虏阴山已灭踪。\n白草黄沙经百战，自怜犹觅酒泉封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从军行 其三","author":"区大相","text":"焉支山外黑云连，翡翠楼中明月悬。\n未听胡笳先下泪，行人无事莫临边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居作长庆体兼劝诸少年 其一","author":"区大相","text":"桂楫兰裾学采莲，妖童艳妓斗花妍。\n江乡往日何曾见，云是东吴游冶船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居作长庆体兼劝诸少年 其二","author":"区大相","text":"闻道先朝卿相家，方袍革履衬乌纱。\n不知此事何时变，昨日仙裳出看花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居作长庆体兼劝诸少年 其三","author":"区大相","text":"红颜过后白髭须，年少无何便老夫。\n久知人意会憎老，此事君能免得无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居作长庆体兼劝诸少年 其四","author":"区大相","text":"鸟语花容各自成，老夫那得太无情。\n茶炉药椀竹间榻，随分随缘过此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居作长庆体兼劝诸少年 其五","author":"区大相","text":"半亩方园一草庐，三杯浊酒满床书。\n觉来名教真堪乐，意不求多愿有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿山歌 其一","author":"区大相","text":"中宿山头一望乡，猿声今夕更沾裳。\n近来潮水全无信，借问郎心有底忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿山歌 其二","author":"区大相","text":"客帆山寺两依依，闻道飞来便欲飞。\n若使客帆同此寺，不烦一宿也能归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿山歌 其三","author":"区大相","text":"江帆江鸟晚争回，溪月溪烟处处催。\n闻道蓬莱又清浅，归心那得夜潮来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出寺","author":"区大相","text":"山院鸣钟日巳昏，僧房虽近隔啼猿。\n回看行处疑无路，一带溪烟锁寺门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣江曲 其一","author":"区大相","text":"章水西连贡水回，橹声摇过郁孤台。\n储潭庙里赛神出，几片香烟树杪来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣江曲 其二","author":"区大相","text":"一滩险过一难来，乱石拦江一线开。\n喷雪奔涛三百里，游心多向此中灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣江曲 其三","author":"区大相","text":"嶕石崚嶒障逝波，鹧鸪啼处女郎歌。\n滩流已隔梅关远，犹问还家路几多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣江曲 其四","author":"区大相","text":"天柱滩连惶恐滩，南来此是利名关。\n行人不怕波涛恶，来过滩头重载还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣江曲 其五","author":"区大相","text":"二日看山快旅情，不知虚骇已多经。\n傍人莫怪舟行稳，来往溪禽识使旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行江上日望舍弟南归信息 其一","author":"区大相","text":"自尔封书作逐臣，天涯消息望归人。\n不信江头芳草色，故园犹有棣华春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行江上日望舍弟南归信息 其二","author":"区大相","text":"莫怪春来会面稀，风尘从古事多违。\n君南我北皆流涕，出处何须问是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行江上日望舍弟南归信息 其三","author":"区大相","text":"共道批鳞罪有馀，主恩翻得守田庐。\n渔樵久定归来计，不待逢人更卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北行江上日望舍弟南归信息 其四","author":"区大相","text":"得承严谴是恩波，去国还家思若何。\n莫道故园春事少，古来迁客岭南多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22892,"sha256":"dc0f9be95fde68d0587a89f7f11526