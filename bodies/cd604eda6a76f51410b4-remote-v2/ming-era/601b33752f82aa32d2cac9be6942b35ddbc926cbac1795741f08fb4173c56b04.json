[{"title":"卧梅","author":"区大相","text":"树老堪眠壑，根危尚著花。\n倒崖疑雪岸，卧涧似星槎。\n山月低还照，溪烟压更斜。\n啾嘈双翠羽，何事梦瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古梅","author":"区大相","text":"铁干封苔古，铅华试粉新。\n傍松同偃蹇，倚石共嶙峋。\n根老不知岁，花开常占春。\n犹馀芳韵在，宜赠素心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采药朱使见访山中","author":"区大相","text":"独坐空山晚，长吟碧草春。\n忽传采药使，来访入林人。\n朋酒聊开径，方书共拂尘。\n悠悠京洛事，疑是梦中身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏荼蘼 其一","author":"区大相","text":"传来西域水，不及中园芳。\n芍药含风细，玻瓈承露香。\n着衣经月气，簪鬓压时妆。\n玉手亲逢摘，霞光流洞房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏荼蘼 其二","author":"区大相","text":"弱艳风偏舞，新茎露未晞。\n姣容胜桃李，多刺似蔷薇。\n香送砗璖椀，春生翡翠帷。\n犹言看未足，折以赠南威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜微雨听侍以箫合琵琶","author":"区大相","text":"春院雨沉沉，春愁带夕阴。\n更堪丝与竹，并起度前林。\n吹作玉堂引，弹为关陇吟。\n乘鸾将别鹄，持底感人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤崔谢","author":"区大相","text":"流落还词客，飘零见此曹。\n文家存选体，乐府失风骚。\n归榇黄河曲，招魂涨海涛。\n才名身后事，汝岂没蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客有以短箫和琵琶者与梁少仲黎君玺共赋","author":"区大相","text":"嬴女骋游思，胡姬含别哀。\n悲随鹄远去，欢逐凤飞来。\n丝竹有馀感，凄清多妙裁。\n何因谢玉塞，联翅返秦台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四兄园馆新成喜赋 其一","author":"区大相","text":"村居嫌未僻，隔水见精庐。\n胜地云烟外，高情翰墨馀。\n披花时进艇，倚树日看书。\n数过亦何事，清言常晏如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四兄园馆新成喜赋 其二","author":"区大相","text":"如何千古意，独在此林间。\n野竹临流水，溪烟上远山。\n笔床依岸置，书牖隔云关。\n虽赋高闲性，如兄宁久闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始兴江口别庆儒嘉诸侄","author":"区大相","text":"送棹逾千里，归流挟一航。\n功名当力勉，离别莫情伤。\n寒雨芸窗夕，春风玉树行。\n此时频忆汝，书札报行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠亮上人","author":"区大相","text":"久作双林客，仍参五叶禅。\n愿深能化俗，行苦更随缘。\n坐处苔生石，行时杖出泉。\n但持心印在，莫问几灯传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻两胡生亡","author":"区大相","text":"海内无多士，交游失二胡。\n文章才有数，磊落调元孤。\n世已哀词客，人犹病酒徒。\n哭君馀两地，寂寞向江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟过南浦伤胡孟韬","author":"区大相","text":"关情南浦路，生别已凄然。\n风雨怀人地，江湖哭友年。\n斗间气已没，稷下誉长悬。\n寂寞徐祠侧，谁令高士传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"日暮旅怀","author":"区大相","text":"竹日幽幽暮，松云靡靡阴。\n寒蟹多傍水，夕鸟未归林。\n岸势冲烟断，江流带雪深。\n寄书南下雁，传语故山心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖上望来雁","author":"区大相","text":"征路逢南雁，相看万里途。\n摇摇经远塞，历历向重湖。\n阵结江云暮，声含海月孤。\n故园关树隔，回望几停舻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又作此寄林宣平","author":"区大相","text":"闻子弦歌处，名山得括苍。\n吏情如素习，宦路即康庄。\n城挟千峰小，天悬列宿光。\n当勤唐抚字，去作汉循良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙井寺片云亭","author":"区大相","text":"旧寺临流水，新亭坐夕曛。\n乱篁森度岭，片石郁生云。\n碧岫连湖尽，春泉过涉闻。\n犹馀下山磬，相送出林氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"携酒偶入包氏园亭 其一","author":"区大相","text":"避石开林浅，疏泉绕径长。\n过桥分柳色，攀阁散梅芳。\n涧溜经庭内，峰云起座傍。\n无言暂时赏，尘虑欲俱忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"携酒偶入包氏园亭 其二","author":"区大相","text":"幽怀随地足，真赏出天成。\n水石因依巧，林亭结构清。\n杂花笼小径，深竹隐疏楹。\n自省闲来往，何心待送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京师苦雨作 其一","author":"区大相","text":"帝城阴晦积，宫路水云宽。\n祇道天为漏，何时上得乾。\n潦侵三辅阔，溜挟九陵寒。\n却忆怀襄世，居然悲念攒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京师苦雨作 其二","author":"区大相","text":"入夏多霪雨，经秋未肯晴。\n直须忧地陷，无计补天倾。\n方割伤民瘼，其咨轸帝情。\n古来尧命禹，天地乃平成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自夏徂秋苦雨兼答张孟奇汪公干庄静父韩孟郁 其一","author":"区大相","text":"共有愁霖唱，偏多滞客情。\n密云屯近塞，高溜迸层城。\n行灶无黔突，朋车绝过声。\n何时披宿雾，见许过新晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自夏徂秋苦雨兼答张孟奇汪公干庄静父韩孟郁 其二","author":"区大相","text":"地下经时雨，云生累月阴。\n浴凫偏近砌，乾鹊漫依林。\n但恐高天坠，还愁大陆沉。\n祇馀檐溜响，时助客中吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子朋光禄解官南归","author":"区大相","text":"故人官不达，久欲赋閒居。\n忽见秋风起，翻然思旧庐。\n宁贪数升酝，定忆四鳃鱼。\n前路多归兴，江天鸿雁初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰闰九日显灵阁酒会 其一","author":"区大相","text":"闰序嘉重九，高秋会法筵。\n菊芳犹应候，桃发已经年。\n昔去人为鹤，今来海作田。\n仍看荐寿处，胜览出三天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰闰九日显灵阁酒会 其二","author":"区大相","text":"凤阁携真侣，龙山接胜区。\n重持黄菊酒，高眺白云衢。\n甘露披林玉，秋花散蕊珠。\n徒言寻白社，何似访玄都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小年夜诸客过集","author":"区大相","text":"独有颓年感，偏逢故旧欢。\n壶觞迎小岁，灯火候仙坛。\n正直平生是，飞腾晚暮看。\n宁因祠灶礼，名姓动天官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕诸客见过守岁","author":"区大相","text":"杯酒临除夜，能禁晚暮嗟。\n愿逢新节序，莫改旧容华。\n岁往偏宜守，春来不待赊。\n年年帝城里，文字老生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日小集","author":"区大相","text":"人日阴晴半，壶觞事亦宜。\n薄云呈霁景，微霰带寒姿。\n花气窥林浅，莺声出苑迟。\n春光犹未觉，为报万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谷日晴","author":"区大相","text":"谷日更宜晴，晴知百谷成。\n人情先卜岁，禽语已催耕。\n冻渚蒲芽短，春畦菜甲明。\n惟欣田舍酒，归与老农倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李进士南还毕姻兼宰连城","author":"区大相","text":"闻道乘龙客，新誇片玉名。\n去乘冰未泮，归捧雁亲迎。\n才子年方少，郎官宿更明。\n仍瞻凫舄影，来伴凤凰鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赋得并蒂花送李进士归娶","author":"区大相","text":"庭前并蒂枝，蚤映合欢帷。\n叶引承筐至，花邀卜凤窥。\n连芳桃李径，交影鸳鸯池。\n何必丝萝结，根株长不移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元之夕星月朗然夜半阴雨以去岁中秋验之亦先晴后雨","author":"区大相","text":"中秋与元夕，隔岁验晴阴。\n九陌灯光静，千门雨气沉。\n秋期犹在眼，春色漫愁心。\n为问繁华子，香车何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙巳午日作 其一","author":"区大相","text":"嘉候维中数，披图验国祯。\n缕增王者寿，镜助圣人明。\n众草随风靡，孤葵待日倾。\n欲除天下恶，臣愿赐枭羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22365,"sha256