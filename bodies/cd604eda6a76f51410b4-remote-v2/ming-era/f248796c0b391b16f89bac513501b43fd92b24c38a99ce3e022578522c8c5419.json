mmit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其一","author":"曹于汴","text":"楚弱刘强东逝波，铜山金谷总消磨。\n啼莺莫向窗前枕，无限荣华正梦柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其二","author":"曹于汴","text":"七尺身躯一粒沙，年来病竖苦相加。\n吾将一笑攀明月，白玉京中别有家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其三","author":"曹于汴","text":"昨夜狂风万水号，如从三峡听江涛。\n垂云隔在应凭取，飞入天门兴转豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其四","author":"曹于汴","text":"风高犹自怯衣单，华岳峰头四望宽。\n万国洪垆悲正炽，银潢泻却与清寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其五","author":"曹于汴","text":"采药时从陌上还，床头欹枕看青山。\n一腔热火风吹去，欲向忙人卖个閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其六","author":"曹于汴","text":"梦里分明玉帝旁，骑龙驾虎任翱翔。\n回头世界些儿大，不是争蜗是怒螳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其七","author":"曹于汴","text":"万里黄河一线流，茫茫大地水中沤。\n非非是是莫相聒，一夜西风欲白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其八","author":"曹于汴","text":"石桥桥畔濯沧浪，高柳阴浓足午凉。\n野老班荆情共适，无人识是琐垣郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其九","author":"曹于汴","text":"累累高冢傍河涯，古碣苔封半欲欹。\n惟是银珰曾不拜，百年处处口为碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其十","author":"曹于汴","text":"十里郊原信步游，每逢嘉树且休休。\n旌旗却忆长安道，潇洒终应此日优。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其十一","author":"曹于汴","text":"陇头小坐说当年，逐牧随农过绿阡。\n人是旧人穷亦得，乌沙难道漆同坚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其十二","author":"曹于汴","text":"半生炊黍未全醒，羸体相看便不宁。\n非是贪官非爱寿，个中不了为惺惺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其十三","author":"曹于汴","text":"春老园花秋近枝，黄昏相对泪交颐。\n如天事大关情切，惟有清风明月知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其十四","author":"曹于汴","text":"盂水昨宵梦化金，灵台帝主窒吾心。\n杨家夜却寻常事，蚁穴能令江汉深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北园十五首 其十五","author":"曹于汴","text":"岸裂澜狂涨若湖，且沉且起赖残壶。\n中流力尽波仍急，尼父空中笑欲扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避暑姚馆漫题 其一","author":"曹于汴","text":"邸报传来莫叹呀，长安从昔此纷拿。\n飞霜堕雪皆天意，到得东风自放花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避暑姚馆漫题 其二","author":"曹于汴","text":"草有千般花万丛，形形色色也难同。\n负心唾面都由彼，不向人间竞楚弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]