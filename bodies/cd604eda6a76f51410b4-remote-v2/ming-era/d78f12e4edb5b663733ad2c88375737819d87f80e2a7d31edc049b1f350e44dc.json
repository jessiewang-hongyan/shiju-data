ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题写竹赠陈九我 其一","author":"龚诩","text":"记得淇园带雨移，春风又见长孙枝。\n夜来月映南州榻，一段高情孰许知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题写竹赠陈九我 其二","author":"龚诩","text":"邂逅相逢酒一樽，清风明月满柴门。\n长安道上尘如海，不到江南水竹村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"龚诩","text":"生绡一幅写烟萝，燕尾蜂腰曲折多。\n最爱小桥杨柳外，可能容我著渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画竹赠袁宗鲁","author":"龚诩","text":"落花飞絮自纷纷，岁晚相看独此君。\n却忆西斋明月夜，满窗清影共论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹦鹉","author":"龚诩","text":"身系雕笼翠羽摧，故山千里梦中回。\n如何性识誇灵慧，不悟能言是祸媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕","author":"龚诩","text":"春风茅舍两乌衣，花径芹塘任意飞。\n自与主人相识旧，不唯鸥鸟解忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4