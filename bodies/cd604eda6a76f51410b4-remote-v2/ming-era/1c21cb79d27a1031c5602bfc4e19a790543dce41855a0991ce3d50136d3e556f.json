[{"title":"七夕江月　距立秋前有六日","author":"郭之奇","text":"江远摇凉月，影分天汉流。\n弦光低鹊渡，机石拂蟾钩。\n巧向何人得，槎因使客浮。\n祇怜欢夜短，此夕未为秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十四夜泊繁昌旧县镇","author":"郭之奇","text":"月自无而满，风惟西与南。\n秋光时可掬，天意日难探。\n绿岸同舟懒，青山对客憨。\n羁人甘寂寂，或恐使星惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汉川秋怀","author":"郭之奇","text":"垂耳悲劳骥，冥飞羡逸鸿。\n及兹游远日，方见出门功。\n招隐怀幽桂，歌骚变落枫。\n沧浪何处叟，此调或相同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十七早晓发虚江","author":"郭之奇","text":"落月衔山白，归帆出树青。\n新凉烟抱石，欲晓影摇汀。\n醉梦滩声破，昏愁鸟语醒。\n披衣成独对，云水自泠泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雩都山行","author":"郭之奇","text":"秋嶂青无几，合色始纷纭。\n积爽招遥黛，含凄散窈云。\n浅深环径别，阴霁百峰分。\n日暮孤村见，疏篱已落曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大宁晓发","author":"郭之奇","text":"玉露团深巘，征人拂晓裾。\n梯盘窥鸟道，穿穴探猿居。\n烟合疑松卧，泉幽听谷歔。\n赪颜得素术，飞液正堪茹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春雨晓对","author":"郭之奇","text":"花雨销红色，春潮转碧芳。\n清晨观物变，闭户息时光。\n独令幽怀远，因知隐趣长。\n深居非避世，不敢向人忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨宿 其一","author":"郭之奇","text":"孤吟明独对，耳目作生涯。\n雨宿闻啼鸟，风前中落花。\n无营春愿足，即事晓因加。\n静色烟光外，幽情欲共遐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨宿 其二","author":"郭之奇","text":"晓寂堪无虑，所思忽复长。\n拙愁因景逼，痴懒怪时忙。\n个个啼莺怨，双双舞蝶狂。\n撩情若在酒，凭此醉春光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙亥北征至分关却望","author":"郭之奇","text":"出门山导客，及此与云深。\n俯视苍茫接，遥看碧落沉。\n岐峰迷别绪，洄涧落乡心。\n万里伤魂处，离初泪不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过上杭陈扆六相招夜集自述两令坎壈事诗以慰之兼志别悰 其一","author":"郭之奇","text":"频年离索感，偶对语飘零。\n已见君头白，犹求世眼青。\n可怜逢故识，仍使叹晨星。\n夜尽倾前绪，游人驻马听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过上杭陈扆六相招夜集自述两令坎壈事诗以慰之兼志别悰 其二","author":"郭之奇","text":"君归竭俸钱，杯酒客心怜。\n此地青山色，当年塞北烟。\n不因时坎壈，谁与日林泉。\n感昔姑相慰，离悰倍黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过清江晤陈建侯主簿走笔书赠","author":"郭之奇","text":"垂白西江簿，当年南岭英。\n知君能自勖，逢世少同声。\n淹泊斯文色，蹉跎此宦情。\n但存高士节，尚得古人名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊洪都赠何蜚鸣","author":"郭之奇","text":"常于天下士，特达问宗因。\n世道今同见，寸心夙自真。\n爱君风义笃，令我气声亲。\n三载流洄处，西江一故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和江上","author":"郭之奇","text":"万古天堑水，当前客绪悠。\n连空堪四望，落日自多愁。\n岁月同滔没，阴晴别应酬。\n劳心时不舍，难向逝波遒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将至采石矶飘风骤发收舟不及泛泛江中者移时诗以志险用前韵","author":"郭之奇","text":"倏忽诸山动，飘零一叶浮。\n风涛观素履，忠信任虚舟。\n不历鲸波变，安知鲛泣愁。\n平生夷险故，事往默追求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"久棹","author":"郭之奇","text":"久棹江情备，周流心目知。\n云山开气象，风雨幻灵奇。\n非海应难水，连天不易涯。\n自疑萍转客，万里日追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋九青给谏将联诗社诗以商之三首 其一","author":"郭之奇","text":"冥思兼旷览，求应总纷纷。\n雅颂如能得，兴观亦可群。\n倾谈初束帛，豁意已披云。\n默尔精魂感，相同独向君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋九青给谏将联诗社诗以商之三首 其二","author":"郭之奇","text":"联心分一砥，执耳问初盟。\n大雅微茫日，王风次第明。\n兴衰宁大运，终始在元声。\n细察推移理，思君练要情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋九青给谏将联诗社诗以商之三首 其三","author":"郭之奇","text":"移风真首务，观世本文心。\n历探情声始，返思得失林。\n欲求人尽我，不令古无今。\n一往同孤尚，千秋讵可禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上陵道中","author":"郭之奇","text":"出郭明孤性，相招已白云。\n千峰收晓眺，万壑动秋氛。\n气势遥相长，精光近若群。\n龙湖天意笃，灵岳自氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪祀昭陵","author":"郭之奇","text":"霜露秋思肃，林峦暮色封。\n苍玄归化迹，丹紫变深峰。\n瑞蔼环弓剑，灵扃闭鼓钟。\n萧萧悽怆夜，奔走向楸松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归道取西山是夜宿碧云","author":"郭之奇","text":"山因秋澹泊，静理作游心。\n策马排云至，看鸿带月深。\n草烟迷础色，松响触泉音。\n耳目谁能着，安禅入梦寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"是早过香山","author":"郭之奇","text":"古寺烟疑渍，孤光近远同。\n晴苔深夙露，寒树老秋风。\n畜爽无昏旦，衔幽自色空。\n璃灯初一照，顿令皈依终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"来青纵目","author":"郭之奇","text":"千山供一览，眼尽即云天。\n聚霭高卑错，巉阴右左悬。\n髻当斜照阙，襟抱反吹前。\n睥睨真何际，微茫得又玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洪光松盘","author":"郭之奇","text":"偶循苍径入，已在绿云堆。\n晓磴旁阴合，寒烟一缕开。\n交巾低密翠，折屐远轻埃。\n静里钟声发，还同吹万来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉泉观源","author":"郭之奇","text":"入山不必深，一壑可幽寻。\n止岫含奔涧，回堤吐漭音。\n蓝光飞玉注，碧潋伏珠沉。\n对此能朝夕，清颜或洗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万庄稍憩","author":"郭之奇","text":"罢游因晚兴，花坞得秋颜。\n霜叶红相胜，云林绿未删。\n较山微绮丽，踞野亦深閒。\n夕照寒峰外，何人此未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再督两馆感昔","author":"郭之奇","text":"两阶依日月，万里合风云。\n有道夷为守，脩名远不勤。\n方期成序至，敢谓后时闻。\n却省尸瘝罪，还思告让文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜朝鲜来贡","author":"郭之奇","text":"圣代时称广，东夷岁职方。\n再看垂櫜至，始信薄来常。\n自抱珍奇耻，非关训导章。\n微臣循旧则，夙夜诵无荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"以仲冬月转本司副郎自述","author":"郭之奇","text":"一官仍典属，三载见咸宾。\n斯亦观生进，即于与客频。\n知名宁远域，束带是皇臣。\n聊幸当重译，长应备舌人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饱食卒岁因之自警四首 其一","author":"郭之奇","text":"匡居能竟日，今始识閒曹。\n静觉餐仍素，谁云酒目劳。\n殷忧多若醉，嗛食少为膏。\n手口徒相息，心颜几忸陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饱食卒岁因之自警四首 其二","author":"郭之奇","text":"职思方岁莫，饮食视云需。\n怀肉曾誇剑，分羊复耻钩。\n饥犹存季女，饱欲死侏儒。\n簌簌何人者，还誇谷有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饱食卒岁因之自警四首 其三","author":"郭之奇","text":"日月将穷节，民神合聚时。\n鱼冰坚泽腹，蚕火照田丝。\n观蜡因人乐，退公或自私。\n作糜名口教，授粲岂徒期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饱食卒岁因之自警四首 其四","author":"郭之奇","text":"谋食非君子，观颐及万民。\n尝思分社肉，每叹治齐醇。\n微术经天下，有孚视一身。\n饔餐馀妙理，况可付昏晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邹石可出守襄阳三首 其一","author":"郭之奇","text":"欲别春风半，离心楚地悠。\n行当芳草色，往见白蘋秋。\n雁影荆门落，狼烟汉水收。\n此时能却望，应忆故人游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邹石可出守襄阳三首 其二","author":"郭之奇","text":"昨从燕黍谷，出问楚筳篿。\n转律阳春日，操弧翼轸天。\n方城堪众禦，万灶待君烟。\n及此鸣庚始，还加五马鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邹石可出守襄阳三首 其三","author":"郭之奇","text":"近说襄阳地，古今人事分。\n习池当祖道，羊石但征云。\n岘泪馀初迹，䍦歌失旧闻。\n俟君盘错见，山水未离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"国计","author":"郭之奇","text":"农臣思国计，望屋急军前。\n多取难因岁，三征不问田。\n为都皆可去，署考孰能先。\n勉语沟中瘠，扶疮向朴鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"主恩","author":"郭之奇","text":"主恩权用缓，兵火赐田租。\n意动天人感，膏同雨露濡。\n汉书先父老，周政始鳏孤。\n取次三春泽，还思四海俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时难","author":"郭之奇","text":"王心因岁省，天步值时难。\n云汉初回象，山川自改观。\n黍苗兴旱月，衣褐慰祁寒。\n造命明君事，流灾那可宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旰食","author":"郭之奇","text":"年饥思赈术，旰食作含哺。\n阍远今如近，天高日可呼。\n去郊安硕鼠，瞻屋定飞乌。\n叹息穷闾贱，深劳圣主图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其一 徵兵","author":"郭之奇","text":"固垒逍遥卒，夷丁杂汉群。\n将骄人命贱，寇退首功分。\n暮野生燐火，春郊老阵云。\n相传今面敌，稍见祖家军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其二 措饷","author":"郭之奇","text":"粟行将万里，刍竭自何年。\n枵腹难终俟，遣苞孰共前。\n方敲民骨髓，稍给士糇饘。\n为语三军众，飞腾莫自便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其三 防河","author":"郭之奇","text":"颓云朝夕压，坚腹近遥淩。\n树介征麾变，霜阴杀气凝。\n旟旐来豹幄，组练杂渔罾。\n游釜何人者，投鞭那可矜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其四 城守","author":"郭之奇","text":"恃险舟皆敌，脩文守在夷。\n时危难远语，效死必城为。\n有意求蛙产，何心问茧丝。\n繇来人志结，不使地天移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其五 分险","author":"郭之奇","text":"务隘当分扼，先人作战筹。\n联心惟谨养，弭耳贵专谋。\n有地因民守，无形令敌愁。\n悬思千击万，险阻庶全收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其六 合围","author":"郭之奇","text":"使寇如流溃，何兵可障川。\n五行迷克土，八载任滔天。\n背水人俱怯，壑邻计久偏。\n虚声求胜势，群力总波漩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其七 老师","author":"郭之奇","text":"玄黄当久战，朝野共无衣。\n师老民从毒，兵钝贼见几。\n中枢迟上策，专阃积轻威。\n不识縻军是，谁云尾寇非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其八 策抚","author":"郭之奇","text":"弄兵宁异昔，逸火庶非今。\n渠胁分群命，死生问一心。\n井闾还旧有，牛犊可新寻。\n倘及阳庚日，春风散绿林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其九 传烽","author":"郭之奇","text":"极目平安火，乡云白似红。\n朔风悲立马，南雪滞征鸿。\n燐野荒寒日，腥川恣渴虹。\n天涯微宦客，愁坐似羁笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵事十首 其十 露布拟而期之也","author":"郭之奇","text":"连阃歌铙日，深宫动乐晨。\n乾坤将厌杀，城野共还春。\n夜影销欃焰，朝书出战尘。\n尚期三捷至，先系百渠陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"季春十日姚永言招同黄可远宋九青夜集谈诗微商同异三首 其一","author":"郭之奇","text":"谬附东南美，君前见古今。\n连杯存酒意，聚首出文心。\n交岂声坛重，时当宦海深。\n试将清夜语，还赋白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"季春十日姚永言招同黄可远宋九青夜集谈诗微商同异三首 其二","author":"郭之奇","text":"惊坐初雷殷，虚怀永夜怡。\n同声堪异响，故友合新知。\n泣鬼千年后，风人百代移。\n多言妨古秘，三口借君卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"季春十日姚永言招同黄可远宋九青夜集谈诗微商同异三首 其三","author":"郭之奇","text":"春夜融如水，因人共与清。\n波澜从酒动，原委向诗明。\n河汉虽无极，山泉各自生。\n繇今看末砥，何似一杯平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅邸抄见晋中闻喜沁原等县开立人市至父子夫妻相食又豫中南阳母子相食随奉明纶前后发御前银五万馀遣使星夜解往设法救济感叹有作四首 其一","author":"郭之奇","text":"易子春秋讳，分翁楚汉欺。\n犹言家不计，或在势难支。\n今日虽荒馑，皇恩积岁时。\n伤心沟壑际，竟作兽人为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅邸抄见晋中闻喜沁原等县开立人市至父子夫妻相食又豫中南阳母子相食随奉明纶前后发御前银五万馀遣使星夜解往设法救济感叹有作四首 其二","author":"郭之奇","text":"兽食人犹恶，民饥兽所怜。\n官言终坐毙，帝念久颠连。\n昃日分宫膳，飞云入灶烟。\n救荒十二策，谁似主心先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅邸抄见晋中闻喜沁原等县开立人市至父子夫妻相食又豫中南阳母子相食随奉明纶前后发御前银五万馀遣使星夜解往设法救济感叹有作四首 其三","author":"郭之奇","text":"臧圭行急病，汲节矫便宜。\n自古贤臣事，于今圣主思。\n收人宁问乏，遣使尚忧迟。\n疋帛宫中数，惟民不计赀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅邸抄见晋中闻喜沁原等县开立人市至父子夫妻相食又豫中南阳母子相食随奉明纶前后发御前银五万馀遣使星夜解往设法救济感叹有作四首 其四","author":"郭之奇","text":"移民终小惠，罪岁始多侵。\n当道矜豺虎，驱人忍兽禽。\n何官思野色，惟帝达天心。\n真切流膏下，兼闻引痛音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟秋十六日于役天中与黄赞伯联辔有述二首　时虏氛方逼近畿 其一","author":"郭之奇","text":"治行千里日，求士两河时。\n日月方交斗，风云未改期。\n阶前辞舞羽，马上听谈诗。\n结束依戎伍，何人识主司。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟秋十六日于役天中与黄赞伯联辔有述二首　时虏氛方逼近畿 其二","author":"郭之奇","text":"诘戎非不急，文事岂虚求。\n将与戈予客，兼同表饵谋。\n因之观士报，终以太儒猷。\n济济中原俊，谁忘普率雠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自感二首 其一","author":"郭之奇","text":"日月难因世，乾坤孰置身。\n在三从属我，未一所求臣。\n争大宜心竞，持危视力陈。\n祇今言报国，何事可为人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自感二首 其二","author":"郭之奇","text":"说剑求欧冶，读书与斲轮。\n纵横思计就，文武择能陈。\n世合轻儒术，时方倚斗臣。\n峨冠虽未解，交椊亦其人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淇水古意","author":"郭之奇","text":"停车淇水上，古意见秋风。\n绿竹诸君子，白圭一武公。\n千年称睿圣，当日自童蒙。\n非哲非愚者，庶几三复终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闱中第三场有鹤集鸣明远楼当事索言纪瑞","author":"郭之奇","text":"天中明远楼，楼上鹤鸣秋。\n何日遵鸿渚，先时引鹿呦。\n在阴縻爵见，闻野向皋浮。\n云路从朝翼，嵩河特近游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐阅卷毕循步阶櫩仰象有言","author":"郭之奇","text":"肃然秋夜对，起视已星陈。\n心目无穷止，菁华始逼亲。\n斗箕分极远，经纬九霄均。\n云汉垂垂下，天中烂客身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雨连日是夕拜榜既毕云烂星陈明月出焉是可纪也二首 其一","author":"郭之奇","text":"黾勉秋期竣，适当云汉清。\n光为君子吉，化以圣人成。\n豫野招贤见，宵中太乙明。\n灿然心目际，毋乃至文精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":35342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]