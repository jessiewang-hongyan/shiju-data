[{"title":"刘海村诗问次韵","author":"许相卿","text":"感叹壶头念少游，危踪到处浪淹留。\n青山食力荒三径，白首携家访十洲。\n夏半梅黄怜节物，雨深苔翠上衣裘。\n四郊战骨萦芳草，斜日孤城怯凭楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入春避地澉水秋尽还山西皋诗慰次韵","author":"许相卿","text":"寄迹荒城似谪居，还家病骨恋箯舆。\n山横雨翠秋容净，林缺霜红野眺舒。\n忧国多虞怀耿耿，信天定分意如如。\n独怜万卷成焦土，遗恨连艘失载书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分酒遗董汉阳依谢韵","author":"许相卿","text":"满城风雨怕开门，狼籍春泥少更分。\n缃帙散陈閒昼晷，山庐在望隔秋云。\n中军李牧谁今许，东海田横异昔闻。\n病思时艰徒懊恼，酒杯诗卷谩酣醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山游","author":"许相卿","text":"杞山秋高风日好，独扶藜杖步晴冈。\n达观浮世身如寄，任侠当年气自降。\n云水茫茫去鸟没，烟霞隐隐归樵双。\n清林孤眺坐成晚，遥见疏林明夜缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢别沈默斋","author":"许相卿","text":"僦居残夏入高秋，世难存身迹漫投。\n瘦骨棱层刓坐榻，故乡艰阻赋登楼。\n山中猿鹤多归梦，天末风烟倍客愁。\n万类两间同逆旅，远游还问武陵舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再别吕东汇","author":"许相卿","text":"涉历危途次水村，支离病骨傍人门。\n满林枫叶秋声碎，四壁寒螀夜语繁。\n客况春温怀地主，邻家社会忆乡园。\n卜携便觉情无限，回首霜空欲断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春暮怀王鹤山","author":"许相卿","text":"三月风光今又暮，四郊雨意喜全收。\n春愁无那凭桑落，午梦将成破栗留。\n乡国创夷谁侧席，故人丰采独登楼。\n空林暮色增惆怅，何日东冈续旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵苏叔豹见忆","author":"许相卿","text":"诗句远投多病客，野心无那不羁猿。\n秋来旷度频萦梦，老去端居独寤言。\n困鹤风云羞短翮，蹲鸱伏腊饱荒园。\n剡舟迟尔维星石，起我高谈雪浪翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨宿真如寺","author":"许相卿","text":"夜雨僧斋滞客舆，清灯高榻信吾庐。\n玄谈种种浮生外，茗碗深深坐醉馀。\n云路造天无款段，野情随地有华胥。\n廿年回首红尘梦，寒影空堂自爱予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初春海上","author":"许相卿","text":"积雨晨收好风日，瘦藤危屐试春袍。\n山中日月人空老，海上烟云兴独豪。\n隐约野芳初乱眼，郁纡幽思欲挥毫。\n咏归樵径者谁子，徙倚残阳首重搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐","author":"许相卿","text":"开门见月来松径，扫地移床傍石渠。\n寂历寒螀共清夜，咄嗟浮世托籧庐。\n黄虞道在生何后，沟壑盟寻老只初。\n一咏一觞还自笑，明时野调独迂疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋晚溪上","author":"许相卿","text":"坐占清溪瘦石双，风流想像鹿门庞。\n高歌草泽时空晏，卑睨云台气已降。\n老去閒愁消短榼，醉来佳句堕寒江。\n归舆伊轧松堂晚，零乱残阳上半窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日","author":"许相卿","text":"感时今日重阳节，扶病云村第一峰。\n黄菊深杯桑落酒，青山高帽日斜风。\n道违末俗空孤愤，诗与秋涛合并雄。\n忽忆苏门遥怅望，欲家辽海谢过逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓萧寺","author":"许相卿","text":"病客閒情与世疏，息肩聊得借僧居。\n梦残午枕莺声里，诗满桥亭野色初。\n经济有怀犹浪迹，乾坤到处是吾庐。\n十年世路尘劳障，来谒禅关得起予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜客对雨","author":"许相卿","text":"风雨茅堂入夜寒，一尊相对共清欢。\n盟深鱼鸟便林壑，病中烟岚痼肺肝。\n孤烛话残衣袖薄，小山赋就茗瓯宽。\n老怀时事频惊慨，意气相逢引剑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"下第归写怀","author":"许相卿","text":"官渡雨中归夜艇，舞雩风里弄春袍。\n九衢华毂不到梦，百亩荒菑自策劳。\n野性如僧安地癖，俗情无物破天韬。\n斜阳瘦影苍茫外，清兴寒山合并高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"麦山老人","author":"许相卿","text":"麦翁清时甘陆沈，踪迹迢迢烟雾深。\n石转醉眠月皎皎，松围晏坐秋阴阴。\n閒携只影云随屐，几见行人雪满簪。\n朝市语闻应洗耳，登高为赋考槃吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赵渐翁七秩初度有诗次韵奉寿","author":"许相卿","text":"忆昔天门曙色开，连翩并马直庐回。\n高翰徼外清风播，遐寿壶中紫气来。\n别圃序芳观物兴，平槎对景擅场才。\n村翁许入香山社，雅祝还称北海杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祝思允宅夜宴","author":"许相卿","text":"残阳隐地红炯炯，角巾弄影青离离。\n暝烟散空归鸟下，白露被野寒虫悲。\n剧谈杂出觞政乱，佳句欲吐灯花知。\n小人夙抱杞狂疾，假日偷欢同鷾鸸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答钟西皋","author":"许相卿","text":"闵雨长歌云汉什，得秋䞉有大田风。\n新凉病骨逡巡健，野水渔舟远近通。\n清梦有徵多胜事，旧题无处不尘笼。\n扶携拟踏西皋路，共采芙蓉带路丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答徐光泽","author":"许相卿","text":"一缄三月紫云湾，深迹栖迟鹿豕间。\n兆喜灯花符昔夜，擅场诗句破衰颜。\n病身遥谢金闺籍，草坐常从野老班。\n自爱山村凉意早，溪南枫叶未秋丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答钟西皋","author":"许相卿","text":"一声秋信叶边闻，早见西风度朔云。\n尘镜红颜吾丧我，雪舟清兴客怀君。\n壶头阅世时何晚，谷口耕岩日自曛。\n抚手知言千载上，苏门长啸有遗文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋夜湖舟对月","author":"许相卿","text":"一年好月是中秋，向夕呼船抱病游。\n大地清辉翻白昼，良宵幽兴属沧洲。\n湖山夜色孤篷远，天水寒光两镜浮。\n酣坐不知吟啸永，阑干北斗挂峰头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵溪翁春日天宁寺楼","author":"许相卿","text":"阑干徙倚雪晴初，十日东风百草苏。\n全晋夕烽清塞徼，片帆春兴满江湖。\n漫堤新水鸥前永，过雨遥岑雁外孤。\n千里河山閒放目，壮游曾忆赋三都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"村翁诗贺堂成次韵","author":"许相卿","text":"小筑岩居俯钓台，更亭绝巘望天台。\n入春穷谷还桃李，避地閒门自草莱。\n叩石商歌凉月上，捲帘沧海暮潮回。\n多情张老斯干颂，匝屋烟云为尔开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵钟西皋见忆","author":"许相卿","text":"落木残阳独倚楼，归云寒拥晚山稠。\n烟霏好语传双鲤，湖海閒身擅一丘。\n塞北戎心骄未格，江南民病愧先忧。\n孤灯长剑空三叹，衰鬓繁霜奈九秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送友","author":"许相卿","text":"棘寺高材起陆沈，翩翩白马向枫林。\n歌声相续山村静，别意无端江水深。\n千里霜威生画戟，孤城秋色上瑶琴。\n病夫怅望留无计，寒月荒郊后夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和西皋","author":"许相卿","text":"手启邮筒伐木篇，樵歌接响赖俱传。\n吟安七字雪髭短，梦醒半窗山月圆。\n澹泊閒心云共远，萧条生事俗无牵。\n岩头卜岁邻翁贺，冰柱阑干冻瀑泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南楼","author":"许相卿","text":"清吟独凭山楼晚，黄落空悲海国秋。\n遁世野情从弃置，安巢归翼自嘤呦。\n勋名梦断图烟阁，病力时看理钓舟。\n岁晏阴晴苦难料，竹椽桑土漫绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋晚登山","author":"许相卿","text":"衰病深村过客稀，经秋短布一衫衣。\n日边巧宦名争显，泽畔幽人见独非。\n薄暮云屏空翠重，疏林霜柿熟红肥。\n山头抱犊归来晚，历乱残阳满涧扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西皋先生季夏诗来俯慰寥泬仆病甚秋半差强展咏三复次韵谢兼简西村勾溪二翁","author":"许相卿","text":"怀人诗句绿阴暮，抱膝怡情红树村。\n木榻渐移当荫石，角巾时倚傍溪门。\n松阴晴景湖天迥，沙碛秋光海气吞。\n白发青山老知己，徘徊吟弄入黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉饯季父之永州倅依韵","author":"许相卿","text":"残日远峰明陆离，别情惆怅风前杯。\n竹林今古清风在，猿鹤东山首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山阁","author":"许相卿","text":"衫浥岚光先雨润，树酣江气未秋丹。\n飞流千尺凭阑外，并作萧萧六月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春病","author":"许相卿","text":"山日冥濛笼野烟，碧桃红杏斗春妍。\n老夫独负看花约，布被蒙头白昼眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪兰","author":"许相卿","text":"金谷妍华空毁垣，国香冰霰自孤根。\n辋川强项芭蕉伴，共谢东皇费手援。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泊钜野","author":"许相卿","text":"冻云寒月递昏明，游子踌躇怯远征。\n身在畏途亲在梦，魂消飞霰打篷声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋晚","author":"许相卿","text":"远浦长霞弄晚晴，钓丝摇飏拂沧瀛。\n幽怀自适无谁语，寒日秋波尽意明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"简瞻仲乞醉翁床","author":"许相卿","text":"醉翁床乞病翁眠，瘦骨今年减旧年。\n欹枕更无蕉鹿梦，面屏时学野狐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越人遗屐","author":"许相卿","text":"三年病縳登山脚，一两邮传过海缄。\n自笑元非珠履客，正须云磴踏巉岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"勾溪和什来再用原韵","author":"许相卿","text":"梦断纷华几岁年，烟云况味只萧然。\n草玄茟砚消长昼，今雨都忘旧雨船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归梦","author":"许相卿","text":"故山秋老亲闱冷，游子夜长归梦多。\n独倚苍茫动幽兴，却惭容易脱渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归期","author":"许相卿","text":"归期屈指已无多，木叶萧萧笠泽波。\n只尺三高英爽在，笑侬怀檄又经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈公桥","author":"许相卿","text":"两涯寒碧成周道，千尺晴虹跨水云。\n别浦归人多怅望，斜阳搔首剧思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过扇依韵","author":"许相卿","text":"秋风桂子又三年，阿过寒窗笑上竿。\n赖得郎罢迂阔甚，抡魁原作技儿看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凭几","author":"许相卿","text":"海宇浮云几去来，山村佳处独裴回。\n春光已谢还秋信，天只峰头梦未回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"尾溪","author":"许相卿","text":"海上烟云朝暮奇，山中日月了残棋。\n秋来无那顽腰脚，得句寻僧过尾溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日雨嘲客负约","author":"许相卿","text":"雨作重阳妒胜游，登山有约望来不。\n却怜剡客能高兴，风雨漫天夜放舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画寄梁仲","author":"许相卿","text":"海上春山眇莽中，长藤到处识髯翁。\n贵游无数花间骑，万态风光适意同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诗成","author":"许相卿","text":"云村病老语多咙，造次诗成杂宋腔。\n还溯开元论风格，拾遗坛上树旌幢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"震泽归寄前峰僧","author":"许相卿","text":"千里烟波一日程，胜游犹恨欠山僧。\n夜归剧忆前峰翠，晓起阑干试一凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金粟兰若","author":"许相卿","text":"野老山僧意味真，瘦筇高笠往来频。\n十年著我东林社，更道何曾见一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望云","author":"许相卿","text":"郊原新绿正丰茸，晏起钩帘晓雾空。\n造化无边生意浃，春云弥望湿东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐南塘惠借袁海叟集附谢","author":"许相卿","text":"柳风桃日满林庐，湘帙缄开午梦馀。\n诗律沿唐追晋魏，一编落手得权舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"招顾寅斋","author":"许相卿","text":"胸蟠万卷隐饥雷，造物从来惯忌才。\n何许诗穷报消息，春泥带雨一尊开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋秋泉","author":"许相卿","text":"微霜昨夜下庭柯，东岫朝来爽气多。\n偶过溪桥探三秀，惊看白发照沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南桥","author":"许相卿","text":"一曲溪流两岸松，石梁蜒蜿卧晴虹。\n径径拄杖归来晚，月挂东林屋上峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"复陈勾溪","author":"许相卿","text":"此地重来已十年，林庐水槛故依然。\n过门不是忘相见，刚有东风送客船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻翁七帙","author":"许相卿","text":"幽人万遍课参同，只恐劳生事事慵。\n高枕山房还静听，十千八百五更钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨卧病朱陈两翁至","author":"许相卿","text":"一丘高卧閒云共，二老相过旧雨同。\n续续江湖十年话，支离病骨起春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕","author":"许相卿","text":"一年将尽此黄昏，坐拨残炉火尚温。\n六十来人今晓事，春风一夜到柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲁山","author":"许相卿","text":"周行辙迹几经年，故国青山梦寐牵。\n桑梓迷阴丘首地，庆云烂漫帝乡边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵西皋感事 其一","author":"许相卿","text":"野人无意卜潜虚，眉宇閒愁久破除。\n白发青山随拄杖，残骸赢是乞来馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵西皋感事 其二","author":"许相卿","text":"十日开门风叶多，病怀今已入无何。\n嗟卑叹老真痴绝，昨见黄童发又皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵西皋感事 其三","author":"许相卿","text":"尧年九歉今始收，满车䆉稏胜封侯。\n葛巾漉得新缸面，客过山前底死留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵西皋感事 其四","author":"许相卿","text":"不问金华旧牧羊，屋头丹井半苔荒。\n凌云赋就多仙意，笑托山灵酬一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野泊","author":"许相卿","text":"沧江茫茫白鸟度，丹崖冉冉晴云流。\n舟横野渡倚残照，日短风烟生暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖外郊行","author":"许相卿","text":"青鞋短策湖云东，漫搜妙语酬春工。\n野烟漠漠吞江树，晴雨丝丝织晚空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"一竹","author":"许相卿","text":"薇蕨声沈旧业空，首阳何处访高踪。\n冰霜大地同摇落，挺立孙枝殿朔风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观化","author":"许相卿","text":"管领云泉四十春，乾坤閒处老閒人。\n却怜故物还元化，光属星河射海垠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诸弟秋试","author":"许相卿","text":"群季秋风桂子，病夫夜雨蒲团。\n黄妳味馀隽永，青云望入高寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"下邳阻风","author":"许相卿","text":"家近心情如醉，路难风浪拍天。\n春云过眼无赖，野日蒙头独眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪游云岫峰","author":"许相卿","text":"深雪撩狂兴，长蓑弄晓寒。\n翠凌孤突兀，玉拱万㠝岏。\n势合疑包地，尘空惬凭阑。\n野情多僻尚，閒处擅奇观。\n得句浮眉宇，抒思入渺漫。\n诗魂清到骨，仙意欲腾翰。\n认路樵无迹，题名竹有瘢。\n馀生饶乐事，无地著忧端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":22834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]