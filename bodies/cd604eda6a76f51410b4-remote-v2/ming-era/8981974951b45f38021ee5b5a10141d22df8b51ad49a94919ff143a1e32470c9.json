[{"title":"传制遇雨纪事 其二","author":"严嵩","text":"每岁宗藩当遣使，锦旄龙节载恩辉。\n昨年册礼弥年举，圣驾新巡漠北归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"传制遇雨纪事 其三","author":"严嵩","text":"至尊新免太皇丧，传制分封举旧章。\n周宗盘石千年固，汉使星轺满路光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"传制遇雨纪事 其四","author":"严嵩","text":"向夕鸣鞘下建章，平明飞鞚出长杨。\n冠军常侍俱承宠，白马金鞍从武皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋使静江先忆钤山草堂","author":"严嵩","text":"南济江湘去意赊，草堂秋色满烟霞。\n还家偶值陶潜菊，奉使真随博望槎。\n市近亲宾能载酒，径深旌节故穿花。\n秪于泉石应堪老，未倦风尘空自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夕次通州怀京邑僚友","author":"严嵩","text":"萧条古台上，云日蔽秋阴。\n已判同人袂，偏伤独客心。\n坏窗微月度，高树早寒侵。\n沉念待明发，东山萝薜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津","author":"严嵩","text":"双流赴海奔，形胜此中存。\n潮汐浮元气，金汤峙国门。\n亭秋叶尽落，江曙景逾昏。\n厌听城笳起，边愁入梦魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夕作","author":"严嵩","text":"秋气总成悲，那堪积雨时。\n客衣新授褐，林叶故辞枝。\n关塞书难问，风波鬓易丝。\n停舟闻夕雁，渺渺向南驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夹沟驿闻曹太仆舟过追候不及寄之","author":"严嵩","text":"沛江秋水驿门深，斜日扁舟度柳林。\n河汉易成千里隔，云山难寄万重心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过彭城","author":"严嵩","text":"十月彭城水，临观势渺漫。\n客帆牵树杪，日夕畏风湍。\n汴泗流争长，鱼龙卧未安。\n无人守茆屋，寂寞傍江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕梁题陈工部观物亭","author":"严嵩","text":"风叶飘摇秋意深，古墙幽竹自成林。\n闭门吏散焚香坐，谁识亭中静者心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高邮湖夜泛","author":"严嵩","text":"四望渺无际，中流扬素波。\n褰衣露华重，开帆月色多。\n病骨成萧爽，秋光入荡摩。\n汉槎天上客，历历近星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖杭守置酒","author":"严嵩","text":"朱幡翠幌在兰舟，绿水澄潭写我忧。\n云破楼台明晓日，筵开箫鼓竞中流。\n烟中檞径藏山寺，蘋际菱歌起钓洲。\n古木苏堤频怅望，看君为政继前修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日将至衢州寄杨使君 其一","author":"严嵩","text":"节序信流迈，川途仍阻修。\n那知逢九日，复此对孤舟。\n村晚枫鸣叶，沙寒雁叫俦。\n烂柯应在眼，未插菊花游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日将至衢州寄杨使君 其二","author":"严嵩","text":"青蕊那经眼，空尊解浣愁。\n招寻从今节，欢宴阻良俦。\n寂寂随寒雁，茫茫泛夕流。\n繁香未衰歇，归赏故林秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十日李使君郡斋宴","author":"严嵩","text":"未对重阳菊，还逢地主杯。\n风光宁自异，怀抱转须开。\n户引清香入，山邀好月来。\n严城看未锁，灯火逐江回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉山馆吴仁夫太史","author":"严嵩","text":"辞燕仍伏暑，度越已深秋。\n并署欣今命，联舟感昔游。\n节过黄菊雨，诗记玉山邮。\n客路同知己，清尊合劝酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉题阁老费公至乐楼","author":"严嵩","text":"衮绣辞天宠，岩峦选地偏。\n横林水石处，曾忆钓游年。\n旋马开新筑，焚鱼乐静便。\n峰晴窗列障，松暝鹤栖烟。\n意狎亲鱼鸟，神怡对简编。\n褰帏川雾湿，摇笔径花燃。\n白传香山社，欧公颍水田。\n传家馀故业，经世赖高贤。\n应有青藜使，来寻阁上仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙泽驿逢钱使君","author":"严嵩","text":"袁山借寇何由得，鄱水逢君本未期。\n为政风流应两郡，怀人云树总多时。\n沧江暮雨维舟楫，古驿残花对酒卮。\n知己难同嘉会少，孤帆欲别更迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同徐郡侯登浚渠亭","author":"严嵩","text":"徐侯亭子李侯渠，水石新呈宿莽馀。\n秋净野田闻鹳语，云深仙洞隐龙居。\n驱驰暂驻三湘节，登赋初陪五马车。\n此日佳游习池共，他年故事岘山如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发宜春风雨枉诸公出饯别后怀寄 其一","author":"严嵩","text":"出郭众峰暝，萧萧风树鸣。\n岭危攀磴上，桥断涉溪行。\n四牡勤王事，三湘问楚程。\n郡斋山雾里，回望渺层城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发宜春风雨枉诸公出饯别后怀寄 其二","author":"严嵩","text":"严程不可住，风雨且须行。\n驿荷群公饯，山怜候吏迎。\n乱峰连雾色，深树隐溪声。\n夙有遐观志，因忘故土情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宣风馆","author":"严嵩","text":"宣风馆前新雨晴，南北平分水陆程。\n客心不柰寒溪水，一夜潺湲树里声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夕次宣风馆见壁间题韵辄次一首","author":"严嵩","text":"下马疏林新月痕，隔篱呼酒问清浑。\n江流萍实此乡路，祠隐濂溪河处村。\n尘里征骖自来去，壁间题墨半明昏。\n舟軓欲挂湘江水，兰杜难招楚客魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢溪谒周元公祠","author":"严嵩","text":"古镇无监税，高贤有奉祠。\n位卑名德重，世远士民思。\n风月卢溪迥，衣冠宋代遗。\n停骖肃瞻拜，敢惜去程迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夕次醴陵","author":"严嵩","text":"晨装去萍邑，夕驾憩长沙。\n湖江通两镇，井里带千家。\n枫岸霜鸣叶，卢洲月映花。\n即看临桂水，还喜泛星槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"行经长沙江寄易太史","author":"严嵩","text":"酌酒看花兴每浓，十年林卧阻游从。\n常参玉署归难并，远使沧江去未逢。\n世事总知荣木槿，愁心空惜老云松。\n湘园门巷云阳麓，日对秋屏翠几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渌口驿","author":"严嵩","text":"炉寒夜坐湘山榻，雾重晨开渌口船。\n宁知东观神仙侣，未了南邦道路缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衡山舟中卧病","author":"严嵩","text":"三日病思伏在床，药物到口不敢当。\n蓬间坐失湘山翠，枕上但忆湘流长。\n晓报昏霾江气恶，临蒸自昔叹殊方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒南岳 其一","author":"严嵩","text":"溅溅石濑交寒溜，瑟瑟松枝来远风。\n村经独树柴荆外，路指千峰雾霭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒南岳 其二","author":"严嵩","text":"三日斋心屏俗荤，清朝病眼洗衡云。\n叮咛入谷停驺喝，恐惊此中猿鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒南岳 其三","author":"严嵩","text":"万壑云岚浩荡开，千重泉溜泻萦回。\n始怜奇僻非人境，尘迹何缘此度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿云开堂","author":"严嵩","text":"寤寐名山游，兹夕山下宿。\n虚馆绝浮埃，沉沉在幽谷。\n曈昽星映除，飒爽风动木。\n耳目澹无营，静嘿寡所欲。\n院寂凝清香，更长续明烛。\n惭无昌黎诚，晴晦安可卜。\n明发戒仆夫，愿恣云霞瞩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿云开堂闻提学常甫兄行部奄至亟遣书迓之","author":"严嵩","text":"夜闻台端檄，欲驻湘中船。\n良游匪夙约，兹会岂天缘。\n狂思忽如酲，揽衣不得眠。\n纸窗露微月，髣髴至我前。\n红日出东方，晓山映澄鲜。\n高吟振衣去，期子层云巅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登岳憩半山亭","author":"严嵩","text":"孤亭翠岭上层云，烟霭微茫万里分。\n仙家鸟道迥莫到，石壁猿声清忽闻。\n幽泉树杪飞残滴，瑶草岩中吐异芬。\n看拂丹霄朱鸟近，焚香先礼祝融君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经湘南寺","author":"严嵩","text":"半岭遥闻深径钟，石堂萝薜护青松。\n草堂邀客供僧茗，此是云中第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下祝融宿南台寺","author":"严嵩","text":"山殿隐苕荛，禅灯照寂寥。\n乱峰临宿霭，古木认前朝。\n桃水忽相失，浮丘还见招。\n欲跨松岩鹤，吹笛溯丹霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳下逢常甫兄","author":"严嵩","text":"白玉堂中鹓鹭群，十年江海叹离分。\n岂意与君逢此地，乱山携酒看飞云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南台寺同常甫兄宿是夕闻钦之兄自攸县来会","author":"严嵩","text":"香阁珠林倚半天，两人相对岳峰眠。\n羌村秉烛翻疑梦，缑岭乘鸾似下仙。\n云伴瘦筇过绝壁，风传清啸隔苍烟。\n攸江亦有山阴兴，莫更虚回半夜船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳下答常甫兄见赠","author":"严嵩","text":"楚乡杯酒故情浓，犹似长安日过从。\n知己百年怜几在，胜游今日叹难逢。\n吟看夜棹溪边月，坐对寒流石上松。\n昨暮祝融应悔别，回瞻云壑已重重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云霁堂逢钦之","author":"严嵩","text":"远信初闻近复疑，西堂清怨独吟时。\n须臾松径传银烛，颠倒风亭洗玉卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常甫宪副钦之翰检与予先后登岳钦之独值雨是日予与常甫坐候云开堂因赋二章 其一","author":"严嵩","text":"祠谒朝景晖，峰登云物变。\n今朝山中客，零雨罢登践。\n林深崖路窄，幽赏不可遍。\n磴滑危难步，谷暗近莫辨。\n兹山号灵幻，顷刻殊隐见。\n叨余上晴峦，万状悉输献。\n愧乏摛毫赋，琢句被崖藓。\n君侯擅风骚，胸中富溪巘。\n佳辞出天巧，不复劳洗鍊。\n岩峦閟辉彩，草树迷葱茜。\n岂被山灵妒，或遭造物谴。\n并觏欣兹奇，独往惜巳殿。\n期君嗣芒屐，言保箸力健。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常甫宪副钦之翰检与予先后登岳钦之独值雨是日予与常甫坐候云开堂因赋二章 其二","author":"严嵩","text":"晴登适可想，雨望奇莫云。\n三子本同志，所历各不群。\n浴溟初杲日，触石忽肤云。\n连峰弥霮䨴，八垠渺氛氲。\n掀林怒飙激，悬壑流泉奔。\n暝色啼玄貁，虎豹夹路闻。\n俯视临万仞，悄怆惊心魂。\n平生几奇游，拟刻石上文。\n虚馆迟回车，秉烛冀同论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"往岁西泉子约予同游衡岳而予不果西泉子独游有诗见怀兹登上封因忆前韵和寄西泉子","author":"严嵩","text":"幸了登山愿，惭输作赋能。\n自惊疲病力，亦上最高层。\n境迥知凡隔，神閒卜寿增。\n西岩清夜月，应照客吟曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方广寺宋晦庵南轩二先生所经衡守计使君期游","author":"严嵩","text":"涉涧登岩费远寻，古松寒寺入榛荆。\n昔贤对榻闻高咏，太守移尊非俗情。\n幽兰谷里堪纫佩，渌水潭边可濯缨。\n林暝杳然迷所适，上方台殿有钟声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿方广寺读朱张二先生唱酬集","author":"严嵩","text":"南岳众峰寺，寺寺期夤缘。\n高穷上封览，静寄南台眠。\n湘南与依空，琐琐不足传。\n方广岳西麓，迹胜由名贤。\n朱张两夫子，杖屦来当年。\n高辞贲岩石，老宿依寒禅。\n而我二三子，景行志弥坚。\n跻攀越林涧，怅望迷云烟。\n不见谷中人，但闻山下泉。\n驰驱限于役，申旦輶车旋。\n幽境夙所尚，尘累何当捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经西明山","author":"严嵩","text":"崖登渺奇兴，况喜故人同。\n石路寒山里，溪流万木中。\n幽花晴泫露，高树晚多风。\n劳思何能洗，清尊幸不空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游水帘洞","author":"严嵩","text":"此是朱陵第二游，恍疑云水閟仙丘。\n磴盘鸟道萝烟暝，潭隐龙宫雨气浮。\n闻有高人眠醉石，拟将俗耳洗寒流。\n摩崖细认题名字，苔色苍苍万古秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡文定公书院 其一","author":"严嵩","text":"文定祠堂衡岳下，岳云祠榜映崔嵬。\n千年弦诵馀岩宝，长遣山灵护绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡文定公书院 其二","author":"严嵩","text":"精思妙契了残编，杖屦南山二十年。\n铅椠未终还仕籍，风尘颜面愧高贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南岳道士","author":"严嵩","text":"焚香松下迎官长，捧爵炉前礼岳君。\n青鞋不畏苍崖路，日日峰头行白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音岩僧","author":"严嵩","text":"自云家世本湘川，来往名山断俗缘。\n只借蒲团供宴坐，不管岩花易岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衡州","author":"严嵩","text":"积水长天尽，深冬暮景催。\n吾仍问南去，雁向此中回。\n岳晚和云立，花寒对驿开。\n侍臣清禁上，荒徼几时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雁峰寺易太史计使君集","author":"严嵩","text":"衡阳溆浦水烟通，落日来登回雁峰。\n星轺玉节道路远，洞庭潇湘云雾重。\n川长不见传书雁，寺古仍馀夹道松。\n山园绿竹扶疏好，共惜佳人此地逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花药寺","author":"严嵩","text":"昨暮雁峰宴，今晨花药来。\n似携馀兴往，更待好怀开。\n楼阁盘幽嶂，香烟上古台。\n楚地多奇胜，吾惭作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衡州与易太史别","author":"严嵩","text":"輶轩遵岭路，别棹倚川浔。\n萧条风壤异，婉婉岁年侵。\n畴昔怀同侣，兹乡逢所钦。\n清芬袭嘉惠，逸响激瑶琴。\n复感承明直，何如湘水吟。\n茆斋攸江上，忆尔会相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至祁阳县行礼时车驾北征","author":"严嵩","text":"使节祁阳逢至日，县庭班列觐天光。\n即看暖入深宫线，正想风飘合殿香。\n塞马力应疲雨雪，江鸿书不到衡湘。\n寒云落木催愁剧，魏阙沧洲引睇长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题潇湘楼","author":"严嵩","text":"山色青瑶润，江光素练长。\n误疑看图画，乃觉临潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"镇国山亭","author":"严嵩","text":"朱甍开邸第，竹径得山家。\n桂种瑶台树，莲开玉井花。\n倾杯移渤澥，染翰动龙蛇。\n疑有神仙过，鸾箫隔彩霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永州城西朝阳岩踞湘水上景号奇绝太守何君携酒岩上","author":"严嵩","text":"危石野亭云外赏，澄潭仙舸镜中回。\n朝阳岩洞堪留客，湘水湘山对举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寻愚溪谒柳子庙","author":"严嵩","text":"柳侯祠堂溪水上，溪树荒烟非昔时。\n世远居民无冉姓，迹奇泉石空愚诗。\n城春湘岸杂花木，洲晚渔歌清竹枝。\n才子古来多谪宦，长沙犹痛贾生辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见梅花","author":"严嵩","text":"岁尽荆南霜霰稀，天晴山雾湿人衣。\n马上朝来如见雪，因傍梅花过翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"全州道中","author":"严嵩","text":"梅花千树雪，松叶万溪云。\n湘源行日日，赖尔洒尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿深溪馆","author":"严嵩","text":"湘皋风物晚凄凄，候馆星轺日向西。\n白屋扉临一水静，苍山路入万松迷。\n寒冲毒雾沾衣润，暝坐幽篁飐雨低。\n不见此中猿鹤侣，恐栖萝月在深溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"全州古松歌","author":"严嵩","text":"全州古松大道边，白昼暝色行苍烟。\n溪回路转不知数，直至兴安阴接连。\n蛟龙拿空势欲舞，往往呼号作风雨。\n大枝屈铁少枝盘，偃蹇突怒如相忤。\n时复一株罗樵斧，槎牙无枝形独古。\n谁栽此松经几祀，国初太守名犹记。\n胜迹曾留学士题，繁阴长与行人憩。\n松风冷冷山寂寥，松月皎皎明清霄。\n遥想山中风月下，定有鹤仙吹玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湘山寺唐无量寿佛示寂地 其一","author":"严嵩","text":"湘山台殿翠微连，石塔禅身坐俨然。\n祗树天移兜率境，金灯焰续会昌年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湘山寺唐无量寿佛示寂地 其二","author":"严嵩","text":"云岚坐涌岩扉暝，薜荔行遮塔径斜。\n两日炎州病如洗，湘山寺里见梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过盘石太守华玉赋诗处","author":"严嵩","text":"盘石江山雨潇潇，行客双旌疋马遥。\n醉起题诗临峭壁，令人却忆顾东桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]