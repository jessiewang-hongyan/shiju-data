[{"title":"偶题 其二","author":"王世贞","text":"十里香烟夹路岐，少年争草步虚词。\n不知天上原无用，只礼身中一字师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余德甫见贻箨冠侑以一绝句倚韵和答","author":"王世贞","text":"竹萌含露供朝餐，余箨犹堪刘氏冠。\n不道道人心死尽，雨来犹作化龙看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七年前为在明赋此十绝句今春在明遇余吴阊复出卷索书之时余二人各挂冠久矣因题二绝于后 其一","author":"王世贞","text":"当年楚馆咏江篱，忽戴宫花集凤池。\n何限幽芳领秋意，于今方是属君时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七年前为在明赋此十绝句今春在明遇余吴阊复出卷索书之时余二人各挂冠久矣因题二绝于后 其二","author":"王世贞","text":"才谈访旧便欣然，更怯长江浪拍天。\n十绝新题挂君壁，似应翻胜子猷船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其一 湘妃竹","author":"王世贞","text":"几点苔痕上翠筠，千秋长见泪痕新。\n从他帝子夸江渚，不是苍梧望里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其二 吴王试剑石","author":"王世贞","text":"㸌尔青天一电流，山头白虎迥惊愁。\n不辞顽质长刳剖，相国功多也属镂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其三 秦女卷衣","author":"王世贞","text":"秦女吴妆玉不如，卷衣犹在五更初。\n休疑雨露无多点，关内离宫二百余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其四 高帝斩蛇剑","author":"王世贞","text":"大泽云腥碧血侵，芙蓉犹在匣中吟。\n天教武库穿云去，负尽残年斩马心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其五 贾佩兰出为段儒妻","author":"王世贞","text":"愁向人间说汉宫，春歌字字咽春风。\n空怜透指金彄美，不及秦家照胆铜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其六 探丸","author":"王世贞","text":"月黑床头风雨鸣，五陵西去漏三更。\n贼曹休怪探丸事，自是人间有不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其七 藏钩","author":"王世贞","text":"花前彄戏巧争新，无奈些娘道便真。\n总为怯输浑不展，依然钩弋赵夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其八 蹴鞠","author":"王世贞","text":"油场光软似凝脂，结社分弸各露奇。\n子政自夸新样好，宫中原不爱弹棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其九 秋千","author":"王世贞","text":"柔荑弱柳竞风流，荡漾颠狂不自由。\n却似侬家新孔雀，学飞横上树梢头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十 春日独当垆","author":"王世贞","text":"纤玉徐量琥珀卮，杏红衫子任风吹。\n公然解赠金条脱，赖是傍无犊鼻儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十一 七宝避风台","author":"王世贞","text":"七宝妆成百尺台，怯风阊阖不曾开。\n纵令吹着双飞去，还解双含祸水来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十二 薛夜来","author":"王世贞","text":"空劳国色更针神，雨露恩移别院新。\n记取蒲生塘上曲，九泉差胜姓甄人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十三 清夜游西园","author":"王世贞","text":"夜凉清吹夹车来，菡萏秋兰水陆开。\n何限风光何限月，有谁能嗣建安才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十四 爱妾换马","author":"王世贞","text":"燕颔风云切大荒，雕鞍新热冷红妆。\n权奇到底应须尽，其奈蛾眉也是霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十五 采莲曲","author":"王世贞","text":"玉腕交加摘露房，生憎孟姥妒檀郎。\n榜来兰楫吹令远，引去莲歌咽不扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十六 若耶溪","author":"王世贞","text":"步屧寻春傍若耶，双环白足洗轻纱。\n兴来莫踏云门寺，处处青帘卖酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十七 北风吹裙带","author":"王世贞","text":"袅袅婷婷骄上春，狂风摇荡不由身。\n君王莫问吹多少，可是吴郎画里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十八 宫蚕","author":"王世贞","text":"摘来桑叶喂蚕肥，缫得流黄夜上机。\n愁说上方初进御，君王别选越罗衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其十九 燕姬堕马","author":"王世贞","text":"堕马胡姬不动尘，飞鞍一跃转如神。\n莫轻乘自侯门过，惹得梁家髻样新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古乐府杂题二十绝 其二十 春闺怨","author":"王世贞","text":"何曾鹊印在龙荒，止许双蛾锁洞房。\n秋夜纵长犹有梦，无情无思对斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李德宣之萧山司训二绝 其一","author":"王世贞","text":"萧山竹箭美于玉，湘湖莼菜绿胜丝。\n任是广文官舍冷，未应翻作季鹰思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李德宣之萧山司训二绝 其二","author":"王世贞","text":"八月晴江响怒雷，西陵渡口趁潮开。\n船头赤鲤如人立，知是龙湫带雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐大光禄奉使江西淮邸见顾赠之再得四绝句 其一","author":"王世贞","text":"拥传初从尚食归，天香细细染宫衣。\n欲知明主兴居事，可谓韩休疏不肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐大光禄奉使江西淮邸见顾赠之再得四绝句 其二","author":"王世贞","text":"淮王上客总能文，谁似风流徐少君。\n彩笔写将芝岭色，锦囊收尽蠡湖云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐大光禄奉使江西淮邸见顾赠之再得四绝句 其三","author":"王世贞","text":"豫章何限豫章材，蔽日干云夹道开。\n君去试看梁栋具，阿谁非是相公栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐大光禄奉使江西淮邸见顾赠之再得四绝句 其四","author":"王世贞","text":"高秋伏枕罢弦时，一曲聊将赠子期。\n若向洪都朱邸听，有人能谱右丞诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题","author":"王世贞","text":"一缕沈烟袅碧虚，五千言是读残书。\n亦知终日无凡事，祗恐凡情未破除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠孙章甫 其一","author":"王世贞","text":"午坛烟暖日迟迟，玉洞群真礼法师。\n最是黄庭须早熟，莫教符力不相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠孙章甫 其二","author":"王世贞","text":"游戏人间事事工，何人不爱葛仙翁。\n那堪一片桃花水，锁住蓬莱未许通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入道史氏妇病死诗以伤之 其一","author":"王世贞","text":"石湖桥畔土千堆，送客魂消黯自回。\n唯有师真曾授记，寸心犹暖未成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入道史氏妇病死诗以伤之 其二","author":"王世贞","text":"初将七魄试重泉，同学群姑尽惘然。\n不信已生忉利界，散花先到世尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过新第","author":"王世贞","text":"压帘银蒜玉钩斜，数缕沈烟袅绛纱。\n曾向此中投一宿，不知端的是谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过弇园","author":"王