919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月六日送舍弟河口即事偶成 其六","author":"王世贞","text":"翻因爱弟有离筵，群从儿孙满目前。\n总是现来阿閦国，一灯还傍佛龛悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦后席上口占 其一","author":"王世贞","text":"偶然梦作朝官好，醒后依然一道人。\n却忆景阳钟底梦，五湖佳处便垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦后席上口占 其二","author":"王世贞","text":"春来大作纵横梦，梦里头头记却无。\n犹胜日长无外事，时从故纸问葫芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送里人金大从军兼简方记室景武 其一","author":"王世贞","text":"双鞲结束气如云，亚子城西酒半醺。\n欲向故人歌出塞，近来王粲倦从军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送里人金大从军兼简方记室景武 其二","author":"王世贞","text":"蓟门芳草殢雕鞍，下马胡姬酒未阑。\n金印不关明主惜，春来质子遍长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹子念文学游闽还访天台 其一","author":"王世贞","text":"昙阳观头夜香焚，袅作轮囷三素云。\n若到幔亭应少住，为余持赠武夷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹子念文学游闽还访天台 其二","author":"王世贞","text":"武夷九曲青不足，还向天台访石梁。\n为是橐轻难压载，尽收山色付奚囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹子念文学游闽还访天台 其三","author":"王世贞","text":"冰盘不肯荐杨梅，五月闽天锦作堆。\n日啖红香三百颗，可应单为荔枝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹子念文学游闽还访天台 其四","author":"王世贞","text":"虬髯铁面太峥嵘，看尔菰芦意气生。\n莫为外家夸宅相，近来文苑已除名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊行","author":"王世贞","text":"满村浮绿数枝红，也解愁侬也殢侬。\n欲觅二端无处着，翛然自在版舆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"折简要家驭提学同长公学士看地棠花","author":"王世贞","text":"弇园千树锦横斜，雨妒风欺一任他。\n唯爱君家兄弟好，就中留得地棠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小病愆花期唯牡丹在耳次公将有豫州之行更成一绝句","author":"王世贞","text":"飘尽棠梨见牡丹，折花行酒莫留残。\n洛阳春事知尤少，无那明年两地看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其一","author":"王世贞","text":"白白红红几树斜，清溪一曲水如霞。\n不须牙版标名字，看着应呼学士花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其二","author":"王世贞","text":"一蕊须头一佛圆，供时长在梵王前。\n远公未晓西归意，亲凿方池种白莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其三","author":"王世贞","text":"仲冬朔日仙蜕回，丛桂凌霜特地开。\n莫笑净名居士病，前身金粟老如来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其四","author":"王世贞","text":"墙阴马鬣秃于童，眼看桃花树树红。\n春色纵归犹未辨，与君相对试霜风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其五","author":"王世贞","text":"舞蝶双萦小玉团，殿他春事耐他残。\n道人香色元无住，偶尔闻呼绿牡丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其六","author":"王世贞","text":"三月行尽春光微，欲觅飞花无可飞。\n高下川原诸草树，也能将绿染人衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其七","author":"王世贞","text":"野菜经春百味新，长镵一柄便周身。\n首阳薇蕨元何限，始解夷齐未尽贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其八","author":"王世贞","text":"一丛新竹迸龙鳞，微雨仍惊玉菌新。\n乞得维摩香积饭，午斋先供两闲人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其九","author":"王世贞","text":"五月五日坐东篱，忽有黄花抽数枝。\n呼杯恐失醒累意，不饮生教醉令嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其十","author":"王世贞","text":"昙阳庵东积水多，僧来商略种新荷。\n鸡头菱角亦堪可，奈此一碧玻璃何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其十一","author":"王世贞","text":"六月十八阳侯狂，老树草偃蛙窥床。\n老夫拥被卧三夕，竟有红日翔扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元驭学士于新观种花挑野菜前后戏呈得十二首 其十二","author":"王世贞","text":"瀼瀼湛露柏间垂，色胜醍醐味胜饴。\n见说华池元自有，可烦天上借璚枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为僧题云林卷","author":"王世贞","text":"晓树苍苍径未分，数声清梵隔林闻。\n莫欺垆底旃檀烬，也解蒸为宝焰云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]