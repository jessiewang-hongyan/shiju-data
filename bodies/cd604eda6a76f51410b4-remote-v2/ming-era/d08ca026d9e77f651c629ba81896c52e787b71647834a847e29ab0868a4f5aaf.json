[{"title":"舟中早发","author":"孙承恩","text":"月落未落天渐明，船头打鼓将欲行。\n哑哑客舟棹齐发，喔喔远村鸡乱鸣。\n乾坤扰扰有行役，世路纷纷多变更。\n迂拙无能禆上下，却惭到处费将迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"孙承恩","text":"向晚书斋坐亦奇，满天明月闭关迟。\n尽将宠辱抛春梦，一并乾坤入酒卮。\n隔水荷风时细细，傍檐花影故离离。\n露华不计沾衣湿，直到西林月落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜与客閒步中庭","author":"孙承恩","text":"虚馆良宵风月清，重门杳杳断人声。\n试拈酒盏三人共，笑踏花阴一径行。\n故旧顿疏难会面，乾坤俯仰总关情。\n暂时乘暇贪欢赏，日出明朝事又生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后种竹","author":"孙承恩","text":"带雨移从远寺来，自携钱镈破苍苔。\n直须旧土连云起，更记南枝向日栽。\n风动只愁龙化去，月明应有凤飞回。\n莫嫌生意萧疏甚，会见深深一径开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴安南二首 其一","author":"孙承恩","text":"万里南征亦胜游，秋晴况喜瘴烟收。\n独惭浅薄虚王命，肯使风尘涴客裘。\n苏节从知完入汉，越裳行见早朝周。\n寸心北极瞻依切，千载令人感魏牟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴安南二首 其二","author":"孙承恩","text":"迢递交南瞻海隅，一封遥降紫泥书。\n九天湛露悬征旆，载道清风拥使车。\n谕蜀窃惭司马檄，出门忍看太真裾。\n天涯落日重回首，白发萧萧独倚闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱塘侯崇礼至有诗因和答","author":"孙承恩","text":"漠漠秋阴杂雨霏，登山有兴漫都违。\n坐深驲榻吟偏剧，望杳仙舟思欲飞。\n万里壮心瞻日近，五更清梦逐潮归。\n相看心事还相信，岁晚冰霜共结依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎跑泉和坡翁韵三首 其一","author":"孙承恩","text":"远续曹溪水更香，云腴深甃石阴凉。\n百灵呵卫龙天肃，一线潜通地脉长。\n病体偶从窥胜迹，尘心应得悟迷方。\n为邀陆羽来同宿，击火烹茶试共尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎跑泉和坡翁韵三首 其二","author":"孙承恩","text":"洞口风生薜荔香，万松阴护佛龛凉。\n禅僧独对青山老，游子贪依慧日长。\n世故极知俱幻想，安心何用觅奇方。\n探幽笑我真成癖，一滴甘泉合试尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎跑泉和坡翁韵三首 其三","author":"孙承恩","text":"古寺幽深石井香，西风吹我葛衣凉。\n数声清磬晚山碧，一榻白云秋兴长。\n解脱五蕴本非有，超离四大还无方。\n为喜灵源已烦渴，觅取远公涓滴尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张文光都阃邀游西湖","author":"孙承恩","text":"七年不向西湖醉，此日真成两度游。\n三竺寺中秋渐肃，两高峰顶雨初收。\n云峦飞翠迎吟舫，水树分青落酒瓯。\n最爱主人多道气，不妨日暮为迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上早行","author":"孙承恩","text":"寒霏收尽看新晴，晓起偶从湖上行。\n青天微茫海色动，红日荡漾波光明。\n笙歌稍稍游人集，洲渚萧萧征雁鸣。\n湖山如此正可赏，惭愧当年游冶情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常山道中即事","author":"孙承恩","text":"登登山径绕羊肠，天际孤吹送晚凉。\n鸟带暝烟投远峤，马驰斜日转危冈。\n汀洲水澨蒹葭老，篱落人家橘柚香。\n风景渐于乡土异，黯然离思共秋长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经宁藩故地有感","author":"孙承恩","text":"颠冥侯度恣淫荒，白日枭鸣自不祥。\n秽迹千年谁洗灭，本支百世自重光。\n故基寂历生秋草，野鸟啁啾话夕阳。\n人与惟仁天助顺，独留覆辙示兴亡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文山祠","author":"孙承恩","text":"兴复区区竟弗酬，百年臣节已全收。\n力穷巡远宁忘虏，死去夷齐不系周。\n燕市龙归秋雨暗，西台客恸暮云愁。\n只今祠下章江水，正气应同万古流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又用杜韵","author":"孙承恩","text":"危祠江上偶经寻，碧殿长松自郁森。\n落日烟云催暝色，空山猿鹤送哀音。\n百年臣子匡扶义，千古英雄激烈心。\n梁甫歌残有馀恨，不胜清泪湿衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行","author":"孙承恩","text":"朝霞翻曙雨初收，芦叶芦花两岸秋。\n漠漠风烟随鸟没，依依沙树共云浮。\n山排叠嶂连天远，潮入寒江接海流。\n乡国不知何处是，孤舟渺渺独生愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南安有怀张东海先生","author":"孙承恩","text":"南邦遗惠霭棠阴，东海神游断碧云。\n馀事百年传墨妙，心期千古赖遗文。\n金鳌阁外荒秋草，玉枕山前漫夕曛。\n夜静屋梁明月下，依稀犹似见夫君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中夜起","author":"孙承恩","text":"明河西斜月出高，数十大星悬树梢。\n露下寒塘响枯苇，风惊栖鹘翻危巢。\n睡醒呼取明烛坐，兴尽还将书卷抛。\n山村漏刻本无据，卧听更人长短敲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟题镇海楼","author":"孙承恩","text":"楼开沧海郁岧峣，弹压三吴不敢骄。\n千尺荡摇波影乱，八窗吞吐野云飘。\n中天笑语疑应近，蓬岛神仙或可招。\n回首家山邈何许，归心一片溯秋潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏波庙二首 其一","author":"孙承恩","text":"伏波遗庙俨空山，落日长烟苍莽间。\n草色有情侵座绿，苔花无数上衣斑。\n勋名直拟留千古，英爽犹能弭百蛮。\n我欲为公昭素节，一杯江水荐潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏波庙二首 其二","author":"孙承恩","text":"报主忠勤老益坚，裹尸有革即吾棺。\n明珠不俟千年白，铜柱终留百世看。\n绝塞悲风疑鼓角，荒山祀典俨衣冠。\n英雄一去空陈迹，落木萧萧生暮寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴","author":"孙承恩","text":"日日云山管送迎，合裁诗句答山灵。\n思穷开辟无终峙，望入微茫不尽青。\n舵转忽看孤石峭，岸移遥认野花明。\n他时为忆经行处，只记多山不记名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵谢吴参戎","author":"孙承恩","text":"笑谈忽奉三旬别，旌节还从万里回。\n白日沸天箫鼓振，青山到案酒樽开。\n殊方满目多豺虎，重镇分符简俊才。\n黾勉尚期功业树，便蕃行见异恩来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵再赠","author":"孙承恩","text":"岭表分符镇百蛮，金汤雄倚屹重关。\n霜清边塞风尘靖，月照辕门鼓角寒。\n悬肘会誇金作印，切云偏称铁为冠。\n高情未许求閒去，绝域须看略地还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借韵述还","author":"孙承恩","text":"离愁渺渺隔云山，回首风尘暗玉关。\n白雁影沉乡信绝，沧江日短使舟寒。\n剑光星动宵弹铗，客袂霜清晓拂冠。\n千古伏波多志节，一时薏苡谤珠还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沃泉邓太守久淹远郡报政喜与予偕行有诗见贶用韵奉答","author":"孙承恩","text":"天涯怀土几登台，报政今从万里回。\n萍梗百年樽酒共，笑谈一日好怀开。\n圣朝柔远非忘远，牧郡抡才见异才。\n会有崇迁应内补，不教兹地更重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贱降前一日俞厚庵暨沃泉携酒饮予舟中即席奉谢二首 其一","author":"孙承恩","text":"贱子明朝初度辰，故人高谊重相亲。\n曳裾自是论交旧，倾盖兼逢托契新。\n有酒且酬今日兴，无闻空负百年身。\n孤舟落日寒江晚，独向天涯感慨频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贱降前一日俞厚庵暨沃泉携酒饮予舟中即席奉谢二首 其二","author":"孙承恩","text":"云山归路正漫漫，愁绪无缘得自宽。\n初度又逢明日是，一樽聊尽故人欢。\n旷怀直欲齐今古，浩啸何妨落佩冠。\n醉去狂来浑不禁，欲将长铗向君弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度述怀二首 其一","author":"孙承恩","text":"百年光景故骎骎，况复天涯万感侵。\n未有涓埃酬帝力，独将迂拙守初心。\n月明江浦猿声急，云暗山城雁影沉。\n慈母白头应念远，倚门日暮正愁深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度述怀二首 其二","author":"孙承恩","text":"学道蹉跎秖未成，岁华荏苒壮心惊。\n乌纱不愧青天覆，玄鬓从教白雪生。\n皇览岂能忘卜梦，闻诗犹自忆趋庭。\n天涯忽忽思千种，风木声中泪最清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒韩襄毅祠","author":"孙承恩","text":"危祠何处倚高岑，碧磴穿云一径深。\n精爽九原犹赫奕，江山千古自萧森。\n伏波勋业曾闻昔，魏国声名合配今。\n见说近郊还寇盗，起公无计独伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍梧元旦拜阙","author":"孙承恩","text":"嵩呼声里晓寒侵，宝炬光中月影沉。\n海宇正当更治日，蛮荒宁异向阳心。\n曾叨近侍奔趋地，尚忆亲瞻斧扆临。\n此日南陲心北阙，不堪愁对瘴云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陆俨山扈从山行二首 其一","author":"孙承恩","text":"落日重山涌翠波，叨从仙跸寄行窝。\n云连斗极瞻天近，树隐寒声入夜多。\n典礼幸逢窥盛事，宗禋合有继登歌。\n平原内史今词伯，健笔真能障九河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陆俨山扈从山行二首 其二","author":"孙承恩","text":"剑舄先皇镇此山，神光灵气在人间。\n玄宫肃穆环千嶂，石兽嵯岈护九关。\n覆载岂能名帝德，丹青曾有识天颜。\n遗芳百世臣民念，何处龙髯更可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次二首并述怀 其一","author":"孙承恩","text":"敢于扈从计奔波，且向深山寄一窝。\n木落群峰秋气肃，柝传五夜月明多。\n九重绍述尊坟典，千古明良喜起歌。\n珍重庙堂勤治理，万年永保汉山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次二首并述怀 其二","author":"孙承恩","text":"乾坤何处托云山，无限幽怀怅望间。\n忙里诗篇聊漫尔，老来情事易相关。\n蹉跎岁月妨公务，潦倒风尘益病颜。\n猿鹤休教怨迟暮，小山丛桂会须攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵后夜钟石少宰宅次韵二首 其一","author":"孙承恩","text":"剩有华灯续此宵，只嫌明月费呼招。\n追游我自惭时彦，宴喜人都荷圣朝。\n小海调高檀板急，博山炉煖篆烟飘。\n孝先才思多豪逸，取次诗成不待敲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵后夜钟石少宰宅次韵二首 其二","author":"孙承恩","text":"华灯高照属清宵，我亦疏狂忝胜招。\n赋凤勉同金马客，驾鳌还仿紫宸朝。\n芳尊荷主深深劝，晴雪催诗故故飘。\n尽兴不知更漏促，到门立马待人敲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李叙翁阁老观莲之什","author":"孙承恩","text":"阁外盆蕖竞晓风，翠蕤碧盖护新红。\n移来华岳峰头种，幻作仙人掌上工。\n丹渥晴云涵綵幕，芬菲瑞霭散彤宫。\n调元再见敷成日，栽植谁非燮理功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游郑园和张水南司成韵三首 其一","author":"孙承恩","text":"城市园林迥不同，入门翠霭眩西东。\n丛篁逼仄短无地，曲径盘旋忽有峰。\n亭上把杯邀落日，水边岸帻倚微风。\n寻芳竟日成留恋，莫计归途起暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游郑园和张水南司成韵三首 其二","author":"孙承恩","text":"胜会难期一笑同，招延此日荷贤东。\n上客自吟青玉案，野蔬不羡紫驼峰。\n黄尘陆海蒸炎暑，碧树荷亭起夕风。\n对酒无穷山谷兴，隔花已听景阳钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游郑园和张水南司成韵三首 其三","author":"孙承恩","text":"郑谷园居我兴同，吾园遥隔海云东。\n一春坐忆浦南雨，此日来瞻江上峰。\n返照渐催归路暝，昏鸦齐噪满林风。\n草堂净榻容相借，卧听城西野寺钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昨来南院叙庵阁老有诗赠别和韵却寄","author":"孙承恩","text":"三十年来逐晓珂，青袍如故鬓将皤。\n移官恰与疏慵称，恋阙翻增感慨多。\n官署晚山堪拄笏，江门秋水忆乘槎。\n盈虚曾究羲皇画，聚散无凭付浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次溪堂春酌联句之什三首 其一","author":"孙承恩","text":"门掩东风生薄寒，清朝良晤客途难。\n即看邻曲承迎便，自觉樽前意绪宽。\n世事且抛春梦外，闲情都付綵毫端。\n更留馀兴重来会，录取鸾笺后日看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次溪堂春酌联句之什三首 其二","author":"孙承恩","text":"座上休辞酒盏寒，劝公乐饮公莫难。\n百年安知良会几，一饭敢负君恩宽。\n遐思直溯邃古上，逸兴超入浮云端。\n长歌慷慨为君发，拂拭雄剑灯前看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次溪堂春酌联句之什三首 其三","author":"孙承恩","text":"曲屏芳宴烛花寒，官里匆匆乐会难。\n老去从知诗兴减，欢来自觉酒肠宽。\n月临五夜闻鸣柝，候入三阳记履端。\n韩孟风流吾忝附，明朝应有客传看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅塘诗寄盛封君","author":"孙承恩","text":"谁把幽芳植水滨，罗浮风致绝纤尘。\n寒依浅渚犹残冻，律转南枝已占春。\n即有炉香浮淡爽，更教凉月助精神。\n调羹他日贤郎事，赢取孤高伴老身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏即事","author":"孙承恩","text":"才见东风扫落英，又看时序到朱明。\n一宵过雨柳都暗，几树迁乔莺乱鸣。\n簿领少亲宜病体，琴樽聊与适幽情。\n故园遥忆吴淞上，欲棹扁舟采杜蘅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭和御制翰林院敬一亭落成诗","author":"孙承恩","text":"杰构新看耸玉堂，文明诞启际非常。\n九天睿藻开贞观，百圣心传蹈允臧。\n愿竭庸愚终黾勉，愧无雅颂重铺张。\n神功已配乾坤大，海宇均瞻日月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和许松皋太宰宫僚宴集四首 其一","author":"孙承恩","text":"轻烟晴日共苍苍，胜会叨承乐举觞。\n国有承祧资保傅，天惟佑命得贤良。\n激昂思越云霄上，笑咏春回几席傍。\n四海皇风披浩荡，百年文运际明昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和许松皋太宰宫僚宴集四首 其二","author":"孙承恩","text":"共把忠诚托昊苍，清朝东府洽壶觞。\n论文我独惭疏拙，辅德时方属俊良。\n皇极仰瞻宸极上，少微遥瞩紫微傍。\n赓歌不尽揄扬意，但祝鸿图百世昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和许松皋太宰宫僚宴集四首 其三","author":"孙承恩","text":"万里长风吹鬓苍，百年高会此传觞。\n劝酬不尽主宾兴，披豁真诚交谊良。\n地切瑶山三岛上，人依金阙五云傍。\n愿言翊赞崇储德，重继周诗咏克昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和许松皋太宰宫僚宴集四首 其四","author":"孙承恩","text":"霜明银榜晓寒苍，乐饮群公各尽觞。\n晋接偶同日休暇，谦光并著德温良。\n尧文炳焕南离上，汉幄岧峣北斗傍。\n浅薄廿年叨侍从，愧无勋业佐时昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"俨山用韵见赠次答二首 其一","author":"孙承恩","text":"愧扳和璧并顽苍，喜托清光接羽觞。\n一代谟猷夔契盛，百年制作马班良。\n论交期我形骸外，曳履随公日月傍。\n调燮即看归大手，伫承休烈颂明昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"俨山用韵见赠次答二首 其二","author":"孙承恩","text":"荏苒年华双鬓苍，侧身天地一衔觞。\n风云幸接夔龙侣，樗栎惭非梓杞良。\n公有经纶禆黼扆，我惟文籍校偏傍。\n骚坛今日谁方驾，百战词锋气更昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠韵赠少湖","author":"孙承恩","text":"西山晴雪袅苍苍，恨不时同泛酒觞。\n华发红尘嗟我老，青年白璧羡君良。\n朝趋每共枫宸上，笑咏能忘竹屿傍。\n丰芑贻谋均宠命，愿摅忠赤报时昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"句曲山房为王克斋题","author":"孙承恩","text":"句曲名山古洞天，高人结屋擅林泉。\n千岩灵气云雷出，万壑晴光日月悬。\n剩有经纶禆大造，不希黄白注真诠。\n旧游猿鹤时相忆，夜夜清光北斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送浦畅斋赴松溪尹用曩岁赠韵二首 其一","author":"孙承恩","text":"一笑惊看别后容，草堂复此晤言同。\n须知禄仕君恩重，莫问蹉跎吾道穷。\n路指松源山郭里，帆开潞水夕阳中。\n即看寒谷冰霜后，须见阳和次第融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送浦畅斋赴松溪尹用曩岁赠韵二首 其二","author":"孙承恩","text":"莫叹霜华两鬓生，一官初喜拜承明。\n诗书好达循良政，才杰宁须甲第名。\n夜月幽斋看剑坐，春风沃野省农耕。\n蓬窗烧烛当年事，送子能无故旧情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"香山寺来青轩","author":"孙承恩","text":"坐想山亭多白云，飞岚扑雾共氤氲。\n即看几席青相映，政拟孤高思不群。\n雨过玉芝春昼永，风传僧呗下方闻。\n尘缘未了清游兴，有待幽深禹穴文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送董羽吉南归","author":"孙承恩","text":"兰舟渺渺发江浔，文采风流子擅今。\n奉节敢忘怀国念，登山偏切望云心。\n高堂喜色星辰动，先垄恩光雨露深。\n宦邸蹉跎浑不觉，暂时分手思难任。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]