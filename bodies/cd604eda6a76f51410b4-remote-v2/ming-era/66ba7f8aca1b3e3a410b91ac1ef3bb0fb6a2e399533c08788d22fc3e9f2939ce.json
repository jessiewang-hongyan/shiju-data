[{"title":"秋前一日感赋","author":"伍瑞隆","text":"寂寂竟何事，虚亭尽日眠。\n绿阴残雨后，爽气发秋前。\n晚舸清溪口，疏钟水寺边。\n自能齐物理，不敢怨流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早秋作","author":"伍瑞隆","text":"凉风动高阁，三径早迎秋。\n病强寻僧起，闲因看竹留。\n晚潮随月至，清磬逐云流。\n玉笛凄清甚，何人夜倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日漫兴","author":"伍瑞隆","text":"水淡生云处，山空欲雨时。\n病翻思睡早，闲不厌醒迟。\n白露澄芳沼，凉风动桂枝。\n萧萧半窗竹，留客坐题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与李太史订中秋之约以雨不果赋此寄怀","author":"伍瑞隆","text":"无由乘兴去，寂莫感相邀。\n一雨来何意，三秋负此宵。\n片心人共远，永夜月难招。\n赋就南楼客，应知咏采萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹亭卧雨","author":"伍瑞隆","text":"偃仰听丛篁，清虚思独长。\n忽惊花外雨，来到竹间床。\n滴翠侵衣湿，牵风捲簟凉。\n不须陶靖节，吾已到羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸子饮落霞峰聊赋纪事","author":"伍瑞隆","text":"山晚秋无赖，登临坐屡移。\n既开松蕊酒，还对菊花枝。\n醉客矜高调，佳人羡画眉。\n转怜兰蕙质，归路北风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜寄何伯友 其一","author":"伍瑞隆","text":"两夜霜渐白，一山秋尽红。\n门疏蒋翊客，心忆淮南丛。\n海气槛前树，雁声天末风。\n怜君不得见，搔首嗟飞蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜寄何伯友 其二","author":"伍瑞隆","text":"汲泉出深竹，望月上层台。\n宿鸟去复去，幽人来不来。\n梦中与子别，云念青山隈。\n何事但相忆，蹉跎首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将游西樵舟中与李太史诸公赋 其一","author":"伍瑞隆","text":"不惮名山远，来从太史游。\n客兼群谢会，人羡李膺舟。\n水色摇残日，蝉声剩晚秋。\n滔滔江上意，箫鼓在中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将游西樵舟中与李太史诸公赋 其二","author":"伍瑞隆","text":"树影临江断，名山入望遥。\n村原隐楼榭，云日丽风潮。\n酒对澄波夕，琴将片月招。\n客行殊未已，何处是西樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游樵舟中见新月","author":"伍瑞隆","text":"新月小如眉，维舟初见时。\n影寒清不灭，光动夜能迟。\n巧引名山兴，晴依小谢诗。\n琴歌恣幽赏，相对送清思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟泊海珠寺","author":"伍瑞隆","text":"回舟泊水寺，入夜访禅踪。\n月送过江雁，云随出洞龙。\n晚凉清宝瑟，细雨落芙蓉。\n客醉倦思睡，开帘闻晓钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中同李伯襄舍弟有开送戴公纶彭伯时李烟客三子","author":"伍瑞隆","text":"落月在深竹，送君朝出山。\n乘闲幸相及，得趣不同还。\n远火鸡声外，残霜鹿迹间。\n亦知非小草，惆怅损离颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中同伯时烟客有开步月","author":"伍瑞隆","text":"为怜清夜色，乘月步烟霞。\n树暝山无路，林香桂有花。\n沿崖疑积雪，傍砌失晴沙。\n归路乌啼冷，澄空玉镜斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荡桨","author":"伍瑞隆","text":"微风吹绿野，月出泛轻艖。\n倚棹听山响，闻香辨岸花。\n乘流无远近，托兴有鸥沙。\n不觉寻源转，留人烟与霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿云路村","author":"伍瑞隆","text":"白云深不极，篱落数家村。\n风俗有遗朴，儿童亦候门。\n花寒风自落，山晚日初昏。\n就此聊高枕，登临兴绪繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中怀紫雾林寄小开","author":"伍瑞隆","text":"清川望不极，行客感何深。\n落日他山外，怀君紫雾林。\n索居时屡改，愁思病兼侵。\n寂寂推篷夜，长歌对玉琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日舟中坐雨限韵","author":"伍瑞隆","text":"瘦因长厌肉，淡岂为无盐。\n散帙诗千卷，扁舟雨一帘。\n潭香花影聚，人语鹤声兼。\n坐待前溪晚，新篁爽气尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中柬先日同泛诸子","author":"伍瑞隆","text":"今日好相见，雨中殊寂寥。\n幽怀催染翰，高兴忆乘潮。\n径湿残红上，阶冲片绿销。\n此时君不过，何以谢清宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有开新舟成与诸子同泛","author":"伍瑞隆","text":"新兴满新舟，盈盈初溯流。\n将寻十洲去，便借五湖游。\n入座皆王子，留欢尽子猷。\n凉风晚萧瑟，云日近清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋前三日送刘良倩还五羊","author":"伍瑞隆","text":"故山非不好，难系远游情。\n酒逐春心尽，愁连秋草生。\n羁怀三径竹，花事五羊城。\n别后看明月，思君磬一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕寄公纶","author":"伍瑞隆","text":"秋来风雨积，竹径暝相催。\n不见支机去，空传乞巧来。\n遥闻作赋处，朝暮云阳台。\n耿耿七襄夜，思君首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月六日大风雨纪异","author":"伍瑞隆","text":"大风起东北，吹雨太萧萧。\n故老传遗事，生平见此宵。\n群灵纷震荡，万室信飘飖。\n此事惊心甚，谁当慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月六夜大风雨寄杨羽君","author":"伍瑞隆","text":"江村多飓母，此事古来无。\n室似悬三峡，家疑付五湖。\n木摧山尽应，檐响夜偏孤。\n对此悲身世，思君在玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜不寐因念幼度从弟方在远行赋此寄忆并答见寄 其一","author":"伍瑞隆","text":"凉风起林薄，不寐月当楼。\n念子远为别，思乡况属秋。\n逃虚身似鹤，乘兴夜宜舟。\n寂寂空相望，劳歌谁为酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜不寐因念幼度从弟方在远行赋此寄忆并答见寄 其二","author":"伍瑞隆","text":"怀人清不寐，片月二更初。\n地僻暑应尽，庭虚秋有馀。\n美名知莫及，清梦近何如。\n无限相怜意，西风一寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何龙友将入京携同瑞昆诸子过余信宿席上分赋得寒云","author":"伍瑞隆","text":"漠漠愁笼树，霏霏寒洒空。\n从龙连北极，如盖感西风。\n海上将残雨，天边送断鸿。\n何当捣衣夜，怅望碧霄中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚秋雨中同侯度有开集仙伯延清馆","author":"伍瑞隆","text":"岁月秋期暮，招寻得故欢。\n闲情池上柳，幽思雨中兰。\n绿绮人空老，青云计转难。\n犹馀双剑在，风雨对君看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兰阁坐雨诸子来集 其一","author":"伍瑞隆","text":"小阁幽如洞，登临颇自宜。\n兼逢二三子，相伴寂寥时。\n静爱琴尊乐，清怜雨露滋。\n此中飞动处，未许众人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兰阁坐雨诸子来集 其二","author":"伍瑞隆","text":"偶尔成幽赏，居然得隐心。\n窗檐山色近，门径雨花深。\n夕鸟乱鸣树，凉风微动琴。\n平生寥落意，对尔一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兰阁坐雨诸子来集 其三","author":"伍瑞隆","text":"随意移床枕，无窗不可眠。\n人烟丛竹下，秋色小山前。\n雨久芙蓉落，溪深荇藻鲜。\n相看兴不减，何必晋人贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送潘侍御还朝月夜赋别","author":"伍瑞隆","text":"使君能爱客，惜别更维舟。\n坐对碧阴下，泠然江水流。\n波翻明月小，风动晚云秋。\n不是今宵兴，离筵不耐愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬何似公李伯襄诸子过观早梅分赋 其一","author":"伍瑞隆","text":"今年寒气早，十月破新梅。\n篱落几枝长，丛林数点开。\n暗香人不觉，幽赏客先来。\n寂寞翻成咏，怜君水部才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬何似公李伯襄诸子过观早梅分赋 其二","author":"伍瑞隆","text":"罗浮清梦后，愁寂几相思。\n花里同今夕，尊前即往时。\n寒香风自远，幽恨月应知。\n预惜欢娱地，明年恐未期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯襄太史携同似公赞夫代骧定国再过观梅时梅先开者飘落几尽止从山畔得一株太史方惘然不知梅开近皆两度也此事已三年矣是在梅花主人为之纪事 其一","author":"伍瑞隆","text":"吟眺几徘徊，聊人是早梅。\n直愁花易落，不厌客频来。\n辨蕊时披竹，寻芳更上台。\n最怜归路晚，山畔一丛开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯襄太史携同似公赞夫代骧定国再过观梅时梅先开者飘落几尽止从山畔得一株太史方惘然不知梅开近皆两度也此事已三年矣是在梅花主人为之纪事 其二","author":"伍瑞隆","text":"若问梅花事，年来异往年。\n每从千树里，争报几枝先。\n间发暂前度，繁开仍后缘。\n芳心君未了，看取季冬前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花树下寄李襄国显国","author":"伍瑞隆","text":"朝来梅树下，花落几枝新。\n不见南来使，空怀梦里人。\n同心双白璧，和曲并阳春。\n陇畔经年别，何时展旧亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀从弟文度","author":"伍瑞隆","text":"得意二三子，如君良亦稀。\n寒梅开又落，行客几时归。\n旅梦寒应作，芳心倦转违。\n朝朝候消息，愁见雁鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中志感寄李太史伯襄 其一","author":"伍瑞隆","text":"黑雨动经旬，幽人却未贫。\n总无身外物，时有意中人。\n白璧成何用，青云不可亲。\n从归武陵后，不敢怨强秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中志感寄李太史伯襄 其二","author":"伍瑞隆","text":"日落雨声歇，远钟来翠微。\n天长人独立，江远雁双归。\n雪树果先落，风岩花易飞。\n遥怜李供奉，吟眺倚荆扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中志感寄李太史伯襄 其三","author":"伍瑞隆","text":"林泉何历历，雨过转萧然。\n潦穴通藏蚁，风枝落病蝉。\n清疏关独解，飞动惬终篇。\n乘兴今何道，高楼云汉边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得归山独鸟迟","author":"伍瑞隆","text":"倦飞还就啄，欲宿更呼群。\n片影依山月，孤鸣入暮云。\n旧巢应不负，密树暝难分。\n三匝声逾切，无劳送客闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨过驼山小楼","author":"伍瑞隆","text":"行眺不得志，萧然还掩关。\n雨中千树橘，花外万重山。\n湿鸟归恒暮，孤云去不还。\n啸歌向天地，吾意醉醒间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日积雨 其一","author":"伍瑞隆","text":"雨声临夕起，耿耿度寒霄。\n卜霁日连日，萦愁朝复朝。\n宁辞病花柳，颇怪妒渔樵。\n祇合擎飞沫，旗枪款寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日积雨 其二","author":"伍瑞隆","text":"连宵苦积雨，昨日且轻雷。\n水阔蛟龙怒，天长鸿雁哀。\n蹇沙颓潦竹，腐蕊落风梅。\n耕凿年年事，艰难谁为裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纪霜","author":"伍瑞隆","text":"十日九风雨，乍晴天有霜。\n凄清动高阁，飞洒到虚堂。\n积柳疑飘絮，凝花作淡妆。\n山中无一事，对此意何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮寄陈时献","author":"伍瑞隆","text":"怀人惊节序，握手限津梁。\n沧海交情远，云山别路长。\n论花朝倚袂，倾酒夜焚香。\n彩笔知无恙，何时接雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊午小除前三日立春","author":"伍瑞隆","text":"坐觉春风转，蹉跎岁近除。\n一年看又尽，双鬓感何如。\n暖入花争笑，寒归柳尚疏。\n野人相唤饮，随意剪青蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李太史宅赏蕙花","author":"伍瑞隆","text":"名花喜相识，况复此同看。\n远韵良先桂，芳名耻后兰。\n露含金液浅，风引玉香寒。\n百亩离骚客，应怜赠所欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李伯襄见怀之作","author":"伍瑞隆","text":"幽居人事懒，怀尔独愁思。\n一负芳辰赏，同愆雪夜期。\n花明朝日露，柳长别时丝。\n不尽怀春意，芳兰可赠谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见新月","author":"伍瑞隆","text":"月色久不见，朦胧此夜悬。\n清光如有待，纤影自堪怜。\n玉笛朱门里，春灯紫陌前。\n邀欢正须汝，好为照琼筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"制霓裳羽衣箫谱成听诸箫郎掐韵","author":"伍瑞隆","text":"不复人间想，新成月里篇。\n声疑隔霄汉，人似挟飞仙。\n艳曲琼楼借，芳心玉指传。\n应知天上谱，元异李龟年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘良倩","author":"伍瑞隆","text":"词场侠少年，谁在刘生前。\n傲骨世不赏，清才吾独怜。\n松为稽子韵，兰是楚人篇。\n终合乘风起，高名日月边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚秋同刘孟骧卢子初李德孚刘良倩家文度诸子宿白云寺分赋","author":"伍瑞隆","text":"风尘吾自厌，猿鹤遂为群。\n一枕到明月，千峰卧白云。\n疏钟花里度，清梵夜深闻。\n渴向龙泉饮，应留肺腑芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿月溪寄答小开","author":"伍瑞隆","text":"禅床孤月夜，寂寞坐秋光。\n伴榻云如水，开帘山满堂。\n雨花晴自散，清籁夜偏长。\n感念昔游子，思君各一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登摩星岭是白云绝顶处","author":"伍瑞隆","text":"绝壁俯群山，登临云雾间。\n盘纡随鸟道，窈窕出松关。\n把酒天应近，怀仙鹤未还。\n自怜人境外，随意得跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓登白云峰望仙岩寄安期子","author":"伍瑞隆","text":"野日禅窗白，苍凉秋气开。\n鹤飞曾不到，仙去几时回。\n山碧云多态，天青雁独回。\n无人见幽兴，独自上层台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安期岩","author":"伍瑞隆","text":"千峰逋客意，七载卧游心。\n倚杖青霄暮，怀仙琪树林。\n野花寒自发，细竹晚逾阴。\n服食真吾事，菖蒲未许寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滴水岩 其一","author":"伍瑞隆","text":"宝刹白云峰，名泉汇九龙。\n经行数丛竹，飞泻出深松。\n气肃三秋雨，声含众壑钟。\n到来心自远，长啸采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滴水岩 其二","author":"伍瑞隆","text":"云湿常凝草，苔深故没桥。\n玉龙晴不去，珠箔冻初摇。\n拂石流逾险，淩风势转骄。\n寻源因复上，迢递出青霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"合掌岩小庵","author":"伍瑞隆","text":"壁削双峰陡，庵临万仞遥。\n俯窗魂屡动，步径石疑摇。\n人迹谁堪下，山灵气日骄。\n岩花与涧草，随意碧萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为何伯韬赠庆伯别","author":"伍瑞隆","text":"三月柳条春，离堂画烛新。\n可怜璚树侣，同是沅陵人。\n未得花间赏，先伤别后神。\n何时过南阮，杯酒一相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日雨王姬过集问月楼因从余授霓裳箫谱 其一","author":"伍瑞隆","text":"令节怜秋晚，高楼醉玉人。\n雨中尘不到，花里静偏亲。\n箫按霓裳怯，鬟簪紫菊新。\n卿家在何处，长许接芳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日雨王姬过集问月楼因从余授霓裳箫谱 其二","author":"伍瑞隆","text":"偶逐行云至，因陪落帽筵。\n映娇丛菊下，凝思小窗前。\n作赋吾何敢，多才汝亦怜。\n他时倘相忆，怅望碧云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈时献诸子夜集问月楼时余将还山","author":"伍瑞隆","text":"高楼秋似水，下榻夜相亲。\n徙几见万里，凭虚无一尘。\n风澄天宇碧，月洗露华新。\n明日沧江上，俱为入梦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日閒居","author":"伍瑞隆","text":"若问閒居事，春来颇自便。\n溪声如昨日，山色入新年。\n画意花能解，诗情鸟欲传。\n空斋无俗物，和墨写春妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日病戏作小诗","author":"伍瑞隆","text":"幽意写不尽，聊将清磬传。\n编篱桑是佛，摘果掌为仙。\n法法原非法，玄玄却又玄。\n谁应观妙理，吟笑到花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日晓起与有开","author":"伍瑞隆","text":"露气澄清晓，疏凉足好秋。\n鸟兼霜叶度，溪入径花流。\n仆懒从辞客，人闲漫倚楼。\n知君有新兴，吟眺水西头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]