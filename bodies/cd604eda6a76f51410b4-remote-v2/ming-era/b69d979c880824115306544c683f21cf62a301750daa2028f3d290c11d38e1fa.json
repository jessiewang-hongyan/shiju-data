[{"title":"送王侍御子衡巡关中","author":"顾璘","text":"经过故国逢迎处，忽忆先朝宴乐时。\n此夕寒樽须尽醉，明朝岐路又相思。\n风光不改长安陌，草色应连太乙祠。\n行部岂唯山岳动，知君幽赏盛文辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送庄伯仁还彭城","author":"顾璘","text":"千山积雪映朝晖，匹马东归旧路微。\n梁苑楼台行处尽，辋川图画眼中稀。\n兵戈满地愁看剑，桑梓何年对掩扉。\n怀抱向君输未得，玉壶清酒重相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送时将军平蜀寇","author":"顾璘","text":"百战曾闻静虏尘，七擒今见破黄巾。\n蛮方帅印提金虎，内殿恩袍刺玉麟。\n万里风烟归指顾，一生忠义属艰辛。\n云台拟画封侯像，铜柱无劳羡古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和少传陈留公夏日野庄卧病之作二首 其一","author":"顾璘","text":"茅斋寄在古城边，堂下犹存旧砚泉。\n芳草閒门无俗驾，乱鸦疏柳对秋天。\n艰危周勃安刘后，慷慨温公入洛年。\n圣主赐金堪养老，故山醇酒且安眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和少传陈留公夏日野庄卧病之作二首 其二","author":"顾璘","text":"闻道裴公返近郊，野堂潇洒自诛茅。\n城隅古道人孤往，门外新松鹤已巢。\n京洛上公时问讯，江潭渔父或求交。\n向来丹毂非吾愿，白首谈玄任客嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠臧怀庆瑞周","author":"顾璘","text":"海内争传国士风，梁园倾盖意何穷。\n已闻德政过黄霸，更爱儒宗自鲁公。\n客久授衣秋色里，夜寒弹剑月明中。\n离愁祇隔长河水，莫遣双鱼恨不通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早秋日宴宗伯乔公宅","author":"顾璘","text":"南宫新第早秋凉，东阁延宾逸兴长。\n莲荐碧房浮玉碗，梧飘黄叶下银床。\n孟坚奕旨精玄理，逸少诗筵重罚觞。\n暂向门墙依北斗，预愁飘泊向炎方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代范祖教酬朱青州","author":"顾璘","text":"海内朱轮俱赫奕，下贤谁是信陵君。\n能将直节全元亮，肯以私交负孺文。\n古道分明如皎日，世情翻覆祇浮云。\n酬恩独有诗堪寄，极目青齐雁影分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄宝应范老","author":"顾璘","text":"竹杖纱巾映白头，淮南耆旧让风流。\n身閒对酒忻无事，禾熟逢人说有秋。\n花坞云香歌扇动，鹭湖天晚钓船收。\n怜君住处堪乘兴，拟傍清溪共饮牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和赵金华叔鸣除夕早朝","author":"顾璘","text":"紫极开春御气清，青阳临午圣颜明。\n风前羽葆摇龙影，云里箫韶下凤声。\n蕃使总陪端笏列，近臣长傍禁阶行。\n腐儒谬接专城寄，惭愧来朝朱绂荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日早朝呈同觐诸君子","author":"顾璘","text":"宫云拂曙金旟列，禁雪迎春玉殿开。\n礼乐总兼三代出，衣冠遥会万方来。\n嵩呼共捧龙笺上，镐宴还沾柏酒回。\n同睹盛仪谁更纪，词林独有长卿才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答徐昌谷广文","author":"顾璘","text":"杨子翛然居学省，闭门安坐日谈玄。\n共嗟朝市留真隐，转见风流胜昔贤。\n深巷马嘶闻过客，古台花发动韶年。\n逢君却愧尘埃误，苦忆江南种秫田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58048,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出京和殷伊阳文济","author":"顾璘","text":"白日浮云暗凤城，远臣辞阙倍含情。\n愁经异域逢春色，忍别前溪对水声。\n马首东风犹自急，山腰新月为谁明。\n与君莫近芦沟宿，水冷沙寒雁鹜鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58049,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"见道上老马","author":"顾璘","text":"霜毛凋尽锦云斑，落日长鸣大道閒。\n老去谁铺金埒卧，战时曾度玉门还。\n尘沙风断三千塞，苜蓿秋空十二闲。\n愿取敝帷终惠养，敢希枯骨动君颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58050,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过肥乡柬郭侍御于藩","author":"顾璘","text":"晓风吹马度清漳，遥指幽林问草堂。\n骢马归来成隐逸，黄鹂啼处有春光。\n愁多更厌干戈满，别久应怜鬓发苍。\n独愧腐儒无所用，报君将欲赋沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过广平旧邑柬孙令","author":"顾璘","text":"春风旧邑经过处，城郭依然感客心。\n眼见故民多识面，手栽新树己成阴。\n郊迎父老群相问，地主仙郎日对吟。\n闻道近来歌杜母，愧无前誉比南金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陆良弼赴楚雄陆旧守云南","author":"顾璘","text":"京国逢君更送君，浮生离合类浮云。\n长才出众仍为郡，久别生男已解文。\n滇巂苍山酬旧约，循良青史继前闻。\n东曹故友无多在，莫遣音书滞雁群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答张愈光留别","author":"顾璘","text":"淮南阻绝兵戈际，冀北逢迎瘴疠馀。\n万里知心仍此别，他时携手定何如。\n荒台脩竹经梁苑，匹马孤烟度楚墟。\n彩服到家安稳甚，早挥潘笔赋閒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送池州施司理","author":"顾璘","text":"长才竟失金门第，大郡聊悬黑绶行。\n断狱好师于定国，赋诗还继谢宣城。\n家山日送登楼色，江水秋回绕郭声。\n土物况宜调膳美，白鱼青笋饭香粳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同汪希会钱塘观潮","author":"顾璘","text":"使君驻节钱塘口，曾见江潮突兀来。\n雪影障天千仞白，雷声喧海两山开。\n孤舟簸荡行难稳，往事销沉去莫回。\n南渡君王吟赏处，峰头空指旧楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠玉枕山人","author":"顾璘","text":"石洞霞生玉枕阴，下窥南极海波深。\n仙人筑室虚无里，俗子传声何处寻。\n终岁著书藏古穴，有时清啸落空林。\n知君自爱逍遥乐，莫话人间出处心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白羊口清泉次周太仆","author":"顾璘","text":"碧涧清泉映地来，黄尘白草向人开。\n澄心不乱秋云色，照影还牵独客哀。\n曾洗甲兵清朔漠，拟浮舟楫望蓬莱。\n赋诗亦有临流兴，揽辔惭非跃马才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58058,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐登州用中","author":"顾璘","text":"送君相对恋残曛，乡里衣冠最出群。\n手绾虎符临海郡，腰悬龙剑动星文。\n行过泰岳逢春雪，望尽扶桑隔晓云。\n待到政成观蜃市，新诗应许四方闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58059,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄寿大司徒洪洞韩公","author":"顾璘","text":"台省巍峨一正臣，太行冰雪洗心神。\n云霄羽翮回孤凤，丘壑风流接古人。\n卧稳朱衣长在箧，忧深斑鬓总如银。\n诸郎籍籍专城贵，走送琼筵寿酒新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58060,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鲍太守新堂","author":"顾璘","text":"鲍叔新堂泗水滨，虚檐潇洒隔风尘。\n巧当竹径开庭户，直取云山作主宾。\n病起马卿多懒慢，位高文子亦清贫。\n疏帘曲几观书地，白发投簪兴更新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58061,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿香山寺","author":"顾璘","text":"禅宫高起万峰头，曲径幽林不可求。\n佛向海中移碧水，人来天上坐朱楼。\n垂垂星斗凭阑见，飒飒□云对酒愁。\n借取西岩明月影，直依旌旆望扬州。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58062,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自香山往卧佛寺马上作","author":"顾璘","text":"马首青山处处新，林间幽径迥无尘。\n楼台映水皆成画，竹树含烟不让春。\n潦倒欲谋千日醉，升平那送百年身。\n五侯歌舞欢娱地，野老凭高独怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58063,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑继之归鳌峰","author":"顾璘","text":"四月燕山雨雪寒，省郎多病复辞官。\n路经海上三神岛，兴在仙人九转丹。\n玉洞桃花留笑靥，沧江秋水湿渔竿。\n尔家谷口空长往，安石东山望未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58064,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与夏德澍游戏龙院暮归","author":"顾璘","text":"城郭谁知涧壑凉，秋天何似野情长。\n烟峰九叠迎曛紫，云木千章过雨苍。\n满地山花清俎豆，高飞溪鸟避冠裳。\n同游况有天台侣，共绕流泉话石梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58065,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日登巾子山","author":"顾璘","text":"隐几朝朝爱翠微，佳辰来醉菊花卮。\n千门落照低秋影，万里长云接鬓丝。\n击鼓每疑高塔动，临崖方见古松垂。\n风光绝好乡关异，北望长唫有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58066,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赵叔鸣","author":"顾璘","text":"澄江潇洒散柴门，暂弄渔竿玩晓昏。\n九鼎犹增淮海重，数篇谁赋泰山尊。\n黄尘白浪归心远，药裹书签旧物存。\n与子同袍未同趣，高城吟望几销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58067,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入康谷","author":"顾璘","text":"岩峦嵂兀步凌兢，时有人家住翠屏。\n磴路盘峰云曲曲，山田开石水层层。\n高林落照悬馀霭，古涧流泉咽断冰。\n不识前朝陵谷变，独寻残碣问山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58068,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿康谷晓归","author":"顾璘","text":"山寺鸣鸡促晓驺，篮舆冲黑过峰头。\n天低路向云中落，雾重山如海上浮。\n竹叶随时供野酌，桃花何处问渔舟。\n松泉满眼行将尽，已动红尘簿领愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58069,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈鲁南","author":"顾璘","text":"羡子谈经侍石渠，鸡林声动四方初。\n家僮可解呼君实，监吏无劳荐子虚。\n紫禁花深摇委佩，玉堂云迥下公车。\n新诗寄我侵骚雅，潦倒泥涂愧不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58070,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日游永庆寺","author":"顾璘","text":"城郭晴光荡客车，古岩高寺切青虚。\n莺花不断人天界，龙象长依水竹居。\n云里壶觞吞海色，山中风物似秦馀。\n灵踪咫尺长难到，莫怪归迟月满衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58071,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游云峰寺","author":"顾璘","text":"层峰行尽入岩扉，石上烟霞点客衣。\n云净海天诸岛出，雨晴山郭乱花飞。\n清歌送酒惊春鸟，缓步寻芳带晚晖。\n闻道真僧长闭户，欲来谈法共忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58072,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢答景伯时往岁见寄之作","author":"顾璘","text":"移官东海已经年，长忆潇湘洒泪篇。\n鸿雁独能踰岭去，梅花何意向人妍。\n艰危转觉同心贵，懒散空劳众口怜。\n齿发似君情独倦，只应归种汶阳田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58073,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居对雨忆钦佩","author":"顾璘","text":"山馆雨声鸣不休，空阶野泉交互流。\n已思吏散得高枕，无奈花发增烦忧。\n风波中座忽反覆，乡关在望空夷犹。\n安得王郎共促膝，一写幽抱登江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58074,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"补寄张司马九月六日忆湘山寺旧游一首","author":"顾璘","text":"遥忆东山张太傅，去年今日共离觞。\n清江画舫愁中别，古寺寒松梦里苍。\n黄菊再逢非旧客，白头相见定何乡。\n题诗欲寄衡阳外，目倚西风送雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58075,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄答陶世和","author":"顾璘","text":"十年京洛事堪伤，归卧稽山鬓发苍。\n祖德未忘陶靖节，乡贤还见贺知章。\n龙墀旧疏今谁记，虎榜同人倍有光。\n珍重寄书秋又晚，夫容零落满溪霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58076,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别冀承忠","author":"顾璘","text":"摇落空山独送君，十年多故叹离群。\n归期梦隔淮南月，世事愁翻海上云。\n共有深襟封旧恨，不劳寒烛引残醺。\n神驹自昔非凡种，看取行囊宝剑文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58077,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正旦雪","author":"顾璘","text":"除夜残寒结海云，新年瑞雪晓氤氲。\n梅花映阁参差见，竹叶临窗浙沥闻。\n色点朝衣随拜舞，春生农扈启耕耘。\n遥思圣主西征地，椒酒传宣遍六军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58078,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别舒广文还湘南兼寄故人二首 其一","author":"顾璘","text":"曾下湘皋采菊英，漫劳朋旧记微名。\n轩车己作三年别，城郭仍含万里情。\n海畔来同河朔饮，灯前惊听楚歌声。\n浮云世事多翻覆，莫对青山意不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58079,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别舒广文还湘南兼寄故人二首 其二","author":"顾璘","text":"湘南山水最宜人，风物萧萧绝世尘。\n磐石江清见鱼影，甲峰松古长龙鳞。\n幽栖问字吹藜火，烂醉回船倒葛巾。\n旧种桃花今在否，相思烦为赏馀春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58080,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"补寄张司马戊寅九月六日诗","author":"顾璘","text":"山城菊蕊两逢秋，湘水夫容万里愁。\n社稷独怀宋司马，神仙难觅汉留侯。\n诗成绿野人谁寄，酒散黄金客未忧。\n台海东边寻旧约，不胜幽梦落沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58081,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同李别驾登巾峰","author":"顾璘","text":"腊月己去正月归，梅花满林飞渐稀。\n海峰积雪白垒垒，江树映日寒辉辉。\n丘壑对筵须纵酒，朝廷旋凯正垂衣。\n台南物色殊堪赖，秉烛题诗兴莫违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58082,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辛巳元日回风亭作","author":"顾璘","text":"元日东风花气香，即看蝴蝶过茅堂。\n山含碧雾霏霏色，时隔丹霞闪闪光。\n楚水旌旗收战略，汉廷诛赏布王纲。\n何时柏酒开春瓮，醉舞斑衣白发傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58083,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日与客宿金山二首 其一","author":"顾璘","text":"江上春山青可怜，角巾同泛过江船。\n峰光仄起通人径，海色平铺到酒筵。\n烟月光摇洲树动，风涛声撼石堂悬。\n驱驰久恨妨清兴，徒倚废知废夜眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58084,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日与客宿金山二首 其二","author":"顾璘","text":"灵峰为爱及春游，冉冉风烟数倚楼。\n海上帆樯夷夏接，江间台殿古今浮。\n行逢嘉树韶华动，坐傍高云客思愁。\n铁瓮不孤开大府，紫宫遥拱对神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58085,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答周观察独泊焦山","author":"顾璘","text":"江心高嶂拥青鬟，羡尔维舟紫翠间。\n明月满山春淡淡，长风吹浪夜潺潺。\n寒鼍下抱孤根宿，独鹤遥横别岛还。\n怅望烟萝虚胜践，沧波愁为洗尘颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58086,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过扬州有感","author":"顾璘","text":"前年客棹经芳甸，武帝龙旂烂锦川。\n北日芜城仍对眼，五湖云水共凄然。\n春光泛滟璚花月，旅思缠绵碧草烟。\n俛仰不堪陵谷变，白头唫坐向江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58087,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮凌溪新园","author":"顾璘","text":"二月扬州淑景新，西园花月解留人。\n仲长乐志因逃禄，潘岳閒居遂奉亲。\n行坐不离醒酒石，逢迎俱是问奇宾。\n看君种树今盈尺，会见欹檐合抱身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58088,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沛上怀古","author":"顾璘","text":"汉祖还乡歌大风，高台提剑气成虹。\n关西父老三章约，垓下河山百战功。\n祇见枌榆生故社，屡闻鸡犬变新丰。\n经过又是高阳侣，醉折桃花荐酒红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58089,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送牛总兵赴贵州","author":"顾璘","text":"当朝郤縠最知名，开府西南握重兵。\n白社分茅专节制，乌蛮锁甲避先声。\n威行铜柱提封远，官插金貂阀阅荣。\n更忆雅歌同宴语，俨然风度古儒生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58090,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天津喜雨二首 其一","author":"顾璘","text":"赤旱弥冬复度春，今晨飞雨落江津。\n雷声出地喧群蛰，云气行空走百神。\n即有鸬鹚矜水影，尚馀麰麦感皇仁。\n迂儒破闷开金盏，捲幔凭阑晚兴新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58091,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天津喜雨二首 其二","author":"顾璘","text":"灵雨乍破风霾昏，洒空胡不即翻盆。\n林花一洗仍春色，川涨初来已旧痕。\n沂浪同时□泛泛，衔泥无数燕翻翻。\n群情共荷桑林祷，剪瓜斋心慰至尊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58092,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李一之都阃","author":"顾璘","text":"将军心胆向人倾，缓带垂腰玉剑横。\n韬略全过汉飞将，交游半是鲁诸生。\n风江画楫春同远，月席金杯夜更清。\n莫道腐儒浑落魄，醉深犹自索谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58093,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张含还金齿","author":"顾璘","text":"上国遥携爱弟来，人传二陆总奇才。\n承家文学岂易得，失意天门仍暂回。\n马色飞云开万里，剑光冲岳照三台。\n堪怜南去风流远，咏尽寒斋蜡炬灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58094,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桐江夜行","author":"顾璘","text":"画舫悬灯一水遥，炉烟相伴坐良宵。\n江云掠幔寒仍重，山月垂波静不遥。\n岂有风猷宣列郡，漫输心膂答清朝。\n严陵滩上垂钦石，犹见残星动紫霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58095,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重过严陵钓台","author":"顾璘","text":"千年钓叟披裘地，客子张帆两度过。\n朱绂频经风雨后，青山其奈古今何。\n松杉落落连祠屋，蘋藻馨馨满涧阿。\n叹息云台诸将相，几人图像独嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58096,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"衢州道中呈子贤宪佥","author":"顾璘","text":"江上相逢衣绣客，青云高况映霜天。\n玄谈屡接清尊酒，丽藻初传宝剑篇。\n长路群山催染翰，中流明月照行船。\n淮南桂树空摇落，岁暮天涯共惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58097,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后泛湖和周子贤","author":"顾璘","text":"西郭群峰积雪寒，画船湖上倚篷看。\n楼台隐见青松色，芦荻萧条白雁滩。\n沉醉放歌新岁始，阳春和曲古来难。\n期君尽访山中寺，细草微风石路乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58098,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登南屏山绝顶","author":"顾璘","text":"雾璧霞岑路有无，下窥平地散江湖。\n青天咫尺星辰湿，沧海周回岛屿孤。\n吴越向来悲粉黛，乾坤何处觅蓬壶。\n清尊坐接流云饮，白日苍茫对画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58099,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]