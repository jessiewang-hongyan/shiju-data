87a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘僚长士美谳狱四川四首 其四","author":"欧大任","text":"陇坂碉门几万盘，武侯城远渡泸寒。\n峨眉天外三千丈，谁共仙郎雪后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱僚长可大南归省觐司空公五首 其一","author":"欧大任","text":"蓟门山色散浮云，谁谓春风此送君。\n策马都亭鞭更疾，路旁争看五花文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱僚长可大南归省觐司空公五首 其二","author":"欧大任","text":"楚天西望逼匡庐，玉笥烟霞大保居。\n自昔韦贤辞相早，玄成偏受箧中书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱僚长可大南归省觐司空公五首 其三","author":"欧大任","text":"齐鲁诸儒让石家，趋归先下里门车。\n五云驿近芙蓉嶂，何限庭前玉树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱僚长可大南归省觐司空公五首 其四","author":"欧大任","text":"曾记司空治水时，鱼台滕沛引流澌。\n转漕百万功非细，去读支河十丈碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱僚长可大南归省觐司空公五首 其五","author":"欧大任","text":"两岸青枫江水流，可堪烟雨宿孤舟。\n傥思西署同游客，回首金茎白露秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周计部元孚被播南行答其临清所寄因以为别 其一","author":"欧大任","text":"陌上论交易别离，御沟杨柳渐成丝。\n可怜一片燕台月，不似清源送客时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周计部元孚被播南行答其临清所寄因以为别 其二","author":"欧大任","text":"宪令谁将妒左徒，采蓠能忆握兰无。\n岂劳渔父相逢问，白雁青枫过五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周计部元孚被播南行答其临清所寄因以为别 其三","author":"欧大任","text":"玉泉南下入漕河，楚客扁舟榜枻歌。\n何限故人江阁望，天涯芳草夕阳多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬张元易送木瘿瓢","author":"欧大任","text":"长生木瓢置佛前，何年山隐辟支禅。\n带将风露中条色，归汲曹溪白象泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾叔潜约郊游不赴","author":"欧大任","text":"缓辔听莺御苑西，杨花飞尽草萋萋。\n可堪粉署随人出，不似春郊信马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬吴声父画蘧园图","author":"欧大任","text":"挥毫双目送飞鸿，丘壑偏宜置此公。\n寿我罗浮八千丈，醉持金策白云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠写容山人吴仲黄","author":"欧大任","text":"扶荔芭蕉似我庐，抛来蓑笠恋簪裾。\n笑君不肯传真去，留伴青黎阁上书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都门作二首 其一","author":"欧大任","text":"玉河汤汤流，白日冉冉度。\n今晨驱我车，踟蹰即岐路。\n言念肮脏人，敢有缨緌慕。\n主圣实优容，班竹愧非据。\n跌宕汉公卿，能垂特达顾。\n游好眷失群，贵靡忘徒步。\n贻之黄父言，送我青门驭。\n绸缪邺中宴，哽咽河梁赋。\n碣石日迢遥，浮云怅驰骛。\n行者不可留，申章寄情愫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都门作二首 其二","author":"欧大任","text":"猗彼汶上篁，移植来蓟丘。\n峄阳孤生桐，托根河中洲。\n何异岩峦姿，一顾蒙恩庥。\n风云幸值遇，七载瞻宸旒。\n日趋金马门，亦点铜龙楼。\n霄汉翱以翔，改秩陪京游。\n俶装辞密亲，分镳盻良俦。\n别促思方始，一日诚三秋。\n南曹孰云远，浅薄固所忧。\n岂不恋禁闼，宣力宁易酬。\n黾勉就长路，夷犹戒鸣驺。\n君其惠前绥，慰我行悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惊雷篇","author":"欧大任","text":"昊天时疾威，积风殆先兆。\n阴阳适相薄，蓊郁怒而剽。\n我舟次江介，迅雷击樯杪。\n丰隆破响来，列缺飞光剽。\n隐隐尚填填，霆奋更火燎。\n骇气久奔激，倏闪远罗曜。\n斯须匕箸失，顾盻篙师咷。\n世异景公台，变似夷伯庙。\n休咎我方省，善否天所照。\n震邻已切躬，察痾蚤求疗。\n在莒能无忘，居邹惧难肖。\n夕惕敕戒勤，励德永思劭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞烈篇","author":"欧大任","text":"东治钟灵粹，三山閟幽贞。\n女出林氏门，礼训自性成。\n蚤受聘于陈，待年犹未行。\n夫倏苕荣凋，女敢爱其生。\n穗帷不可望，鞶丝空复情。\n罗静岂慕烈，翟素宁希名。\n谷也莫共室，窆可同佳城。\n从容求吾志，一死冰霜明。\n宴娭并云盖，姚裔飞霓旌。\n春兰更秋菊，终古歌怀清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萦河篇","author":"欧大任","text":"岷山导江水，发自天汉上。\n源深流以长，嘉陵渺相望。\n飞湍漫漭来，云气纷沆砀。\n灌入冯夷潮，时涌江妃涨。\n赤岸泛霞津，白沙积霜障。\n练净朝以披，縠鲜书还荡。\n萦回巴子曲，猛锐巴渝唱。\n隐君洁者流，下帘丈人行。\n遗荣早蜚遁，远志谢禽向。\n亭皋俯潺湲，衿情日夷旷。\n上善镜空明，至文涣溶漾。\n薖轴一何幽，老易素所尚。\n乐泌已永年，击波有遗榜。\n涟漪犹至今，荇藻莫可状。\n其中方圆折，珠玉光摩荡。\n毓祥井络西，千龄烛星象。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜直省中","author":"欧大任","text":"华省傍画垣，闶门夹朱户。\n纵横太弩署，回薄公车府。\n自为含香吏，宿直卧周庑。\n徂宵秋已深，莎鸡振其股。\n坠露芳蕙凋，惊飙散蓬聚。\n肃穆仰皇居，萧寥视天宇。\n幸兹际休明，授餐过升釜。\n岂不畏简书，敢云薄簪组。\n考父示益恭，旦夕惟偻伛。\n陈力即未疲，尸位曾何补。\n驰思白云中，矫望皋禽羽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜怀张幼于","author":"欧大任","text":"兹夜一何长，劲飙起平楚。\n别君征虏亭，望君新林浦。\n同云被钟陵，密雪涂江浒。\n兰卮不共持，瑶琴待谁抚。\n缄情诒所思，因之问蘅杜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答顾司勋二首 其一","author":"欧大任","text":"宸居钜丽观，建业维旧京。\n省寺夹阊阖，宫阙槩泰清。\n人文盛斯日，鸣环猎冠缨。\n顾生起吴会，握管逢休明。\n修嫭宛珠润，清馥含兰馨。\n通方极丘索，辨古分淄渑。\n诗从四始正，曲合九奏成。\n何哉铨衡地，洵有箕颖情。\n结佩岂不美，折麻殊自荣。\n余岂茂陵客，跌宕东方生。\n申章谢嘉藻，辗转怀同声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]