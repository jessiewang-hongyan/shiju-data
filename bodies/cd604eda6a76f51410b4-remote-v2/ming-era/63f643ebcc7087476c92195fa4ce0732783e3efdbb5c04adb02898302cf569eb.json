[{"title":"秋日赠友","author":"李舜臣","text":"乙疾顷来思，秋风忽若斯。\n黄花开独晚，玄鸟去何之。\n稍习田家苦，方知静者为。\n多君能枉驾，时复慰吾私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西屏诗二首为馆人叶直夫赋直夫卜居宣武坊北门对西山以西屏自号也 其一","author":"李舜臣","text":"结宇虽城市，为屏乃翠微。\n隔篱纷可望，叠嶂远相依。\n雨后烟霞出，天边雁鹜飞。\n一尊时对酌，潇洒似君稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西屏诗二首为馆人叶直夫赋直夫卜居宣武坊北门对西山以西屏自号也 其二","author":"李舜臣","text":"胜绝城西路，昨来始一过。\n山空泉自响，湖迥芰应多。\n望极凭云阁，寻幽到石窝。\n早知为地主，好与共鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕王潼谷度支见访 其一","author":"李舜臣","text":"惊鹊栖难稳，飘蓬任所如。\n昨来犹逆旅，忽报有高车。\n庭次堪留客，城隅为索居。\n时闻话潼谷，吾志亦归欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕王潼谷度支见访 其二","author":"李舜臣","text":"寂寞扬雄宅，惟君数见过。\n家贫全简率，名薄共蹉跎。\n暝色明河出，秋风落木多。\n一尊新市得，清浊试如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕王潼谷度支见访 其三","author":"李舜臣","text":"一榻迎曛下，归轩肯夜阑。\n多君心尚尔，为客鬓俱班。\n露气添新酒，花香入薄餐。\n娟娟天上月，聊得共长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"李舜臣","text":"薄午炎蒸极，忻看雨足垂。\n似添池草绿，应洒陌尘缁。\n吏道聊乘暇，幽襟复在兹。\n因思故里日，耕稼候东菑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日约赵景仁出郭景仁有辞因简","author":"李舜臣","text":"午日蒙恩泽，彤庭既醉归。\n此时仍逸兴，相与及馀晖。\n林壑闻多美，朋曹觉近稀。\n如何草玄思，不暇览芳畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马上偶然作","author":"李舜臣","text":"秋风鼓大荒，万里长空来。\n忽然被群木，瑟瑟鸣声哀。\n黄叶日夜落，蕙草庭中摧。\n鸿雁号云中，蓬转何时回。\n顾惟仕京邑，二载兹徘徊。\n时哉岂所适，拙薄成嫌猜。\n常恐夙昔意，零落随浮埃。\n不洁一以蒙，西子犹堪哀。\n胡为复南陌，追逐相喧豗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿诗","author":"李舜臣","text":"一鸟翔天中，毛羽何奇哉。\n谓从万里昆崙道，遥指三山碧海隈。\n须臾灵驾何缤纷，凤管鸾箫翕可闻。\n正逢结实千年日，共驭为章五色云。\n五色云中振羽裳，千年树畔赴霞觞。\n玉阙金台相照曜，天文海色共青苍。\n其中燕喜何冲融，其上龙光正郁葱。\n曾劳八骏陪瑶水，偶值群仙朝碧空。\n霓旌翠盖驻天门，紫阁琼宫绝世喧。\n灵妃前献南星寿，玉女旁开北斗尊。\n已经人世几春秋，鹤舞龙吟尚未休。\n青青桂树金波湿，灼灼扶桑紫气流。\n忽而来兮倏而归，还于海上拂云衣。\n朝从东极乘初日，夕息西山憩落晖。\n遨游八极信悠哉，下见江河万古来。\n还将此日蟠桃宴，永作夫君寿祝杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜饮马考功宅","author":"李舜臣","text":"服采少暇日，良夜畅由衷。\n肃肃飙迤北，亭亭月在东。\n中天烂河宿，清晖丽房栊。\n夙心期胜引，晤语忽宵中。\n昔高蕃榻下，今摄膺门崇。\n徒倒中郎屐，深愧伯牙桐。\n归来谅得遣，慰我忧冲冲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"报国寺饯薛君采缘陪诸僚登毗卢阁二十四韵","author":"李舜臣","text":"宝阁凌阊阖，煌煌镇帝京。\n梵宫兹栋宇，尘世俯檐楹。\n饮饯叨群哲，追随缘一行。\n良辰属景豁，极眺有山晴。\n王粲销忧兴，玄晖抚化情。\n如闻钧乐发，想见玉毫呈。\n晤语应朝彻，相看或籁鸣。\n傍徨翻不惬，悽恻故多婴。\n吐鲁今深寇，河湟正用兵。\n御裘心耿耿，班马泣喤喤。\n况复横戈卒，还馀细柳营。\n皇灵须震叠，百二此藩屏。\n谋庙思裴令，喻薪忆贾生。\n时犹工贝锦，星独耀欃枪。\n鸡犬寰中困，貂珰座上盈。\n嫠怀常似丧，渴病分无成。\n念拙机甘息，包荒德莫名。\n湿灰悲列子，肯綮感庖丁。\n贱子公车辱，同人意气宏。\n忘年期好我，奋藻愧登瀛。\n顿觉游蒙尽，弥怜灏气清。\n繁霜疏古木，残律振寒城。\n赏倦谈禅夕，魂劳去客旌。\n凄凉燕燕赋，朗咏骨为惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵遇冯子和旧同吏部","author":"李舜臣","text":"山城初上日，鞍马落前墀。\n宛似清朝罢，叨陪宰府时。\n浮云如世事，流水只君思。\n五岳惟当去，看余鬓欲丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴集东麓亭因过西山道院","author":"李舜臣","text":"幽房去何处，只隔杏花丛。\n碧水如明镜，青山挂彩虹。\n庭滋芳草遍，城枕大江雄。\n虽复邻朝市，东南在目中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送湛甘泉尚书赴京","author":"李舜臣","text":"海内称耆旧，公名满缙绅。\n遭时佐明主，几岁托邦人。\n镇俗山河壮，移官省阁新。\n平生经济在，诣阙待亲陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘鹅峰侍郎改官兵部","author":"李舜臣","text":"清朝司马贵，选授必人英。\n已佐金陵久，还徵采鹢行。\n殊方知姓字，前席待光荣。\n公到多筹画，边尘岂复惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"李舜臣","text":"冬来不适意，况复雁南飞。\n枕上空山叶，窗中明月晖。\n一秋多在病，千里正思归。\n不耐江南住，今年又授衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘叔正出守永平","author":"李舜臣","text":"南国接芬芳，忻闻荐省郎。\n君行名已晚，此别路何长。\n马首指沧海，渔阳即故疆。\n异时儒术理，为郡有辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庭树","author":"李舜臣","text":"为爱窗前树，花时一院馡。\n清霜能肃杀，黄叶早纷飞。\n近壁蛛丝满，空庭鸟宿稀。\n悽然此时意，不独吊残晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同刘叔正王道思李邦良登报恩寺浮图","author":"李舜臣","text":"隐隐荆门水，纷纷海上山。\n身犹依禁阙，目已极河关。\n檐日千岩散，窗云五色还。\n同来霄汉里，独喜净尘颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送同年张助教赴刑部主事","author":"李舜臣","text":"同榜十年馀，君才世所须。\n遭逢多不贱，辛苦独为儒。\n画舫乘春去，金门待漏趋。\n分曹荷明主，从此借云衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王念觉出守卫辉王旧给事","author":"李舜臣","text":"曩君报主志，慷慨即南车。\n到处为良吏，明廷有谏书。\n潮平江路阔，沙净日光虚。\n早逐春风去，中州领郡初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠徐章甫大理","author":"李舜臣","text":"明时廷尉选，佳胜复留都。\n湖水清官舍，山城入画图。\n平反三岁在，幽赏四时俱。\n不见歌为政，人今满路衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李端甫招至徐氏东园乡人同坐端甫时有杭州之行","author":"李舜臣","text":"繁华南国里，流水古城边。\n剖竹人将去，投林鸟竞翩。\n潭光澄日夕，柳色变春先。\n笑指清尊在，要当醉别筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐锦衣西园陪宴朱子礼太仆","author":"李舜臣","text":"尚忆观鱼戏，重来送马蹄。\n故人江汉客，贤主薜萝栖。\n煖日荣芳树，晴烟小碧溪。\n春风二三月，定有好禽啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送内兄伯雨出守松江","author":"李舜臣","text":"海上分符日，城隅立马时。\n昨来何自意，早到使人悲。\n雨雪征途满，春风到郡吹。\n惟应大江去，浩荡寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯别内兄伯雨","author":"李舜臣","text":"明经有未遇，四十已专城。\n岂不荣名羡，终多怅别情。\n山桥冰欲合，官舍雨常鸣。\n赖有前庭竹，能如舅氏清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"内兄见招夜坐言别","author":"李舜臣","text":"到门忽自识，客舍早梅开。\n凛岁偶相似，清芬又不摧。\n江风飘月上，河汉倒烟来。\n长孺亦为郡，当时许召回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"内兄见招军器局乡人同坐","author":"李舜臣","text":"尔郡得斯人，终知恋所亲。\n椎牛徵我辈，过鸟怪簪绅。\n华馆凉阴结，丹楼霁雪新。\n勿言独别去，谁料客中身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"内兄见招东园诸公同坐","author":"李舜臣","text":"一径入幽园，门墙绕树繁。\n大夫为地主，公子避人諠。\n水竹无尘到，寒花有雪存。\n辉辉长者后，吾忝亦飞轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐锦衣西园陪饯内兄 其一","author":"李舜臣","text":"素雪舒梅遍，苍烟带竹深。\n林扉开净色，庭木落疏阴。\n五马故人去，三杯游子吟。\n池亭多可到，归路恐难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐锦衣西园陪饯内兄 其二","author":"李舜臣","text":"凿石新成径，临流旧结轩。\n城边飞盖驻，树杪凤台存。\n融雪滋花色，微风送鸟言。\n夕阳未归去，垂钓待鱼飧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶生宅陪饯内兄","author":"李舜臣","text":"谁不惜车东，声华满国中。\n卷帘堂未暮，吹竹盏能空。\n池水澄寒碧，窗花馥晚红。\n亲交知我在，为尔饯筵同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过别内兄","author":"李舜臣","text":"落日凤城头，微风鼓角流。\n御沟寒水咽，清禁紫烟浮。\n剖竹为名郡，横金作远游。\n平生轻外虑，不免别君愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"内兄过别鸡鸣山房","author":"李舜臣","text":"积雪侵苔径，残山抱竹扉。\n萧条官舍暮，惆怅帝京违。\n海路愁俱往，江城泪共挥。\n鸡鸣北湖上，凭望去光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"神乐观诸公同坐饯别内兄","author":"李舜臣","text":"环山雄帝郭，逝水凿秦年。\n岁岁甘泉上，煌煌大道边。\n歌钟流白日，征旆卷寒烟。\n何似为邦去，倾城饯我贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊别内兄","author":"李舜臣","text":"青山看欲断，紫陌去何长。\n日气摇寒水，风声送晚凉。\n金陵龙虎势，宝剑斗牛光。\n独有临分袂，仆夫亦感伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别内兄伯雨","author":"李舜臣","text":"朔风一何劲，飘然江上吹。\n江南一夜梅花发，积雪朝看亦满墀。\n雪色梅花两相映，都门无处无芳径。\n一尊携酒远来此，望里青山道傍水。\n与君同生渤海域，君家淄南我淄北。\n少年弄笔竞为文，一日称名俱可识。\n遭时吾忝尚书郎，已复君称宰邑良。\n功能不独明廷最，公等今扶汉道昌。\n赫赫留朝六补阙，从此官论青锁月。\n四海流传贾谊书，千秋如未欧阳没。\n而我迂愚世所嗔，纷纷情态后来新。\n不能东耕避贤者，空复南冠学事人。\n蓬鬓沙颜谁复怜，遥山瘴水昨来旋。\n东城并马是何日，南国啼莺二月天。\n杨柳青青大江涘，江流浩浩思归子。\n君行过阙觐衣裳，吾继还乡问桑梓。\n云里长松碧石枝，朝来满树绿萝丝。\n丝萝讵拟今如是，天马由来众不知。\n犹及观涛八月回，况复登高九日杯。\n黄花入手便芳馥，清江照人无尘埃。\n儒宫旧在鸡鸣麓，谏垣能枉鹿头毂。\n无数名山许共行，不时绿酒欢方逐。\n谓来相逢得相守，岐路惊人又分手。\n客中孤游空我情，海上殊观尽君有。\n宾还宴罢东将去，此际看君空百虑。\n过鸟交啼把袂前，归云故绕翻旌处。\n男儿所至要名成，不须别泪纷纷倾。\n煌煌为良二千石，台鼎他年在此行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送苏一峰侍郎献绩如京苏旧铨司","author":"李舜臣","text":"日色覆平津，年光催别晨。\n江帆今送客，水镜旧为人。\n城阙融残雪，山河入早春。\n寄言花共柳，好作道途新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹给事赴京","author":"李舜臣","text":"谏议官应重，看君此一时。\n书因规社上，名始赋台知。\n过阙春将晚，扬帆雨乍随。\n江流亦东去，怀主共如斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙京兆致仕归慈溪","author":"李舜臣","text":"城郭顿生姿，金陵坐镇时。\n致身时辈许，乞疾主恩推。\n人老攀江上，山林卧海涯。\n祗应五色诏，名德复娄师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送伦彦式祭酒奉其太夫人归养南海","author":"李舜臣","text":"君著老莱衣，非欢昼锦归。\n师筵新礼乐，帝幄旧恩晖。\n路入黄花满，樯随彩雾飞。\n三年高义在，复尔恋依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张子阳太常赴京","author":"李舜臣","text":"今皇经术理，侍从复君才。\n宇内名谁敌，南中召独回。\n江云随五色，夜宿接三台。\n应忆金陵别，秋风鸿雁来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送费钟石侍郎上绩如京","author":"李舜臣","text":"遥将三岁绩，北阙上龙墀。\n宰府古来贵，斯文今在兹。\n衣冠匡世俗，勋德满京师。\n正值梅花发，清芬荐别卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹给事出守宁国","author":"李舜臣","text":"岁月金门路，叨陪上履綦。\n君多补衮意，吾送剖符时。\n南国股肱郡，西川玉雪姿。\n敬亭今胜绝，应待有新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曾给事赴京","author":"李舜臣","text":"金陵望京色，只在五云边。\n侧席君王待，南司讽议贤。\n才兼堪世用，书奏使人传。\n酒罢欲分手，羡君行若仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送闻石塘太宰赴京","author":"李舜臣","text":"山水浙东去，声华共若斯。\n高贤希世出，明主俾衡持。\n风俗归淳后，春廷上绩时。\n人今公尽望，留佐衮衣垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱桐溪司徒赴京","author":"李舜臣","text":"不独称佳丽，河山王气存。\n司徒分国计，端笏俨都门。\n宇内勋名满，江南制节繁。\n谁能公可荐，密勿切朝昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨给事尊堂受封","author":"李舜臣","text":"载笔闻曩至，晨昏愿岂违。\n遭逢劝簪笏，浩荡借恩晖。\n琐闼人贤在，金陵母德归。\n共言能主报，直道似君稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧石江少宰","author":"李舜臣","text":"为赴司衡召，应闻开府贤。\n歌声方陜日，启事藉山年。\n才大今能用，书成世已传。\n从兹云路阔，豪俊入翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈介泉中丞赴河西","author":"李舜臣","text":"张掖国西门，中丞山甫论。\n从天下节钺，绝塞驻戎轩。\n蛮赋千邦入，威名万里存。\n空传汉出使，此路去河源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李涔涯尚书赴京","author":"李舜臣","text":"敕使召还都，争言新命殊。\n三朝皆报主，六典复司徒。\n旧德今谁在，皇心古帝俱。\n最应边饷赖，西北壮规模。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐枫冈中丞赴蓟","author":"李舜臣","text":"中丞今塞上，开府作藩维。\n况复神州在，应劳圣主知。\n山河千古壮，气象八陵滋。\n长策当何定，威名仰昔时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈给事中赴湖广参议","author":"李舜臣","text":"秋高凭远色，为送武昌行。\n画省名原重，参藩位不轻。\n江楼千里目，湘竹四时情。\n试发郢中倡，应希和者声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至后送马西玄侍郎赴京","author":"李舜臣","text":"一从吹管动，阳气物应知。\n河柳滋将遍，江梅烂已施。\n人才南就日，吾道北归时。\n制作今皇志，宗儒在礼司。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江京兆景熙赴京","author":"李舜臣","text":"赫赫都门坐镇来，三年为政不凡才。\n能令江上风涛郁，复道人间夜户开。\n绕郭青山常带雨，经春芳树早生梅。\n扬帆又送朝天去，待报明廷宠玺回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送闻石塘尚书赴京","author":"李舜臣","text":"下榻长安彼一时，复从南土奉光仪。\n怜才近世难公似，论德中朝亦我师。\n山郭欲销残暑气，江帆只待好风吹。\n惟应去后遥相望，夜夜台阶紫极垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨赴太学","author":"李舜臣","text":"杨柳青青古柏连，一区为舍去人偏。\n惟将闭户供长日，祗过圜桥踏晓烟。\n禁里啼莺春树满，池边滋草露华鲜。\n幽情自爱群芳发，物色风光共远天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南都清明","author":"李舜臣","text":"群山绕郭大江流，复作金陵浩荡游。\n帝里歌钟行处是，人家垂柳映门幽。\n微风竹树摇晴日，薄暮楼船散水洲。\n莫谓花开还落去，曾相舞劝百杯休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同诸年友故汉王府宴集","author":"李舜臣","text":"故园亭榭郁参差，暇日亲朋尽在兹。\n早属风光为地主，兼多水竹弄幽姿。\n侵阶藉草衔杯满，夹路垂杨去马迟。\n勿谓樽空又分手，他年相望足相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日饮顾东桥园时蒋子云方伯同坐","author":"李舜臣","text":"弃官江上肯归耕，几亩城中喜自营。\n结宇故栽芳树满，看山不断白云生。\n身裁鹤氅称居士，家本龙门远俗情。\n为扫落花名蒋径，春来吾忝众宾行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日闻人邦正招至徐氏东园","author":"李舜臣","text":"戚里园亭傍水开，主人延客夕阳催。\n城边踏草寻幽径，石上流泉浸碧苔。\n几亩但愁芳树歇，一春常听好莺来。\n颇闻绝胜兰亭日，亦忝兹游与上才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]