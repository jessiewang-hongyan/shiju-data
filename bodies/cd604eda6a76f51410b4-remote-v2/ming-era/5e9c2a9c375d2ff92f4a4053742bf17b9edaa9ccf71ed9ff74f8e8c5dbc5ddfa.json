[{"title":"挽刘恕","author":"唐璧","text":"琼台曾共远遨游，尔汝忘言二十秋。\n暂别树云劳眷念，相逢诗酒即淹留。\n芸窗虚拟千年在，薤露俄惊一旦休。\n清泪满眶何处滴，澹烟斜日独登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙酉元日","author":"唐璧","text":"河山佳气郁葱茏，满耳欢声处处同。\n天上六龙扶晓日，人间万象蔼春风。\n邑侯制锦多佳政，边将征蛮有异功。\n醉写太平歌一曲，凭君遥寄五云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"攻大藤峡","author":"唐璧","text":"古树浓阴袅翠藤，石藤谁道险难登。\n健儿劲旅能飞渡，且到楼山十二层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移师苍梧","author":"唐璧","text":"云捲霆驱号令行，苍梧城下动欢声。\n秋毫不犯民安业，不数条侯细柳营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三广合兵","author":"唐璧","text":"三广兵齐气概雄，牙旂高处识元戎。\n辛勤止欲消民害，非为云台第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"连贺大捷","author":"唐璧","text":"战鼓初停日未昏，挽回春意在乾坤。\n就中未必无良善，安得奇香为返魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"班师回广","author":"唐璧","text":"万姓临江听凯歌，岭南今喜息干戈。\n谁知一阵风霆怒，化作两邦春气和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞章奏捷","author":"唐璧","text":"羽檄淩风上九重，雪消冰泮见春容。\n天颜有喜颁鸾诰，煜煜金泥带露封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉诏还京","author":"唐璧","text":"圣主褒崇柱石才，天书遥使凤衔来。\n行囊不贮殊方物，惟带清风两袖回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙洞春云","author":"唐璧","text":"老龙潜迹已多时，吐出春云态度奇。\n变化未能成雨泽，祥光先为报昌期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙台秋月","author":"唐璧","text":"金波寒浸玉嶙峋，天宇澄清绝点尘。\n料得嫦娥清兴好，桂花香里宴群真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"福庵古佛","author":"唐璧","text":"人世沧桑几度迁，金仙遗像尚依然。\n良工铸范知何代，老衲犹称汉晋年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白石晴烟","author":"唐璧","text":"满山白石粲瑶英，晴罩鲛绡一片轻。\n错讶仙羊眠不起，云霄无路觅初平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清远飞来寺","author":"邝杰","text":"古寺飞来诚地灵，舟中过客久知名。\n四维拥翠峰峦秀，一境无尘法界清。\n塔外閒云横碧落，门前流水接蓬瀛。\n玉环献后人何在，落日空闻猿啸声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游灵山得游字","author":"邝杰","text":"元戎小队出南州，驻节名山得胜游。\n日转松阴连榻净，雨馀山色带烟浮。\n看花听鸟临风久，对酒吟诗意日留。\n幸际太平无个事，不妨行乐共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游灵山诗得金字","author":"王宏","text":"万木参天古睆睆，□陪□盖此登临。\n远山雨过千屏画，斜日穿花□地金。\n对酒□怀成畅饮，题诗分韵动豪吟。\n兴阑随意苍苔坐，一曲熏风入舜琴。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广于天下为远藩仕籍华秩已少况琼于广又为远郡成化二年秋进薛公远户部尚书邢公宥都御史丘公浚翰林学士皆在一月恐虽天下望郡亦希海外衣冠胜事真奇逢也","author":"王宏","text":"三要清官一月除，尚书学士与佥都。\n六朝礼乐王纲正，千古文章世道扶。\n政教已闻超汉宋，人才今见盛唐虞。\n彬彬文彩诏临下，欢动琼南士大夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠辅斋先生掌教无锡","author":"彭谊","text":"青春领教共称宜，况以才华越等夷。\n两袖天香辞陛日，一帆秋色发舟时。\n潞河风落蘋初放，官道霜晴柳半疏。\n悬想毗陵多俊彦，一经从此得名师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送玉庭上人住持南华","author":"彭谊","text":"南华金刹倚穷苍，曾是卢师旧道场。\n千载有僧来礼法，一溪流水自生香。\n宝花台右荒秋雨，锡杖潭空印夕阳。\n莫道菩提消息远，孙枝今喜见芬芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠戴竹堂","author":"陈守文","text":"清节惟应爱此君，草堂潇洒隔尘氛。\n寒声晚送一窗雨，翠色晴翻满槛云。\n绕枕暑天风拂拂，漏阶良夜月纷纷。\n可能不惜青苔地，容我来看到夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野步","author":"梁穗奇","text":"随意飘飘放杖藜，望中春色入新题。\n峰峦水拥云千顷，野径青回雨一犁。\n振锡僧归疏竹寺，唤船人隔落花溪。\n幽禽可是曾相识，飞过芳林唱复啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄铦归黄田","author":"梁穗奇","text":"才得相逢又别离，况当寒食禁烟时。\n东风祖席花前酒，春色归途马上诗。\n黄叶村深云树合，青山径仄雨萝垂。\n遥知此后频相忆，梁月窥窗意独驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅庵为龙溪吴逑赋","author":"梁穗奇","text":"植梅潇洒称庵居，铁干冰花雪里舒。\n风细暗香来几席，月明疏影上琴书。\n诗成东阁春晴远，酒醒罗浮晚梦馀。\n泉石主人贞志操，岁寒心事复谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦草庵为余诗琼赋","author":"梁穗奇","text":"书阁残吟掩楮帷，黑甜酣致兆多奇。\n烟光染罽迷庄蝶，春思因风达谢池。\n缥缈柔香偏淡处，悠扬嫩翠正深时。\n家儿且莫䰙茶臼，待得醒来定有诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避地寒食","author":"易翀","text":"插柳才惊寒食逢，弟兄奔走各西东。\n落花有恨随风舞，芳草无情泣露浓。\n白发暗添沦落里，青春已过乱离中。\n寥寥先陇南山外，谁为持觞一扫松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文笔峰","author":"吴敬","text":"突屼山岚一带长，轻烟暖日弄晴光。\n孤峰隐隐淩霄碧，群卉森森过雨苍。\n霭气浮空迷绕郭，霞浑拂树映斜阳。\n悬知绝顶最高处，好望蓬莱仙子乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衡王题长史王士衡荣恩堂","author":"吴敬","text":"九重丹诏出皇州，褒赠存亡爵冕旒。\n西阁侍书最勤苦，东斋辅导秉嘉猷。\n董子文章今代出，贾生才调后人犹。\n忆君平日多清致，拳拳此去不能留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄男京邸","author":"梁文冠","text":"罗粉漫天雪雨来，松涛砍树朔风回。\n北京旅邸寒应甚，南海渔家晏未开。\n万里几番孤梦破，三年一别六书回。\n白头舐犊心犹在，祇恐囊空欠夜煤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"槎溪见访辄惠以诗因倚和之","author":"李德彰","text":"衡门流水野人家，何事淹留长者车。\n聆尔旧游情更洽，怀予新咏调堪誇。\n自惭供奉无兼味，只有相看对落花。\n却喜清平无一事，不妨回首夕阳斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题友人月梅号","author":"李德彰","text":"梅似贞操月比形，幽人骞举自冥冥。\n光摇练影当窗白，冷浸琼浆入座馨。\n处士孤山诗兴豁，嫦娥蟾阙梦魂惺。\n知君对此饶佳趣，索笑巡檐几醉醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次白瑩青云天梯诗韵","author":"骆可圣","text":"一片清光锁郡雄，天边层削秀芙蓉。\n烟连淡浦三千岫，气压阳台十二峰。\n湛湛壶天飞乳蝠，离离霜草接云龙。\n夜来心醉松梢月，直递寒香上九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次邓颙龙山月色诗韵","author":"邓承第","text":"崭然山势俨龙蟠，头角淩空瘦骨寒。\n极目云收千里霁，舒怀霞散八方宽。\n银河带露泻清影，铁岸参霄壮翠峦。\n为爱草堂多景色，夜深吟罢倚栏看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白沙先生应辟赴京送别","author":"马广生","text":"莫怪悲歌起钓矶，江湖廊庙两相违。\n苍生喜看蒲轮至，白马宁知水石非。\n畎亩若无伊尹志，尘埃那上老莱衣。\n一尊就醉江门道，万里兰桡欲别时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正统己巳避寇蚬冈","author":"李谦","text":"长笛亭前远近村，邮亭系马对芳尊。\n山收宿雨云归洞，岸阁枯芦水落痕。\n世故炎炎随处有，风尘荏苒几家存。\n临风不用悲华发，戍角一声还断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题","author":"张本正","text":"离却山门十八年，双亲慈爱阿娇贤。\n那堪归路西风急，空染尘埃半世缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游灵山得生字","author":"屠泰","text":"灵山奕奕久知名，使节来游逢兴生。\n海月半檐天向曙，松风万壑雨初晴。\n神孚帝梦当年事，诗咏皇华此日情。\n啸傲不知归路晚，落花香趁马蹄轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲岩","author":"李应泌","text":"三洲崖石翠岧峣，金削芙蓉冠碧霄。\n空洞欲吞潭底月，峥嵘雄压海门潮。\n扣舷渔父应难觅，采药仙翁去莫招。\n几度凌风游绝顶，松涛千顷散箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲岩","author":"李茂","text":"穹窿岩洞久幽栖，此日登临曙色辉。\n群从总陪天上客，新诗不让古人题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"美陇滩","author":"王赋","text":"二十年前叹陆沉，今朝复聚此林阴。\n苔迷乱石行踪莽，水落高滩钓处深。\n隔叶野花供笑语，认人妖鸟怪儒襟。\n相逢且饮樽前酒，莫向江蓠吊古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答陈白沙先生","author":"袁金蟾","text":"独坐桂花边，清香杳杳燃。\n夜深山寂寂，明月满西川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广西宝林寺","author":"袁金蟾","text":"宝林之水似曹溪，今日传来转到西。\n自古一花开五叶，到头结果要人为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"治平寺","author":"赵铈","text":"一簇珠林涵碧海，浑如弱水浸蓬莱。\n月明禅榻清无际，露冷菩提绝点埃。\n洗钵梵扬龙已伏，寒松烟暝鹤归来。\n座中诗客多题品，醉墨淋漓洒绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"治平寺","author":"钟仕杰","text":"治平禅寺此重临，风景无殊昔与今。\n日映鲸波环宝地，洲联鹭渚曜珠林。\n古藤绕壁连僧舍，老树迎风起梵音。\n塔纪慈恩遗事在，胜游谁继杜陵吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"超真观 其一","author":"钟仕杰","text":"珠宫高倚翠微寒，叠阁回廊眼界宽。\n迤逦近山连远岫，悠扬碧水接清澜。\n花香映日薰兰榭，天籁随风起石坛。\n兴罢酒酣归路暝，道人相送出林端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"超真观 其二","author":"钟仕杰","text":"宦游几载赋归田，仙观重临破晓烟。\n黄鹤楼空馀铁笛，青牛人远剩瑶编。\n山含水色星坛外，风送天花法座前。\n对景欲询修养术，世间何处觅真诠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽沙洪","author":"林弁","text":"书帷夜掩残灯落，笔冢寒封宿草深。\n到处忍看馀迹在，卷中题字值千金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三海岩","author":"欧信","text":"提兵西驻访云岩，淑气浮光杳霭间。\n石乳滴泉和雾紫，山花飘锦点苔斑。\n昔年题壁人何在，今日诗成客醉还。\n惟有赤忠思报国，喜将英气寓灵山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋凉闻寇 其一","author":"陈锜","text":"杀气横空急皂雕，一时胡马挟风骄。\n嫠忧正似关宗国，雅志常如在本朝。\n侧席岂无思颇牧，垂裳何必愧虞姚。\n犹闻得肉羁鹰饱，猛掣绦铃遁远霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋凉闻寇 其二","author":"陈锜","text":"来鸿去燕各分飞，翠霭浮空白日微。\n霜霰渐成欺葛屦，风尘终不到荷衣。\n穷愁亦有江枫咏，高调谁传郢雪诗。\n远愧俊游成老大，雁行时觉少参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋凉闻寇 其三","author":"陈锜","text":"袅袅凉风起白波，萧萧寒露湿青萝。\n长贫莫笑犹衣结，远戍遥怜有荷戈。\n人马骤闻喧海市，女牛犹忆望星河。\n年前已自忧多事，不似年来事更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋凉闻寇 其四","author":"陈锜","text":"满床流影动金波，茅屋春深未补萝。\n肉食有人司重鼎，毛锥无用愧长戈。\n鲸鲵未见东归海，鸿雁还从北渡河。\n老倍安仁愁更切，二毛销尽岂容多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临没赋诗","author":"蔡颙","text":"平生耽读数行书，出守边城在一隅。\n律己未曾逾矩度，持身恒欲绝沉污。\n传家不患田园少，继志惟忧孙子愚。\n俯仰二仪难不愧，永为清苦老寒儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"肇庆披云楼","author":"许仁","text":"麟次飞甍出女墙，白云拂槛自波扬。\n九天云汉星辰近，千里山河草木香。\n列坐壶觞论乐事，窥帘莺燕语年光。\n使君清论皆民瘼，不似南楼庾亮狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"璞墩","author":"唐濂伯","text":"城东一望许，连簇水云村。\n岿然双奇峰，云是桐璞墩。\n璞乃玉由藉，桐以琴故栽。\n山辉知玉生，桐茂本滋培。\n筑墩种桐玉，陈均寓深趣。\n匪为纵游衍，知德斯能喻。\n比德以玉润，养心如种桐。\n温密似仁智，衰茂系勤慵。\n积养已有馀，玉见桐复茂。\n当入大匠手，将来谒君后。\n南州文墨儿，祁祁会如云。\n高调凌霄汉，眼界空昆崙。\n簌列烝民蒲，殽陈行苇臄。\n醵聚泻素怀，宛若天上客。\n倚剑发浩歌，为谢桐璞墩。\n伐桐作琴瑟，玉烟辉乾坤。\n我忝读父书，视君为执友。\n鸣珂金马门，他日同携手。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闱会友","author":"唐濂伯","text":"旅邸相逢喜气新，剪灯彻晓细论文。\n皮肤学问应怜我，魁首文章独让君。\n击楫渡江雄祖逖，枕戈待旦苦刘琨。\n会须霹雳同声起，十郡英豪掩耳闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽戴南湾","author":"任效","text":"有美人兮骨已仙，南湾渔舍尚依然。\n春风竹坞閒棋局，夜月螺洲冷钓船。\n诗礼家声乡邑重，箕裘事业子孙传。\n忍从埋玉山前过，落木潇潇怨杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽戴南湾","author":"任璩","text":"葛巾藜杖鬓萧然，只住人间八十年。\n几许夕阳閒钓艇，数椽茅屋老风烟。\n任公德重名空在，瞻父风高世共贤。\n今日我来空洒泪，半篙春水白鸥前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽戴南湾","author":"方俊","text":"八十年来两鬓霜，寄情渔钓足徜徉。\n严陵不肯扶东汉，尚父何心事武王。\n几曲狂歌悲晓月，一樽春酒醉残阳。\n从今谢却人间去，万古清风溪水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赏十月菊赠同年张叔亨泰","author":"方俊","text":"十月黄花开满篱，人人都道不逢时。\n虽然已过重阳节，开也迟迟谢也迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"劝忠祠落成在铜岭","author":"熊德","text":"禅林近有劝忠堂，路入铜冈草木香。\n山色未能忘义气，水声犹似颂勤王。\n千金谁种祇园树，三径新成烈士场。\n从此东官添胜迹，山灵今始发幽光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南园雅集分得陪字","author":"梁韡","text":"白社偏从郭外开，才人宴集碧云堆。\n铿锵金石同敲句，潋滟葡萄共举杯。\n风月拉为元亮侣，溪山招得谢安来。\n时光荏苒年将换，何吝林泉一笑陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"笔峰分得辞字","author":"梁韡","text":"黄岭清高锐似锥，文星秀峙社东维。\n管城有号天工巧，毛颖成形地力奇。\n霞绮明时花灿烂，雨云拖处墨淋漓。\n何须幻出中书手，移向皇家草诏辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞来览胜","author":"朱琳","text":"归来赋就拥鹴裘，日傍青山访旧游。\n灵鹫远从云外出，瀑泉飞向峡中流。\n渔竿满地非求鲤，金锁千峰不断牛。\n借问河阳花几许，种桃人已卧丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲岩","author":"马襄","text":"东风策马循阡陌，偶入三洲紫翠堆。\n片石辟开真境界，九天飞下小蓬莱。\n药炉客已还丹去，花径人常载酒来。\n岩畔留题纪行迹，不教春雨长莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲岩","author":"黄浩","text":"问俗时巡粤水滨，双旌拂破素岩云。\n俯观清瘦岩头石，犹逾苍生肉几分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题莫状元祠","author":"袁亮","text":"幼学当年未夺魁，仙人曾许列三台。\n一朝顿把天香折，万古传来岭表栽。\n云汉祥光天外拥，状元合口马前催。\n万言策向金縢卷，令誉至今表凤台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]