[{"title":"登迎翠楼次韵","author":"卢宁","text":"虚棂疏箔晓苍苍，炎昊冰霜冷布裳。\n泛月酒杯秋艳艳，遏云歌管夜琅琅。\n山横竹岸绿屏合，风度兰汀紫玉香。\n仙馆琼楼何处好，待来桃熟问东方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"具瞻图","author":"卢宁","text":"偶解青条出禁宫，剑翎铁石俨升中。\n高虚已脱斯人网，搏击真称盖世雄。\n众小未须干气象，群分聊得望巃嵷。\n奋身电掣晴霄上，披拂红霞凌景风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹰","author":"卢宁","text":"独立高秋削玉巅，竖翎精彩出风烟。\n决云白日山前荡，濯雪玄冬塞上骞。\n清绝有声调大吕，威严一顾净长天。\n此生疾恶知无敌，肯惜奇毛负老拳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与友人坐忽风雨大作得单字走笔","author":"卢宁","text":"鸣雨飘风草阁寒，秋生五月布衣单。\n山精出壑乱啼啸，海燕乘空翻羽翰。\n阶砌落花浮别院，坳溏泛梗倚长栏。\n呼童南市买船去，卧听滩头急夜湍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乔松主人","author":"卢宁","text":"托足青山形自逸，鼎炉时复飞黄金。\n举头汉楚有成败，侧身天地无古今。\n白云半枕清都晚，玉液千行紫雾深。\n此去仙郎家不远，碧桃溪岸欲成林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林次崖先生钦州考绩二首 其一","author":"卢宁","text":"直道抗颜辞北阙，圣王悬念满南州。\n官浮海岛一身眇，地接华夷万里秋。\n惠政自随行部著，封章谁为远臣收。\n汉恩欲报须流涕，贾傅当年已熟筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林次崖先生钦州考绩二首 其二","author":"卢宁","text":"极海六年图卧治，孤忠千结独成狂。\n一州民瘼春同煦，万里君门夜未央。\n搜辑地舆成国史，隐忧戎马疏蛮荒。\n何时宣室来前席，迅策奇勋在衮裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与僧月崖","author":"卢宁","text":"云界碧楼玄鹤杳，桂宫银篆午天长。\n二名不避自圆妙，万象同归谁慧光。\n手出黄金通化羽，梦回青棘比明珰。\n木犀香动天无隐，真悟应输老晦堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪鸿池上月夜别友人二首 其一","author":"卢宁","text":"江阁萧萧吹朔风，平皋翻雪飞冥鸿。\n玄谈深夜忍谋别，明日芳樽谁与同。\n断岸暝烟青雀舫，疏蓬鱼股赤罴弓。\n空帷细忆襟期话，凄切银床一叶桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪鸿池上月夜别友人二首 其二","author":"卢宁","text":"澄心共藻芳池水，浪迹看君真泛凫。\n阿阁望随云外远，小亭愁与月同孤。\n莫听风笛伤南浦，且系兰舟倾玉壶。\n后夜有怀何处寄，一藜寒影对河图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次邳州元旦望阙二首 其一","author":"卢宁","text":"圣皇嗣历题辛丑，万国衣冠庆舜年。\n寿域齐天瞻北极，文光连壁耀东躔。\n夕郎金钥龙楼启，太宰彝章象魏悬。\n亦有元和玄德赋，愿叩嵩祝入瑶编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次邳州元旦望阙二首 其二","author":"卢宁","text":"行客观光当正始，蓬莱宫殿物华鲜。\n黼屏宝扇开仙仗，云液冰桃进御筵。\n四海大明忘帝力，小臣三策叩尧天。\n康衢献纳兼收采，王烛和春亿万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题金门待漏图","author":"卢宁","text":"寒烟濛密五城低，独立端门紫阁西。\n赤甲犹闻传禁虎，朱冠将起报晨鸡。\n九天瑞蔼团龙衮，双阙星回集马蹄。\n叩仗岂无经国疏，春风杨柳满金堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和蔡半洲司马中丞平黎韵二首 其一","author":"卢宁","text":"威灵南曜亘长城，小范蟠胄尽甲兵。\n孽虏负恩当万死，牙旗挥电拯群生。\n琼山月霁蛮烟净，炎海风高宿雾清。\n此日功成匡四国，尧天荡荡孰能名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和蔡半洲司马中丞平黎韵二首 其二","author":"卢宁","text":"一岛周环四郡城，除凶赫怒下天兵。\n阵驱云鸟风霆迅，民乐村原烟火生。\n直使夷荒知纪度，重看海屿录澄清。\n自今文治应熙洽，龙钺非叨真将名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年冯改溪水部分司宁阳二首 其一","author":"卢宁","text":"委折漕渠达帝关，源流疏节令新颁。\n大明水阔春潮荡，钜野波深夜溜潺。\n足国功劳收太史，济川才望秩清班。\n等閒试借观泉眼，樽俎东山与泰山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年冯改溪水部分司宁阳二首 其二","author":"卢宁","text":"临济仙源浚远岑，八荒王贡此侵寻。\n天培社稷根基厚，帝简忠贤倚注深。\n国是顿忘航海策，杞忧空费广田心。\n公馀为念东南力，一寸泉流一寸金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽赵中丞载二首 其一","author":"卢宁","text":"辕门方拟起熊罴，典册哀荣叩玉墀。\n雄剑曾寒西贼胆，碧幢犹系业人思。\n龙归沧海川原涸，凤去丹崖草木衰。\n对景重添怀古恨，朔风萧瑟冷云垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽赵中丞载二首 其二","author":"卢宁","text":"经国谟谋仗老成，两朝勋业子干旌。\n人悬北极三台象，天夺中原万里城。\n雨暗新亭凄夜杵，云迷细柳辍春耕。\n英标曷不归图画，黄阁麒麟次第名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"部檄饷军","author":"卢宁","text":"一劄仓皇下度支，辎车畿外饲熊罴。\n旌旗影裹三军悴，鼙鼓声中万马驰。\n饷道满忧林莽伏，居民仍促室家移。\n干城会食朝悬切，敢避狼锋赴后期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饷军","author":"卢宁","text":"麒麟门上拥旌麾，分布貔貅靖岛夷。\n国计实烦唐节使，军容宁比汉官仪。\n策功自释袁安愤，缘数谁逢李广奇。\n二百年来劳养士，选锋今正答恩时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与林冬岭省丈憩暑灵谷寺时有倭寇之警","author":"卢宁","text":"早雨空斋疑夏冰，天花飘处雪犹凝。\n清闻宝铎传灵籁，静检金签讲慧僧。\n高庙衣冠游凤辇，寝园梐枑绕龙陵。\n海氛何用干玄佑，王气晴看与日升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿英州崔楼溪佥宪","author":"卢宁","text":"西蜀官阶执法身，挂冠无柰锦江春。\n霜清越巂思原吏，云白蓬莱有主人。\n试马尚宜勤汉节，杖鸠端合作虞宾。\n莫言东海堪投钓，祇恐徵车下渭滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留都除夕有怀二首 其一","author":"卢宁","text":"海天问省书难到，京国风光岁又加。\n小院无樽喧枥马，西邻有炬散林鸦。\n彤楼隐现仙茎杳，青琐阴深御柳斜。\n相守不堪乡土异，一杯岑寂草玄家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留都除夕有怀二首 其二","author":"卢宁","text":"芳怀剩欲元朝发，短景犹怜岁暮催。\n恼客病教随腊去，赏心诗已逐春来。\n云边白发添双算，胜里瑶花独厌裁。\n自是椒盘堪媚远，可因风操过年回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高庙六首 其一","author":"卢宁","text":"恭忆龙飞淮甸年，雄雄神武更无先。\n风云已协鸿钧运，日月重开泰始天。\n九牧贡金形尽铸，盈庭屈轶草长翩。\n阿难河上乌犹在，啼断明元朽骨膻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高庙六首 其二","author":"卢宁","text":"胡运何曾及百年，笃生真主炳几先。\n威加四海功成圣，治复中华道继天。\n鸿起商山归汉从，凤飞丹穴向岐翩。\n神谟自是高千古，扫逐羱群万种膻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高庙六首 其三","author":"卢宁","text":"三尺横与一旅年，孰为汤武肇基先。\n拟陈鸿业知无极，欲赞黄图祇有天。\n寝殿初开宫雉列，樱桃欲荐禁莺翩。\n神孙时宪严崇报，万祀焚膋达臭膻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高庙六首 其四","author":"卢宁","text":"肇自河清五百年，圣人出御武为先。\n闾阎尽复唐封俗，书轨皆同禹贡天。\n桃野放牛还吒吒，华阳归马正翩翩。\n小臣却鄙庄生语，成聚成都蚁慕膻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高庙六首 其五","author":"卢宁","text":"初从丰沛衅旗年，为汉驱除夥涉先。\n岂识真人翔灞水，遂成王事得民天。\n万方执玉臣工肃，千载朝陵法从翩。\n礿祀幸随殷荐后，西曹七日戒荤膻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高庙六首 其六","author":"卢宁","text":"再睹周家过历年，贞符早协凤麟先。\n陵多复道三千户，堑有长江百二天。\n今上厉精龙德震，东吴奏捷羽书翩。\n朝廷事事皆绳祖，何有南髡与北膻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答伦右溪银台赠行诗二首 其一","author":"卢宁","text":"诏从海上访安期，君在沧洲世自知。\n柏府有人曾避马，松门无寺不题诗。\n丹山碧水江声暮，花落云流鸟哢迟。\n未许便随坡老逸，心灰黄纸与红旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答伦右溪银台赠行诗二首 其二","author":"卢宁","text":"罗浮清梦惬襟期，每到梅花忆故知。\n烛剪西窗增客思，月明南国咏君诗。\n艰难蜀道分符晚，寂寞冯唐入署迟。\n争说右溪经略手，待平番舶建牙旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次友人金山赠行韵四首 其一","author":"卢宁","text":"金山一瞬又三年，犹记僧归月下船。\n千丈浪中浮绿树，五州山外落青天。\n风前秀句劳清梦，神里瑶华生紫烟。\n同学故人才更绝，蓬莱东观待群仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次友人金山赠行韵四首 其二","author":"卢宁","text":"金石交情见百年，冯唐署忆钓鱼船。\n飞觞台畔流孤月，浮玉筵前接远天。\n沧海笑谈通肺腑，秋江寤寐隔风烟。\n诸君合作琼林客，况有新诗似谪仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次友人金山赠行韵四首 其三","author":"卢宁","text":"英豪忘食不知年，才似云帆万斛船。\n还把文章凌白日，为将时命问苍天。\n黄花遇节悲风雨，碧草回春怅晚烟。\n自是积功千百后，丹台迟久尽成仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次友人金山赠行韵四首 其四","author":"卢宁","text":"罗浮梦寐已多年，何日逍遥泛海船。\n怀友翩翩黄鸟雨，思亲望望白云天。\n杨花落尽鲥鱼浪，蕙草鸣来鹈鴂烟。\n不识四君能絜我，卢敖同作五羊仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"右溪翁诗寿家君次韵答之二首 其一","author":"卢宁","text":"溪翁长把溪上杯，坐对溪花满眼开。\n棣萼并悬天下望，蒲轮会见日边来。\n西台谏疏留宫禁，南国文章贲草莱。\n夜夜思公瞻海月，诗联珠影照三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"右溪翁诗寿家君次韵答之二首 其二","author":"卢宁","text":"白下官閒漫举杯，白云司里红药开。\n花深鳷鹊台前咏，风动鶢鶋海上来。\n无日不悬南极梦，有怀同剪北山莱。\n便图戏彩招仙逸，肯信人间重鼎台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题南城新苑赠周主政缜庵","author":"卢宁","text":"南城盘郁小瀛洲，芳圃鲜池两世脩。\n庭馆旧为娱老计，菊松今作引年谋。\n神仙何处有三岛，木石閒身傲五侯。\n况是海氛平靖后，庙堂无用借前筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖霞寺留云谷和尚","author":"卢宁","text":"太平门外玄云合，望里栖霞休上人。\n野鹿阶前眠佛日，腊梅庭下报王春。\n诸峰尽斲如来像，七火都离无量身。\n但得簿书閒半夕，便寻兰若说三真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋居夜坐次堂翁梦山尚书韵三首 其一","author":"卢宁","text":"仙闱空豁月流光，斋沐炉熏汉署香。\n霜肃九逵星正会，葭吹六管气偏凉。\n制严禋祀联臣寀，精附云霾达帝乡。\n令节天颜知有喜，冕旒端拱焕朝章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋居夜坐次堂翁梦山尚书韵三首 其二","author":"卢宁","text":"幸陪斋宿傍龙光，共沐氤氲满眼香。\n象辂泰坛仪秩秩，汾阴星尾迹凉凉。\n检书烧烛悲前事，迓节逢阳忆故乡。\n拟赋甘泉才恨拙，敢言华国有文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋居夜坐次堂翁梦山尚书韵三首 其三","author":"卢宁","text":"来宵大路肃明光，南国风飘画省香。\n净案胆瓶看渐暝，法宫玄服觉加凉。\n龙斿应拂金灯上，凤历还踰铜鼓乡。\n显相有怀浑不寐，手披云汉裂天章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽少司寇葛两溪公二首 其一","author":"卢宁","text":"兰台曾奏弼违书，直气英声众不如。\n此日有舟藏夜壑，当时解印赋閒居。\n尚方请剑朱槐令，棘寺祥刑汉尉于。\n麟趾祇馀继簪绂，向人犹自悼輀车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽少司寇葛两溪公二首 其二","author":"卢宁","text":"两溪环玉照高闉，隔世犹闻直道身。\n抗节一生驰骏足，上书濒死逆龙鳞。\n苍松郁郁封云鬣，宿草凄凄护石麟。\n地下脩文知信否，祇留芳誉诵斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春凤凰台宴集 其一","author":"卢宁","text":"芳春名苑一樽开，准备高轩卜昼来。\n风翕鸟声依翠幕，情薰花气袭瑶台。\n诗筒问柳频移舄，舞袖当筵谩举杯。\n高论洗心聆不尽，税檐浮绿照星台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春凤凰台宴集 其二","author":"卢宁","text":"相随宾从古仪台，况是新晴丽景开。\n城阙万家斜照里，乡关极目岭云隈。\n六朝词客供文藻，百代王孙閟草莱。\n空翠暮来浑欲滴，穿林骑马意迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵赠何柘湖内翰春首得请之作二首 其一","author":"卢宁","text":"文采翩翩艳旧京，瀛洲鸾凤骨犹清。\n不耽石室绐书粟，元是金门避世情。\n上苑众芳来鹈鴂，建章百转绕流莺。\n从今无复中朝梦，北客休相蘼火城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵赠何柘湖内翰春首得请之作二首 其二","author":"卢宁","text":"词林蓄积富如京，翰墨官休似个清。\n冠盖世途殊少味，靡芜春雨更多情。\n蓬山东路终留舄，淮水西窗暂对莺。\n吏问金龟还玉署，谪仙持当酒家城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孙季泉尚书蔡鹤日台长用韵贺何内翰得请之作再赠","author":"卢宁","text":"二老文章压汉京，瑶篇春映日华清。\n蔡邕东观琴中韵，孙绰天台赋里情。\n芳草满洲分白鹭，杂花生树乱黄莺。\n漆园司马仙风别，十二楼中咏五城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀瓠川宗子伯昭","author":"卢宁","text":"桐水盈盈别一天，伊人宛在赤山巅。\n寻春有杖拄不倒，倚阁无言私自怜。\n狗监未称司马赋，侯芭欲问子云玄。\n何年月白风清夜，扫叶同烹第一泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古江上吟","author":"卢宁","text":"西分茅岭桂江浔，映带磐山岁月深。\n日出曾浮苏子雪，鱼潜应有赵胡金。\n通渠引绿行蔬圃，返照流光入晚林。\n便欲移舟寻钓石，夜阑风雨听龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄参军署篆顺德还","author":"卢宁","text":"小借冰壶文苑妙，共传幕府惠风清。\n雪亭花影移春昼，云陆鸟声歌午晴。\n兴好他山旋憩鹤，化行何地不专城。\n乡村在处歌来暮，去马离人无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何宗舜西粤省乃翁完斋二首 其一","author":"卢宁","text":"江上朔风潮欲生，白云飞动双眸明。\n玉杯锦席高秋饯，斑管青帷贵从行。\n百粤薇垣开左府，陆郎橘井浚东城。\n寿康过去苍梧路，合爱天然父子情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何宗舜西粤省乃翁完斋二首 其二","author":"卢宁","text":"江上一杯云浪晴，赤裘黄卷拥朱舲。\n棹移岛屿三洲丽，秋入楼台八桂青。\n勿药不妨前戏彩，执经何得比趋庭。\n承颜为进南征算，仗钺军中早震霆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菊泉二首 其一","author":"卢宁","text":"僻径戎戎千树霜，清临流水注秋光。\n黄金净跃潭中影，青眼倒窥涯上芳。\n彭泽滟波滋晚节，崀山寒日浴残妆。\n长源到海无穷尽，添试曹溪一勺香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菊泉二首 其二","author":"卢宁","text":"九后同歌傲岁雄，重沿甘谷寿诸翁。\n花开饱沃金田泽，鱼泳惊参玉蕊宫。\n艳比桃源怜间白，馥疑兰渚别浮红。\n寒芳色色呈秋富，何处锦江篱落东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赏菊次韵二首 其一","author":"卢宁","text":"薄战西风血点衣，天教阳质迓寒威。\n曾陪烈士歌金甲，还待幽人上翠微。\n献岁谩疑迟节序，赏心赢得殿芳菲。\n相看醉此贞元会，又到梅花带腊归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赏菊次韵二首 其二","author":"卢宁","text":"饮水餐英作寿基，满庭霜集副襟期。\n樽前朱履踏红叶，头上金钱蘸绿卮。\n秋色已拚今夕醉，朔风何急向篱吹。\n自知根蒂从来固，誓不飘零满砌墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云洲草堂为姚柱史泽山乃祖题二首 其一","author":"卢宁","text":"天云缭绕款郊坰，大老临流结野亭。\n十亩蕙兰添晓翠，几湾鸥鹭占前汀。\n惯兴霖雨深区夏，更起虬螭奋性灵。\n紫气不随函谷去，乐群渔父卧沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云洲草堂为姚柱史泽山乃祖题二首 其二","author":"卢宁","text":"高岸层轩早避名，直东何处问蓬瀛。\n鲤湖隐隐氤氲布，蟹穴盈盈雺雾生。\n一点太虚閒自障，半潭寒影照心明。\n风云已附龙孙去，老听沧浪歌濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]