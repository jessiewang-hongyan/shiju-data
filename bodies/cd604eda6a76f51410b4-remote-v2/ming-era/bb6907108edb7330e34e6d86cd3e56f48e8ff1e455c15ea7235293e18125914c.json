[{"title":"春日访山家三首 其三","author":"苏仲","text":"谁是山中主，看山有宿缘。\n白云封洞口，绿树荫塘前。\n问客儿先出，烹茶妇就煎。\n岭西将落日，绕屋有啼猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳春日试笔二首 其一","author":"苏仲","text":"春到园林媚，云深引步迟。\n柳娇莺细掷，花好蝶先知。\n草软牛羊饱，枝危鹳鹤依。\n凭谁高著眼，杯酒洗肝脾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳春日试笔二首 其二","author":"苏仲","text":"时物随风转，和风拂面来。\n蛰虫穿地拆，芽笋闯墙开。\n梅笑寒塘角，鱼依浅水隈。\n杖藜还老脚，诗酒共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭陈公晦二首 其一","author":"苏仲","text":"白屋遭穷命，青云未致身。\n琴书遗旧业，笔砚已封尘。\n仗义心犹在，工诗世已闻。\n归山何日是，絮酒奠苍坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭陈公晦二首 其二","author":"苏仲","text":"青眼于君独，丹心傍我真。\n百年交义重，三载讲堂亲。\n宝剑犹埋狱，奇葩未遇春。\n有怀空仰望，挥泪洒穹旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪二首 其一","author":"苏仲","text":"六出偏奇绝，玄机可复论。\n夜晴添月色，春早助梅神。\n伫望诗情远，孤斟酒兴频。\n交加双柏树，彷佛玉龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪二首 其二","author":"苏仲","text":"入户溶溶落，飘帘片片轻。\n乍疑留鹤毳，错认剪鹅翎。\n著物无声臭，淩空似战争。\n楼台曾引望，诗思满江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日到农家","author":"苏仲","text":"豆秸檐前积，藤蓑屋角悬。\n竹篱驯犬睡，水草老牛眠。\n儿壮添农具，年丰益社钱。\n县官颁历日，相率数流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铁线牡丹","author":"苏仲","text":"元非花异品，何处得名扬。\n附势随枝曲，贪高引蔓长。\n敢当倾国色，徒窈媚人妆。\n惹得痴蜂蝶，纷纷过粉墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜中闻雪","author":"苏仲","text":"纸窗吹朔雪，琴瑟有馀音。\n寒气潜欺枕，清声实到襟。\n拥炉添逸兴，烧烛纵长吟。\n唤起痴童子，烹茶坐夜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到官","author":"苏仲","text":"行年方五十，拜职地官曹。\n面目尘埃染，心神会计劳。\n效忠期犬马，爱国惜脂膏。\n借问东南客，漕兵卖布袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有双燕入梁似寻旧垒之迹数日而不果就偶作诗以记之","author":"苏仲","text":"穿帘双紫燕，日语傍檐巡。\n认主元非旧，遗巢也尚新。\n早图栖止计，何事往来频。\n我是无机者，寻常可托身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀","author":"苏仲","text":"长悬乡土梦，景物副心情。\n五月薰风荔，三冬白雪橙。\n子姜鱼作鲙，藤菜蚬为羹。\n白石清泉外，无羁世利名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻梁景达讣音哭之以诗","author":"苏仲","text":"少年同事业，中岁各相悬。\n为国心偏远，营家子独先。\n一天分楚粤，千里断风烟。\n老病他乡恨，因君泪雨涟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨粟卷为邱懋之大尹题","author":"苏仲","text":"燕谷阳回日，春祈大有年。\n纷纷如雨坠，粒粒似珠圆。\n庆满三农望，风留百姓传。\n上天元有意，用表长官贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭景贤侄丧子","author":"苏仲","text":"青天无所主，黄口亦何知。\n毒病应难起，归魂未定之。\n九泉怜老父，五岁痛慈帷。\n万古青山在，空遗贾岛悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题毗陵徐氏思齐","author":"苏仲","text":"木风千古意，藜藿百年心。\n古道人行少，遗芳子独任。\n几筵今孝节，羊枣昔曾参。\n写就名齐意，挥毫泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"足病","author":"苏仲","text":"湿热相钩引，灾延一股伤。\n扶墙犹勃率，拄杖学商羊。\n笔下无新句，瓶中已缺粮。\n客途谁念我，合眼梦家乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓旅中生日","author":"苏仲","text":"旅馆生犹寄，天涯梦未还。\n黄花虚晚节，白发对秋山。\n见友情虽遣，思亲乐竟难。\n瓦壶无绿酒，空强自加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相地起继芳亭","author":"苏仲","text":"旧日栖迟地，今为养病窝。\n一池环小岛，四面湛清波。\n老圃朝锄菜，渔翁晚飏蓑。\n不才无世用，把酒共婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度后五日作","author":"苏仲","text":"扶老凭藜杖，风光任笑歌。\n今生能几许，后世知如何。\n有酒聊供醉，栽花不用多。\n笑人闲计较，长为子孙魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝和大理少卿陈以道韵","author":"苏仲","text":"雪拥千官来陛陈，御炉香细染儒绅。\n君王万寿齐天地，龙衮千秋拱圣神。\n上帝监观知有道，小臣歌诵敢辞频。\n高冈共听梧桐凤，宇宙长看万古春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送同年杨景奇奉使浙江","author":"苏仲","text":"使星飞出动皇州，玉笋班中拜冕旒。\n黄纸早传明主意，青山深慰老臣忧。\n腰间剑气腾霄汉，雪里梅花映骅骝。\n王事百年今小试，行人千载指眠牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯有孚正郎改侍御按湖南","author":"苏仲","text":"河桥柳色染春云，按节湖南此送君。\n岸昔江蓠烟漠漠，野花汀草雨纷纷。\n屠牛已试庖丁手，斲鼻还看大匠斤。\n他日归朝献天子，画图先遣画饥民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送户部尚书张西溪先生辞官还乡用西溪见寄韵","author":"苏仲","text":"堂堂声价重人间，得遂辞荣出御班。\n归路烟云千里外，□窝风月两山环。\n春光绿墅供吟兴，晚节黄花伴笑颜。\n清献高风千古在，岭南今日□公还。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和大参兄见寄韵三首 其一","author":"苏仲","text":"宦途为别几星霜，讵意传胪共奋扬。\n粉署勤劳徒尔尔，外台声价白堂堂。\n蚌怀照乘终难掩，剑有龙光竟莫藏。\n每恨驽骀鞭不起，心悬篱菊岁寒芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和大参兄见寄韵三首 其二","author":"苏仲","text":"沧茫云水是吾乡，几叶传家种德香。\n世有渊源文正起，门中声价大苏行。\n激昂士类归清白，唤起人间老病狂。\n附骥岂无千里志，不堪痴病倚藤床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和大参兄见寄韵三首 其三","author":"苏仲","text":"世事纷纷乱扑丝，是谁真怜是谁痴。\n坦怀天地随缘分，过眼风花总未知。\n词客贾生空愤世，诗家杜老浪忧时。\n是非千古浑无定，不属冥冥更属谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和祈主事春日韵","author":"苏仲","text":"怪得阳春有脚忙，小园桃李已争芳。\n人生风月惟真性，谁遇莺花不倒觞。\n休把功名嗟老鬓，且供人事笑他乡。\n我知塞上翁心事，得失无关心自凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黎汝常掌教之任","author":"苏仲","text":"海蚌胎光动彩蟾，休嫌官冷卧穷檐。\n长吟管甚年华过，午梦不惊春昼甜。\n座上光风花满眼，阶前细雨草侵帘。\n舞雩气象今何似，桃李成蹊雨露沾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾主事请赴元夜阻于足病诗以代谢","author":"苏仲","text":"箫鼓喧腾几处同，楼台开宴赏春风。\n云翻锦袖歌童舞，彩剪花枝蜡炬红。\n折柬有心劳远使，杖藜无力可扶翁。\n人间胜会何辜却，不入群贤笑语中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"耿员外见邀不赴代简以谢","author":"苏仲","text":"高台遥拜蟒衣新，倒屣趋迎铁面臣。\n座上春风儒雅辈，席中花锦笑谈人。\n杯传玉液真无分，曲和鸾箫偶未闻。\n无限老怀扶不起，时光辜负病中身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈祐卿主事病中见寄时予亦有宿疾","author":"苏仲","text":"两年襟枕病魔留，几度春风不上楼。\n梦逐老牛依水草，盟寒南海钓鱼舟。\n园林明媚花争晓，水阁清光月爱秋。\n好景易过人易老，是谁先我得遨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中闻前堂花盛开","author":"苏仲","text":"种花无病病花开，老眼何堪紫翠堆。\n满座香风无我分，一帘春色为谁来。\n皱眉刺手看藜杖，忍气吞声负酒杯。\n花若可留人不死，月明深夜共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久病公事分累同寅赋此谢之","author":"苏仲","text":"自怜贫病两攻身，买药无钱敢叩神。\n忍痛自甘唯薄分，分劳深愧累同寅。\n极知义重诸贤辈，果尔恩垂不报人。\n他日沈屙如可起，得容残喘拜车尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄表弟梁应和喜其居第依山临水幽雅可爱","author":"苏仲","text":"相逢何处问仙家，离却红尘便可嘉。\n一派青山两椽屋，数湾流水几株花。\n松根扫叶烧芽笋，石罅分泉煮细茶。\n枕上梦魂甜似蜜，不知红日上窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出游","author":"苏仲","text":"欲将游赏托生涯，每遇春光少住家。\n白发不嫌花笑我，青山都爱我簪花。\n芒鞋布袜穿萝径，暖日和风采蕨芽。\n自笑阿翁还健步，溪桥飞步捲尘沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芍药花","author":"苏仲","text":"占断风光不偶然，托根疑是马嵬仙。\n风流故态难收拾，脂粉冤家未了缘。\n艳色乍疑儿女爱，浓香争得士夫怜。\n昏昏老眼还多病，逢著花开只爱眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萧汝柔掌教讶无回书赋此见意","author":"苏仲","text":"计程云水四千馀，三载暌违两度书。\n墨迹可留真面目，文光留取炤吾庐。\n随阳长者曾将意，乌有先生不与俱。\n自笑病馀疏懒骨，故人书翰尚勤劬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和煮茗诗韵二首 其一","author":"苏仲","text":"交加摇影竹窗虚，试问寒炉煮茗初。\n古霤避烟惟见鹤，小铛吹浪怪无鱼。\n通仙有道还堪信，披腹无文愧浅疏。\n春梦几回呼不醒，凭君摧起二更馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和煮茗诗韵二首 其二","author":"苏仲","text":"占断风云一掬春，汲泉分火属何人。\n凤团巧制传来妙，龙焙初开不放陈。\n曾把睡魔都战倒，顿令诗骨倍精神。\n瓦瓯逼透梅花月，刚好先生与我亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢伯居佥宪之任广西","author":"苏仲","text":"别酒一杯浇磊块，新诗几句写风流。\n青春剑倚苍梧晚，白日霜飞桂水秋。\n狐兔深山无遁迹，儿童随地有歌讴。\n我知使节经行地，人在无私镜里游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送亚卿黄先生归湖湘","author":"苏仲","text":"四纪功名史笔香，老年犹记石田荒。\n江山万里辞明主，行李半挑归故乡。\n溪上正逢鲈脍美，篱旁迎笑菊花黄。\n知君不是陶弘景，也爱松风一枕凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄大参兄","author":"苏仲","text":"云霄万里早翱翔，群从中间见凤凰。\n江右铎声西蜀振，庐山高拱雪峰昂。\n福星迥向闽中合，文字还传翰苑香。\n乡里菊坡吾最爱，许君千古共争光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予时叨承部檄督粮于通州与同僚数以公事往回京师因其经过游览之所分为七题每人作诗以纪其事云 其一 太平晓会","author":"苏仲","text":"钟动禅房向晓开，草阶凝露湿莓苔。\n古槐叶嫩飞虫落，老柳皮枯惹蠹胎。\n犬为识人先掉尾，僧逢熟客且留杯。\n从容我对头陀说，还有同袍马上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予时叨承部檄督粮于通州与同僚数以公事往回京师因其经过游览之所分为七题每人作诗以纪其事云 其二 太平起马","author":"苏仲","text":"月落钟声闻古寺，鸦惊乱起绕禅宫。\n烟横马首平原绿，云出山尖晓日红。\n草色未乾花底露，柳阴初起帽檐风。\n游人惯见频来往，夹道儿童也笑公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予时叨承部檄督粮于通州与同僚数以公事往回京师因其经过游览之所分为七题每人作诗以纪其事云 其三 五里著鞭","author":"苏仲","text":"南北分岐西复东，纷纷车骑往来通。\n五更饭客山厨月，千里游人酒肆风。\n老马怯行犹泄泄，怀人多事苦匆匆。\n眼中京郭烟云远，那得寻花问柳同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予时叨承部檄督粮于通州与同僚数以公事往回京师因其经过游览之所分为七题每人作诗以纪其事云 其四 双桥景色","author":"苏仲","text":"双桥下马路傍叉，物色风光各可誇。\n松径拂云连墓道，柳阴傍水到人家。\n幽幽古寺幽幽趣，个个闲僧个个嘉。\n烟绕粉墙高著眼，是谁□里万株花。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予时叨承部檄督粮于通州与同僚数以公事往回京师因其经过游览之所分为七题每人作诗以纪其事云 其五 花园玩赏","author":"苏仲","text":"经过莫厌我频来，松径连云古峒开。\n一榻风烟供睡卧，数株红紫可徘徊。\n家童先我供茶椀，羽客留人共酒杯。\n旁有一门通物外，花枝临水小天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予时叨承部檄督粮于通州与同僚数以公事往回京师因其经过游览之所分为七题每人作诗以纪其事云 其六 高密驻马","author":"苏仲","text":"漠漠春云覆浅沙，谁传消息到禅家。\n通州客子方驰马，高密老僧先煮茶。\n爱客供传新熟果，悦人都是有名花。\n从今洗尽尘埃眼，付与风光管物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予时叨承部檄督粮于通州与同僚数以公事往回京师因其经过游览之所分为七题每人作诗以纪其事云 其七 深沟望阙","author":"苏仲","text":"匹马深沟日未斜，巍巍宫殿眼中赊。\n天生气象非人力，地献洪图作帝家。\n虎拜龙降山缭绕，云蒸雾滃水交加。\n停车更上层崖望，傍阙云生五色花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题萧以忠主事心怀两愧卷","author":"苏仲","text":"世短官迟事事忙，君亲无地著情长。\n鸡豚报答心当缺，犬马驱驰鬓已苍。\n欲补衮衣徒梦寐，每看花木独悲伤。\n知君却抱无穷恨，一目江山两泪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆家庙元宵寄族中诸兄弟","author":"苏仲","text":"太史楼前伐鼓频，香烟飞绕画堂新。\n六三世代同尊祖，五百云礽本一人。\n诗酒箫笙喧夜月，子孙兄弟满堂春。\n年年好景重相会，也念他乡老病身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄梅主家兄","author":"苏仲","text":"寥寥南北雁声沈，萍梗他乡雪满簪。\n兄自抱孙安稳睡，我因耽禄战兢深。\n风尘飘䬍千山暝，道路驱驰百病侵。\n圣主可怜衰老骨，梅花月下不胜斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅主为家兄题二首 其一","author":"苏仲","text":"野水闲山共隐居，老梅遥种几多株。\n一觞一咏渠依我，淩雪淩烟我共渠。\n瘦影月斜侵几案，冷香风细洒琴书。\n绿阴青子犹堪爱，到老相看莫放疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅主为家兄题二首 其二","author":"苏仲","text":"是梅依我我依梅，素分相投碧水隈。\n有雪有花谁共赏，携诗携酒我还来。\n清癯骨格怜同趣，洁白风声果异材。\n莫谓东家无管刺，腊前催得一枝开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送锦衣吴瑞卿还乡","author":"苏仲","text":"江门游走是何年，分得罗浮几洞天。\n清世又开观国眼，春风摇曳上京船。\n锦衣初试红尘骑，钓艇还寻碧水烟。\n庾岭秋风南海月，菊花迎笑短篱边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和陈亚卿先生咏红梅","author":"苏仲","text":"化机先放一枝春，彷佛红妆不染尘。\n静里自堪供几案，兴来无复命蹄轮。\n逋仙著眼还相向，潘岳驰情未敢亲。\n从此江南与江北，万千名卉敢同伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"改韵再咏二首 其一","author":"苏仲","text":"老眼帘栊罩晓烟，恍然沈醉玉台仙。\n罗浮气味何曾减，洞□颜容是偶然。\n雅意不随春意闹。\n孤芳争出众芳妍。\n若都菩蕾枝头□，恐亦庞生作令前。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"改韵再咏二首 其二","author":"苏仲","text":"冰霜肌骨是家传，染得胭脂不记年。\n雅趣自无前度好，芳名犹冒旧姻缘。\n浓香已被东风引，艳色曾经俗眼怜。\n世事只因忘故态，便教清议得嗔嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙寅除夕二首 其一","author":"苏仲","text":"老至时忙事两违，北风吹雪冷侵衣。\n江山对面客何在，花鸟无心酒兴微。\n不换桃符留旧对，每添香炷数前非。\n明朝又报春消息，付与流莺掷柳枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙寅除夕二首 其二","author":"苏仲","text":"无奈江山岁律移，万牛不挽两轮飞。\n客途老去多萧索，人世无端惹是非。\n不为送穷文字拙，全凭直道鬼神知。\n白头阅世惭无补，敢向人间恨数奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春试笔","author":"苏仲","text":"岁月经营百不休，时情于我两悠悠。\n一行新历初开眼，五十年光又起头。\n临老敢将身计较，效忠无补世筹谋。\n东风唤起流莺语，烂熳春光满地浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]