[{"title":"閒居","author":"袁宏道","text":"只对陈编坐，閒将稚子行。\n笔罢书将老，瓶响茶初成。\n饥鹤窥冰涧，穷鸦话夕城。\n江烟回照里，转湿转鲜明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乍晴即事","author":"袁宏道","text":"寒日回霜薄，天风扇雪晴。\n山纹斜界露，树影拗枝横。\n海客须眉冻，门宾姓字生。\n下床忘栉洗，抛卷上西楹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"袁宏道","text":"寒日抛残历，冬风迫小年。\n霸图虚孟尺，贫策付丘鞭。\n释闷多诙史，嬴欢少破钱。\n不簪复不履，随意但高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘侯宴","author":"袁宏道","text":"满斗撒珠玑，窗风射蜡晖。\n乐从三奏罢，酒看十分飞。\n参佐分山果，优人撤地衣。\n为贪文字饮，小减邑侯威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陶石篑书至","author":"袁宏道","text":"不复言馀事，唯云了即休。\n山川销断案，花鸟罢春秋。\n定后窗行鼠，餐时壁下猴。\n自无求相意，焉用钓文钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"何茂倩索游吴诗","author":"袁宏道","text":"莫漫谈吴事，吴中佳事多。\n天高震泽网，发细虎丘歌。\n只是官无那，由来谷喜过。\n莫釐与緸缈，双峰孰嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子公贫病口占乞笑","author":"袁宏道","text":"病阅冬秋尽，方穷内外科。\n梦来牵母泣，愁觉此身多。\n愧涸鱼求水，翎单雀窘罗。\n伤心谈往事，悔作恋灯蛾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬州舟中晨起","author":"袁宏道","text":"薄月层冰上，飞飞叫去鸿。\n梦寒孤渚雪，茶向一垆风。\n冻网悬枯木，荒崖依病枫。\n繁华无用处，陡觉恋虚空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送洪子崖之归化县","author":"袁宏道","text":"小邑无官长，登临费履綦。\n方言从事译，山景隶人知。\n廨舍巢鹦鹉，乡田贡荔枝。\n岚光侵簿牍，长日但围棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉除夕","author":"袁宏道","text":"得意人间事，经年作旅人。\n愁因山水减，荡免父兄嗔。\n蜡屐千乡雪，公衣几摺尘。\n瓜洲波起处，长日望垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登苏门山泛舟百泉 其一","author":"袁宏道","text":"食罢共成饭，来观泌水泉。\n废桥穿竹屿，小舫载茶烟。\n方外清溪寺，人间好畤田。\n那能营二项，风雨啸台眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登苏门山泛舟百泉 其二","author":"袁宏道","text":"一叶寒塘上，孤云信所如。\n东亭观美箭，西沚访幽居。\n静玩涵波羽，幽怜避饵鱼。\n未容狂阮籍，沉湎污清虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和朱非二山间之作 其一","author":"袁宏道","text":"入谷非无路，凿空尚有痕。\n势危攀棘杪，力尽憩松根。\n天上云烟市，仙家水石村。\n悠然见邃古，梦里亦羲轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和朱非二山间之作 其二","author":"袁宏道","text":"愁绝苍龙岭，苔青万古铜。\n㠉深凭绠汲，栈绝赖枝通。\n洞隔寒溪雪，僧归石璺风。\n半卷轻四岳，一笑傲三公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和朱非二山间之作 其三","author":"袁宏道","text":"只觉川原变，宁知七曜同。\n按图穷大地，卓笏量虚空。\n霞过遗仙影，云归识海风。\n人间三不朽，尘里一微虫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和朱非二山间之作 其四","author":"袁宏道","text":"极态穷工出，摩天插地孤。\n平开东震旦，坐想先供卢。\n曰石铛何在，青溪鹤也无。\n浩歌中夜月，万里湛冰壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和朱非二山间之作 其五","author":"袁宏道","text":"云懒飞难上，龙痴卧不醒。\n巴江寒荡日，郑火夜飞星。\n炉瀹千年液，松留太古青。\n绿霞封石锁，应是护仙经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕朱非二入少林至初祖洞","author":"袁宏道","text":"宿世同来否，青山记梦登。\n云分新坠石，树老旧扶藤。\n古藓番文印，胡䰄壁影僧。\n摩公真狡狯，只履去何曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"话无言上人方丈","author":"袁宏道","text":"秋子拨秋烟，堂头二十年。\n还君半面识，乞我一蠡禅。\n石壁分窗看，松风对榻眠。\n浮生成泛泛，俱有雪毛县。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中逢老衲少时从征有功者","author":"袁宏道","text":"头发遮眉白，归来五乳峰。\n梦中闻虏笑，定起看经慵。\n戒铁支为枕，衲衣挂在松。\n閒时穿洞壁，欲去縳狞龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次良乡","author":"袁宏道","text":"劳碌岂堪怜，心情亦自偏。\n閒中长似郁，途里却翛然。\n草屦多生业，名山老去缘。\n云岚成妄想，渴梦走鸣泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次定川和壁间韵","author":"袁宏道","text":"岁岁疲车马，劳劳憩此州。\n精神渐耗减，名字益虚浮。\n斜月微茫岫，平河散漫流。\n西溪莲在否，持语去年鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"定州见拙诗拓戏题","author":"袁宏道","text":"塔上烟煤句，何人勒此中。\n鸣虚聊以蚓，篆壁偶如虫。\n蚀去宜苔藓，销来仗雨风。\n而今真入石，泥土被丹红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿赵州","author":"袁宏道","text":"入市不闻嚣，残阳半丽谯。\n人家多画水，贾肆尚依桥。\n禅梦采清磬，秋心动夜条。\n柏林如见语，还汝旧时瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓出柏乡","author":"袁宏道","text":"未晓已先兴，轩车带睡登。\n官程胶齿饭，乡思折腰菱。\n野店歌鬟女，孤庵瀹鼎僧。\n不酲亦不醒，沙里鼓鼟鼟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书所见","author":"袁宏道","text":"落日澹秋容，游云忽自重。\n斜披四五树，乱点两三峰。\n马顾横桥水，僧归别路松。\n岩深不见寺，烟里忽闻钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"崤陵壁间见黄平倩诗怅然有怀和韵","author":"袁宏道","text":"角声催晓关，云冷梦初还。\n秋是王维句，月如李白颜。\n涸泉长念雨，笼鸟岂忘山。\n拟把一竿去，相从水石间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潼关题壁","author":"袁宏道","text":"一枕簟花凉，魂清梦亦长。\n雌雷方唤醒，女魃乍迷藏。\n云识鬘鬟气，风知菡萏香。\n那能倦膏沐，千里酒兰汤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕朱非二汪以虚段徽之雨中投兴教寺望南山 其一","author":"袁宏道","text":"树古积苔痕，山高昼易昏。\n袖中云气出，阶下水声喧。\n断鼎残埤寺，青螺紫涧村。\n倚阑叩京尹，还我玉峰轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕朱非二汪以虚段徽之雨中投兴教寺望南山 其二","author":"袁宏道","text":"迹往休寻记，台倾莫问年。\n风香来韦曲，雪色照樊川。\n野寺遮红叶，人家住翠莲。\n隔溪山更好，驱马入苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕朱非二汪以虚段徽之雨中投兴教寺望南山 其三","author":"袁宏道","text":"槛外即危岭，烟中跨楚秦。\n石留前劫字，洞老别朝人。\n夏月莲花雪，冬风暖谷春。\n云深无隙地，千里瘦龙鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过华清宫浴汤泉 其一","author":"袁宏道","text":"镜澈古苔光，溪风湛碧香。\n花犹知世代，水不解兴亡。\n粉黛山川俗，烟泉岁月长。\n而今正好景，石骨照苍凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过华清宫浴汤泉 其二","author":"袁宏道","text":"十六长汤院，阿谁似玉环。\n故宫秋草里，小邑水声间。\n童子驱羊去，村姑赛庙还。\n教他扬广笑，破国只骊山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过华清宫浴汤泉 其三","author":"袁宏道","text":"过鸟烟中迹，回风水上痕。\n欲知天宝事，唤起石苔言。\n兰乳飞千殿，宫云绕数村。\n太真方病齿，歌拍且停翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过华清宫浴汤泉 其四","author":"袁宏道","text":"羯鼓弄伊凉，露花石火光。\n山馀绣领字，云染碧螺香。\n芍药留妃子，鹦哥说上皇。\n难将脂粉水，傲我白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过华清宫浴汤泉 其五","author":"袁宏道","text":"凤靡鸾吪易，王图霸业轻。\n仙灵祠后见，笙柷夜深鸣。\n野火烧连理，秋风荐侧生。\n遥知石镜月，恨不照倾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过华清宫浴汤泉 其六","author":"袁宏道","text":"东岭复西岭，秦乡与汉乡。\n市城云淡淡，今古水汤汤。\n废址耕斜坂，归樵话夕阳。\n乱亡犹有等，最劣是幽王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再泛百泉","author":"袁宏道","text":"欲去复停帴，瓶瓯尚在船。\n异沙千种色，密雨一湖泉。\n有鹤山中梦，无人池上弦。\n醉归旋就枕，带却涧声眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浪歌","author":"袁宏道","text":"朝入朱门大道，暮游绿水桥边。\n歌楼少醉十日，舞女一破千钱。\n鹦鹉睡残欲语，花骢蹄健无鞭。\n愿为巫峰一夜，不愿缑岭千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渑池和黄平倩壁间诗 其一","author":"袁宏道","text":"落日疏林涧水，秋风匹马咸秦。\n南北陵收过雨，东西崤起飞尘。\n龙锁幽崖翠乳，雷绕古树苍鳞。\n穴处巢居谁氏，断辕折轸何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渑池和黄平倩壁间诗 其二","author":"袁宏道","text":"四顾陂陀无地，一螺乡井有君。\n百一崤函天险，五千道德灵文。\n驿路屏遮障掩，溪田错绣罗纹。\n思触枕边流水，梦牵峤外孤云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登焦山","author":"袁宏道","text":"海门一带雾初收，碧树丹崖小十洲。\n山杂云帆浮水上，江盘螺髻出潮头。\n经堂昼寂眠苍兕，石壁晴空挂野猴。\n白首闭关僧自苦，花开花落也春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中和黄道元至日禅寺梦愁诗","author":"袁宏道","text":"一番花信又成春，百结枯肠万转轮。\n铃下久停辰后版，功曹空阁案间尘。\n消愁莫问弓蛇影，对境聊观梦幻身。\n宫缕添来非我有，秪应添得与游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂题 其一","author":"袁宏道","text":"树老无花也自新，山茶红似女儿唇。\n数茎白发春前长，一点青峦雨后真。\n莺欲下枝先作语，鹊能占岁亦如人。\n锦鞯金络纷纷去，飞尽晴郊十里尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂题 其二","author":"袁宏道","text":"儒衣脱却礼金仙，三十偷闲也少年。\n芊草如毡花欲舞，淡烟垂幕柳高眠。\n兴来学作春山画，病起重笺秋水篇。\n酒障诗魔都不减，何曾参得老庞禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂题 其三","author":"袁宏道","text":"晴日园林放好春，馆娃宫里拾香尘。\n痴心春了鸳鸯债，宿命多惭鹦鹉身。\n柳爱风流因病睡，鹊贪欢喜也嗔人。\n桃花不识潘郎去，又逐东君一面新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂题 其四","author":"袁宏道","text":"一番丹蕊一番泥，何处垂杨无马嘶。\n芍药有香兼有态，山鸡能舞亦能啼。\n阴晴雨旱劳占问，云月风花细品题。\n十分漆园学得五，逍遥犹可物难齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂题 其五","author":"袁宏道","text":"幽窗重镊鬓边丝，嬴得青鬟谀少时。\n垆合博山烟吐篆，沙烘石子煖围棋。\n靓妆却念画眉鸟，佞巧愁听百舌儿。\n笑杀陶家五杨柳，春来依旧折腰肢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂题 其六","author":"袁宏道","text":"纵多桃李也无言，只是然篱与映门。\n暖日护将鹦鹉瘴，和风吹却鹧鸪瘟。\n乡书题就双重晕，炉气熏残一缕温。\n梦里明明渡湘水，不知若个似仙源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇甫仲璋邀饮惠山上 其二","author":"袁宏道","text":"萍迹犹怜滞水乡，濯缨满地是沧浪。\n罢来仙县郎官绶，扮作青溪道士装。\n沙鸟惯人眠不醒，岸花经雨折还香。\n相思别后知无益，烂向春风醉一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵饮华中秘宅上 其一","author":"袁宏道","text":"青丝华管夜从容，客正阑时酒正浓。\n堂上观灯莲品品，尊前顾影面重重。\n博他镜月千回醉，假我云山第几峰。\n麈尾奋来毛欲尽，当筵风雨约谭锋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵饮华中秘宅上 其二","author":"袁宏道","text":"长竿百尺拥灯轮，浊酒千巡意转真。\n霜亚残枝花片老，云拖轻影月痕新。\n订将白石成知己，掷却乌纱是野人。\n漏水销来杯不尽，当轩鹦鹉亦留宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮华中秘园亭上","author":"袁宏道","text":"东风杨柳濯青枝，暖日池台艳艳姿。\n巧石疏花宜对酒，文窗香阁好弹棋。\n饥来野鹤如人懒，饮去河豚亦自疑。\n竹里辛夷差得似，天然一幅辋川诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得罢官报","author":"袁宏道","text":"拟将心事寄乌藤，料得前身是老僧。\n病里望归如望赦，客中闻去似闻升。\n尊前浊酒憨憨醉，饱后青山慢慢登。\n南北宗乘参取尽，庞家别有一枝灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游惠山作 其一","author":"袁宏道","text":"柳色渐舒枝渐齐，流莺涩涩美春啼。\n花溪水赤香鱼子，荒草牙青倦马啼。\n鹧鸟不行终恋侣，鹁鸠无屋懒呼妻。\n一瓶煖贮惠泉酒，过得层峦日又低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游惠山作 其二","author":"袁宏道","text":"雪后青山暖复鲜，疏黄浅绿也堪怜。\n高僧执卷供谈柄，少妇明妆送佛钱。\n向子无端儿与女，华阳多事道兼禅。\n浮生早被微名误，迟向人开醉五年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和沈飞霞代老姬别用原韵","author":"袁宏道","text":"双龙毛羽若为乖，销尽琵琶十里街。\n燕子有情终恋主，鸡皮无色强名娃。\n愁同班氏秋来扇，愿作杨家多浚钗。\n桃叶桃根君记否，当年亲指带如淮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏堤曲 其一","author":"袁宏道","text":"浓绿疏黄总古新，六桥风日更精神。\n柳腰似欲争游妓，莺舌分明唤醉人。\n暖谷蒸香疑作雨，芳蹊吹汗不沾尘。\n洛妃谩欲淩波出，曹植荒唐恐未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏堤曲 其二","author":"袁宏道","text":"画阁层层出晓波，东风湖面软于罗。\n佳人秾李山花髻，荡子垂杨水调歌。\n蝴蝶意閒随梦去，鸳鸯情熟奈春何。\n苏公雅亦称相识，浪比西施愧已多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏堤曲 其三","author":"袁宏道","text":"桃叶成蹊柳作行，东风吹热少年场。\n赵家姊妹皆端正，谢族儿郎有短长。\n陌上口声多汴语，垆头结束尽唐装。\n吴歌越舞颠如梦，不是湖山也断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏堤曲 其四","author":"袁宏道","text":"亭亭如月婉如春，堤上楼边总丽人。\n柳汁染将袍已嫩，梨花吹落粉痕新。\n瑈帘欲度閒仙语，宝屐初移拾翠尘。\n宋玉也知空作赋，越姬十倍胜东邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮第六桥酒垆上","author":"袁宏道","text":"流芳亭畔草如油，堕粉吹香历几秋。\n鄂国有祠争下马，西陵无主漫登楼。\n玉龙酿熟多酬直，土哺鱼肥易上钩。\n南北诸峰收不尽，朝朝放艇过溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游虎跑泉","author":"袁宏道","text":"竹床松涧净无尘，僧老当知寺亦贫。\n饥鸟共分香积米，落花常足道人薪。\n碑头字识开山偈，炉里灰寒护法神。\n汲取清泉三四盏，芽茶烹得与尝新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠虞德园兄弟","author":"袁宏道","text":"霜庭五叶晚抽枝，喜得犹通一线儿。\n时戒每尝无味水，闲情多赋落花诗。\n台宗贤教谁能识，何肉周妻到应疑。\n若使相逢不吐胆，更于何处觅相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中过苏 其一","author":"袁宏道","text":"二年前事似前朝，记得朱颜个里销。\n雨雨风风新震泽，车车马马旧虹桥。\n尘来不上双行脚，病后犹存一捻腰。\n是我万般辛苦地，如今闲话尽逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中过苏 其二","author":"袁宏道","text":"无官有客尚留吴，难道陶潜不腐儒。\n魂亦寻花如蛱蝶，梦惟逐浪似鹈鹕。\n孤灯影瘦寒山寺，荒草流青夏驾湖。\n学道参禅都未澈，一毛聊得比杨朱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同梅子马方子公饮北安门","author":"袁宏道","text":"閒对枯槎与钓缗，暮云斑驳似龙鳞。\n青山不许谈新事，白鸟如曾狎故人。\n宫閤参差十里水，衣冠包裹一生尘。\n西门车马东门月，冷热从谁问假真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]