[{"title":"子夜歌十二首 其一","author":"于慎行","text":"侬年三五时，双鬟垂两肩。\n日在欢左右，不解取欢怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜歌十二首 其三","author":"于慎行","text":"不能识郎心，何用识郎面。\n黄檗在深林，苦心谁得见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜歌十二首 其五","author":"于慎行","text":"欢游横塘岸，侬望长安道。\n昔为同心花，今成断肠草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜歌十二首 其六","author":"于慎行","text":"年少不为乐，夷犹欲谁与。\n不见东门花，落地如红雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜歌十二首 其七","author":"于慎行","text":"明旦沟水头，折柳牵郎衣。\n郎心如流水，东去何时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜歌十二首 其八","author":"于慎行","text":"谁令冰不寒，谁令火不热。\n雨霜涂前除，侬思底得绝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜歌十二首 其十","author":"于慎行","text":"相逢不须臾，相看长脉脉。\n木末采芙蓉，莲子何由得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜歌十二首 其十二","author":"于慎行","text":"玉腕弄柔弦，清商吐未转。\n何意凉风吹，使我肝肠断。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜春歌 其二","author":"于慎行","text":"春花浑欲笑，春鸟自成歌。\n惆怅春皋上，含愁可奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜春歌 其四","author":"于慎行","text":"正及春花时，采芳步华薄。\n春风复无情，又欲吹花落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜夏歌 其一","author":"于慎行","text":"开轩待远风，风来不吹面。\n何如觅剪刀，裁作合欢扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜夏歌 其四","author":"于慎行","text":"别时杨花落，别后藕花芳。\n惜往觉日短，望来觉日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜秋歌 其一","author":"于慎行","text":"严霜下空阶，促织声何烈。\n夜中无人语，怀情望秋月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜秋歌 其四","author":"于慎行","text":"别欢三春月，思欢九秋霜。\n霜华上玄鬓，侬心底不伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜冬歌 其一","author":"于慎行","text":"朔风吹北林，玄冰结远岸。\n君心非松柏，岁寒那不变。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜冬歌 其四","author":"于慎行","text":"忆欢不能寐，中夜涕纵横。\n河流不应冻，是侬泪结成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上声 其一","author":"于慎行","text":"木叶自欲黄，不待西风作。\n闻郎歌上声，曲终泪已落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上声 其二","author":"于慎行","text":"上声一何悲，柱促弦欲绝。\n三叹未终极，已看鬓如雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"前溪 其一","author":"于慎行","text":"郎从前溪去，不向前溪返。\n水流无浅深，人心有近远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"前溪 其二","author":"于慎行","text":"前溪何潺潺，花流逐水去。\n侬欲使花还，不能使水住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七日夜女歌 其一","author":"于慎行","text":"长空起薄寒，明河流素月。\n谁云一夕欢，可当经年别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七日夜女歌 其二","author":"于慎行","text":"经年一水间，相望不相及。\n莫卷七襄衣，是侬愁思织。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧玉歌 其一","author":"于慎行","text":"碧玉好颜色，故是小家女。\n笑倚金绣屏，不解挑郎语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧玉歌 其二","author":"于慎行","text":"碧玉十五馀，丝发不及肩。\n理妆背面立，宛转得郎怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"续曲歌 其一","author":"于慎行","text":"别时不知愁，别后空相忆。\n日晚潮水来，渡头问消息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"续曲歌 其三","author":"于慎行","text":"本作双鸳鸯，忽为别鹄怨。\n不是侬泪流，江水有时断。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"续曲歌 其四","author":"于慎行","text":"脉脉闺阁中，常似千里别。\n两心自分明，有如水上月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东飞伯劳歌","author":"于慎行","text":"鸳鸯比翼翡翠吟，巫山湘水高且深。\n可怜新妆映白日，芳脂艳粉当轩出。\n银床试展金缕衣，绮疏月缀琉璃扉。\n凝娇聚态语复咽，卷衣谢君心欲绝。\n春风袅袅花气寒，长留可怜谁为欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲四首 其一","author":"于慎行","text":"桃花如泥柳如雪，飘泊乘风无断绝。\n青枫江上波色寒，郎今不渡春梦阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲四首 其二","author":"于慎行","text":"白门栖乌夜未晓，参横月没霜皎皎。\n金徒受水能几何，合欢日少别日多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲四首 其三","author":"于慎行","text":"芙蓉羽帐翡翠钩，月华当户河汉流。\n微吟细酌欢未厌，城上乌啼明星烂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲四首 其四","author":"于慎行","text":"银床小簟云母屏，博山吐焰双烟青。\n相看脉脉两无语，曼声一曲泪如雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲 其一","author":"于慎行","text":"金堤柳枝拂水黄。\n桃花如焚众草香。\n江南稚女歌春阳。\n歌春阳，气若兰。\n采江蓠，遗所欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲 其二","author":"于慎行","text":"春江漠漠朝气深。\n丹霞紫露流满林。\n踟蹰解佩伤春心。\n伤春心，骋远目。\n望平皋，草空绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时折杨柳歌 其一","author":"于慎行","text":"春风入上兰，鸟啼绿烟中，日耀桃李颜。\n折杨柳，春去复来归，人去当归否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时折杨柳歌 其二","author":"于慎行","text":"芙蓉散朱华，吐艳为谁芳，不采当柰何。\n折杨柳，不畏秋浦空，愿得在欢手。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时折杨柳歌 其三","author":"于慎行","text":"问君何时归，明月凝前除，微霜下沾衣。\n折杨柳，捣衣寄远人，夜凉不觉久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时折杨柳歌 其四","author":"于慎行","text":"北风正烈烈，雨雪逐风飞，山深步道绝。\n折杨柳，但保岁寒心，不道欢相负。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其一","author":"于慎行","text":"皎皎天中月，照我虚堂壁。\n抚枕心不夷，起视今何夕。\n摄提指孟陬，年岁忽复易。\n跳丸日夜驰，迫迫将焉适。\n烈士怀贞心，夸毗营寸尺。\n因时览群动，感叹无终极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其二","author":"于慎行","text":"皑皑原上霜，萋萋道傍草。\n金石有销铄，人生安可保。\n大化为炉锤，万物何缴绕。\n达士耻近图，所思在远道。\n荣瘁非有期，修名苦不早。\n焉能自结束，坐向风尘老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其三","author":"于慎行","text":"日出上东门，桃李何灼灼。\n回风中夜起，嘉树纷其落。\n昔时五侯子，宝马黄金络。\n北里吹笙竽，南邻钟磬作。\n斗鸡出长杨，挟弹过平乐。\n光采照云日，意气何轩霍。\n高台一旦平，里巷飘飞藿。\n不见东陵瓜，近在青门郭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其四","author":"于慎行","text":"迢迢泰山隅，渺渺无行迹。\n猿鸟夹路啼，松桂百馀尺。\n中有啸歌士，鸣琴卧泉石。\n夕采山上薇，朝吸松间液。\n放情凌绛霄，流目瞩四极。\n宴息藐无言，中情多所适。\n我欲往从之，惜哉无羽翼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其五","author":"于慎行","text":"薛公昔好士，珠履罗高堂。\n酒酣指白日，各欲吐肝肠。\n相印甫脱肘，门前迹已荒。\n魏其盛宾客，田侯安敢望。\n一绾大将组，车马盈路傍。\n疏者为胶漆，亲者为参商。\n朝暮市门改，贵贱交情伤。\n灌夫与冯子，意气何飞扬。\n悠悠数千载，此道久沦亡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其六","author":"于慎行","text":"朔风凄以厉，憭慄吹人衣。\n玄云起大陆，雨雪何霏霏。\n孤鸿号中夜，百卉具已腓。\n长恐坚冰至，凛凛伤骨肌。\n鸡鸣感时物，游子驾言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其七","author":"于慎行","text":"白日回青阳，春草萋已绿。\n游子忽不乐，沉吟聊踯躅。\n踯躅将何为，念彼东山麓。\n涧壑生白云，冈峦荫修木。\n飞泉落绝壁，璆然写哀玉。\n山水有至音，安用徵丝竹。\n长揖陌上人，去来从所欲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其九","author":"于慎行","text":"陟彼高台上，天风吹我裳。\n顾见双黄鹄，浩浩摩空翔。\n振翮翳若木，矫翅凌扶桑。\n羽翼岂不修，其如天路长。\n横绝薄四海，中道以徬徨。\n如何燕雀群，追逐令人伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十","author":"于慎行","text":"吾慕汉阴叟，灌园聊避世。\n搰搰自行汲，不肯生机事。\n掉首谢圣儒，比之为技系。\n混沌虽假修，厥言良有味。\n世人徒营营，心劳自憔悴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十一","author":"于慎行","text":"三年雕一叶，为日已蹉跎。\n木鸢徒跕跕，不能出网罗。\n天巧固已凿，于世亦何加。\n大圆惟混混，万木生条柯。\n工者力常少，拙者力常多。\n操斤代大匠，伤手将如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十二","author":"于慎行","text":"登彼蓟门道，东望渔阳城。\n渔阳秋草落，万里阴云生。\n鸣笳弥旷野，虏骑何纵横。\n羽书东西驰，刁斗日夜鸣。\n一战左贤遁，再战谷蠡惊。\n白骨蔽榛莽，落日空原平。\n成功苟如此，安得有吞声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十三","author":"于慎行","text":"十五弄柔翰，操业游艺林。\n纵志有遐览，颇见千古心。\n委质事明主，岁月忽已深。\n怀思敢不报，所愧在浮沉。\n悲歌览青镜，长恐华发侵。\n大块陶万籁，纤巨固殊音。\n微尚在虚恬，经世非所任。\n俛仰感白日，啸咤谁能禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十四","author":"于慎行","text":"家本东海裔，樵牧东山下。\n先子秉儒术，歌音追大雅。\n一吏稍浮沉，举世无知者。\n眇予秉薄祜，宛洛随车马。\n丘陇日以遥，松柏在原野。\n风木无停音，雨露凄其洒。\n一为皋鱼叹，零涕缘缨泻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十五","author":"于慎行","text":"昔我珠树林，荧荧照琼岛。\n子仲工文词，奇气何夭矫。\n如何时不遇，岁宴空山道。\n卞玉苟不开，谁知为世宝。\n伤彼蕙与兰，含芳扬绿藻。\n严霜被空谷，将欲同秋草。\n用大世所难，咄唶令人老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十六","author":"于慎行","text":"习习泽中鸟，斑斑五采质。\n天寒游石梁，十步不得食。\n一朝栖灵囿，羽翰生颜色。\n餐君玉山禾，饮君丹霞液。\n道旁有寒士，感之长太息。\n拂拭岂不怀，人养非所适。\n愿因晨风发，振我凌空翼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十七","author":"于慎行","text":"大鹏运溟海，举翮触四隅。\n鹪鹩巢一枝，栖息常有馀。\n适志无小大，窥化有盈虚。\n昔日五侯里，狐兔嘷其墟。\n君平卜百钱，常有终岁储。\n老氏戒止足，千古铭盘盂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十八","author":"于慎行","text":"栎社有大树，轮囷以樛棼。\n下枝蔽牛马，上干干青云。\n匠伯睨不顾，终古绝斧斤。\n翡翠巢南海，何尝慕世氛。\n金丸落珍木，惟以羽毛文。\n膏火为谁销，兰香徒自焚。\n多材实身累，沉溟与道群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其十九","author":"于慎行","text":"六籍既已远，扬马不可作。\n铅刀为湛卢，腊鼠称周璞。\n伟哉二三子，将操郢匠凿。\n胡为崇亢厉，亦复呈丹雘。\n裂吻御寒菹，飘帷奏清角。\n信美非大观，矩裁焉所托。\n雅道和且平，治音安以乐。\n不悲而嘘唏，皇风无乃薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀二十首 其二十","author":"于慎行","text":"黄帝游赤水，象罔得玄珠。\n遇道皆如此，安用图与书。\n奈何江左流，所味在清虚。\n六籍皆糟粕，三坟为土苴。\n得鱼可忘筌，无筌焉取鱼。\n譬人适莽浪，伥伥将奚如。\n悲哉道丧世，一叹徒愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其一","author":"于慎行","text":"新知且莫欢，生离且莫悲。\n忧来无定端，愁思当语谁。\n夙昔同衾裯，中心怅有违。\n何况万馀里，欲以见容辉。\n君行忽已久，岁月不相守。\n浮云蔽中天，凉风吹户牖。\n忧来不可宣，浩叹成疢首。\n黾勉加餐食，素心良不负。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其二","author":"于慎行","text":"春夜一何永，置酒临高堂。\n宾从列四座，广乐奏东厢。\n清歌激流羽，琴瑟悲且良。\n高张发促柱，哀音不可详。\n沈吟欲何待，酌醴不盈觞。\n人生天地间，辟彼隙驹光。\n世路岂不怀，坎?多所伤。\n乘时慎自保，为欢殊未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其三","author":"于慎行","text":"名都开大道，上有三重楼。\n桂树罗棂牖，飞泉鸣道周。\n盈盈楼上女，新妆丽且修。\n当户弹鸣琴，皓齿发清讴。\n一弹幽兰生，再弹白雪流。\n游子在万里，邈焉无匹俦。\n忽忽岁云晏，不知春与秋。\n音稀和者寡，顾念徒怀忧。\n游目送飞鸿，泪下不可收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其四","author":"于慎行","text":"漫漫秋夜长，四壁凉风烈。\n空庭流熠耀，高树号鶗鴂。\n仰视玉绳垂，众星烂成列。\n志士多悲心，忧来不可绝。\n俯仰念昔游，流睇双龙阙。\n同时有旧好，高举翔寥泬。\n昔为雷与陈，今为秦与越。\n永怀平生心，风尘非所阅。\n麾手谢故人，长当从此决。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其五","author":"于慎行","text":"迢迢百尺楼，下俯长安道。\n上有狭邪人，玉颜一何姣。\n当户理琴歌，沉汉悲清晓。\n本以倚门姿，委心结宴好。\n良人逝不归，忧伤难独老。\n顾匪姬与姜，悠悠亦何保。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其六","author":"于慎行","text":"湛湛江湘阯，萧萧芳树林。\n褰华思有赠，馨香盈我襟。\n美人渺千里，欲致无依因。\n江寒风已厉，旷望愁人心。\n且复置怀袖，聊以襞锦衾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其七","author":"于慎行","text":"瞻彼泰山岑，厥有孤生竹。\n冉冉捎云霓，亭亭上岩谷。\n凄凄岁欲寒，盈盈华色绿。\n凉风振层阿，音响如哀玉。\n高节抱贞心，可折不可曲。\n顾见女萝枝，绸缪附乔木。\n天霜降严威，零落成朴?。\n所以君子心，邈然自结束。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其八","author":"于慎行","text":"我行秋江曲，睹彼蕙与兰。\n紫茎发绿叶，秀色若可餐。\n芳馨随风转，郁烈不能干。\n采采不盈掬，思以遗所欢。\n所欢在天杪，道路阻且难。\n弃置委空谷，将随百卉残。\n佩帏岂不充，无乃蒯与菅。\n兰芳非有待，所佩诚足叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其九","author":"于慎行","text":"驱车东城道，言陟崇山阿。\n茫茫顾四野，万木更条柯。\n薄云出岩岫，绿水生微波。\n四时更代谢，寒暑递相过。\n日月化颜容，华发亦已多。\n修名苦不早，秉烛嗟蹉跎。\n览镜念平生，浩叹将如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意十二首 其十","author":"于慎行","text":"暮秋多悲风，玄霜凝大泽。\n驾言出行游，游彼重城北。\n道旁何代丘，郁郁松与柏。\n上有千里涂，下有万古宅。\n不知王与侯，狐兔多遗迹。\n人生匪金石，地上长如客。\n新故递相寻，神巧不能测。\n伤彼道旁子，矫性何迫隘。\n宠利既内营，荣名多外饰。\n交战汩衷和，鬒发日夜白。\n胡不放情志，逍遥以永夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]