[{"title":"观音岩","author":"黄公辅","text":"峭壁玲珑一洞开，半天幽筑两层台。\n逶迤石径深还入，荡漾扁舟去复来。\n灵叶座浮莲朵朵，宝珠盖滴蕊枚枚。\n烟霞缥缈凭高眺，收拾奚囊翠作堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐昌阻雨刘亲家韵 其一","author":"黄公辅","text":"轻舟何事阁江头，云暗孤城雨未收。\n夜半溪流声转剧，不堪迢递旅怀幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐昌阻雨刘亲家韵 其二","author":"黄公辅","text":"雨馀春色烂山城，来去扁舟逐岸行。\n比屋篱门三五舍，野花照水乱云横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐昌阻雨刘亲家韵 其三","author":"黄公辅","text":"维舟屡日阻狂澜，残色凄凄带雨酸。\n客梦不成嫌夜永，晨来无语对江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐昌阻雨刘亲家韵 其四","author":"黄公辅","text":"一剑离家事远征，长途何处不关情。\n况逢逆旅春将半，烟雨溟蒙碧草生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨刘韵","author":"黄公辅","text":"淫雨妒春颜，偏侵客舫间。\n浪迷来处岸，云暗望中山。\n聊借联舟话，稍舒逆旅颜。\n翻怜芦港里，渔艇一篙间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜晴刘韵","author":"黄公辅","text":"熹微天际头，转觉波间浮。\n柳色娇平岸，沙痕白浅洲。\n暴阳禽对对，展翅乐悠悠。\n趁此春光好，载晴度客舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岳州从陆登舟顺风过临湘新堤市","author":"黄公辅","text":"岳阳城外道，晴日暮云降。\n骋望群峰万，乘流泛棹双。\n远渡浮碧落，返照漾船窗。\n傍岸呼童去，沽壶醉暮江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衡州道中","author":"黄公辅","text":"轮蹄逐逐楚天遥，历尽江山昼复宵。\n习习香花迎客媚，关关啼鸟挟春娇。\n也知夫仆劳驱马，争奈邮程促远镳。\n却羡岩隈三五老，披裘閒步野溪桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宜章有怀","author":"黄公辅","text":"道从平石入章城，山径云岚马首生。\n啼鸟骄春迎鼓角，和风夹道捲旗旌。\n昔年知己嗟萍梗，此日驱车促客程。\n景物渐殊乡语别，歧分楚粤重关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安乡道中有感","author":"黄公辅","text":"平原四望渺无边，不见青山只见天。\n满道蒙茸惟野草，沿涯洼湿少腴田。\n又逢刁斗声方急，何怪徵输苦不前。\n谁为绘图呈魏阙，穷阎赖得计安全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登黄鹤楼","author":"黄公辅","text":"黄鹤高翔何处巅，尚留胜概亘长天。\n星罗万户依峗郭，水汇三湘荡碧烟。\n非借高人增绮阁，那凭远眺忆飞仙。\n赏心会到忘言处，清籁稀微一笛先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登黄鹤楼时闻流寇犯楚界速往常德","author":"黄公辅","text":"峗峨高阁倚云巅，俯瞰长江水拍天。\n偶得登临舒望眼，恍从图画缀轻烟。\n风声疑是当年鹤，笛韵犹怀昔日仙。\n时事关情催棹急，中流击楫任谁先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿周家田庄 其一","author":"黄公辅","text":"春雨溟濛碧草萋，云林深处暂安栖。\n东邻买米西邻菜，饱饭还须念藿藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿周家田庄 其二","author":"黄公辅","text":"门前柳色锁云霞，畎亩生涯自一家。\n入暮停车聊憩宿，那嫌村舍非官衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽崇滚弟","author":"黄公辅","text":"尔我同庚如骨肉，相随宦邸鹤音和。\n十年三径陶然共，千古一朝可奈何。\n去岁欢颜浮柏斝，今时青泪湿春罗。\n栽蔬隙地间抛却，谁为编篱护薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至常德","author":"黄公辅","text":"撇下带围已十春，腰间赢得任舒申。\n无端又逐三湘路，兼却疏违八口亲。\n挝鼓放衙无逸趣，批签披牍祇劳人。\n移文荔圃园丁子，好护花枝与沼鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄石头陈芬阁","author":"黄公辅","text":"别却凫鸥事楚游，洞庭阅尽一帆舟。\n笑将习懒耽间者，阑入嚣尘杂遝俦。\n鼓角惊残还里梦，云山引去望乡眸。\n他年草就归来赋，求友莺声啭石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过袁中郎故居有忆小脩年兄","author":"黄公辅","text":"诸袁名沸楚之南，郭外故居俯碧潭。\n柳色犹疑分角里，鸟声差似诵瞿昙。\n试看今日苞纹九，奚让当年凤侣三。\n兰籍萧条增感慨，式庐空自怅晴岚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荆门道中","author":"黄公辅","text":"日夕驱车底事忙，轻烟笼树淡山装。\n野花开遍斜侵径，阵阵乘风扑袖香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆三兄","author":"黄公辅","text":"韵叶熏篪谊特隆，相从官邸燕闽中。\n原鸰遽咽寒霜月，邻杵乍残白露风。\n古巷烟花怜失主，东亭花好为谁红。\n虽云七十由来少，其奈钟情恨不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"往承天见楚俗莳田妇女多于丈夫每田二三十成群丈夫二人击鼓相催群妇互歌相答须臾而此田莳毕又过别田矣诗以述之","author":"黄公辅","text":"驱犊过前溪，和烟带雨犁。\n莳田循界畔，撷水任高低。\n妇女成行列，乡邻合作齐。\n鼓催沿土俗，歌答和禽啼。\n清风徐拂面，霞彩淡粘绨。\n时踏闲云径，或过青草堤。\n朝同杲日出，暮向茅庐栖。\n抱瓮忘机械，娱宾有黍鸡。\n纷纷是与非，不到陇之西。\n笑杀途中客，急鞭催马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澧州早行 其一","author":"黄公辅","text":"登舆犹在梦醒关，策骑驱驰山又山。\n聒耳蛙声鸣唧唧，行人那得似伊閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澧州早行 其二","author":"黄公辅","text":"明月当空翠满檐，溟濛雾霭湿鬘鬖。\n计程廿里天将曙，料得幽人睡尚酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澧州早行 其三","author":"黄公辅","text":"东方渐觉日朦胧，山带烟岚淡抹工。\n穿树沿涯随径出，恍然人在画图中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼张月沙同年","author":"黄公辅","text":"去年寄我平安字，此日讣音恨不平。\n鼎水时闻枝上鸟，血痕疑是蜀魂声。\n望穷峨岭眉增惨，泪逐巴江字不成。\n海内知心还有几，池边翘俟凤争鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"常德郡伯顾母节孝诵","author":"黄公辅","text":"直矢丹心蘖自餐，冰霜凛烈鹤纱寒。\n承亲劲节强钟鼎，捍柩孤贞胜羽干。\n争羡此时襦作诵，都凭当日胆为丸。\n陈情沥血悲风木，赖有褒章焕彩鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"黄公辅","text":"碧树深森景色幽，悠悠世路更何求。\n道人自是忘机侣，满径烟霞物外收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙亥午日衙内与四兄小酌","author":"黄公辅","text":"薰风晴日逗窗绡，鸲鹆新声何处娇。\n蒲酒漫同兄弟酌，荔枝犹隔粤山遥。\n天涯宦迹如萍聚，游子乡心似柳飘。\n昼永阴浓清院宇，欲歌兰浴未成骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"册封荣藩世子暨长宁王承荣殿下赐宴于青阳阁","author":"黄公辅","text":"四牡骖驔丽锦鞯，山河千载帝恩鲜。\n辉煌玉节来宫阙，焜耀泥书艳楚天。\n华萼楼前瞻气紫，青阳阁上傍云连。\n宠筵醉后歌麟趾，满袖沾濡湛露旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别四兄归粤 其一","author":"黄公辅","text":"是处垂杨五月江，霏霏微雨洒归艭。\n府河怅望飞帆渺，衙树惊看宿鸟双。\n笑我一官羁北楚，输兄三径傲南窗。\n何时共结烟霞侣，荔圃津头学老庞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别四兄归粤 其二","author":"黄公辅","text":"才喜衙斋共晓昏，骊歌忽又重销魂。\n不将乡事临歧说，恐动离肠逐浪鶱。\n祝尔和风过远浦，凭谁明月坐西轩。\n三湘难隔离乡梦，丹荔于今熟满园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋前二日荣王西园月夕宴","author":"黄公辅","text":"秋到西园一洞开，更于何处觅蓬莱。\n池光荡漾迎风入，亭敞清虚送月来。\n三匝青乌栖得树，几枝香桂影浮杯。\n承恩恍坐寒宫里，领略霓裳醉后回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾常德请游德山","author":"黄公辅","text":"画鹢乘流访德山，胜心高翥共跻攀。\n昆卢阁上钟声度，苍桂枝头鸟语闲。\n皓魄分辉侵燕席，红霞散彩入酡颜。\n不辞剪烛留连兴，携得秋光翠色还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕有怀","author":"黄公辅","text":"此夕繇来乞巧同，惭予抱拙对虚空。\n犊裈且把长竿曝，云锦那须组织工。\n牛渚风高飘鹊羽，梅梢月冷逗房栊。\n宦情争似乡情好，清夜凭栏望彩虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德山前韵","author":"黄公辅","text":"晴日同登郭外山，丛林深处向高攀。\n前朝古木双株翠，夹道脩篁半偈闲。\n兴到遐情骄野鹿，狂来笑语傲商颜。\n波光潋滟浮归棹，明月窥窗相伴还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日","author":"黄公辅","text":"细雨霏霏入暮斜，楚天秋色淡蒹葭。\n塞鸿远度三三节，篱菊初开九九花。\n勿问轻风欺短发，且将樽酒酌闲衙。\n去年树下登高处，湖水烟波几渡赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙亥初度前二日笃望侄余内侄衙轩小酌","author":"黄公辅","text":"昼永榴花艳正匀，天涯那问矢弧辰。\n退衙谢客无公事，倚槛看书有斫轮。\n鸡肋不堪磨岁月，樗材何以答君亲。\n同来小阮殷勤甚，西爽轩前酌几巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初度自述","author":"黄公辅","text":"火欲西流暑尚炎，晨来白发上梳尖。\n每逢生日蔬为食，回念劬劳骨若砭。\n虽有锦屏赓乐只，何如儿女祝安恬。\n家乡迢递音书渺，几度孤吟自拂髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜余舅至衙家中儿孙寄来短衫龙眼等物","author":"黄公辅","text":"久无消息度湘湖，一纸平安喜欲呼。\n乡果沾唇情似蜜，布衫适体爱如乌。\n一官自笑无长物，八口犹怜有宿逋。\n秋到疏帘蛩渐语，感时转忆沼边凫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张泰岩别于留都十一载适遇于常武共谈往事又见其两孙雅致楚楚喜赋","author":"黄公辅","text":"十载离踪一覕过，相逢客邸感怀多。\n看来何事非空影，阅去前途总逝波。\n抵掌谈时眸欲白，班荆话旧发怜皤。\n喜看奕奕桐枝秀，孔李绸缪又若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张泰岩谒伏波将军庙志感之作时在滇招降普寇也","author":"黄公辅","text":"人心原在是非公，归向惟凭德望崇。\n自昔无端猜薏苡，于今那不羡英雄。\n泽同武水流何尽，名并庐峰耸太空。\n俎豆千秋勤庙祀，后人犹得藉遗风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"似熊侄衙归","author":"黄公辅","text":"桂花香散翠岚天，不尽离思向浦船。\n赖得新书充旅橐，何妨旧絮禦寒烟。\n湖湘皓月孤帆影，朗水凄风万木颠。\n归到乡园梅正白，好从词社斗芳妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中西番菊","author":"黄公辅","text":"一种幽姿擅众芳，传来异域斗姚黄。\n偏逢冷露才舒艳，尤借寒霜为洗妆。\n逸致堪争陶令兴，孤英未许楚人尝。\n故园三径知何似，管领秋光锁夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈司理貤封并之官乾州","author":"黄公辅","text":"法曜辉腾福曜明，封章宠锡重持平。\n胸中素有筹边略，郢上今誇借箸名。\n勿以梁山多警燧，正凭刺史壮长城。\n出奇自昔推陈氏，传檄行看达帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺兵道叶六桐父母生日","author":"黄公辅","text":"悠悠鼓角靖边氛，闲却如林虎豹群。\n暖人梅花春色早，风清画戟鹤声闻。\n剑光夜丽弧南象，关气朝明楚北云。\n华祝欢腾千万户，凤毛更羡映斓文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答华阳王","author":"黄公辅","text":"才华久矣擅淮南，芷韵兰情孰可参。\n雁羽纵横来鼎水，云花错落斗烟岚。\n惊人自昔苏惟二，贵纸于今左有三。\n遥想兔园春色好，向阳谁不醉清酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中梅初开","author":"黄公辅","text":"谁催春意入官衙，忽见庭梅已放花。\n几点如星疏有态，数枝斗雪澹无华。\n仙郎梦觉香风远，宿鸟栖群瘦骨斜。\n路隔衡阳无驿使，折来那得到仙家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙内对雪","author":"黄公辅","text":"客邸寒深万木凋，朝来树树缀银条。\n浑疑柳絮千番舞，别是春情一样娇。\n官况自甘东郭履，诗书那似灞河桥。\n儿童差解烹松茗，澹趣悠然啜一瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎春赋","author":"黄公辅","text":"鼓角迎春闹市衢，看来三五步相趋。\n人看春也年年似，春阅人兮岁岁殊。\n浪说翠蛾横半额，那知白雪转盈腮。\n春来春去浑如此，臈酒何辞倒碧壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春","author":"黄公辅","text":"令转三阳雪势降，烟花明媚捲旌幢。\n凭将弱柳舒青眼，度却和风到碧窗。\n游踏香尘人两两，鸣流清韵鸟双双。\n乡心忽觉随花发，谩把辛盘载酒缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕二首 其一","author":"黄公辅","text":"翻遍历头岁已阑，楚天臈尽尚馀寒。\n儿童乞写宜春字，老仆勤修守岁盘。\n自是玄工分乙丙，将于午夜转支干。\n梅花独领春消息，岁岁年年一夜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕二首 其二","author":"黄公辅","text":"坐对青灯夜息阑，数声鼓角送残寒。\n每惊炮竹催年急，转羡园林淑景宽。\n家计未能逋事了，客途那得梦魂安。\n回思昨岁团栾处，星斗宁堪两地看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮有感","author":"黄公辅","text":"旅邸惊看岁序忙，凭栏何事几回肠。\n娱人惟有庭前酒，欺老其如鬓里霜。\n六十年来曾一瞬，四千里外隔三湘。\n荔园何日容吾逸，绕径穿林屐齿香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦拜圣节回","author":"黄公辅","text":"画角传宣夜色纤，对扬清肃凛威严。\n归来星斗犹横汉，坐对香烟独捲帘。\n淑气晴光随处好，旅情乡念个中兼。\n故园倍占春光早，料是兰芽渐发尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦荣府朝贺","author":"黄公辅","text":"五运初开丙子春，春风送暖正宜人。\n星环北极正依日，气入东皇瑞拥晨。\n剑佩辉扬争奔奏，衣冠拜祝效惟寅。\n数年四海浑多事，帝治从今运转新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣价归","author":"黄公辅","text":"开年闲数日，聊得写家书。\n句句思乡语，时时忆旧居。\n洞庭春浪稳，珠海暖云舒。\n归到阮山日，平安早寄予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得豫儿生孙之报兼念坚孙","author":"黄公辅","text":"人日晴光淡午风，梅花香霭斗芳丛。\n忽凭鸿雁来湖北，却喜芝兰发阮东。\n弓冶谩云原有样，骅骝跨步好争雄。\n天涯老子归来日，任尔群呼白发翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华阳王园梅双异","author":"黄公辅","text":"名园别是洞中天，中有梅花异样妍。\n六瓣香淩蓬岛月，重台彩映玉田烟。\n若然何逊来花下，宁啻扬州在眼前。\n不尽春光谁管领，主人结社握词权。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答汪和邱年兄寄惠佳刻","author":"黄公辅","text":"一别春明十五年，各天消息却茫然。\n头颅相顾惭非旧，云树兴怀倍可怜。\n赖有飞鸿来朗水，喜看丽藻斗春妍。\n苍生属望今谁是，早晚蒲轮汉洞边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荥王元夜招饮看珠灯烟火","author":"黄公辅","text":"邸第招邀入画堂，日迟风暖属春王。\n花燃火树分梅艳，灯映明珠混月光。\n谁架虹桥来咫尺，恍从仙侣共相将。\n芳宵自是留人住，酣赏何辞夜未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杨修龄先生遗卷","author":"黄公辅","text":"能于真我觅真悰，因应如环任适从。\n忧国筹边皆实著，空花泡影总销镕。\n德山无复双游屐，手泽犹存半偈宗。\n知是灵通超起灭，令人千载想高踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和华阳宗室曙谷","author":"黄公辅","text":"吏事何胶扰，天潢邂逅奇。\n投欢怜脱俗，相见恨无迟。\n珠吐挥毫处，云生扫素时。\n河间流韵远，千载惬心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明","author":"黄公辅","text":"三春忽已二，旅邸又清明。\n草绿离离色，莺啼处处声。\n无穷游子意，莫展上邱情。\n回首梅花邈，乱云空自横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送余舅归应试","author":"黄公辅","text":"离家岁一更，旅邸共扬衡。\n言别风烟黯，思归羽翮轻。\n囊羞无所赠，道远有馀情。\n珠海鲲池阔，快登万里程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]