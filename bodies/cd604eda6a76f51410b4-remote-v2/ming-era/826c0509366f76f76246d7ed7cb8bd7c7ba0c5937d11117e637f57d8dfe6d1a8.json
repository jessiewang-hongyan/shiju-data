mmit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕观妓","author":"徐熥","text":"玉露凋瀼片月明，人间天上此时情。\n红楼不似银河隔，一任邻鸡报晓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事","author":"徐熥","text":"莫叹吾家似磬悬，资生犹有卖文钱。\n不知万落千村里，多少人家绝火烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访黄道晦","author":"徐熥","text":"桑麻鸡犬自成村，溪口云深绝洞门。\n有客迟回空日暮，不知何路到花源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"口占戏赠道晦","author":"徐熥","text":"家难相寻已十秋，半居城市半林丘。\n此身已是空门客，只欠披缁物外游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林伯溥还金陵","author":"徐熥","text":"落魄江湖岁月更，相怜何必是平生。\n送君忽起并州感，衰柳秋风白下情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜即事","author":"徐熥","text":"秋宵残雨上窗纱，一点流萤照暮花。\n觅得轻罗穿竹径，已随风叶过邻家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24048,"