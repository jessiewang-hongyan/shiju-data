[{"title":"送郑翰卿游燕 其一","author":"徐熥","text":"慷慨辞家事北游，黄沙万里使人愁。\n市中击筑悲歌日，为觅荆卿旧酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑翰卿游燕 其二","author":"徐熥","text":"大梦山前片月孤，送君走马入燕都。\n黄金台上生秋草，犹有当年骏骨无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六溪夜泛","author":"徐熥","text":"暮潮初涨月痕低，一叶兰舟过六溪。\n唱罢沧浪天渐晓，青山无数鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌石山访虚公","author":"徐熥","text":"飞锡何年住此山，长松修竹掩禅关。\n斜阳影里暮钟发，三十六峰烟霭间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日郊行","author":"徐熥","text":"春风初动暮云平，十里芳郊信马行。\n山色苍苍溪水绿，杏花村里鹧鸪声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其一 仙桥柳色","author":"徐熥","text":"迎仙桥畔万条丝，淡荡春风二月时。\n知是踏青归去晚，几多游女唱杨枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其二 大梦松声","author":"徐熥","text":"澄湖潆绕越王城，十里湖光似镜平。\n怪得寒涛何处起，前山无数乱松声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其三 古堞斜阳","author":"徐熥","text":"百尺高楼接女墙，犹传闽越旧封疆。\n可怜霸业归何处，惟有寒鸦带夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其四 水晶初月","author":"徐熥","text":"孤山深处水晶宫，画舸归来信晚风。\n欸乃歌残天似水，一痕新月上湖东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其五 荷亭晚唱","author":"徐熥","text":"虚亭遥跨水中央，五里荷花十里香。\n度曲女郎齐拍手，一声惊散两鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其六 西禅晓钟","author":"徐熥","text":"湖上邀宾卜夜驩，胜游休问夜漫漫。\n天鸡叫罢晨星落，犹听钟声出寺残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其七 湖心春雨","author":"徐熥","text":"滉漾平湖影碧空，千重树色尽朦胧。\n春光何处尤堪赏，多是梨花暮雨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖八景 其八 澄澜曙莺","author":"徐熥","text":"子与风流天下闻，刱来高阁欲凌云。\n晓莺不道年华变，犹自声声唤使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼侠气赠李姬 其一","author":"徐熥","text":"阿娇侠气满红楼，不肯轻身事贵游。\n昨日五陵公子过，青衣传语未梳头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼侠气赠李姬 其二","author":"徐熥","text":"文章元不属蛾眉，红粉谁知唱丽词。\n袖里云笺裁五色，客来题出断肠诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼侠气赠李姬 其三","author":"徐熥","text":"玉貌元同苏小娟，清讴一阕最堪怜。\n歌声未断尊中罄，犹卸金钗当酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼侠气赠李姬 其四","author":"徐熥","text":"绿云慵理黛痕销，时把金簪竹上敲。\n但得黄金能买赋，何须珠翠斗妖娆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题朗公宝函楼","author":"徐熥","text":"一瓢一钵一经函，幡影灯光对佛龛。\n百尺楼中皆净土，莲花千叶坐瞿昙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过面壁洞访熙工","author":"徐熥","text":"蹑屐重过积翠台，当时屐齿半苍苔。\n桑麻鸡犬还如旧，洞口桃花几度开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其一","author":"徐熥","text":"翡翠衾寒晓漏迟，博山香烬夜何其。\n起来试揭珠帘看，月在梨花第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词 其二","author":"徐熥","text":"莫怨銮舆宠幸稀，九重天子正宵衣。\n云和一曲閒清昼，乳燕帘前作对飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对月荅邓汝高","author":"徐熥","text":"共对秋山月影寒，尊前莫惜尽馀驩。\n不知故国秋山月，能得尊前几度看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日怀王少文","author":"徐熥","text":"去岁逢君花下饮，閒庭花落正纷纷。\n于今又是花时节，但见花开不见君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访程子晖","author":"徐熥","text":"草阁秋深露气寒，白龙江上暮云残。\n轻舟泛入桃源里，两岸芙蓉一钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕怀李伯实","author":"徐熥","text":"往事伤心倍可怜，故人今夜渺云天。\n灯光月色鞦韆影，已隔春风二十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子行太守谪茶陵 其一","author":"徐熥","text":"一官何事又投荒，楚峡猿声几断肠。\n正是长沙迁谪地，不堪夜雨度潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子行太守谪茶陵 其二","author":"徐熥","text":"不为相逢叹陆沉，总缘离别易伤心。\n孤臣命似湘云薄，圣主恩同汉水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子行太守谪茶陵 其三","author":"徐熥","text":"楚江遥望隔天涯，盛世南迁道路赊。\n满目春光无限泪，清明风雨马头花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子行太守谪茶陵 其四","author":"徐熥","text":"春雨潇潇春草微，片帆遥逐楚云飞。\n此行若过湘江路，莫吊三闾吊二妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄白仲","author":"徐熥","text":"家在西湖第几峰，白云无数水重重。\n鸟啼花落春光暮，同听南屏寺里钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与瀚公宿绿玉斋","author":"徐熥","text":"几年踪迹各西东，一点禅灯此夕同。\n对坐空山天籁寂，满林花雨月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山别闵龄","author":"徐熥","text":"古寺钟残暮霭收，人烟起处见瓜洲。\n长江渺渺愁无尽，况上秦淮万里舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芋江驿楼送张四之白下","author":"徐熥","text":"春风吹柳万条斜，此去金陵驿路赊。\n不必相思当后夜，片帆开处即天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀谢在杭司理","author":"徐熥","text":"一片愁心两地分，三年人隔五湖云。\n从来未识苕溪路，只是思君不梦君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙宗寺","author":"徐熥","text":"古寺荒凉蔓草生，青山回合暮云平。\n当年遗迹俱尘土，惟有流泉是旧声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自鼓山历凤池寻白云洞不得误抵山麓而归口占寄赵用拙居士 其一","author":"徐熥","text":"岧峣径路杳难分，猿鸟哀呼日半曛。\n莫谓洞门今咫尺，不知犹隔几重云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自鼓山历凤池寻白云洞不得误抵山麓而归口占寄赵用拙居士 其二","author":"徐熥","text":"桃花流水自潺湲，晓起寻君日暮还。\n不是渔郎迷去路，断无踪迹在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涌泉寺怀融上人","author":"徐熥","text":"忆昔团焦住化城，萧萧风雨佛灯明。\n于今重借云房宿，无复当年禅诵声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与陈惟秦郑震卿宿老禅庵","author":"徐熥","text":"古寺钟残夜已分，三人同卧一床云。\n他时此地闻钟夜，未必连床又是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其一","author":"徐熥","text":"王郎本是大罗仙，暂谪人间二十年。\n一夜缑山仍控鹤，满天风露冷婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其二","author":"徐熥","text":"去年春暮禁烟寒，把酒看花共倚栏。\n此日花开君不见，黄垆相隔路漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其三","author":"徐熥","text":"龆龀能诗便有声，笔花长向梦中生。\n如今玉树埋黄土，谁继风流竹下盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其四","author":"徐熥","text":"素笺如练墨如云，年少临池独有君。\n旧日兰亭今寂寞，不堪开箧见遗文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其五","author":"徐熥","text":"长吉当年赋玉楼，怜君犹少七春秋。\n伤心处处生悲感，何必山阳始泪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其六","author":"徐熥","text":"绵绵幽恨几时销，金屋无缘贮阿娇。\n虚度春光二十载，看花不及咏桃夭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其七","author":"徐熥","text":"猿鸟声中昼掩扉，竹阴依旧故人非。\n思君忘却幽明隔，犹怪音书近日稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其八","author":"徐熥","text":"一别黄泉路杳冥，愁云空锁草玄亭。\n即今风雨罗山夜，猿鸟哀呼不可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其九","author":"徐熥","text":"魂魄悠悠到夜台，应知尘世不重来。\n从今绿玉斋前路，一任春风长碧苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭王少文秀才 其十","author":"徐熥","text":"记得孤斋晚眺时，倚栏连袂共题诗。\n山中每到斜阳后，便觉伤心双泪垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词寿陈汝大 其一","author":"徐熥","text":"半生踪迹寄烟霞，炼就丹垆九转砂。\n鹤背鸾笙明月夜，一声吹过碧桃花。","collection":"明","no