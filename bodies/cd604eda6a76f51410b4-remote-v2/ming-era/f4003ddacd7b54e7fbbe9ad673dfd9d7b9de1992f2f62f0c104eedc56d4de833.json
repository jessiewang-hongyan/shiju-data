[{"title":"潮阳八景 其一 麻田紫气","author":"吴仕训","text":"金沟沟外种麻田，辟谷仙方自可传。\n莫道借车游已远，长瞻紫气在南天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潮阳八景 其二 莲峰海色","author":"吴仕训","text":"栖真海口咏沧浪，枕石餐霞意激昂。\n盼望乘云归去久，惟留水色与山光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潮阳八景 其三 玉峡山辉","author":"吴仕训","text":"青溪几曲绕名山，秋水渔矶杳霭间。\n二十年前载酒处，空闻邻笛月中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潮阳八景 其四 灵山留衣","author":"吴仕训","text":"一衣一钵是禅装，何事留君云锦裳。\n城郭山林浑不异，空馀神木不为梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄岐山歌","author":"曾迈","text":"南越之南揭阳岭，突兀层峦黄岐山。\n从秦历汉群峰出，流云飞霞不可攀。\n上有浮屠拂云起，石湖千载抱泉水。\n悬崖风雨古木疏，春色秋容翠微里。\n磊石玲珑溪谷中，洞门双辟竹与松。\n盘桓宛转多迂怪，叠巘连岫度晚风。\n俯临玉窖之双溪，舂容夜月映沙堤。\n山高水清长无绝，渡水登山无尽期。\n昔人独有陈夫子，幽栖选胜风流美。\n古今地灵应相托，山中仙客良有几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月登黄岐山绝顶","author":"曾迈","text":"独有登高兴，欣逢九日缘。\n维舟分二水，著屐拟诸天。\n潦倒悲秋客，清狂作赋年。\n悠然饶古意，宝塔拂云烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙桥山怀郑碧河太史","author":"曾迈","text":"登山聊一梦，谷口旧丘亭。\n人岂仙桥重，地因太史灵。\n文章空有托，松柏忍为听。\n长醉歌凫舄，秋风若解醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游凤栖岩","author":"丘道光","text":"我来寻道士，恍惚入鸡山。\n径僻春云满，岩空夜月閒。\n香台修竹里，清磬绿萝间。\n为爱红尘断，跏趺日暮还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江田晓发闻杜鹃","author":"丘道光","text":"青山如黛绿萝长，风雨潇潇送短航。\n此去家乡应咫尺，杜鹃何事叫归忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食偕同寅集北山寺","author":"丘道光","text":"东风榆柳雁飞斜，寒食年年不在家。\n解道逢僧间半日，莫将僧舍比官衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万寿节","author":"梁斗辉","text":"佳节巧联少海辰，祥云璀璨月重轮。\n虹光色动龙鳞晓，雪藕香浮凤阁春。\n捧日丹心悬斗极，瞻天喜气溢勾陈。\n欲将金鉴何繇献，目极尧阶祝颂频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"册立冠婚分封四咏 其一","author":"梁斗辉","text":"帝里祥光曙色曦，瑶山高映五云奇。\n少阳已起中天运，万户同欢履泰时。\n合殿春回花绽锦，青宫瑞霭露盈芝。\n遥知齿胄风长在，应有夔龙集凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"册立冠婚分封四咏 其二","author":"梁斗辉","text":"问竖曾闻日几回，龙楼深处正徘徊。\n招贤不藉留侯策，豫教常悬贾谊才。\n鹤驭风清调玉烛，蓂阶气盎接蓬莱。\n微臣更有承华颂，留对君王次第开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"册立冠婚分封四咏 其三","author":"梁斗辉","text":"熙朝燕翼轶成周，元服三加又好逑。\n一自虎闱来翟茀，伫看麟趾叶睢鸠。\n天开社稷千年运，人乐乾坤万古秋。\n为嘱佗时簪珥处，鸡鸣歌后谩淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"册立冠婚分封四咏 其四","author":"梁斗辉","text":"三星历历自分明，光烛薇垣灿玉京。\n天上六龙乘日驭，皇家五凤缀云英。\n器凝宝箓绵周鼎，坐拥雄藩定汉盟。\n百二山河从此壮，好将怀德固维城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崇德书院","author":"郭诗","text":"旧院曾闻鞠草莱，翻从遗搆展新裁。\n衣冠骈集人文廲，礼乐纵横道化回。\n息犬已无苛吏扰，吹藜应有老人来。\n翁山此际端非偶，紫气遥看烛斗台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"受长洲令出都门戏作长歌","author":"邓云霄","text":"从来懒慢喜逍遥，林下闻风欲弃瓢。\n东海肯将龙性扰，北山谁把鹤书招？\n朅来京陌红尘里，奏对明光谒天子。\n骥尾犹随十九人，鹏溟休说三千里。\n一行作吏傍凫飞，此日驱车出帝畿。\n风木哀吟愁捧檄，尘埃世态易沾衣。\n平生疑是劳薪骨，簿领从今终矻矻。\n折腰断不受人怜，强项雄心未全歇。\n丈夫有甑学莱芜，独鹤随行兴不孤。\n物力东南今正竭，谁能鞭扑更催租。\n莫言下吏翻嫌俗，百里郎官高列宿。\n一曲琴清化茧丝，九还丹就骑鸿鹄。\n梦中彩笔去曾携，一片闲心物外栖。\n吴门烟月宜仙令，处处湖山待品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至茂苑","author":"邓云霄","text":"翛然身世两无求，一入尘涂意转幽。\n范蠡芳湖连苑外，虎丘山寺挂城头。\n散衙入夜开芸阁，问俗乘春上野舟。\n莫怪河阳誇傲吏，县门长对百花洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其一 碧梧","author":"邓云霄","text":"炎天庭院午生凉，为有双梧对小堂。\n金并银床邀夜月，彩鸾威凤待朝阳。\n瑶琴曲度龙门险，石鼓声传蜀道长。\n莫向西风惊一叶，疏枝偏不碍秋光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其二 翠竹","author":"邓云霄","text":"长日谁堪领簿书，绕亭苍翠可逃虚。\n清风入榻茶烟罢，疏雨鸣梢午梦馀。\n赋就梁园无俗调，影摇湘水动仙裾。\n主人最爱清狂客，为问王猷肯命车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其三 古柏","author":"邓云霄","text":"秋深霜落满园芜，爱尔亭亭晚节孤。\n黛色浮香如隐麝，苍枝横铁亦栖乌。\n古堂疏豁欹朝枕，小榭阴森换夕垆。\n老友岁寒堪共对，女萝余蔓莫教扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其四 丛兰","author":"邓云霄","text":"楚客香传九畹名，西轩栏槛最留情。\n当门弄色人争妒，幽谷孤芳尔独贞。\n冷翠迎秋襟袖薄，淡妆团露梦魂清。\n同心入室今何在，岁晏怀人别恨生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其五 丹桂","author":"邓云霄","text":"霓裳仙袖暗分丹，冉冉秋香怅独攀。\n霜露可能欺绿叶，神仙长与驻朱颜。\n寻芳有客登中岳，招隐何人继小山。\n遥望故乡森八树，西风流水夜潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其六 黄菊","author":"邓云霄","text":"晚对金尊泛落英，西山爽气入秋明。\n偏怜骨为淩霜瘦，更羡香缘饮露清。\n薄宦几年犹浪迹，故园三径正含情。\n凭君寄谢东篱客，啸傲归来得此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其七 盆鱼","author":"邓云霄","text":"日月曾闻寄一壶，谁云勺水异江湖。\n天光云影含虚镜，碧藻红鳞漾锦铺。\n渔父持竿空伫立，波臣卧辙笑相呼。\n翛然齐物同观化，未辨濠梁乐有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小漆园八咏 其八 湖石","author":"邓云霄","text":"永日求羊不到门，烟霞片石意犹存。\n神鞭驱出洞庭泣，仙子骑来震泽翻。\n幽壑转疑迷竹径，危峰直欲压松轩。\n参禅一悟生公偈，静坐焚香可对言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卧病暮春","author":"邓云霄","text":"经旬休沐拥愁眠，不分残花笑欲然。\n吏俗尚堪呼酒圣，官贫犹得数榆钱。\n惟将案牍供多病，谁把升沉错料天。\n共道出郊人事少，开衙应去课春田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"棕拂子","author":"邓云霄","text":"避暑早扃门，道书行尚把。\n脱巾握棕拂，意态何潇洒。\n非无白羽扇，能使烦襟写。\n无风风乃清，此物较幽雅。\n古人琴无弦，希声不外假。\n繄余悟此理，隐几高梧下。\n地静如清秋，苍蝇胡为者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清风亭","author":"邓云霄","text":"夜来坐虚亭，蘋末微风起。\n金波摇素练，江上月千里。\n何处采莲归，歌声传渌水。\n更有扁舟人，濯足月明里。\n茶烟飞一缕，知是天随子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其一","author":"邓云霄","text":"蜂翅初试黄，豆蔻花渐吐。\n小姑未许人，不敢下堂步。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其二","author":"邓云霄","text":"大嫂唤小姑，踏青南浦去。\n儿夫同一艇，系缆人稀处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其三","author":"邓云霄","text":"前行逐后行，同著锦裲裆。\n弹莺休中燕，打鸭莫惊鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其四","author":"邓云霄","text":"踏青晚醉归，郎醉且休寝。\n上堂问舅姑，挑灯还制锦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其五","author":"邓云霄","text":"竹箔罢春蚕，生丝作夏衫。\n今年家计好，斗草剩宜男。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其六","author":"邓云霄","text":"游子转兰船，调侬曲港边。\n采花先得藕，不受外人莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其七","author":"邓云霄","text":"江上龙舟戏，新妆照碧波。\n隔船呼女伴，举酒酹曹娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其八","author":"邓云霄","text":"欢向临邛去，经年不寄书。\n还及浮瓜节，初看燕乳雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其九","author":"邓云霄","text":"挈枕上高楼，银床凉似水。\n对郎弹箜篌，恐落邻家耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其十","author":"邓云霄","text":"瓜果郎休笑，邻姑共巧筵。\n今宵逢七夕，光景异常年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其十一","author":"邓云霄","text":"摘药裹萤火，应手药先飞。\n妾貌同衰叶，追思嫁日衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其十二","author":"邓云霄","text":"昔日梦辽西，生憎络纬啼。\n欢归秋夜永，不敢怨邻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其十三","author":"邓云霄","text":"应怜夜度娘，动寒往相觅。\n可畏双行缠，已落雪上迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其十四","author":"邓云霄","text":"兽炭拥貂衾，欢情中夜满。\n颇怪芙蓉褥，留得三春暖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其十五","author":"邓云霄","text":"新妆非好淡，本欲学梅花。\n妾异东邻女，墙头盼宋家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时欢歌 其十六","author":"邓云霄","text":"守岁对寒灯，寒暄兹夜隔。\n侬作玉壶冰，愿君如松柏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其一","author":"邓云霄","text":"自君之出矣，缲丝头绪多。\n朝来理蚕箔，不忍见双蛾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其二","author":"邓云霄","text":"妾忆初归日，栽桃碧沼旁。\n君行不觉久，桃树出楼长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其三","author":"邓云霄","text":"步出城南陌，客来乘五马。\n可笑使君愚，调侬绿桑下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其四","author":"邓云霄","text":"暮春朝气和，侬自肝肠热。\n何许最撩人，林间啼百舌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其五","author":"邓云霄","text":"生女有所归，莫嫁吴中估。\n江头望回船，日日多风雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其六","author":"邓云霄","text":"寄语采莲伴，谁知莲苦心。\n齐桡翻弄曲，若个是知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其七","author":"邓云霄","text":"避暑水亭中，紧下葳蕤锁。\n夜短梦难成，日长愁杀我。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其八","author":"邓云霄","text":"少女拜新月，临阶幽意多。\n但祈夫婿贵，不愿似嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其九","author":"邓云霄","text":"家住阊门外，笙歌搅独愁。\n三年空见雁，两鬓易惊秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其十","author":"邓云霄","text":"登楼望阊门，下见倡家女。\n萍荇蔓芙渠，雪深谁采汝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其十一","author":"邓云霄","text":"梦断辽阳戌，心西火共流。\n莫言闺里苦，边塞正防秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其十二","author":"邓云霄","text":"拟作回文句，残机懒更开。\n愁来眠不著，促织夜相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其十三","author":"邓云霄","text":"南雪不到地，著树斗琼花。\n正是可怜色，儿童休打鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其十四","author":"邓云霄","text":"独觞不成醉，独被不禁寒。\n颇怪邻家语，喧喧到夜兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其十五","author":"邓云霄","text":"片心焦若火，两泪滴成冰。\n早晚逢西使，重园在白登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴子夜四时懊歌 其十六","author":"邓云霄","text":"岁去暗须惊，春远似相识。\n梅花在陇头，为我传消息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕携演春乐部过张伯起幼于昆仲园亭把玩腊梅残菊席上同赋三首 其一","author":"邓云霄","text":"江左机云远擅场，华筵法曲并传觞。\n群芳已变繁霜后，空谷犹存晚节香。\n艳骨未随长笛落，幽姿偏藉短篱藏。\n岁寒吾辈能相守，春事何心怪底忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕携演春乐部过张伯起幼于昆仲园亭把玩腊梅残菊席上同赋三首 其二","author":"邓云霄","text":"汉殿迎年催赐衣，幽人犹自把寒枝。\n携来彭泽先生酒，同和扬州水部诗。\n春入池塘惊晓梦，歌翻子夜倚吴儿。\n巡檐欲写东篱意，冉冉孤芳可赠谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕携演春乐部过张伯起幼于昆仲园亭把玩腊梅残菊席上同赋三首 其三","author":"邓云霄","text":"香色凭栏对美人，娇歌妙舞起梁尘。\n谁家彩胜纷矜巧，得似蓬蒿别有春。\n不惜柏尊邀上客，从教琼露湿花神。\n少微夜半光连宿，坐看星回万象新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胥门晚春闲眺","author":"邓云霄","text":"胥江春浪迭平沙，野水浮来尽落花。\n遥望片帆归别浦，不知双燕入谁家。\n孤村斜日收渔网，远寺残钟起暮鸦。\n试问城中歌舞地，何如此处最清嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝带桥夜泊玩月二首 其一","author":"邓云霄","text":"长桥十里卧晴虹，吴会山川在镜中。\n岂有神鞭驱海石，遥听仙佩下琼宫。\n双星寄恨三天水，半夜怀人一笛风。\n此去沧洲知远近，且将孤舫狎渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝带桥夜泊玩月二首 其二","author":"邓云霄","text":"潮归月落夜渐分，人语空江隔岸闻。\n化鹤道士不入梦，弄珠神女能为云。\n天上白榆侵桂树，枝间干鹊随鸦群。\n秋近骚人无限意，乘流东下吊湘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和申瑶翁咏物十四首 其一 竹粉","author":"邓云霄","text":"万竿晴拂渭川烟，解琼箨枝自皛然。\n湘水裙摇珠佩冷，葛陂云护玉龙眠。\n看来翻恨何郎妒，栽处应将汉署连。\n六月林间犹带雪，可留清韵待群贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和申瑶翁咏物十四首 其二 松涛","author":"邓云霄","text":"龙鳞蹙沓起狂飙，虎啸空山动泬㵳。\n万树忽飞秦帝雨，千岩遥涌浙江潮。\n徂徕欲驾神鳌去，精卫宁衔大木飘。\n澎湃寒声催作赋，八乘雄笔未须骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和申瑶翁咏物十四首 其三 花影","author":"邓云霄","text":"瑶台仙态自重重，色相元来未是空。\n暂试新妆临晓镜，更怜残照倚东风。\n洛神解佩淩波上，巫女行云度峡中。\n几向雕兰频想像，蛾眉偏爱月如弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]