[{"title":"木哀十首 其四","author":"李江","text":"仙圃岁寒瑞草凋，眼中恍惚梦中遥。\n天香不幸西风落，国色空教月夜描。\n神绕昆崙伤未返，魂飞弱水竟何招。\n人生于此真无奈，仙圃岁寒瑞草凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其五","author":"李江","text":"寒松晚月夜深深，喜带丝萝几万寻。\n一日松萝成幻梦，百年夫妇自伤心。\n齐眉案下人归古，好合琴中韵不今。\n欲煮鸾胶酬所愿，寒松晚月夜深深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其六","author":"李江","text":"绿竹春阴带雨愁，霏微点滴到心头。\n东山遮断黄昏晚，南海遥惊古木秋。\n鸾凤分飞菱影冷，鸳鸯失队枕前休。\n伤情独倚西窗下，绿竹春阴带雨愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其七","author":"李江","text":"雨滴孤桐夜半时，秋风叶落恨离离。\n心藏金井一泓水，性托瑶琴三尺丝。\n彩凤高枝痕带泪，峄阳寒谷路空悲。\n睡来不着惊残梦，雨滴孤桐夜半时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其八","author":"李江","text":"烟笼弱柳淡飞寒，隔断秋江漾碧澜。\n月落夜空心自苦，风残天老梦还单。\n不如道蕴曾何愧，也似孟光久已安。\n今夕何期成千古，烟笼弱柳淡飞寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其九","author":"李江","text":"山空月冷雨飘零，到老姻缘一息停。\n连理枝头花寂寂，舞鸾镜里影冥冥。\n杜鹃啼处魂何在，蝴蝶飞时梦不醒。\n愁杀人生不如愿，山空月冷雨飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木哀十首 其十","author":"李江","text":"叶落风酸可怆神，青天何事误乎人。\n潮虽消后犹还长，叶到秋来尚再春。\n斜谷铃声寒雨湿，昭阳山色暮云湮。\n遮魂不有芦生叶，叶落风酸可怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其一","author":"李江","text":"鹃声哭月夜寥寥，魂逐飞仙不可招。\n花落西风悲阆苑，烟迷芳草断蓝桥。\n糟糠人去丝麻冷，缘分天亡梦寐消。\n昨日曾过白猿洞，鹃声哭月夜寥寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其二","author":"李江","text":"蝶梦迷春自怨春，花前何处觅精神。\n七弦指下清音断，一纸缄中紫墨新。\n茶灶未消今日火，糟糠不见旧时人。\n衾寒枕冷西窗下，蝶梦迷春自怨春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其三","author":"李江","text":"鸾影分飞镜里虚，彼苍于此意何如。\n福缘不计千多岁，命分空教十八馀。\n恍惚音容疑似昨，悽凉心事恨难除。\n西风落月堪流涕，鸾影分飞镜里虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其四","author":"李江","text":"鹤声怨惨九天遥，肠断夫君失偶朝。\n帐底寒生人梦远，枕边夜落泪痕憔。\n寿山不尽千年久，福海无涯一夜消。\n独倚西风惆怅处，鹤声怨惨九天遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其五","author":"李江","text":"梁燕当秋竟远离，庭前帘外月生悲。\n执巾执栉无违处，田尾田头有梦时。\n夫妇本同天地老，室家宜与海山期。\n年来非谓无春色，梁燕当秋竟远离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其六","author":"李江","text":"海雁叫云海月寒，凄凉南北夜漫漫。\n眼枯海屋仙筹止，月落嫦娥桂影单。\n地已荒时天未老，鸾今分处凤何欢。\n夜来一阵西风起，海雁叫云海月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其七","author":"李江","text":"荻塘古岸水空流，月落波沉白露愁。\n羽化空教归紫府，精灵长望照丹邱。\n桐音寂寂风中断，菱影青青水外秋。\n云尽天南驾不返，荻塘古岸水空流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其八","author":"李江","text":"玉潭秋水静波澜，秋影潭心天地闲。\n玉女峰头云杳杳，银河桥下水潺潺。\n人间莫道无贤妇，世上堪怜有鬼关。\n子母恩深深未了，玉潭秋水静波澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其九","author":"李江","text":"鸳鸯斜晖水一围，双双同宿亦同飞。\n今朝镜里临风别，何日花前带月归。\n宿世几时重好合，老天何事与心违。\n嗟嗟独向寒潭立，鸳鸯斜晖水一围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤哀十首 其十","author":"李江","text":"鸠啼春暮雨晴时，月下声中听自悲。\n结发只应成好合，断弦今已误佳期。\n女工针指宁甘拙，妇道操持颇有宜。\n安得今朝不相忆，鸠啼春暮雨晴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其一","author":"李江","text":"巴峡猿啼泪几行，随风点点滴心伤。\n偶炊无釜梦千里，谁续断弦琴一张。\n月挂西山人不见，云横弱水恨何长。\n今朝罢却前生事，巴峡猿啼泪几行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其二","author":"李江","text":"衡阳断雁碧峰青，天远山空月自明。\n书信自从今日尽，天缘有分几时成。\n闺门妇道能无忝，云路夫君喜有名。\n望眼愈长心愈苦，衡阳断雁碧峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其三","author":"李江","text":"龟游长江不再回，空悲天地古今来。\n千年万载成虚语，再世还魂亦可猜。\n香断芝兰风雨恶，音消琴瑟水山哀。\n当年只把龟为寿，龟游长江不再回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其四","author":"李江","text":"马嘶芳草路何长，万里腾云只自伤。\n天子门生知有分，细君年几未应亡。\n堂前甘旨须供奉，壶内纲常赖主张。\n行李春风原是客，马嘶芳草路何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其五","author":"李江","text":"玉兔云中捣药声，寒云捣尽月空明。\n仙风吹断三千里，紫府遥连一万程。\n欲问当年为月老，何知今日失云英。\n夜长天远思无尽，玉兔云中捣药声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其六","author":"李江","text":"金鱼比目物皆然，何事姻缘无百年。\n夫妇有情如愿久，室家无幸亦天偏。\n桃花落尽青犹再，桂影亏时望复圆。\n惆怅人生不如物，金鱼比目物皆然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其七","author":"李江","text":"豹枕惊寒梦不成，春风帐底可伤情。\n鸳鸯水暖期双老，鸾凤声沈隔五更。\n中馈乏人诚落魄，幼儿无母甚孤?。\n今人遭此真无奈，豹枕惊寒梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其八","author":"李江","text":"鹿车遗迹夜沉沉，抛妇分明一点心。\n缘分有天应到底，佳期无奈止于今。\n女牛天上年年见，兰桂人间夜夜深。\n有恨尽从归肺腑，鹿车遗迹夜沉沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其九","author":"李江","text":"黄鹤楼中云自移，不知黄鹤欲何之。\n一杯合卺昏中酒，九步佳城望处思。\n二月桃花思旧日，七弦琴韵失前时。\n一朝倾下东风泪，黄鹤楼中云自移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟哀十首 其十","author":"李江","text":"华表千秋一柱高，佳期音断北风号。\n思量人世真如梦，那见神仙果伐毛。\n百岁姻缘谁不愿，终身家计却空牢。\n天长地久来今古，华表千秋一柱高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其一","author":"李江","text":"旸谷寒生曙色明，扶桑千丈露元精。\n天光正对闺门照，晓影空浮枕簟清。\n妯娌有情思旧语，鬼神何事夺前生。\n小窗恍惚如相见，阳谷寒生曙色明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其二","author":"李江","text":"古木重阴偶蔽时，回头百事与前移。\n西风吹断游仙梦，细雨寒生失偶思。\n称寿笑携鹦鹉盏，栖身盟共凤凰枝。\n一场春梦知何处，古木重阴偶蔽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其三","author":"李江","text":"列缺光芒五夜中，英魂缥缈梦何穷。\n夫君客路燕京北，荆妇闺门丽水东。\n笑语化成为血泪，恩情藏却在心胸。\n天荒地老无穷处，列缺光芒五夜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其四","author":"李江","text":"归墟漫衍自冲愁，冲破愁肠不尽头。\n一寸心田归壤土，百年福海付波流。\n枕前春梦鸳闱薄，镜里仪形凤帐收。\n为想金陵风乍起，归墟漫衍自冲愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其五","author":"李江","text":"太耀灵光似晔征，人亡愁尽似无情。\n虽云夸父能追影，却恐麻姑亦虚生。\n比翼已惊成梦古，闻猿空抱断肠声。\n看来只有天无尽，太耀灵光似晔征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其六","author":"李江","text":"丰隆先导欲何之，九土茫茫竟远离。\n一子学行还泣乳，两瞳无主动心悲。\n空教月殿飞仙处，也感僯家辍社时。\n沧海不枯山不烂，丰隆先导欲何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其七","author":"李江","text":"太乙空空寂寂时，倚门何望转来期。\n家贫款客宜炊黍，月落馀灯尚抽丝。\n谁料南山犹有尽，那知东海亦将移。\n几回问天天无对，太乙空空寂寂时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其八","author":"李江","text":"旬始晞微光景消，金陵燕市路迢迢。\n魂归九土蓬莱杳，神入千峰翠水遥。\n中馈朝来思未断，德宫人去梦难招。\n百年恩义何曾了，旬始晞微光景消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其九","author":"李江","text":"丹邱日月景长明，却恨人间了此生。\n荀爽有言难再得，周庄何处动歌声。\n失鸾镜里秋风薄，舞蝶花前晓梦惊。\n果有天堂当荐汝，丹邱日月景长明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东王公哀十首 其十","author":"李江","text":"佳城郁郁万青山，欲种松楸绕墓间。\n不老有春疑似梦，长生无虑却忘还。\n清风动处盆歌罢，明月低时婺影閒。\n从此别离竟千古，佳城郁郁万青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其一","author":"李江","text":"瑶池月落暗西天，风满西天泪满前。\n王母楼前花失影，麻姑洞远夜如年。\n云飞杳霭长生景，月朗逍遥不老仙。\n千古相思在何处，瑶池月落暗西天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其二","author":"李江","text":"翠水烟笼万里程，跨鸾飞去不归宁。\n千年风景虽云乐，一段姻缘恨未成。\n何处寒炉呼嫂嫂，当年谐老仰卿卿。\n而今却与夫君别，翠水烟笼万里程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其三","author":"李江","text":"飞泉微液听无声，点点遥惊泪欲倾。\n阆苑仙风人似玉，广寒清府雪如琼。\n暮云锁断尘缘梦，野水流还织纴情。\n此恨绵绵终莫尽，飞泉微液听无声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其四","author":"李江","text":"寒门月落绝垠空，俯仰情深恨不穷。\n仙圃虚教瑶草绿，玉栏空见碧桃红。\n容工今已皆身后，言德偏惊在梦中。\n锦瑟调和音已别，寒门月落绝垠空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其五","author":"李江","text":"弱水寒流自古今，飙轮西荡影沉沉。\n闺门不斗梳妆巧，荆布空留纺绩心。\n百子春风前日帐，七弦夜月旧时琴。\n可知只有蓬山上，弱水寒流自古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其六","author":"李江","text":"金乌返照水中天，梦里音容掩映前。\n女德可拈银管写，妇工应在綵楼传。\n六经勤读言犹耳，二姓和谐分有缘。\n好事都成一场梦，金乌返照水中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其七","author":"李江","text":"湘灵漂荡不归来，风急云飞孰可催。\n梅熟及时今已梦，桃天宜室转成哀。\n凤凰枝上栖应稳，孔雀屏中望几回。\n九土又深天又远，湘灵漂荡不归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其八","author":"李江","text":"月殿清虚夜独游，离亲抛子可无忧。\n看来好事皆虚事，从此千秋及万秋。\n结发恩情云已远，与心齐愿水空流。\n如今弃却人间去，月殿清虚夜独游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其九","author":"李江","text":"一别千秋路两分，令人伉俪重层云。\n身名虽死犹非死，形迹无文自有文。\n长夜台中知所息，黄金曾纳已无闻。\n荣华富贵无忘尔，一别千秋路两分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西王母哀十首 其十","author":"李江","text":"原始要终岂足怜，委诸理数为能全。\n福该所有皆该分，寿不相应自不天。\n借语发挥泉壤德，遗言留与子孙传。\n脩身俟死夫何义，原始要终岂足怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游薛公岩","author":"李江","text":"学得逍遥半日閒，层岩万仞我来扳。\n寻诗自有眼前句，着足更无头顶山。\n阆苑移来天外处，蓬莱飞入洞中间。\n山灵知道书生意，袖拂青云马上还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题观音阁","author":"李江","text":"踏上观音阁上来，一声长啸鬼神哀。\n花花笑我遨游客，朵朵迎人满树开。\n野鸟不须闲弄舌，山灵犹畏俊英才。\n于今一望无穷处，眼底长江水半杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上题黄莺","author":"李江","text":"满眼柔香嫩绿时，东风和雨柳丝丝。\n一梭便是经纶术，半舌还应律吕奇。\n振翅出于幽谷处，着身飞上打头枝。\n平生不爱多言语，一叫春风天下知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题鬼火","author":"李江","text":"万虑天然夜气清，虚窗人静梦初醒。\n三更曙色上梁栋，一点珠光夺日星。\n乍骇枕衾连北斗，还疑奎壁入中庭。\n想必书债还未了，太乙真人烧杖灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔","author":"李江","text":"一个蓑衣一个裘，老于江湖一孤舟。\n沙深水浅傍岩宿，月白风清吹笛游。\n数罟任从天外撒，连鳌还是手中谋。\n瀛洲若问家何在，閒傲烟霞笑五侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"樵","author":"李江","text":"万虑纷纷了不干，生涯哨指白云端。\n昆崙已远樵无及，泰岳虽高采未难。\n挑月往还真似苦，戴星出入也如官。\n秦关燕壁秋风乱，一束还堪为煮丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"耕","author":"李江","text":"村头播谷唤声频，催起山中三月春。\n半亩何时辛苦了，荒田岂为责征宽。\n耒驱莘野云初起，龙卧南阳脚未伸。\n千里长安人走马，山花笑杀垄头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牧","author":"李江","text":"倒骑牛背日晴晖，撩弄清风过垄时。\n蓑笠萧条随野乐，梅花嘹喨倚云吹。\n桃林千队还须我，秦国五羊更有谁。\n莫道有人不知子，有人知子子何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊堂兄丧","author":"李江","text":"乔木颠抛第一枝，撑持门户又阿谁。\n买田屋下春长在，打睡窗前月自移。\n黄卷我成三十弟，彩衣尔是五旬儿。\n云过丽水酸风起，鸿雁一声天地悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得子自忻","author":"李江","text":"十年辛苦九年灯，三十春光四十零。\n兄弟情因添侄喜，椿萱心为得孙宁。\n肯愁家里无千顷，自感床头有一经。\n尊酒相逢须尽醉，眼中天地自分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺人得子","author":"李江","text":"万事称心一不忧，诗书欣喜为吟搜。\n熊罴夙愿应如梦，姜酒春斟不计筹。\n赵氏箕裘京日月，丽山风土应公侯。\n年少爱尔登科早，莫学挨来我度秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"求宿韩京对村妇作限令易解","author":"李江","text":"早早梳头赶路程，赶程不到宿韩京。\n相逢妇子无见识，推我书生出外亭。\n世上无人担屋卖，从来男不带家行。\n汝夫亦是江湖客，也在山中歇不曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺伯祖母暨厥耄堂叔寿 其一","author":"李江","text":"何处笙歌闹耳边，丽洞廷寿设华筵。\n宝炉香动箕和斗，海屋筹添百又千。\n群列孙英绳羽咏，一贞乾德衍瓜绵。\n四朝萱绿廷荆茂，代舞班斓绕膝前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺伯祖母暨厥耄堂叔寿 其二","author":"李江","text":"南老光临紫水边，香浮炬彻设斋筵。\n一筐蘋藻无岐两，翻诵菩提已数千。\n玄昊钟灵应未讫，崦嵫宣景祝更绵。\n枝根共脉相传递，选择蟠桃贡叟前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其一 春日偶成","author":"李江","text":"霁月光风别一天，春融和意满晴川。\n梦中端拜程夫子，识破繁华觉晚年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其二 春日","author":"李江","text":"自觉融和老海滨，寻花玩景药阑新。\n村前出带雨寒润，一路东风一点春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其三 春宵","author":"李江","text":"春满花枝碎弄金，新红嫩绿已成阴。\n如今一刻非容易，只怕星移漏欲沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和千家诗六十首 其四 城东早春","author":"李江","text":"八月梅春便有春，况于花锦一般匀。\n不堪吟笑东城过，得似尧夫有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":55144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]