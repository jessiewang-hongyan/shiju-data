[{"title":"送赵叔鸣视学山东","author":"何景明","text":"尔道东行日，斯文北学传。\n凤凰千仞上，騕袅万金前。\n岳峙高无极，沧流渺百川。\n古来齐鲁地，风教育遗编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侯汝立之东昌","author":"何景明","text":"东郡疮痍日，苍生属此行。\n二毛犹未见，五马亦为荣。\n月对河关上，秋从海岳生。\n向来嵩少约，西望各悬情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送士侄归雀巢县","author":"何景明","text":"见汝南归日，令予北倚楼。\n彩衣花县酒，白雁楚江洲。\n闭户自兹始，佩韦须古求。\n行藏愧汝叔，日忆竹林游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭外舅之江阴","author":"何景明","text":"郭舅佐名邑，出门怜女甥。\n春风到江县，花下早鸣莺。\n听讼琴堂静，哦诗竹槛成。\n临行赠玉佩，空有渭阳情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘西曹决狱畿内","author":"何景明","text":"日下秋官出，天边汉使分。\n令行乘肃杀，风覃藉仁闻。\n香署含清旭，仙闱上白云。\n垆薰亦暂别，遥想昼氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡别驾出关","author":"何景明","text":"天上黄华戍，云边铁壁城。\n风沙行塞日，金鼓出关情。\n转饷留萧相，挥鞭让祖生。\n军储西北计，从此树勋名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送毛汝厉按湖南","author":"何景明","text":"腊送燕门节，春迎楚水艭。\n扬帆泛广汉，击楫渡长江。\n地络蛮荆域，天躔翼轸邦。\n此行君不忝，才气本无双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王梦弼之高邮","author":"何景明","text":"南窜随春色，东行识壮颜。\n闾阎犹涕泪，道路复追攀。\n风节云霄上，霜威海岱间。\n圣明怜万里，不久赐君还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送望之赴汶上二首 其一","author":"何景明","text":"相送一如昔，出关行复留。\n初看万里至，忽是五年流。\n老骏从东路，春鸿向北州。\n青门数行柳，烟色暮含愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送望之赴汶上二首 其二","author":"何景明","text":"春郊馀雪日，河甸起风沙。\n送折燕中柳，行逢汶上花。\n宾朋半海内，弟妹各天涯。\n驻马临岐处，飘飘独望家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客二首 其一","author":"何景明","text":"方岳从来重，君才世岂多。\n中原虽寇盗，晋国有山河。\n劝俗销金甲，求贤访碧萝。\n政平人自理，不用事烦苛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客二首 其二","author":"何景明","text":"海内苍生困，看君紫绶新。\n天官元贵客，岳伯是词人。\n云极行山目，花伤冀北神。\n平生胶漆意，翻恐愧雷陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送葛时秀任东明","author":"何景明","text":"东明花满县，令宰即神仙。\n宓子今为政，河阳复壮年。\n隼?开雨雪，凫舄向云天。\n何地传消息，相闻在日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆子楼饯祖邦","author":"何景明","text":"渺渺枫江阔，高楼望转伤。\n同来送归客，予亦念还乡。\n塞接寒天迥，城衔落景长。\n重逢是何日，尺素莫相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白将军征南兼寿母","author":"何景明","text":"将军天上出，万里拥舟航。\n玉帐驻南国，金尊开北堂。\n海云添宠色，江日借恩光。\n报主身何壮，犹牵寸草肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱推府之闽","author":"何景明","text":"越水到闽乡，风帆万里航。\n云间开瘴疠，山雨暗桄榔。\n器本中丞后，才仍佐郡郎。\n燕京把剑别，此去有辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送施御史便道寿母次韵","author":"何景明","text":"绣衣真昼锦，彩服更花辰。\n海鹤称觞数，江鱼入馔新。\n近欢追里宴，遥祝借朝绅。\n堂下忘忧草，今春倍往春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王举人","author":"何景明","text":"王子万人英，诗名少日成。\n骊珠眠自抱，天马傍谁行。\n旅食青枫改，秋吟素发生。\n过逢见汝意，潦倒愧吾情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管汝济","author":"何景明","text":"冠裳同海内，杯酒对寒宵。\n旧识三秦客，今看万仞标。\n芙蓉生露掌，騕袅在烟霄。\n愿听云门奏，春风入凤箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠权僧过昌化寺见访次韵","author":"何景明","text":"问尔湖边寺，微钟翠巘西。\n千岩一径转，落日乱藤迷。\n数见谈天竺，相从过虎溪。\n山中送客罢，独礼白云低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吕道夫转右给事","author":"何景明","text":"右掖言司旧，重题御陛名。\n碧霄通汉苑，丹地接秋城。\n报主褰龙衮，惊人想凤鸣。\n怀中一谏草，何日为苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吕子迁左给事中","author":"何景明","text":"月明鳷鹊观，日丽凤凰城。\n自昔飞腾入，今看草奏行。\n衔沙填海志，鍊石补天情。\n无限乾坤事，非因万古名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郑佐","author":"何景明","text":"老郑空同客，长歌北海尊。\n十年旧宾友，谁到李邕门。\n天地频回首，江湖一旅魂。\n关城独归雁，风色傍黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"君采迁居","author":"何景明","text":"宅卜宫墙近，堂开燕雀驯。\n迁居怜客次，过觅喜吾邻。\n题竹元因主，看花更属春。\n知悬孺子榻，虚薄愧高人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠时亮","author":"何景明","text":"象郡开梅岭，罗池傍柳州。\n山川盘秀地，文物迥风流。\n丹就还珠洞，书藏驾鹤楼。\n风尘望尔去，霄汉独相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺汝济生子","author":"何景明","text":"夜夜生兰梦，年年种玉心。\n充闾看气色，入户试啼音。\n明月含珠浦，高枝发桂林。\n北堂书报日，何啻万黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠董侍御","author":"何景明","text":"何处采芳蘋，维舟湘水滨。\n草间露彩薄，沙上月华新。\n杳杳侵滇路，依依向楚人。\n汀花不寄远，惆怅独逢春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘东之宪副","author":"何景明","text":"浮生能几见，孰谓别离轻。\n远道惟长剑，寒宵共短檠。\n旌旗临汉水，雨雪度秦城。\n乡井衣冠少，分携益怆情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过寺中饮赠张元德侍御","author":"何景明","text":"竹林清宴集，秋夜剧呼卢。\n即席花偏艳，开尊月不孤。\n君为淮海俊，我乃洛阳徒。\n腰下金龟在，明朝付酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夜寺中集","author":"何景明","text":"火树连能苑，烟花绕鹫峰。\n词人高宴会，令节喜过逢。\n阁度银河上，窗含宝月重。\n九衢风起夜，处处有歌钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集赠吕仲木","author":"何景明","text":"石室抽书旧，金门待诏来。\n官勋三载见，客抱此宵开。\n刘向本经术，马迁真史才。\n斯文久寥落，望子早登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王子","author":"何景明","text":"王子万夫特，英风千仞馀。\n未投湘水赋，曾上汉庭书。\n日月方前席，江湖漫卜居。\n城南相觅处，花暮独回车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡户部父母同受封命","author":"何景明","text":"紫诰开天府，瑶函照楚乡。\n白头偕二老，綵服有诸郎。\n草动春江色，花携汉署香。\n夜来望南斗，万里益光芒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠祖邦","author":"何景明","text":"白下通缄少，燕都见面迟。\n客心悲岁晚，归路及春时。\n姓入山公启，人传水部诗。\n同年吾不及，相望赴前期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴逸士","author":"何景明","text":"逸士古豪士，剑歌出燕关。\n不博邯郸市，常游五陵间。\n宾客重然诺，公卿多往还。\n千金何足贵，义气高如山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕怀曹毅之","author":"何景明","text":"百卉飘零尽，孤鸿何处归。\n高楼横暮笛，万户捣寒衣。\n南国江湖远，佳人尺素稀。\n独愁谁与晤，明月鉴重帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀望之姊夫","author":"何景明","text":"自尔出门去，天时十月催。\n如何千里外，不见一书来。\n远峤寒云起，高城旅雁哀。\n乡园莫久滞，星驾及春回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀姊","author":"何景明","text":"逐子东归日，輶轩惜路岐。\n那堪骨肉泪，洒向别离时。\n旅病秋来减，乡书岁暮迟。\n庭闱欣见汝，千里重予思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀三兄","author":"何景明","text":"轺车北上日，相送及燕州。\n为客全经夏，还家已过秋。\n鹡鸰寒更急，鸿雁晚相求。\n况是诸兄隔，天涯重倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子纯宅夜集怀望之","author":"何景明","text":"花月同游客，江湘万里遥。\n燕閒如我辈，杯酒又今宵。\n转觉花愁思，翻教月寂寥。\n无论去与住，俱是断蓬飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀刘园诸友","author":"何景明","text":"亭榭刘园丽，携游汝辈频。\n竹高停翠袖，花密隐朱唇。\n桥是经行地，城馀战斗尘。\n京华又二载，肠断楚乡春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过子容有怀献吉","author":"何景明","text":"故友何人在，常时独尔游。\n停杯思北海，跃马为南州。\n雨助鸣蛩夕，风惊过雁秋。\n有怀俱不减，携手重迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀李生园柬季升","author":"何景明","text":"李生北园内，亭榭近如何。\n草径犹红药，柴扉自碧萝。\n江湖归路少，天地战场多。\n空忆张夫子，清尊夜夜过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪简川甫","author":"何景明","text":"一雪数花集，空庭寒起迟。\n微风罢弱舞，初日尚馀姿。\n自抱朱弦瑟，谁看玉树枝。\n仙曹有高倡，不送凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄任司训","author":"何景明","text":"不见任公子，飘飘旅客魂。\n苦吟惟白发，生计有清尊。\n散吏真兼隐，荒城不异村。\n人间好事者，谁到广文门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日寄望之汶上","author":"何景明","text":"至日怀亲友，题书在帝乡。\n风云馀岁色，梅柳复年芳。\n白发行藏里，清尊涕激傍。\n思君鲁城北，汶水日汤汤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简以道","author":"何景明","text":"久雨文园客，风流汉长卿。\n苦吟生白发，消渴望金茎。\n雪盛黄精草，云深赤石英。\n早寻方外士，服食使身轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄空同子卜居襄阳","author":"何景明","text":"尔定襄阳宅，云山好傍谁。\n草怜王粲井，花醉习家池。\n留滞悲江汉，驱驰感岁时。\n扁舟空怅望，未有鹿门期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪简郑客","author":"何景明","text":"燕雪未成花，萧萧覆浅沙。\n误听梁苑竹，拟放楚江槎。\n集霰含风色，流云转日华。\n城中百万户，歌舞醉谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄钱水部","author":"何景明","text":"多情钱水部，别后有哀吟。\n万里秋风兴，孤舟日暮心。\n白沙宫舍迥，沧海故园深。\n怅望佳期隔，殷勤数寄音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王文熙","author":"何景明","text":"之子南归日，江湖泪泫然。\n凉风一夕至，秋月几回圆。\n鸿雁求巢急，雕鹏各自迁。\n三年望天末，徒有寸心悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄顾华玉","author":"何景明","text":"词客金陵去，那期岁屡过。\n相思秋水隔，怅望暮云多。\n清庙朱弦瑟，华堂白纻歌。\n徽音久寂寞，高调近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简都玄敬","author":"何景明","text":"故友日零落，都君情不忘。\n草玄常避客，头白近为郎。\n宦况思江上，乡心望海傍。\n闻君话山水，吾亦慕南方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄徐太守","author":"何景明","text":"塞雁去复尽，燕台愁望春。\n十年同病客，万里各风尘。\n南国已碧草，清江空白蘋。\n秋来有词赋，莫使怨骚人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阁内简张员外","author":"何景明","text":"我在金门里，闻君候琐闱。\n去天俱咫尺，瞻日共光辉。\n柳下宫官出，花边阁吏稀。\n晚来沙苑外，骑马欲同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寺中斋居简崔内翰张侍御","author":"何景明","text":"径雪草生细，林寒莺到稀。\n伤春怀二子，斋沐掩禅扉。\n石室栖金马，天花落绣衣。\n分明共朝市，鹓鹭不同飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜望之量移兼寄","author":"何景明","text":"岭海投荒日，燕台望远时。\n三年一消息，万里转相思。\n归雁先知暖，惊乌尚绕枝。\n湘江催发棹，预报北来期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋日寄粹夫","author":"何景明","text":"一叶悲天地，秋风泪万行。\n江河无日夜，边塞有烟霜。\n雁鹄思高起，龙蛇愿久藏。\n蓬瀛何处涉，头白恨无梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家书","author":"何景明","text":"一返滇中使，重嗟故里违。\n老亲遥在念，薄禄未能归。\n雨雪三冬暗，家书累月稀。\n激缄灯下发，回雁隔云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾出","author":"何景明","text":"九重玄武仗，万岁羽林军。\n朝帝乘舆出，行天警跸闻。\n螭头蟠晓日，雉尾拂春云。\n伫望南郊气，遥连北斗文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾幸南海子","author":"何景明","text":"铙音发桂畤，春狩践兰区。\n水尽缇城合，山回帐殿孤。\n公卿随八骏，虎旅备三驱。\n如闻后车载，倘遇渭川夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾入","author":"何景明","text":"地转瑶坛迥，天回翠辇高。\n入城传鼓吹，开殿引旌旄。\n佩委春池草，盘行上苑桃。\n九天灯烛里，齐拜衮龙袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庆成宴","author":"何景明","text":"汉主汾游日，周王镐宴时。\n礼成天地协，乐奏凤凰仪。\n上殿承天语，登筵拜帝釐。\n载歌天保颂，还称既醉诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇陵","author":"何景明","text":"陵阙皇灵閟，山河王气遥。\n万年龙虎抱，每夜鬼神朝。\n玉碗留天地，金灯照寂寥。\n如看翠华度，缥缈在青霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"内直","author":"何景明","text":"阁院雨晴初，微风动绮疏。\n凤池通紫极，云阙过清虚。\n衮职闻封事，军情见捷书。\n非才叨侍从，徒望五云车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入直","author":"何景明","text":"赋岂文园客，名惭骑省郎。\n闻鸡趋建礼，驻马望宫墙。\n风昼杨花色，烟春蕙草香。\n露盘天汉上，消渴意何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚出左掖","author":"何景明","text":"洞门馀积雪，御苑覆高霞。\n吏散层霄上，城行五凤斜。\n青回初霁柳，红动峭寒花。\n立马清沙外，空林集暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和严太史谒泰陵三首 其一","author":"何景明","text":"敬皇十八载，四海一何安。\n鼎成弃万国，弓堕哭千官。\n白日园陵閟，秋云松柏寒。\n龙游万岁后，寂寞葬衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和严太史谒泰陵三首 其二","author":"何景明","text":"世切如云望，天摧格帝功。\n弥留念诸将，顾命托三公。\n玉几星辰上，玄宫霜露中。\n松楸恸哭地，白日起悲风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和严太史谒泰陵三首 其三","author":"何景明","text":"夜壑霜钟杳，秋岑玉殿扃。\n穗帷风淅淅，银海月冥冥。\n象卫朝群帝，龙藏扈百灵。\n临门日呼召，天语旧臣聆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬郭内翰上陵还诗","author":"何景明","text":"帝遣朝陵日，暂辞供奉班。\n楸梧开玉殿，云雾宿春山。\n晚向松间散，晴从花下还。\n知君有佳句，传和五陵间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]