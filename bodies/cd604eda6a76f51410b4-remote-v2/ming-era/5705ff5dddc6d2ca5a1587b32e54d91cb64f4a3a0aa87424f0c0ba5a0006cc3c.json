[{"title":"秋日卧病瀫元显卿厚之皞民过访 其一","author":"胡应麟","text":"老病秋来话息机，满阶梧叶梦魂飞。\n亦知极乐华胥界，无奈西风撼竹扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日卧病瀫元显卿厚之皞民过访 其二","author":"胡应麟","text":"十年消渴梦魂摇，驴背风烟又灞桥。\n玉露金茎何处问，汉宫秋色正岧峣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其一","author":"胡应麟","text":"三十年来击筑场，白头相对又河梁。\n双龙莫讶经离合，满目飞云是太行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其二","author":"胡应麟","text":"乱云残叶晚凄凄，挥手长安日渐低。\n眼底只今饶醉尉，不烦追送灞桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其三","author":"胡应麟","text":"君向青门话种瓜，余归亦卧武陵花。\n扁舟后夜堪乘兴，雪满山阴十万家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其四","author":"胡应麟","text":"千里行歌出蓟门，何年同住杏花村。\n衰杨古驲卢沟道，歌到骊驹各断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其五","author":"胡应麟","text":"十载青萍赋浪游，萧萧羸马塞门秋。\n那堪茅店鸡声夜，落月梁间梦李侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其六","author":"胡应麟","text":"日夜西风起潞津，余归君住总伤神。\n相看脉脉燕台上，地北天南两病身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其七","author":"胡应麟","text":"易水燕山半草莱，萧萧风色暮偏哀。\n悲歌屠狗凋零尽，无赖黄金百尺台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其八","author":"胡应麟","text":"玉河流水暮潺潺，行李西风出乱山。\n一路相思秋色里，孤云何处秣陵关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其九","author":"胡应麟","text":"极目天南雁鹜群，荷衣深入五湖云。\n华阳碣石当年事，憔悴西风不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟寅十绝句 其十","author":"胡应麟","text":"十万貔貅罢枕戈，中山无奈谤书多。\n祇今铜柱留遗迹，谁见当时马伏波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬李汝藩四首 其一","author":"胡应麟","text":"万斛鲸波大海头，扶桑东指乱云愁。\n玉门生入殊堪乐，莫羡当年定远侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬李汝藩四首 其二","author":"胡应麟","text":"憔悴东还泣数奇，亲闱南国倚闾时。\n谁言敬仲操戈怯，剩有交游鲍叔知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬李汝藩四首 其三","author":"胡应麟","text":"归来无恙旧楼船，赢得鸡林字字传。\n不是王阳难九折，千山云色太行前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬李汝藩四首 其四","author":"胡应麟","text":"不解征衫客异邦，兴阑初返木兰艭。\n东游可道风波恶，题遍新诗鸭绿江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巧巧素素皆薛生名也而字特未称余与行父定议曰瑶英庶于二名不偏亦以古有兹字也","author":"胡应麟","text":"翩翩长袖越罗轻，玉骨冰肌照眼明。\n莫道元家人已去，千秋重睹薛瑶英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滕观察先生招游湖上藩臬诸公咸集命余赋诗","author":"胡应麟","text":"弱水盈盈一望中，群仙环佩起天风。\n青霄尽敛浮云色，紫气遥临大海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题大雅堂七首 其一","author":"胡应麟","text":"十尺荆榛峡口涛，千年遗搆蜀云高。\n堂成莫话幽忧事，列座王杨尽彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题大雅堂七首 其二","author":"胡应麟","text":"半壁天南八咏楼，阳春今在瀫溪头。\n华堂肯借抽毫客，五夜如椽拂斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题大雅堂七首 其三","author":"胡应麟","text":"千树桃花送夕阳，莫愁家住石城傍。\n从今再睹清商调，绝胜当年白玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题大雅堂七首 其四","author":"胡应麟","text":"灵隐高僧卧佛庐，参军亦傍紫薇居。\n丹梯莫话卢敖杖，三百篇成奏玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题大雅堂七首 其五","author":"胡应麟","text":"清川如玉抱前村，处士当年旧荜门。\n破屋数间君莫笑，千秋大厦有云孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题大雅堂七首 其六","author":"胡应麟","text":"珠箔银屏赋浪裁，美人何处问瑶台。\n郁金堂上双栖燕，妒杀君家少妇才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题大雅堂七首 其七","author":"胡应麟","text":"屈指河山罢酒徒，华阳重见李生无。\n知交尚有卢鸿在，如意狂敲碎玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪明府以校文来武林旬日别去追送四章 其一","author":"胡应麟","text":"乍拥轩车到六桥，不堪江浦系兰桡。\n飞樯百尺西风里，万壑千岩送暮潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪明府以校文来武林旬日别去追送四章 其二","author":"胡应麟","text":"堤上明霞跃紫骝，接天弦管带琼楼。\n漫将桃李誇梁国，采尽芳兰瀫水头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪明府以校文来武林旬日别去追送四章 其三","author":"胡应麟","text":"迢递朱弦百里鸣，朱衣仍傍棘闱行。\n新栽何限淮南桂，满路飘香入帝城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪明府以校文来武林旬日别去追送四章 其四","author":"胡应麟","text":"星斗昆崙一柱悬，文光千丈烛龙泉。\n浑忘卤簿江州贵，寂寂衡卢问太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同黄生过方生仲闇适沙棠入湖曲因寄声留棹子夜同醉狭斜中 其一","author":"胡应麟","text":"天际楼台挂碧空，芙蓉十里褪残红。\n岳王祠畔狂歌发，何限湖山夕照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同黄生过方生仲闇适沙棠入湖曲因寄声留棹子夜同醉狭斜中 其二","author":"胡应麟","text":"缥缈寒光石磴幽，佳人无赖木兰舟。\n青帆莫便乘风去，子夜钱塘载莫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祝逊之订约新秋过湖上不至","author":"胡应麟","text":"湖畔秋风日夜过，东来舴艋定如何。\n蒹葭满目澄江上，不分兰阴坠露多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚再寄祝逊之","author":"胡应麟","text":"老去冯唐不解愁，南山秋色暮悠悠。\n歌残白石无人和，荒草斜阳独饭牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻弇州续集杀青寄怀王囧伯昆季四首 其一","author":"胡应麟","text":"四部重开诧汗牛，千金悬市定谁雠。\n风霜字字遥天外，怅望如椽白玉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻弇州续集杀青寄怀王囧伯昆季四首 其二","author":"胡应麟","text":"副在名山更杀青，茫茫元气走群灵。\n从知百氏毫端废，可道传家但一经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻弇州续集杀青寄怀王囧伯昆季四首 其三","author":"胡应麟","text":"百尺危栏跨紫虚，青藜遥夜烛前除。\n莫言中垒慵疏甚，阁上曾雠太乙书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻弇州续集杀青寄怀王囧伯昆季四首 其四","author":"胡应麟","text":"万颗骊龙抱月圆，江河不废异时传。\n琳琅何限阶庭下，次第三株拂斗躔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新秋再寄囧伯","author":"胡应麟","text":"柳色金阊半夕阳，鲈鱼虽好未堪尝。\n莫言方外狂司马，多少楼船鸭绿傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦弇园怀逸季茂才","author":"胡应麟","text":"极目娄江大海浔，弇园秋色梦中寻。\n兴怀莫话兰亭序，玉树琅琊正满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄生九斗携所业千里过访于其别也赠以绝句六章 其一","author":"胡应麟","text":"万仞潮头溅客衣，布帆无恙雪中飞。\n推篷面面青山色，已到严陵白石矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄生九斗携所业千里过访于其别也赠以绝句六章 其二","author":"胡应麟","text":"千里遥遥问字船，海天长啸白虹悬。\n还家莫话相如璧，携得成都旧太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄生九斗携所业千里过访于其别也赠以绝句六章 其三","author":"胡应麟","text":"衮衮青云结驷游，沾沾白雪断鸿愁。\n何来意气纵横甚，昨日龙门御李侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄生九斗携所业千里过访于其别也赠以绝句六章 其四","author":"胡应麟","text":"缥缈仙都挂碧空，石门飞瀑乱云中。\n他时倘为名山出，双屐岩前候谢公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄生九斗携所业千里过访于其别也赠以绝句六章 其五","author":"胡应麟","text":"秋风秋叶乱山苍，踏尽秋山到遂昌。\n问讯故园樵牧侣，只今谁住郑公乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄生九斗携所业千里过访于其别也赠以绝句六章 其六","author":"胡应麟","text":"扫石题诗坐绿苔，黄家群从最多才。\n无双漫自誇江夏，次第三珠照玉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题册赠凌别驾二首 其一","author":"胡应麟","text":"弦歌百里画帘深，桃李千家接上林。\n试问佩刀临瀫水，何如飞舄向兰阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题册赠凌别驾二首 其二","author":"胡应麟","text":"仙吏仍浮剡水槎，天都缥缈接金华。\n官衙尽说囊如水，携得芙蓉几片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林孝廉园池四绝 其一 浣花池","author":"胡应麟","text":"百顷风潭照玉壶，清鳞白石拥菰蒲。\n沙棠独抱夷光卧，何事风涛汎五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林孝廉园池四绝 其二 飞云榭","author":"胡应麟","text":"八面疏棂挂夕阳，楼头云色尚飞扬。\n屋梁咫尺亲颜在，不用褰帷望太行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林孝廉园池四绝 其三 清涟馆","author":"胡应麟","text":"古桧崚崚映夹池，虚亭十尺锁涟漪。\n朝来载酒谁相过，正值扬云赋就时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林孝廉园池四绝 其四 振秀轩","author":"胡应麟","text":"缥缈精庐入望遐，芙蓉秋水旧生涯。\n如椽莫笑书生笔，十丈亭亭照暮霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题祝山人树勋栖云轩四首 其一","author":"胡应麟","text":"掩径萧萧木叶闻，干将明灭动星文。\n青山独据胡床坐，閒看中条石上云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题祝山人树勋栖云轩四首 其二","author":"胡应麟","text":"木末飞轩面水流，终南遥挂万峰秋。\n玄关白日重重闭，不放飞云去岭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题祝山人树勋栖云轩四首 其三","author":"胡应麟","text":"一径莓苔尽日封，匡床云色卧双龙。\n罗浮四百青天外，不认飞来第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题祝山人树勋栖云轩四首 其四","author":"胡应麟","text":"十二巫峰挂楚台，高唐新赋定谁裁。\n莫言神女朝行倦，夜夜閒云卧榻来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祝如华二首 其一","author":"胡应麟","text":"抗手玄亭话别离，青衫憔悴越江湄。\n那堪独宿孤舟上，潮落钱塘夜雨时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祝如华二首 其二","author":"胡应麟","text":"十载高山托素琴，朱弦无处觅知音。\n飞霜落月河桥畔，惆怅行人发武陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"履素使君邀集衙斋中嗣君出迓仅五龄风仪韶润而衣裳楚楚如老成人赋赠二绝 其一","author":"胡应麟","text":"三尺龙渊掌上持，亭亭寒玉照风仪。\n机云漫自誇年少，又睹云间小陆奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"履素使君邀集衙斋中嗣君出迓仅五龄风仪韶润而衣裳楚楚如老成人赋赠二绝 其二","author":"胡应麟","text":"径寸骊珠夜色悬，衣裳楚楚画堂前。\n抽毫异日兰台坐，会学盈川赋浑天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴德符损饷宣德茶盂二枚因瀹天池新焙赋二绝以赏之 其一","author":"胡应麟","text":"柴汝官哥各浪传，摩娑秋色到龙泉。\n筵中宣德新磁在，笑杀何郎食万钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴德符损饷宣德茶盂二枚因瀹天池新焙赋二绝以赏之 其二","author":"胡应麟","text":"把赠双珍破寂寥，龙团翻雪乱云飘。\n琅琊旧著煎茶赋，已说宣窑胜定窑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病经旬吴生持所业新诗来谒讶其精进赋赠二章 其一","author":"胡应麟","text":"何人不羡济川功，策石虚传大海东。\n莫笑老为题柱客，当年曾住玉华宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病经旬吴生持所业新诗来谒讶其精进赋赠二章 其二","author":"胡应麟","text":"独绾金绳系法轮，重施宝筏架迷津。\n亦知黄檗前身是，肯作恒河自渡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其一","author":"胡应麟","text":"两岸清溪中有洲，山花红白遍溪头。\n闻说西门好风景，大家同上木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其二","author":"胡应麟","text":"兰阴苍苍北固遥，中洲水面似金焦。\n欲把湖头比溪上，若个三山在六桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其三","author":"胡应麟","text":"饮水白虹千丈强，来来去去罢褰裳。\n中流不碍蚤行客，隔水休呼夜渡娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其四","author":"胡应麟","text":"渡口狂风掀白蘋，惊波猛浪不愁人。\n乍宵西崦踏青罢，明到兰阴赛水神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其五","author":"胡应麟","text":"苧萝村中花满蹊，庐江亦有仲卿妻。\n银钏金钗照溪水，往往来来唱大堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其六","author":"胡应麟","text":"严陵东头七里滩，家家门户钓鱼竿。\n良人乍夜趁潮去，将船卖酒入临安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其七","author":"胡应麟","text":"四柱凌云排六鳌，铁絙高系最坚牢。\n水母难兴泗洲浪，蛟精不作九江涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其八","author":"胡应麟","text":"溪上浮梁春涨平，濛濛烟雾懒回程。\n风秋潭上踏歌去，水远山高无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其九","author":"胡应麟","text":"郑村渡口风浪多，鱼船来去疾如梭。\n相邀女伴到梁下，一时同唱采菱歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其十","author":"胡应麟","text":"三百阑干浮碧空，笙歌缭绕暮云中。\n天香夜半广寒落，错认银桥在月宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其十一","author":"胡应麟","text":"金台尖高高插天，俯江楼俯夕阳边。\n当年板筑遁荒野，今日舟梁济大川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰江竹枝词十二首 其十二","author":"胡应麟","text":"城南回望告天台，衢婺悠悠二水来。\n清献前身为时出，萧然琴鹤在蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]