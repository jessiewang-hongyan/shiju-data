[{"title":"题画二首 其一 哦松","author":"吴俨","text":"谁言高树独靡阴，六月凉风自不禁。\n相对可能无一语，含毫为调水龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画二首 其二 灌竹","author":"吴俨","text":"远汲清泉溉欲深，童儿那识汝翁心。\n虞廷六管终须备，不为春来十亩阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其一","author":"吴俨","text":"绿树莺啼春正深，絮飞花落满园林。\n长松不改青青色，岁暮相看共此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其二","author":"吴俨","text":"圉圉洋洋乐有馀，谁言我独不知鱼。\n纵教九岛回千里，那比江湖得自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其三","author":"吴俨","text":"待隐园依北固山，题名石在墨痕乾。\n何时布袜青鞋去，老眼摩挲试再看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其四","author":"吴俨","text":"芙蓉枝上露华清，杨柳阴中独自行。\n江上美人期未至，停歌不发更含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其五","author":"吴俨","text":"洗竹从来为太繁，独留高节与人看。\n渭川空自誇千亩，争似公家只数竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其六","author":"吴俨","text":"一叶扁舟十幅蒲，长竿短发傍江湖。\n不知渺渺烟波里，曾见逃名范蠡无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其七","author":"吴俨","text":"松间石上听鸣泉，清比琴声更自然。\n有客欲来醒俗耳，挂冠已约在明年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园次杨太宰韵 其八","author":"吴俨","text":"清风明月两无求，花径柴门日转幽。\n莫怪主人归较晚，君王有诏欲分猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇寄徐文烱表侄","author":"吴俨","text":"东风力软落花轻，一曲离歌客未行。\n载酒满船还载月，坐听啼鸟溧阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈克寅扇","author":"吴俨","text":"绿杨黄鸟试春声，画舫朱帘送客行。\n醉后不知君别去，醒来犹记溧阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"明妃词 其一","author":"吴俨","text":"西风冽冽塞云愁，冻合长河水不流。\n只恐妾颜明日改，单于轻易犯边州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"明妃词 其二","author":"吴俨","text":"玉颜一去黄金殿，香骨终埋白草原。\n千载游魂归不得，至今青冢尚含冤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词二首 其一","author":"吴俨","text":"花影疏疏月影昏，沈沈鱼钥锁重门。\n无端步下空阶立，踏破苍苔石上痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词二首 其二","author":"吴俨","text":"清簟疏帘困日长，南风时送芰荷香。\n隔窗女伴来相约，同到池头纳晚凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"塞下曲 其一","author":"吴俨","text":"一声画角起边愁，满目黄云暗戍楼。\n夜半将军传号令，明朝要斩郅支头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"塞下曲 其二","author":"吴俨","text":"边城九月雪飞花，睥睨高寒集暮鸦。\n今日楼兰犹未灭，沙场战士莫思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送三弟东归 其一","author":"吴俨","text":"灯前相对一尊同，衰颊那知是酒红。\n醉后已忘离别恨，楼头又听叫霜鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送三弟东归 其二","author":"吴俨","text":"东篱秋菊试新黄，江岸蒹葭未著霜。\n路入故乡三百里，遥看雁影落横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄丁芝山","author":"吴俨","text":"闻君脉理见秋毫，袖里咸阳术更高。\n芝草满山光晔晔，常分一叶惠儿曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜雨止风作","author":"吴俨","text":"秋阴初散雨初晴，飒飒西风夜有声。\n梦绕五云溪上路，不知身在石头城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪梦 其一","author":"吴俨","text":"灵椿彫落已多时，犹记当年涧壑姿。\n昨夜梦中真想见，分明月影过南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪梦 其二","author":"吴俨","text":"大椿不驻八千秋，空使孤儿日日愁。\n独有当时枝上月，至今还照屋西头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示骥儿 其一","author":"吴俨","text":"未尝糠覈体何肥，空有便便腹十围。\n但愿吾儿勤苦学，何愁清瘦不胜衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示骥儿 其二","author":"吴俨","text":"梦寐分明在碧山，涧泉深处洗尘颜。\n从来只说休官易，今日谁知退亦难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14708,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送沈四舅","author":"吴俨","text":"花外莺啼三两声，坐中有客不胜情。\n纵令花落春光老，犹向垂杨树底行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14709,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中与沈克寅赏莲二绝 其一","author":"吴俨","text":"红莲花映白莲开，花影交加入酒杯。\n疑是南威与西子，双双联袂雨中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14710,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中与沈克寅赏莲二绝 其二","author":"吴俨","text":"西洴溪上万花开，季子门前锦作堆。\n花笑主人何太俗，秋风将起未归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14711,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"席上戏赠写真龚士常","author":"吴俨","text":"不写褒公与鄂公，却来吴下写吴翁。\n衰容老眼都相似，独不能摸左耳聋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14712,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汪海云为骖儿画白鸡鲜洁可爱戏题一绝","author":"吴俨","text":"菊丛东畔石阑西，素质天然不染泥。\n玉漏未残天未晓，莫教轻易草间啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14713,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海云又为驷儿写赤鸡形差小而有文复戏题一绝","author":"吴俨","text":"绛帻低低距未长，自知不入斗鸡场。\n宋公相对谈玄处，应有旁人拟凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14714,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭李充昭","author":"吴俨","text":"虚堂落笔鬼神惊，生縳龙蛇卧素屏。\n莫怪遗文无谏草，白麻犹未拜延龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14715,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题柳燕","author":"吴俨","text":"深深庭院锁春愁，尽日珠帘不上钩。\n懒入茅檐定巢垒，暂时飞向柳枝头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14716,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和国贤谢茶 其一","author":"吴俨","text":"雨坼灵芽我发船，北风吹断碧山烟。\n一杯未解文园渴，七碗何能到玉川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14717,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和国贤谢茶 其二","author":"吴俨","text":"品茶世独推阳羡，评水人多说慧山。\n今日相从调众口，莫教腾沸鼎铛间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14718,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"士修惠左传一部已为峡水所坏后加装潢又几为风雨所漂因成一绝","author":"吴俨","text":"昔年沈没黄牛峡，今日漂零季子家。\n左氏两遭风雨厄，天公应是厌浮誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14719,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江一棹","author":"吴俨","text":"万里长江一镜平，空林落叶战秋声。\n孤舟不畏归来晚，已见沙头候火明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢汝砺惠橘次韵","author":"吴俨","text":"百颗匀圆远寄将，青虬小卵半涂黄。\n诗人莫作多酸恨，采日应知未著霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题猫捕蜻蜓图","author":"吴俨","text":"养得狸奴善匿形，閒来花外扑蜻蜓。\n不知黠鼠浑无忌，白昼徐徐出外庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为欧阳牧之题竹二首 其二","author":"罗钦顺","text":"此君吾所爱，一见心神融。\n由来律吕声，出自空洞中。\n岁寒凛无恙，叶叶皆清风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东窗为曾如周赋","author":"罗钦顺","text":"栽竹已满林，滋兰欲盈畹。\n爱此东窗幽，不换金门显。\n明月透轻纱，高枕便息偃。\n遥山上红日，四壁晴光晅。\n庭閒燕雀驯，境静轮蹄远。\n春风和且柔，芳草齐如剪。\n举世慕登仙，金丹期九转。\n却恐金丹成，蓬莱水清浅。\n何似窗中人，世累渐消遣。\n瑶琴时一弄，尊酒自洗腆。\n我居枕西冈，有轩亦东展。\n虽勤待旦心，梦见周公鲜。\n北望多浮云，南观叠层巘。\n啸傲得此生，兹言庶同践。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"慎轩为萧蒙绅赋","author":"罗钦顺","text":"开轩面南山，山光浮几褥。\n高人时往来，幽花晚芬馥。\n虽馀润屋资，不作守钱俗。\n理学二三编，自抄还自读。\n因思两大贤，皆云慎其独。\n爰以慎名轩，大书常在目。\n从知一念微，终若秋阳暴。\n毫发分公私，天渊异荣辱。\n兢兢如捧盈，洞洞如执玉。\n敢萌机变心，况举横行足。\n芳誉蔼当年，清风振乔木。\n允副交游期，亦萃家庭福。\n柱史明知人，其言固可覆。\n何时一樽酒，为子歌淇澳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵同年郑宪长舟行书事","author":"罗钦顺","text":"药裹正关心，凝尘满瑶瑟。\n忽枉故人书，顿愈无妄疾。\n长篇屡沈吟，首得防尾失。\n风波固云恶，高天自行日。\n那知汹涌时，不有龟龙出。\n吾命乃在天，颠顿亦奚恤。\n侃侃开笑谈，底柱屹中立。\n虽然西江水，未容一日吸。\n顾此济川舟，何方不可适。\n终风徒尔为，行云靡留迹。\n大哉天壤间，自生还自息。\n此意当谁知，吾目为君拭。\n君吾榜中英，常情讵能测。\n激扬肃官箴，钻仰希圣域。\n变化阴且阳，居然守无极。\n应悲行险徒，终年长戚戚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽兴化陆子贤举人","author":"罗钦顺","text":"平生春秋学，字字经推寻。\n跃如果何物，昭哉素王心。\n兴贤诏屡下，丛棘围冠襟。\n文章岂不美，谁辨沙中金。\n俛首充岁赋，远韵无悲吟。\n瑶京日华紫，璧水春流深。\n仰止琼台翁，一旦逢知音。\n骅骝鸣向乐，万马立皆瘖。\n价增终有合，天定讵难谌。\n光华京兆榜，魁名动儒林。\n庶几日千里，如何中陆沈。\n凄凉淮海畔，风物莽萧森。\n浮生孰为久，大节人所钦。\n庭闱怀婉婉，襟度想愔愔。\n遗劳析薪在，负荷诸孤任。\n显扬会有日，鼎荐宜居歆。\n旻天多雨露，楸梧郁繁阴。\n怀贤良自苦，怅望空遥岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丰生坊初冠","author":"罗钦顺","text":"皎皎珊瑚枝，凝辉玉堂戺。\n一见已知奇，再见益堪喜。\n少小攻文章，明窗无虚晷。\n兹辰突而弁，居然异童子。\n古礼不多存，存者何常已。\n三加威仪备，所重成人尔。\n成人必有德，忠信以为址。\n篑篑靡停功，峨峨见崇峙。\n家声四百年，鹏程九万里。\n寻常得失间，何足挂唇齿。\n昔贤怀一饭，况乃言之旨。\n祝子非他人，瓯滨天下士。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼亡女","author":"罗钦顺","text":"东风射窗急，窗纸摵摵鸣。\n畴昔窗中居，一去不闻声。\n展转夜过半，揽衣步前楹。\n宁知治缕夕，正此月华明。\n耳目不堪触，更堪忆平生。\n十年一梦短，伤哉父子情。\n周身旧裙布，犹如新制成。\n奈何修洁姿，大命偏早倾。\n花缀故枝红，草回隔年青。\n婉娈无复见，痛恨何时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古轩为程处士赋","author":"罗钦顺","text":"末世争外鹜，弥巧弥丧真。\n孰知深山中，乃有葛天民。\n含淳而抱朴，沈晦以自珍。\n奉身一裘葛，养母兼鼎茵。\n连枝无异爨，比屋有分囷。\n百金能一掷，趋义勇过人。\n高亭既还旧，小轩亦开新。\n山凝太古色，水泛桃花春。\n红尘何由到，鸥鸟长相亲。\n春秋乡饮酒，雍容见嘉宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"彭郡博先生蒲萄为王斯远冬官题 其一","author":"罗钦顺","text":"彭师樗散日，余及升其堂。\n堂前蒲萄架，架下笔满床。\n乘兴一挥洒，枝叶互低昂。\n明珠来照眼，宛若中心藏。\n谁能宝此幅，潇洒冬官郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"彭郡博先生蒲萄为王斯远冬官题 其二","author":"罗钦顺","text":"马乳西北来，分甘到吴越。\n画图不根着，妙在三两折。\n修蔓引清风，远影含初月。\n彷佛骊龙腾，颔下光明灭。\n酿酒纵盈缸，凉州吾不屑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送少宗伯杨先生考满赴京","author":"罗钦顺","text":"堂堂建安公，四朝蔼嘉绩。\n公姓何振振，振振岂天锡。\n渊源良有开，才华况无敌。\n一举凌天衢，未脱劬书癖。\n藻鉴清秋悬，全牛片时析。\n几微慎周防，中外屡扬历。\n留都礼乐存，遗文赖参绎。\n声色初不烦，神人乃胥怿。\n兹当述职期，凉风满襟掖。\n离亭一杯酒，永怀自今夕。\n台省须仁贤，如闻有虚席。\n文旆倘重来，慰我长亲炙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"守拙为丹阳贺环赋","author":"罗钦顺","text":"饥餐高原粟，渴饮下泉水。\n菽粟水火如，时时散邻里。\n公家别有输，为义良亦伟。\n峨峨乌纱帽，见者胥仰止。\n三径以藏身，一经以教子。\n有子复何忧，万事渠能理。\n游心濂溪赋，真可没吾齿。\n袖手公输傍，无由血吾指。\n名途多疾足，利路䍐徐轨。\n独倚一株看，劳劳竟谁使。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日陪吴白楼陈苇川王阳明汪双溪登蒋山得依字","author":"罗钦顺","text":"佳辰不可负，文会何当稀。\n聊携一壶酒，相与登翠微。\n园陵郁佳气，古庙豁重扉。\n阴云坐来敛，草露亦已晞。\n游目极千里，凉风正吹衣。\n翩翩南来雁，远避风霜威。\n南土人尚馁，何由尔皆肥。\n长林移晚席，澄湖凝夕晖。\n同为醉乡客，各咏新篇归。\n天运靡留处，人事多乖违。\n真乐在三益，所愿长相依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"封淑人卞氏挽章","author":"罗钦顺","text":"樛木阴正繁，采蘋人已远。\n空馀桃李花，不辨春深浅。\n忆昔菟裘成，君子悬舆返。\n久劳欣共逸，相对日三饭。\n杂佩出房清，朱弦送声缓。\n每怜尊酒深，未觉年华晚。\n儿女情所钟，垂老尤缱绻。\n死丧忽相继，肝肠成寸断。\n一疾遂不支，百年何曾满。\n皓首失同心，老泪盈双眼。\n翩翩丹旐扬，望望牛眠坂。\n惨淡悲风生，凄凉蒿里挽。\n玄堂閟周翣，贞石蟠秦篆。\n冠帔不俱藏，春秋时一展。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贞母咏","author":"罗钦顺","text":"朝读贞母传，夕吟贞母诗。\n母寿今八旬，芳名千载垂。\n昔归君子室，心德两相宜。\n执手奉承说，黄发以为期。\n烹凫酌美酒，从容理朱丝。\n清音正盈耳，桃华犹满枝。\n溘乘埃风去，弃我真若遗。\n哀来无昼夜，昼哭声转悲。\n逝将从君往，重结深长思。\n有身嗟未判，辛苦安得辞。\n继体心所切，悬弧事竟奇。\n深闺寒复暑，长养实勤斯。\n聪明自天锡，教诲亦不迟。\n居然富文学，下笔惊主司。\n名题黄金榜，班簉白玉墀。\n爵位既频陟，恩封遂屡貤。\n尊荣倾邑里，光彩焕门楣。\n盛德固有报，始望那及兹。\n彼哉须眉具，长佩纷陆离。\n当几靡定力，王业何由熙。\n人间有贞母，岂得无男儿。\n贞母宜万寿，非独闺门师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"持节瞻云图为符台刘克柔赋","author":"罗钦顺","text":"马首太行北，孤云渺江东。\n忡忡刘子心，炯炯如狄公。\n大江日夜流，云舒还复卷。\n王事有程期，游子安得返。\n何时拜家庆，春酒碧于油。\n坐令回首处，变作綵云浮。\n归装不自由，图画先春就。\n稽首附征鸿，封君千万寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14738,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼内 其一","author":"罗钦顺","text":"墙头桃李花，墙下多芳草。\n忽忽又逢春，春光空复好。\n食案顿萧条，尘衣日颠倒。\n嗟我同心人，云胡不偕老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14739,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼内 其二","author":"罗钦顺","text":"春深风已和，入户但凄凄。\n逝水无复返，德音终不迷。\n去年双飞燕，又入梁间栖。\n我心非金石，能不增惨悽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14740,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼内 其三","author":"罗钦顺","text":"五十不为天，勤劳嗟未偿。\n我官已台省，君犹布衣裳。\n平生薄自奉，所愿名节芳。\n相我仅三纪，苟得非所臧。\n百年庶无悔，庶几同乐康。\n俯仰忽不见，此恨何时忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14741,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼内 其四","author":"罗钦顺","text":"养老非无人，鸾刀手亲把。\n教子亦有师，辞色无少假。\n吾父寿而康，惜尔得年寡。\n吾儿傥能立，庶以慰泉下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次儿珝祇投赴京作五言古诗一篇送之以致丁宁告戒之意","author":"罗钦顺","text":"严亲顷辞世，仰蒙恩典优。\n荣光悬日月，感激无时休。\n寸忱思亟展，祇谢当龙楼。\n奈此多病挠，弥增旷礼忧。\n服劳吾儿事，欣然买扁舟。\n束装戒明发，春江正浏浏。\n勇往诚足慰，离绪纷难收。\n夜堂明烛短，教戒胡能周。\n呼童展长卷，为汝书绅谋。\n直词无润色，情致加绸缪。\n敬身第一义，三益资交游。\n亦既辨菽麦，宁当昧薰莸。\n出门路如砥，非义将安由。\n茶肆与酒市，一迹不可投。\n神明扶正直，人道恶轻浮。\n参倚必有见，洪闸皆安流。\n薰风御堤柳，莺声满皇州。\n金门偻伛入，进止宜详诹。\n故人多台省，往见亦奚求。\n所贵亲德范，庶或聆嘉猷。\n旬浃事当竟，有阙勤增修。\n白云试回首，归兴谁能留。\n蓬窗多暇日，还肯惜之不。\n知新在温故，中弸外乃彪。\n阿蒙三日别，议论惊同俦。\n兹行将验汝，刮目期清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]