[{"title":"投赠沈相国八首 其五","author":"胡应麟","text":"十年调鼎系遐思，霖雨亲承玉陛词。\n八士夜登元恺族，千官晨谒帝王师。\n逶迤树色长春殿，缥缈藜光太乙祠。\n惭愧钧天韶濩在，入将流水奏朱丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"投赠沈相国八首 其六","author":"胡应麟","text":"冠代词华八咏俦，中天霞色四明流。\n黄冠未许归贤相，彩笔聊将和隐侯。\n环佩西园晴赫奕，图书东壁暮优游。\n无论消渴须盘露，百尺金茎望斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"投赠沈相国八首 其七","author":"胡应麟","text":"廿载貂裘客路难，青冥长日望鹓鸾。\n华轩肯挟三公贵，大厦宁忘一士寒。\n日月夔龙新政府，风云扬马旧词坛。\n玄亭不厌侯芭学，扫叶频过十二栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"投赠沈相国八首 其八","author":"胡应麟","text":"十年怀璧卧山堂，老逐盐车上太行。\n矫首乾坤空骏骨，关心岐路半羊肠。\n星河暗蚀芙蓉佩，雨雪全凋薜荔裳。\n道是姬公勤吐握，将因词笔献长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事","author":"胡应麟","text":"九折曾闻蜀道难，绨袍谁恋故人寒。\n长镵杜甫朝朝斸，短铗冯驩夜夜弹。\n垂首乾坤皮骨尽，侧身湖海鬓毛残。\n天风习习扶摇近，会向南溟刷羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李参军使秦中","author":"胡应麟","text":"朱节朝持下紫宸，北风扬旆潞河滨。\n飞槎渭水星为使，授简梁园雪照人。\n去路正逢葭菼夕，归期先趁棣棠春。\n遥遥草色西池畔，何限新诗入梦频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠孙太宰二首 其一","author":"胡应麟","text":"名世中原间出年，三朝人望属材贤。\n冰壶独抱青云上，水镜高悬白日前。\n珂色葱茏分建礼，履声摇曳动甘泉。\n千秋启事传缃帙，肯让山公笔似椽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠孙太宰二首 其二","author":"胡应麟","text":"徵书晨下建章宫，赫奕蒲轮眷注同。\n黜陟千官周太宰，安危一代晋司空。\n尊罍尚忆东山胜，柱石遥瞻北斗崇。\n咫尺黄金飞兔满，骊黄聊为辨追风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"章纳言得雄过是将益燕山之数贺以七言一章","author":"胡应麟","text":"梅花南陌正毵毵，兰萼东风瑞气含。\n四凤桓生重遘一，八龙荀氏仅馀三。\n充闾此夕传歌颂，跨灶他年入笑谭。\n屈指琅琊符胜事，珠玑林立待分甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈囧卿过访二首 其一","author":"胡应麟","text":"危楼百尺暮云孤，象纬寒飘玉鹿卢。\n校士当年曾越郡，空群此日更燕都。\n天闲尽获龙媒否，海甸仍求骏骨无。\n最忆牙樯兰水畔，沧浪一曲和潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈囧卿过访二首 其二","author":"胡应麟","text":"高天云雾玉宸班，咫尺龙鳞近圣颜。\n静夜鸣珂朝北极，清秋拄笏望西山。\n风驰騕袅三千队，电拥骅骝十二闲。\n惭愧方皋谈灭没，盐车憔悴太行间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惟寅病榻对谭作","author":"胡应麟","text":"大厦华轩接上林，閒窗孤榻类山阴。\n朱颜我向愁中掷，白发君随病后深。\n枥下骥心时惨淡，杯中蛇影任浮沈。\n蒲团兀坐黄粱熟，万户燕台急暮砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐文明馆中听歌","author":"胡应麟","text":"清歌一曲暮云长，秉烛呼卢万事忘。\n朱履三千回别院，金钗十二照华堂。\n谁言工部生来瘦，漫说司空见后狂。\n妒杀卢家双乳燕，春风联翼向雕梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜饮徐文明邸即席作二首 其一","author":"胡应麟","text":"相逢湖海尽词才，车马苍茫踏翠苔。\n万里乡心同越峤，新年春色到燕台。\n筵前柏叶风初动，庭际梅花月渐来。\n遮莫河梁成远别，黄金新诏出蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜饮徐文明邸即席作二首 其二","author":"胡应麟","text":"散发狂歌动紫宸，天街良夜月如银。\n朱颜暂借逢春客，白发偏惊受岁人。\n宇宙风期回击筑，江湖消息报垂纶。\n高阳是处名流集，痛饮何辞大白频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡谷元招同茅陈诸生夜集余适留滞都门不及赴","author":"胡应麟","text":"折简招邀玳瑁筵，那知春色负华年。\n才人并集春明外，倦客孤吟建礼前。\n易水乍闻新击筑，稽山殊愧旧移船。\n?成十日平原醉，柏叶椒花次第传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄何转运","author":"胡应麟","text":"严城平楚正苍然，突兀高牙大海悬。\n三辅云霞双阙底，九河冰雪万家前。\n公车竹箭同登日，宦邸梅花独赋年。\n漫说鱼盐留滞久，家声八座在甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠戚山人伯坚","author":"胡应麟","text":"散发相逢大海头，弇山堂下即糟丘。\n余归故里携通德，汝向新亭载莫愁。\n厎事歌鱼来越郡，谁能骑鹤上扬州。\n皈依合傍莲花社，天女维摩话昔游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕冯太史开之邀同俞羡长潘景升吴泰宁德符喻叔虞傅太学王山人集湖上观少姬走马戚不磷洎仲君继至余夜分返太史以轻舟载羡长不磷宿玉莲亭","author":"胡应麟","text":"折简秋宵兴欲狂，东南名胜半沙棠。\n天孙河畔停乌鹊，地主池头宿凤凰。\n绿树回风全送暑，红蕖摇月细生凉。\n无劳更觅牵牛信，一骑湖头到谢娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过天津访万中丞伯修四首 其一","author":"胡应麟","text":"建牙吹角下蓬莱，飞檄千章尽手裁。\n晋代诗书元帅业，周家文武上公材。\n还摇大纛天骄遁，曾系长缨日逐来。\n漫道平阳曾第一，无双筹策照云台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过天津访万中丞伯修四首 其二","author":"胡应麟","text":"翩翩白马气淩虚，老将渔阳尽不如。\n出塞盛传破敌策，筹边频上护羌书。\n千樯跨海长驱鳄，万弩乘潮各射鱼。\n落落元规豪兴在，南楼明月半长裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过天津访万中丞伯修四首 其三","author":"胡应麟","text":"威名十载镇祁连，又见登坛仗钺年。\n列校总驱横海节，偏师遥下伏波船。\n风行蜃鳄扶桑外，观筑鲸鲵细柳前。\n屈指铙歌飞捷夜，抽毫何客代如椽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过天津访万中丞伯修四首 其四","author":"胡应麟","text":"玉帐梅花照叵罗，南楼吹笛夜如何。\n中丞节钺行三辅，大将楼船出九河。\n赤日桑乾穷兕虎，青天蒲类息蛟鼍。\n燕然片碣题铭处，万丈穷崖绝顶磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李万户过访舟中作","author":"胡应麟","text":"寂寞孤帆滞水濆，双旌俄报李将军。\n虬髯本自山西出，猿臂先从塞北闻。\n异代淩烟谁左席，他年冒雪有奇勋。\n燕然绝顶聊相待，为扫班生石上文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集万伯修中丞署中听奚童弹琵琶即席赋","author":"胡应麟","text":"鼓瑟吹笙夜未阑，狂歌醉舞烛花残。\n清光琥珀浮金斝，逸响珠玑坠玉盘。\n细柳生风回绮席，丛篁扶月上雕栏。\n真堪十日平原饮，莫向参军话路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陈子卿胡瀫元集黄茂才馆茅生击鼓侑觞席上戏题","author":"胡应麟","text":"旅鬓萧然越客踪，故人文酒暂从容。\n风霜骤击渔阳鼓，云雾深藏碣石钟。\n春尽短衣残薜荔，夜阑长铗笑芙蓉。\n朝来曲水堪沈饮，何处桃花问旧峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日黄文学馆中送陈子卿南归访马生即席赋","author":"胡应麟","text":"行李萧萧易水寒，不因题赋到长安。\n魂摇蓟阙千门树，兴入湘台九畹兰。\n击筑风云晨肮脏，抽毫星斗夜阑干。\n东归未值秦淮棹，愁绝春风两鬓残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"禊日再送陈生","author":"胡应麟","text":"布衣行色又风尘，携手平原未浃旬。\n易水悲歌逢壮士，兰亭修禊属才人。\n扁舟自许浮东海，龙剑犹堪射北辰。\n归去白门机上女，莫言裘敝出三秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄燮卿王至卿胡静父瀫元茅厚之过集","author":"胡应麟","text":"萧萧四壁似禅关，纵饮宁辞十日閒。\n邂逅江湖成白社，参差河朔见青山。\n垆头乍发幽人兴，庑下频开倦客颜。\n台殿黄金原咫尺，朝携瓢笠共飞攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送包稚升观察之蜀中","author":"胡应麟","text":"握手河桥兴未阑，春风笳鼓出长安。\n千波已见淮流静，九折宁辞蜀道难。\n酒肆才人原犊鼻，花溪词客尚渔竿。\n岧峣雪色三峨上，何限新诗勒翠峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"首夏少傅赵公斋头纵观宋元本朝书画名迹出家藏焦尾命作梅花三弄饭罢奕棋留连浃日即席赋诗","author":"胡应麟","text":"画槛雕楹白玉堂，高山流水落胡床。\n墙头树色分长乐，户外花枝接上阳。\n笔札西清悬琬琰，图书东壁散琳琅。\n翛然一枕蓬壶畔，卧听棋声入梦长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少傅赵公斋头烹供虎丘新茗适侯家以紫牡丹至清香艳色应接不遑即席二首 其一","author":"胡应麟","text":"杨花飘落遍天涯，十二雕阑散曙鸦。\n玉盌坐邀阳羡月，金盘驰送洛城霞。\n清香恍坠幽人席，艳色偏归上相家。\n入梦故园红紫遍，千峰寒瀑漱灵芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少傅赵公斋头烹供虎丘新茗适侯家以紫牡丹至清香艳色应接不遑即席二首 其二","author":"胡应麟","text":"楼头红日近扶桑，乳燕参差入画梁。\n雪乳乍分卢处士，天香元属魏平章。\n移来上苑非金谷，烹处中泠是玉堂。\n莫便清风生两腋，联翩倾国在明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹计部访寓中赋赠","author":"胡应麟","text":"词藻翩翩跨七闽，楼船曾宿大堤春。\n辉煌结驷寻燕侠，缥缈惊鸿问洛神。\n阙下云霞飞锦绶，湖头风雨湿纶巾。\n知君暂驻玄亭笔，盐铁将成献紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詹司理过访并邀集寺中夜谭司理家去余邑百里而近","author":"胡应麟","text":"驷马骖驔碣石东，持杯萧寺问飞蓬。\n无论客思孤航外，何限乡心一座中。\n说剑春云流绮户，抽毫晴雪照丝桐。\n尘埃暂试空群足，荏苒黄金出汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王将军过访不值次日遣信相闻走笔四韵代东时方拜总戎之擢而余寄居胡氏园芍药盛开故诗句云云","author":"胡应麟","text":"高空遥望碧云残，细雨萧萧一径寒。\n小队朱旗频出郭，元戎金印乍登坛。\n双龙色照芙蓉匣，驷马光生芍药栏。\n为报主人林竹在，天风晨夕候飞鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方伯苓徐彦伯胡静父王孟博吴云从同集茅生斋头","author":"胡应麟","text":"相逢湖海合吴钩，笑拂青萍上酒楼。\n坐里风霜流覆局，檐前星斗坠藏阄。\n三生障业输芒蹻，十口生涯问敝裘。\n取高歌酬令节，红牙催拍按梁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王贞伯过访胡园作时澍雨骤至轰饮几达旦归","author":"胡应麟","text":"握手高阳尽赋才，参差游屐点苍苔。\n虚疑上客寻花过，总为元戎看竹来。\n急雨乱飞巫女峡，雄风遥度楚王台。\n谁言定远先投笔，粲烂如椽勒草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王总戎携酒同登新城南楼即席赋","author":"胡应麟","text":"突兀飞甍潞水头，栏干十二挂朱楼。\n云拖汉阙双龙度，月拥燕城万雉流。\n坐里胡床应尽兴，登来彩笔暂销愁。\n山川信美吾乡异，聊伴元戎作壮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东黄水部孟修并乞其绘事","author":"胡应麟","text":"才名江夏世无双，耆旧襄阳接姓庞。\n兴里烟岚流彩笔，吟边云日弄纱窗。\n鸿冥大泽心长远，驷逐中原意已降。\n识面长安吟晚暮，烂烧红烛醉银缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝过刘金吾斋阁小饮即席赋","author":"胡应麟","text":"暖日暄风半画堂，金吾西第暮传觞。\n图书粲烂偏盈架，绿竹参差尽绕梁。\n赋就桃花潜弄色，吟馀梅萼乱飞香。\n接䍦颠倒休辞醉，能忆通家旧雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨不弃吴用卿追送潞河作","author":"胡应麟","text":"惨淡尘沙吹别颜，都亭杨柳并追攀。\n河梁客趁双鱼下，海岸人浮片鹢还。\n白苧淋漓燕雪底，青萍摇曳潞云间。\n谁言岐路分飞近，纵饮犹?十日閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹计部至自盘山极谭夜宿招提之胜赋此","author":"胡应麟","text":"乱山回合暮云齐，流水桃花汉阙西。\n绝顶双灯悬舍利，中峰一刹现菩提。\n萝深忽跨猿猱上，树古聊同鹳鹤栖。\n最是夜深铃铎畔，天鸡如傍法轮啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过万都尉馆赋赠","author":"胡应麟","text":"坐捲珠帘夏日长，主家楼阁凤城傍。\n金池草色连兴庆，玉洞花枝映寿阳。\n逸气千秋回处仲，玄谈一代擅真长。\n春山写就难停笔，次第蛾眉出后房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过区用孺太史适长公绳玄诞日即席赋赠","author":"胡应麟","text":"五夜文光切上台，三春晴色绕蓬莱。\n桃花漫向秦源觅，棣萼先从汉殿开。\n紫气絪缊红日驻，清歌摇曳彩云来。\n丹砂勾漏容相问，六翮从君跨九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴太学游边","author":"胡应麟","text":"燕台秋色乍阑珊，少借垆头十日閒。\n说剑风声流易水，弯弓云色坠天山。\n平沙夜伴孤鸿宿，大漠朝驰驷马还。\n愁绝南楼离恨杳，西风吹梦出阳关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河东郊同胡生踏青即席赋","author":"胡应麟","text":"春色三分二已过，空门相逐问维摩。\n新红破萼盈高树，浅绿回茎上细莎。\n雪里袈裟留绝域，风前杖锡度恒河。\n颓然一饱香厨饭，坦腹绳床话贝多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王遵考使君之岭南","author":"胡应麟","text":"卤簿春风出禁城，骖驔五马向人鸣。\n南州桂树传新赋，东阁梅花问旧盟。\n铜柱乱云行处合，金门残月望回明。\n名山莫恋罗浮色，前殿长杨识姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊中丞出塞诗","author":"胡应麟","text":"百万曾提阃外兵，君王西北问长城。\n埋轮疏上豺狼避，横槊诗成虎豹惊。\n川入大非晨按垒，河当无定夜移营。\n雕弧白马翩翩去，尽遣降王款帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于凤鸣得雄赋赠","author":"胡应麟","text":"窈窕笙歌出画堂，将雏一阕暂徜徉。\n群珠合浦争呈艳，片玉昆冈乍发祥。\n薮畔青云麟趾集，池头丹日凤毛翔。\n无劳骨相占英物，已听啼声出后房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江汝成驾部留集丙夜即席题","author":"胡应麟","text":"振策西游半五陵，旋车聊待帛书徵。\n三天会见翔孤凤，六月何妨息大鹏。\n款语凉风生白氎，酣歌明月坠青灯。\n犹闻彩笔多奇句，题遍慈恩第一层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄观察自沛上擢济南赋柬二首 其一","author":"胡应麟","text":"奕世通家问孔融，频年经国倚司空。\n千樯大海群飞鹢，六传高天并驾熊。\n雨浥杉松秦帝畤，风翻匏竹鲁王宫。\n犹能一识荆州面，漫向关河问落鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄观察自沛上擢济南赋柬二首 其二","author":"胡应麟","text":"竹箭南州贡竞输，梅花东阁梦频趋。\n彭城浪息三千仞，济郡泉疏七十区。\n白马何天沈汉壁，苍龙随地献隋珠。\n拾遗池上飞豪翰，笑揖长庚下紫枢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过济上昭刘大司空奉赠二律 其一","author":"胡应麟","text":"玉匣双龙挂斗躔，金堤千鹢度楼船。\n褰帷大吏群趋日，缓带中丞独坐年。\n碧汉云霞高凤羽，黄河冰雪净蛟涎。\n无论四载驱驰急，烨烨旂常太史悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过济上昭刘大司空奉赠二律 其二","author":"胡应麟","text":"宝箓琼函焕赤文，支祈摧伏奏元勋。\n旌旗泰岱瞻红日，节钺琅琊驻彩云。\n搜粟漫劳横海校，飞刍何待伏波军。\n由来据馈深延客，倘借胡床坐鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮上访王世叔留集署中座出新鲥共饱即席题","author":"胡应麟","text":"急管繁弦次第陈，歌鱼宁叹暮途贫。\n峥嵘铁网飞银鬣，粲烂金盘照玉鳞。\n岂为江莼能唤客，祇因岩桂共留人。\n孤亭环碧他年过，遮莫羊裘动帝宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东叶侍御初抵武林","author":"胡应麟","text":"霜威拂面豸袍悬，突兀声华柱后传。\n鼓吹春风吴苑外，楼船秋水越城前。\n芝兰竞发曾游地，桃李偏滋旧植年。\n珍重鱼盐聊驻节，抟空鹏翼上甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵总戎之北平","author":"胡应麟","text":"大纛高牙照彩虹，除书遥下建章宫。\n前驱半杂三河少，别队新分六郡雄。\n騕袅登台呈逸步，麒麟开阁待殊功。\n平津突兀钧天上，吐哺能无忆转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张参知睿父过访赋赠","author":"胡应麟","text":"委巷萧疏卧绿苔，高牙俄报上公来。\n溪头弭节临三洞，海畔扬舲度七台。\n此夕星辰垂草莽，当年日月扈蓬莱。\n长杨一代推题赋，白首能怜问字才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴文仲使君八首 其一","author":"胡应麟","text":"大纛飞扬驻草莱，孤查寂寞坐莓苔。\n花溪乍识元戎过，叶县争传令尹来。\n雾涌双龙呈玉匣，云驱六骥上瑶台。\n中原匠石凋零尽，敢向灵光惜赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴文仲使君八首 其二","author":"胡应麟","text":"百尺清潭理钓缗，双鱼何意问沈沦。\n维舟敢道菰芦客，入幕偏容草莽臣。\n海峤尘沙埋骏骨，天都日月觐龙鳞。\n峥嵘八座家声在，香案能无捧玉宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]