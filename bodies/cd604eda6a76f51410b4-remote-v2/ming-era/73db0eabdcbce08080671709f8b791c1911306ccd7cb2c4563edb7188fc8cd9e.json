[{"title":"瑞雪三首 其一","author":"孙承恩","text":"帝锡丰年兆，春乘雪意来。\n花明禧圣院，琼积望仙台。\n飒沓来无尽，氤氲扫不开。\n九重昭泰象，万室仰尧阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞雪三首 其二","author":"孙承恩","text":"朔雪千林盛，连天舞素英。\n依依巧作态，脉脉故无声。\n似在空明界，浑疑白玉京。\n感孚歌帝德，鼓舞贺升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞雪三首 其三","author":"孙承恩","text":"滕六恭承事，天孙巧散花。\n积来无玷垢，飞处故欹斜。\n精意通三极，欢声恊万家。\n皇风应有象，春色浩无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无逸殿直宿次韵三首 其一","author":"孙承恩","text":"奏币神君殿，祈灵太乙坛。\n愿均一雨施，遍洒万方宽。\n月映觚棱直，风生碧树寒。\n感恩惭补报，忧思浩无端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无逸殿直宿次韵三首 其二","author":"孙承恩","text":"展礼瑶为席，呼雩玉作坛。\n仰知圣心切，忧待阜民宽。\n禁鼓传清漏，絺衣生薄寒。\n甘霖应不远，只在五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无逸殿直宿次韵三首 其三","author":"孙承恩","text":"肃肃紫垣静，微微香篆清。\n即看尘事远，顿觉道心生。\n开阖从玄化，忧勤仰圣明。\n不胜颙望切，数起问阴晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈佩昌赴龙游博士二首 其一","author":"孙承恩","text":"剑水闻名日，燕台会面年。\n文场淹白首，世业只青毡。\n夜雨弦歌静，秋风苜蓿鲜。\n知君敦古谊，志不在腾骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈佩昌赴龙游博士二首 其二","author":"孙承恩","text":"弱冠承庭训，长笺念子贤。\n齐竽惭我滥，楚璞得谁怜。\n世事看更局，年华岁逝川。\n无端怀旧意，相对重凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周莱峰出守平度州二首 其一","author":"孙承恩","text":"旭日都门道，含悽送子行。\n巳多场屋谊，况是故乡情。\n柳拂春郊骑，花明海国城。\n云霄初发轫，期尔树声名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周莱峰出守平度州二首 其二","author":"孙承恩","text":"爱尔文章士，而今民社司。\n慎惟邦本重，莫厌簿书卑。\n郡古弦歌在，春深草木熙。\n圣贤从政理，须记讲求时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答宣龙田自况之什二首 其一","author":"孙承恩","text":"会面从今日，闻名自昔年。\n抟鹏时久拟，屈骥古来然。\n赋见安贫志，文辞润笔钱。\n蹇予聊托契，造次敢言缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答宣龙田自况之什二首 其二","author":"孙承恩","text":"老我催颓渐，惭犹逐少年。\n官情聊漫尔，野性故依然。\n浅薄叨天眷，尸鳏愧俸钱。\n何当返初服，习静息诸缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴玉田赴进贤训导","author":"孙承恩","text":"旭日照吟鞭，薰风吹客船。\n洪都新教铎，圣井旧风烟。\n慷慨歌今日，迟回惜别筵。\n勉旃端轨范，兹地固多贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨东川赴监利训导","author":"孙承恩","text":"迢递荆门道，看君领教行。\n家从故乡挈，士喜近郊迎。\n云散狮山出，风来鹤泽清。\n仲宣楼尚在，作赋继休声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送戴瀛冈赴奉新训导","author":"孙承恩","text":"戴子吾邦彦，书香奕世传。\n风云孤素志，事业付青毡。\n岳暝云埋麓，江春水拍天。\n袖中有龙剑，把赠帝城边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱后斋赴河南","author":"孙承恩","text":"大省看筮仕，名门克象贤。\n忆逢君少日，今见我衰年。\n自是源流远，非关雨露偏。\n玈翁有遗迹，试问洛人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和放棹即景兼述怀三首 其一","author":"孙承恩","text":"落日扁舟远，微凉生葛袍。\n沙添新涨浅，帆倚夕阳高。\n世故看谁是，风期不易消。\n扣舷一长啸，秋色满江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和放棹即景兼述怀三首 其二","author":"孙承恩","text":"宦业全无着，羁怀日更加。\n有书消白昼，无句咏青霞。\n雅调弦流水，悲歌剑拂花。\n茫茫沧海峤，回首未应赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和放棹即景兼述怀三首 其三","author":"孙承恩","text":"尘外黄金贱，尊中白发微。\n昔贤多遁世，老我巳忘机。\n明月如堪约，白云何日归。\n浮云应勘破，吾欲问渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"致政归","author":"孙承恩","text":"休假经年疏，归来此日情。\n秪缘忧老病，敢谓薄荣名。\n击壤诗频讽，思玄赋欲成。\n柴门稀客过，吾亦懒将迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北溪耕读卷","author":"孙承恩","text":"卜筑清溪上，衡门枕稻区。\n桑麻深绕屋，烟水绿平渠。\n倚杖歌黄鹄，呼儿具小车。\n石林堪晚对，随意阅残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园中漫兴","author":"孙承恩","text":"小圃闭深春，居閒适性真。\n治蔬思抱瓮，尝笋欲开尊。\n老矣无高兴，稀哉几故人。\n林泉聊尔已，不复问朝绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避寇入城寓居官廨","author":"孙承恩","text":"避寇此来居，兼旬伏暑馀。\n高城鸣柝后，落日闭门初。\n风月自清景，帘栊非故庐。\n草堂时在望，竹影上窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰侄孙友仁昌祖居宅俱罹寇燬二首 其一","author":"孙承恩","text":"祖屋成灰烬，倭夷很毒情。\n我闻增慨叹，汝定泪纵横。\n已已无深痛，徐徐可再营。\n才能年更富，宁患业无成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰侄孙友仁昌祖居宅俱罹寇燬二首 其二","author":"孙承恩","text":"世事宁非数，人生合有灾。\n几年劳积累，一日变灰埃。\n出谷莺非托，迁巢燕亦猜。\n但看勤植立，天意有安排。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜居","author":"孙承恩","text":"避寇来城郭，仓皇就此居。\n敢思求巨丽，幸得免忧虞。\n草舍邻翁过，蔬畦稚子锄。\n地偏情未稳，吾自忆吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城卜值重午","author":"孙承恩","text":"海上旌旗满，人间令节临。\n乱离天不顾，樽酒我何心。\n井邑炎烟遍，村墟杀气深。\n逃移思骨肉，何处觅来音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盗贼","author":"孙承恩","text":"盗贼何充斥，咆哮剧虎狼。\n焚烧靡孑遗，逃窜各仓皇。\n骨肉稀音问，交游有死亡。\n忧来频怅望，清泪湿衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大雷雨二首 其一","author":"孙承恩","text":"忽听轰雷震，浑疑大地摇。\n滂沱鸣急澍，挥霍走狂飙。\n玄化杳难测，天威默自昭。\n凶顽嗟已甚，应得尔魂消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大雷雨二首 其二","author":"孙承恩","text":"枭翥与鸱张，难当尔跳梁。\n嗟无罴虎将，恨纵猰㺄狂。\n罪恶己盈贯，神明自鉴量。\n将无轰霹雳，万里净炎荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寇退述怀","author":"孙承恩","text":"闻道倭夷退，贪残志巳充。\n官军犹假息，将帅可言功。\n天意含糊里，人心战惕中。\n莫教桑梓地，再见燎烟红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乱后出城二首 其一","author":"孙承恩","text":"刁斗声犹在，疮痍痛正深。\n田庐迷故业，飘泊慰归心。\n生理浑无赖，催科况可任。\n感时添老泪，到处一沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乱后出城二首 其二","author":"孙承恩","text":"变乱岁时更，皇天未洗兵。\n连村才一突，十口半无生。\n宿鸟无栖托，孤嫠接道行。\n艰难勤救死，愁听说催徵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕示儿侄三首 其一","author":"孙承恩","text":"城上更传急，尊前烛燄红。\n即听数刻过，便是一年终。\n酬酢看昆弟，愁嗟独病翁。\n不知今夕饮，再得几番同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕示儿侄三首 其二","author":"孙承恩","text":"老泪伤时落，衰颜借酒红。\n岂期乡国难，竟底岁年终。\n戚戚怀先德，茕茕成老翁。\n却思色养日，笑语几回同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕示儿侄三首 其三","author":"孙承恩","text":"秪有愁容惨，宁看笑靥红。\n试从千古论，谁驻百年终。\n世难能无历，童儿易得翁。\n他年今夕会，须忆此宵同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜儿侄俱属和","author":"孙承恩","text":"身外尘缘浅，堂前酒盏深。\n笑予多感慨，喜汝渐能唫。\n敢忘先人德，应怜后裔心。\n醉来还自慰，膝下玉森森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸孙四首 其一","author":"孙承恩","text":"汝辱冠裳列，常儿已不同。\n名称须务实，令始要图终。\n笃教非吾力，劳之在汝翁。\n百年先世德，期汝振家风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸孙四首 其二","author":"孙承恩","text":"学海今初涉，工夫未有涯。\n即看童子耳，敢以大人期。\n澹薄吾无遗，承传汝自为。\n祖孙原一气，爱汝故孜孜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸孙四首 其三","author":"孙承恩","text":"吾祖肇文基，严亲益大之。\n我承犹强勉，汝父仅支持。\n到汝应愈重，投艰实在兹。\n世途多偪侧，振起是男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸孙四首 其四","author":"孙承恩","text":"草有薰莸异，人因习染殊。\n今朝同队侣，他日几贤愚。\n白日联翩去，青春递续催。\n再看三二载，便是大人为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸侄孙二首 其一","author":"孙承恩","text":"见尔诸孙子，瞿然感老迂。\n只今叨显达，鲁历苦工夫。\n立志须超世，承家惟业儒。\n男儿期远大，毋忘祝桑弧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸侄孙二首 其二","author":"孙承恩","text":"济济青衿子，不殊同队鱼。\n朝来适相过，见后几长嘘。\n问学登天似，工夫掘井如。\n青年毋易掷，当为惜居诸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠董子元移居次张月鹿韵二首 其一","author":"孙承恩","text":"之子清修士，悠然大隐情。\n移居原避乱，习静为逃名。\n庭有鸣阴鹤，林多求友莺。\n通家真忝窃，羡尔著书成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠董子元移居次张月鹿韵二首 其二","author":"孙承恩","text":"羁旅相过日，论文数启予。\n风尘聊对酒，水竹且谋居。\n乐志宜公理，垂惟拟仲舒。\n旧林烟月在，归梦未应疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石湖诸公小会草堂二首 其一","author":"孙承恩","text":"草舍曾期聚，文轩此屈临。\n清游达人事，好客老夫心。\n共惜交情厚，休辞酒盏深。\n民艰方日甚，感叹几沉唫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石湖诸公小会草堂二首 其二","author":"孙承恩","text":"竹牖与茅堂，居然野老庄。\n高人时枉顾，衰白顿生光。\n径草浮晴翠，林花送晚香。\n杯行莫停手，天际易斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸君有和再答","author":"孙承恩","text":"眼底兵戈满，尊前涕泪多。\n时艰合有此，天道竟如何。\n至治思隆古，愁怀几逝波。\n相看俱白首，莫厌数相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前韵再呈石湖 其一","author":"孙承恩","text":"俗子无交涉，名贤辱眷临。\n辞荣元亮兴，忧国少陵心。\n黄鹄翩其逝，沧波流日深。\n阳春有高调，伫听一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前韵再呈石湖 其二","author":"孙承恩","text":"雅志樊生圃，遥惭裴相庄。\n青云谢冠绂，白首映辉光。\n尊酒深浮碧，炉薰细袅香。\n连阴剧愁思，今日快晴阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书三诗翁集后三首 其一","author":"孙承恩","text":"昔有三诗叟，唫情月共高。\n百年忘富贵，千古擅风骚。\n挂剑谊何极，怀贤心独劳。\n万安桥下水，日夜自滔滔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书三诗翁集后三首 其二","author":"孙承恩","text":"迈往耽诗志，穷瘝守义身。\n不缘好事者，虚负苦心人。\n伯道悲无后，原思独患贫。\n招提行乐处，怅望几长嚬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书三诗翁集后三首 其三","author":"孙承恩","text":"白日坐超忽，青山自古今。\n眼前无耇老，越世得遗音。\n后死吾何及，斯文谊独深。\n无能永翁誉，俯仰为沉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别方伯刘公","author":"孙承恩","text":"圣主敷皇极，名臣重保釐。\n千年开泰运，八叶际昌期。\n公也山川秀，巍然柱石资。\n萧何元应昴，傅说又骑箕。\n德盛人规范，才隆帝简知。\n毕公终辅相，方叔暂藩维。\n令出风雷动，恩行雨露滋。\n百司遵约束，多士仰光仪。\n老手便繁剧，宠才大展施。\n劳心虽惕励，退食每逶迤。\n勋业今如此，台衡实在兹。\n讵云追丙魏，直可继皋夔。\n望重心逾下，官崇礼益卑。\n故交虽久暌，葑菲正无遗。\n贱子惭庸劣，穷居叹蹇奇。\n壮心空突兀，末路竟差池。\n鄙俗方嗤哂，高情独奖推。\n赤心真自托，青眼匪公谁。\n德较丘山重，恩同鞠育慈。\n岂惟勤佩服，直欲镂肝脾。\n未信终沦落，还当策钝疲。\n埋光羞匣剑，脱颖志囊锥。\n落落乾坤大，悠悠岁月迟。\n焉能心怏怏，祗是守规规。\n自许当雄奋，从来耻伏雌。\n酬恩尤有地，报德岂无时。\n行矣真难负，天乎不可期。\n愿公多福祉，阅世享期颐。\n搦管纾情愫，当缄更忸怩。\n莫能名大德，聊用识微私。\n欲别心尤恋，临岐意独悲。\n西风吹去棹，翘首又天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登第后表谢释菜日俱值雨有作","author":"孙承恩","text":"一滴春瓢雨，知时集建章。\n才看飘禁籞，又见湿宫墙。\n云拥中天近，烟浮碧水长。\n皇仁应浩荡，圣德与汪洋。\n襟佩诸生肃，箫韶九奏张。\n恩波期共沐，化雨故难忘。\n葵藿心偏耿，羹墙意独忙。\n许身今日始，稽首颂时康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送少傅刘老先生展墓归","author":"孙承恩","text":"元老扶三圣，台衡领百司。\n山川钟秀气，宇宙际昌期。\n率土瞻神观，中朝肃令仪。\n文章呈黼黻，藻鉴炳蓍龟。\n任栋材偏称，为圭玉不疵。\n匡时心独赤，忧国鬓成丝。\n一代经纶著，千年德业垂。\n九重资说砺，百辟守萧规。\n地望方隆重，松楸切孝私。\n恳陈披悃愫，归去荷恩慈。\n诰锡明廷命，黄焚秘阁辞。\n光荣覃梓里，传颂遍耄倪。\n谢事应多暇，怀高谅未宜。\n乾坤双眼阔，出处寸心知。\n霖雨苍生望，盐梅圣主思。\n商山与洛水，莫久滞旌麾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王司马致政归","author":"孙承恩","text":"八座声华旧，三朝见老成。\n际时依日月，接履上台衡。\n圣眷怜耆硕，公心忌满盈。\n累陈丹悃疏，去结赤松盟。\n旭日明驺从，秋风引旆旌。\n天空红叶下，川渺白云平。\n访旧容僧款，寻幽带鹤行。\n乾坤看晚节，造化与完名。\n恋阙心犹赤，忘机梦自清。\n汾阳初解组，司马暂辞荣。\n出处随舒卷，功名任重轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨奉郡伯喻惕庵","author":"孙承恩","text":"两月苦无雨，郊原生白烟。\n君侯重民隐，轸念独勤惓。\n窃笑焚巫妄，惟师罪已贤。\n精禋极昭格，诚恳契幽玄。\n小暝惊俄尔，浓云忽沛然。\n卧龙起深壑，晴日暗居廛。\n淅沥初堪数，奔腾遂欲颠。\n银河横迥望，瀑布注高檐。\n江鸟飞应尽，林花湿更妍。\n黍禾青被陇，畎浍绿盈川。\n巳慰三农望，宁无一物偏。\n潜孚德政在，阖辟化工全。\n贱子三冬计，东原数亩田。\n有怀同野老，拭目待丰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野舟诗","author":"孙承恩","text":"放浪非吾志，烟波且自由。\n虽知川可济，巳与世无求。\n泛泛同江苇，飘飘类野鸥。\n行依渔艇乱，静向鹤汀收。\n明月蒹葭浦，清风杜若洲。\n笑歌天漠漠，濯足水悠悠。\n鱼鸟供诗兴，云峦豁醉眸。\n入天迷远近，逐浪泛沉浮。\n倦后凭舷卧，狂来倚棹讴。\n放怀真自得，高兴若堪俦。\n逋叟西湖胜，龟蒙笠泽幽。\n郎官谪仙醉，赤壁老坡游。\n宁用如神技，聊齐泛海桴。\n垂纶情亦称，击楫事堪忧。\n富贵非从好，风波任所投。\n乾坤双短棹，身世一浮沤。\n自是无拘碍，谁能管去留。\n沧浪有馀兴，吾道尽优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祁通府入觐","author":"孙承恩","text":"旭日开新霁，长风吹旆旌。\n天空红叶落，江阔白云平。\n玉帛君臣礼，扳留父老情。\n诗歌南浦绿，棹拂晚山青。\n驿路分吴甸，河山接帝京。\n人瞻千里月，鹤共一天清。\n勋业看前哲，才猷范后生。\n九重方侧席，好去立虞廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观奕","author":"孙承恩","text":"空堂手谈谁，剥啄惊户外。\n旁观似予閒，当局真敌对。\n势多楚汉强，地割鸿沟界。\n敛拓互阖辟，错纵明向背。\n攻围盛行阵，隐伏妙机械。\n奇出风雨交，冥搜鬼神会。\n争雄不相能，夺隽讵容贷。\n时移方一着，妙处得三昧。\n坡云方优游，我欲无胜败。\n疾呼为太狂，赪颜亦颇隘。\n一挫何须馁，敛枰还可再。\n兹艺岂犹贤，饱食圣所戒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚宜楼","author":"孙承恩","text":"结构幽栖处，江天欲暮时。\n翠屏看更好，虚阁坐偏宜。\n霞映千峰乱，潮随一棹移。\n横空翻暝色，绝岛起孤吹。\n倦鸟投林速，归云到峡迟。\n喜看群动息，觉与众缘遗。\n忽忽浮生事，悠悠千古思。\n且将娱晚兴，聊复撚吟髭。\n胜事君多会，高情我最知。\n愧非陶谢手，细写入新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]