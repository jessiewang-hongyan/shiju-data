[{"title":"舟中夜感兼怀河源李绍汤","author":"张天赋","text":"孤舟细雨夜敲时，唤起游人枕上悲。\n忠孝未能身力践，君亲徒有念头思。\n圣贤门户且行却，天地风云半合离。\n遥忆美人何处是，槎江夫子旧相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡江城下早发漫兴","author":"张天赋","text":"孤舟冻雨乱敲篷，惊醒凄然梦未终。\n报晓鸡声茅店月，冲寒梅信雪花风。\n才华鸣世滕王阁，天地储精五老峰。\n仰止岂能甘目画，尼丘翘首望山东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊舟大萍洲登萧公庙吹壁间胡文穆公韵","author":"张天赋","text":"腰带黄金映紫袍，巍峨庙貌倚空高。\n九重霄汉垂灵庇，万丈银山息浪涛。\n赫赫声名收汗简，绵绵血食洁牲毛。\n祠前拜颂琼台祝，纷若祈庥不浑劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰元日与竹斋濂川二子饮于馀干县苦竹港舟中早自瑞洪发","author":"张天赋","text":"年华又转甲辰春，天地宁甘是旧人。\n草木有情迎淑气，江山无约遇嘉宾。\n一帆风月资行舫，万里桃源喜问津。\n谩向沧浪咨游乐，如流春酒令催频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次醴陵刘两塘进士韵","author":"张天赋","text":"倾盖孔程千载后，话交风雨十年前。\n方敦帝里陈雷睦，遽失张家李郭船。\n怅望楚天人去也，相思纸帐梦凄然。\n乾坤淑气应回泰，打算梅花五百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游浏阳石霜寺","author":"张天赋","text":"双手排云上石霜，三年无补卧浏阳。\n青山云锁乾坤别，红树风摇日月长。\n俗吏率真忘潦倒，老天知我恕疏狂。\n马蹄明日长安路，万里罗浮客子忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次长沙府庠友吉桂峰韵","author":"张天赋","text":"清昼庭阴覆绿苔，儒仙跨鹤九霄来。\n丰神壁立倾人仰，谈笑风生喜帐开。\n名位尚期天北斗，履声端拟殿东阶。\n此生相见嗟何晚，谩托东风报好怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次夏双桥诗教韵 其一","author":"张天赋","text":"天缘高士过南洲，轩冕铢尘蔑五侯。\n孟氏一生卑假伯，孔明三顾待真刘。\n无边锦绣胸襟塞，万斛烟花眼界收。\n从古绿窗归嫁晚，娇痴终不学红楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次夏双桥诗教韵 其二","author":"张天赋","text":"骨肉斯文遍九州，半甘嘉遁半封侯。\n道原终古推尼父，说苑何人道向刘。\n缺陷世情添我恨，公评月日羡君收。\n无端一枕渊明梦，飞上罗浮第一楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和永丰坤简韵寄答之","author":"张天赋","text":"秋风喜听雁南飞，翻恨当年信息稀。\n风雨昔同家国话，襟期曾拟圣贤归。\n壶中日月真堪乐，物外神仙孰识奇。\n楚客却怜天各一，醴兰湘水梦频思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入分宜谒高士夏双桥兄","author":"张天赋","text":"摆脱樊笼裹我粮，清风相送入宜阳。\n溪头杨柳徐君宅，眼底青山四皓庄。\n莫笑鹿门无活计，须誇邺架有书香。\n西溪溪上双桥稳，并驾安车入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺詹巡检考满","author":"张天赋","text":"除书荣俸莅罗岗，万里孤城托俊良。\n草莽震惊藏虎豹，宪台委任带风霜。\n三年喜报仪封政，五位行看宠命光。\n试问锦旋订何日，欲凭长揖饯河梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬子秋科送从侄伯珍赴科场兼嘱三儿云","author":"张天赋","text":"柳汁当年已染衣，槐黄今值选场期。\n文章天地分经纬，鸾凤云霄展羽仪。\n老货却怜无好价，奇才何幸有明时。\n佳期洗耳泥金报，拚醉黄苍酒百卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅九月十日登神光山纪事","author":"张天赋","text":"九日先茔荐野殽，不妨十日谩登高。\n黄花迟结百年约，白发豪吟两鬓摇。\n千古神光应复气，一泓墨沼可濡毫。\n茱萸永戴多花实，此际重游不惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送雷司训建安","author":"张天赋","text":"与君相别意如何，吾道随时任捲舒。\n鲁酒数杯三叠曲，清风千里一船书。\n紫芝云外山无主，红蓼滩头水有鱼。\n踏上武夷峰顶月，茫茫天路夜窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邑侯陶公诗来次韵答之","author":"张天赋","text":"芦荻潇潇正系船，忽闻金石耳旁边。\n病心频觉消残渴，醒眼何须读古编。\n明月碧霄无点滓，虚窗清夜若空禅。\n太平有象今朝见，人乐熙皞鼓腹天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋承刘斋默李和山有约不来病怀一律","author":"张天赋","text":"秋色平分月正高，故人千里秪神交。\n苍龙矫矫飞层汉，病鹤依依守旧巢。\n霜刃若怜无用剑，璠桃羞见昔花袍。\n刘伶李白空相约，今夕知谁共酕醄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欧阳吉峰侵晨过访值未起床而去次李五榕韵答之 其一","author":"张天赋","text":"纷纷谁识此情真，天地斯文骨肉亲。\n倦鸟已还幽郁处，化龙端属老成人。\n炭添炉火常教热，心尽葩蕉又展新。\n窗外梅花明月夜，思君不见梦君频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欧阳吉峰侵晨过访值未起床而去次李五榕韵答之 其二","author":"张天赋","text":"世途难免半高低，从古传云七圣迷。\n宝剑未曾经血刃，龙驹终岂蹶霜蹄。\n功名自是无凭㨿，赋命原来有速迟。\n看到芙蓉开口笑，万花零落总凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次游岩韵赠送郭彩峰理问之任云南","author":"张天赋","text":"神骏长驱出傅岩，洗尘梅雨弄微纤。\n春容薇省花开锦，秋色滇池水赛蓝。\n使节高风来竹马，恩波浪暖起春潭。\n冈头侧耳泥金报，坐笑黄堂位列三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴思斋甲家彻帐还新建","author":"张天赋","text":"乡曲斯文同气味，宦还更值是年家。\n君为倡道文中子，我亦知人鲍叔牙。\n一贯浑融宣父妙，六经破碎汉儒差。\n此行细认先天信，驿路梅梢处处花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次王云从陈连湖李澄江刁时泉登神光韵","author":"张天赋","text":"雨后青山色更新，登临都是赏花人。\n墨池化雨看鱼跃，夜气回光赛月明。\n松涧石梳云母发，烟霞鸟弄洞天春。\n高冈羊角须臾起，九万联飞两翮轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次前韵","author":"张天赋","text":"古人易地皆无异，廊庙山林隔几重。\n酒食困从歌舞里，风流落在画图中。\n乾坤太极为根柢，原道西铭是祖宗。\n辽海鹤归明月上，盘桓人笑抚孤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠程乡林乐平上舍","author":"张天赋","text":"曾诵南宫赋美人，才华踪迹类元禛。\n堪誇窈窕奇成配，可是风流妙入神。\n夙世有缘题叶句，前生原是探花身。\n人间好事须双喜，伫看嫦娥缔约新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅州舟中写怀","author":"张天赋","text":"好景兴来容易得，彷如风月送将来。\n白云似我无心出，黄菊随人有分开。\n地僻莫劳天外鹤，口酸常啖雪中梅。\n从前却悔忙忙过，对酒高歌不计杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汀州承荆府教授胡介石兄自浏教谕升","author":"张天赋","text":"闽广接壤非异土，楚浏握手又同官。\n秋风君得莼鲈美，末路吾惭蜀道难。\n卧石碧霞诗骨冷，归舟明月水花寒。\n临流忍割今朝别，春树江云两地看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午夏都宪檄催边饷浏仓素储一旦发之","author":"张天赋","text":"边报频催馈饷兵，披衣冲晓发南盈。\n白云远补青山缺，黄鸟初蜚绿树声。\n许国素心怜蠖屈，唱筹五夜杂鸡鸣。\n孤臣万里疮痍境，拭目何时见太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浏有四仓曰东丰西满南盈北赡乙巳冬奉藩司委徵正赋北瞻有怀","author":"张天赋","text":"东作西成丰且满，南盈北赡粒烝民。\n斯民三代原无异，世道于今又一新。\n梅报小春潜地复，月移疏影露天真。\n客窗喜听鸡鸣蚤，欲学当年起舞人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"催徵写怀","author":"张天赋","text":"闻说浏阳百谷丰，迩来九室十家空。\n多因遭旱连年苦，何况催科一并同。\n鞭扑欲加怜菜色，稻粱无计问河东。\n排云欲向青皇诉，楚水吴山路不通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日示儿曹","author":"张天赋","text":"曾闻墨向染丝悲，谁笑悲丝是老痴。\n圣域奋然容易到，路头差却便难期。\n梦中讲梦真成梦，非处求非盖补非。\n丰蔀决开天日晓，羹墙亲切见尧眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墨池吊古次韵","author":"张天赋","text":"风景轮云又一新，閒游长忆探花人。\n湖田水打回亨泰，天子龙飞喜圣明。\n夜气光涵峰顶月，墨池香浸翰林春。\n先生濯濯灵如在，试问今谁是后身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题清白堂","author":"张天赋","text":"隔断红尘四杳然，堂开冰玉翠相连。\n秋波澄彻渊潜地，虚室光生寂静天。\n铁汉楼头风瑟瑟，水晶帘外月娟娟。\n座中一个人如玉，打算梅花五百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次节推南林兄云南所寄韵三首录一","author":"张天赋","text":"六龙驾上春如海，喜沐恩波下九重。\n弦诵洋洋声彻夜，冰壶皎皎月当中。\n形名定国谁称屈，家学横渠独得宗。\n百卉眼前叹零落，参天仰止老乔松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄惠阳叶两峰","author":"张天赋","text":"齐昌桥上别元夫，闽楚迢迢雁信疏。\n同出却怜非上路，相看应笑负当初。\n烟花眼底风情薄，夜梦梁间月色孤。\n诗礼过庭清暇处，盛唐诗有续编无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答杨柳溪先生","author":"张天赋","text":"桃花浪煖太塘春，欢动高堂白发人。\n天地恢宏开寿域，竹松苍翠挺丰神。\n壶中自我风光别，眼底从渠世态新。\n列鼎五云膺禄养，优游晚景乐天真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永慕双亲","author":"张天赋","text":"白首高堂逝不还，寝门长叹五更寒。\n熊莲抱我终身苦，桑梓留人百岁看。\n冻雨每添慈鸟恨，黄金不易綵衣欢。\n鼻头未了浮生气，一度追思一度酸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题邵尧夫聊以书怀","author":"张天赋","text":"肝肺谁收天下春，风流千古打乖人。\n浩歌声里皆天籁，安乐窝中尽谷神。\n杨柳枝头风味暖，梧桐梢上月华新。\n空中楼阁层层起，物我同观混一真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽李周学秀才","author":"张天赋","text":"炎荒屈指几英才，月旦评归周学来。\n准拟明秋蟾桂折，俄惊此日玉山颓。\n诗书声绝灯花落，天地愁分猿鹤哀。\n正气不随今日散，梅花依旧占春魁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽西昌老友萧汝静","author":"张天赋","text":"总角文章擅大家，白头湖海梦江槎。\n风云笔阵多年力，桃李门墙到处花。\n皇阁未曾垂竹帛，玉楼何事美才华。\n昔年谈易今成幻，愁向西江泪日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黄南浦二尹","author":"张天赋","text":"带病冈头望墨池，墨池龙去没归期。\n神光不见登仙屐，武进空流堕泪碑。\n世路脚头应自了，乾坤逆旅莫相疑。\n年年洛社西风里，野草閒花满眼悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵从侄元吉生子","author":"张天赋","text":"积德于门原有素，一朝天降宁馨儿。\n丹山从此昭灵异，国宝应堪稳护持。\n廊庙喜添新柱石，祖宗还复旧根基。\n广寒老桂萌芽发，伫看香飘次第枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次黄龙坡大尹义城精舍十景录五首 其一 义城衍芑","author":"张天赋","text":"五季中原鼎沸时，风雷驱石堑山溪。\n千门文物亨嘉境，一面英雄保障旗。\n丰草饱沾春雨露，鹿门培植老根基。\n也知善庆绵绵远，簪组蝉联讵有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次黄龙坡大尹义城精舍十景录五首 其二 西湖渊水","author":"张天赋","text":"杭州颍水罗浮下，并此卢东一色秋。\n沆瀣洗颜宜旭日，沧浪带月趁鱼舟。\n波恬点水双双燕，春暖忘机对对鸥。\n画舫微茫人不见，梅花吹彻笛声浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次黄龙坡大尹义城精舍十景录五首 其三 前峰翠微","author":"张天赋","text":"当户南山景色幽，摩空巀嵲最高头。\n玄云连合地天泰，旭日照临光焰浮。\n先垄满堆崇马鬣，祥飙终古绕松楸。\n昼檐清昼珠帘捲，笑指烟光一望收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次黄龙坡大尹义城精舍十景录五首 其四 映波彩虹","author":"张天赋","text":"从古舆梁济不通，吉州又跨赵州虹。\n光涵碧玉环中影，柳拂青铜镜里风。\n华表月明归白鹤，水乡云静隐青龙。\n德星今在卢东聚，驷马频过盖世雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次黄龙坡大尹义城精舍十景录五首 其五 亨衢履矢","author":"张天赋","text":"衣锦乘龙喜气新，风流高谊重乡邻。\n扬鞭直向幢溪路，甃石旋随骥足尘。\n周道共瞻君子履，金牛空费五丁勤。\n迩来骢马骧云去，芳躅绳绳启后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次双湖歌风台","author":"张天赋","text":"千古寒烟锁汉台，赤符曾此辟蓬莱。\n丹书冷落黄河约，血刃腥红白日埃。\n帝业阿谁能独力，乾坤几度纵多才。\n沛亭落日千林月，杜宇声声带旧哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠门生李元卿来学南还","author":"张天赋","text":"负笈穿云辱再来，梧风柳月笑徘徊。\n共谈上古先天学，忍酌长亭别酒杯。\n努力未应沉壮志，乘时端拟听春雷。\n逢人莫吝花消息，一度春风一折梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"束书归闽为次厓林宗师公子才甫题同安人","author":"张天赋","text":"雏凤原来集海涯，丹山寻穴骈还家。\n先天妙诀归行李，万里长风破浪花。\n乔木已瞻参碧落，桂香端拟吐英华。\n德星遥向同安聚，奕叶重光更有誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入浏阳三都写似卜守约守愚子贤三秀才","author":"张天赋","text":"踏入三都景色新，旷然一个洞天春。\n溪头流水源头活，眼底青山画底神。\n边境无风嘶战马，龙门有客问通津。\n天王欲树中兴业，梦卜须求姓吕人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽徐师傅庚辰夏到县未上任不幸即世","author":"张天赋","text":"浙水驰名卓荦哉，五云深处拜官来。\n杏坛未播春风教，宦况俄成疾祸胎。\n来路马行归路梦，贺声人换吊声哀。\n迢迢旅衬知何地，故国寒烟锁夜台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽罗外父西塘翁","author":"张天赋","text":"年高德邵两兼隆，眼小江山几万重。\n纯粹德容犹羡玉，直端心地比良弓。\n一朝魂赴渺冥地，举世人嗟矍铄翁。\n泣血数声天外远，不知何处觅行踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上广州沈节推","author":"张天赋","text":"一团春在越城中，雷震今朝处处通。\n寒谷唤回三月暖，东风吹散百花红。\n苍天不为韶光禁，好景行看万里同。\n物物直教归化育，令人特地仰神功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒙沈节推往长乐和复仇侯命再吟以似之","author":"张天赋","text":"蓝袍几破泮庠中，万里青云路未通。\n点额再三淹志久，让人多少看花红。\n灯前祇自甘孤陋，亥豕凭谁辨异同。\n今日幸逢夫子铎，一声深荷订顽功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拜题家君竹山小隐别号 其一","author":"张天赋","text":"天地无拘有我翁，南阳前世是真龙。\n家居兀兀巍巍下，身在青青翠翠中。\n凉透午阶风细细，光生虚谷月溶溶。\n万重云影潇湘梦，不入千官拥玉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拜题家君竹山小隐别号 其二","author":"张天赋","text":"万丈崔巍森玉台，自招琴鹤住山隈。\n疏枝漏月虚生白，高节凌云翠作堆。\n彩凤舞风乘暖日，蛰龙翻土待春雷。\n琅玕敲动西华枕，日报平安次第来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题白石道人","author":"张天赋","text":"万叠青山万卷书，洞云深处道人居。\n坚刚在石心无异，圆活还君石不如。\n扣角笑人歌灿烂，扫苔愧我梦安舒。\n璠玙不必荆山问，此地包藏自有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"味兰别号","author":"张天赋","text":"拨破芳菲紫陌尘，幽林镇已认天真。\n同人心利言如臭，楚畹春融德与新。\n剑叶插空知正气，玉芽冲地见通神。\n坐忘直与香浑化，方是乾坤第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王宝山别号","author":"张天赋","text":"开辟嶙峋价重高，阿谁季世结神交。\n玉藏空谷虚生白，雨过苍崖色放娇。\n卧石不知人扣角，舞松长见鹤归巢。\n层峦碧出青霄外，扰扰风尘不染毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王养晦别号","author":"张天赋","text":"谁向隆中守钝迟，葆光渊默待明时。\n寻游朱子庵门路，玩索明夷象传辞。\n三尺太阿藏玉匣，一轮红日浴咸池。\n伫看提起蛟龙断，照耀江山景物熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种兰别号为南海刘民威题","author":"张天赋","text":"南国谁开九畹田，灵苗栽培不知年。\n秽除荆棘芳根盛，活引方塘夜气全。\n清晓露凝珠箔翠，三春日暖玉生烟。\n秋高次第天香几，吹散幽香遍八埏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和竹庵","author":"张天赋","text":"兀兀丛中兀兀亭，天开玄洞喜深沉。\n雷轰白日围龙□，风捲晴梢听凤吟。\n卧隐竹林同劲节，坐忘天地一□□。\n竹山光共庵头月，照见肝肠道义深。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]