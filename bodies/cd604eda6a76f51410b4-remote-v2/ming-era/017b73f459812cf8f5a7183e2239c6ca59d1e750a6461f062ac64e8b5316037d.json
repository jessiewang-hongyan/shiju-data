[{"title":"九日方山登高","author":"郑善夫","text":"方山五片石，巉巀七千寻。\n气象恒嵩敌，风云岁月深。\n百年大梦寐，九日此登临。\n愿卸红尘累，嵓栖长道心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"耳鸣","author":"郑善夫","text":"官司忽失职，双耳自今聋。\n尽日闻天鼓，何时听么虫。\n向人艰应答，于世类冥蒙。\n未老神俱耗，勋名涕泪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄华玉","author":"郑善夫","text":"潇洒顾吏部，为邦日渐多。\n人心兴礼乐，世事入风波。\n剡曲舟堪诵，濠梁道不磨。\n向来巾子雪，堂构合如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绣岭晓行","author":"郑善夫","text":"绣岭行不极，盘山霄汉长。\n谁将钓渭意，同寄雁湖傍。\n野宿雀芋饭，岩居木槿墙。\n晨征莫相失，云气正茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金山纪胜","author":"郑善夫","text":"扬子宅前水，东溟势欲吞。\n乾坤真浩荡，岛屿尽儿孙。\n石舞风波作，龙归日月昏。\n平生爱飞动，长剑倚昆崙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集胜果寺分得眠字","author":"郑善夫","text":"寺阁兹辰会，宾朋尽世贤。\n云山兼胜日，岩壑得高眠。\n移席竹林晚，题诗花蕊妍。\n燕鸿何意绪，来往各翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游烂柯山同杨节使二首 其一","author":"郑善夫","text":"太末徐王国，青霞洞府名。\n江山共吾子，风雨若平生。\n锦树岩扉净，秋杯云鸟明。\n应悲看棋者，柯烂未忘情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游烂柯山同杨节使二首 其二","author":"郑善夫","text":"岝㠋干峰下，天开姑蔑墟。\n地灵蕃玉蕊，神至响云车。\n未破人间局，先翻石室书。\n茅靡入道术，岁晚莫踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"风雨过南关","author":"郑善夫","text":"元亮东归日，长途菊正斑。\n宁辞彭泽米，早得匡庐山。\n雨势秋崩峡，云阴昼阨关。\n回思凤凰阁，吾已得生还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠姜建州","author":"郑善夫","text":"南迁为隐吏，山水兴难降。\n客至丹青阁，时翻白玉缸。\n谏书留御榻，惠政及邻邦。\n若访汉阴老，知余是姓庞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李曲江","author":"郑善夫","text":"李子新为令，南迁百粤州。\n梅花过庾岭，吹满曲江头。\n鹏运天池暮，槎停星汉秋。\n丹砂好寄与，早晚上罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄倪南雄","author":"郑善夫","text":"京华相别后，闻尔亦南图。\n笑解银鱼绶，坐分铜虎符。\n山蟠五岭厚，俗到百蛮殊。\n千里梅花使，春风好寄余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王文辉游武夷","author":"郑善夫","text":"王郎不肯住，脱屣武夷山。\n学道心长苦，寻仙鬓欲斑。\n鱼龙淹海日，鹅鹳厉天关。\n何限沧洲兴，希君共一扳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送公衡韶州省觐兼怀倪南雄李曲江二首 其一","author":"郑善夫","text":"尔往宁亲日，千花春未稀。\n此行无道路，綵戏及庭闱。\n王勃才名盛，孙登世事微。\n如逢始兴守，道我钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送公衡韶州省觐兼怀倪南雄李曲江二首 其二","author":"郑善夫","text":"拟此过逢数，何期迅别愁。\n青山问庾岭，沧海近韶州。\n猿狖声堪听，桄榔叶正稠。\n风烟易春暮，须及曲江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮春湖上","author":"郑善夫","text":"沧溟春欲暮，湖上芳草生。\n风烟吹不断，遥带凤凰城。\n万事兵戈外，孤臣藜藿情。\n何当拊神物，谈笑扫欃枪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"詹文化","author":"郑善夫","text":"报尔龙头选，才名我昔闻。\n凤凰今有象，骐骥直空群。\n黄散经纶事，金縢礼乐文。\n更期射三策，早晚奏明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏公谨","author":"郑善夫","text":"四海夏公谨，平生道未疏。\n岂为青琐客，不问白菟裾。\n帝业维新日，皇舆草昩初。\n看君抱经济，献纳定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴宗道","author":"郑善夫","text":"小戴青云器，明经正显行。\n以兹先后甲，知尔庙廊情。\n樗栎人俱弃，凰麟世必清。\n经年无一字，何以慰平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林克相","author":"郑善夫","text":"厓老本钓侣，经纶今若何。\n自来科目选，秪为利名多。\n江汉波初定，夔龙道不磨。\n南冠有词赋，万古卿云歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梁日孚","author":"郑善夫","text":"梁鸿终自洁，禄仕暂栖迟。\n混世名为佛，修身早得师。\n儿童送我意，俯仰别君时。\n何日长安市，相过筇一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"方思道","author":"郑善夫","text":"方郎天下士，慷慨古人稀。\n刎颈交惟女，同心结到谁。\n江湖同苦别，霄汉独雄飞。\n远愧朝歌叟，中兴淹桂枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汪希周","author":"郑善夫","text":"崇阳汪武选，识汝自京华。\n拊剑平江汉，经年别室家。\n飞云收虎帐，战马返龙沙。\n长揖青门外，何人善种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林德敷","author":"郑善夫","text":"圣后乘元化，江湖思致身。\n君居财赋地，况作庙堂臣。\n勋业时堪就，鲈莼兴莫新。\n何当逐狐鼠，同看帝城春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郑伯兴","author":"郑善夫","text":"吾宗贤吏部，昔往鹿门山。\n应世身难卧，探玄意自閒。\n山公启事近，庞老㩦家还。\n余亦隆中隐，接君床下颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苏天秀","author":"郑善夫","text":"吾怜苏太乙，磊磈长安豪。\n钓罢渭川猎，名驰天汉曹。\n言余亦善士，拊己愧时髦。\n徐稚平生义，还山解佩刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"姚元肖","author":"郑善夫","text":"接手燕昭国，倥偬十载前。\n乌栖空绕树，鹏转自横天。\n抚世缘知己，抡才后少年。\n君看越石父，客礼竟虚传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"顾九和","author":"郑善夫","text":"昆山顾学士，十载绾银鱼。\n勋业天人策，行藏封禅书。\n与君成去住，谋道竟何如。\n先帝焚香在，皇情可但虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陆子渊","author":"郑善夫","text":"成贤真此地，瑶席尔司成。\n述作回中古，机云愧后生。\n华亭鹤正唳，蓬海雁长征。\n结谊风尘上，看君万里情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄刘希尹吏部兼怀薛君采二首 其一","author":"郑善夫","text":"长安薛子宅，对尔诵骊驹。\n云树怀良友，风尘愧腐儒。\n看山费日月，忧国阻江湖。\n方朔金门下，藏身道不孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄刘希尹吏部兼怀薛君采二首 其二","author":"郑善夫","text":"薛郎成小隐，旧宅定荒芜。\n万事将双泪，经年无尺书。\n身随梅福去，病与马卿殊。\n白日调龙虎，飞腾意有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙门西象顶望海","author":"郑善夫","text":"浩荡窥南纪，长天望正繁。\n北风青啸海，高浪白浮山。\n舟楫思兼济，云霄怅独还。\n何当溯牛女，重扣紫皇关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岊江送黄伯固大理赴白下","author":"郑善夫","text":"大理平生友，相看涕泪存。\n谏书君最切，往事我难论。\n放逐心无尽，岩廊道已尊。\n愿将金石志，长报圣明恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人之邺","author":"郑善夫","text":"浩荡夷亭意，经过邺下来。\n王门占玉节，春日上铜台。\n游子牵多梦，高堂候举杯。\n蘼芜江畔草，应挽使船回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"明妃曲","author":"郑善夫","text":"明妃初出塞，宛转意何穷。\n上马琵琶曲，流悲入汉宫。\n自言妾命薄，万里去和戎。\n今日蘼芜草，青青向陇中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"木虚过青野堂夜坐","author":"郑善夫","text":"小坐同吾子，荒斋寡四邻。\n林鸺鸣近夜，山月迥随人。\n太乙青藜杖，先生乌角巾。\n中宵莫说剑，恐益鬓毛新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访吴山人隐所","author":"郑善夫","text":"脱屣吴居士，寻君江水遥。\n云房生夜气，薜牖散春潮。\n榻静闻空籁，情高梦九霄。\n从兹毕灵宝，不赴小山招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答陈天游","author":"郑善夫","text":"淑气回南纪，文星傍省堂。\n犹县沧海月，留照紫薇郎。\n学道防衰晚，愁时应帝王。\n思君直咫尺，一夕鬓毛苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖中寒食","author":"郑善夫","text":"湖上逢寒食，行行云日迷。\n林花相映发，只似武陵溪。\n远水清烟并，高杨黄鸟啼。\n年年对芳草，古意满城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答林贞孚主客","author":"郑善夫","text":"忆自秋风起，虚传奉使回。\n未捐池上佩，翻失陇头梅。\n尧舜垂衣日，班杨奏赋才。\n黄金散朝士，知上礼贤台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴德翼佥宪赴阙","author":"郑善夫","text":"使君今赴阙，春兴定翛然。\n江汉黄华动，风云锦䌫牵。\n星移南斗下，路引北堂前。\n愿有华封祝，天朝寿万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏夕青野堂卧月","author":"郑善夫","text":"海月团芳夜，园庐引绪风。\n琴书栖榻晏，岩壑与人同。\n尚泽南山雾，终怀北极枫。\n黄虞忽到梦，伊郁卧隆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入海","author":"郑善夫","text":"沧海鸥波外，云艘迥自航。\n大江沉马腹，密雨湿鱼梁。\n未及星槎远，那知天汉长。\n渔竿变孤志，翻愧紫荷裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答顾华玉参政","author":"郑善夫","text":"吾怜顾长康，吏隐近沧浪。\n学道通元窍，蛟龙翊尔翔。\n云回朱鸟国，花照紫薇堂。\n授我冥筌意，相期天汉长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闭门","author":"郑善夫","text":"经岁避尘缘，时参道德篇。\n柴门背海闭，鸥鸟受人怜。\n桂树栽成实，松花采作团。\n微官浑忘却，唯记孝皇年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻荐","author":"郑善夫","text":"逋客晚知几，西山言采薇。\n长安三丈雪，而我赏心违。\n隐处无人识，荐书何事飞。\n冥鸿天万里，空遣弋人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早秋怀晋安诸子","author":"郑善夫","text":"摇落茭湖晚，湖边鶗鴂鸣。\n秋风吹桂树，一伫越王城。\n榻有南州重，人兼卫玠清。\n还闻刷羽翮，看尔共蜚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄赠石室山人","author":"郑善夫","text":"安期持世界，挟策西入关。\n吴老遵牛渚，乘槎钓不还。\n行藏元气里，弓剑彩云间。\n何时留玉舄，去入蓬莱山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中","author":"郑善夫","text":"避地抛铜墨，风霜岁屡更。\n那期凤鸟至，亦遣伏雌鸣。\n久病丹心苦，中年白发生。\n如何张仲蔚，却扫卧升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出塞曲二首 其一","author":"郑善夫","text":"黄金雕鹊印，白马出榆林。\n瀚海行人绝，阴山杀气深。\n汉恩长北损，边骑日南侵。\n一唱丁都护，三军泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出塞曲二首 其二","author":"郑善夫","text":"大王开绝域，上将喜边功。\n塞外风烟异，军中苦乐同。\n龙旂凋朔气，虎帐卧沙风。\n未系单于颈，横戈意气雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"克相过草堂别去余病垂死诗来见怀呻吟中答之","author":"郑善夫","text":"喜女文章贵，相过成笑言。\n追陪憎病骨，风雨别柴门。\n会苦青衫湿，情多白发繁。\n形骸已近死，谁复与招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中哭伯固二首 其二","author":"郑善夫","text":"去年白下去，送汝芋原陂。\n今日湖边问，俾余双泪垂。\n终为谏议鬼，竟失帝王师。\n已矣先朝事，伤哉此盛时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈少府镧","author":"郑善夫","text":"吾怜陈少府，独抱明月珠。\n五载官闽土，春风生向隅。\n县知水薤意，频握玉麟符。\n霄汉声名早，看君受剑车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张起溟约过草堂为传卒所误","author":"郑善夫","text":"君是峨眉秀，余惭南海琛。\n并期歌白雪，何止断黄金。\n接手难如此，浮生感独深。\n闽关及漳水，鱼腹莫教沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答林白石大参","author":"郑善夫","text":"归钓龙溪水，君胡亟失时。\n岂因白石烂，竟赋绿衣诗。\n拙抱江湖愧，贤于弼亮宜。\n重华迹已远，吾道欲何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七月望游水西白鹤寺乘月泛岘江","author":"郑善夫","text":"爱尔东林社，乘秋到蕊宫。\n招邀满童冠，歌罢舞雩风。\n鹳鹤黄庭莫，巾袍白露中。\n西江上云月，归艇意何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送季明德应召赴阙二首 其一","author":"郑善夫","text":"接手为兄弟，交期共死生。\n云逵易相失，三宿晋安城。\n海内风尘切，秋边鸿雁鸣。\n飞腾未时莫，万里好长征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送季明德应召赴阙二首 其二","author":"郑善夫","text":"相别无一语，相观情自閒。\n风云感壮士，江海散秋颜。\n道已干时禁，人须涉世艰。\n去乡莫草草，迟尔阳明山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"琅琊王墓下作","author":"郑善夫","text":"田文全盛日，泪下雍门弹。\n王氏千秋后，劳歌玉树残。\n寝园生兔穴，疑冢奠龙盘。\n万仞莲花色，关河望已难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大田读伯固起溟见和之作怅然怀答二首 其一","author":"郑善夫","text":"读尔怀沙赋，潸然系我思。\n当年分即死，此日已云迟。\n社稷还唐介，江山哭子期。\n才贤世有几，况及圣明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大田读伯固起溟见和之作怅然怀答二首 其二","author":"郑善夫","text":"朅来张仲蔚，秀句日逾多。\n岂不思君子，其如长路何。\n商霖怜我在，谷口喜人过。\n终愧箕山隐，无能守薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南山赠林迁于比部","author":"郑善夫","text":"忆自随三釜，同歌沧海篇。\n何期傍九日，得结碧山缘。\n江汉兵戈外，风烟鱼雁前。\n相看未忍别，更上木兰船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莆口之败福宁兵最无纪律大纵掠金以致肝脑涂地赋诗伤之","author":"郑善夫","text":"闽粤何多难，兴漳师未休。\n虎豺行白日，天地泣清秋。\n欲捣群凶穴，须枭败将头。\n兵贪法半至，遗恨福宁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"剑州赠陈待用太守","author":"郑善夫","text":"郁彼神仙府，云骖迥莫扳。\n言将五裤手，满弄九华山。\n紫盖风尘表，黄堂霄汉间。\n因君觅神物，剑水有龙蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸂鶒","author":"郑善夫","text":"鸂鶒无拘碍，浮游锦石傍。\n雌雄互饮啄，毛羽割阴阳。\n已得沧洲趣，宁思天汉翔。\n并生大化里，幽独阐文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送罗复之","author":"郑善夫","text":"圣寿齐天地，臣衷效海山。\n面陈安瘼疏，头耸触邪冠。\n玉帛奔重译，衣裳济万官。\n不胜恋阙处，时事尚多艰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀南湖旧居","author":"郑善夫","text":"南湖不可到，幽事自涟漪。\n田父春相遣，邻翁暮与期。\n烟霞隐薜荔，风日晒鸬鹚。\n岂待清商发，花时有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"双凫","author":"郑善夫","text":"汎汎长依渚，飞飞不度岑。\n却无黄鹄志，但有白鸥心。\n烟水知音旧，鱼虾得食淫。\n自从叶县令，来往五云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"向晓","author":"郑善夫","text":"河影忽不见，东方方小明。\n晨鸡许市客，秋管海边营。\n起舞者谁子，飘零独此生。\n矇昽听金钥，封事转驰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]