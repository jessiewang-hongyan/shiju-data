[{"title":"赠李枣强","author":"宋登春","text":"泉石元同调，辞官几岁华。\n锄云开药圃，看月到僧家。\n诗敌双峰回，门从五柳遮。\n秋兰自可佩，何必问丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜独坐咏怀","author":"宋登春","text":"露洒青梧湿，天寒鸿雁鸣。\n星云摇海戌，砧杵动山城。\n久客三秋梦，怀人独夜情。\n故乡渺何许，华发岁残生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆州杂诗六首 其一","author":"宋登春","text":"选胜楼居好，凭高发兴奇。\n江云春自袅，山月夜相宜。\n头白还词赋，身闲且岁时。\n沧洲吾道在，花鸟莫深期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆州杂诗六首 其二","author":"宋登春","text":"寒渚依凫雁，春城自薜萝。\n登高初拟赋，望极欲悲歌。\n落日燕京□，浮云楚徼多。\n一尊□□□，何处吊湘娥。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆州杂诗六首 其三","author":"宋登春","text":"流落燕州日，疏狂楚国身。\n无金难作客，多病况逢春。\n白发犹公道，清尊不负人。\n相逢无狗监，投策莫于秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆州杂诗六首 其四","author":"宋登春","text":"惆怅荆州牧，新诗此见招。\n渚花无落日，岸水□平潮。\n寒雨沽琴岳，春风试洞箫。\n盘云双白鹤，似欲待王乔。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆州杂诗六首 其六","author":"宋登春","text":"水呈沧海赋，山送白云篇。\n洪渺鹏腰客，虚无鹤背仙。\n清樽随世计，芳树自流年。\n闭阁吾将老，何人问草玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚归山寺二首 其一","author":"宋登春","text":"月静花林僻，琴清竹院闲。\n幽兰芳短砌，独鹤下空山。\n鸟道排云入，松门映雪关。\n儿童夜归去，采得紫芝还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚归山寺二首 其二","author":"宋登春","text":"鹤懒眠白石，云深护紫芝。\n僧闲翻贝叶，月冷浸莲池。\n鹫岭秋寻遍，虎溪夜度迟。\n梅花伴成梦，霜色澹孤帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀呈刘五","author":"宋登春","text":"剑骑任飘零，天涯作客星。\n年华双白鬓，秋梦一浮萍。\n返老寻丹诀，怡情诵鹤经。\n故人刘季子，相对眼能青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安僧舍","author":"宋登春","text":"种竹青门外，分花杜曲边。\n关云一以卧，陇月几回圆。\n晓梦悲乡树，秋风满岳莲。\n囊空金错冷，时诵马蹄篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游别山东知己","author":"宋登春","text":"池浸芙蓉月，堂含松叶烟。\n搴衣坐白石，隔竹弄幽泉。\n客子玄洲梦，佳人窈窕篇。\n相思隔云海，秋满木兰船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"远游","author":"宋登春","text":"寥落悲歌客，含兰迟美人。\n湘云迷五岭，关月度三秦。\n驾鹤行吴市，停车赋洛神。\n倦游思卧海，垂老钓玄津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日寻李□师","author":"宋登春","text":"野田荣卉木，春木抱仙家。\n树暖游蜂狎，风轻舞燕斜。\n闲门通小径，高柳映明霞。\n日宴山中客，开关扫落花。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日登李仲培山楼二首 其一","author":"宋登春","text":"地僻云侵榻，帘疏风满楼。\n霜寒篱菊晚，雁度渚莲秋。\n满箧新诗草，横矶旧钓舟。\n清尊随处醉，万事付江鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日登李仲培山楼二首 其二","author":"宋登春","text":"零落十年客，迢遥百尺楼。\n霜寒龙塞晚，风急雁门秋。\n独戌三家市，长河一夜舟。\n村活还可醉，相对有双鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日发上党游洛别刘五","author":"宋登春","text":"晨发上党路，行行漳水湄。\n计程梁路远，回首晋云迟。\n抱玉岂求识，含兰欲待谁。\n高楼倘引望，花月两相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五云洞","author":"宋登春","text":"洞里仙人去不归，洞口碧桃秋自肥。\n石坛露滴松花冷，夜深山鬼薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉中偶兴","author":"宋登春","text":"春酒壶中烂似霞，青童学炼白朱砂。\n醉来起舞松庭月，三□临风玉树花。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣二首 其一","author":"宋登春","text":"自君之出矣，弃妾渔阳西。\n不及野田雀，双飞还双栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣二首 其二","author":"宋登春","text":"自君之出矣，肠中车轮转。\n欲向梦中寻，路长春梦短。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词三首 其一","author":"宋登春","text":"行行长千里，采采春田花。\n郎君相问讯，大树是侬家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词三首 其二","author":"宋登春","text":"小姑茜红衫，大姑郁金裙。\n把手促侬去，两两拜湘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词三首 其三","author":"宋登春","text":"妾居杨子津，郎在清江浦。\n一自与郎别，十日五风雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠柏谷山人","author":"宋登春","text":"窈窕柏谷原，中有食柏客。\n不笑亦不语，往来无行迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野菊","author":"宋登春","text":"野菊多幽姿，含香待谁发。\n落英我欲餐，芳心无遽歇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侠客","author":"宋登春","text":"跃马青门道，酣歌击玉壶。\n腰间藏匕首，谈笑入秦都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嬿婉谁家女","author":"宋登春","text":"嬿婉谁家女，搴荷戏芳渚。\n薄笑三春晖，扬眉千仞羽。\n怀中连城珠，皎皎为谁许。\n可人期不来，日暮徒延伫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游留别刘元和","author":"宋登春","text":"东风习习芳草柔，欲去不去情悠悠。\n赠剑何年刻玉字，对君一笑说沧洲。\n宜教白发悲春晚，乍可黄金买笑愁。\n此目别离那可道，相思长绕晋山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别刘五高秀才游洛阳","author":"宋登春","text":"春风袅袅桃花开，客馆飞飞燕子来。\n游子一朝辞此去，故人千里梦频回。\n上党小姬白苎舞，襄阳美酒黄金罍。\n与君共把拔□倒，风流不数洛阳才。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荡子妇","author":"宋登春","text":"妾家高楼艳阳春，花枝柳条两鲜新。\n花笑柳条空袅袅，不能绾系荡心人。\n花容随貌改，柳叶上眉颦。\n惟忧叶落花飞尽，敲碎冰壶歌彩云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江亭对雨有所怀","author":"宋登春","text":"轻烟一带起蘋洲，日暮澄江送客愁。\n细雨黄花何限泪，思君一夜楚云秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮王太史山庄","author":"宋登春","text":"郢上文章伯，山中太史家。\n养年常种药，闲日但修花。\n竹涧明秋水，松林落晚霞。\n儿童怜醉客，瀹鼎夜烹茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书王侍御山房","author":"宋登春","text":"云白山青柱史居，茅堂满贮玉函书。\n鹿车暇日携闲客，半亩清塘自网鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韩山","author":"宋登春","text":"采秀来韩山，韩山石崔巍。\n不见韩众鹿，满山秋云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"远游二首 其一","author":"宋登春","text":"浩浩中天立，如何是丈夫。\n乘槎须远去，不买水精奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"远游二首 其二","author":"宋登春","text":"廓落孤云合，英雄一剑知。\n欲寻龙伯国，濯理旧竿丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芙蓉篇赠西安黄孝廉","author":"宋登春","text":"晔晔芙蓉花，盈盈濯绿水。\n素影漾清漪，佳人乃相似。\n肯学中园柳，漫逐春风起。\n愿为并蒂花，托根碧池里。\n我本燕狂人，而来偶君子。\n匣中有宝书，礌礌心相许。\n日暮望高楼，含情不得语。\n笑弄黄金珰，愿言酬知己。\n弩力扬高翮，名成访绿沚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游王氏郭北山楼","author":"宋登春","text":"径草连村合，山楼带郭横。\n开尊招野客，倚树听流莺。\n露自花间滴，云从石上生。\n几回渔篴响，素月岭头明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日寄怀刘经府","author":"宋登春","text":"江海十年梦，关山万里情。\n悲歌怜宋玉，谈笑忆公荣。\n目逐秦云断，愁随越鸟生。\n北园松菊好，今夕共谁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春登钧州西台简党中丞","author":"宋登春","text":"汝阳春色望中来，词客长吟重自哀。\n身世百年宜对酒，家山千里且登台。\n寒云细草雁初至，斜日孤城花自开。\n白发中氶能好事，仲宣流落几时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日登黄鹤楼怀刘四皋","author":"宋登春","text":"黄鹤楼前江水流，故人何处木兰舟。\n双双燕子南飞去，瑟瑟芦花铁邃秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠五岳山人","author":"宋登春","text":"上国有一土，披褐日来往。\n口诵南华篇，心存出霞想。\n提携赤松徒，五岳姿奇赏。\n调弄农皇琴，和彼流泉响。\n赤水觅玄珠，穷神寄象罔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀唐子瑞","author":"宋登春","text":"萧寺秋深冷石门，山人寥落卧松云。\n黄花芳砌临风看，玄鹤鸣皋傍晓闻。\n楚醴醉来空作客，商□□罢正思君。\n何时彩笔开缃帙，花下鸣琴共夕曛。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓北固山谩兴","author":"宋登春","text":"自剪朱霞补白袍，倚天还诵碧云谣。\n山前流水万里去，石上长松百尺高。\n清磬时鸣玄圃玉，洞箫新斸拂天稍。\n采兰踏破春江月，笑弄银钩戏紫鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜园亭小集","author":"宋登春","text":"春夜弄琴拂落花，满壶春酒煮春霞。\n醉倚琼奴□其夜，笑指花稍月未斜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上寻张炼师","author":"宋登春","text":"隔松闻桂杵，玉粒捣玄霜。\n水月明笙鹤，江云冷石堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中夜月送客","author":"宋登春","text":"松里夜禽声关关，松上女萝垂石阑。\n天风吹衣月皎皎，紫芝歌罢仙翁还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同四勿王孙游兖东兰若","author":"宋登春","text":"四勿主人王之孙，春寒唤客倒清尊。\n梅花照眼欢意发，酒未到日诗脾温。\n野鹜无心还可意，山鬼多伎何足论。\n高歌一曲明月上，醉后不闻僧敲门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙堂山","author":"宋登春","text":"赤足仙人跨白鹿，道逢授我东华箓。\n山下绯桃三百颗，食了还向瑶台宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"烧药","author":"宋登春","text":"笑歌山鸟外，飘思海云孤。\n袖出金鹅蕊，烧药许松奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游长庆观","author":"宋登春","text":"古殿依岩立，平桥策马登。\n抱琴寻郢客，得句寄山僧。\n杖外云霞度，坐中芳草艿。\n荆门秋水静，旅雁下江陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿郑氏园亭怀白石山人","author":"宋登春","text":"云泉满谷碧桃肥，白石山人去未归。\n春至不知芳草绿，月明松下鹤双飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠东隅逸人","author":"宋登春","text":"东隅老人能养拙，春来酿酒摘松叶。\n有时半醉临风前，独抱瑶琴啸海月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登文星台","author":"宋登春","text":"春酒百壶春日开，东风扶我上文台。\n乾坤无处着双眼，秖对云山舒壮怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉中书长安酒楼","author":"宋登春","text":"黄鹤还来舞醉乡，调歌不用紫云娘。\n一瓢连月挥春瓮，大醉长安几百场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜宿三清阁三首 其一","author":"宋登春","text":"红云长绕玉皇家，炉里丹成结紫霞。\n琴冷月明孤鹤怨，冰壶昨夜浸梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜宿三清阁三首 其二","author":"宋登春","text":"道人不解尘机事，爱访吹笙骑鹤仙。\n歌□素芝云外落，一钩梅月晒冰弦。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜宿三清阁三首 其三","author":"宋登春","text":"遥看玉雪洒长天，隔匣飞光宝剑寒。\n江月山云频有约，先生归去着黄冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别友归山中","author":"宋登春","text":"杖挑一束青囊书，走向山中觅云蕨。\n何处幽人深忆君，白猿霞外啸萝月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠方士","author":"宋登春","text":"无何老人悬玉壶，挥云笑月出苍梧。\n袖里丹砂三百颗，时化黄金入酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出门行","author":"宋登春","text":"山有云，水有澜。\n壮士出门弹危冠，抱剑羞歌易水寒。\n一朝笑解盘龙带，十年零落黄金镮。\n惟遗双宝珠，忧来不忍看。\n愿采金光草，令人驻朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太晖观晚眺","author":"宋登春","text":"霞月生西岭，秋云澹暮山。\n鸟啼仙阁近，花落羽人闲。\n白发非生事，黄金岂驻颜。\n孤怀犹未惬，长啸下松关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小筑","author":"宋登春","text":"杖屦秋来健，山林老去偏。\n野花疏短砌，水叶满平田。\n鸡犬多阳尽，人家橘柚连。\n江深寒小筑，栖泊自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十三夜郡楼宴集","author":"宋登春","text":"高楼落日秋冥冥，西风吹送燕鸿声。\n半江杳蔼月初上，万壑虚无云自生。\n拊槛欲窥白兔药，持杯空复紫芝情。\n谁家今夜横长笛，杨柳拆残怨未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙津送林孝廉还白下","author":"宋登春","text":"为送王孙去，踟蹰芳草边。\n莺啼娃妓馆，花拂孝廉船。\n易醉金陵酒，长歌宝剑篇。\n相思重回首，郢树隔风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"妓馆送人还金陵","author":"宋登春","text":"楚水湘云桂树秋，黄金未尽大刀头。\n西风谩薄班姬扇，南浦愁看燕子楼。\n鸡塞梦回怜玉佩，龙关月冷忆貂裘。\n明年郢上还芳草，夹岸桃花好泛舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日集楚雄楼怀书","author":"宋登春","text":"沱水燕关忆壮游，短衣孤剑老荆州。\n天涯纵酒逢青眼，马上看枫掉白头。\n日暮饥乌还绕树，烟寒古堞自深秋。\n江空鸿雁无消息，千里相思月满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集郡楼感赋","author":"宋登春","text":"客计萧条白发生，江山去住一鸥轻。\n山云漠漠长含雨，江草萋萋空复情。\n楚老巳忘白雪调，巴童还解踏歌声。\n犹怜憔赣餐英者，落日登楼赋未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久雨","author":"宋登春","text":"秋作田家苦，黄梁夜自舂。\n衡茅难久雨，桑柘易凄风。\n懒织从新妇，荒锄教小童。\n诗成还独笑，天地一衰翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过罗道士山房","author":"宋登春","text":"自煮胡麻饭，看松闭石关。\n绿芝眉宇古，白鸟道身闲。\n剑秘屠龙术，囊探伏虎丹。\n不须择地隐，随处是青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月七日龙山感赋简苏郡丞","author":"宋登春","text":"残日凋山叶，凉云脆渚芹。\n空怜黄菊酒，不醉白头人。\n秋水还堪赋，高台易怆神。\n去来随老马，疏散任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]