[{"title":"山中避暑和游元封夏日閒居十首 其二","author":"佘翔","text":"习静来初地，赍粮不满囊。\n恒河晴可濯，祗树午偏凉。\n已证传灯录，何论辟谷方。\n摊经消永日，更宿赞公房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其三","author":"佘翔","text":"垂老猖狂态，当年契若翁。\n利名捐物外，贤圣辨杯中。\n阴剩门前柳，材留爨下桐。\n羲皇何不作，枕石咏南风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其四","author":"佘翔","text":"眷此清凉界，诸天聚火云。\n地含秋水碧，岩拥绿苔纹。\n龙藏空中见，曹溪定里闻。\n幽偏堪养拙，猿鹤若为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其五","author":"佘翔","text":"何必探沧海，尼珠得比丘。\n年虽过牧豕，心已老盟鸥。\n纨扇堪题咏，酒杯但拍浮。\n斋心浑不染，剥啄厌相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其六","author":"佘翔","text":"碧树栖群雀，清风咽暮蝉。\n登山怜有屐，挂壁笑无弦。\n混世青门业，劳生绛县年。\n何年超苦海，聊此学逃禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其七","author":"佘翔","text":"地僻宜消夏，入林已浃旬。\n云迷丹壑迥，雨濯绿荷新。\n伏枕多尝药，披裘且负薪。\n歌声出金石，原宪未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其八","author":"佘翔","text":"刹自前朝建，谁参最上乘。\n无生惟佞佛，有发也呼僧。\n榻为栖云下，楼因啸月登。\n此中元空洞，何爱亦何憎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其九","author":"佘翔","text":"偃蹇松林下，停云有所思。\n关山游子梦，风月美人期。\n松覆云阴薄，藤垂日影迟。\n沉忧何以遣，赖有手中卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中避暑和游元封夏日閒居十首 其十","author":"佘翔","text":"乾坤无尽意，长啸辟支巅。\n邻父频携酒，官家少索钱。\n摘瓜终老圃，种秫仅荒田。\n身世甘枯槁，浮名安足传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其一","author":"佘翔","text":"青山吟谢眺，白马赋陈思。\n却厌梧桐落，兼闻蟋蟀悲。\n才心空自老，古调竟谁期。\n若问柴桑计，萧条五柳枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其二","author":"佘翔","text":"人生非金石，摇落重含情。\n林暝萤初度，汀寒雁数声。\n科头山欲瘦，濯足水偏清。\n枯槁寻常事，安知身后名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其三","author":"佘翔","text":"地僻人稀到，清秋昼掩关。\n世随沧海变，心与白云閒。\n烟淡萦长薄，林疏出远山。\n忽闻樵唱起，鸦带夕阳还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其四","author":"佘翔","text":"万籁空中发，凄凉枕上闻。\n道穷元不病，身隐总焉文。\n来去澄江月，浮沉薄海云。\n垆头无浊酒，何以遣尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其五","author":"佘翔","text":"著屐寻丘壑，乾坤一眺中。\n终南多捷径，颍水邈高风。\n避世青门拙，问年绛县同。\n草?怀耿耿，帝座岂堪通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其六","author":"佘翔","text":"草际沙鸥集，江村事事幽。\n才非堪傲世，赋敢附悲秋。\n风冷初飘箨，云低半入楼。\n无营耽旷达，嵇阮或同流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其七","author":"佘翔","text":"百岁嗟驹隙，无劳较短长。\n但?人醉月，莫问鬓沾霜。\n道与渔樵狎，情难犬马忘。\n诵诗哀岵屺，泪满白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其八","author":"佘翔","text":"一间容膝地，何处想楼台。\n土木形全毁，星霜鬓屡催。\n飘零荷叶佩，潦倒菊花杯。\n不是求羊辈，蓬门莫浪开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其九","author":"佘翔","text":"水天浑一色，彷佛见真吾。\n自爱逃空谷，深惭涉畏途。\n松风吹草榻，海月挂冰壶。\n裘马飞扬态，从他竞五都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒居和张隆甫韵 其十","author":"佘翔","text":"文园抛绿绮，病渴却为谁。\n味似兰初臭，心悲石可移。\n南阳龙欲啸，东海钓方垂。\n山水知音者，寥寥未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其一","author":"佘翔","text":"春风何淡荡，疏拙恋閒居。\n一著登山屐，如乘下泽车。\n明农忧旱涝，读易悟乘除。\n偃蹇从吾道，无劳问索虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其二","author":"佘翔","text":"科头过岁月，草泽一閒人。\n织屦终违俗，卖浆偶比邻。\n时名龙卧稳，春梦蝶飞频。\n同病怜嵇阮，垆头日可亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其三","author":"佘翔","text":"浊酒耽陶令，新诗拟惠休。\n人惊双鬓短，花簇数枝稠。\n负汉终投阁，怀秦独倚楼。\n吾惭三老后，曳杖亦名鸠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其四","author":"佘翔","text":"垂钓无他事，沙边繫小舠。\n愁肠思蹈海，病色起观涛。\n积雾炊烟湿，奔泉激石号。\n寰区多震荡，何计定金敖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其五","author":"佘翔","text":"身世看如此，三洲只敝庐。\n持斋寒食后，脩禊暮春初。\n丘壑孤云迥，琴樽一榻馀。\n倦来时隐几，抛却养生书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其六","author":"佘翔","text":"薄暮收鱼笱，呼童掩竹关。\n乘风非北牖，步月即东山。\n湖海登楼倦，园林抱瓮閒。\n美人安可望，厌说落花班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其七","author":"佘翔","text":"几年无战伐，何事亟传烽。\n谁借军中箸，长驱海上艟。\n檄堪清瘴疠，佩欲解芙蓉。\n不尽忧时意，荒村听暮舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其八","author":"佘翔","text":"岸帻松林下，衔杯水竹前。\n清狂非玩世，沉醉近逃禅。\n风雨催春色，藤萝逗暝烟。\n前身疑毕卓，也作瓮头眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其九","author":"佘翔","text":"白首机心息，何妨识者稀。\n糟丘堪自老，斥鴳岂高飞。\n豪侠千金尽，穷愁万事违。\n首阳人不作，薄采故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日幽居十首和薛景登韵 其十","author":"佘翔","text":"悬鹑依陋巷，妻子任长贫。\n高蹈怀千古，劳生笑此辰。\n乾坤宽荷锸，草莽窃沾巾。\n五柳青青色，依然不惹尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄怀郑景爱","author":"佘翔","text":"溪流喧入枕，落日漫怀人。\n偃蹇俱违俗，艰危各问津。\n春从多病过，鬓为苦吟新。\n何日囊山社，寻僧重结邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄游元封","author":"佘翔","text":"心交淡似水，夙昔别郊坰。\n梦断天涯雨，愁多水上萍。\n关山遥度雁，节序暗流萤。\n若醉江楼月，曾知泽畔醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬杨伯海见赠","author":"佘翔","text":"万事皆春梦，浮生枉自劳。\n乾坤容此物，湖海傲吾曹。\n身后名何益，杯中兴独豪。\n醒来行泽畔，寥落楚人骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读方员外浮湘集赋赠 其一","author":"佘翔","text":"一代文章伯，风流汉子长。\n扁舟浮万里，高咏满三湘。\n游女捐琼佩，骚人制野裳。\n青云词赋色，千载并沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读方员外浮湘集赋赠 其二","author":"佘翔","text":"不读西征赋，谁知大雅吟。\n衡山秋色壮，湘水暮云深。\n二女重华泪，孤臣众妒心。\n应知摇彩笔，山鬼啸空林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日薜荔园书怀 其一","author":"佘翔","text":"一帘黄叶雨，高枕白云秋。\n天地甘贫病，蓬蒿自去留。\n鱼肠空结客，猿臂岂封侯。\n所以忘机者，临流狎海鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日薜荔园书怀 其二","author":"佘翔","text":"悲风鸣大壑，落叶满荒苔。\n倦鸟投林尽，浮云度海来。\n文章裁短褐，日月寄深杯。\n中散交游绝，柴门昼不开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日薜荔园书怀 其三","author":"佘翔","text":"一径萋寒卉，孤村逗夕阳。\n溪流环远近，树影散池塘。\n有客怀餐菊，无人问翳桑。\n端居空自好，山际白云翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日薜荔园书怀 其四","author":"佘翔","text":"秋色江村冷，兼之四壁贫。\n图书供岁月，牛马任风尘。\n蹈海齐高士，怀沙楚逐臣。\n吾生空落落，华发几茎新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮秋即事怀许希旦","author":"佘翔","text":"篱菊还堪把，萧条酒一尊。\n吟诗生白发，听鸟到黄昏。\n乱竹栖幽径，微云缀远村。\n风流高月旦，欲向汝南论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日访张明府同游山人赋 其一","author":"佘翔","text":"偃蹇嗟吾党，相过岂世情。\n途穷诗作祟，俗薄酒为名。\n月朗花阴静，风微竹影清。\n百年?一醉，刘阮或同声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日访张明府同游山人赋 其二","author":"佘翔","text":"秋气生林薄，扁舟访隐居。\n青山生计在，白眼世情疏。\n陶令贫耽酒，虞卿老著书。\n飞来天外月，不醉欲何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日集柯尧叟草堂得斜字","author":"佘翔","text":"看竹向谁家，柯亭兴不赊。\n开尊迎五柳，染翰丽三花。\n阁迥云微度，林深日易斜。\n猖狂吾党在，月下斗瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日同游宗谦余思澄泛木兰作 其一","author":"佘翔","text":"为有寻真兴，欢乘载酒船。\n溪寒云翳日，谷迥树浮天。\n龙气盘沙岸，鸥群散野田。\n共歌招隐赋，挥手弄苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日同游宗谦余思澄泛木兰作 其二","author":"佘翔","text":"千秋含朔气，天地有无间。\n风送扁舟客，云随孤鸟还。\n浮生逃浊酒，高眼傲青山。\n胜地藤萝古，游人几醉攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别方子韩 其一","author":"佘翔","text":"湖海怜同病，风尘笑独醒。\n投人双白璧，愤世一青萍。\n落魄文章壮，狂歌涕泪零。\n鹏抟还尔辈，吾道托鸿冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别方子韩 其二","author":"佘翔","text":"飘零谁下榻，偃蹇独登楼。\n交态黄金变，穷途白发愁。\n飞扬裁郢曲，睥睨看吴钩。\n莫洒杨朱泪，乾坤一叶舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别方子韩 其三","author":"佘翔","text":"司马才名大，元龙客礼疏。\n形骸长自放，词赋好谁嘘。\n把袂看时事，衔杯叹索居。\n不知萍梗迹，飘泊竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别方子韩 其四","author":"佘翔","text":"问奇曾载酒，听雨几联床。\n久客何萧索，悲歌故慨慷。\n竖儒从侧目，世路枉回肠。\n我辈风流在，何妨入醉乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别方子韩 其五","author":"佘翔","text":"才名空落落，踪迹竟栖栖。\n骏骨千金妒，羊肠九坂迷。\n人从天外别，乌似故乡啼。\n莫笑交游绝，前身是姓嵇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别方子韩 其六","author":"佘翔","text":"江湖双别泪，天地一狂生。\n有客同王粲，何人称祢衡。\n绨袍风雨色，樽酒别离情。\n君自怀明月，终偿十五城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蚤春陪舅林郡丞暨黄全之许希旦姚体恪体贞兄弟集郑氏北郭别业 其一","author":"佘翔","text":"春入柳条新，郊游岸角巾。\n青山环别业，芳树媚佳辰。\n陶谢俱词客，荆高总酒人。\n年华驹过隙，欢赏剧相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蚤春陪舅林郡丞暨黄全之许希旦姚体恪体贞兄弟集郑氏北郭别业 其二","author":"佘翔","text":"草阁背城开，何人载酒来。\n偶因随杖屦，共此破莓苔。\n韦曲寻春宴，梁园作赋才。\n留连情未已，城角暮声哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白沙谒陈宪副墓","author":"佘翔","text":"佳气纷沙渚，新阡紫翠中。\n停车悲宿草，投辖想高风。\n两汉文章色，三吴战伐功。\n嗟余后死者，流水恨无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒林和靖处士墓","author":"佘翔","text":"停舟访林壑，猿鸟若为群。\n秋色西湖水，前朝处士坟。\n山含三竺雨，柳带六桥云。\n千古遗踪在，梅花梦见君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠袁景从","author":"佘翔","text":"袁生禀异姿，偃蹇尚藜藿。\n白凤梦常悬，青云名自薄。\n悠悠海上鸥，矫矫空中鹤。\n为报草玄人，吾今亦寂寞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立秋夜呈吴子从","author":"佘翔","text":"大火西流夕，庭柯一叶飞。\n如何萍梗迹，犹与故山违。\n白露团芳草，流萤度翠微。\n凉风吹客梦，归思共依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬萧汉卿","author":"佘翔","text":"览镜惊华发，看花忆故庐。\n五湖非范蠡，四壁即相如。\n已悔雕虫技，长怀种树书。\n行藏君莫问，吾道自樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈本虞游燕访其弟本容","author":"佘翔","text":"仗剑辞吾党，翩翩向帝州。\n谢家春草梦，易水蓟门秋。\n侠气倾三辅，诗名动五侯。\n黄金燕市里，早晚索骅骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同游宗谦集马从甫草堂作","author":"佘翔","text":"清尊开别墅，慷慨命吾徒。\n子夜吴歌啭，阳春郢调孤。\n凌云名不薄，醉月气何粗。\n栗里风流在，重过有酒无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄郑兆采","author":"佘翔","text":"苦忆谈天客，江城久索居。\n山林余小隐，词赋尔长驱。\n径草萦书带，岩花映绮疏。\n九华悬片月，西望欲踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"关山月","author":"佘翔","text":"上谷风尘起，良人去不归。\n青楼多涕泪，紫塞隔音徽。\n月下秋砧急，庭前桐叶飞。\n榆关万里道，何处寄寒衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊平浦作","author":"佘翔","text":"天涯飘泊处，日暮动深情。\n身世随蓬转，关山对月明。\n西江初挽粟，南粤未休兵。\n如此艰难道，非关学请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沙阳守涨作","author":"佘翔","text":"积雨溪初涨，孤舟泊水涯。\n荒村馀鸟雀，落日走龙蛇。\n偃蹇成何事，飘零祗自嗟。\n隔林烟火起，暂向酒人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"程乡舟中","author":"佘翔","text":"乘舟来百粤，五月尚披裘。\n瘴气晴飞雨，溪风飒似秋。\n文章非屈宋，踪迹老穷愁。\n此际思乡泪，潺湲水共流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨泊作","author":"佘翔","text":"西风吹大漠，远客滞归舟。\n雨暗城阴色，云含海上愁。\n潮声来卧榻，画角起层楼。\n那得新丰酒，悠然命马周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题竹林七贤图","author":"佘翔","text":"昔时竹林人，俱是清狂客。\n逃名却尚奇，纵酒已成癖。\n天地总虚无，老庄与朝夕。\n吾生后汝期，感慨兹遗迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题余思澄超然楼次柯尧叟韵","author":"佘翔","text":"高阁清阴合，乘秋曳履过。\n凭轩穷海岳，把酒命羊何。\n落日低双鸟，微云淡九河。\n悬知占太史，座上德星多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中登江天阁","author":"佘翔","text":"积雨依山寺，凭高思渺茫。\n潮声回片石，云气暗空廊。\n地控南徐险，天连北斗长。\n凄凄何处笛，此调是沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中诸君子携歌者过饮草堂醉后赋此 其一","author":"佘翔","text":"十日嗟余病，扁舟见汝情。\n清秋来旧侣，子夜啭新声。\n天地容吾党，文章误此生。\n但教千日醉，不必问阴晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]