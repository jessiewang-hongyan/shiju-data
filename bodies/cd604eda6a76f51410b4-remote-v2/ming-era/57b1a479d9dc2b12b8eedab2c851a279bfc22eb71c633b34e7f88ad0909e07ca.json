56":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈先生林塘读书图","author":"郑真","text":"古来经训拟菑畬，谁似昌黎训阿符。\n笑我林塘风月夜，西窗梦里听咿唔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题方壶闲云潭影","author":"郑真","text":"点点遥山落影边，水光云影两悠然。\n俗尘不到林深处，一片灵台万古天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老柏图","author":"郑真","text":"山中冰雪惯曾经，百岁长存铁石心。\n江海萧萧风雨夜，倚窗祇听老龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰","author":"郑真","text":"湘山湘水思冥冥，欲访三闾问独醒。\n岩谷春芳风日透，翩翩杂佩散余馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题祝洞天云山图","author":"郑真","text":"客邸遥闻祝洞天，蓬莱岛上友群仙。\n试求鸾鹤飞升处，云在青山月满川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题枯木图","author":"郑真","text":"千章乔木挺苍苍，都入天家作栋梁。\n惟有老身无用处，岁寒岩壑饱冰霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵王理问琵琶亭夜宿","author":"郑真","text":"水流呜咽夜传更，梦里如闻弦上声。\n却笑当年白司马，青衫泪湿也多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前人韵过鄱阳","author":"郑真","text":"入云渺渺碧山重，流水茫茫万折东。\n白月倒悬星斗湿，此身如在广寒中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前人韵道出鄱阳感兴","author":"郑真","text":"鲛门岛外近仙家，夜月林深唤煮茶。\n千里宦游江海阔，晚香频忆满篱花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答史先生 其一","author":"郑真","text":"丞相精忠贯白虹，曾□经日上层空。\n百年独着山河誓，三□□承社稷功。\n龙凤宸章华阁表，貂蝉画像彩帷中。\n余芳□□□□□，制作翩翩锦绣工。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答史先生 其二","author":"郑真","text":"太白楼高隔□虹，楼前流水带长空。\n枕床不作繁华梦，翰墨原归点染功。\n□□光寒明镜里，江山春暖画图中。\n悬知蓑笠骑牛处，□意悠悠合化工。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答彦彬 其一","author":"郑真","text":"烽火春城正荷戈，□□清隐奈君何。\n山深兴逐云霞远，天涧恩承雨露多。\n尚使斯民跻泰域，未应吾道变颓波。\n百年且向东风里，酾酒当筵舞太阿。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答彦彬 其二","author":"郑真","text":"东风日日候鸣珂，为问山中近若何。\n坐对一庭桑梓合，笑看三径菊松多。\n前林日暖莺迁木，隔岸云深豕涉波。\n尚想华堂春昼永，管弦杂沓间阳阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵与袁希曾","author":"郑真","text":"先正诸孙兴未涯，东风曾记理征槎。\n关河车骑三千里，京阙笙歌百万家。\n红日当天头上近，黄埃满路望中赊。\n十年归住沧江水，犹忆金门拥翠华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵江上观灯","author":"郑真","text":"牙樯锦缆簇华灯，上下乾坤破杳冥。\n飞影倒穿千尺水，流光远散一天星。\n警传炮石边军肃，曲奏笙歌海若听。\n相国有恩民共乐，好将盛事写丹青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮写怀二首 其一","author":"郑真","text":"书床斜傍竹溪虚，千古风流梦寐俱。\n汉祖每资萧相国，齐人多赖管夷吾。\n林丛月落狐狸啸，水国天寒雁鹜呼。\n岁暮故人寥落甚，抱琴祇欲赋归欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮写怀二首 其二","author":"郑真","text":"故国山河战伐雄，新亭风景寂寥中。\n菁茅宁复供周祀，兰蕙谁能继楚风。\n瀛海边防寒络马，辕门警肃夜櫜弓。\n人间总是经纶手，彝鼎重刊社稷功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵复阎至明","author":"郑真","text":"风外游丝着面轻，困人天气半阴晴。\n董生早受春秋学，许劭新推月旦评。\n阊阖日高天宇阔，蓬莱山近水云明。\n看花看柳青春好，莫负东君万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和王子璋见贻 其一","author":"郑真","text":"玉烛光浮海宇春，夹城花柳喜为邻。\n长风早报林莺信，旭日寒迷苑骑尘。\n圣主新耕农务急，燧人钻火爨庖新。\n书生不愿繁华乐，有待天恩及万民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和王子璋见贻 其二","author":"郑真","text":"海上人家叹扊扅，海边山壑遍藏尸。\n糠秕岂可供常爨，饘粥胡能疗积饥。\n鹄立形骸僵卧久，龙钟老病却行迟。\n九重正有苍生念，清问应须待帝咨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邀月轩","author":"郑真","text":"嫦娥趣驾上青霄，公子开轩慰寂寥。\n露洗杯罂光濯濯，风生冠佩影飘飘。\n九河垂浪秋情密，万境无尘世虑消。\n斗转参横人未散，欲呼秦女更吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴季璋松斋","author":"郑真","text":"石上高斋倚碧空，虚檐面面拂空蒙。\n龙蛟影动三更月，猿鹤声传万壑风。\n飞翠雨余浮几席，轻花春暖洒帘栊。\n先生莫自甘岩壑，廊庙终归造化功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高明楼","author":"郑真","text":"天光云影画图开，河汉星辰接上台。\n沧海忽惊龙变化，青山常见鹤飞来。\n秋风凉动牙签架，夜雪声传鴳■堆。\n自笑浮生尘满眼，登高作赋愧无才。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和贵司丞雨中述怀 其一","author":"郑真","text":"联璧光辉重万金，功名未许谢朝簪。\n百年正属风云会，一片宁甘铁石心。\n彩凤双飞华阁表，征鸿齐度画楼深。\n埙篪唱和今何似，请把周诗雅颂吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和贵司丞雨中述怀 其二","author":"郑真","text":"东风环佩动璆琳，席上欢陪玳瑁簪。\n报国好酬千里力，持家宜共百年心。\n紫荆堂树江山远，锦棣园通阔水深。\n白日看云余兴在，客边妙写杜陵吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杜元昌除国子学正","author":"郑真","text":"丞相家传百岁余，日临斋馆看云储。\n绫花尚宝宸章赐，袍褐亲看省檄除。\n藻泮晴香琼液动，杏坛春暖锦云舒。\n谁怜樗散空山客，一卷青灯夜屋虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送戴文祥谢官归里 其一","author":"郑真","text":"草色花香忆故庐，归来戎马厌驰驱。\n久知司隶终兴汉，共说夫差昔沼吴。\n天阔三江鲸挟浪，云深双阙凤栖梧。\n相过祇欲论时事，夜半前溪雪棹孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送戴文祥谢官归里 其二","author":"郑真","text":"元老新辞丞相秩，强藩欲觅假王封。\n可怜壮士心全改，谁信忠臣发上冲。\n晋国甲兵千里马，吴人城郭五更钟。\n纷纷世事知何似，高卧长台第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡万户","author":"郑真","text":"沧溟五月锦帆开，海上传呼将帅来。\n天近扶桑明白日，风行偃草散荒埃。\n金戈万灶屯飞骑，铁锁千寻伏怪能。\n宴犒从容军事少，仙人楼阁望蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孟宣使回京","author":"郑真","text":"星槎使节斗牛间，蚁酒龙衣尚局颁。\n圣主无为开泰治，元臣有命复清班。\n云霞海阔三神岛，日月天高万岁山。\n京国归承台阁问，定须送喜入龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答王以文见寄 其一","author":"郑真","text":"廿里松声宝地凉，天仙时与共彷徉。\n秋闱儗上登科记，春殿谁传入奏章。\n太白山头开日观，朝元阁上逼奎光。\n翩翩欲遂登临兴，何日天风送佩璜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答王以文见寄 其二","author":"郑真","text":"自笑吾生似服虔，西窗风雪半床毡。\n清班未得临丹阙，禁炬空怀锡绛莲。\n兵甲年深愁老去，文章官样许谁传。\n相知最有王征士，胡不归来夜月船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王子章 其一","author":"郑真","text":"南风闽海早归来，青眼相逢一笑开。\n彩笔题春云满座，银灯照夜月当台。\n枢庭正用萧张杰，宾幕终归管乐才。\n况是故园生意好，桃花流水出天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王子章 其二","author":"郑真","text":"枢星光带赤城霞，山月寒随碧海槎。\n宥府早看宾入幕，故乡重喜客还家。\n晓营独跨青丝骑，夜屋重吟绛烛花。\n当世正须文与武，皇都不日听宣麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钟山长","author":"郑真","text":"皋比堂下听谈经，人物风流叶地灵。\n甬水东来银树碧，菁江西望蜀山青。\n象樽饮福秋倾醴，牲俎传餐晓割腥。\n官满三年浑欲□，□□□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题咏春亭","author":"郑真","text":"绣柱雕阑面面空，座间人似杜陵翁。\n画图不用丹青手，彩笔争夸锦绮工。\n花柳光辉春雨后，山川浩渺夕阳中。\n元戎不负风流约，樽俎还看一笑同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王子章以道院迎仙客书堂隐相儒为题以栖字金字为韵 其一","author":"郑真","text":"琳宫瑶宇迓佺期，弱水蓬莱路不迷。\n宝剑光寒珠斗泾，长裾影动彩云低。\n池深碧藻春龙蛰，月满苍松夜鹤栖。\n况有笙箫谐律吕，好将法酒醉玻瓈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王子章以道院迎仙客书堂隐相儒为题以栖字金字为韵 其二","author":"郑真","text":"投老星星鬓发侵，经纶事业岂无心。\n半生独对孙康雪，万里终为傅说霖。\n碧草窗前空日暮，紫薇垣底自春深。\n夜来有客欣相问，卖得文章几百金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":25161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]