[{"title":"居守京城赠同事靖远伯王公二首 其一","author":"严嵩","text":"居留藉总戎，简命冠群公。\n斧钺行军令，诗书振祖风。\n玉鞭光指月，龙剑气成虹。\n迂薄欣联事，多惭卫霍功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"居守京城赠同事靖远伯王公二首 其二","author":"严嵩","text":"白马玉连环，城巡遍九关。\n月临霜仗肃，风袅戍旗间。\n阁道星辰上，桥陵雾霭间。\n明朝书笏记，同候属车还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓登长陵陪祀","author":"严嵩","text":"绛节霓旌拥圣君，翠崖丹壑上层云。\n松林日出浮佳气，沙塞霜飞净远氛。\n瑶草总承恩露重，黄花犹傍御炉芬。\n幸随天杖观殷祀，不向风歌数汉汾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿景陵朝房作","author":"严嵩","text":"六载桥陵得再攀，石房仍宿翠微间。\n拜瞻松柏惊时序，来往风尘笑病颜。\n幄殿六龙频驻辇，羽林千骑遍遮山。\n太平仪典今看盛，薄劣虚惭侍从班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉命视部篆岁除日履任奉呈桂翁少傅 其一","author":"严嵩","text":"亭玉张筵迥，袍绯拥绶新。\n丹霄通雨露，华省切星辰。\n拔擢惭非分，遭逢庆此身。\n所希阳道泰，明日万方春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉命视部篆岁除日履任奉呈桂翁少傅 其二","author":"严嵩","text":"南省今重入，春阳动粉闱。\n气随莺谷转，花傍雪筵飞。\n斋署更新榜，厅槐过旧围。\n总多耆俊在，虚薄冒恩辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉命视部篆岁除日履任奉呈桂翁少傅 其三","author":"严嵩","text":"少傅知予久，交承分愈亲。\n圣朝无阙典，何力继芳尘。\n憩阁棠依席，寻诗鹤近人。\n极知三礼重，夙夜奉惟寅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉命视部篆岁除日履任奉呈桂翁少傅 其四","author":"严嵩","text":"弱冠游文苑，载笔逐时英。\n敢期周典礼，仍备汉公卿。\n辛苦思身事，恩荣荷圣明。\n坐怜松雪晚，真有岁寒情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摄事西陵行次旧功德寺作 其一","author":"严嵩","text":"湖寺春禋到，高秋得重寻。\n川原通远色，岩嶂锁寒阴。\n暂息尘中驾，犹怜物外心。\n彩云松柏里，长候翠华临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摄事西陵行次旧功德寺作 其二","author":"严嵩","text":"蘋际泠风起，飒然湖上秋。\n远波明岛屿，层雾隐林丘。\n鸟下溪田熟，钟鸣谷寺幽。\n驰驱念于役，心赏若为酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其一","author":"严嵩","text":"本朝陵墓壮西山，松柏神宫未可攀。\n独有中官奉祠祀，石房烟火翠微间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其二","author":"严嵩","text":"玉匣珠襦掩夜泉，世人那见鹤归年。\n秋来十里金山道，华表参差夕照前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其三","author":"严嵩","text":"无穷台殿倚山椒，土价黄金向此消。\n常侍不来僧独在，游人还自说先朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其四","author":"严嵩","text":"涧松岩石荫秋萝，贪看青山寺寺过。\n归鸟数行西日外，树烟横碧晚钟多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其五","author":"严嵩","text":"方池涌出玉流寒，耐可溶溶一鉴宽。\n尘事驱人留不得，欲归还复倚阑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其六","author":"严嵩","text":"金代遗踪寄草莱，湖边犹识钓鱼台。\n沙鸥汀鹭寻常在，曾见龙舟凤舸来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其七","author":"严嵩","text":"湖上闲云对草亭，蒹葭淅沥映寒汀。\n千峰万壑看难尽，白鸟双飞入翠屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其八","author":"严嵩","text":"万峰苍翠入云端，极目江山此郁盘。\n地隐西湖成泽国，天开蓟苑作长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山杂诗 其九","author":"严嵩","text":"白羊山路白云中，鸟道羊肠一线通。\n岂有胡儿能牧马，万年天险限华戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣祭皇子于西苑长春宫寓宿苑中纪述 其一","author":"严嵩","text":"望见飞虹白玉桥，水边台殿影青霄。\n那知苑内来留宿，月白霜清共此宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣祭皇子于西苑长春宫寓宿苑中纪述 其二","author":"严嵩","text":"西内新移皇子丧，礼卿临奠捧宸章。\n蕙肴兰醑曾来享，转益皇情一倍伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣祭皇子于西苑长春宫寓宿苑中纪述 其三","author":"严嵩","text":"缭绕香花覆玉幢，瑶坛夜醮礼虚皇。\n可怜今夕长春殿，坐听经声月转廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣祭皇子于西苑长春宫寓宿苑中纪述 其四","author":"严嵩","text":"高殿虚廊灯烛光，残河欲没树苍苍。\n长安万户瞢腾里，不信蓬莱刻漏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和师相序翁阁中盆荷初开是日翁六载考绩 其一","author":"严嵩","text":"芙蕖香蔼玉堂风，丽彩还迷晓日红。\n天禁移根恩本异，蓬山歌瑞句尤工。\n凌波杂佩摇湘岸，擎露金盘出汉宫。\n愿借碧觞留胜赏，况逢黄阁奏元功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和师相序翁阁中盆荷初开是日翁六载考绩 其二","author":"严嵩","text":"纶阁挥毫坐水风，晴花新上赐袍红。\n物华自解呈嘉瑞，衮职惟应代帝工。\n天上恩波涵凤沼，帘前香雾隐仙宫。\n极知退食从容地，调燮全收鼎铉功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"被旨待朝鲜使臣宴 其一","author":"严嵩","text":"百伎充庭奏管弦，大官供馔列芳鲜。\n岛夷职页虔臣节，天驿恩华宠御筵。\n寰海车书应会极，圣朝功德正齐天。\n微臣邦礼叨从事，拜舞重歌既醉篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"被旨待朝鲜使臣宴 其二","author":"严嵩","text":"五位衣裳坐圣人，殊方玉帛走蕃臣。\n海嵎日出颁封旧，阊阖云开献寿新。\n阶羽舞时知舜德，衢尊斟处荷尧仁。\n皆言夷夏为家日，同醉钧天湛露春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇储大庆侍读屠文升告赐汴藩便道过家省觐赋赠","author":"严嵩","text":"诞瑞元良重，颁书郡国遥。\n使旌遴玉署，皇泽霈丹霄。\n宝服云龙丽，宸章日月昭。\n宗藩均庆赐，寰海遍欢谣。\n贤继方歌启，男多竞祝尧。\n天枝千叶茂，璇律万年调。\n才子华簪称，词林俊望超。\n凤毛呈异彩，琼树挺清标。\n麾节梁园道，风烟洛水桥。\n染衣尘叆叆，鸣驿马萧萧。\n汴寺连云起，河冰逐晛消。\n帆津凌沆漭，屐岳上岧峣。\n览胜才能赋，寻幽会屡招。\n陇梅匀细萼，渠柳变芳条。\n禾里山连舍，江门月映潮。\n宫袍裁昼锦，寿酒注春瓢。\n恋别频看剑，承欢更驻轺。\n起居荣八座，封锡贲三朝。\n气挟湖山动，恩垂雨露饶。\n筵开青鸟度，乐奏紫霞飘。\n白发仍将母，青宫特简寮。\n禁林春色满，侧耳听回镳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月十日同宫保浚川会少傅桂洲宅席上有作次韵 其一","author":"严嵩","text":"高城过雨浮埃净，东阁留宾绮席开。\n紫艳未呈芳节菊，黄封先出内家醅。\n幽怀晚径频移榻，醉眼秋山独倚台。\n退食相过应不厌，共看名籍在蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月十日同宫保浚川会少傅桂洲宅席上有作次韵 其二","author":"严嵩","text":"还怜颜鬓三秋改，怅望风烟万里开。\n病客未能忘野兴，玉人犹喜对仙醅。\n霜晴白雁来沙碛，日晚祥乌下石台。\n朱绂缪惭随奉引，可应重问北山莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕学士未翁宅灯宴次席上诸学士韵 其一","author":"严嵩","text":"德星池馆五云连，翠管银罂照绮筵。\n伶部按歌传锦瑟，御厨分赐辍金钱。\n夜看灯月明于昼，人在蓬瀛望若仙。\n共喜恩波逢圣世，愿将歌颂答韶年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕学士未翁宅灯宴次席上诸学士韵 其二","author":"严嵩","text":"登堂顿觉消尘思，独树梅花清傍人。\n物色每惊游宦侣，风光先透帝城春。\n何郎诗兴留东阁，杜老醅香送隔邻。\n岁岁传觞还此夕，綵灯花胜斗鲜新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲春五日宴饯大司徒李公于礼部后堂次留别韵","author":"严嵩","text":"暖烟晴树动春妍，胜日南宫共此筵。\n宗伯正同周典礼，司农新领汉缗钱。\n金瓯姓字需贤佐，玉府班仪列上仙。\n三纪词林今八座，与公重数孝皇年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄朱给谏伯雨","author":"严嵩","text":"秣陵烟月叹离居，长忆招邀驻笋舆。\n尘世浮踪难自定，故人欢好已全疏。\n寻山寺隐松萝胜，坐竹池涵几席虚。\n别后此心何所寄，江鸿频展八行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同年张少参兄挽词 其一","author":"严嵩","text":"远书昨岁渡江潮，蒿里惊闻引葬箫。\n莫话对廷弘治日，杏园前伴已萧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同年张少参兄挽词 其二","author":"严嵩","text":"白璧青铜亦自珍，暮年朱绂水云身。\n堂前尚有薇花月，不见当时作赋人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠袁西园节推 其一","author":"严嵩","text":"昨来同驻潞河舟，今去君为岭外游。\n从此向南书渐少，云山无限水悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠袁西园节推 其二","author":"严嵩","text":"宦情离思入风烟，把酒相看各惘然。\n今日黄金台上别，与君重会是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠袁西园节推 其三","author":"严嵩","text":"野性自期盘谷隐，误恩重作凤池游。\n因君思逐飞云去，直到钤山楼上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠萧二守赴任济宁 其一","author":"严嵩","text":"使君出佐古名州，钜野娄城接鲁陬。\n庭中好种甘棠树，他日能将惠化留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠萧二守赴任济宁 其二","author":"严嵩","text":"铙吹喧喧济水头，赤旗赪帽引官舟。\n津亭送客归时晚，可得閒登太白楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送进士卢木伯宰嘉兴 其一","author":"严嵩","text":"慷慨贾生能抗疏，萧条宓令独鸣弦。\n琅玕贮腹应无数，留取重来侍帝前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送进士卢木伯宰嘉兴 其二","author":"严嵩","text":"烟水吴门暂驻桡，到宫惟有两程遥。\n但教得禄为亲养，不用逢人叹折腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨惟明","author":"严嵩","text":"疋马双旌逐晓风，楚云湘水思无穷。\n遥知驿路经行处，多在春山万木中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同顾学士于神乐观赏牡丹次韵 其一","author":"严嵩","text":"何处高吟对物华，石林来访地仙家。\n桃源景胜迷行迹，日槛风亭处处花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同顾学士于神乐观赏牡丹次韵 其二","author":"严嵩","text":"荏苒风尘度岁华，春晴下马醉谁家。\n官曹出郭应难数，惆怅尊前双树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听歌玉娥儿词阁臣应制作也","author":"严嵩","text":"玉娥不是世间词，龙舰春湖捧御卮。\n闾巷教坊齐学得，一声声出凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和少傅相公西苑祀归之作","author":"严嵩","text":"摄祀元台重，乘春淑气和。\n菀芳花露早，汀晓水烟多。\n稼穑勤周畯，明良恊舜歌。\n欲知回衮舄，天路近星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和少傅相公景神殿上香","author":"严嵩","text":"片月斜明古树苍，玉京楼阔迥含凉。\n神舆欲降浮龙气，宝殿初开引御香。\n直以精诚将祀命，极知趋走奉恩光。\n归来彩笔题新句，人世惊看五色芒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李正郎之广右提学","author":"严嵩","text":"冠盖三春别，云山百粤程。\n草齐疑碍马，花暖欲啼莺。\n简擢儒台重，迟回省署清。\n相知谁复似，不尽送君情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠用之","author":"严嵩","text":"志业平生远，发轫壮兹行。\n过家娱彩服，入郡引前旌。\n夕浦船依市，春山柳向城。\n楚邦民俗好，应惬宦游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠呈立赴曲江丞","author":"严嵩","text":"童稚情怜砚席亲，雪窗萤馆共悲辛。\n那堪老至思前事，忍向天涯别故人。\n对酒莫辞寒夜醉，折梅应寄远江春。\n河阳小试君休叹，遥听贤声慰吏民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈子新知州","author":"严嵩","text":"金陵共尔论文日，十载重逢白发新。\n擢第旧传三礼学，分符今牧两州民。\n青枫粤峤鸣驺远，绿水燕河举棹频。\n南去故交知渐少，题书还忆雁声春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和少傅相公九日邵园集饮 其一","author":"严嵩","text":"侯家池馆闭芳园，上相能来共绿尊。\n看竹未须询地主，结茅真拟学山村。\n松根坐石云随几，谷口鸣驺鹤避轩。\n退食自公多暇日，为将歌颂答君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和少傅相公九日邵园集饮 其二","author":"严嵩","text":"只疑风景是陶园，九日閒情对菊尊。\n绿树篱边斜有径，青烟郭外近依村。\n歌声缓送鸾箫曲，仙驭高临紫气轩。\n岂似齐山吟落照，共瞻霄汉奉明恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和少傅相公九日邵园集饮 其三","author":"严嵩","text":"城东柰有辟疆园，座上能虚北海尊。\n惯见渔樵谈胜事，忽惊车马驻深村。\n林风不厌吹乌帽，瀑水尤宜落绮轩。\n最喜年丰禾稼熟，野人含哺颂君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登报国寺阁次宫保未斋韵","author":"严嵩","text":"鹫林朱阁重霄近，俯见风烟接地浮。\n金阙觚棱深隐雾，碧山红树迥含秋。\n可怜车马陵东别，未羡衣冠岘道游。\n人事尘劳难可到，凤城斜日重回头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送虞大理侍养南归","author":"严嵩","text":"赐归真慰北堂欢，色养无心恋达官。\n献寿总宜莱子服，趋朝曾识惠文冠。\n山中逸兴思攀桂，溪上秋芳咏采兰。\n圣主恩深阊阖远，几回清梦忆鸣銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少傅桂翁寄黄太史伯真余同作","author":"严嵩","text":"忽报远书传凤阁，遥怜高客卧云山。\n青萍绿绮谁应惜，药圃茅堂相对閒。\n长为风烟增怅望，漫于时序感容颜。\n故人拟荐扬雄赋，早晚重来谒帝关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感述","author":"严嵩","text":"长安滚滚化衣尘，侣逐私嗟作宦身。\n驽蹇敢方燕市骏，蛾眉曾学楚宫人。\n谩于情事朱弦在，信有交游白发新。\n玉树上林无限好，寄言鸾凤莫相嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得中峰少宰书却寄之","author":"严嵩","text":"越客初逢得起居，夜灯频展八行书。\n故人沧海身犹健，旧德中朝席尚虚。\n世事无端还失马，碧山多兴欲焚鱼。\n谢公自有苍生望，旅逐无能独愧予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"报国寺阁饯都宪白川周公还南京","author":"严嵩","text":"来登梵阁诸天上，暂借文觞此日留。\n落木寒山堪望远，疏花锦石自宜秋。\n风尘荏苒催双鬓，廊庙周旋系百忧。\n已报旌旗戒明发，更攀萝薜寄清游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元会二首 其一","author":"严嵩","text":"正元钟鼓动长安，率土朝天若会湍。\n瑞气先浮百子殿，晴光欲上五辛盘。\n梅风应律韶年丽，蔀屋迎阳圣泽宽。\n先向御帘陈贺表，缪司邦礼备春官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元会二首 其二","author":"严嵩","text":"紫宸楼阁雾中看，宝扇龙旗拂曙寒。\n燕律吹葭饯冰雪，汉庭鸣玉引鹓鸾。\n身当奏对瞻天近，世际雍熙报主难。\n虹渚七回逢大庆，万方嵩祝一声欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋夜二首 其一","author":"严嵩","text":"玉漏南宫夜，星河迥寂寥。\n辉辉庭雪积，冉冉树烟销。\n大礼严皇谕，清斋肃署寮。\n圣躬传勿药，凝思睇丹霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋夜二首 其二","author":"严嵩","text":"入院烟霜暝，开窗柏桧深。\n地严知俗遣，夜久觉寒侵。\n礼乐逢明主，乾坤抱寸心。\n拥书清不寐，风鹤送馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日同乡宴集","author":"严嵩","text":"此日旧传人共得，小堂初喜客相过。\n椒觞柏叶修春酌，锦瑟银筝起夜歌。\n万井烟花芳节好，百年桑梓故情多。\n正逢休沐堪乘兴，暂驻灯前白玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]