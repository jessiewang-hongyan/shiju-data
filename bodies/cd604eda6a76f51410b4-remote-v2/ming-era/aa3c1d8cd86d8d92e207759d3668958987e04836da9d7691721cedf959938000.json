294295f79689","path":"明_1.csv","pointer":33285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"到建宁赠星者苏金台","author":"张以宁","text":"博望乘槎斗牛去，蜀庄帘下独沉冥。\n金台五纬光联璧，何处江湖有客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南京早发","author":"张以宁","text":"大隐金门三十载，壮怀中夜每闻鸡。\n今朝一吐虹霓气，万里交州入马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚泊石头城下明旦发龙江","author":"张以宁","text":"江口帆开五两飞，海门遥望树依微。\n若为得似千年鹤，东向三神岛上归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过大圣港新河口","author":"张以宁","text":"佳气茏葱紫翠间，人家百万绕钟山。\n新河亦似知形势，流入龙江第一关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芜湖","author":"张以宁","text":"忠臣解体将离心，一鼓芜湖九鼎沉。\n遗老尚谈前宋事，惜无人解说王琳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊月子河望三山","author":"张以宁","text":"三山仙岛隔归期，长夜京华梦见之。\n明发开帆成误喜，青天三点见峨眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"焦矶庙","author":"张以宁","text":"碧殿红棂翠浪间，江风缥渺动烟鬟。\n神鸡不逐云中去，啼杀清秋月满山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过采石 其一","author":"张以宁","text":"重过峨眉访旧游，三山无恙水东流。\n若为唤起青莲客，共醉西风亭上秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过采石 其二","author":"张以宁","text":"天堑西边牛渚矶，燃犀谁敢照朱衣。\n而今荡桨平如掌，薄暮渔童买酒归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月子河阻风","author":"张以宁","text":"洱江万里此朝东，入贡舟航四海同。\n明代百神都受职，为言休作石尤风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为舟人万氏题象图","author":"张以宁","text":"雪白双牙云满身，日南万里贡来驯。\n远方奇物真堪画，却是中州有凤麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中望庐山 其一","author":"张以宁","text":"重过庐山三十秋，西风催送上湖舟。\n若为借得仙人鹤，飞到香炉峰顶头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中望庐山 其二","author":"张以宁","text":"老无杰句对庐山，紫翠遥看霄汉间。\n羡杀倒骑牛背客，买田长占落星湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过临江望閤皀山","author":"张以宁","text":"閤皀山青琐夕霏，仙翁旧馆尚依稀。\n归来倘似辽东鹤，愁杀千年老令威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀故人邓南皋","author":"张以宁","text":"夕阳独立楚江边，不见南皋二十年。\n欲寄平安无处问，津头风急起官船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遇故人胡居敬临江府送至新淦 其一","author":"张以宁","text":"共酌檐花细雨前，凄然重见此江边。\n停舟莫怪难为别，能几人生二十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":33301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]