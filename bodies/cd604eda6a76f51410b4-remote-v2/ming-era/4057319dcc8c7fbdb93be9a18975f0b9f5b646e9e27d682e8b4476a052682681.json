[{"title":"书舍咏","author":"欧阳建","text":"秋萼春开是所期，湖山精舍读书时。\n举头折桂今年事，试看谁簪第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别次韵三首 其一","author":"欧阳建","text":"万仞云衢拟子登，一鞭归马激谁膺。\n今宵肯歇归与兴，还看中秋月色明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别次韵三首 其二","author":"欧阳建","text":"权力当年笑吕登，皇王事业系予膺。\n与君饮到堪期处，尚有庐中坐孔明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别次韵三首 其三","author":"欧阳建","text":"如天斯道岂难登，有孔铸颜便服膺。\n今日与君须尽醉，藤萝石上月将明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题扇面画","author":"欧阳建","text":"春柳舞江干，春水弥江岸。\n孤舟坐钓翁，举目南天雁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕汇诗","author":"欧阳建","text":"一杯频酌酹诗魔，月夕风晨赖汝多。\n吸取云烟藏玉匣，凭谁书就换笼鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝怀同社兄弟","author":"欧阳建","text":"相思憔悴到花朝，留滞天涯问渡遥。\n飞梦半随千里月，离情长逐一江潮。\n莺声宛转翻金缕，燕语凄清近玉箫。\n触景不堪增怅望，垂丝烟柳锁河桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯子与美人对奕得于窃见拈得知字","author":"欧阳建","text":"连环劈破两情痴，敌手那容隔眼知。\n几劫鸳鸯情不尽，燕飞还待落花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不染上人斋中留宿","author":"欧阳建","text":"十载谈玄愧未真，何如今夕倍通神。\n坐残石上三更月，證尽人间两世因。\n茶熟正须棋局稳，香销犹爱竹床新。\n随缘处处心皆佛，破衲原来不染尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕感怀","author":"欧阳建","text":"卧病忽惊秋，剖瓜满彩楼。\n有怀情不寐，新月曲如钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勉诸弟学","author":"欧阳建","text":"汝兄旧学在羊城，深夜咿唔不彻声。\n一举成名非易得，诸生对卷好求精。\n也知天爵来人爵，须信身耕让笔耕。\n北极洪澜深著眼，凭将脩举步南溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"眼病承友诏谈诗答之","author":"欧阳建","text":"病来旬日负新缘，青白双眸任倒颠。\n闻道新诗誇郢调，何人赓和百花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"眼病调药","author":"欧阳建","text":"谁分石火到床头，甘草空怜手自抽。\n怪底半生青白眼，一朝炙热枉相投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别","author":"欧阳建","text":"珠泪纷纷欲断猿，贫交无事祇多言。\n相思若此蘼芜草，一路随君到故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴诗卷次韵四首 其一","author":"欧阳建","text":"风光此夜与谁同，剔尽银灯照眼红。\n之子莫辞玄石醉，酒钱已付隔邻翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴诗卷次韵四首 其二","author":"欧阳建","text":"投机议论我君同，座上何须一点红。\n竟夕能为文字饮，似泥谁敢笑仙翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴诗卷次韵四首 其三","author":"欧阳建","text":"羊裘两袖拂花庄，肯著人间等辈裳。\n酒后形骸都不记，却疑今日有严光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴诗卷次韵四首 其四","author":"欧阳建","text":"东南笑话向梅庄，舞破春风是此裳。\n酒兴寻常行处遣，人生容易度时光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周清溪先生福州司训　从员山周家谱采入","author":"唐穆","text":"广文官冷未为贫，木铎声高道自尊。\n二载烟尘辞九陌，一襟风月占三山。\n久甘苜蓿寒牙嚼，肯厌虫鱼白首斑。\n济济英才星斗望，古风远矣看追还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"名公纪遇　于时予与许太尹时泉盖新知也","author":"唐穆","text":"长云不离天，森林不去地。\n俯仰斯人徒，天地同气谊。\n千里亦匪遥，并驾歌戾止。\n人生重相知，何论疏皆异。\n一盖孔程倾，杯酒元黄懿。\n谁云此襟期，古今乃殊致。\n缅兹良晤难，好怀安可寘。\n莫惜携手迟，但愿断金利。\n仰首思停云，元亮有同志。\n世路崎崄多，转盻忽如弃。\n赠子写绸缪，永慰旅中意。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张鹤野鸣鹤图","author":"唐穆","text":"郁郁望青野，昂藏有仙姿。\n众鸟不比俦，孤高自幽奇。\n嘎然向空啸，慷慨舒光仪。\n零零祥露降，袅袅清风随。\n凛凛寒威斗，萧萧夜气吹。\n眷兹灵耿性，岂似浪味咿。\n孤琴亦难宣，千载空中词。\n清晨入雷鼓，洛阳远闻之。\n何况凌云冈，钧奏迭笙篪。\n志公飏林麓，庾子唳孝思。\n何况托王土，宁忍噤明时。\n徽音不多得，一鸣震天逵。\n鴳鸠既屏迹，鸾凤应相期。\n但作盛世鸣，不为尘网羁。\n繄彼啄群鸟，终日受拘縻。\n含声樊笯中，低俛徒凄其。\n悠哉九皋情，举世谁能知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初二夕报南川远行终夜思之追送至白沙又恋恋至暮","author":"唐穆","text":"日暮惊传雁，更阑未帐牙。\n榻前千种思，灯里数团花。\n迅去南川马，轻追白水沙。\n情知难作别，迟落晚天霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王指峰司教定安","author":"唐穆","text":"职清终是贵，路近即为家。\n雁报千金易，云瞻一路赊。\n座开新幕客，锦烂故园花。\n长昼闲蓬枕，春风自放衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和郑篁溪不寐韵","author":"唐穆","text":"坐久临更寂，歌浓伴月明。\n旅怀频恋目，残籁苦吹声。\n灯信花前结，春容酒后生。\n遥思寰海客，休戚几关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠符澄溪子赴南雍","author":"唐穆","text":"金缕春萦树，莺啼晓破烟。\n泮池观海近，云砥淬锋先。\n万卷书横架，三秋榜丽天。\n燕台杯送剑，不是荡离筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过庾岭有感","author":"唐穆","text":"云岭何年辟，挥鞭此日行。\n步高天转近，眼阔景常清。\n勋业空前古，乾坤著大名。\n太平有几相，屈指溯前生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰仲夏八日寓黄塘忆洞元吴子归南海予至此已半月馀矣诗云渡海盖遥度之也","author":"唐穆","text":"刚别重山外，相逢渐面非。\n片云浮目远，孤月照形稀。\n渡海舟应到，朝天马正飞。\n萱庭春昼永，嘱与报归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送彭密渊别归","author":"唐穆","text":"白云天上密渊子，沧海人间此日来。\n踏遍尘寰万万里，回首四望忘崔嵬。\n主人留子一年好，见子欲别心如摧。\n去去仙风何处约，眼前金马亦蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送彭密渊谈仙适弟存吾以诗约彭赴罗浮武夷予不能赴赋此","author":"唐穆","text":"欲向鸿濛问路迟，海天相遇欲何之。\n黄金丹诀原非幻，白首禅缘亦自疑。\n天地几人能不朽，灵丸一点本相随。\n与君话到无穷处，不说罗浮即武夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自吴季明饮归有感","author":"唐穆","text":"百岁才惊三日别，寸心却似千里违。\n吾怀不尽灯前酒，君意犹加雨后衣。\n欲托雁鱼书尺素，还疑形影到柴扉。\n人生最惜销魂事，几度相思梦里依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲辰仲秋同内斋至姑苏江口因东旸年兄抉台佐守之报遂别去台约明春访予于金台然内斋于东旸舅甥至懿也予于内斋乃白首知己也思其别忆其来情自无已诗以将之","author":"唐穆","text":"仗剑遥同萍水游，那堪江柳又分舟。\n知音人去丝桐冷，倚玉筵开丛桂留。\n白首行藏缘我定，青天肝胆许谁酬。\n相思独望在秋月，犹忆春光共上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中探珠子赠陈独庵","author":"唐穆","text":"兴来相赏景何如，渺渺青天数一珠。\n日朏初看偏隙白，月低还眺半湖虚。\n轻圆留点穿来好，有孔含光照远无。\n何□□□高世□，□逢惊讶□□卢。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢人见惠香品","author":"唐穆","text":"软着丝罗绌裹丸，香风款款透心肝。\n人间何物传来异，掌上开封墨木乾。\n一水红梅凭落叶，百年仙遇喜乘鸾。\n前生蟾桂今宵月，漫抱阳台作梦看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈南阳乐园","author":"唐穆","text":"已伴光风五十春，兴来此日复清芬。\n剧怜蓬岛宜仙侣，未信金门有散人。\n笑对花间还坐晚，醉忘瓮口更开新。\n南阳胜景看无尽，留取琅玕赠好因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓石头城七夕借与","author":"唐穆","text":"谩说莫愁台己古，更看秋夕鹊桥新。\n惊心牛女何时约，乍眼姮娥此地亲。\n经岁灯花刚过漏，隔溪烟柳又逢春。\n无端斟酌天家事，不道人间亦写真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和阎聚奎子游学万军","author":"唐穆","text":"丈夫到处是豪游，万卷生涯此担头。\n道大浑忘天地老，心閒那解利名休。\n岩封去去黎侯胜，桃李森森狄圃收。\n一枕诗成君正别，锦囊端副友生求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王指峰教谕　得宸字韵","author":"唐穆","text":"文翰曾经品玉宸，綵毫摇映泮池春。\n杏坛化雨赏心远，水暖江清寄兴频。\n官近故乡风习熟，堂登大雅广陶甄。\n诸生谩笑阮囊涩，游咏偏多得句新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元宵与阎天秀老友赏月","author":"唐穆","text":"一杯喜趁月明酬，如此春光肯负不。\n灿灿银冰垂绮席，盈盈珠玉映云楼。\n景好多开陈世笑，花狂还上老人头。\n相逢莫浪尊前放，白首今宵几处游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送广信吴医士","author":"唐穆","text":"业传三世丹初熟，药转千炉效更奇。\n喜我有缘逢葛老，令人到处说卢医。\n一身无病怀常胜，四国多瘢梦未稀。\n我技非医心却是，苍穹何日慰烝黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补题曹叔冈铁拐仙图","author":"唐穆","text":"眼开白日空今古，手把轻云任指挥。\n寥落生涯壶口外，浑忘天地是双扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答螺冈寄韵","author":"唐穆","text":"天涯那得此离言，寄到羊城九曲轩。\n我有深情随逝水，愿从南海送涓涓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞文邑韩机训妻朱氏守节氏","author":"唐穆","text":"金石为心铁作肝，备尝艰苦不辞难。\n相随沦殁孙和子，独抱松贞耐岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓白沙公馆阻海寇四日风利渡海次日抵英利遇陈自所同宿驿西偏","author":"李一夔","text":"怀归每恨到家迟，迟速乾坤自有期。\n孤馆天留三日榻，片时风利一帆飞。\n长途有分从羸马，薄酒无钱任典衣。\n旧话喜逢贤太守，不妨萍迹驿前扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀王韦轩","author":"李一夔","text":"剑气腾冲孔孟津，风光何事久羁人。\n骚坛酌月频更主，旅馆看花又过春。\n老病自怜青眼旧，交游谁信白头新。\n锦天迎养真天乐，争奈停云粤海滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日金台怀钟黄山","author":"李一夔","text":"青衫两载染京尘，怀抱迂疏敢对人。\n飞雁南天来札少，流莺乔木感怀新。\n勋名芳远君青史，富贵缘轻我白云。\n薄拟一樽谈肺腑，百年颠倒是何辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠林艾陵","author":"李一契","text":"白日不再媚，黄花无终期。\n美人入我怀，援琴写寸私。\n明月流丹楹，照见金玻璃。\n杯空明月在，对此重悽其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山谒苏文忠公祠","author":"李一契","text":"水带环窗绿，山屏隔岸青。\n仰高来古寺，览胜历幽亭。\n九死孤忠在，三生旧梦醒。\n念亲久延伫，拥棹下前汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送毅轩兄分教琼山次韵","author":"李一契","text":"渊源家学旧名科，出处还谁得惠和。\n官冷作人应有道，时清航海迥无波。\n光声拜接文庄范，客况随安邵老窝。\n乡国化行无彼我，榔枒云树即松萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黄恪斋月夜泛舟","author":"李一契","text":"谁将光景谢留连，好月随波落客边。\n九曲调高夷水棹，一篷风细剡溪船。\n消磨尘鞅三山杳，妆点春光两岸妍。\n想到忘形花柳外，有怀多是在前川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过安庆怀先兄帽山尝宰怀宁","author":"李一契","text":"弦歌声歇几周星，香火千年寄皖城。\n善治未题明道墓，瓣香聊识惠连情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拜淮阴侯庙","author":"李一契","text":"忍辱屠门未可非，河边一饭迹尤奇。\n三分若决蒯通策，中尉黄金总浪施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见山亭","author":"郭凤举","text":"亭不在山，无山景俗。\n山不在见，无见景虚。\n俗则滞有，有非真有。\n虚则沦无，无非真无。\n滞有迹粗，术数权谋。\n沦无梦幻，黄老达么。\n有无相感，保合太和。\n山亭静对，养真如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南溪精舍","author":"郭凤举","text":"谁把南溪作胜游，未须此外觅瀛洲。\n山含晓气明如洗，树映波光翠欲浮。\n碧水有天开洞府，白云无梦绕王侯。\n我来漫作沧浪咏，一曲歌残古渡头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罩纱","author":"谢宪","text":"行值风尘更可嗟，群儿当路弄泥沙。\n先生自有垂帘计，那得閒钱买罩纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和明道诗","author":"谢宪","text":"矜持未敢说从容，起坐清宵待日红。\n物理未融思则得，人情难一扩之同。\n散殊不落无形外，飞跃都归有事中。\n何以不淫何以乐，人能无欲是豪雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题丹灶土","author":"谢宪","text":"丹成灶冷烟火息，青草黄沙杂瓦砾。\n相传有病可能医，此土何妨当饭食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅怀","author":"袁永伸","text":"岩楸落尽雁来稀，旅邸琴书锁翠微。\n秋色夜随明月入，乡心时伴白云飞。\n袁安嶂里惟耽酒，王粲楼前未拂衣。\n南粤楼台何处是，牡丹亭上暂忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔家乐","author":"袁永伸","text":"飘泊江天不系舟，断桥红雨涨春流。\n酒醒斜月沧浪外，笑倚东风看白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠同章昆冈节推宴分赋","author":"区益","text":"碧海珠光日夜浮，百年天地此奇游。\n花宫远映三山树，水国寒凝四序秋。\n雨过欲明云外岫，蜃来忽结海中楼。\n为耽佳胜依仙侣，向晚还淹岛上舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏过?川上高明 其一","author":"区益","text":"暑雨弥初夏，衰迟过半生。\n豹姿聊隐雾，凫性自依蘅。\n勋业羞看镜，行藏笑拂缨。\n溪山开旧业，藉此寄幽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏过?川上高明 其二","author":"区益","text":"荒径无人扫，经年长薜萝。\n时侵愁毒热，老去苦沉屙。\n云水随渔钓，莺花对笑歌。\n何来轩冕系，岁月枉蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩杂咏","author":"区益","text":"灵峦隐隐背城开，览胜何劳慕九陔。\n溪是武陵看进艇，花疑少室故停杯。\n吹箫应使鸾凤下，解佩深期猿鹤来。\n良会有时难屡得，碧山欲暮更徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日?川庄登高高明","author":"区益","text":"衡门秋飒绝嚣尘，三径潇潇旧隐沦。\n老去菊萸犹自媚，节临兄弟转相亲。\n插花欲满参军帽，洒酒惭非处士巾。\n莫问明年谁更健，陶然一醉卧松筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗","author":"区益","text":"陶令归柴桑，种菊满东园。\n累累故侯瓜，五色耀青门。\n物畅乃适志，身约道弥存。\n世路浩漫漫，是处有波澜。\n变故在须臾，忧来原无端。\n朝为云中龙，暮为阱中猿。\n黄雀岂不高，挟弹有王孙。\n遗荣如敝屣，弃置宁足论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏青四首 其一","author":"区益","text":"习习原上风，青青河畔柳。\n风来吹吾衣，柳飞扑吾酒。\n自吾返初服，逍遥乐畎亩。\n去春住城市，今春耕谷口。\n所遇无故物，结心惟逸叟。\n岂不念芳辰，其如少良友。\n鸟缘求匹鸣，兽为索群走。\n感物伤我心，我心独怀旧。\n芳草满道旁，拾以贻知厚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"踏青四首 其二","author":"区益","text":"驱车出里闾，行行步冈陇。\n四顾何萧条，但见丘与冢。\n杳杳泉原间，一往如长梦。\n前人不复作，后人更追送。\n遗羹空堕泪，洒饭兴长恸。\n谁云去者疏，来者实总总。\n悠悠代谢理，天地元终共。\n达人齐死生，不惑复何恐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]