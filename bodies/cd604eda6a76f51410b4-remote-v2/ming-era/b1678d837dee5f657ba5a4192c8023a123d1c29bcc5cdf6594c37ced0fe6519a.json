[{"title":"建南九曲棹歌 其六","author":"郑潜","text":"六曲中流注碧潭，集贤斜对宝华岩。\n秋风诗客歌芝陇，落日归僧入翠岚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36657,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"建南九曲棹歌 其七","author":"郑潜","text":"七曲清陂障断流，农家篱落半沙洲。\n数声长乐疏钟晚，栖凤桥边景最幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36658,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"建南九曲棹歌 其八","author":"郑潜","text":"八曲云山好卜邻，楮衾萑席不忧贫。\n水边照日铺晴雪，竹外含风织翠茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36659,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"建南九曲棹歌 其九","author":"郑潜","text":"古道通津近万安，石湖云绕福台山。\n游川何处堪招隐，春在沧浪九曲间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36660,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"建南九曲棹歌 其十","author":"郑潜","text":"棹歌声远幔亭空，千载沧州兴味同。\n今日紫阳山下客，他年人唤采芝翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36661,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入京 其一","author":"郑潜","text":"端本堂开正万方，儒臣日日近储皇。\n讲明治道称尧舜，历览人文备宪章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36662,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入京 其二","author":"郑潜","text":"洒天马乳秋先到，卓地鸾旂驾欲回。\n漫拟颂诗随警跸，愧无才力佐霜台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36663,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上京行幸词 其一","author":"郑潜","text":"群山如画列层城，佳气滦阳此上京。\n四野穹庐环魏阙，三宫仗马拥霓旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36664,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上京行幸词 其二","author":"郑潜","text":"明德城南万骑过，御天门下百官多。\n箫韶九奏风云会，嵩岳三呼景象和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36665,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上京行幸词 其三","author":"郑潜","text":"宫草葱茸拂槛青，苑中麀鹿自和鸣。\n云边仙子锵环佩，日暮君王幸穆清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36666,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上京行幸词 其四","author":"郑潜","text":"宫树行行密覆墙，雨馀沙净碧云凉。\n锦衣花帽金鞍马，綵仗红旗夹道光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36667,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上京行幸词 其五","author":"郑潜","text":"红云霭霭护棕毛，紫凤翩翩下綵绦。\n武士承宣呈角触，近臣侍宴赐珠袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36668,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上京行幸词 其六","author":"郑潜","text":"近西穹帐是青宫，瑞霭祥云晓日红。\n宝扇初开颜似玉，金舆方驾气如龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36669,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送别燕叔义之广东","author":"郑潜","text":"过了梅关到五羊，满怀秋思洒飞霜。\n罗浮山下梅华月，千里相思梦亦香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36670,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行五首 其一","author":"郑潜","text":"两山之间六七里，一岭上头千百盘。\n木杪见天披宿雾，云根坐石漱风湍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36671,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行五首 其二","author":"郑潜","text":"深林无路饥猿啸，孤嶂镵空山鬼愁。\n自信凡躯换仙骨，振衣飞步过山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36672,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行五首 其三","author":"郑潜","text":"千林竹死皆成纸，万陇丛生总是茶。\n空谷云深疑路断，绿阴流水有人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36673,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行五首 其四","author":"郑潜","text":"深谷人家尽力耕，老翁稚子笑相迎。\n但愁官府徵租赋，不识风尘有甲兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36674,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行五首 其五","author":"郑潜","text":"闭门高卧夜窗空，山酒微酣睡兴浓。\n月照纸衾浑是雪，道人身在白云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36675,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清溪道中","author":"郑潜","text":"平冈百里青草齐，草间鹧鸪朝暮啼。\n阴云淡日好天气，风捲野花随马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵题王仲肃书方画壁","author":"郑潜","text":"野石层层立翠螺，幽篁苍树晚烟多。\n梦回浑作江南看，满壁秋声落涧阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石门对酒","author":"郑潜","text":"故人送我青田酒，载到石门山下开。\n坐对银河酌琼液，千年玄鹤亦飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蜀山雨霁图","author":"郑潜","text":"闽南随处好山川，叠嶂平林俯钓船。\n争似春风登蜀道，半空楼阁五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"歌风台","author":"郑潜","text":"硉矹高台沛水涯，英雄千载故乡思。\n云飞风起歌声断，落日萧萧草树悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅寄王维善经历","author":"郑潜","text":"春雪飘香度桂林，海邦万里见天心。\n使君欲试调羹手，坐待花残看绿阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅花寄仲良御史","author":"郑潜","text":"山中拾得琼瑶树，寄与霞州御史家。\n自是南闽春信早，东风开到北枝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36682,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与宋景璋刘彦宾登崧台寻乐亭诗","author":"郑潜","text":"断虹阁雨横东嶂，斜日栖云隐暮林。\n尊酒一时江海客，布衣千载圣贤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36683,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题墨梅寄理惟贤大使","author":"郑潜","text":"皇华使者岭南回，阅遍天涯几树梅。\n诗卷满床香不断，为君临得一枝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36684,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画梅","author":"郑潜","text":"上苑孤芳过眼稀，心如铁石苦相思。\n三山海畔黄昏月，雪点寒梢蝶未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36685,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感怀 其一","author":"郑潜","text":"清明不雨只狂风，竟日尘沙起半空。\n四海疲民皆白骨，人间无泪洒春红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36686,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感怀 其二","author":"郑潜","text":"男儿盖棺事则已，壮士拔剑歌莫哀。\n功名富贵我何有，松菊田园归去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36687,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵周叔维竹枝歌 其一","author":"郑潜","text":"东淮时味颇清嘉，莲实累累小胜瓜。\n雪藕松甜丝万缕，令人吃著便思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36688,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵周叔维竹枝歌 其二","author":"郑潜","text":"月河守闸问船开，闸上新痕长绿苔。\n怪底篙人相唤急，西江又有使臣来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36689,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登能仁寺塔","author":"郑潜","text":"独上浮屠第七层，乾坤万象见觚棱。\n东山吹老庐山雪，却捲江声入建瓴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36690,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长庐卧病简枢密院掾陈子恭","author":"郑潜","text":"海口云航浪接天，故人瓜戍动经年。\n独怜南国思亲客，梦绕梅花庾岭边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36691,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松溪渔隐","author":"乌斯道","text":"青松何矫矫，溪水何泠泠。\n中有垂缗者，悠悠乐中情。\n濯足繁阴底，凉飔吹我缨。\n四山阒无人，一鸟空中鸣。\n层台肃群仙，空坛森百灵。\n白云被广路，瑶花缭幽扃。\n明月忽在水，浩歌激青冥。\n胜地东南富，渔者江海盈。\n兹味一何寡，高风吁独清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36692,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答胡徵君舜咨还山 其一","author":"乌斯道","text":"高迹寄空谷，幽居托田间。\n江水非吾限，可以相往还。\n游鱼当在渊，飞鸟当在山。\n谢此城郭游，逸驾不可攀。\n还山濯清泚，何如冰雪颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36693,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答胡徵君舜咨还山 其二","author":"乌斯道","text":"君子保厥躯，于以待昌时。\n白日惧颠蹶，夜行不倾危。\n归心若金石，固留终我违。\n譬彼出峡舟，欲挽不可追。\n山神亦已怨，来归一何迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36694,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏史","author":"乌斯道","text":"商颜避秦烈，何独有园绮。\n如何隆准公，泗鼎不可起。\n谋犹信留侯，仁慈在储嗣。\n安刘匪平勃，诚由四翁耳。\n岂中烟霞疾，徒与麋鹿死。\n芝草长满山，谁欤继修轨。\n嗟哉司马公，一传靳青史。\n排难何足云，乃传鲁连子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36695,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中兴感因成七诗寄蒲庵老禅 其一","author":"乌斯道","text":"青天湛秋水，明月扬素波。\n浮云自何来，漫漫掩星河。\n中宵月离毕，晨朝俾滂沱。\n蝶蝀乃止之，时雨良不多。\n天道本无意，咄咄其如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36696,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中兴感因成七诗寄蒲庵老禅 其二","author":"乌斯道","text":"人生恶好胜，水斗良足嗤。\n有口贵守默，石言岂其宜。\n桑田可衣食，忍使鱼龙归。\n青山可结搆，乃向空中飞。\n地道本宁静，咄咄何如兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36697,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中兴感因成七诗寄蒲庵老禅 其五","author":"乌斯道","text":"病中无所为，据梧观品汇。\n品汇自错迕，吾何发长喟。\n彼美蒲庵叟，守道已淳备。\n静坐一室中，县解六合内。\n朗谭逍遥篇，詟服许询辈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36698,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中兴感因成七诗寄蒲庵老禅 其六","author":"乌斯道","text":"公读西竺书，我读东鲁文。\n我坐支叶烦，复有彼此分。\n何当罄忘之，缁素如一人。\n譬生文字先，同为葛天民。\n无言亦无辩，熙熙乐芳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36699,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中兴感因成七诗寄蒲庵老禅 其七","author":"乌斯道","text":"相别无一语，相见无一言。\n如何忘形者，远情复相牵。\n我持江上风，遗公吹法筵。\n公以竹间月，照我调素弦。\n风比锦绣段，月比青琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36700,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题寒林远岫图","author":"乌斯道","text":"游子念故山，岁晏不得归。\n出门见林薄，日暮烟火微。\n关河渺千里，猿狖声正悲。\n况尔霜雪繁，鸟道不可跻。\n阳春固伊迩，奈此寒无衣。\n衣寒何足叹，所忧美人违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36701,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"叶国谅赴兰亭书院山长","author":"乌斯道","text":"考槃衡门下，阶前芳草深。\n方池耀晴旭，遥天堕鸣禽。\n之子方诀别，驱车向山阴。\n山阴予故游，矫首追登临。\n崇山俯清旷，回湍激灵襟。\n风磴石齿齿，孤亭树森森。\n达人不可作，咏歌有遗音。\n流光三十载，再往违素心。\n惟将飘飘思，中夜托瑶琴。\n君子美如玉，于兹遂幽寻。\n暮春服单袷，凉飔集冠簪。\n宴坐云霞谷，徘徊松竹林。\n至理忽自得，俛仰无古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36702,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与揭伯防先生桂彦良重游东山分韵得鸟字","author":"乌斯道","text":"荏苒岁云暮，霜露摧百草。\n东山松柏姿，青青故相好。\n我有违旷思，戾兹涉远道。\n斗酒斟酌之，良以慰孤抱。\n所悲无定居，依依若飞鸟。\n愿藉山中云，优游以终老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36703,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野人居为陈则颜赋","author":"乌斯道","text":"江城有甲第，楼阁高嵯峨。\n朝骑骏马出，驰骋意气多。\n我居田野中，衡门掩藤萝。\n岁月不易得，聊以保天和。\n清风起兰芷，明月扬素波。\n琴书正可陈，奈此閒静何。\n况兹桃花村，仙源入山阿。\n山中有俦侣，亦足同啸歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36704,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邀友人胡舜咨姚晋道刘庸道北郊夜坐","author":"乌斯道","text":"美人集江郊，圆月湛秋夕。\n天阔星宿繁，地迥鸡犬寂。\n供具虽不殷，各取意所适。\n抽辞托卮匜，燕坐更几席。\n既尽遐迩怀，复有新故益。\n凉风激庭柯，澄波照林石。\n零露不作寒，层霄愈凝碧。\n缅思江海内，轩盖相驰激。\n酬酢过为欢，友道谅匪得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36705,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送薛彦仁之京 其一","author":"乌斯道","text":"夫君丈夫雄，出处宁草草。\n孤踪抗浮云，贞心献穹昊。\n非类徒见招，荣名岂庸蚤。\n松柏藉霜雪，骐骥思远道。\n愿言持此心，皦皦以终老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36706,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送薛彦仁之京 其二","author":"乌斯道","text":"朝见故人家，莫别衢路侧。\n意长乏交欢，言短悲夙昔。\n南风促征舰，迅若高鶱翼。\n天吴不敢骄，帖帖戾京国。\n今予起遐思，中宵睇奎壁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36707,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答胡徵士","author":"乌斯道","text":"畴昔见君子，往来山野间。\n野鸟不相忌，山花澹相看。\n彼苍今何尔，独俾落尘凡。\n矧复旷言笑，寤寐不自安。\n天地一居室，万里犹咫尺。\n达人解天游，出处随所适。\n所交或相违，何必怀恻恻。\n飒尔精灵通，终焉若金石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36708,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮天游室夜大雨移席有作","author":"乌斯道","text":"炎歊尼欢宴，露坐希夜长。\n望舒閟金波，屏翳决银潢。\n飞廉亦驰骤，万马集战场。\n孱姿或沮丧，壮怀当激昂。\n丈夫干化机，晦冥宁我伤。\n清酤既不匮，华灯岂辞张。\n楚歌激忠肝，越吟思远乡。\n卜昼固前闻，夜饮诗所臧。\n愿言各尽醉，顷刻远相望。\n缅怀芙蓉洲，池阁风雨凉。\n遗音若金石，百载不能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36709,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题坦腹江亭图","author":"乌斯道","text":"晴光耀丛芷，凉飙激微波。\n层云汎林麓，猿猱度烟萝。\n亭中有粲者，感慨亦何多。\n疏襟献苍天，天阙高嵯峨。\n北辕缪阡陌，南州阻江河。\n琅玕腹中富，奈此迟莫何。\n踟蹰眷鱼雁，悠悠泳春和。\n江山百灵集，凭虚一高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36710,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蔡节妇诗 其一","author":"乌斯道","text":"开门见江水，江上有青山。\n青山易黄落，江水易波澜。\n妇心寂不移，白首无腼颜。\n衣藏锦文新，镜掩铜花斑。\n惟忧凤一去，母雏日饥寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36711,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蔡节妇诗 其二","author":"乌斯道","text":"奉姑忧戚中，训子识字初。\n金凤买姑药，绣麟易子书。\n姑没子已长，今当子孙娱。\n朱萱隔疏箔，翠竹森前除。\n春酒洽邻母，暮齿为何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36712,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋迟云林先生不至越五日见访有感 其一","author":"乌斯道","text":"美人涉江水，爱此鸥鹭閒。\n参差各怅望，江水渺波澜。\n萧萧风日中，蔼蔼松竹间。\n天乎贷予时，再晤良不难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36713,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋迟云林先生不至越五日见访有感 其二","author":"乌斯道","text":"美人涉江水，将以采芳草。\n空筐非所思，踟蹰向周道。\n岂无江上花，容华戾中抱。\n白露秋已零，其能弃衰槁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大生堂","author":"乌斯道","text":"美人坐高堂，阶前春草碧。\n朝阳煦游鲜，晴风送飞翼。\n出门事瞻眺，花开满阡陌。\n众山亦前陈，青青有佳色。\n天地何心哉，生意靡休息。\n吾有长桑术，于焉媲兹德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过西山访章愿学钟声伯二隐者兼与同游诸公分韵得深字","author":"乌斯道","text":"冬雨久不作，冰霜谢穷阴。\n予因积遐思，于焉事追寻。\n西山数君子，幽居托云林。\n冈峦负城郭，在乐不在深。\n旨酒罄良觌，嘉言谐素心。\n岩花照纹楸，松风堕鸣琴。\n讵谓兵革馀，得以疏烦襟。\n人生易凋谢，何时续斯今。\n离别奚足叹，愿言怀德音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题江阁燕坐图","author":"乌斯道","text":"青山凝微霭，澄江耀晴空。\n层坡积馀润，绿树披清风。\n彼美衣冠者，燕坐江阁中。\n手持高士传，目送归飞鸿。\n天朝罗俊髦，岩穴何舂容。\n吾知松关路，未启白云封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石龙人日山行 其一","author":"乌斯道","text":"坡坂屡崇卑，上马复下马。\n老怀虽云壮，奈此筋力寡。\n解鞍憩繁阴，纡郁聊自写。\n所遭无仙凡，所思何取舍。\n苍藤缀流苏，鸣禽咏风雅。\n白云自西来，故作忘形者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石龙人日山行 其二","author":"乌斯道","text":"晨兴趣归马，中涂山雨倾。\n薄言避村舍，道远复纡萦。\n林密不能盖，衣湿强前征。\n云气益昏翳，潦水益纵横。\n得非山灵意，留予卧山庭。\n似此庶不恶，悠哉有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"力农三诗 其一","author":"乌斯道","text":"家贫无土田，未尝操耒耜。\n父母令读书，但事秉笔耳。\n今当为老农，何堪即任此。\n学之良不难，所恨吾老矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"力农三诗 其二","author":"乌斯道","text":"黎明驱牛出，日暮荷锄归。\n土荒三十载，往返无旧蹊。\n荆棘刺两胫，草根固深泥。\n不辞筋力倦，但恐官事违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"力农三诗 其三","author":"乌斯道","text":"日出事输作，先日听新令。\n黾勉田野中，奈此草莱盛。\n锄垦知土脉，耕牧识牛性。\n夕归还读书，聊以俟天命。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐梅涧先生授余琴予写曲调之意赋诗九章修禊 其一","author":"乌斯道","text":"春风播良时，品汇齐化钧。\n崇山鸣众羽，清流跃纤鳞。\n咏觞托修禊，俛仰怀昔人。\n寂焉千载事，伤哉百年身。\n令德苟不著，修短何足云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":36723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]