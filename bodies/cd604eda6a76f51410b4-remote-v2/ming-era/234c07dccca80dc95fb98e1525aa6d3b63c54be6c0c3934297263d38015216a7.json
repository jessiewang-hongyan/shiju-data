or/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂言集陶三十首并序 其二十三","author":"江源","text":"荣荣窗下兰，含薰待清风。\n安知物为贵，直在百年中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂言集陶三十首并序 其二十四","author":"江源","text":"遥遥从羁役，前涂当几许。\n去去欲何之，杨朱所以止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂言集陶三十首并序 其二十五","author":"江源","text":"谁谓固穷难，袁安困积雪。\n屡空既有人，方此亦不劣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂言集陶三十首并序 其二十六","author":"江源","text":"四时相催迫，空叹将焉如。\n不赖固穷节，谁当为汝誉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂言集陶三十首并序 其二十七","author":"江源","text":"古时功名士，不知止利己。\n从来将千载，二疏复此举。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂言集陶三十首并序 其二十八","author":"江源","text":"草荣知节和，气变悟时易。\n斗酒聚比邻，抗言谈在昔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂言集陶三十首并序 其二十九","author":"江源","text":"昔在黄子廉，寄声与我谐。\n其人虽已没，念之动中怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏古五首 其一 夷齐","author":"江源","text":"嗟来何足吝，饥食首阳薇。\n竟抱固穷节，千载非所知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏古五首 其二 豫让","author":"江源","text":"君子死知己，哀哉亦可伤。\n问君何能尔，厚恩固难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏古五首 其三 荆轲","author":"江源","text":"渴饮易水流，猖狂独长悲。\n惜哉剑术疏，奄去靡归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏古五首 其四 四皓","author":"江源","text":"嬴氏乱天纪，闲居三十载。\n平原独茫茫，紫芝复谁采。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏古五首 其五 二疏","author":"江源","text":"大象转四时，始觉止为善。\n不为好爵縻，翱翔令人羡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与邝载道别","author":"江源","text":"怜君不得意，何处问通津。\n草色催归棹，莺声傍逐臣。\n东风千里树，落日两家春。\n惜别心能醉，交情老更亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞三首 其一","author":"江源","text":"问罪阴山下，从今又几年。\n亲朋无一字，雨雪尽三边。\n溪月明关陇，胡沙乏水泉。\n功成尽麟閤，燕颔岂徒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞三首 其二","author":"江源","text":"兵出塞垣通，金鞭指铁骢。\n将军下天上，杀气绕湟中。\n受命边沙远，防秋鼓角雄。\n匈奴犹未灭，何处欲输忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞三首 其三","author":"江源","text":"关塞疲征马，泥沙困老龙。\n野昏边气合，月落戍楼空。\n怅别三河道，谁论万里功。\n寒灯孤戍里，看取宝刀雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中客怀","author":"江源","text":"万里思归客，徘徊无所亲。\n浮沉千古事，凄断百年身。\n冠冕通南极，江云暗北津。\n故园肠断处，万里未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕感兴二首 其一","author":"江源","text":"今夕知何夕，青阳逼岁除。\n暮年千里客，故国一封书。\n就枕灭明烛，鸣榔闻夜渔。\n明朝遥捧酒，空望白云衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕感兴二首 其二","author":"江源","text":"旅馆谁相问，兀然空一身。\n岂知新岁酒，已少去年人。\n渐与骨肉远，空邻鸥鸟亲。\n无论去与住，谁道不逢春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送友人入蜀","author":"江源","text":"立马愁将夕，嗟君万里行。\n潮平秋水阔，风急暮猿清。\n芳树笼秦栈，烟花望锦城。\n殷勤共杯酒，不必有离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行遣兴二首 其一","author":"江源","text":"无嗟千里远，山断水茫茫。\n草市迎江货，枳花明驿墙。\n身心尘外远，书剑梦中忙。\n在世谁非客，尘心徒自伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行遣兴二首 其二","author":"江源","text":"异国久为客，故园何日归。\n汀烟轻冉冉，江燕正飞飞。\n千里河流直，孤舟人事稀。\n登临思不已，吟好送斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中思亲八首 其一","author":"江源","text":"一见清明一改容，悔将名利役疏慵。\n一身千里家何在，持酒无因洒墓松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中思亲八首 其二","author":"江源","text":"一生三万六千日，一日思亲十二时。\n清秩偶叨非养望，一杯成喜亦成悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","poin