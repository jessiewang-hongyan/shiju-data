[{"title":"饮汊口宗家语次偶赋","author":"程敏政","text":"流水溅溅石路平，几年鸡黍约初成。\n古芸绕架香还盛，乔木当年老更荣。\n招隐不惊探虎穴，忘机偏解结鸥盟。\n斜阳未尽渔樵话，刻竹题诗寄此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午饮汊口汪端家忽记京华旧事","author":"程敏政","text":"紫云溪上作端阳，忽记前年黼座傍。\n分艾特颁宫样虎，侑尊时出上供羊。\n綵丝系臂饶恩露，聚扇回风带御香。\n抚景不堪惊岁月，愧无才力报君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云水山房","author":"程敏政","text":"杖策云溪上，濯足云溪下。\n由来故王孙，却是忘机者。\n仰看鸢戾天，俯见鱼潜渊。\n欲悟动静理，日到云溪边。\n溪云时卷舒，溪水可厉揭。\n珍重溪居人，斯言或相契。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其一 汊口","author":"程敏政","text":"二水中分白鹭洲，人家多住竹棚头。\n眼前有景道不得，长夏江村事事幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其二 赠汊口诸宗人","author":"程敏政","text":"文武衣冠异昔时，惠连群从总能诗。\n东园载酒西园饮，药饵扶吾随所之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其三 赠逸民用光","author":"程敏政","text":"清风明月两閒人，何用浮名绊此身。\n闭户著书多岁月，野花啼鸟一般春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其四 晚步云溪上","author":"程敏政","text":"山屐经过满径踪，閒来无事不从容。\n白沙翠竹江村路，云碓无人水自舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其五 夜宿用光南窗下","author":"程敏政","text":"门外青山如屋里，嘈嘈虚枕纳溪声。\n怪来诗思清人骨，欲化西园蝶未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其六 谒忠壮行祠","author":"程敏政","text":"松花风煖庙门开，百亩庭中半是苔。\n怅望千秋一洒泪，安危须仗出群材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其七 拜端明公墓","author":"程敏政","text":"苑边高冢卧麒麟，曾是贞元花下人。\n人世几回伤往事，碑文才见满埃尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集古八绝 其八 望岩将公墓","author":"程敏政","text":"流水溅溅度两陂，旅坟三尺近要离。\n鸟啼花发人何在，一剑曾当百万师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿榆村宗老以顺义官七十九岁","author":"程敏政","text":"人生难得古稀龄，况乃重看九度蓂。\n庆衍芝兰盈谢砌，义沾恩宠出尧庭。\n卷舒任我心何累，饮啖兼人体自宁。\n遐算定同师尚父，榆川山色共青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兖山汪处士世宁留宿予适有事辞归别后寄此","author":"程敏政","text":"越国勋名重有唐，兖山家法冠诸汪。\n主人有道开鸥社，子姓无哗列雁行。\n李白拟尝新竹酝，陈登空扫旧藤床。\n两怀不尽忙相别，咫尺停云万里长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄坑寺","author":"程敏政","text":"一坞深深竹树长，梵宫遥枕碧山冈。\n废兴屡换新碑石，俎豆犹存旧寝堂。\n为祝慈龄参佛母，敢将诗病叩医王。\n清谈未了匆匆去，不尽毗那一瓣香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"率口族人燕予世忠行祠","author":"程敏政","text":"忠壮行祠率水边，锦屏银烛夜张筵。\n祖宗望出南朝上，子姓分当北宋前。\n谈麈频挥人似雨，劝筹交错酒如泉。\n相违记取重逢日，万里鸥波解绶年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄石谒太母庙","author":"程敏政","text":"黄石丛祠在，人传太母名。\n子功全故国，神鉴定佳城。\n香火千家盛，冠裳八座荣。\n阃仪谁有此，瞻拜不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮率东族家","author":"程敏政","text":"路入方山一里强，百年程氏率东房。\n教条半出朱隆隐，家法多宗郑浦阳。\n庭户各分乔木影，图经犹带旧芸香。\n花前棋局灯前酒，无限宗盟夜坐长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题钖山孙王庙","author":"程敏政","text":"庙食青山岁月长，居人多未识孙王。\n江东讨逆功初著，许下迎銮志莫偿。\n一代英豪存太史，三分名节愧元方。\n何当订入新图志，祀典分明重此乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿坑口孙启先生家次韵时予以疾戒饮故诗及之","author":"程敏政","text":"前辈风流杳莫俦，近来人物数谁优。\n閒心坐与鸥盟狎，世态看同蜃气浮。\n无分清尊开北海，有情吟榻借南州。\n掀髯久欲闻长啸，明月何时共倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过郑公钓台","author":"程敏政","text":"相公湖边一拳石，截断湖光三百尺。\n射蛟人去今几年，谁扫云根看遗迹。\n师山先生性爱山，偶然得此青孱颜。\n临流坐钓不知晚，渔樵并载扁舟还。\n武威余公天下士，特与先生题篆字。\n良工刻入断崖傍，遂使溪山增胜事。\n一朝海内风尘生，两公死国如弟兄。\n平生隐显虽异迹，竹帛同垂千载名。\n薰风雨过潮初落，足蹑苍苔俯幽壑。\n钓丝已逐野烟飞，字画多为古藤络。\n师山之节峻且孤，武威之字人争摹。\n忠贤所遗众所宝，泉石清奇何处无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题唐十八学士登瀛图","author":"程敏政","text":"冠冕分明见盛唐，百金谁购宋宫藏。\n山人妙绝丹青手，学士名高翰墨场。\n千里忽惊雷剑合，十年空叹楚弓亡。\n摩挲手泽真非偶，抚卷令人羡紫阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"予访王氏子仁泰于泽富仁泰适以是日生男时予方以疾断酒为之喜而破戒赋诗赠之","author":"程敏政","text":"深巷方停下泽车，便惊佳气蔼庭除。\n数声喜报檐前鹊，一颗光呈掌上珠。\n兆应熊罴来梦日，庆随弧矢上门初。\n因君破戒重开酒，佳话流传遍里闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过余岸拜远族祖宋枢密","author":"程敏政","text":"高坟山下几经春，曾是先朝执政臣。\n甲第儿孙惊异县，梵宫香火幸比邻。\n金貂入像图应在，石兽分行迹未陈。\n同出相湖惭后学，不堪追仰荐溪蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邵村张氏子茂植年十二俊颖可爱其父才遣从予游以其尚幼俾先之于塾师俟少长则收而教之且勖以诗","author":"程敏政","text":"楚楚青年子，明明玉树枝。\n少仪须读礼，多识贵闻诗。\n乔木云霄迥，良苗雨露滋。\n执经函丈下，看尔出群时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题汪本仁处士耕读轩","author":"程敏政","text":"小结幽轩傍水涯，此中耕读两相宜。\n欲求莘野千年志，乐诵豳风一卷诗。\n春垄短蓑鞭??，夜窗明烛听吾伊。\n老来达道应无及，付与名郎佐盛时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过岑山渡","author":"程敏政","text":"势比焦山小，因名忆郑公。\n江鼋浮水面，天狗堕云中。\n舟楫东西过，渔樵上下通。\n涉溪逢旧寺，尘虑偶然空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿万山观六言四首 其一","author":"程敏政","text":"词客初停尘鞅，鍊师相约楼居。\n赤日正过林樾，好风时到庭除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿万山观六言四首 其二","author":"程敏政","text":"石磴盘回九折，山房小结三间。\n酷暑因风尽扫，道心与鹤俱閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿万山观六言四首 其三","author":"程敏政","text":"灯影半窗冉冉，垆薰一炷亭亭。\n多病思投白社，老人为说丹经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿万山观六言四首 其四","author":"程敏政","text":"一派滩声东去，满空月色西流。\n但觉梦游尘外，不知身宿山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮万山观东明楼赠道庸都纪","author":"程敏政","text":"五月高楼暑气凉，捲帘山色动晴光。\n病来喜服乌蛇酒，睡起频添宝鸭香。\n堆案道经翻蕊笈，绕梁仙乐奏云簧。\n何时解绶归林下，许借閒云宿半床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗家贡士迪请诗送其友人还浙","author":"程敏政","text":"见君几日送君归，梅雨纷纷湿苧衣。\n来喜客舟重返浙，去惊乡语半从徽。\n石榴庭院黄蜂入，水稻田塍白鹭飞。\n揽胜他时还有约，莫辞尊酒暂相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题于文远山水小景","author":"程敏政","text":"望中疑是富登山，只欠危亭著树间。\n记得摩厓看石篆，小舟曾泊相湖湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"道庸都纪城市山林卷次韵","author":"程敏政","text":"上逼青霄下瞰城，来游何必羡登瀛。\n风前不动旌幢影，云外时闻杵臼声。\n盟狎海鸥机渐了，梦回蕉鹿世空惊。\n丹房何日全相借，慰我吟身太瘦生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"范蠡归湖图为师鲁侄题","author":"程敏政","text":"万顷湖光足钓丝，济川功了乞归时。\n安流不用施篙楫，敛手舷头任所之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云岚山汪王墓","author":"程敏政","text":"六州已罢新开府，千载谁思旧使君。\n只有云岚桥下路，行人能指越公坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"歙北有山曰飞布甚奇山下江氏世居之山旧有主簿庙以结兵禦寇之功而江氏实主其祀今江氏之老曰嗣器其家以殷实徙京师从子韶入为京学生尝及见予予过歙欲访江氏适以疾不果赋此寄之","author":"程敏政","text":"一峰高耸碧嶙峋，一族相延几百春。\n庙守甘棠思歙簿，家传乔木自江人。\n幸瞻日月分馀照，渐觉诗书起后尘。\n多病未酬鸡黍约，不辞题句托双鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗侄贡士式之求诗寿岩镇方翁七十","author":"程敏政","text":"七十年来气尚豪，红颜如画映霜毛。\n佳辰满酿山中秫，晚岁曾餐海上桃。\n童子喜提如意舞，老人光并少微高。\n亲朋欲助长生颂，为染宣城玉兔毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观槐塘远祖宋丞相文清公明良庆会卷次王而勉太守韵","author":"程敏政","text":"丞相勋名重斗南，讲帷曾说旧师甘。\n一时奏劄多忠谏，百世赓歌继美谈。\n秦律乍除闻板荡，孔墙中坏得肜戡。\n后生景行无穷意，敛手临风读再三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再观丞相奏议复次前韵","author":"程敏政","text":"庙谟惟欲保东南，几许忠言主未甘。\n分镇独馀唐未议，徙戎谁说晋清谈。\n传家素节推杨震，去国高风忆孔戡。\n留取百年遗荫在，当门槐幄尚成三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄进士金溪尹黄硕夫","author":"程敏政","text":"百年谭渡水声长，一郡犹传孝子黄。\n不为病躯亲药饵，定瞻遗像设椒浆。\n云礽又见承新宠，父老仍思立旧坊。\n坐想昼游真得意，青山乔木总生光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题汪思恭松萝书屋 其一","author":"程敏政","text":"饱看青山读古书，无人能识市中儒。\n朝朝卖药归来晚，留得芸香辟蠹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题汪思恭松萝书屋 其二","author":"程敏政","text":"松萝门下筑书台，满架牙签一径苔。\n常有新诗生眼■，不知山色近人来。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题汪思恭松萝书屋 其三","author":"程敏政","text":"王孙潇洒皂纶巾，独起高轩出市尘。\n见说年来书更熟，门前常有问奇人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题汪思恭松萝书屋 其四","author":"程敏政","text":"秘府图书阅半交，故园松菊可全抛。\n何时更约开新社，与子山中共结茅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后与克俭弟联句","author":"程敏政","text":"细雨生凉一院风，幽情多在小斋东。\n草分秀色沿阶绿，葵吐秋花拂座红。\n睡起焚香初谢客，吟馀思茗漫呼童。\n隔林谁奏笙歌沸，预喜山城乐岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"程敏政","text":"墟落莫烟相望，板桥春涨初平。\n未放渔家艇子，疑闻塔院钟声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七月神会饮福","author":"程敏政","text":"金风初动月当申，萧鼓山堂乐赛神。\n眼■光阴真过客，坐中人物半姻亲。\n语因随俗多成笑，酒到忘怀不记巡。\n相好不堪相别处，明年应忆宦游人。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卜算子 题汪汝温便面","author":"程敏政","text":"草长沙露尖，风急波生绉。\n两个渔郎任意行，不问谁先后。\n纶竿腥乍收，饭甑香初透。\n回首相呼好放船，正是潮生候。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拜庆千秋节敬赋","author":"程敏政","text":"山城侵晓设行宫，礼庆千秋万国同。\n新学定期随日长，睿心元自与天通。\n前星位正龙楼北，南极光躔鹤禁东。\n惭愧授经无寸补，四年空立御香中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆莲盛开饮中赠潘玉汝王廷璧戴廷器三秀才","author":"程敏政","text":"盆池花照粉墙东，不数峰头十丈红。\n雅韵独超尘壒外，新妆初试月奁中。\n底须瑞露分金掌，共取清香注碧筒。\n良会一时真不偶，拟开佳兆为诸公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浪淘沙 八月九日早至南山庵","author":"程敏政","text":"沙口系兰桡。\n初退溪潮。\n石成山路树成桥。\n又见一番新稻熟，犹未趋朝。\n野寺晚钟敲。\n声到书巢。\n此身何日伴渔樵。\n少答君恩寻旧隐，细和山谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠泰塘画鱼程翁希明 其一","author":"程敏政","text":"叠嶂如城水满川，门前乔木翠参天。\n路人来往能相指，文献传家几百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠泰塘画鱼程翁希明 其二","author":"程敏政","text":"爱鱼何羡古濠梁，画出群鱼趣更长。\n正欲垂纶寻钓隐，何时相约水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋开宴南山宗贤毕集燕后閒步坟庵水次偶成赠同行诸君子","author":"程敏政","text":"初向南山见月圆，笑谈相对欲忘眠。\n他乡每岁思千里，好友今宵共一筵。\n人影渐分山寺侧，蛩声多近石梁边。\n眼前又作朝天计，同步沙头在几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题汪道全爱萱堂","author":"程敏政","text":"阿母生儿今已老，少年曾佩宜男草。\n阿儿念母心无涯，北堂远种忘忧花。\n爱母如花愿花茂，长向花前祝眉寿。\n酒盏时闻花送香，舞衣欲共花争秀。\n我心正复与子同，一曲薰风歌绕丛。\n爱母何年心始惬，霜鬓重看绿如叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祖保去岁八月二十五日亡于姑苏暂寄僧舍归瘗南山今一年矣其母忽于箧中得见旧佩香囊恸不能忍并楮钱焚其瘗处辄赋五十六字志予之悲","author":"程敏政","text":"去秋今日寄僧房，泪洒西风裂寸肠。\n冢上已浇新麦饭，箧中犹见旧香囊。\n五年父子缘何短，万里关山恨更长。\n最是不堪怀抱处，梦魂时到枕帏旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"心远轩为方景茂赋","author":"程敏政","text":"结屋西城下，幽人自不群。\n道情閒共鹤，诗思淡随云。\n与客观朝槿，呼童炷夕薰。\n不知门外路，车马日纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闰八月二十七日早送何侍御至阳山寺","author":"程敏政","text":"豸冠前日下山城，双旆匆匆又出行。\n金气作霜天九月，法星随斗夜三更。\n青围川陆知途险，黄入郊原喜岁成。\n山寺相违还有约，柏台高处听蜚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归途有作","author":"程敏政","text":"为送行台出县门，不辞携酒到山根。\n竹阴正入支公寺，树色遥连主簿村。\n潮啮新沙知废路，水舂机碓隔荒垣。\n望中一簇峰峦秀，问是乡名古夹源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题贵溪程原宗人濯缨亭","author":"程敏政","text":"洗耳常思古逸民，小亭閒傍绿杨津。\n能收楚泽歌中趣，不惹长安陌上尘。\n触目鸢鱼千古在，忘机鸥鹭一时驯。\n何年解绶遥相访，同试渊明漉酒巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送贵溪宗人世熙会谱西归","author":"程敏政","text":"贵溪溪上旧程源，百世宗盟此一番。\n祖庙已通昭穆序，客途何惮往来烦。\n云山雨后丹青出，霜叶风前锦绣翻。\n他日相期定何所，碧霄千里看鹏鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"德兴泸口程氏青云桥为贡士崧乃尊赋","author":"程敏政","text":"泸口之木高参天，泸口之水青如烟。\n主人有功能济川，长桥倏起何蜿蜒。\n眼中突兀见奇事，观者纷纷若鳞次。\n新制宁须玉蝀名，华榱高揭青云字。\n主人系出篁墩房，银青金紫相辉光。\n有家住近凤凰里，一子矫如孤凤翔。\n秋桂初分广寒殿，宫花拟入琼林宴。\n门前正起世科坊，绰楔巍巍两堪羡。\n主人白头乐有馀，看子平步青云衢。\n驷马高车自兹始，傍人不用誇相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿汪处士","author":"程敏政","text":"明明丹颊映华颠，淅淅金风拂寿筵。\n清向客来茶当酒，严于家教笔为田。\n东篱赏记前三日，西伯徵期后十年。\n遥望芙蓉秋色里，仙人应有鹤书传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":45960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]