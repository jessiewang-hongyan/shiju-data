repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玩庭前风竹戏书","author":"赵完璧","text":"㛹娟细竹玉玲珑，袅袅纤腰不耐风。\n谁遣楚宫如意舞，婆娑对酒日西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵李亨庵辛夷花 其一","author":"赵完璧","text":"惆怅春残尽日中，新词欲写倦柔风。\n珠玑不逐猩毫落，意匠悠悠铸未工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵李亨庵辛夷花 其二","author":"赵完璧","text":"阅来承宠若为容，倦写蛾眉独倚风。\n满目杨花心绪乱，彷他桃李不言中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盐城官署对葵","author":"赵完璧","text":"伟干秾妍冒雨华，粉墙摇曳晚风斜。\n黄昏小院无人见，孤负年芳独自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜","author":"赵完璧","text":"城头落日云重重，倦吏闭门睡正浓。\n雷雨满天来半夜，定知海上起蟠龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"翟家嘴感怀","author":"赵完璧","text":"老妻海上肠应断，弱子河西泪满襟。\n独向关山对明月，离怀三处总伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5