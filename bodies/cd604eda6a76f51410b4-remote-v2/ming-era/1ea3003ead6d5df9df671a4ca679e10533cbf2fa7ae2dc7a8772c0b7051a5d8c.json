[{"title":"柳山诸诗八首 其六 登春台","author":"顾璘","text":"高台倚青嶂，下顾城郭间。\n茅居散花竹，雨馀春意閒。\n相将理农务，朝耕暮来还。\n寄言长民者，勿使惠爱悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳山诸诗八首 其七 仰高亭","author":"顾璘","text":"缘云陟盘磴，俯见飞鸟脊。\n侧身最高峰，去天不盈尺。\n星陈上皇宫，风举神仙舄。\n长啸落遗音，沈沈洞庭碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳山诸诗八首 其八 极高明亭","author":"顾璘","text":"倚杖绝壁上，烈风从空来。\n苍梧亘千里，万壑秋阴哀。\n思将谒虞舜，上历金银台。\n浮云暗南极，为我须臾开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"去年予谪湘源朱升之副使以二诗寄慰兹闻升之调按滇南凄然奉答 其一","author":"顾璘","text":"题诗慰我潇湘谪，洒泪看君巂外行。\n怅望故山俱万里，苦吟秋月向孤城。\n风摧羽翼青云隔，尘满头颅白发生。\n世事近来无所爱，溪门春起欲归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"去年予谪湘源朱升之副使以二诗寄慰兹闻升之调按滇南凄然奉答 其二","author":"顾璘","text":"曾摇彩笔歌天马，更借单车访碧鸡。\n栈道西盘秦塞险，滇池东压楚宫低。\n行台日月无来信，世路风波少定栖。\n莫向空山求薏苡，马援祠庙使人悽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿灵家山僧居","author":"顾璘","text":"夜宿招提舍，秋云冷石堂。\n天河斜挂户，瀑水静依床。\n叠岭攀跻险，虚空梦寐凉。\n明朝登宝顶，期与玩神光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其一 灵家山","author":"顾璘","text":"灌木攒云猿啸悲，崩崖截涧马来迟。\n庞眉老衲忘人世，只取朝山记岁时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其二 苦鍊庵","author":"顾璘","text":"竹里流泉殷地喧，古堂犹是给孤园。\n山厨笕水深龙穴，石岭寻蹊听鸟言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其三 七十二峰","author":"顾璘","text":"七十二峰高下悬，天梯云栈互勾连。\n芒鞋竹杖空林里，一路行吟破暝烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其四 大峰","author":"顾璘","text":"城中遥望碧氤氲，拟是瑶空一片云。\n来上峰头看气象，分明平对玉宸君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其五 小峰","author":"顾璘","text":"天低石角云长拥，风掠岩腰树半摧。\n秋气忽寒高隼避，午阴将合老龙回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其六 定心桥","author":"顾璘","text":"石壁上接浮云齐，下临不测之回溪。\n道人来往浑閒事，时有惊猿落树啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其七 扫阶竹","author":"顾璘","text":"高岩短竹馀一尺，纤叶袅袅青鸾毛。\n空山无人月华冷，西风满地秋萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游覆釜山诸诗八首乃无量主人成果地也 其八 神灯","author":"顾璘","text":"云间疏焰冷光凝，千古空门不尽灯。\n一宿林中惊乍见，却留残语付山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日登柳山","author":"顾璘","text":"佳节登临感岁华，苍梧云影向秋赊。\n高空独鹤翻风去，返照澄江抱郭斜。\n南国音书催白雁，东篱归兴倚黄花。\n衰迟自爱茱萸酒，瘴疠谁悲薏苡车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其一 古塔","author":"顾璘","text":"古塔已千载，白骨为黄金。\n寒灯耿不灭，照见西来心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其二 云归庵","author":"顾璘","text":"松林有茅宇，白云往还来。\n山僧爱云好，柴门夜长开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其三 飞来石","author":"顾璘","text":"谁骑苍鸾来，啄破苔花碧。\n经年不归去，化作山头石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其四 甲亭","author":"顾璘","text":"不信湘中好，江山天下稀。\n如何万里客，终岁澹忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其五 卓锡泉","author":"顾璘","text":"老禅卓锡处，石上泉犹清。\n红尘不相染，唯有苍苔生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其六 玉虹泉","author":"顾璘","text":"一条寒泉色，迤?穿石下。\n秋雨何处寻，犹馀白虹挂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其七 法华泉","author":"顾璘","text":"寂寂空山深，荒泉四时冷。\n唯馀月明夜，山猿弄孤影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其八 玄通洞","author":"顾璘","text":"下窥杳无极，仰视白日微。\n山人把火入，照见石燕飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其九 狮岩","author":"顾璘","text":"绿草断行迹，鍧然石门开。\n分明洞天里，不遇仙人回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山杂诗十首 其十 露胜亭","author":"顾璘","text":"高亭行处尽，远岫望中微。\n日月开禅观，云霞护客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄大梁贾道诚兼简王左诸贤 其一","author":"顾璘","text":"不见贾生久，天南空断肠。\n雅文清庙瑟，儒术仲尼堂。\n心事疏鸿雁，贤罗失凤凰。\n乾坤正澒洞，愁绝尔摧藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄大梁贾道诚兼简王左诸贤 其二","author":"顾璘","text":"秋至梁王苑，何人赋最多。\n传书堪白首，欹枕即黄河。\n兴忆登台饮，悲怜击筑歌。\n无端洞庭渚，终岁浩烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄贺长史王景旸乃子登科","author":"顾璘","text":"董傅儒流重，韦郎世业新。\n陈诗閒白昼，学礼富青春。\n大府高槐色，皇都走马尘。\n此时金殿上，直欲醉逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘中送荣老还金陵永宁寺","author":"顾璘","text":"摇落三湘外，经年爱尔来。\n故人书总至，异域眼俱开。\n放逐怜亲友，悲欢向酒杯。\n衲衣经雨暗，横笛伴秋哀。\n试问寻风洞，何如对凤台。\n寺幽词客满，松古老师栽。\n梦寐惟吾土，羁累愧不才。\n江山孤兴减，瘴疠暮颜摧。\n澧浦难捐佩，龙门异曝鳃。\n相看移去棹，转见脱尘埃。\n烟水滔滔地，随缘易往回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉答乔衡州","author":"顾璘","text":"荒城闻系马，使者有题封。\n尺牍惊文古，绨袍感意浓。\n霜清楚泽水，云霁祝融峰。\n咫尺神交地，经年阻过从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲戌除夕 其一","author":"顾璘","text":"南郡迎春律，东风罢雪花。\n毳衣辞冷节，蓬鬓受年华。\n性僻为邦简，身危去国赊。\n祗应与田父，归种故园瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲戌除夕 其二","author":"顾璘","text":"堂吏封州印，家儿献岁盘。\n春兼梅蕊浅，兴落酒杯宽。\n瘴疠全生足，驱驰向晚难。\n不遑将父母，何以慰承欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲戌除夕 其三","author":"顾璘","text":"岭雪初消臈，红泉已动春。\n两年迁客地，万里独吟身。\n黄鹄长垂翅，苍鹰不附人。\n山林无限好，犹自恋风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲戌除夕 其四","author":"顾璘","text":"细雨知冬尽，催花故媚春。\n潇湘逢献岁，幽独正愁人。\n岭海犹迁客，乾坤有战尘。\n何时一尊酒，相对白头亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘江行寄孟侍御","author":"顾璘","text":"逐臣远系湘江上，散发行歌日悲壮。\n郡门江水急东流，廨宇山云作炎瘴。\n去年花发悲阳春，今岁花开更泥人。\n种瓜不及青门客，怀橘空思白发亲。\n少年意气干云起，中路摧藏乃如此。\n徒劳殴血走风尘，不救折腰临督史。\n桂林夫子旧同心，献玉君门共陆沈。\n千首楚歌犹跌宕，一瓢颜巷自萧森。\n春风闭户意何如，遥遣娇儿奉素书。\n倘蒙大府明公檄，莫惜荒城使者车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄蒋中丞","author":"顾璘","text":"山拥罗浮万仞青，水涵章贡混沧溟。\n春深乌府文书简，白日垂帘诵五经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春夜歌立春夜试灯同张陈二进士饮后作","author":"顾璘","text":"东郊春旗平旦回，泰坛灯光夜复开。\n太平天子运元极，佳辰令节参差来。\n湘南小臣复何有，阳和亦到寒城柳。\n巷陌罗幡挂玉叙，楼台画烛临朱牖。\n家家夜坐吹笙竽，对此忘却居边隅。\n千金斗酒不爱惜，五夜宴客同欢娱。\n陈孟公，张子房，两枝玉树临中堂。\n高才八韵并倾座，少年百步能穿杨。\n驷马初过桑梓里，双星更度银河水。\n日射金屏孔雀飞，池开锦浪鸳鸯喜。\n洗觥酌君君莫辞，人生难得似君时。\n且趁春花欲烂熳，与君终日醉如泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"相忆行寄鲁南钦佩","author":"顾璘","text":"金陵帝城行乐多，荏苒独奈春宵何。\n楼台压空云构丽，通衢曲巷相盘佗。\n城头月起光如日，万户华灯映街出。\n风窗雾阁隐玲珑，宝马香车意非一。\n虎头桥下是吾庐，清夜邀宾乐有馀。\n漏转几回飘火树，酒酣千遍倒砗磲。\n座中高客让陈王，风雅纷纭翰墨场。\n学士争观杜陵赋，尚书不怪孟公狂。\n嗟予中路忽分飞，戢羽湘江久未归。\n明朝客舍逢元夕，独坐思君泪满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夜","author":"顾璘","text":"明月满千门，时清乐事繁。\n酒香浮夜市，花影袅春幡。\n漏静鸣箫远，灯辉狭室温。\n苦吟酬节序，飘泊任乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春寒","author":"顾璘","text":"燕寝文书静，春寒物候迟。\n满庭犹宿草，何日且黄鹂。\n云远三华树，江深二女祠。\n不须添细雨，愁绪已如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬陈宋卿","author":"顾璘","text":"颇怪陈无已，寻诗日闭门。\n空庭疏系马，细雨负清尊。\n节序过梅萼，春阴积藓痕。\n不嫌官舍冷，烧烛对黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园分菊苗有作","author":"顾璘","text":"解带理荒圃，及兹春雨馀。\n丛菊被嘉泽，芳苗郁以舒。\n伐根辨众色，间植周前除。\n汲涧沃新壤，秉锄散故苴。\n匪惜悁勤意，爱尔气清殊。\n秋华既幽靓，夏叶亦扶疏。\n霭霭轩楹侧，颇慰陶潜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘南二月大雪戏作春雪歌 其一","author":"顾璘","text":"桂岭长年冬郁蒸，湘江今岁积春冰。\n北人饮酒歌黄竹，愁杀桃花与葛藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘南二月大雪戏作春雪歌 其二","author":"顾璘","text":"二月雪花飞楚关，浑如李白对燕山。\n祗愁晓日融城湿，讵惜飞花罥鬓斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘南二月大雪戏作春雪歌 其三","author":"顾璘","text":"山郭桃花且未红，扑檐柳絮太匆匆。\n山公久醉浑颠倒，不记湘南二月中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘南二月大雪戏作春雪歌 其四","author":"顾璘","text":"四野荒云接地齐，雪花如掌下寒溪。\n招邀白鹭翩翩舞，孤负黄鹂恰恰啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘南二月大雪戏作春雪歌 其五","author":"顾璘","text":"绕郭千峰玉作台，连林素缬尽妆梅。\n同谁跨马腰弓箭，山口盘旋射鹿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘南二月大雪戏作春雪歌 其六","author":"顾璘","text":"南方食麦胜食土，瓦砾不救饥肠苦。\n今年春雪如陇西，蒸饵家家作端午。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪霁登湘山露胜亭","author":"顾璘","text":"胜地意何限，新晴还独过。\n众山残雪满，孤嶂烈风多。\n浪迹留岩壑，幽襟到薜萝。\n俗尘休见染，欲此问维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56616,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得徐伯雨太平书奉答","author":"顾璘","text":"残腊江门望使车，新春忽枉丽江书。\n嗟予已作三湘别，念尔那堪万里馀。\n绝域风烟居暂定，深山官府事应疏。\n绝怜雅兴耽诗律，满纸琼瑶愧不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56617,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠周典膳","author":"顾璘","text":"宁亲西下马蹄劳，文采惊人一凤毛。\n南粤江山归陆贾，梁王宾客羡枚皋。\n薇堂祝寿花明酒，风动题诗月满袍。\n异域逢君又伤别，离心春水共滔滔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56618,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张进士自全州成婚归桂林","author":"顾璘","text":"马卿持节下江乡，鸾镜新欢得孟光。\n宝剑龙鳞横北斗，金屏雀影照东床。\n九天礼乐周京盛，三月烟花粤徼香。\n采服即看宜寿酒，门楣还喜映岩廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明病中作","author":"顾璘","text":"万里清明节，三年放逐臣。\n已无花共照，况有药相亲。\n岭徼饶蒸雾，江湖一病身。\n圣朝容腐朽，归去老垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶题","author":"顾璘","text":"道穷何叹拙，身病始知衰。\n座有青山对，门无俗客来。\n浮名消短鬓，雅兴寄深杯。\n颇笑刘伶辈，沈冥负尔怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧病四首寄诸兄弟 其一","author":"顾璘","text":"南州瘴雾三年客，西塞清江万里家。\n春断壶觞疏竹叶，病移衾枕失桃花。\n英雄自分填沟壑，魑魅空劳砺齿牙。\n独有苍天能料理，底须医卜浪矜誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧病四首寄诸兄弟 其二","author":"顾璘","text":"江汉滔滔绕上阳，五龙京阙拱高皇。\n舆图四塞青山固，陵寝千秋翠柏长。\n绮丽春风开画障，郁葱佳气护金汤。\n苍苔白石青溪曲，爱有巢由旧草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56623,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧病四首寄诸兄弟 其三","author":"顾璘","text":"细雨浓花思不禁，春山何处独登临。\n高鸿实寄传书泪，老马虚驰伏枥心。\n肺病闭门聊稳睡，穷愁抱膝且长吟。\n閒情已逐归云尽，独奈人间枳棘林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56624,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧病四首寄诸兄弟 其四","author":"顾璘","text":"十日春阴槲叶齐，午窗吟坐到鸡栖。\n归期漫阻桃花水，客泪重沾燕子泥。\n万里弟兄空梦寐，百年岐路尚东西。\n请看舍侧垂杨树，已映东桥旧钓溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56625,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中忆鲁南钦佩","author":"顾璘","text":"空斋高卧动经旬，远梦天涯忆故人。\n典礼近闻刘向起，草玄犹柰子云贫。\n江楼积雨鸣长夜，山郭馀花堕晚春。\n人世几何将白发，年年离恨独伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56626,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄文徵仲","author":"顾璘","text":"儒林挥笔掩群贤，湖海倾心二十年。\n藻鉴尘埃无伯乐，规模乡国有颜渊。\n黄花别泪临湖水，白雁乡书断楚天。\n山馆穷愁欹枕日，拭君图画转凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56627,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送阳春歌和陈宋卿","author":"顾璘","text":"南风吹春辞九垓，百舌怨诉黄鹂哀。\n老夫卧病亦强起，把酒劝花俱一杯。\n我家旧住金陵曲，开门正对梁王台。\n桃花盈蹊柳映地，年年爱见春风来。\n千金买鞍装骏马，山高堆粟成新醅。\n云台功名不足取，富贵于我如蒿莱。\n古人白骨穴蝼蚁，亦知王乔安在哉。\n一从弃掷向湘水，辕驹局促惭非才。\n羁栖厌见春色至，教儿刬却东园梅。\n纵有韶华满郊薮，弄花斗草随婴孩。\n青春尔今去，勿为吾徘徊。\n吾衰今久矣吾视，天地万物真浮埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56628,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘山寺同客作","author":"顾璘","text":"一麾迢递天南头，名山颇惬平生游。\n日饱窗中列岫色，更起策杖穷岩幽。\n窈曲烟霞入空翠，招邀不识神灵意。\n自从窜逐得逍遥，始叹风尘昔蒙昧。\n升堂笑问无量师，尔住青山今几时。\n翻经愿从弟子列，洗钵愧乏头陀姿。\n诛茅小乞岩前地，痛饮狂歌日来去。\n听法閒看虎伏时，怀乡莫近猿啼处。\n幽花细竹俱堪怜，烧丹服药期长年。\n费公未启王屋鼎，华老谬语天池泉。\n神仙渺茫竟难测，古往今来岂终极。\n但愿道路风波平，江上故园归即得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56629,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楚歌二首 其一 天吴","author":"顾璘","text":"灵淼淼兮焉穷，下无极兮幽宫。\n登岷峨兮远望，波龙鳞兮扬风。\n赤螭兮黄鼍，喷雾雨兮骈罗。\n望子之驾兮伊迩，交不缔兮奈何。\n眷予心兮东归，君不顾兮畴依。\n将以承兮巧笑，揆皇道兮虑非。\n荪壁兮兰堂，结桂枝兮芬芳。\n羌离合兮有期，聊容与兮徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56630,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楚歌二首 其二 洞庭君","author":"顾璘","text":"坎坎兮击鼓，望君山兮屡舞。\n陈烦辞兮仰空，渺夫君兮何所。\n波四漫兮汤汤，会百川兮同量。\n津无梁兮不可以涉，测地弥广兮度天愈长。\n驾兰桡兮扬桂旗，飘风起兮又汩之。\n浮余瓠兮水际，理余佩兮川湄。\n众纷纭兮磔肥牛，顾玄醴兮增余羞。\n陟虚坛兮伫立，徒终岁兮离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56631,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]