[{"title":"柳枝词","author":"杨慎","text":"结根元自在青冥，䙚䙚依依映紫庭。\n怪得古来天帝醉，柳边高揭酒旗星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题便面画新柳","author":"李日华","text":"雪消野水半融泥，冻柳森森态未齐。\n昨夜一番春雨好，淡黄金色满湖堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南山杂咏","author":"怀渭","text":"暮春三月风日妍，乱折花枝送酒船。\n西岭山光青浸水，南池柳色绿生烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳塘","author":"永瑛","text":"千树垂丝两岸烟，绿波春雨白鸥天。\n江乡不近章台路，留得长条系钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃","author":"方九功","text":"一曲桃园树，平沙十里春。\n落花红胜锦，藉草绿如茵。\n野兴邀诗伴，村沽觅酒邻。\n怕逢渔父问，疑是避秦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃花","author":"申时行","text":"万山回合似天台，二月桃花已遍开。\n映水却疑乘浪煖，缘崖故是倚云栽。\n乱红飞雨沾衣袂，碎锦分霞入酒杯。\n漫道武陵仙路远，探奇有客问津来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃","author":"张新","text":"绿浅红深醉眼浓，殢人何处不迷踪。\n飞时莫浪随流水，自有春涛可化龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘松年桃花山水小幅","author":"德祥","text":"杳无鸡犬有人家，夹水山高路不赊。\n刘阮别来频甲子，年年春雨送桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游西洞庭","author":"德祥","text":"玉柱金庭在洞中，当时谁道有毛公。\n人间白发三千丈，只见桃花一片红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅影","author":"朱之蕃","text":"斗帐香浮月欲斜，纵横疏密遍窗纱。\n恍疑姑射仙姬步，来访西湖处士家。\n转盼含情仍逞态，全欺琢玉更蒸霞。\n溪藤点笔留芳韵，书幌银釭不用遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅","author":"朱之蕃","text":"东皇著意布三阳，点缀疏枝弄早芳。\n刻玉镂冰无俗韵，钩帘汎坐有馀香。\n卧游庾岭云横路，梦到西湖雪映塘。\n相对倾樽明月上，行吟绕树不知忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老梅","author":"朱之蕃","text":"空岩曲折挂苍虬，骨干崚嶒韵致幽。\n闇淡输香宜纸帐，森疏濯影向溪流。\n懒随艳冶荣千树，独葆青真隐一丘。\n自有松篁深结契，江天春柳任轻柔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禁中梅花","author":"罗伦","text":"一段清香蔼禁闱，几枝疏影照寒辉。\n玉堂不让孤山趣，雪骨冰肌对紫薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅","author":"陈继儒","text":"村边杨柳已拖黄，一路云深旧讲堂。\n偶向梅花村里度，芒鞋到处雪痕香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画梅","author":"释大遂","text":"古干横斜意自奇，半开半蕊亦相宜。\n寒时悔不前村觅，知是溪桥第几枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏梅","author":"项兰贞","text":"冰玉孤清世外姿，娟娟新月上疏枝。\n无情短笛休轻弄，未是春风点额时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红梅","author":"雷思霈","text":"似是梨花靠杏芽，又飞柳絮裹桃花。\n嵰山绀雪仙娥颊，玉座丹砂道士家。\n岂为秾香非素质，故将冰蕊当铅华。\n广平心事浑如铁，作赋何妨妩媚奢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画红梅","author":"德祥","text":"三百年来处士家，酒旗风里一枝斜。\n断桥荒藓无人问，颜色如今似杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏花","author":"申时行","text":"坊开裴野锦，花发董林株。\n望欲迷琼苑，栽宜近白榆。\n微风舒露脸，小雨湿烟须。\n春意枝头闹，从教醉玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏","author":"朱谋㬜","text":"一月烧林发绛英，六街初有卖花声。\n黄鹂立亚高枝雨，紫燕飞来小树晴。\n村僻深藏沽酒旆，楼高全露约帘旌。\n年年开遍曲江寺，香在马蹄归处生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏花","author":"申时行","text":"上林佳处午桥边，半染赪霞半著烟。\n记得曲江春日里，一枝曾占百花先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杏花","author":"张新","text":"曲江池畔题诗处，燕子飞时花正开。\n报道状元归去也，马头春色日边来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拨闷","author":"朱多炡","text":"雨暗春城十万家，强支髹几到栖鸦。\n峭风欲阁游人屐，吹尽墙头柰子花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏宗良兄斋头佛手柑","author":"朱多炡","text":"春雨空花散，秋霜硕果低。\n牵枝出纤素，隔叶卷柔荑。\n指竖禅师悟，拳开法嗣迷。\n疑将洒甘露，似欲揽伽梨。\n色现黄金界，香分肉麝脐。\n愿从灵运后，接引證菩提。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"橘","author":"孙七政","text":"美人有嘉树，结实如黄金。\n微霜降秋节，芬芳满中林。\n采采不盈箧，岁暮远相寻。\n缄以尺素书，致以瑶华音。\n开缄读素书，字字琅与琳。\n把玩不去手，置我高堂阴。\n恍行洞庭上，秋色潇湘深。\n况此东南美，橘颂步高吟。\n橘柚匪芬芳，荷君芬芳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"橘","author":"陈继儒","text":"睡起难禁酒力加，醉时随卧白鸥沙。\n草堂位置新篱落，蕉叶西边橘试花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"榴火","author":"朱之蕃","text":"天付炎威与祝融，海波如沸沃珍丛。\n飞将宝鼎千重燄，炼就丹砂万点红。\n自抱赤衷迎晓日，应惭艳质媚春风。\n农家颖实需甘雨，愁拟焚林望碧空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白杨梅","author":"瞿佑","text":"乃祖杨朱族最奇，诸孙清白又分枝。\n炎风不解消冰骨，寒粟偏能上玉肌。\n异味每烦山客赠，灵根犹是圣僧移。\n水晶盘荐华筵上，酪粉盐花两不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樱桃花","author":"于若瀛","text":"三月雨声细，樱花疑杏花。\n溪转开双笑，临流见浣纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙眼 其一","author":"王象晋","text":"来从炎徼登雕俎，满架芳馨总莫逾。\n崖蜜纵甘终带酢，江瑶虽美未全瑜。\n骚人赋就芳名远，汉帝移来贝叶敷。\n较烈侧生应不忝，何缘唤作荔枝奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙眼 其二","author":"王象晋","text":"何缘唤作荔枝奴，艳冶丰姿百果无。\n琬液醇和羞沆瀣，金丸玓瓅赛玑珠。\n好将姑射仙人产，供作瑶池王母需。\n应共荔丹称伯仲，况兼益智策勋殊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葡萄","author":"冯琦","text":"晻暧繁阴覆绿苔，藤枝萝蔓共萦回。\n自随博望仙槎后，诏许甘泉别殿栽。\n的的紫房含雨润，疏疏翠幄向风开。\n词臣消渴沾新酿，不羡金茎露一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"垂丝海棠","author":"瞿佑","text":"袅袅春风拂苑墙，天机呈巧织仙裳。\n玉栏斜搭酣春睡，银烛高烧照晚妆。\n华屋雨寒愁绪乱，绮窗日暖唾茸香。\n诗成倘有纤毫补，愿醉佳人锦瑟傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海棠","author":"张新","text":"雨滋霞衬入朱颜，月下疑从姑射还。\n最是春工多巧思，著将色在浅深间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋海棠","author":"俞琬纶","text":"春色先阴到海棠，独留此种占秋芳。\n稀疏点缀猩红小，堪佐黄花荐客觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏桂","author":"申时行","text":"岩壑同栖处，风霜独秀时。\n暗飘灵隐粟，高擢广寒姿。\n露气侵衣袂，天香扑酒卮。\n桂丛吾自密，不负小山期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红木犀","author":"瞿佑","text":"滴露研珠染素秋，轻黄淡白总包羞。\n量空金粟知难买，击碎珊瑚惜未收。\n仙友自传丹灶术，状元须作锦衣游。\n一枝拟问嫦娥乞，管取花神暗点头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂","author":"申时行","text":"招隐曾缘桂树留，追欢仍爱小山幽。\n尊前露气浮清汉，云里天香散碧秋。\n老干已分蟾窟种，良宵堪续兔园游。\n灵椿晚岁能相傍，花底何妨醉白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田人送桂花有怀同庵法兄","author":"德祥","text":"上清宫里花间殿，天竺山中月下台。\n两地旧游同怅望，田家人送一枝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙桂曲题月娥帖和荪谷韵","author":"崔孤竹","text":"碧落迢迢鸾路长，天风吹送桂花香。\n玉箫归去瑶坛上，罗袜寒生一寸霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉兰花","author":"文徵明","text":"绰约新妆玉有辉，素娥千队雪成围。\n我知姑射真仙子，天遣霓裳试羽衣。\n影落空阶初月冷，香生别院晚风微。\n玉环飞燕元相敌，笑比江梅不恨肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉兰","author":"陆树声","text":"葱茏芳树雨初乾，樽酒花前洽笑欢。\n日晃帘栊晴喷雪，风回斋阁气生兰。\n参差玉佩排空出，烂熳香鳞拥醉看。\n自是东君苦留客，莫教弦管易吹残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉兰","author":"眭石","text":"霓裳片片舞妆新，束素亭亭玉殿春。\n已向丹霞生浅晕，故将清露作芳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"合欢","author":"于若瀛","text":"一茎两三花，低垂泫朝露。\n开帘弄幽色，时有香风度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗","author":"叶小鸾","text":"可是初逢萼绿华，琼楼烟月几仙家。\n坐中听彻凉州曲，笑指窗前夜合花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日閒居","author":"王虞凤","text":"浓阴柳色罩窗纱，风送炉烟一缕斜。\n庭草黄昏随意绿，子规啼上木兰花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山茶","author":"张新","text":"胭脂染就绛裙栏，琥珀妆成赤玉盘。\n似共东风解相识，一枝先已破春寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栀子","author":"于若瀛","text":"萱花薝卜亚枝柔，夏艳春娇取次收。\n丽朵乍开金谷障，冷香乱堕水晶毬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛夷","author":"陈继儒","text":"春雨湿窗纱，辛夷弄影斜。\n曾窥江梦彩，笔笔忽生花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛夷","author":"冯文度","text":"木笔花名映碧栏，词臣相对动毫端。\n晓来似惹松烟滑，疑向春风咏牡丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛夷","author":"张新","text":"梦中曾见笔生花，锦字还将气象誇。\n谁信花中原有笔，毫端方欲吐春霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"棠梨","author":"陆树声","text":"满树棠梨锦作团，双栖啼鸟斗争妍。\n边徐生色依然好，赢得东风岁岁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过孙山人故居","author":"明秀","text":"溪边野竹映寒沙，茅屋青山处士家。\n燕子归来寒食雨，春风开遍野棠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚兴","author":"张宇初","text":"晚来山色翠芙蓉，树带溪声水接空。\n自是江南春雨久，柳阴啼鸟楝花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹亭","author":"德祥","text":"满园惟种竹，竹里置幽亭。\n犬吠青松路，人来白鹭汀。\n花沟安钓艇，蕉地著茶瓶。\n老耳思鸣凤，何当借此听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"称心寺看竹","author":"章敞","text":"山深无数碧琅玕，爱静人来取次看。\n地匝翠云侵骨冷，径迷苍雪蔽天寒。\n风敲玉佩惊清梦，月浸金波起宿鸾。\n我欲平分僧半榻，烦君日日报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月十三日种竹","author":"文徵明","text":"分得亭亭绿玉枝，雨馀生意满阶墀。\n凌梢已展疏疏叶，护粉聊营短短篱。\n肯信移来真是醉，不愁俗在未能医。\n人间此夜频前席，凉月虚窗更自宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题薛淡园墨竹","author":"姚广孝","text":"淡淡烟中映夕曛，疏疏石上拂晴云。\n展图却忆西冈夜，坐听秋声亦有君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王黄鹤墨竹","author":"德祥","text":"辋川竹里旧题诗，画里如今似见之。\n满耳秋声人不到，弹琴长啸月来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行根笋","author":"朱之蕃","text":"琅玕林立拂云高，诘屈盘根茁上膏。\n龙尾挂崖鹰攫爪，凤咮衔石蟹舒螯。\n清阴只拟过邻屋，玉版何期饫老饕。\n好待春雷抽犊角，长镵不用费爬搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"笋","author":"朱之蕃","text":"龙孙头角奋春雷，蓦径穿林破绿苔。\n已放琅玕摩碧汉，聊从玉版荐金罍。\n煮泉清入诗脾健，喷饭香传笑口开。\n清味不妨频作供，万竿烟雨为栽培。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题扇","author":"蔡清","text":"风本造化权，却从手中得。\n因思天下事，也须著人力。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹 其一","author":"冯琦","text":"百宝阑干护晓寒，沈香亭畔若为看。\n春来谁作韶华主，总领群芳是牡丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹 其二","author":"冯琦","text":"数朵红云静不飞，含香含态醉春晖。\n东皇雨露知多少，昨夜风前已赐绯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芍药","author":"眭石","text":"春色今方满，名花尔较迟。\n含芳如有意，呈彩亦当时。\n调鼎需仙液，挥毫停凤池。\n天工知不浅，一夜露华滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题芍药","author":"德祥","text":"玉阶宜有此花开，金鼎调香宰相才。\n莫谓人间无彩笔，写将秾艳入云台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芙蓉","author":"申时行","text":"群芳摇落后，秋色在林塘。\n艳态偏临水，幽姿独拒霜。\n汉皋霞作佩，湘曲锦为裳。\n白首沧江上，相看醉夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"茉莉花","author":"沈宜修","text":"如许閒宵似广寒，翠丛倒影浸冰团。\n梅花宜冷君宜热，一样香魂两样看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夹竹桃花 其一","author":"王世懋","text":"名花踰岭至，婀娜自成阴。\n不分芳春色，犹馀晚岁心。\n绛分疏翠小，青入嫩红深。\n本识仙源种，无妨共入林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夹竹桃花 其二","author":"王世懋","text":"何来武陵色，移植向深闺。\n叶不迎秋堕，花仍入夏齐。\n菲菲能拂石，冉冉更成蹊。\n尚挟风霜气，流莺未敢栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月季花翠雀","author":"申时行","text":"奇葩竞吐汉宫春，日日含香送紫宸。\n千叶能随蓂荚荗，四时常应桂轮新。\n乍疑胜里金花巧，却讶枝间翠凤驯。\n愿以长春歌圣寿，还将解网颂皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月季花","author":"张新","text":"一番花信一番新，半属东风半属尘。\n惟有此花开不厌，一年长占四时春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送金员外归泉南","author":"来复","text":"朱楼别起拥飞霞，浮石桥边久住家。\n海日浴红春雨霁，鹧鸪啼上刺桐花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖杂诗","author":"来复","text":"芙蓉湾口绿阴斜，吹笛何人隔彩霞。\n惊起沙头双翠羽，衔鱼飞上刺桐花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]