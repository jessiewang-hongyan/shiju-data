[{"title":"观牡丹","author":"翁万达","text":"夏入边城草色凄，繁花开向路东西。\n交枝露退红犹滴，密叶风柔翠欲迷。\n衣上娇香飞粉堞，酒中高咏转黄鹂。\n公馀对此成清赏，况复连旬息鼓鼙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宁化道中","author":"翁万达","text":"怀忧种种山行日，舆病匆匆梅发时。\n马援功成犹速谤，冯唐身老欲何为。\n铁山回首惟流泪，龙塞关心知复谁。\n圣世应多颇牧侣，孤臣终系蓼莪思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阴那山","author":"翁万达","text":"结愿峰头云雾稠，三生檀越旧同流。\n空巢独吊存乌鹊，露地何人守白牛。\n声断磬边云纳岫，光回殿阁月窥楼。\n五更归梦青巅上，强执金吾初拜侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过虎溪","author":"翁万达","text":"虎溪祠屋对山开，白水纡回银汉来。\n绝顶云霞依石塔，斜阳钟鼓动林隈。\n远公遗事今存钵，靖节当年此筑台。\n登眺无缘愧飘忽，石梯度马又寒梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铅山望鹅湖","author":"翁万达","text":"天入鹅湖山对开，陆朱曾此筑居台。\n台存人去不复返，古木高藤生绿苔。\n不可异同求往迹，祇缘闻见转迷猜。\n惭予独抱遗经叹，梦里犹疑得鹿回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵严寺同碧洋","author":"翁万达","text":"石桥直寺开斜阳，山僧迎客流清商。\n苍崖翠壁茑萝没，琼草瑶芝云雾香。\n胜地琪林欣共赏，春风花鸟近相忘。\n丹筇赤舄随所适，昏黑犹寻甘露浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登马退山望邕州次静峰韵","author":"翁万达","text":"初夏来登千仞峰，身同飞鸟思无穷。\n五花墩树归江上，百雉城楼表粤中。\n古戍岚烟浮近郭，夕阳萧鼓动悲风。\n望仙山下草空绿，不是仙人纡玉葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入邕州次静峰韵","author":"翁万达","text":"南郡观风去复来，山城水郭亦悠哉。\n乌云故与旌旗狎，堂署兼无簿岭堆。\n奎聚辉煌依斗极，时来谈笑定风雷。\n居人漫拟棠阴地，相戒他年莫伐枚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萧关得家君平安报三首 其一","author":"翁万达","text":"忽听家君有报书，时方少息红纱渠。\n把缄初启神不戢，惊心藉此欣何如。\n念予弟妹能共事，愿托晨昏宽倚闾。\n展彩殷勤忆严训，王程且复驱我车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萧关得家君平安报三首 其二","author":"翁万达","text":"清平昨奉平安报，环水遥逢华筵开。\n七十年踰古稀颂，八千春荷大钧培。\n远游岂为黄金贵，极目欣传青鸟来。\n拜舞阶前悬寸念，凭高欲上望乡台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萧关得家君平安报三首 其三","author":"翁万达","text":"南国梅花开不迟，白云迢递海之湄。\n登门应有神仙客，行路能歌麟趾诗。\n衣豸陶然承荐锡，种槐频看长新枝。\n从来平格应多福，不是洪濛有所私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓬洲晚登一览楼自酌次壁间韵二首 其一","author":"翁万达","text":"危楼百尺起孤岑，落日登临兴不禁。\n天近自无尘俗到，江空时有蛟龙吟。\n纤云依树巧疑坠，明月满城凉欲侵。\n华盖高高悬紫极，不妨独对酒杯深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓬洲晚登一览楼自酌次壁间韵二首 其二","author":"翁万达","text":"高柏丛篁非故岑，凭栏极目思难禁。\n秦关遥识青牛气，粤海空怀白石吟。\n鸿雁不来乡信断，簿书无补岁华侵。\n劳歌慷慨何为尔，倘欲飞归秋又深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀薛中离二首 其一","author":"翁万达","text":"年来双剑别南州，跃马相逢非旧游。\n周道秦川皆历险，雁关高阁又经秋。\n鹿门尔放青山鹤，龙塞予登明月楼。\n异地可怜迷出处，思君一倍长离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀薛中离二首 其二","author":"翁万达","text":"幽栖今有薛夫子，时与白云相往来。\n春载罗浮归药笥，山依玉简起书台。\n海中仙侣常应聚，梦里宗溪识几回。\n烟水故林吾不负，拂衣他日共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"结愿峰头失题","author":"翁万达","text":"念余昔日共谈经，愧尔词林早立名。\n摛藻远追唐大历，拜官今出汉承明。\n春移潞水仙帆杳，秋到芹宫绛帐横。\n闻说岑溪山万顷，碧梧应有凤凰鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"市中寺","author":"翁万达","text":"竹屋斜开临市墟，桃花背指野人居。\n东风榆柳歌梵宇，子部郎官拥使车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓬辣滩","author":"翁万达","text":"滩高水急吼素秋，雷风动地舟人愁。\n东去潮阳沧海接，应看此水作平流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠紫峰","author":"翁万达","text":"山人住在潼关西，江湖角巾情自怡。\n屋后紫芝长一尺，无数东风不受吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云阳","author":"翁万达","text":"云阳山下白云垂，雁塞天边赤雁飞。\n目断岭南天万里，春深梦着老莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途次题壁","author":"翁万达","text":"戎事关心忆去时，风尘荏苒复何之。\n花枝桃李忽满眼，客路车马无停期。\n礼法独怜中散放，关山空有杜陵悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题","author":"翁万达","text":"畿辰昔倾天上露，交降昨洗粤中尘。\n平生心事可人语，霄梦分明摧石麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦屏岩","author":"翁万达","text":"崖悬百尺古，面削一屏开。\n晴日流丹草，春风长绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王君静斋崇慕堂","author":"翁万达","text":"一塌崔嵬里，云空繁露清。\n丹书侵翠壁，松桂表遗灵。\n结子频思岵，藏经忆过庭。\n悲栖增健翮，重见起高冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送戴宾竹封君旋里","author":"钱仝","text":"九重紫诰方承宠，万里苍江又买舟。\n古道风花浑老兴，短篷烟月是新秋。\n无机白鸟随归棹，有约青山识旧游。\n不了枌榆无限意，暮云何处阖双眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过阇西山","author":"谢邦信","text":"阇西山色高百寻，我行独傍鼋鼍吟。\n霜天箫鼓双江迥，海日帆樯大虎阴。\n菅蒯历历蝤蛑出，斥卤茫茫牡蛎深。\n正是暨南声教地，他时诸益几沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柯卫尉招饮城楼同孙明府","author":"谢邦信","text":"层城台榭枕河流，翠竹黄花亦胜游。\n萧瑟堪为庾信赋，衰零还倚仲宣楼。\n弹琴白日无多事，说剑清宵有壮猷。\n况接杜陵词客饮，可能无意赋悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"谢邦信","text":"小金山寺山气幽，山下长江带寺流。\n锦石苍松常入梦，野袍芒屩恰宜秋。\n杜陵多难常忧世，触武无能自白头。\n回首昔游已陈迹，牙樯飞旆晚悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清平道上杂感","author":"陈思谦","text":"掩卷生怀抱，登楼复啸歌。\n旅情凭浊酒，乡思厌沧波。\n霜落梅花苦，天阴雀噪多。\n不堪白云处，亲发两皤皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题三洲岩","author":"何南","text":"岩畔青山紫翠堆，昔闻此处胜蓬莱。\n幸来游览仙遗迹，留壁诗文长绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秦望山","author":"潘梅","text":"提封犹禹甸，望海自秦山。\n万事花争发，孤云鸟共还。\n方隅从眺览，磴道足跻攀。\n拟叩金银阙，丹砂少驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"省墓","author":"潘梅","text":"频年遥作吏，竟日倍思亲。\n梓里云根冢，松门梦裹人。\n乞归瞻马鬣，引步陟龙鳞。\n风木皋鱼恨，于今更怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓟门春晓","author":"潘梅","text":"万里鸣驺入帝京，春风骀荡曙云平。\n祥光隐隐金为阙，佳气葱葱玉作城。\n南海日浮龙舸远，西山天敞佛灯明。\n惟馀湛露深汪濊，嫩柳新蒲太有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"抚州署中答黄宫詹才伯","author":"潘梅","text":"彭蠡湖南下小艭，只缘司马殿名邦。\n宗工暂辍长杨赋，幼妇因贻弱柳江。\n佐郡散衙怀旧侣，倚楼闻篴调新腔。\n劳劳往返邮亭使，珍重书传鲤一双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日与诸僚长登茱萸亭","author":"潘梅","text":"令节凭高引兴长，半天秋色落壶觞。\n茱萸亭畔濡凉露，砧杵人间捣夕阳。\n天碧纵横啼过雁，山青悲咽乱唫螀。\n不知此日龙山会，潦倒谁如落帽狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"断蛇沟","author":"潘梅","text":"白蛇中断此荒丘，汉祚炎炎四百秋。\n霸业已随灰烬灭，遗踪犹说断蛇沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅都御史林念堂宗藩奏疏御史陈青田大征檄文咸用余通纪治安策感而有作","author":"陈建","text":"一编资治敢沽名，忧国忧时不尽情。\n岂有丹砂藏石室，何当芹曝献彤廷。\n禄粮通变宗藩利，兵律昭宣岭海清。\n勿讶杞人空抱虑，经纶应不负生平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽叶太宜人","author":"陈建","text":"天下有至理，大数不可移。\n天下有妙理，感应天无私。\n吁嗟太母贤，令德女中师。\n内助誉已播，教子名并驰。\n一朝膺诰锡，冠帔乐清时。\n云胡大数临，风波匪人为。\n伟哉仁冢嗣，一德表孝思。\n颠沛知有母，宁复顾身危。\n号顿吁上帝，身代复奚疑。\n仗此精诚格，感应桴鼓随。\n异梦速匠氏，飞渡瞿塘瀰。\n须臾神斧挥，解蹇跻平夷。\n贤母幸无恙，顾视喜移时。\n全家荷无恙，冥冥显护持。\n岂有他谬巧，孝弟通神祇。\n始信天人理，居高还听卑。\n贤母适数尽，和扁不可施。\n巨峡洪涛中，拯溺兹已奇。\n五十不称夭，矧已届古稀。\n况复多贤嗣，振振并麟儿。\n二难尤世罕，勋业期皋夔。\n策名垂汗简，显扬端在兹。\n含笑九原下，应知靡憾遗。\n感此希奇事，相逢重叹咨。\n愧乏如椽笔，聊尔陈芜词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浴日亭","author":"李秉同","text":"黄木湾头古野亭，亭虚俯槛吞沧溟。\n扶桑遥报日将起，洪轰海底鱼龙惊。\n细濯咸池真皎洁，不比寻常乍明灭。\n悠悠燠照遍垓埏，风檐蔀屋皆澄澈。\n昔唐最重虞渊功，尘埃洗尽依旧红。\n会得何须赤绳系，自有擎手回苍穹。\n夸父邓林徒扰扰，鲁阳三舍应未了。\n晋人见说寡君须，岂知线量终缥渺。\n狂夫炙背献至尊，烈士曝书遗儿孙。\n世事浮云祇如此，我爱古来铭浴盘。\n亭去波罗犹咫尺，庙神相对遥相忆。\n朝捧清光荡祲氛，暮绕馀辉江震击。\n效灵宣秘护濠城，蛟腾凤舞黄河清。\n果然羲驭寅宾旭，万国山河属大明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古","author":"李秉同","text":"矗矗丛祠隐隐碑，荒陵何处到今疑。\n伤心岭海浮征舸，回首陈桥捲战旗。\n一木可能支大厦，千金无计赎孤儿。\n翠华黄屋空尘迹，绿水青山似旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝节坊","author":"李秉同","text":"繄先烈妣仰何氏，佑启后人昭二美。\n因心淳笃孝于姑，坚贞弗贰从夫子。\n夫子明经荐省闱，云胡遽驭红云里。\n奔走悲号逆旅魂，关山迢递心千里。\n寒灯寂寞守空闱，蘋藻时修中馈事。\n不期姑疾在膏肓，早暮走穷卢扁技。\n引刀割股和汤剂，一死报之吾分耳。\n此时此心天所知，果然沉疴旋即起。\n孝思贞节古难兼，矧在女流能有几。\n节媲共姜孝过之，诚堪追彼太任姒。\n旌书束帛下彤廷，系节标扬重青史。\n华表亭亭屹一方，声名赫奕流千纪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤台秋霁","author":"李秉同","text":"清秋吟社色，宋玉不胜情。\n风急猿声碎，天高雁字横。\n井梧和露下，砧杵杂笳鸣。\n酌上桐梢月，黄花香满城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廉泉","author":"李秉同","text":"一水旗峰下，源流久陆沉。\n源从石罅过，流到海门深。\n堪洗许由耳，更倾吴隐心。\n寄言冰檗士，相与细追寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵川夜坐写怀","author":"李秉同","text":"寂寂幽窗忍独醒，疏灯残月两微明。\n子规枝上啼初彻，蝴蝶丛中梦未成。\n蓬鬓不愁朝镜改，浊醪偏爱晚杯清。\n何时净扫苍崖石，坐对南山接凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成次白沙先生韵","author":"李秉同","text":"秋风拂地秋山清，野吹那堪隐几听。\n韩愈独能排横议，希元何事著心经。\n肯加涵养终须畅，净扫尘埃却自灵。\n朗月渐高云渐散，紫薇深处见垣星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏穫庵","author":"李秉同","text":"欲归未归复何如，响应同声几郡除。\n斗米不移陶令操，薰膏空校太玄书。\n青云有分三冬足，白发无私两鬓馀。\n谁念千年吾道计，振衣高趁旧山居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏见江","author":"李秉同","text":"握手仙台几度春，别来消息两无闻。\n酌高楼月偏怜我，咏入霜丛却忆君。\n薇署绩光西汉传，衡门踪谢北山文。\n赤冈黄岭元同脉，莫惜新裁寄白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题祁榕湾别号","author":"李秉同","text":"水色榕阴一味清，道人应为寄閒情。\n只须翠幄疑彭泽，那用红霞认武陵。\n酌酒放歌寒玉涌，倚蓬长笑碧云生。\n乾坤此景无人会，明月何时一棹横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻袁莞沙移守夷陵","author":"李秉同","text":"分符报政未经年，路绕衡阳喜复传。\n冠服已将回左衽，湖湘容易转吴船。\n功联汉柱青云上，忧系燕台玉几前。\n此去荆门应不远，金溪馀韵想依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江亭写怀","author":"李秉同","text":"溪头常拟别吟窝，无奈衰残入鬓何。\n麟凤不来知梦改，莺花为伴觉春多。\n水流涧底空鸣瑟，风到松梢自起波。\n世事浮云古如此，观澜何用五噫歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城山访陈碧洋主事","author":"吴继乔","text":"海国风涛壮，巍然见石城。\n苔痕侵地绿，岭气接天青。\n路锁朝霞霭，江横夜月明。\n悲风惊树杪，龙卧渴苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒菊坡有作","author":"伍訚","text":"夫何造化妙，产此名世贤。\n横胸几渊海，直步三山巅。\n道德百世师，呼吸雷风随。\n出手无全牛，历历堪鼎彝。\n孤忠久忧国，端揆宜戮力。\n当宁侧席思，胡然乐家食。\n吁嗟宋阳九，奇袤蚀仁厚。\n毒手摧纲常，真魏已掣肘。\n贤俊几登崇，叶公能好龙。\n大厦支一木，胡马鸣西风。\n岂谓惮错节，泉流自中竭。\n辞疏几千年，义命真皎洁。\n寒坡秋露深，霜英动豪吟。\n灵凤奋万仞，矰缴嗟何心。\n悠悠四百年，白日悬青天。\n晨窗对书读，清风犹泠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲水流杯","author":"汤价","text":"王溜清虚出翠微，谁从太乙泄玄机。\n千年流泽遗仙籍，九曲传杯醉谢晖。\n张老岩高红日近，葛川台石紫霞飞。\n狂歌一曲清藜瘦，回首苍茫云树稀。\n逍遥不尽登临兴，更向清泉共濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"陈尧典","text":"振衣重上妙高台，朔气初随白雁来。\n万里壮怀江月皎，一声长啸海云开。\n天边倚剑星流彩，花下裁诗鸟为催。\n沉醉凭阑狂兴逸，试将春信问寒梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其一","author":"陈尧典","text":"直上飞来第一关，飘飘疑是隔尘寰。\n半云招我丹青里，尽日嬉游画幅间。\n孤鹤影横江水碧，哀猿啼彻峡山寒。\n平生野兴梅花寄，领得春光两袖还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其二","author":"陈尧典","text":"芙蓉削玉耸嶙峋，云壑中藏万古春。\n览胜扪萝还笑我，凌空飞锡又何人。\n猿声啼冷千岩月，山色幽无半点尘。\n趺坐苍崖观不尽，丹青天外画图新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浴日亭次东坡韵","author":"林光","text":"落落星辰没远天，腾腾金浪满黄湾。\n无时可滞升空日，万撼难摇抱海山。\n天远未须扶赤手，霞红不觉上苍颜。\n须知造化烦谁力，无限阳和宇宙间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扶胥书事借东坡韵","author":"林光","text":"扶胥几许频声意，黄木空流水一湾。\n何处此杯偏放手，百年青眼细看山。\n浮生向老输钳口，黑发逢秋未腆颜。\n多谢波罗数株树，也能相候水云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠","author":"王廷翰","text":"天水浮金印，云山作画图。\n禅钟惊鹤梦，云影落昙芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"学堂岭","author":"温孔德","text":"系马振衣千仞屏，凌虚身世羽毛轻。\n长天雨歇云容淡，远岛风来暑气清。\n松鹤一声闻碧落，渔舟几点杳沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿五层楼 其一","author":"邝梦琰","text":"高楼飞步势层层，夏木阴阴暑不生。\n地接东南三楚界，星分翼井两瓯屏。\n尉佗碑在莓苔古，伪汉江流日夜声。\n为问伯图今壮否，夕阳满地野烟腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿五层楼 其二","author":"邝梦琰","text":"崚嶒高阁与云浮，几度凭栏对白鸥。\n梧树朝阳栖凤馆，桃花春水化龙洲。\n地连百粤千峰出，天入三江万里流。\n芳草东风无限意，不堪回首仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]