[{"title":"闻徐子与解汝宁太守","author":"黎民表","text":"一麾犹未达，多病遽隳官。\n岂为才名误，终伤世路难。\n河濆归客骑，苕水濯尘冠。\n猿鹤应相语，空山得岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳雨夜王仪甫吴约卿杜从殷见过时王将外补","author":"黎民表","text":"汎羽逢今夕，春阴未有花。\n乡心随去雁，城柝乱栖鸦。\n聚散京华梦，飘零汉使槎。\n朋知青琐满，前席莫言赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李伯承将之谪所同吴约卿欧桢伯携酒过讯","author":"黎民表","text":"星斗正阑干，春风夜复寒。\n归心牵濮水，别酒共长安。\n流落诗名在，驱驰吏道难。\n莫言捐玦易，曾著鵔鸃冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王正意之任怀庆","author":"黎民表","text":"不薄王门吏，知君属数奇。\n图书观洛日，车骑入梁时。\n沙覆经秋草，风高积雪枝。\n河堤回首处，碣石暮云垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约卿授馆桢伯携酒过讯","author":"黎民表","text":"风尘疲上谒，幽兴屡难忘。\n敛屐穿深竹，移尊过草堂。\n流尘经雨净，微月逗云光。\n谁下南州榻，相怜有异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过刘刑曹仲恭出先世所藏名贤翰札相示","author":"黎民表","text":"华省归常晚，明灯坐不迟。\n雨凉新草径，风静落花枝。\n物论中朝在，文章故老贻。\n西园叨胜引，清夜可无诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"佛日过顾汝和观柳公权书兰亭禊帖同许元复文寿承姚元白集","author":"黎民表","text":"欲寻修禊事，屡问辟疆园。\n车马尘方静，莺花日稍暄。\n馔蒲供早食，班草对清尊。\n莫谓过逢易，三生此共论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桢伯以西山纪游诸篇见示因书其后","author":"黎民表","text":"闻追金马客，振锡万峰阴。\n西岭元天竺，东来是佛心。\n梯楼还见日，绝壑更扪参。\n归诧风尘士，探珠自宝林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"迁居","author":"黎民表","text":"沈冥无所适，燕市又移居。\n庑下从栖泊，蓬门倦扫除。\n炎风时展簟，凉月乍窥书。\n犹说金张第，登龙日不虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家报云岭外焦旱殊甚深有渔樵之忧赋此","author":"黎民表","text":"近得家园信，羁人易怆情。\n四郊多垒战，三月废农耕。\n婚嫁谋多拙，渔樵计未成。\n谁怜炊桂者，犹自滞秦京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同许长史殿卿姚鸿胪元白欧文学桢伯游郑氏园池 其一","author":"黎民表","text":"何处移觞得，欣逢出郭晴。\n林光披雾远，树色入池清。\n喜客禽争聒，穿花日递明。\n虽然萍水地，携手一交情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同许长史殿卿姚鸿胪元白欧文学桢伯游郑氏园池 其二","author":"黎民表","text":"逼仄缁尘里，兹游属兴奇。\n梯云花落树，伏槛水平池。\n暝色催歌起，凉风返棹迟。\n分携还此日，须忆桂丛枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姚元白将还金陵同顾汝和兄弟欧桢伯过访","author":"黎民表","text":"伏热应难避，幽寻重有期。\n蓬门经雨静，旅馆见花迟。\n世路归能早，才名宦独卑。\n飘零五湖约，杯酒又何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约卿自邯郸回同桢伯过讯留酌出示张助甫所寄书","author":"黎民表","text":"三径促行杯，单车远道回。\n凉风披菡萏，深夜坐莓苔。\n洛水双鱼至，晴天一雁来。\n碧云何处所，乘月故徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约卿自北岳回以庙碑见贻","author":"黎民表","text":"绛节凌虚上，行吟已日边。\n树穷沙碛外，石堕寺门前。\n云气扶双舄，泠风下列仙。\n相逢嵇叔夜，犹枉紫苔篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独坐","author":"黎民表","text":"触热还骑马，乘閒即掩扉。\n乡愁来伏枕，雨气入秋衣。\n薄禄胜渔猎，贫家望蕨薇。\n简书闻遣将，为解揭阳围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕约卿携酒邀过桢伯馆","author":"黎民表","text":"北斗拂阑干，凉风下露寒。\n新妆初学凤，彩女正乘鸾。\n别恨良宵促，来期隔岁难。\n谁怜金屋里，犹倚桂华看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜姚元白欧桢伯携酒过访","author":"黎民表","text":"杯酒销馀日，茆斋坐夜清。\n疏砧风外急，孤烛雨中明。\n乡国伤多事，浮沈笑此生。\n问奇吾转愧，难得是交情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桢伯馆同咏秋雨得青字","author":"黎民表","text":"萧飒含悲思，那堪倦客听。\n风烟驱惨淡，木叶应飘零。\n远树先浮白，重峦骤失青。\n停云无浊酒，谁为遣沈冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"助甫梦与余泣别见寄","author":"黎民表","text":"谪宦人情异，新秋景物悲。\n别离如昨日，少壮岂前时。\n易水风犹惨，关山月屡亏。\n故园嵩洛畔，携手莫教违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伯常携酒过访僦居","author":"黎民表","text":"载酒蓬扉下，烽尘正此时。\n将军勤破敌，野客废谈诗。\n久坐丛花烂，狂歌白氎欹。\n边尘犹未静，吾敢道归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉命至西山坟园 其一","author":"黎民表","text":"回首长杨苑，风霜始觉秋。\n青山低卷幔，寒日淡披裘。\n杨柳兼村落，菰蒲有钓舟。\n佩鱼虽汉使，还得采真游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈侍御道襄宅离夜遇雪得零字","author":"黎民表","text":"把袂风尘日，燕歌且共听。\n客心寒易怆，离夜酒长醒。\n蕉荔经持节，江湖感聚萍。\n黄金交谊少，垂白任飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈宪使少岩之西越附寄舍弟书","author":"黎民表","text":"偶逢铜柱使，一寄岭南音。\n乡思楚云碧，江帆漓水深。\n名途谁荐士，歧路我沾襟。\n不似西飞雁，随君到桂林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"欧桢伯馆夜别梁彦国还卢龙","author":"黎民表","text":"东阁多奇士，诸侯有辟书。\n岂知残岁别，仍卧茂陵居。\n绝塞烧荒后，孤城雨雪馀。\n飘零今夜酒，难与故人疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阅军池河度清流关","author":"黎民表","text":"赤符曾破敌，紫气复临关。\n千古兴亡地，中原指顾间。\n浮云随马策，落日照刀环。\n远愧轻裘者，铭功上岘山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同盛仲交宿黄崖岭","author":"黎民表","text":"荒村无雨盖，枕藉向田庐。\n汲水初蒸黍，燃肪可照书。\n山云遮户密，松韵过窗虚。\n寄谢牛衣客，劳劳且驻车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闽警","author":"黎民表","text":"干戈愁越骆，闽海更堪怜。\n篁竹频依险，鲸鲵共戴天。\n未收熊耳甲，莫费水衡钱。\n痛哭谋臣疏，珠厓肯弃捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得仲弟西越书云有挂冠之兴予亦请告期暮春可聚故园赋此订约 其一","author":"黎民表","text":"北阙无媒者，南音只自操。\n向人肝胆露，为吏爱憎劳。\n药饵丹砂少，山林白雾高。\n故园茆屋在，相见接春醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得仲弟西越书云有挂冠之兴予亦请告期暮春可聚故园赋此订约 其二","author":"黎民表","text":"铜符如可解，皂帽肯归迟。\n迂拙人皆笑，功名我自疑。\n花应团北户，鸟亦恋南枝。\n何必山阴守，将归发誓辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻吴明卿上计以禁例不得相晤赋此寄怀","author":"黎民表","text":"流落闽中使，生涯近始闻。\n泪收江北雨，身老越南军。\n积思生春草，新愁隔暮云。\n倘携延水剑，犹可报明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"坠马卧疾遣闷","author":"黎民表","text":"寒冰方内手，蹇劣亦长驱。\n岂意千金堰，翻成九折途。\n过门劳客问，策杖待人扶。\n试探囊中俸，东邻酒肯沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明卿自闽至晤于吴约卿官舍","author":"黎民表","text":"一自游梁后，相逢又郭门。\n酒因多病废，诗许故人论。\n霜雪驱单骑，星河望九阍。\n莫谈江海事，羁客恐销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾子玉比部召饮同桢伯集","author":"黎民表","text":"岁晏驱羸马，过逢亦少期。\n偶从官阁里，共和法曹诗。\n扫叶当风牖，衔杯摘露枝。\n琳琅欣触目，留醉愿归迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姚元白自金陵至遇于慈仁寺方丈","author":"黎民表","text":"共怜千里约，还向五陵逢。\n行径寻黄叶，栖禅问雪峰。\n诗篇新满纸，旅思夜闻钟。\n君看双班鬓，知余万事慵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同苏子川欧桢伯访吴化卿姚元白于慈仁寺","author":"黎民表","text":"二仕逃禅处，人谁访薜萝。\n穿林惊雪重，梯阁见山多。\n候骑花间并，栖禽竹下过。\n云房未寥寂，红烛对清歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姚元白考绩还金陵","author":"黎民表","text":"赐舄旋南省，归轩背北风。\n故人青琐隔，江月白门空。\n酒熟逢残腊，花开觅旧丛。\n因君忆鲈脍，携手问江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾子澄过访招桢伯同集时子澄将之塞上 其一","author":"黎民表","text":"论交千里日，不独旅情亲。\n夜烛长安酒，征衣北地尘。\n荣途吾白首，风景是残春。\n欲赠无奇策，西秦别有人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾子澄过访招桢伯同集时子澄将之塞上 其二","author":"黎民表","text":"亦知分手易，杯酒问前期。\n怨别难成赋，从军更有诗。\n孤莺将薄曙，残露尚明枝。\n回首天山夜，闻笳忆此时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孔子河逢刘德卿","author":"黎民表","text":"高士藏真处，门迎孔子河。\n青山经楚暮，凉雨到江多。\n白发生行路，清樽对放歌。\n回车千古意，今日共蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜山亭答潘少承","author":"黎民表","text":"别离欣把袂，披写共登楼。\n木叶千山雨，虫声四壁秋。\n酒缘多病止，榻为故人留。\n已似嵇康懒，那堪复远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰薰香","author":"黎民表","text":"岭外多奇树，扶疏异泽兰。\n空山徒自媚，中土不曾看。\n色夺青绫被，香宜紫箨冠。\n携来经万里，犹结故人欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元美改席于浮玉山同作","author":"黎民表","text":"青山行不尽，转入道场幽。\n孤塔云相拄，双溪水合流。\n舟移石不碍，星落影还浮。\n俯仰看今古，能无忆醉游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中留宿张幼千家 其一","author":"黎民表","text":"秉烛坐清夜，摊书共草堂。\n疏砧秋思早，微雨客衾凉。\n鸡黍成良晤，风波忽异乡。\n羁愁稍披豁，触目见琳琅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中留宿张幼千家 其二","author":"黎民表","text":"不为愁风雨，还因恋解携。\n途长思老马，梦短怯晨鸡。\n离思中年恶，音书后夜题。\n片帆何处落，邗水易东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵旅舍欧桢伯陆华甫黄定甫过访","author":"黎民表","text":"草草簇蔬盘，还追燕市欢。\n云停高阁暮，雨过大江寒。\n贫贱交情在，风尘昭语难。\n行装戒前路，谁问客衣单。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同定甫游李鸣卿园亭","author":"黎民表","text":"世事足悠悠，因君复漫游。\n行随脩径转，坐占小亭幽。\n艳蕊晴堪摘，清池夏不流。\n诗情馀白首，云卧恣丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒董子祠","author":"黎民表","text":"英风怜马上，间世睹人文。\n玄冕加繁露，青衿仰庆云。\n诗书维汉鼎，柱石奠淮濆。\n东阁多奇士，寥寥竟不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜瓦厢谒大禹庙","author":"黎民表","text":"德水千年在，谁能忘禹功。\n金堤非旧迹，铜瓦见新宫。\n野著沧凉日，林交惨淡风。\n路岐何用感，王气满关东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜过许计部官舍","author":"黎民表","text":"壮心怜岁月，浊酒话平生。\n古院疏槐影，高楼画角声。\n孤踪悬北阙，倦翮思南征。\n惟有无衣客，同君独夜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"趋顺义县 其一","author":"黎民表","text":"使者正乘轺，东行上郡遥。\n关门临井口，城堡落山腰。\n岸远沙如雪，风悲水似潮。\n客愁何处著，寒月助萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"趋顺义县 其二","author":"黎民表","text":"内园停使节，地主敞华筵。\n酾酒黄粱薄，登盘紫芡圆。\n军声飞鸟外，乡思捲芦边。\n向夕无探骑，平沙直际天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪胜寺","author":"黎民表","text":"野寺逢人少，残僧乞食迟。\n古墙花不发，丛薄鸟兼悲。\n沙聚看尘劫，天长立暝时。\n伊吾惭抚剑，剜草读唐碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峪口","author":"黎民表","text":"翠削庞峰峻，高蟠鸟道孤。\n东西分幕府，沙草满平芜。\n牧马闲千匹，当关用一夫。\n传闻汉诸将，犹议塞飞狐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过真如寺乾上人访蔡文学子耕","author":"黎民表","text":"霞踪成海客，休暇惬相寻。\n累劫空弹指，千言是说心。\n当门官树直，隐座佛灯深。\n阶雪方盈尺，何人候少林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杜比部遣惠瓶酒白鱼","author":"黎民表","text":"碧酒双丝络，银盘小白鱼。\n味全胜冷炙，情独重春蔬。\n冻瓦封霜后，晴檐曝日馀。\n赖君能好事，难并太玄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答陆山人本仁","author":"黎民表","text":"三年无一字，梦想落沧洲。\n不遂金门谒，还从庑下游。\n春生琼树馆，天远洞庭舟。\n薄劣风尘里，空惭骏马求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫荆关","author":"黎民表","text":"径转蛇盘险，云连鸟去长。\n山桃微著紫，沙柳不成黄。\n重镇临天府，神功划大荒。\n金城谁献议，老作尚书郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿关城公署","author":"黎民表","text":"深院静松筠，喧喧鸟雀群。\n窗明犹瞰雪，榻冷半侵云。\n入夜风声异，边关气色分。\n更长梦猿鹤，不解赋从军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饭银钗岭馆舍","author":"黎民表","text":"云藏千仞壁，日落数家村。\n节冷无烟火，沙乾乏水源。\n山家供麦饭，野逻具醪尊。\n稍喜临边静，垂鞭出此门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戗风岭","author":"黎民表","text":"沙泥拆雨岸，细路转堪憎。\n去马冲风色，征衣挂石棱。\n疲兵时偃卧，古堠更陵乘。\n赖有销愁地，云中岳色层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至王家庄风沙骤作","author":"黎民表","text":"知是山阴近，风威特地寒。\n惊沙鸣索索，落叶聚团团。\n铁笥腰间重，戎衣马上难。\n章台冶游子，不向塞垣看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡桑乾河","author":"黎民表","text":"古渡是桑乾，征人晓涉寒。\n鸣笳喧聚落，带剑拥材官。\n霜雪经行尽，烟花出塞残。\n春衣犹未寄，空倚月轮看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西行咏怀古? 其一 平城","author":"黎民表","text":"神龙困泥淖，燕雀反见咍。\n如何赤帝子，遇窘白登台。\n谋臣虽幸中，鱼服几殆哉。\n不见芒砀气，阴风千里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西行咏怀古? 其二 灵丘","author":"黎民表","text":"佳兵古所忌，奇智人不亲。\n武灵何倜傥，变服诧强秦。\n祸机起床笫，兴亡由一身。\n惟有邯郸道，千秋狐兔尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西行咏怀古? 其三 荆轲宅","author":"黎民表","text":"传道荆轲里，町疃皆故丘。\n陇树无西指，易水犹东流。\n贤愚等共尽，尔独报君雠。\n叔孙何首鼠，诡对乃封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悬空寺与北岳相接","author":"黎民表","text":"隐壁金绳起，依山翠殿安。\n两崖分岳色，百丈下风湍。\n云狭牵衣过，天长仰面看。\n石楼遥似画，归去濯金盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大云寺在灵丘县门对太白峰","author":"黎民表","text":"谁知沙塞里，亦自称禅栖。\n雪涨晴沙合，山欹晚堞低。\n多歧分客路，一宿憩招提。\n才有安心处，关门又听鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]