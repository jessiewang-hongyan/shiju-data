[{"title":"送君晓弟归里 其一","author":"李孙宸","text":"寂寞官斋里，春风一弟行。\n披襟谈世事，数驿计乡程。\n期尔青云起，怜予白发生。\n池塘有春草，偏益梦归情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送君晓弟归里 其二","author":"李孙宸","text":"忆共离家日，相将又一年。\n风尘伤去住，节序感推迁。\n宦况只如此，乡心益杳然。\n凭汝归山去，先营负郭田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何太史","author":"李孙宸","text":"忆别峡山后，飘蓬不自由。\n生年百已半，宦计七宜休。\n候雁遥珠浦，春风到石头。\n东山君早起，物望待相酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与侯司马陈民部游木末亭 其一","author":"李孙宸","text":"春色俄将暮，春游爱夕阴。\n雨中花似沐，烟外树如沈。\n共有怀贤恨，兼悲歧路心。\n酒阑多慷慨，吟眺一沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与侯司马陈民部游木末亭 其二","author":"李孙宸","text":"披云遥策杖，木末小亭幽。\n松柏萧森处，前贤遗庙留。\n忠魂伤十族，蘋藻肃千秋。\n瞻拜休增感，云山起暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源县作兼示李明府","author":"李孙宸","text":"桃源空有县，无复见桃花。\n长阪希耕犊，中逵闻噪鸦。\n驿惟呵候吏，水不泛胡麻。\n为问烹鲜宰，哀鸿集几家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阻舟济上与李烟客步月 其一","author":"李孙宸","text":"迢递京华路，艰难济上程。\n每逢清月夜，宁忘故山情。\n独往知何日，同舟赖友生。\n登崖聊缓步，不觉漏三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阻舟济上与李烟客步月 其二","author":"李孙宸","text":"海月生遥浦，轮高望转微。\n最怜羁旅影，尚与弟兄依。\n照树惊乌绕，横江见练飞。\n故园千里外，何处赠清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同烟客诸子游古南池和壁上杜工部韵","author":"李孙宸","text":"水活仍通洫，堤遥碍进船。\n觅凉同坐石，荫柳忽闻蝉。\n炎暑销当夏，壶觞待晚天。\n醉来还藉草，新绿正如毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋","author":"李孙宸","text":"金陵多毒热，一雨送新秋。\n夜坐凉生竹，朝登露满楼。\n近传辽海捷，稍慰至尊忧。\n禄食惭何补，应为三径谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萧瑟","author":"李孙宸","text":"萧瑟频年意，逢秋倍不堪。\n无媒通魏阙，有梦到江南。\n日报攒眉剌，时修媚客函。\n消磨少壮去，短发已毵毵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宗伯姜仲讱宫詹何龙友学博王季重廿日再过小斋夜集","author":"李孙宸","text":"雅会还堪续，何嫌鸡黍贫。\n君原忘礼数，我已领清真。\n月冷疑兼雪，宵长莫虑晨。\n时能酬此愿，应不叹缁尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日太史何龙友文学马伯起暨同丈过集 其一","author":"李孙宸","text":"燕山秋欲暮，摇落思难裁。\n共是他乡客，宁忘九日杯。\n悲秋翻恨雁，怀土懒登台。\n却忆龙山会，狂歌意转哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日太史何龙友文学马伯起暨同丈过集 其二","author":"李孙宸","text":"重阳怜令节，况值此秋晴。\n风急轻鸿翼，霜迟逗菊英。\n插萸乡国事，落帽古今情。\n聊复凭杯酒，陶然醉友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周玉绳年兄迁居道院屡疏乞身初夏过访漫赋 其一","author":"李孙宸","text":"城东道院静，聊得谢扳援。\n易退知臣意，留行哪主恩。\n飞花过初夏，伏枕足閒门。\n共有冥鸿思，风尘未敢论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周玉绳年兄迁居道院屡疏乞身初夏过访漫赋 其二","author":"李孙宸","text":"仕途原少味，所趣在弹冠。\n子计欲归去，予情已尽阑。\n行藏从所好，非誉总何干。\n独有酬知遇，涓埃亦自难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周玉绳年兄迁居道院屡疏乞身初夏过访漫赋 其三","author":"李孙宸","text":"岂难轻襆被，难契是恩深。\n玉立人嫌洁，金门疏亦沈。\n卜居非傲物，扫榻为知音。\n若论平生意，应无负此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲夏同黄玉崙先生暨何龙友韩孟郁二丈游城北园池和黄韵","author":"李孙宸","text":"北郭陂塘迥，西山石乳通。\n会怜河朔饮，人儗竹林同。\n柳雨飘新翠，荷风落晚红。\n坐忘尘组绂，犹系市朝中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游定国公园 其一","author":"李孙宸","text":"炎暑无逃处，还来问水滨。\n径疑曾到地，花认昨游人。\n树密堪移席，林深似有津。\n若容长住此，不用叹缁尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游定国公园 其二","author":"李孙宸","text":"荷花京国赏，红萼占横塘。\n莫以怜孤艳，翻令念故乡。\n碧筒聊作献，绿叶未裁裳。\n留宿非难事，归途爱月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高侍御谪官南归 其一","author":"李孙宸","text":"炎蒸三伏后，一雨欲来秋。\n但惜故人别，非关迁客愁。\n骊歌易水暮，归路岭云稠。\n到日江鱼好，谁同上酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高侍御谪官南归 其二","author":"李孙宸","text":"策蹇辞京国，人还认旧骢。\n圣朝无市虎，吾道有冥鸿。\n放谪恩原重，浮沈术始工。\n家山未相远，好待桂花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高侍御谪官南归 其三","author":"李孙宸","text":"已恨交亲少，哪堪尔复还。\n清秋焚谏草，白发待斑斓。\n臣自欢开网，君原许赐环。\n苍生同系望，莫便稳东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野泊","author":"李孙宸","text":"小泊西凉岸，相携上翠微。\n天长人独立，江阔雁孤飞。\n世路悲戎马，乡心阻钓矶。\n故园春酒熟，应亦望予归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊繁昌","author":"李孙宸","text":"晓发芜湖棹，向晚达繁昌。\n风便帆樯稳，天空海气凉。\n身閒惟问酒，睡醒或焚香。\n更听渔歌发，前川下钓航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中月夜怀韩孟郁","author":"李孙宸","text":"忆别金陵柳，相将又一旬。\n每逢吟咏处，难忘和歌人。\n雁落孤帆影，花飞夹岸春。\n此时雍署里，杯酌与谁亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠","author":"李孙宸","text":"羡尔考槃者，幽栖不问年。\n青云看世业，白雪入朱弦。\n看竹辞鸠杖，寻芝伴鹤眠。\n玉堂传诰日，谁识地行仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平原舟次逢董思白先生 其一","author":"李孙宸","text":"七年石城下，犹记别时颜。\n此日予重往，逢君应召还。\n时艰知念切，道路阅头斑。\n且惬良辰赏，扁舟共采兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平原舟次逢董思白先生 其二","author":"李孙宸","text":"舟行闻与见，不异在都时。\n何意平原道，欣瞻云汉仪。\n巢许箕山意，夔龙圣代私。\n寸心倾未得，风雨促分歧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平原舟次逢董思白先生 其三","author":"李孙宸","text":"至人不碍世，出处亦何情。\n闻道纶扉上，于今待老成。\n因之怀凤德，敢以付嘤鸣。\n自有冥鸿意，无烦猿鹤惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平原舟次逢董思白先生 其四","author":"李孙宸","text":"芳辰凑良会，哪得再寻常。\n不尽尘中话，兼多世外商。\n龙驯宁自性，鸥狎未飞翔。\n安石东山在，苍生引望长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄石斋宫允阻舟临清黄以四诗见投次和 其一","author":"李孙宸","text":"汪汪黄叔度，千顷幸相依。\n浮海谋非拙，乘风愿已微。\n烟霞盟有约，时事赋无衣。\n得似南来雁，芦汀到处归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄石斋宫允阻舟临清黄以四诗见投次和 其二","author":"李孙宸","text":"中外鸱鸮剧，谁怀之好音。\n未偿蹈海意，惭负济川心。\n我去位仍窃，君归山岂深。\n风烟闽粤近，招隐好相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄石斋宫允阻舟临清黄以四诗见投次和 其三","author":"李孙宸","text":"岂不畏行役，其如世路何。\n人情偏局面，宦籍亦风波。\n竭泽游鳞少，寒山哀雁多。\n不然终滞此，几欲问行輠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄石斋宫允阻舟临清黄以四诗见投次和 其四","author":"李孙宸","text":"轮囷万乘器，为有先容根。\n任笑徒工瑟，何曾解扫门。\n敢言三礼重，还自一邱尊。\n幔亭春色好，暂去坐絪缊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为王非熊宗伯题天漱亭","author":"李孙宸","text":"小亭天结搆，清迥绝尘氛。\n有酒时邀月，无人独卧云。\n空泉潴作沼，飞翠自成纹。\n颇怪端居懒，何心学离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟眠夜起","author":"李孙宸","text":"绳床能几许，半被月侵眠。\n近暑仍惊露，当林或听蝉。\n更长归梦乱，客久得愁偏。\n取醉还欹枕，晨钟又到船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中对酒","author":"李孙宸","text":"舟閒惟对酒，颇快是临流。\n水涩风虚顺，崖高日易收。\n客盘虾菜美，乡思雁声愁。\n更道粮艘急，前途恐滞留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济上阻舟","author":"李孙宸","text":"维舟济水次，对酒强微吟。\n道路浮生梦，乡园游子心。\n未能谢羁束，聊自任浮沉。\n应愧南来雁，冥冥孰可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春 其一","author":"李孙宸","text":"入春才几日，花草竞抽芳。\n对酒风生座，钩帘月满堂。\n无书托鸿雁，有梦到江乡。\n吏况原兼隐，何妨昼卧长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春 其二","author":"李孙宸","text":"羁思无穷已，风光且绿尊。\n雪馀天悔虐，春至鸟多言。\n宦以拙增傲，吾兼懒避喧。\n礼曹公牍简，吏散任关门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春 其三","author":"李孙宸","text":"春色开年浅，登台百感生。\n条风初实柳，淑气欲催莺。\n琴剑看无赖，莬裘计未成。\n无人共杯酒，小酌亦多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢原甫与陈孺登过集 其一","author":"李孙宸","text":"客怀长落落，经月罢登台。\n忽有高人至，柴荆雨亦开。\n青馀霜后竹，春在水边梅。\n鹦鹉论词赋，应知属楚才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢原甫与陈孺登过集 其二","author":"李孙宸","text":"经旬不见月，乍喜吐如钩。\n不尽酬幽思，因之更上楼。\n懒云当槛住，小雨剧谈收。\n随意恣欢赏，过从亦胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李临淮招游清凉台 其一","author":"李孙宸","text":"障空微架椽，眺远洞开窗。\n一纵孤亭望，居肽万境降。\n山花晴朵朵，江舶暮双双。\n暂觅閒身得，何妨倒玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李临淮招游清凉台 其二","author":"李孙宸","text":"入户见空翠，登登不了青。\n兴趣怜吾党，来游复此亭。\n归骖促暮酒，醉眼乱春星。\n流连海棠下，未忍别山庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王遂东民部同刘田二兄初夏过集","author":"李孙宸","text":"夏浅仍无暑，昼长乐事全。\n论诗过水部，联骑复高贤。\n柏古肤留韵，荷新叶已偏。\n可堪初月上，不为少流连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢原浦还家寿母","author":"李孙宸","text":"还家非倦羽，所念在慈闱。\n莱綵一以舞，秋云无复飞。\n即看庭玉秀，总媚树萱晖。\n介母能偕隐，青山计未非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李筼谷以南大廷尉晋少司空 其一","author":"李孙宸","text":"亦同京雒地，差快少缁尘。\n以我宦情薄，多君友道真。\n眷知偏内简，官未积前薪。\n政今将在子，谁当社稷臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李筼谷以南大廷尉晋少司空 其二","author":"李孙宸","text":"脉脉秦淮道，无言送尔行。\n艰危四海阔，去住一身轻。\n衮以近需补，官因远易称。\n悟来萍梗迹，不作别离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦偶成","author":"李孙宸","text":"白门重改岁，爱此晓光鲜。\n阁对钟山霭，窗临淮水烟。\n贺年仪节简，酌柏性情全。\n披拂春枝动，东风莫讶颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王季重董得庵携酒夜过","author":"李孙宸","text":"载酒忘宾主，因谐投辖缘。\n客谈高夜色，宦况似冬天。\n会喜何勘旧，歌听渭雨传。\n坐深有七发，药裹遂堪捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送唐□□操江 其一","author":"李孙宸","text":"亦缘来白下，始得此良朋。\n未谢为官累，先倾出世情。\n投閒吾尚阻，请乞尔非轻。\n顿觉相关切，羞他丛桂盟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送唐□□操江 其二","author":"李孙宸","text":"进贤冠未脱，话去几无疑。\n似此离尘意，差堪静者知。\n畏人难速避，见事已惭迟。\n计日分吴越，青山共紫芝。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送唐□□操江 其三","author":"李孙宸","text":"任说官无累，何如解去时。\n随缘事莫试，独往兴何疑。\n罗浮已驰檄，云水岂无期。\n各自寻生活，难容念别离。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"睡佛寺","author":"李孙宸","text":"娑罗佛前树，闻已阅齐梁。\n为问千灯接，何如一睡长。\n坛虚无讲席，殿老不焚香。\n兴废休关感，吾生总梦场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"香山寺","author":"李孙宸","text":"山色青无尽，都来入此轩。\n观空天变幻，窥磴石飞翻。\n客爱跻登险，僧忘应对烦。\n绳床容小憩，清绝梦中魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黎缜之","author":"李孙宸","text":"物外怜君万虑宽，才名三十旧登坛。\n山中采药萝为服，竹里题诗箨作冠。\n岂为漂零身转傲，向来肮脏路逾难。\n朱弦且莫誇高调，任是沾裳未可弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎缜之赵丕显丕振欧子建过馆赏紫菊 其一","author":"李孙宸","text":"雪月初移野径芳，还留秋色媚山堂。\n丹心晚带晴霞艳，密藿朝含宿雾香。\n违世共顷陶令酒，餐英宁学楚臣狂。\n江梅尚隔花时远，幽赏那能不尽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎缜之赵丕显丕振欧子建过馆赏紫菊 其二","author":"李孙宸","text":"年华惟汝殿芳菲，岂有怜芳赏更违。\n病客独留荒径在，故人须醉白衣归。\n即看晕日香逾暖，况是淩霜叶未稀。\n一掇寒英心自远，肯辞潦倒负秋晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山寺同诸子送别张明府","author":"李孙宸","text":"旧识灵洲海上山，金银楼阁出人间。\n空中似听吹笙过，定里如闻振锡还。\n方丈香分荀令袖，九还丹驻葛洪颜。\n凭君取醉东林酒，明发双凫未可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日酌赵氏园亭","author":"李孙宸","text":"一笑风波各路岐，重来未改习家池。\n尊开白社同盟地，话到青灯半夜时。\n露濯芰荷香泛泛，月临杨柳影垂垂。\n与君且恣邱中赏，莫向云霄念别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芒鞋","author":"李孙宸","text":"世上驱驰祇自纷，芒鞋有路出尘氛。\n春晴踏遍千郊翠，秋好穿残五岳云。\n幽意只同藜杖得，閒踪时趁鹿麋群。\n侯门珠履三千客，野外谁堪半席分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹦鹉为方伯情赋","author":"李孙宸","text":"鹦鹉西来自垄坁，西山霜霰若为姿。\n尊前最忆祢衡赋，洲畔空传李白诗。\n学语共怜多慧质，垂头如亦解愁思。\n雪衣旧羡莲花舌，明月珠宫何处期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲秋日同黎缜之邓伯乔访欧子建饮贻安堂其诸从同集","author":"李孙宸","text":"银烛江乡此夜清，更阑洗酌喜初晴。\n交论意气无新故，语洽清狂见弟兄。\n正倚纵横诗兴发，莫因萧瑟壮心惊。\n月华况近中秋色，肯负平原十日情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸子过欧虞部蘧园水阁","author":"李孙宸","text":"欲向孤亭问草玄，菟裘犹在赤花边。\n空林半入山樵道，曲径平分野犊眠。\n槛外潮声翻夕照，篱前秋色散荒烟。\n风流顿觉前修尽，徙倚楼头思悄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"到锦溪仅得欧经季丈人一晤别后赋寄","author":"李孙宸","text":"十年曾忆紫芝眉，雪夜山阴棹故移。\n麈尾乍聆杯底语，虎头犹想画中诗。\n花洲露冷江如练，龙社秋深柳尚丝。\n翻笑逢君如梦寐，祇赢今日寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]