[{"title":"会乐图为宗弟永寿王题","author":"朱诚泳","text":"四海承平庶事康，百年雅会重藩方。\n琴樽适兴排鸳序，礼乐禔身肃雁行。\n更喜阿咸从阮籍，且无成义狎宁王。\n天伦至乐时时有，不似兰亭一咏觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送暹上人还京","author":"朱诚泳","text":"萍水相逢岁未周，又看飞锡上神州。\n梁恢针验心多感，龙树机深计莫留。\n雁度碧云函谷晓，蝉鸣红树曲江秋。\n临岐且莫伤怀抱，更约春风此地游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和马天禄宪副陇州简阎光甫大参","author":"朱诚泳","text":"悠悠汧水带云流，白草黄沙接远洲。\n风断归鸿迷别渚，霜寒落木动高秋。\n番营人散城边马，野渡僧归月下舟。\n独有高閒当此际，每将心迹寄菟裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和次阎大参韵","author":"朱诚泳","text":"报国曾将素志酬，乞归还爱草堂幽。\n夕阳帘捲吴山碧，野渡舟横陇水流。\n诗酒放怀三径地，乡园飞梦五云楼。\n身閒况是心无累，半百年来未白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和华亭道中雨晴","author":"朱诚泳","text":"五花骢马鞚青丝，宪使高秋按节时。\n贪吏望风争解印，远人归化纳降旗。\n草间泣露蛩声切，尘外摩空鸟力疲。\n景物满前骚兴在，不妨头上雨催诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51623,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和晚渡咸阳","author":"朱诚泳","text":"长堤漠漠绕晴川，芳草离离接远天。\n几处夕阳林外鸟，半篙秋水渡头船。\n青山伯业成馀烬，紫蔓残碑纪昔年。\n薄暮行人呼愈急，短衫黄帽立沙边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51624,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿汧阳伯父","author":"朱诚泳","text":"玳瑁筵开簇绮罗，碧桃花发去年柯。\n东平乐善贤名著，南极呈祥瑞彩多。\n翠袂舞风鸾影细，紫箫吹月凤声和。\n霞杯满进长生酒，醉看桑田起白波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51625,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈公辅伴读省亲入蜀时其弟进士亦归省","author":"朱诚泳","text":"一别慈闱几岁寒，宦游何处问平安。\n太行睥睨云飞远，栈阁崔嵬马度难。\n庭下称觞尧叟至，门前衣绣季方欢。\n人间家庆如君少，堂北春深雨露宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51626,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送童世奇黄门回京","author":"朱诚泳","text":"近臣承诏下銮坡，跋涉其如远道何。\n鱼目混珠须辩早，角弓入酒莫疑多。\n人情翻覆真堪笑，水鉴妍媸定不讹。\n行色一鞭催去马，华山回首郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51627,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送唐虞卿郎中回京","author":"朱诚泳","text":"遥持玉节下秦中，万里流云素鉴空。\n曲直肯挠三尺法，咨询都付一心公。\n行旌渺渺瞻燕北，驿骑萧萧过陕东。\n囊里封章多少事，更期民隐达宸衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51628,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和咏雪","author":"朱诚泳","text":"六花飞舞乱西东，一白茫茫路不通。\n闭户高眠穷巷客，维舟独钓破蓑翁。\n川原缭绕疑琼岛，草树高低见玉丛。\n最喜丰年先有兆，来麰生意已无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51629,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送锦衣杨千兵回京","author":"朱诚泳","text":"一片清冰置玉壶，家传韬略更兼儒。\n鼠牙雀角原情伪，重裤疑金定有无。\n堤柳煖风飞乳燕，河桥春水泛轻凫。\n香尘十里长安道，笑拂吴钩上帝都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51630,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨化州清节卷","author":"朱诚泳","text":"佐政三州蔼颂声，茧丝保障极经营。\n跳梁小丑空为乱，安堵居民总不惊。\n囊里肯携包拯砚，胸中元有仲淹兵。\n关西家世传来久，清白端能裕后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51631,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次杨应宁佥宪留别京师词林诸友韵 其一","author":"朱诚泳","text":"三年读礼辍慈闱，还逐鹓鸾旧伴飞。\n双阙制颁纶綍命，五陵士望斗山归。\n青云接武天应近，绛帐传经愿不违。\n留取从行清献鹤，他年堪绣上罗衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51632,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次杨应宁佥宪留别京师词林诸友韵 其二","author":"朱诚泳","text":"玺书荣捧别词林，祖帐临岐思不任。\n原委早承明道派，之无幼契乐天心。\n官居执法飞霜远，人喜从游立雪深。\n密勿庙廊应有待，壮年谁许脱朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51633,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宣庙太乙真人莲叶舟画为永寿王题","author":"朱诚泳","text":"水上飘飘一叶莲，真人宴坐稳于船。\n撑归泰华峰头月，梦入西湖镜里天。\n冲浪不惊红雨乱，忘机常对白鸥眠。\n鼎湖龙去仙踪远，遗泽空存御笔鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51634,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送高文明绣衣事竣还朝","author":"朱诚泳","text":"榷茶奉制抚边夷，一道澄清属有为。\n豸角霜威秋肃肃，乌台月影夜离离。\n及瓜有待催行色，折柳无端动别思。\n关陇近来凋弊甚，封章好达圣明知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51635,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送匡敬敷绣衣事竣还朝","author":"朱诚泳","text":"戎政贤劳岁屡更，又持绣斧上神京。\n天开魏阙双龙近，云尽长空一鹗横。\n官道飞埃过雨净，驿亭残暑逐风清。\n九重若问三农事，麰麦微收谷未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51636,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题忠孝节义传为都阃王徽作","author":"朱诚泳","text":"节钺防边与弟俱，一门风化重舆图。\n孤忠报主今应少，双节从夫古亦无。\n事母孝思恩罔极，痛姑涕泪眼将枯。\n芳名美誉垂青史，留与人间作范模。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51637,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送都宪陈叔振作镇宣府","author":"朱诚泳","text":"边疆作镇众称宜，攀卧争缘父老痴。\n宪府恤刑崇德望，都台迁秩拜恩私。\n燧烽烟杳防秋远，刁斗声沈警夜迟。\n旧炼石皆成五色，珍藏还待补天维。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51638,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与强景明伴读","author":"朱诚泳","text":"清冰无滓玉无瑕，鱼水相看鬓未华。\n诗拟陶韦窥雅调，文宗韩柳擅名家。\n井天典教膺儒聘，藩邸能官更汝嘉。\n惭愧楚筵初设醴，何如贾谊在长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51639,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹窗写兴 其一","author":"朱诚泳","text":"幽轩潇洒傍宫墙，种得新筠绕画廊。\n寒色满林秋淅淅，绿阴匝地晓苍苍。\n小窗不雨书常润，矮榻无风簟亦凉。\n一点红尘无处著，分明身世在潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51640,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹窗写兴 其二","author":"朱诚泳","text":"满院琅玕绿染成，苍茫秋色弄阴晴。\n如云谩作纷纷态，带雨常为簌簌声。\n陆地何时无翠滴，炎天终日有寒生。\n我来不是閒乘兴，共结冰霜岁晚盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51641,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹窗写兴 其三","author":"朱诚泳","text":"一片湘云压画栏，凤毛零乱绿成团。\n香生箨粉晴犹堕，翠滴苔花湿未乾。\n帘影低垂秋雾薄，玉声轻弄晚风寒。\n傍人莫讶耽幽兴，尽日微吟独倚阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51642,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹窗写兴 其四","author":"朱诚泳","text":"轩居幽僻断尘纷，不种秾华种此君。\n晴翠拂檐秋瑟瑟，绿阴垂地画氲氲。\n满庭碎玉人空扫，半亩清风鹤共分。\n读罢武公淇澳句，不知帘外已斜曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51643,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪上晚景","author":"朱诚泳","text":"隔岸山光翠欲流，暂停骢马一遨游。\n断云阁雨天将暝，老叶惊风树已秋。\n争果野猿时聚散，傍船水鸟自沈浮。\n垂鞭缓策归来后，诗兴无边咏未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51644,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和韵寄日华上人 其一","author":"朱诚泳","text":"几年不见佛图澄，龙象天高未许登。\n西土重来思有道，亲藩分守愧无能。\n曾闻心印传诸祖，更喜诗坛续九僧。\n料得山居无个事，蒲团终日课莲经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51645,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和韵寄日华上人 其二","author":"朱诚泳","text":"当年曾会景隆池，千里难禁别后思。\n古寺春深花落后，小轩人静月明时。\n寒山笑谑都成偈，无本推敲酷爱诗。\n何日重来寻旧约，相逢一笑话襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51646,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李公堤为岳州守李文明作","author":"朱诚泳","text":"洞庭湖水古今同，岳牧全收捍禦功。\n耕艺有田成岁稔，往来无客叹途穷。\n沿堤新柳摇金缕，傍岸长桥卧彩虹。\n昭代拟脩循吏传，声华先已属观风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51647,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李文明宪使之任河南","author":"朱诚泳","text":"东陵作镇先诸郡，西岳旬宣重一方。\n到处苍生沾雨露，平生清节凛冰霜。\n宪台赫赫官阶峻，使节摇摇驿路长。\n不道梁园还久住，居然听履上岩廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51648,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送少司马王表伦赴京 其一","author":"朱诚泳","text":"简书分陕羡贤劳，几见巡边树节旄。\n战马不嘶饶苜蓿，耕农无事醉蒲萄。\n三春雨露滋三辅，六籍经纶济六韬。\n八座登庸还有待，好将忠赤荅恩褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51649,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送少司马王表伦赴京 其二","author":"朱诚泳","text":"遥持玉节镇长安，百辟严趋仰豸冠。\n私谒不通霜满面，秋毫无犯铁为肝。\n一封丹诏来春殿，三品清衔贰夏官。\n幸际升平戎事少，委蛇日日侍金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51650,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张应祥绣衣按治四川还朝","author":"朱诚泳","text":"绣衣骢马上金台，好是西川按辔回。\n甘雨一天随使节，清风千里断氛埃。\n故园情思迷松菊，先陇恩光贲草莱。\n五色云开双阙近，朝阳争看凤飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51651,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送夏官杨知微司厅事竣还朝","author":"朱诚泳","text":"三孤世阀挺人豪，赞理兵曹地位高。\n霄汉飞腾真不忝，关山跋涉肯辞劳。\n长安秋色随青盖，华岳晴光绚锦袍。\n此去天颜应咫尺，定知乔擢荷恩褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51652,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谈时英佥宪升任江西宪副","author":"朱诚泳","text":"双旌高捲北风凉，南望洪都去路长。\n洞獠定归今日化，野梅应发去年芳。\n谩誇搏击同鹰隼，共喜翱翔有凤凰。\n楚水吴山成远别，作诗聊为缓离觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51653,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒中","author":"朱诚泳","text":"閒中常是笑人忙，始觉闲中趣味长。\n天上浮云多变幻，人间流俗自炎凉。\n推窗对客敲棋局，倚榻呼童检药方。\n茶灶笔床书满架，不妨吟啸到斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51654,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夕","author":"朱诚泳","text":"嘘煖东风晚更微，瑶天皓月正光辉。\n华灯万盏楼头下，火树千枝望里飞。\n宴集衣冠开玳瑁，诗成咳唾落珠玑。\n迢迢良夜春如海，不醉樽前肯放归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51655,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送丘仲玉大参之任山西","author":"朱诚泳","text":"若翁三晋赖旬宣，鹏路追踪有后贤。\n藩省甘棠谁忍伐，琐闱旧草世争传。\n蒲关夜月鸡声早，汾水秋风雁影联。\n自是才高留不到，岩廊千仞看飞鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51656,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送仰晋卿宪长入觐","author":"朱诚泳","text":"駊騀花骢觐紫宸，棱棱风采动朝绅。\n霜飞豸角三秋肃，喜入龙颜万国春。\n执法无私推骨鲠，筹边有策待经纶。\n笼街喝道长安市，元是西台第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51657,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送严宗哲太守入觐","author":"朱诚泳","text":"五马骄嘶不受鞭，文章太守远朝天。\n苍头秪许携孤鹤，父老何曾献一钱。\n岂弟从来心宅好，廉能多见口碑传。\n朝廷公道明于日，此去褒旌定九迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51658,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日即事","author":"朱诚泳","text":"银床冰簟暑风清，宴坐频挥玉麈轻。\n好鸟向人如欲语，新花照眼更多情。\n一拳怪石当窗小，几派流泉到沼平。\n最喜平安轩外竹，萧萧先已送秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51659,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜","author":"朱诚泳","text":"火云才见敛奇峰，隐隐前溪递晚钟。\n碎玉铿锵风动竹，零金散乱月穿松。\n荷盘烛影明还灭，鹊尾沈烟淡复浓。\n吟倚朱栏清不寐，可堪宫漏促铜龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51660,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"处善楼为永寿王东轩题","author":"朱诚泳","text":"百尺危楼喜落成，九重赐额一时荣。\n圣经浩浩乾坤大，祖训谆谆日月明。\n莫向绮罗丛里醉，直须韦布境中行。\n传来天语南山重，好学间平享令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51661,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兴庆池","author":"朱诚泳","text":"绿波流尽草离离，画舫笙歌载昔时。\n海变桑田龙去远，云迷华表鹤归迟。\n歌台落寞俱陈迹，小殿荒凉有断碑。\n最恨沿堤杨柳树，临风依旧舞腰肢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51662,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与华阴孙令","author":"朱诚泳","text":"早沐恩除下九重，年来声誉满雷封。\n单车出郭多迎客，羸马随鞭每课农。\n雉哺桑田春盎盎，鸡呜蚕市月溶溶。\n民安物阜应多暇，上到莲花第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51663,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"曲江春游","author":"朱诚泳","text":"泼眼春光泛晓晴，閒行随处惬幽情。\n桃花笑客乘时发，芳草留人特地生。\n鸟外云移山欲动，树头泉落水如倾。\n晚风馀兴归仍在，忽讶新诗马上成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51664,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"理发美人","author":"朱诚泳","text":"金盆沐罢水沈香，谩解双鬟趁晚凉。\n蝉翼轻盈笼薄雾，鸦翎闪烁出残汤。\n凝脂翠缕风前滑，窣地青丝镜里长。\n恼杀多情惊一见，似曾行雨下巫阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51665,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"步月美人","author":"朱诚泳","text":"远思惊秋梦不成，玉关何处玉轮横。\n风光暗与当年异，弱质难禁此夜清。\n柳影花阴聊曳步，人间天上谩多情。\n凭谁亲向嫦娥道，莫为孤眠损旧盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51666,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点唇美人","author":"朱诚泳","text":"笑取红绵拭镜光，香台珍重晓来妆。\n瓠犀微露朱樱破，猩血轻调玉笋忙。\n樊素年来添妩媚，乐天老去更疏狂。\n金笼鹦鹉惊相见，却怪风前笑语香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51667,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"折花美人","author":"朱诚泳","text":"粉香罢染镜中丹，百转千回绕画阑。\n夜合有香迎日暖，宜男无语怕春寒。\n深红在手颜初破，浅白沾衣露未乾。\n浪蝶狂蜂莫相妒，妆成要使阿奴看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51668,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈德脩都宪之河南","author":"朱诚泳","text":"青云黄甲早飞腾，历历贤劳独有称。\n才领除书迁左牧，又看徵诏进中丞。\n后生久已归山斗，元首从来藉股肱。\n记取长安今日别，上元时节正张灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51669,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桃接梅","author":"朱诚泳","text":"何事玄都解出神，孤山换骨绝纤尘。\n刘郎此日非前度，姑射于今是后身。\n自许坚贞盟晚节，耻将颜色媚秾春。\n从今结就调羹实，不记瑶池有故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51670,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送惠安伯奉使还朝","author":"朱诚泳","text":"圣明天子重亲亲，衮冕临轩遣大臣。\n亲捧金书辞北阙，远持玉节下西秦。\n波分雨露天潢近，庆衍宗支帝命申。\n归去重瞳应咫尺，为言万物总回春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51671,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑德新方伯致仕","author":"朱诚泳","text":"霄汉勋名喜致身，薇垣望重自西秦。\n心应许国终怀赤，鬓为忧民早博银。\n公道定知归太史，清朝无愧作閒人。\n从今勘破黄粱梦，习静虚堂养谷神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51672,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"韩愚夫黄门具庆诗","author":"朱诚泳","text":"忠献云仍衍庆长，一门遭际此非常。\n两儿价重连城璧，二老眉齐具庆堂。\n乌府黄门同宠渥，锦袍珠翟共康强。\n亦知积德君家事，寿域天开自圣皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51673,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李叔渊绣衣还朝 其一","author":"朱诚泳","text":"青春豸绣几人如，玉斧从容引鹭车。\n买铁十年曾铸剑，典衣无日不收书。\n似闻彫瘵劳存问，那复豺狼待扫除。\n去近九重应简在，西行声价重璠玙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51674,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李叔渊绣衣还朝 其二","author":"朱诚泳","text":"旧持宪节过西秦，衔命重来是故人。\n八郡风霜千里远，三场条格一时新。\n杜陵骨瘦多忧国，范相心劳总为民。\n料得巡边应有待，藩邦争识玉麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51675,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送戈勉学太守之廉州","author":"朱诚泳","text":"天家有诏起龚黄，暂抚东夷近海乡。\n夹道旗亭榕叶暗，绕城村落荔枝香。\n扶桑日上春无瘴，合浦珠还夜有光。\n壮志不须嗟远别，男儿出处付穹苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太行家庆为李叔渊侍御题","author":"朱诚泳","text":"车马骈阗鼓笛哗，德星今聚李膺家。\n三千钟乳和玄露，百万蒲萄荐紫霞。\n金舄喜承新宠渥，青毡还是旧生涯。\n贤郎便道称觞处，天上蟠桃正著花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灞陵别意送夏廷赞行人还高邮","author":"朱诚泳","text":"官河夹岸柳依依，有客西来衣锦归。\n诗思喜随花竞发，离心应比絮先飞。\n马头岳色春云淡，树底河声夜雨微。\n此去宁亲兼入觐，清时忠孝独无违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日即事","author":"朱诚泳","text":"帘捲东风淑景移，朱楼翠阁日迟迟。\n柳烟分绿侵书幌，花雨飞香入砚池。\n物外功名浑似梦，眼前风物总宜诗。\n人生对景须张主，莫待秋霜染鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春宫词","author":"朱诚泳","text":"昼漏迟迟淑景长，此中别是一风光。\n彩云画栋来天女，丽日文窗语雪娘。\n怪石当阶飞翠湿，小桥临水落花香。\n龙笙凤管开筵处，只把关雎备乐章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送汪文灿大参升任广东宪长","author":"朱诚泳","text":"薇垣督饷未三年，持宪遐方简任专。\n霜落梅天消瘴雨，风清驿路扫蛮烟。\n讼庭坐久榕阴合，宾席开时荔子鲜。\n见说外台风纪重，豸冠还上五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]