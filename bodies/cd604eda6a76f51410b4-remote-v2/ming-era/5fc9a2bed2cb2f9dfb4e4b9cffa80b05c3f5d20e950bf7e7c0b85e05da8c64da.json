[{"title":"元夕开府杨公自范阳过访，赋事以谢 其三 登阴山","author":"戚继光","text":"凌虚小队散春风，长啸遥看大漠空。\n隐约蓬莱沧海畔，氤氲宫殿紫云中。\n睛沙鸣镝初回骑，石磴移尊已度钟。\n万灶暮烟低汉戍，归来豪气挟长虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕开府杨公自范阳过访，赋事以谢 其四 观新庙","author":"戚继光","text":"殿俯榆关迎六纛，旌移兰省阅初禖。\n云间山色槯甍起，天外河流鼓角回。\n骐骥中朝殊盛矣，貔貅乘塞亦雄哉！\n他时呼酒祁连上，潦倒清秋三百杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"缃桃戏题","author":"戚继光","text":"缃桃千叶正宜春，万里风尘叹此身。\n移向平章亭子畔，徘徊应忆武陵人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬申春余月下浣夜梦","author":"戚继光","text":"使君少负九州名，开府天津近帝城。\n六博似知忧国意，一轮红日掌中擎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春方山人邀游山庄","author":"戚继光","text":"寻芳长啸到林丘，谢眺庄前控紫骝。\n白雪满枝临月坞，绛霞绕树抱春流。\n石床未醒寰中梦，羽服谁同物外游。\n醉挹韶光问花事，从来不解破边愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日浮麓山人方君邀同诸客游山庄","author":"戚继光","text":"何处开新亩，凭谁识旧游？\n杏林金作坞，瀑布玉为楼。\n客尽江南盛，身仍塞北留。\n钟声林外急，倏起戍城愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日邀友人同登三屯之阴山","author":"戚继光","text":"秋入千山静，东来紫气多。\n德星高可摘，碣石醉堪磨。\n九塞劳车马，孤辰傍薜萝。\n偶闻击柝者，回首愧烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王山人南还","author":"戚继光","text":"天风万里过仙槎，滦水光摇彩笔花。\n慷慨已知凌大漠，艰虞何用问悲笳。\n乍看白发乾坤短，忍听骊驹道路赊！\n秋雁图南江国近，边臣愁绝久无家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶山人归恒安 其一","author":"戚继光","text":"仗剑来辽西，徘徊望恒安。\n古塞下秋色，清霜侵鹖冠。\n长揖谢比邻，几屦向岩岵。\n时从倦鸟栖，亦与浮云伍。\n俗情既难协，衡宁堪留连。\n中心识者稀，恍惚羲皇前。\n惜此辕下驹，徒羡青冥翼。\n汗血岂足怜，皮骨易抛掷。\n论交繄早岁，自首乃所期。\n歧路一何广，雅志遂参差。\n剑合古有言，分金亦吾党。\n握手且踟蹰，迢迢叹孤往。\n任侠应多愧，还丹好自求。\n不知他日泪，谁为故人流？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶山人归恒安 其二","author":"戚继光","text":"浮世蹉跎易白头，毋令旧约负沙鸥。\n蚤知裘剑归山好，不傍风尘作远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和徐使君秋日建昌闻警，得“戎”字","author":"戚继光","text":"飞羽辽河上，移军滦水东。\n前驱皆大将，列阵尽元戎。\n夜出榆关计，朝看朔漠空。\n但期常献馘，不敢望彤弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送文学郭建初归闽","author":"戚继光","text":"夕阳惨澹众芳歇，木叶脱尽群山高。\n一尊万里坐超忽，浮生如此亦已劳。\n君来暑深去秋杪，意气自谓凌风涛。\n醉挥彩笔时侧目，况复过从鞬与櫜。\n青袍凋敝犹未售，古今扼腕多英髦。\n幕中校艺万夫敌，衔杯出塞谁称豪！\n问天天欲何为者，高阳大名遽相假！\n逸态常留山简前，壮心不在少卿下。\n朔风归渡延平津，何日风尘手重把？\n君王更起黄金台，会见东南至天马。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙舟洞送郭建初","author":"戚继光","text":"把酒仙舟个怆神，钓鳌君去大江滨。\n白云红叶看无际，何处千峰是七闽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄医官南还","author":"戚继光","text":"少年结侠如君少，况复神楼旧业奇。\n松菊满庭归正好，春鸿回首慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬申除夕偶成","author":"戚继光","text":"绝塞无烽紫气浮，一时轩盖愧同游。\n使星天地看仍聚，子夜招寻醉未休。\n腊尽忽惊双鬓改，北来已是六年留。\n丹心不假残杯力，醉倚空庭拂剑缑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春郊行","author":"戚继光","text":"十日一出郊容改，东风夜发山花红。\n纷纷桃李何为者，不可思忆天之工。\n轮转荣枯何日了，年年青入长城草。\n嗟嗟人生物不如，一度经年一度老。\n朔方健儿期报恩，憔颜短发披荆榛。\n成蹊桃李自何处，那知芳草忆王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞外观音岩","author":"戚继光","text":"朔庭喜见战尘收，石洞疑从大士游。\n不道受降唐壁垒，何如奉使汉风流。\n天低台观三千里，雪近颠毛四十秋。\n短剑萧森心尚壮，君恩回首几时酬？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉陪少司马汪公等同登山海关之观海亭","author":"戚继光","text":"曾经泽国鲸鲵息，更倚边城氛祲消。\n春入汉关三月雨，风推秦岛五更潮。\n但从使者传封事，莫向将军问赐貂。\n故里沧茫看不极，松楸何处梦魂遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山海关城楼","author":"戚继光","text":"楼前风物隔辽西，日暮凭栏望欲迷。\n禹贡万年归紫极，秦城千里静雕题。\n蓬瀛只在沧波外，宫殿遥瞻北斗齐。\n为问青牛能复度，愿从仙吏授刀圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侯民部守思恩","author":"戚继光","text":"杨柳春深易水濆，十年交谊两离群。\n中朝经术还酬主，西粤江山待使君。\n士马渐强边计在，幨帷初启郡符分。\n政成莫问长安远，回首天涯见五云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日邀游赋别，兼呈诗社诸君子","author":"戚继光","text":"天际浮云久不开，他乡禾黍重徘徊。\n报君尚愧求龙种，草檄应多倚马才。\n南国传家惟二谢，东牟旧德有三槐。\n寄言莲社当坛者，乘醉长登万里台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游夹山寺","author":"戚继光","text":"塞门从古杂烟尘，丹鹫谁移佛土新？\n属国已归东夏日，荒碑犹识上元春。\n穿亭一水留僧供，夹寺三峰护法轮。\n中有双钩看欲起，光芒夜夜动星辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"练武太平，登南庙望北山古刹，感怀赋此","author":"戚继光","text":"忆昔从戎向北陲，重来持节鬓成丝。\n夜悬炎海烽烟梦，时听严关杕杜诗。\n古戍寒云过铁马，中原睛日闪牙旗。\n安危赖有诸君在，酹酒还期下月支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈将军留守承天","author":"戚继光","text":"天为闽越息风尘，借箸奇能动鬼神。\n二十年来劳汗马，五千里外过征轮。\n义高田孟翻多议，家似韩原未是贫。\n忽听离歌秋色里，当杯不觉倍酸辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤泉大阅","author":"戚继光","text":"使者临关日拥旄，天威只尺壮神皋。\n指挥乍结车骑阵，战守还凭虎豹韬。\n万阁凌霄金作垒，五兵飞雪玉为刀。\n年来愧博君王宠，幸有边尘识二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐使君参知山东政事二首 其一","author":"戚继光","text":"监兵六郡节旄新，元是褰帷第一人。\n患难相将兰作佩，生平独立玉为身。\n曾消汉士沙中语，更却胡儿碛外尘。\n桑梓何因私帝泽，岁星今已在东秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐使君参知山东政事二首 其二","author":"戚继光","text":"储胥百万识奇才，东向扶桑岳色开。\n潞水片帆看复合，丰城神剑去还来。\n离歌忽起山头月，酾酒能忘塞上台？\n君下三齐知忆我，朔风吹雁到蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和司马刘公、中丞杨公过温泉有作 其一","author":"戚继光","text":"武帝恩波在眼中，龙飞气色尚茏葱。\n清时不减为霖意，沧海遥分浴日功。\n碧水浮觞摇夜月，玉虬拖练动秋风。\n天私三辅余膏沐，一脉汤汤万古同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和司马刘公、中丞杨公过温泉有作 其二","author":"戚继光","text":"几度临池愧病身，纶巾犹自滞风尘。\n三秋经略秦封壮，千载澄清汉泽新。\n祗树晴光分障塞，中天爽气动星辰。\n左贤已属穹庐部，愿理沧溟旧钓缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸公秋日过访滦上即席奉呈","author":"戚继光","text":"结驷何期蓟北城，德星忽傍碛沙明。\n谈锋独感匡扶志，禄食同衔顾遇情。\n三辅桑麻连朔野，万方玉帛拥神京。\n秋回战气为山色，醉倚崆峒看洗兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹将军擢领南兵还越","author":"戚继光","text":"投笔当年勒汉勋，驱驰南北独怜君。\n天遥海上金汤在，地壮渔阳版锸分。\n蚤识名家还越郡，今看精骑属将军。\n关楼秋望旌旄色，佳气如含紫塞云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兵宪刘公以游喜峰、柞子洞诸作见示，赋答 其一","author":"戚继光","text":"车骑行边笔作筹，光摇五色度中流。\n斜阳有意杯仍剧，危堞无烽洞转幽。\n谁谓风沙通朔漠，共疑形胜是南州。\n关前不筑三城在，能使山灵识壮游？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兵宪刘公以游喜峰、柞子洞诸作见示，赋答 其二","author":"戚继光","text":"塞垣风色易凄凄，柞子城头乌夜啼。\n汉节蹉跎仍蓟北，文星错落复辽西。\n烽明飞阁三千迥，角起连营十万齐。\n眼底戎机君自见，逢人不必说羁栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日承召泛舟，后登峰台寺，赋此","author":"戚继光","text":"萧鼓下长河，中流发棹歌。\n野云随岸阔，秋色逐帆多。\n为惜经年别，翻怜此日过。\n凭高追往事，双鬓已成皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次马祥寺，值方山人至，共酌稼场","author":"戚继光","text":"入各有愁城，能攻仗酒兵。\n关山一片月，游子十年情。\n未遂终军志，徒为班固征。\n相逢且潦倒，天地自虚盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圣水泉","author":"戚继光","text":"王气偏三辅，山灵迟上卿。\n涌泉分左右，迭石起峥嵘。\n洛画龟犹负，河源鉴自清。\n君恩仍未报，不敢濯尘缨！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黠虏献俘得封，坚志贡市 其一","author":"戚继光","text":"狂胡初款塞，飞诏出云中。\n自古绥戎策，应难此日同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黠虏献俘得封，坚志贡市 其二","author":"戚继光","text":"王者原无外，残黎莫隐忧。\n已闻兵马诏，相继下深秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三屯新城工成志喜 其二","author":"戚继光","text":"冰霜谁识抱关情，三辅河流一洗兵。\n楼阁城悬新日月，桑麻色起旧屯营。\n龙回地轴开戎幕，水合风门远戍城。\n应是太平还有象，金汤万世奉神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万历乙亥秋九月，同诸将再登太平南山有作","author":"戚继光","text":"把酒重登塞上台，匡时君等亦雄哉！\n云连雉堞秋逾静，月照机丝夜可哀。\n何日信眉容我去，百年开口几人来？\n还为国步推豪俊，誓向祁连勒马回！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中偶成 其一","author":"戚继光","text":"燕越烽烟二十春，一朝病集未闲身。\n忽来窗外黄梅雨，又送新愁到耳频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中偶成 其二","author":"戚继光","text":"边愁隐隐上颠毛，肺病那堪转侧劳？\n惟有空庭一片月，漫移花影护征袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中偶成 其三","author":"戚继光","text":"风尘已老塞门臣，欲向君王乞此身。\n一夜零霜侵短鬓，明朝不是镜中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪梦","author":"戚继光","text":"平楚何来使者骢，为言圣主是重瞳。\n中兴礼乐当年异，上国文章振代雄。\n但说梯航归越雉，还看社稷倚周公。\n抱关小吏君休问，一任东流泛短蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙潭","author":"戚继光","text":"紫极龙飞冀北春，石潭犹自守鲛人。\n风云气薄山河迥，闾阖睛开日月新。\n三辅看天常五色，万年卜世自中宸。\n同游不少扳鳞志，独有波臣愧此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄监兵陈使君 其一","author":"戚继光","text":"闽海烽烟首重回，当年揽辔识君才。\n半生偃蹇惭同调，浮世风波敢自媒？\n秋向西山鸿雁起，月依碣石白云来。\n轺车按塞难为御，又负清宵五百杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄监兵陈使君 其二","author":"戚继光","text":"延津分剑寒，别后还从万里看。\n雁塞更将兰作佩，鹓行尚忆笔簪冠。\n声名天下无双士，保障军中有一韩。\n抵掌不须谈往事，颠毛种种识艰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄监兵陈使君 其三","author":"戚继光","text":"东向榆关离思赊，外台只尺是天涯。\n自怜燕越分前箸，谁谓歌钟阻暮笳！\n尘满三秋孺子榻，眼穿八月使君槎。\n主恩不薄行间吏，遮莫风霜袭鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙舟洞","author":"戚继光","text":"天地无心壑似舟，岩扉寂历自春秋。\n一时偶见停桡在，千载能令载酒游。\n洞口将军应化石，蓟门客子尚存丘。\n醉来欲掣神鳌去，不掷任公旧钓钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雾灵山","author":"戚继光","text":"昔人说法暮云残，几度劳歌秋草寒。\n日月四千俱佛土，山河百二尽龙蟠。\n南瞻御气长安近，北俯胡沙属国宽。\n乐界自迷归去路，却嫌苦海殢缨冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赤灵符","author":"戚继光","text":"病骨嶙嶙强自撑，每从马革问余生。\n而今万里无烽火，不用灵符辟五兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别总镇刘公","author":"戚继光","text":"百年天地识孤忠，九塞旌旗羡更雄。\n易水光分典属国，太行色起右扶风。\n论文几度同听雨，把剑中宵自吐虹。\n词客相看多不薄，早将椽笔赋彤弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"申太夫人八秩","author":"戚继光","text":"一阳回泌泽，云物卜先春。\n圣善钟中阃，贤才启后人。\n授经逾五桂，列彩重三辰。\n养至金章贵，恩逢石茆新。\n家声振冰雪，世德著丝纶。\n但识旗常显，还看机杼陈。\n河源分浩荡，岳色起嶙峋。\n彤管称尧舜，瑶枢映楚秦。\n轻轺陟屺日，寸草倚闾身。\n忠孝谁能擅，千秋独颂申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子除夕署中有感","author":"戚继光","text":"五十春光隔曙晖，风尘未晤梦中非。\n半生俯仰天应识，三辅蹉跎腊又归。\n杯酒忽惊寒漏尽，垄云故与片心违。\n共君莫话当年事，赤胆犹殷白发稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿北平兵宪海山陈公","author":"戚继光","text":"南北天为吾党期，櫜鞬常得傍蟾帷。\n行间力借青云起，使者名从绛节驰。\n万仞冈陵当祝日，三藩才俊共瞻时。\n安闽筹策应谁问？\n惟有年来白发知！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石匣四松","author":"戚继光","text":"翛然相倚翠堪餐，龙卧鸾翔各羽翰。\n对尔十年流景易，会心一日宦途难！\n涛回小簟侵人骨，梦破层阴悟鼠肝。\n莫道大夫能变化，贞操不易雪霜寒！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时馆","author":"戚继光","text":"校武开形胜，论文傍梵宫。\n层阴三树合，复道一泉通。\n环宇寒暄异，流觞左右同。\n醉来谁意气，白眼弄青虹？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邹隐君归洞庭","author":"戚继光","text":"皓首相逢意气殊，谁知大雅在菰芦。\n客星起色当东辅，碣石雄谈入太湖。\n万顷烟消鸿影度，两山寒浸月华孤。\n扁舟好逐鸱夷侣，能忆边庭岁易徂？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕河送别东山张公镇守宁夏","author":"戚继光","text":"十年心印许谁传，万里西征思黯然。\n圣主宠分金鹊篆，疆臣敢负采薇篇？\n流言往事浮云尽，破虏殊勋丽日悬！\n燕塞何时重握手，一尊相罄故人前？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登塞上台，和幼海周山人韵","author":"戚继光","text":"曾嗟雁唳越王台，何处分飞又北来！\n游子几时归故里，年年秋影落空杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛未送谭司马、甲戌送刘司空、戊寅送杨司寇，俱至牛山有感","author":"戚继光","text":"春拥油幢出远山，十年三到白河湾。\n生平自分无骸骨，却是人间有玉关！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日饮孙协镇葡萄园，忆北平傅、陈二使君","author":"戚继光","text":"不见浮槎博望侯，相看苍干已成虬。\n珠龙当日俦能致，射海何年迹并收？\n云拥北平淹使节，梦遥南国下鲸流。\n累累架底容吾醉，为有诸君尽虎头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石塘岭鹦鹉岩 其一","author":"戚继光","text":"翠羽丹崖敞碧天，飞来风雨不知年。\n肯饶寸舌呼余粒，惟有精神倚暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石塘岭鹦鹉岩 其二","author":"戚继光","text":"侧身天地欲言难，故向空山戢羽翰。\n雨后千林争起色，月中片石怯生寒。\n更无金锁惊春梦，似有清音落暮滩。\n一自边城留幻迹，陇西云树几凋残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]