[{"title":"游灵岩山","author":"董其昌","text":"选胜从初地，伤秋问故宫。\n周遭悬径仄，明灭远湖空。\n人阅台游鹿，碑看墨戏鸿。\n共携高士传，展读乱云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惠山黄园","author":"董其昌","text":"烟景驻征骑，晴林踏落花。\n因听绿水曲，忽到赤松家。\n鱼鸟向人近，楼台俯郭斜。\n更携馀兴去，丝管隔窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游灵岩山范园","author":"董其昌","text":"三径我频到，千峰自掩门。\n停云吴会思，白雪郢中翻。\n豹隐神逾王，龙图谊益敦。\n年来多道貌，因事五千言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同唐元徵宫允游善权洞四首 其一","author":"董其昌","text":"神功开混沌，水府亘氤氲。\n峡隐将飞石，岩垂欲堕云。\n龙腥阴壑迥，鸟道乱泉分。\n今日摩厓记，知同藏史群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同唐元徵宫允游善权洞四首 其二","author":"董其昌","text":"西峰拨云尽，万象划然殊。\n地轴连离墨，仙宫秘蕊珠。\n微明天有漏，大巧谷非愚。\n为问探奇者，曾逢石髓无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同唐元徵宫允游善权洞四首 其三","author":"董其昌","text":"石径幽无际，金堂永不扃。\n丹台犹偃月，仙掌故扪星。\n跨鲤探云笈，燃犀遁水灵。\n如闻淙响外，历历演黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同唐元徵宫允游善权洞四首 其四","author":"董其昌","text":"山霁气初澄，攀萝下复登。\n千峰攒积铁，百仞矗层冰。\n溅雪看庐阜，随花得武陵。\n平生耽胜事，选胜却输僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泖湖春泛","author":"董其昌","text":"野涉有同人，云帆试早春。\n能将催榜兴，更入聚沙因。\n水国龙犹蛰，香台鸟亦驯。\n祗林经浩劫，暗逐岁华新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏孟桧","author":"董其昌","text":"爱此孟家树，森然见典型。\n沃根洙水润，含气峄山灵。\n阅世消秦篆，参天郁鲁青。\n方知樗散寿，只入列仙经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫茄五首 其一","author":"董其昌","text":"何物昆崙种，曾经御苑题。\n似葵能卫足，非李亦成蹊。\n落实寻常味，攀条径寸低。\n玉盘如可荐，宁复怅云泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫茄五首 其二","author":"董其昌","text":"欲辨嘉蔬种，应同藿食人。\n累垂贪结子，低亚巧藏身。\n被垄千苞坼，连畦万颗匀。\n清斋频撷取，老圃未生嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫茄五首 其三","author":"董其昌","text":"纂纂称天茁，离离见土毛。\n知非丰岁宝，聊佐野夫饕。\n落处宁为瓠，投来颇类桃。\n米家图矮树，怪尔矗云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫茄五首 其四","author":"董其昌","text":"卑栖性所便，尺五即为天。\n每带胭脂色，来登玳瑁筵。\n江莼下豉美，蒟酱点庖鲜。\n能误青鞋客，忙趋过邵田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫茄五首 其五","author":"董其昌","text":"不敢怨无诗，秋当咏菊时。\n封关丸可弄，覆餗印何累。\n槐国分阴近，僬侥假盖迟。\n谁知谦吉意，更好助观颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五日龙潭观水嬉","author":"董其昌","text":"归客炱恢侯，都人游冶场。\n繇来看竞渡，是处比浮湘。\n水曲鱼龙戏，风前缯綵香。\n祗将反骚意，永日对壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜有集得还字","author":"董其昌","text":"逃虚城市里，踪迹远人间。\n结梦迷新路，题诗忆旧山。\n星河低坐冷，秋色逐人还。\n好及清言夜，君今且闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"就李九日同郭次甫登金明阁","author":"董其昌","text":"香阁瞰郊关，芳晨试共攀。\n不因寻白社，何以见南山。\n夕梵林端出，秋钟雨外閒。\n青萸更黄菊，无酒亦开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曲阿孙山人过访鸳湖旅舍","author":"董其昌","text":"数载掩荆扉，重来似鹤归。\n贫惊故吾甚，狂与世情违。\n岁俭谁供秫，霜寒未授衣。\n当湖惜别处，烟雨夜霏霏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽苏烈女二首 其一","author":"董其昌","text":"战垒多新鬼，衡茅表大家。\n所生真不忝，之死更靡他。\n青冢颜何厚，崩城事共嗟。\n贞魂化雌剑，直可净胡沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽苏烈女二首 其二","author":"董其昌","text":"国恤传江汜，王风续汝坟。\n问名曾未字，殉节岂恒闻。\n马革嗟何及，鸿毛死更芬。\n史书苏媛事，宁数锦回文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至后同诸公访愚公慈惠兰若驾纳言延伯有作依韵和之","author":"董其昌","text":"神皋方丈室，初地盍簪盟。\n花雨翻空界，松涛杂梵声。\n小参如筏语，晏坐閒关情。\n楼阁重延眺，千山积翠横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别侯六真司农","author":"董其昌","text":"剑履瞻民部，星辰托友昆。\n家如移社曲，容许傍夷门。\n易接铜龙武，难虚镜水恩。\n春风杨柳陌，意气罄离尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题汶上路太守壁二首 其一","author":"董其昌","text":"寻云路公榭，招鹤路家池。\n记取还山客，风流此一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题汶上路太守壁二首 其二","author":"董其昌","text":"衣拂京洛缁，窗含齐鲁黛。\n因君思故山，驱车火云外。","collection