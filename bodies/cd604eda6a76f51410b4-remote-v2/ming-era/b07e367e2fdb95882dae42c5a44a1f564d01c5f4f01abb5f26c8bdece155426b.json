7,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其六","author":"董其昌","text":"隃糜磨一石，侧理伸寻丈。\n轩轩五岳图，堂堂大人相。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其七","author":"董其昌","text":"少年多狡狯，老笔渐离披。\n气韵从何取，心无赞毁时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其八","author":"董其昌","text":"云海荡吾胸，笔随意所到。\n犹如剡上船，何必见安道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其九","author":"董其昌","text":"虚槛列云岫，闲阶响石淙。\n若添千顷竹，又领渭川封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其十","author":"董其昌","text":"幽人茶灶烟，每与宿云乱。\n凭轩望所思，春湖渺无岸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其十一","author":"董其昌","text":"野客不贪涉，如何亦问津。\n前村黄叶里，大有耐閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其十二","author":"董其昌","text":"茅屋空山中，时有幽人至。\n指点乱云生，不谈人间事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其十三","author":"董其昌","text":"巘崿莲为峰，涟漪柳成浪。\n此中可卜居，于以遂天放。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其十四","author":"董其昌","text":"客去秋林空，沙际石濑响。\n好随飞鸟归，一路山烟上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其十五","author":"董其昌","text":"乔木生昼阴，清泉响寒溜。\n前村杳霭中，大有雷霆斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画共十六首 其十六","author":"董其昌","text":"谷静鸟飞绝，天空云度閒。\n尔时一回首，眼底无青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画杂诗 其一","author":"董其昌","text":"晚岫带霞明，汀洲变蘋绿。\n如何万里桥，却在苏台曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画杂诗 其二","author":"董其昌","text":"龙女是前身，鸥波不问津。\n侍儿能缚帚，何处拂红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画杂诗 其三","author":"董其昌","text":"弭棹月三更，秋砧断复续。\n听砧了不愁，翻理无愁曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万寿朝贺","author":"董其昌","text":"仙掌初开玉露清，瑞看尧荚向秋荣。\n香飘桂殿分旌影，乐散珠宫杂佩声。\n琮帛迥陈王会盛，星辰切望泰阶平。\n亦知华祝年年事，别有丹箴效广成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太庙荐麦","author":"董其昌","text":"閟宫朝启肃精禋，御苑来牟及荐新。\n九叶灵光开大历，双岐瑞颖献昌辰。\n风回玉几馨先稷，露裛金茎洁似蘋。\n一自寝园祈报后，于皇清颂遍周民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得玉河冰泮","author":"董其昌","text":"寒澌忽散御沟东，百道清波太液通。\n望处月华连沼动，祈来雪瑞及春融。\n渐听玉碎方流畔，不尽珠遗赤水中。\n先向龙池沾帝泽，愿歌鱼藻乐皇风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安冬至","author":"董其昌","text":"子月风光雪后看，新阳一缕动长安。\n禁钟乍应云门曲，宫树先驱黍谷寒。\n台上书祥传太史，斋居问礼向祠官。\n纷纷双阙鸣珂下，未觉玄关闭独难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上林春雪","author":"董其昌","text":"九陌阳和御苑偏，瑞看盈尺应祈年。\n飞花散入梅千树，舞絮犹疑柳半烟。\n积处宜春添曙色，融来太液涨新泉。\n不须更和邹枚曲，黄竹歌声日下传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中州凤凰见为大中丞冯礼亭年丈赠","author":"董其昌","text":"温洛嵩高天地中，千秋再见凤游空。\n直缘干羽修虞典，可但循良溯汉风。\n盟府论功铭熟釜，内廷锡宴赋彤弓。\n承明著作惭班掾，载笔犹能纪大冯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周斗垣参知入贺二首 其一","author":"董其昌","text":"桂舟容与叙分携，日近长安禹会齐。\n四岳云开蒲璧贵，双茎露爽玉绳低。\n瑞看符命呈华渚，锡有新纶下紫泥。\n南国若论棠芾事，春风桃李白苏堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]