[{"title":"哭太学友陕西张恕","author":"吴琏","text":"迢递琴书上帝畿，子规啼月落馀晖。\n一窗灯火十年梦，万里关河一衬归。\n绿鬓眼枯新旐墨，白头肠断旧莱衣。\n生刍一束无由置，拈笔哀吟泪雨飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何邦彦之官浮梁","author":"吴琏","text":"明能观物理，公可服人心。\n明自公中出，公从明处深。\n生灵同赤子，瓦砾视黄金。\n酷爱龚黄辈，芳名古到今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡大声放回","author":"吴琏","text":"一卷先天几句诗，嘤嘤黄鸟绿杨枝。\n相看酷爱人如玉，为别生嫌马似飞。\n燕馆夜寒孤鹄影，饶江春暖艳襕衣。\n一忠一孝男儿事，向北征辕莫较迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢林乡人带家书至北馆","author":"吴琏","text":"瓜蔓青连葛蔓青，万金书籍寄神京。\n床头病在迟瞻访，囊里金无失送迎。\n频拭纸窗争月白，重磨长剑插天明。\n平安二字无馀事，逢著吾翁为寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何应期之官崇明","author":"吴琏","text":"万里之官海上洲，此官原是古诸侯。\n寸诚可作千村泽，一爱能消万姓忧。\n马薏贮船成客谤，吴香归路委江流。\n闲来点检循良传，耿耿芳名万古留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘世祯","author":"吴琏","text":"何日?江一泊舟，风烟为别几经秋。\n逢人数问南来信，闻说先生已白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡提学升福建宪副","author":"吴琏","text":"万仞匡庐插碧天，鲰生双眼倦云颠。\n无端生意连蹊草，不断清音落涧泉。\n晓露芝兰开树树，春风桃李长年年。\n抠趋欲尽登临兴，翘首闽山路八千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮至冲虚观万象森然真洞天境界","author":"吴琏","text":"四百耸耸峰插天，一观万树青苍连。\n白头道士对棋局，碧眼小童鸣管弦。\n丹灶古泥浮紫气，修篁符叶霭苍烟。\n仙禽似有相留意，啼伴山房几觉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至七星坛及飞云顶会三人各持一竹揖别后始知其仙","author":"吴琏","text":"古梅垂垂花遍开，古坛深净路萦回。\n山猿连臂下复上，野鸟乱啼飞复来。\n云起岩隈凝翠盖，石堆波面翳苍苔。\n诸仙歌笑飞云上，一揖相逢紫翠堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓含山答南都胡侍御胡先为含山令","author":"吴琏","text":"瘦马南来十室中，山深无自见人龙。\n古来旧政传新令，手教无妨日数封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"含山寄李席珍杨景昌","author":"吴琏","text":"小小茅檐数十馀，一春耕凿自如如。\n莫言鸡小刀无用，赢得官闲日看书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题湖西别业","author":"吴琏","text":"何处风光乐可寻，淮西湖上草堂阴。\n陶潜几树绿杨好，周子满庭芳草深。\n过眼烟波随上下，傍人鸥鸟自浮沈。\n一尘飞不到真境，明月几时同醉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以公事同抚州吴推府宿萝山寺","author":"吴琏","text":"叠叠山峰远近连，公过闲借上方眠。\n高谈说处佛耸听，好句成时僧暗传。\n几院古松巢野鹤，两岐新麦秀山田。\n吟馀庵外还舒步，犬卧柴扃月满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李寅教谕致仕","author":"吴琏","text":"坦坦云霄路早行，晚风江上忽舟横。\n翔斯集矣色斯举，泽可钓兮田可耕。\n酒不饮时从索价，棋多输处为贪赢。\n青山绿树浮云外，一事无干了此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入觐过诸湖","author":"吴琏","text":"行担希微客舫轻，一帆风过几沧溟。\n岸旁水落石还出，岗上草黄松自青。\n老翁泛湖舟几只，孺子濯足歌数声。\n倚蓬一望成惆怅，诗谩吟哦酒谩倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入觐途中咏雪","author":"吴琏","text":"雨密风严冻转加，絮飞盐撒两无瑕。\n千门有地皆凝粉，万树无春自放花。\n晓日短詹垂玉箸，晚风平地起银沙。\n丰年有兆宜相庆，驻马呼童问酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词三首 其一","author":"吴琏","text":"帘卷霞光日暮时，白羊何处响车儿。\n自知离合皆天定，不用吴盐洒竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词三首 其二","author":"吴琏","text":"织罢公裳绣锦袍，妾身随分效微劳。\n中情何用君王识，俯仰无惭是所操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词三首 其三","author":"吴琏","text":"门径春风翳草芽，懒将心事弄铅华。\n惊回午梦闲啼鸟，斜倚宫墙看落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄沙水诸舅","author":"吴琏","text":"溪水清清漾碧沙，古松岗上是谁家。\n年来闻得浮生计，闲辟污莱学种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九饮徐别驾南庄","author":"吴琏","text":"松阴如盖午风凉，花满篱庭酒满觞。\n元亮一庄闲意趣，孟嘉千里共徜徉。\n主情恰与宾情恰，诗兴长于酒兴长。\n壶矢未阑题未遍，不堪明月映秋江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和冯汝清见访","author":"吴琏","text":"公暇委蛇退早衙，官庭频扫净无沙。\n忽传客舫停关外，问是君来自海涯。\n酷爱绸缪情惓惓，不妨倾倒帽斜斜。\n山城浊酒应能醑，未放山夫送小车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归欤词","author":"吴琏","text":"归欤归欤，吾之膝有琴案有书。\n琴可鼓而造尧舜之区，书可读而坐周孔之隅。\n吾之竹万个松数株。\n深苍浅翠，老怀衰步可于此而少舒。\n清江枕村兮可渔，薄田负郭兮可锄。\n出无车兮蹇驴，食无鱼兮盐菹，居无庐兮茅旋可诛。\n如此亦可放浪形骸而自适，何役役于尘途而久困其躯。\n菽水以娱老亲兮，旦夕愉愉。\n诗书以启儿童兮，庭其日趋。\n再掩扉于罗浮兮，日求心得之馀。\n惟冀所生于无忝谁其拘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复南昌守","author":"吴琏","text":"彭泽爱陶潜，陶潜厌彭泽。\n一杯浮罗春，世外神仙客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乞休至丰城寄南昌郑通府","author":"吴琏","text":"一心聊自适，两膝报平安。\n烟艇南溟外，浮云细细看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中即事四首 其一","author":"吴琏","text":"僻地六七亩，好邻三四家。\n逐时买鸡犬，随雨种桑麻。\n瓮泼新篘酒，梅开老树花。\n不愁甘旨缺，随处见生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中即事四首 其二","author":"吴琏","text":"一拨红尘便入山，山中甘旨慰慈颜。\n坐开黄卷清窗净，卧掩柴扉白昼闲。\n癖好诗书增白发，衰凭丹药助朱颜。\n赤松子候同游乐，婚嫁何年了世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中即事四首 其三","author":"吴琏","text":"四角黄牛一草庐，一山松竹一江鱼。\n饮馀盏酒即寻睡，了却些农便看书。\n挺岁萱花堂以北，争春兰茁雨之馀。\n故人若问陶元亮，飞鸟还林只自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中即事四首 其四","author":"吴琏","text":"一入青山即当仙，野禽幽鹿伴清眠。\n诗书剩买无论价，风月频赊不用钱。\n林外軥辀花外蝶，径中松竹雨中莲。\n少开老眼成真趣，翻恨红尘误少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜书塾新成","author":"吴琏","text":"屋外青山山外庭，山深人静院清清。\n池边洗砚鱼龙喜，竹里题诗鸟雀惊。\n窗几净函春草绿，吾伊声蔼夜灯明。\n青衿满眼俱豪俊，从此朝阳有凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫笔","author":"吴琏","text":"卢橘花开二月天，春风怀抱自年年。\n客来问字不暇答，且教官童学种田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和彭文见寄","author":"吴琏","text":"头白纷纷任世嗔，野怀幽兴逐年新。\n闲中白昼我为我，忙里红尘人自人。\n浮云忽舒忽复卷，尺蠖俄屈俄还伸。\n人间冷暖浑无定，律转阳和即是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代乡人贺东博店主初度","author":"吴琏","text":"历历星霜六十周，夜看南极瑞光浮。\n十围松柏还苍干，满眼儿孙未白头。\n王母玉桃呈古博，葛翁丹粒候瀛洲。\n晚来闲眺青天外，雨过南山色更幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"允祯尹怀安诗以示之","author":"吴琏","text":"世外精神一老身，闲中点检未全贫。\n秫田负郭年供酒，笋箨堆林日当薪。\n半亩池鱼于仞跃，四时园果相鲜新。\n君恩当报民当恤，莫遣家乡入念频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李元善时元善为广西大参 其一","author":"吴琏","text":"忠节看看老益强，江河谁谓斗堪量。\n万家厚泽四时雨，到处浓阴一树棠。\n稷契眼中调重鼎，巢由林下稳方床。\n纤需负郭田堪秫，松底何年一尽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李元善时元善为广西大参 其二","author":"吴琏","text":"得入青山便掩扉，半因衰病半狂痴。\n人前不尽三分话，酒后空哦几句诗。\n膝下彩衣娱老母，案头黄卷付诸儿。\n扣门有客来相问，万事摇头说不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈祐卿奉使北还","author":"吴琏","text":"菊坡亭外草连天，重担何人一着肩。\n诗送先生远归国，卧将双耳洗山前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送修书黄陈二进士事竣北还 其一","author":"吴琏","text":"心头斤两铢铢定，笔下春秋字字严。\n司马先生黄太史，百年公论更谁嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送修书黄陈二进士事竣北还 其二","author":"吴琏","text":"海滨古邹鲁，山木间楩梓。\n先生笔则笔，千载垂青史。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑元美以事拘宪狱诗以奉慰","author":"吴琏","text":"大哉公冶长，缧绁非所耻。\n独恨白发多，无人妻伊子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和戴伯元李席珍菊会诗二首 其一","author":"吴琏","text":"老圃秋容次第开，晚山清节可谁陪。\n日高重影参差见，风细微香远近来。\n盈把采馀陶令手，落英飧老屈原杯。\n枝枝朵朵重重瓣，真费天工细剪裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和戴伯元李席珍菊会诗二首 其二","author":"吴琏","text":"高秋篱落露华浓，佳节何年酒盏空。\n彭泽白衣来远圃，龙山乌帽落轻风。\n菊因人赏花方媚，诗出天然句始工。\n更拾落英频细嚼，这般清味可谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"福州贾百户使广为带允祯家书事竣诗以送之","author":"吴琏","text":"三尺焦桐百里音，野棠春浅定春深。\n几秋睽别浑千载，两字平安抵万金。\n乡思宦情劳远慰，荜门洼巷荷重临。\n怀庭更藉丁宁语，黄卓芳名古到今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严子陵四首 其一","author":"吴琏","text":"文叔苍颜我鬓华，相看甘分老烟霞。\n莫言故旧无相助，凤阙渔矶各一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严子陵四首 其二","author":"吴琏","text":"老大难为少贵谋，错将心思问羊裘。\n谏垣不是延宾地，依旧桐江一钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严子陵四首 其三","author":"吴琏","text":"白发桐江老钓徒，清风千古汉狂奴。\n不知崔烈祠前过，亦向先生一拜无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严子陵四首 其四","author":"吴琏","text":"珍重君房列上卿，玄纁何苦远相迎。\n钓台细雨春山外，竿自横江水自清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万筠一叟为郑元美作 其一","author":"吴琏","text":"人瘠以无肉，人俗以无竹。\n爱肉人所同，爱竹君所独。\n门外俨渭川，庐旁即淇澳。\n月色锁碎金，风声凤凰曲。\n大暑自清凉，隆寒亦苍绿。\n不受尘土侵，止厌牛羊触。\n先生归去来，对此亦自足。\n竹床琴一张，竹轩书数束。\n琴横竹阴弹，书展竹阴读。\n一弹一读罢，披怀酌醽醁。\n百年洒洒天地间，管甚谁荣与谁辱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万筠一叟为郑元美作 其二","author":"吴琏","text":"筼筜新种几千竿，要占浮生日日闲。\n紫陌红尘忙白昼，黄堂清兴爱青山。\n风生凤吹撩诗兴，雨长龙孙益笑颜。\n随鹤一归放林上，任教飞去复飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏笔","author":"吴琏","text":"蒲扇纶巾老秃翁，一天明月一山风。\n闭门谢绝人间事，一任浮云过眼中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"富翁吟","author":"吴琏","text":"绣户雕阑玳瑁筵，沈檀风袅鸭炉烟。\n翠钿错落调钟乳，玉笋纵横拨锦弦。\n紫阁绣袍车杂沓，金丸珠履客喧填。\n蜡薪麟脯龙为醢，笑杀何曾日万钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贫士吟","author":"吴琏","text":"曲巷萧条惨澹家，荜门圭窦小山洼。\n单衣絮薄风频透，破屋萝牵雨莫遮。\n夜读借光天黯黯，朝炊赊米日斜斜。\n家徒四壁门如洗，乐对荆妻老岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨掌科子山服阕还京","author":"吴琏","text":"三载刘郎海上归，春风红碧自成蹊。\n刘郎再入看花会，不看夭桃只看葵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周侍御上疏言幸臣事谪怀远驿过访诗以奉赠","author":"吴琏","text":"老山豺虎众所畏，大厦栋梁谁力扶。\n卓尔声光千载仰，挺然天地一心孤。\n依阿随世乃妾妇，雄猛敢言真丈夫。\n我有此怀无地发，独将忧念抱江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘晏叔昆仲","author":"吴琏","text":"座上埙鸣座下篪，相欢相笑日怡怡。\n闻人不似逢人话，见面深嫌识面迟。\n夏雨苗须秋雨实，少年心赖暮年持。\n自惭潦倒头空白，真率惟应叔季知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺戴伯元初度","author":"吴琏","text":"今古瀛洲上，蟠桃几度花。\n喜闻新结实，荣献到君家。\n云液酣王母，天歌散紫霞。\n甘香梨似蜜，肥软枣如瓜。\n玉斝篯翁酒，金瓯陆羽茶。\n催花鼓急急，迎喜鹊喳喳。\n乐奏清音曲，门喧白鼻騧。\n十年期一会，百岁共繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西施","author":"吴琏","text":"鬓扫烟云眼醮波，吴王宫里见姮娥。\n鸱夷不尽搜求力，仙态沈沈老苧罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄同年程德和通政","author":"吴琏","text":"老去何年是会时，一江南北路微微。\n山深驿使无来往，莫怪梅花折寄迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亡考忌日","author":"吴琏","text":"心欲成灰眼欲枯，真容无计变头颅。\n衰怀亦有荣褒望，未识君王出猎无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亡妣忌日","author":"吴琏","text":"风入寒山万木悲，年年此日泪沾衣。\n一生独抱荣褒恨，火上殊恩付阿儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君词","author":"吴琏","text":"妾入夷宫汉土清，玉容虚说解倾城。\n君王好奠毛延寿，一笔殊当百万兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西屿为泌冲邹处士作","author":"吴琏","text":"江南有佳人，结屋傍岩穴。\n睡起日将午，乘阴采山蕨。\n晚霞映窗明，卷帘看新月。\n何当一访之，细把行藏说。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老将","author":"吴琏","text":"上马争言矍铄翁，据鞍犹喜马如龙。\n日寻旧砺磨新剑，时买新弦上旧弓。\n夜读龙韬还朗朗，晓登云栈尚重重。\n圣明若铸封侯印，天下平宁指顾中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老妓","author":"吴琏","text":"蝉鬓歌台舞袖时，金貂公子富家儿。\n一从冷落门前马，肠断苏州懒寄诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张东所送厓山新志读而有感","author":"吴琏","text":"新祠新志两荧荧，宇宙纲常日月明。\n一后万年彰圣德，三臣千古慰忠灵。\n宋庭王蔡章椎破，虏祸秦韩贾酿成。\n六贼共消恭帝恨，英雄徒尔费精诚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和白沙先生与门人唱和诗","author":"吴琏","text":"欲上飞云散一歌，相看休问意如何。\n学吹牧子骑牛笛，闲著渔翁钓月蓑。\n黑发渐惊成白发，黄河新见转清河。\n太平有象年来见，山下耕人雨后多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送伦伯畴先生服阕北上","author":"吴琏","text":"曲江祠下水潺潺，清献坡亭紫翠环。\n五岭再占名相出，九重深喜状元还。\n葵花向日常含赤，蜂蜜尊王数献兰。\n老卧江湖无所嘱，大披忠悃沃天颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]