[{"title":"次清源值龚侍御行部过谈舟中","author":"卢龙云","text":"维舟当日暮，有客过河干。\n六载思同舍，重逢感旧欢。\n月曾薇省隔，霜已鹭车寒。\n揽辔君行早，弹来愧豸冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之邯郸答高正甫博士二首 其一","author":"卢龙云","text":"疋马向丛台，风烟万里开。\n骊歌徵别曲，郢调杂新裁。\n随牒官非远，临岐首屡回。\n绝怜天尺五，先简邺中才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之邯郸答高正甫博士二首 其二","author":"卢龙云","text":"再上燕台日，还思粤岭时。\n千山辞瘴疠，五斗复腰肢。\n下走风尘吏，中兴国学师。\n未称劳逸远，诗句许相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"回车巷世传蔺相如避廉颇处","author":"卢龙云","text":"国事艰危里，君心属望初。\n抗秦堪拔剑，全赵且回车。\n虎斗谁争长，鹰扬计未疏。\n列侯多策士，谁更似相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈新之二首 其一","author":"卢龙云","text":"期月平干政，风流邺下才。\n神君邑里颂，循吏传中来。\n世业青箱授，先声白简催。\n五云天咫尺，飞舄自堪回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈新之二首 其二","author":"卢龙云","text":"保障元相并，飞腾可易同。\n里中难和雪，斤外已成风。\n名自斗南远，群应冀北空。\n愧余初学步，蹇拙向谁工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读朱巽甫嘉禾卷二首 其一","author":"卢龙云","text":"旧美渔阳政，嘉禾合并观。\n总缘秋色好，双拂露华乾。\n瑞协千箱积，忧从百亩宽。\n河阳花发后，孰与此中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读朱巽甫嘉禾卷二首 其二","author":"卢龙云","text":"几载求荒策，祥开喜颂君。\n政和天亦格，绩异帝先闻。\n畴绿新沾雨，畦黄并卧云。\n愿因同颖秀，遍向陇头分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得仲弟家书二首 其一","author":"卢龙云","text":"万里天南信，经年未易闻。\n清宵频梦草，白日几看云。\n朔雪迷凫影，春山掩雁群。\n忽来逢粤使，欣读八行文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得仲弟家书二首 其二","author":"卢龙云","text":"三年来冀北，星聚愧元方。\n松菊应还在，田园岂尽荒。\n旅愁春又半，乡思日偏长。\n秋好看鹏翼，凌风或并翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"照眉池世传赵宫人照眉于此","author":"卢龙云","text":"荒池千载后，尚忆照眉时。\n云鬓临妆罢，花容傍槛移。\n柳馀深染黛，桃学淡凝脂。\n此日空樵牧，兴亡事可悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇三首 其一","author":"卢龙云","text":"行路难如此，孤踪合滞留。\n客怀空对月，蓬鬓又惊秋。\n愁逐商飙起，心俱大火流。\n长安车马地，回首记同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇三首 其二","author":"卢龙云","text":"阅遍红尘骑，凭谁慰盍簪。\n人多工射影，吾独怅论心。\n往事如川逝，生涯总陆沉。\n但令钟子在，犹可托知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇三首 其三","author":"卢龙云","text":"圣朝多雨露，无地不衔恩。\n总识乾坤大，其如岁月奔。\n殊方甘落魄，旅梦易惊魂。\n自信心元赤，何时达帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与张计部夜语并寄家书","author":"卢龙云","text":"冉冉风尘客，悠悠桑梓情。\n十年俱潦倒，片语尽平生。\n候馆悲秋色，乡园羡昼行。\n平安惟两字，凭为报柴荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅梦二首 其一","author":"卢龙云","text":"客舍连宵梦，居然是故乡。\n风波怜逆旅，羽翮倦殊方。\n漏永参横户，窗虚月在梁。\n静闻天籁起，萧飒动新凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅梦二首 其二","author":"卢龙云","text":"漂泊非吾土，迢遥忆敝庐。\n到家元是梦，经岁渺无书。\n骨肉两乡隔，宾朋万里疏。\n行藏天所付，安用渺愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发邯郸暂寓西署四首 其一","author":"卢龙云","text":"信宿丛台下，栖栖一旅人。\n閒方谢簿领，愁转怯风尘。\n砧杵秋声急，关山客梦频。\n但谙倚伏理，何处不容身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发邯郸暂寓西署四首 其二","author":"卢龙云","text":"蓬转应难定，羁栖复若何。\n困来悲失马，妒在敢扬蛾。\n旅思丹枫剧，乡心白雁多。\n长风吹晓漏，不寐彻行窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发邯郸暂寓西署四首 其三","author":"卢龙云","text":"细雨侵阶湿，微风入暮寒。\n徘徊征思懒，牢落客衣单。\n卷帙堪为伴，琴尊并所欢。\n未须怜去住，何路不行难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发邯郸暂寓西署四首 其四","author":"卢龙云","text":"闭户时深念，凭谁作解嘲。\n不妨杯独把，聊复句重敲。\n傲骨成金注，穷愁是石交。\n故园秋色满，天末有衡茅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日旅怀","author":"卢龙云","text":"万里同为客，三年别故乡。\n生涯俱逆旅，岁事又重阳。\n盟负篱花酒，寒侵木叶霜。\n龙山今日帽，谁并孟嘉狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对月","author":"卢龙云","text":"望尽三秋月，空添万里愁。\n风云多变态，羽翼尚淹留。\n未上贾生涕，难消杞国忧。\n可堪三五夕，俱倚仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送乡友之扬州","author":"卢龙云","text":"木叶催寒序，他乡动客愁。\n君方随旅雁，我独怅鸣驺。\n斗下分雄剑，霜前怯敝裘。\n暮云将鹤去，何日到扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行","author":"卢龙云","text":"淡月听鸡去，狂风傍马吹。\n有谁怜傲骨，徒自强低眉。\n白屋閒中笑，青楼暗里窥。\n故人霄汉上，几度及瓜期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄汝纶","author":"卢龙云","text":"记忆邯郸道，真从梦里看。\n弹冠先达笑，行路古来难。\n满目纷时态，贞心独岁寒。\n风尘俱异域，握手慰加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"卢龙云","text":"万态纷如昨，乾坤总莫容。\n是非元自见，忧喜递相从。\n未解知黄雀，何须笑白龙。\n酒杯时对月，漂泊任萍踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答高正甫赠别二首 其一","author":"卢龙云","text":"拙已无三异，狂初学四明。\n暮云连树渺，孤鹤伴琴清。\n走马为迁客，听莺恋友生。\n骊歌新柳外，无奈别离声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答高正甫赠别二首 其二","author":"卢龙云","text":"上林春事好，谁与问花神。\n我愧愁为敌，人知懒是真。\n漂零随世态，奔轶望京尘。\n纵有渑池翼，那堪白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答袁彦可","author":"卢龙云","text":"回首金台下，如君意独长。\n开尊同雪色，并骑挹春光。\n袂忍看花别，鞭因折柳扬。\n新诗时把玩，慰我九回肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别黄汝纶","author":"卢龙云","text":"风尘耽薄禄，岁月混微名。\n衣敝鹑将结，琴孤鹤共清。\n诗多留滞意，酒慰别离情。\n试问金台客，谁当赋二京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫文学转王官致政","author":"卢龙云","text":"王门堪吏隐，虚左待君来。\n醴酒恩非薄，长裾念已灰。\n未临都讲席，先上望乡台。\n桃李阴初合，含情更一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日钱使君招同蒋文学署中小酌时方忧旱","author":"卢龙云","text":"郡阁逢多暇，庭槐逗远风。\n天涯三夏半，客里一尊同。\n艾叶迎杯绿，榴花入座红。\n因思云汉语，废酒意忡忡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日公出便过江氏园亭","author":"卢龙云","text":"本是逢迎出，翻为汗漫游。\n葵榴丹艳满，槐柳绿阴稠。\n染翰馀清暇，开尊恋胜幽。\n坐来移昼永，忽自散穷愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城北送客不及小集神祠得同字","author":"卢龙云","text":"共有阳关意，归人望已穷。\n避喧因别酒，听法借禅宫。\n聚散元无定，壶觞但不空。\n官閒期会少，竟日总堪同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜雨","author":"卢龙云","text":"雨意连朝足，人心尽日欢。\n火云初捲焰，赤地已扬澜。\n耕课移勤补，农书带笑看。\n几旬陪露祷，今得谢玄坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司马王公招饮城东别墅","author":"卢龙云","text":"背郭新开径，邀宾屡徙筵。\n香山游再羙，绿野景同鲜。\n鸟亦知人乐，花能为客妍。\n微风生雨后，真可对炎天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慰蒋文学思归","author":"卢龙云","text":"异地同为客，如君最系思。\n眼穿垂暮日，愁剧未归时。\n燧色连青海，乡心满绛帷。\n春风将改岁，桃李又花期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿兴善寺二首 其一","author":"卢龙云","text":"一径双林下，新晴对夕晖。\n参禅同入定，趺坐久忘归。\n蛙吹皆成部，莲灯半照帷。\n疏钟才数点，冥悟息尘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿兴善寺二首 其二","author":"卢龙云","text":"借榻依禅室，坛前见雨花。\n停骖初贳酒，避鹤几烹茶。\n棋局缘幽兴，诗篇恋物华。\n尘途方扰扰，安得似僧家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淫雨颓垣甚多走笔戏作","author":"卢龙云","text":"蜗居徒四壁，四壁复难存。\n夜宿玄冥驾，朝翻白帝盆。\n龙吟当户牖，蛙鼓近堂门。\n无力驱山鬼，凭谁为筑垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自文安舟行至武清二首 其一","author":"卢龙云","text":"作客元无定，公馀亦胜游。\n泥涂方驻马，野水共乘舟。\n帆挂中川月，舷鸣雨岸秋。\n江湖思不尽，渔火满汀洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自文安舟行至武清二首 其二","author":"卢龙云","text":"蓟北三年客，常愁马足尘。\n平川理舟楫，清夜下江津。\n秋夜穿蒲苇，波光共羽鳞。\n莼鲈思未得，亦自慰征人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大悲寺与文安诸生小集","author":"卢龙云","text":"野寺当幽处，登临思亦佳。\n暮云方绕室，秋水欲浮阶。\n扫榻呼僧语，凭轩动客怀。\n青衿劳问讯，玄论满萧斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武清隆兴寺僻静可居而门外纡径深泥不便来往","author":"卢龙云","text":"一榻双林里，焚香展道书。\n闭门聊玩世，行路辄愁余。\n僻地尘缘渺，新晴露下初。\n不须惭物役，独坐见真如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和钱使君与大司马王公月下汎舟酌别薛明府","author":"卢龙云","text":"名园开洛社，月下记同游。\n五马鸥相狎，双凫鹢并流。\n池平波影动，星聚夜光浮。\n□有安车诏，追欢复帝州。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十四夜与诸文学对月酌别","author":"卢龙云","text":"砧杵秋将半，新情夜色良。\n举杯同问月，今夕各他乡。\n客里萍踪合，尊中桂子香。\n当歌还进酒，明发思偏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜渡苑家口时月出东方水天一色酷类江南之景","author":"卢龙云","text":"月出波光涌，秋深露气寒。\n观涛心欲壮，击楫道偏难。\n灯火渔家集，帆樯估客欢。\n江南多泽国，此地却同看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王孝廉席上送蒋郡博给假南还","author":"卢龙云","text":"几夜秋声急，催君解缆行。\n莼鲈思正渺，衣马念全轻。\n杯酒还今夕，邮签柰去程。\n相违休道远，南望不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其一 龙山带郭","author":"卢龙云","text":"缭绕城边地，移来海上山。\n峰峦朝暮接，苍翠有无间。\n紫气时环抱，白云长自閒。\n仙踪何处觅，蜡屐好同攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其二 雁塔摩空","author":"卢龙云","text":"阿育留遗胜，千年迹未芜。\n凭虚观始壮，望远势难模。\n霄汉闻钟磬，乾坤入画图。\n锡游飞不尽，登览遍三吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其三 七水横琴","author":"卢龙云","text":"流水知音少，扬澜此地回。\n盈堤多细柳，遇腊有官梅。\n七派潮声入，千厓淑气开。\n雍门今去远，何用使人哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其四 两湖浮镜","author":"卢龙云","text":"玉匣谁开镜，寒光对郭分。\n双涵沧海月，半度具区云。\n钓艇烟笼棹，莲舟绿映裙。\n歌声随处起，偏动旅中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其五 桧坛流月","author":"卢龙云","text":"仙坛嘉树合，世远自齐梁。\n翠盖参天色，清阴碎月光。\n干留孤鹤下，叶抱片云凉。\n直性终无改，灵根谅有常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其六 桃涧飞泉","author":"卢龙云","text":"涧水飞流出，桃花夹岸开。\n穿林疑作雨，喷壑自成雷。\n选胜堪移杖，探幽屡举杯。\n武陵休再入，聊此涤尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其七 破山钟磬","author":"卢龙云","text":"断壁云常补，崩厓路欲迷。\n仙游邀杖屦，客至访伽梨。\n闻磬知莲社，听钟认虎溪。\n禅心如入定，真作絮沾泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其八 瑞石亭台","author":"卢龙云","text":"磐石依山曲，孤根岁月遒。\n台成堪坐啸，亭在可销愁。\n截雨疑犀浦，听箫作凤楼。\n飞仙宁道远，此地足夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其九 绝壁悬门","author":"卢龙云","text":"百丈丹梯迥，乾坤拓此山。\n高疑通帝座，幽可列仙班。\n日月平临照，风云递往还。\n祗应人世外，别自有天关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其十 拂岩回瀑","author":"卢龙云","text":"悬泉千尺下，飞作雪花轻。\n岩挂联珠影，溪鸣碎玉声。\n霏微沾月驭，凌乱洒霓旌。\n并坐翻愁湿，新来谷口莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其十一 玄林鸽井","author":"卢龙云","text":"卓锡何年至，泉流雪乳寒。\n群飞天外羽，几就洞中丹。\n花雨兴龙窟，慈云覆绮阑。\n酌来应觉爽，沆瀣不须餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海虞十二景 其十二 晴海狼崖","author":"卢龙云","text":"大壑容流远，晴天入望多。\n雨馀看玉蝀，浪里出青螺。\n观海元无极，题厓尚可磨。\n鲸波长愿息，击壤听讴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜宁夏报捷二首 其一","author":"卢龙云","text":"六月王师出，三秦虏祸深。\n尚方烦赐剑，死士赴悬金。\n秘法通黄石，先声陨绿林。\n辕门看饮至，庶以答天心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜宁夏报捷二首 其二","author":"卢龙云","text":"骑士皆超距，儒臣亦据鞍。\n城登弓月满，水决阵云寒。\n百二还秦险，威仪复汉官。\n几回看露布，更为里中欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李长庚","author":"卢龙云","text":"问讯丛台月，凭谁作报章。\n交情看剑远，别恨引杯长。\n命驾难千里，怀人祗一方。\n太行休道险，天路识飞黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日得徐二孺书兼承寄长歌一阕赋答二首 其一","author":"卢龙云","text":"喜际春还候，双鱼达素书。\n名因汉高士，诗似魏黄初。\n青眼宁违俗，玄言重起予。\n公车能召对，且莫赋閒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日得徐二孺书兼承寄长歌一阕赋答二首 其二","author":"卢龙云","text":"屈指词坛客，徐卿已白眉。\n三都推作赋，五岳待题诗。\n海上依丛桂，山中问紫芝。\n吴门他日过，载酒若为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发益津留别江应雷二首 其一","author":"卢龙云","text":"试笔当春早，江淹梦若何。\n风云应有合，岁月岂虚过。\n孤愤当年甚，离怀此日多。\n不须传别赋，脉脉对沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发益津留别江应雷二首 其二","author":"卢龙云","text":"旧业馀三径，幽居傍五渠。\n孤山时养鹤，濠濮久观鱼。\n上国多鸳侣，承家有鹭车。\n箕裘看汝在，莫自托樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]