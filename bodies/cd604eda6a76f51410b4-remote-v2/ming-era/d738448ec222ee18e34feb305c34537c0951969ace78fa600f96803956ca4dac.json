"provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫阳书院","author":"徐熥","text":"水自茫茫山自青，荒祠千载寄精灵。\n道人已作黄冠客，不着儒衣拜考亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玄都观寻道士不遇","author":"徐熥","text":"洞门寂寂锁烟霞，此是玄都道士家。\n鸡犬无声丹灶冷，深溪流出碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别虚道人","author":"徐熥","text":"与师分别亦关情，不记形容记姓名。\n闻说还童有真诀，白头人又是前生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀郑君大","author":"徐熥","text":"几人白首困尘氛，垂老看山独有君。\n莫道年高筋力少，芒鞋曾踏一梯云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同元瀚惟秦雨宿舟中怀惟起弟","author":"徐熥","text":"细雨扁舟泊近村，三人同卧亦销魂。\n谁怜此夜孤身客，山店残灯独掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西蜀竹枝词","author":"徐熥","text":"杜鹃啼上海棠枝，赤甲山前月落迟。\n斗帐夜寒春梦醒，笛声吹过竹郎祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮感怀","author":"徐熥","text":"春光将老杏花残，犹自惊心带泪看。\n记得去年今日里，布衣羸马出长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明有感","author":"徐熥","text":"人间春色太无情，不管音容隔死生。\n满地梨花坟上雨，一番零落又清明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊行","author":"徐熥","text":"日暮空林野鸟歌，新坟古冢满山阿。\n不知白骨埋多少，依旧青山四面多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其一","author":"徐熥","text":"青山如黛草萋萋，古寺残钟隔远溪。\n客散长亭天色晚，两行烟柳灞桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其二","author":"徐熥","text":"苍茫绿野接江天，渔父中流独扣舷。\n何处月明堪系缆，树阴西畔小桥边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其三","author":"徐熥","text":"二客来寻草阁幽，况逢邻舍酒新篘。\n主人日暮归来晚，带有青蚨在杖头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其四","author":"徐熥","text":"閒来约客访烟霞，行到桥边日已斜。\n尚隔寺门三五里，且将瓢笠宿山家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其五","author":"徐熥","text":"山中日暮起西风，隔岭霞生石壁红。\n对坐共怜秋色好，数株松影半林枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其六","author":"徐熥","text":"崚嶒孤塔影中流，万顷江天一色秋。\n恍似金山高处望，片帆无数出瓜洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其七","author":"徐熥","text":"兰桨摇摇下急滩，满天风雪正漫漫。\n莫嫌野店村醪薄，消尽深溪一夜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为屠田叔题王玉生山水册 其八","author":"徐熥","text":"千寻瀑布响空林，数尺危桥出树阴。\n欲向溪南访真隐，飞花满路白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"枕上偶成","author":"徐熥","text":"山馆云寒枕簟清，隔窗残月不分明。\n黄莺未醒人先醒，卧听枝头第一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九仙观晚步","author":"徐熥","text":"独携双屐访烟霞，画阁朱阑夕照斜。\n清磬一声山院寂，流莺啼过木棉花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日瀚上人过访","author":"徐熥","text":"绿阴深处响新蝉，移得蒲团柳影边。\n数曲棋残天未暮，更烧山茗结清缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听钱叔达弹琴时叔达将归吴兴","author":"徐熥","text":"竹院微风动晚凉，冰弦花里按宫商。\n凭君莫作思归引，一曲哀声易断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山园杂兴","author":"徐熥","text":"信步荒园日几回，秋风吹老壁间苔。\n浇花正怪儿童懒，忽见松阴片雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜读伯孺诗草","author":"徐熥","text":"空斋寒夜雨声声，细读君诗欲四更。\n十载悲欢灯影里，同游风景最关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日山行","author":"徐熥","text":"行尽空山日未斜，隔林烟火见人家。\n涧边小犊眠衰草，风动满园荞麦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感旧","author":"徐熥","text":"秋光依旧满房栊，镜里铅华渐不同。\n去岁今宵卿忆否，锦衾香煖烛摇红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭林逸人 其一","author":"徐熥","text":"水明楼上看明月，共对冰盘品荔枝。\n今日谱成君不见，年年肠断荔枝时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭林逸人 其二","author":"徐熥","text":"昔年遗我青精饭，药气浮空满箸云。\n风雨空山寒食节，一盂何日荐孤坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭林逸人 其三","author":"徐熥","text":"记得方山昔日游，逢君濑水苦相留。\n从今若过方山路，不忍重维濑水舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭林逸人 其四","author":"徐熥","text":"怜君易箦垂亡日，值我囊书远别秋。\n欲哭灵帏山水隔，空将双泪寄人流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]