[{"title":"山居杂兴 其一","author":"徐熥","text":"雨后空山剥啄无，满阶苔色绣氍毹。\n开门忽讶新痕破，知是双双过鹤雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其二","author":"徐熥","text":"呼童洗砚写黄庭，手自摩挲旧日铭。\n渐露满池鸲鹆眼，犹馀残绣上金星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其三","author":"徐熥","text":"桐阴如盖午风凉，沉水香消白昼长。\n触手残编随意看，一时书卷乱堆床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其四","author":"徐熥","text":"几年心与世缘疏，独有雕虫癖未除。\n赋就一篇诗得意，人来喜向扇头书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其五","author":"徐熥","text":"为耽禅悦久皈依，饭贮山瓢施鸟饥。\n总是道人机事息，近前饮啄不惊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其六","author":"徐熥","text":"林深无数鸟争啼，独立花间自品题。\n毕竟流莺声第一，画楼东畔柳阴西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其七","author":"徐熥","text":"云边松影挂斜阳，上下禽声到竹床。\n半醉半醒开斗帐，微风吹送玉兰香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其八","author":"徐熥","text":"闭却重门竹影疏，日长閒叠架头书。\n放生不守空王戒，故蹴方鞋杀蠹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其九","author":"徐熥","text":"万竿新竹傍檐牙，八面青山一带遮。\n斩却当门三四个，隔云峰影露莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其十","author":"徐熥","text":"一夜霜风叶满庭，黄花三径尽飘零。\n山房不放秋光去，犹折残枝插胆瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其十一","author":"徐熥","text":"新裁斗帐白生绡，百种奇花五色描。\n凤蜡低悬通夜照，有人双度可怜宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其十二","author":"徐熥","text":"金炉残火宿沉擅，万绿阴中拥合欢。\n啼鸟一声秋梦觉，侍儿刚进小龙团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其十三","author":"徐熥","text":"美人蕉下立红裙，磨得玄精满砚云。\n按写江南桃叶曲，指尖香粉印罗纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其十四","author":"徐熥","text":"小词閒制曼声歌，写出春闺幽恨多。\n懒把九宫翻别谱，花间占得忆秦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其十五","author":"徐熥","text":"碧纱窗冷昼常关，丘壑移来枕簟间。\n几上石屏岚翠滴，分明一片点苍山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居杂兴 其十六","author":"徐熥","text":"何事柴门午未开，落花依旧满苍苔。\n只缘欲了分题债，暂禁山童报客来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷发白龙江 其一","author":"徐熥","text":"荷衣草屩竹筇轻，路入丹山谒上清。\n不是离家无别恨，出门先断世间情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷发白龙江 其二","author":"徐熥","text":"五云遥望赤松家，八月同乘碧汉槎。\n自有仙童亲接引，不须沿路问胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷发白龙江 其三","author":"徐熥","text":"尘世蹉跎三十春，欲将云水了閒身。\n清溪无数船来往，能去寻仙有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游武夷发白龙江 其四","author":"徐熥","text":"参驾云中白鹿车，万年宫里荐乾鱼。\n江头有客来相送，不唱离歌唱步虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈振狂拟游武夷舟次渊溪兴尽而返戏嘲 其一","author":"徐熥","text":"自是青山欠夙因，且将踪迹寄红尘。\n幔亭指日重开宴，遍问曾孙少一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈振狂拟游武夷舟次渊溪兴尽而返戏嘲 其二","author":"徐熥","text":"寻仙元不属凡身，空负桃花洞里春。\n岂是渔郎多别恨，玄都只待有缘人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈振狂拟游武夷舟次渊溪兴尽而返戏嘲 其三","author":"徐熥","text":"咫尺仙凡路遂分，悲君犹自恋人群。\n待予九转丹成后，未度他人首度君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈振狂拟游武夷舟次渊溪兴尽而返戏嘲 其四","author":"徐熥","text":"何事尘心未肯灰，寻真中路忽辞回。\n思君不奏宾云曲，只唱人间曲可哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过剑津","author":"徐熥","text":"神物飞腾自有灵，至今风雨带馀腥。\n道人欲唤龙魂醒，再合雌雄铸七星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村中晚步 其一","author":"徐熥","text":"数家茅屋小溪东，衰草寒烟夕照中。\n门掩千峰山犬吠，一篱秋色豆花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村中晚步 其二","author":"徐熥","text":"青山回合抱清溪，村径阴阴鸟自啼。\n落尽疏林秋色晚，水流枫叶过桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀仙馆","author":"徐熥","text":"九曲溪流枕上听，白云遮断数峰青。\n金鸡叫罢山天晓，鹤在松间梦未醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀仙馆忆汝翔熙工伯孺因觅伯孺所画烟雨图不得","author":"徐熥","text":"此地曾闻控鹤来，三人同礼七星台。\n一溪烟雨知何处，满壁丹青翳绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听刘隐虚道人谈玄","author":"徐熥","text":"指挥如意坐云根，总是清虚世外言。\n谈到缤纷花似雨，曾无一语及傍门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠羽士 其一","author":"徐熥","text":"绝壑凌空鸟道悬，竹房松火乱秋烟。\n道人不问丹梯险，禁步青山二十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠羽士 其二","author":"徐熥","text":"竹杖游方几化龙，知君云水本无踪。\n今朝长揖下山去，他日相寻何处峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小桃源呈吴元瀚陈惟秦江仲鱼","author":"徐熥","text":"山转溪回一径斜，半栽桑柘半桃花。\n何年共结茅茨隐，添得人烟三两家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其一 玉女峰","author":"徐熥","text":"五色苔花当绣襦，朝云暮雨锁模糊。\n清溪照出蛾眉影，错认湖中大小姑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其二 架壑船","author":"徐熥","text":"壑里藏舟经几春，溪头何用叹迷津。\n世人自爱风波险，岂是神仙不渡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其三 仙掌峰","author":"徐熥","text":"顶门开处即玄关，白日青天去不还。\n多少幻形俱脱化，独留仙掌在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其四 换骨岩","author":"徐熥","text":"可怜人世似蜉蝣，谁识真还借假脩。\n不学换心求换骨，青山依旧葬骷髅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其五 大王峰","author":"徐熥","text":"危峰苍翠插云中，炉里丹砂色尚红。\n此地大王曾羽化，至今犹自起雄风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其六 徐仙岩","author":"徐熥","text":"碧嶂千寻骨一函，当年曾此脱尘凡。\n重来忽记前身果，笑指飞升旧日岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其七 金鸡洞","author":"徐熥","text":"红尘容易使人迷，流水无情日又西。\n大梦纷纷谁自觉，空劳仙洞报金鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其八 幔亭峰","author":"徐熥","text":"一曲宾云酒一卮，共乘鸾鹤醉归迟。\n至今五色霞千片，犹似当年结彩时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其九 投龙洞","author":"徐熥","text":"空有辉煌玉简书，莫疑云气不重嘘。\n神龙本是飞腾物，肯向千年洞里居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷十咏 其十 虹桥板","author":"徐熥","text":"一从仙乐散丹霄，千载长虹亘未消。\n待得丹成生羽翼，手攀日月过虹桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙曲 其一","author":"徐熥",