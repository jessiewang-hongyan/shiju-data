[{"title":"周恭人悼亡 其二","author":"王世贞","text":"晓案犹闻举，春蚕未罢工。\n泉台人自玉，藜阁管堪彤。\n寂寞鱼轩冷，凄其蕙帐空。\n周郎能顾曲，慎莫唱离鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题兰湖秋色图送王吏部","author":"王世贞","text":"秋浦木兰楫，青云鹓鹭行。\n时人归简要，循吏有辉光。\n水镜元同澈，露桃难共芳。\n芙蓉池上客，谁不向王郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日憩舟嘉树林小饮","author":"王世贞","text":"仲冬好风日，故山嘉树林。\n信履触幽赏，改席就清阴。\n青葱冒霜草，啁唽先候禽。\n人生贵所适，毋为悬别心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答魏允中","author":"王世贞","text":"邮函旦夕至，似汝尺书无。\n眼欲空三辅，心仍折五湖。\n何人充骏骨，念我报骊珠。\n好去连城在，秋风看过都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问华起龙工部","author":"王世贞","text":"生今杜门处，春草故人疏。\n罢读考工记，俱称行秘书。\n毋云计左矣，吾亦赋归欤。\n见说君山色，萧条宦兴如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事呈邢邵二医 其一","author":"王世贞","text":"春朝视膳罢，次第检方书。\n薄宦人皆有，穷愁老自如。\n枕移啼鸟后，杯到落花初。\n况是谈诗懒，无劳客起予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事呈邢邵二医 其二","author":"王世贞","text":"麦雨冷将热，庭花朝自昏。\n渔樵初入耳，鸟雀已窥门。\n不论宦情薄，祇言医道尊。\n年来秫田歉，为尔罄芳樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答王礼部言卿","author":"王世贞","text":"礼乐逢昭代，文章属盛年。\n名从赤县得，官向紫微迁。\n倚玉怜余弟，投珠念汝贤。\n春卿古芳署，应许和歌传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"璩敏仲见访作","author":"王世贞","text":"词客不寂寞，到来令坐惊。\n今朝下悬榻，强半为璩生。\n笑语纵横进，图书次第评。\n此中殊有味，何必傍时名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予分部吴兴日圆上人住弁山了不相闻既迁晋臬归里请告未遂上人忽锡杖肩笠以一诗见投且致郡人之思谈禅竟日倏尔告往遂成二章送之 其一","author":"王世贞","text":"抱病日悠哉，衡门雨渐苔。\n乍传飞锡下，仍以施珠来。\n护法吾何敢，逃禅酒自咍。\n相闻岘山社，翻为远公开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予分部吴兴日圆上人住弁山了不相闻既迁晋臬归里请告未遂上人忽锡杖肩笠以一诗见投且致郡人之思谈禅竟日倏尔告往遂成二章送之 其二","author":"王世贞","text":"道汝弁山住，弁山无汝踪。\n念予托一钵，挥手谢诸峰。\n小果聊遗爱，空花是旧逢。\n乾坤大檀越，到处好从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王山人","author":"王世贞","text":"五岳游欲遍，归来鬓尚玄。\n藏名诗句后，避世酒杯前。\n久客乡音改，无家旅兴偏。\n翛然唤双屐，挥手向江烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写怀寄舍弟 其一","author":"王世贞","text":"除书何足问，已自乞归耕。\n不必山公启，俱先海内名。\n鼓鼙秋转急，幕府岁仍更。\n赖有疏慵在，犹堪寄此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写怀寄舍弟 其二","author":"王世贞","text":"休沐无它事，清狂为尔陈。\n身将数酒伴，名挂一诗人。\n物意安吾拙，时才捷有神。\n不知投老计，何日定为真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周君自大官令出太仆辽左飘然挂冠今年五十矣而颜尚童其婿一龙余从子也乞诗为寿 其一","author":"王世贞","text":"我爱周郎美，雅如王子猷。\n官閒骑曹马，兴尽剡溪舟。\n坐客中清圣，园租比素侯。\n白狼河畔雪，知不上君头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周君自大官令出太仆辽左飘然挂冠今年五十矣而颜尚童其婿一龙余从子也乞诗为寿 其二","author":"王世贞","text":"少日佳公子，中年贤大夫。\n自回司仆驭，祇忆步兵厨。\n入坐峰峰玉，挥毫字字珠。\n龟貂未全敝，时付酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将之晋任离家有感","author":"王世贞","text":"自缘休沐久，安作里中人。\n强起从时意，迟留惜此身。\n舟凌荷芰发，门掩薜萝新。\n无那尊前客，晨星个个沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京口别送者","author":"王世贞","text":"抛君江口棹，尽我手中卮。\n垂老本难别，欲归翻狎离。\n转头吴地近，抗手晋山迟。\n岂必耽微禄，浮生本未期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过滁州邵少参","author":"王世贞","text":"过君驷马里，逢君五马还。\n乍看仍似梦，稍定各开颜。\n白葛凉从进，清尊别任攀。\n环滁众峰色，彷佛越中山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途次赠孙尚宝鑨时以千秋入贺","author":"王世贞","text":"汝自舆司马，忧时涕泪悬。\n宸枫九地隔，疏草万人传。\n天意存孤直，臣心转更坚。\n承华一箴在，知不愧先贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈太仆参政蜀省","author":"王世贞","text":"久宦无前辈，推迁自至公。\n空群辞蓟北，叱驭指褒中。\n益部星初动，并门险对雄。\n还将在駉绩，一颂拟清风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜从侍御饶公登明远楼二首 其一","author":"王世贞","text":"今夜中秋月，浮云袅自横。\n未添三晋瑩，只避五星明。\n小坐杯频转，清言烛屡更。\n霜威暂时失，桃李欲敷荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜从侍御饶公登明远楼二首 其二","author":"王世贞","text":"黯澹千山暮，凭阑首重回。\n虹争汾水上，云拥太行来。\n渐老惊先达，多艰急异才。\n今宵迟月色，须为绣衣开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邀李袁二使君小饮","author":"王世贞","text":"忽忽秋将暮，悠悠欲傍谁。\n无才薪自积，有禄桂从炊。\n贪作传杯过，数为同舍期。\n南冠笑相拭，莫使晋人疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入谒晋邸陈常侍要饮别墅作 其一","author":"王世贞","text":"别殿沾恩罢，逢迎有大珰。\n自云东第好，只在小山傍。\n曙月侵金酎，流云断粉行。\n为传趋府近，促拍按飞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入谒晋邸陈常侍要饮别墅作 其二","author":"王世贞","text":"河东张特进，老不爱人扶。\n圃为延宾学，尊从罢直呼。\n食单黄颔臛，酒味紫酡酥。\n取适须臾事，沈冥即我徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再从诸公饮陈常侍别墅 其一","author":"王世贞","text":"小割虒祁地，聊为梓泽园。\n杯从三雅贵，客有八公尊。\n膝席宽宾礼，牙盘侈国恩。\n犹言朱邸俗，揖向栋花村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再从诸公饮陈常侍别墅 其二","author":"王世贞","text":"偶尔朋簪盍，仍劳倒屣迎。\n斗茶中贵好，赐醴主君情。\n果取非时味，花多别创名。\n不论休沐否，省事晓来清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋中得亡妾信志感 其一","author":"王世贞","text":"歌鹿初停奏，来鸿已叹离。\n一棺谁傍汝，两口别称儿。\n拭泪偷潜滴，关心忍自支。\n丈夫多意气，元不为蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋中得亡妾信志感 其二","author":"王世贞","text":"苦忆登车日，双眸强暂回。\n已真成死别，翻更怯书来。\n玉箸难收恨，朱丝未作灰。\n和家后园李，子好令枝摧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋中得亡妾信志感 其三","author":"王世贞","text":"我更三千里，儿骄女又痴。\n最怜垂命别，谁作有情悲。\n旧幌教凉住，空箱傍夜移。\n戢身无寸土，西閤已先辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋中得亡妾信志感 其四","author":"王世贞","text":"十八年中事，居然一梦非。\n未论调瑟好，所悯抱衾稀。\n强粥供啼乳，篝灯问缉衣。\n辛勤意何限，脉脉付斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归路写闷 其一","author":"王世贞","text":"夜半呼厨饭，欲餐还不能。\n路危心转迫，天远足无凭。\n已觉仍疑梦，无言忽自应。\n遥传伏枕在，知复倚门曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归路写闷 其二","author":"王世贞","text":"因过长子县，愈重老亲思。\n路任羊肠险，书嗔雁足迟。\n往来山色异，迎送物情疑。\n不那三千里，长萦方寸丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻台抨不行有感 其一","author":"王世贞","text":"纵令宽谪籍，岂敢问朝班。\n雨雪人回首，春风自掩关。\n穷途出处外，垂老是非间。\n爱此浮云色，翛然逝不还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻台抨不行有感 其二","author":"王世贞","text":"当时诤臣论，夫岂谤书函。\n执政宽相假，流言转自惭。\n本应呼第五，不合受朝三。\n遂我初衣后，秋风农圃谙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢华婿饷紫檀梳匣","author":"王世贞","text":"吴刚月中树，斲作紫琼箱。\n得借卫郎润，长沾荀令香。\n寒暄奉巾栉，早晚见行藏。\n投老缁衣日，毋言弃置伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠温州周生才甫","author":"王世贞","text":"籍甚诗篇美，飘然步屧过。\n停杯顾误曲，弹铗出悲歌。\n客礼龙门重，乡心雁荡多。\n永嘉风物好，其奈壮游何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新安汪惟一徐使君子与门人也以尝侍李于鳞先生刻其白雪楼集赋二章赠之 其一","author":"王世贞","text":"客有儒中侠，人怜身后名。\n言从徐孺子，得尚济南生。\n山水存遗操，冰霜问旧盟。\n莫将青凤翮，到处觅兼城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新安汪惟一徐使君子与门人也以尝侍李于鳞先生刻其白雪楼集赋二章赠之 其二","author":"王世贞","text":"识汝沾沾意，曾因御李君。\n死犹能借客，生可罢论文。\n附骥吾何有，登龙世所闻。\n祇应今夜月，鹤背怅离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠白云上人","author":"王世贞","text":"爱汝白云色，萧萧佛日间。\n有时归法钵，无意卧禅关。\n生灭了何碍，卷舒长自閒。\n寻常足避世，莫买沃洲山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为曹比部送长洲张令入佐比部郎 其一","author":"王世贞","text":"我爱张平子，贤声众不如。\n棠阴过夏茂，凫影入秋舒。\n已制吴门锦，还司城旦书。\n曹丘能念旧，不惜重吹嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为曹比部送长洲张令入佐比部郎 其二","author":"王世贞","text":"列宿徵书重，干夫拥旆迟。\n令君青雀舫，仙吏白云司。\n汉法霜同峻，吴郊雨自私。\n虔刀吾旧佩，脱赠为明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈母挽章","author":"王世贞","text":"范子成公父，宜家是伯鸾。\n闺中新凤诏，机畔旧熊丸。\n慈竹吴江冷，啼魂蜀道难。\n欲挥彤管述，心折泪仍残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病后程子访我园居小饮作","author":"王世贞","text":"起色缘君动，衔杯转自真。\n材高聊玩世，年少不窥人。\n池草诗情晚，岩花酒态新。\n即论吾党外，谁不傍风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答徐文果","author":"王世贞","text":"自失而翁后，风流思不胜。\n绝怜徐孺子，时及柳吴兴。\n天目寒逾峻，湖心雨自曾。\n菰芦最深处，鳞素一堪凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁王君用章既去昆山为客部副郎邑人俞仲蔚集古语为八咏饯行要余与家弟和之各得四首毋论其辞之当与否而感德怀贤要自不异也 其一 威凤栖梧桐","author":"王世贞","text":"圣时不虚瑞，有凤下高桐。\n含苞媚朝日，鸣律和春风。\n揽德辉何晚，将雏曲未空。\n俱言阿阁贵，非仍枳棘丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁王君用章既去昆山为客部副郎邑人俞仲蔚集古语为八咏饯行要余与家弟和之各得四首毋论其辞之当与否而感德怀贤要自不异也 其二 桂楫汎河中","author":"王世贞","text":"汴水似天河，星查暂一过。\n鸣鼍彻遥汉，飞鹢凌清波。\n洛客思归引，吴侬于蔿歌。\n不取支机石，其如压载何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁王君用章既去昆山为客部副郎邑人俞仲蔚集古语为八咏饯行要余与家弟和之各得四首毋论其辞之当与否而感德怀贤要自不异也 其三 处处春云生","author":"王世贞","text":"春云处处生，蔼蔼复盈盈。\n恍如飞盖落，忽与去帆平。\n泄彩迎回照，乘虚薄太清。\n惠休无怨别，早晚丽神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁王君用章既去昆山为客部副郎邑人俞仲蔚集古语为八咏饯行要余与家弟和之各得四首毋论其辞之当与否而感德怀贤要自不异也 其四 轩盖照墟落","author":"王世贞","text":"半刺威仪重，典客声名高。\n徵贤下梁榻，问俗见干旄。\n翠舄晨双去，瑶琴夜一操。\n祇应今仲蔚，穷巷又蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽杨都督尚英四首 其一","author":"王世贞","text":"剑佩先辞汉，楼船旧姓杨。\n一归肝胆赤，百感鬓毛苍。\n客与金俱散，弓将鸟共藏。\n西州华屋地，何处不堪荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽杨都督尚英四首 其二","author":"王世贞","text":"垄树萦幽旐，江城咽暮笳。\n风摧大将树，霜剥故侯瓜。\n越甲初滋藓，吴钩不吐花。\n一贫应莫叹，去病肯为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽杨都督尚英四首 其三","author":"王世贞","text":"双挽角弓强，横行铁裲裆。\n虬髯将施草，猿臂已生杨。\n病诧千金骨，恩留一寸肠。\n祇应誇毕万，终觉少冯唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽杨都督尚英四首 其四","author":"王世贞","text":"鲸海氛谁扫，麟台迹尚存。\n生教仆射宅，入作奉诚园。\n势去通侯冷，时平醉尉尊。\n山阳夜中笛，不听已消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄翁少司马","author":"王世贞","text":"三持直指节，两拜夏官卿。\n身力从君父，行藏有重轻。\n尽抛封赏去，不减孝廉名。\n祇恐干星象，羊裘隐未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈司训迁高邮","author":"王世贞","text":"不断江南北，春风桃李香。\n珠还收甓社，剑已铸干将。\n少郁冲星色，仍开照夜光。\n儒官到自好，何必去游梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李时养授室","author":"王世贞","text":"那输谢傅墅，聊具戴生装。\n白几供棋隐，青衣控酒狂。\n稍宽怀土切，莫怯受恩长。\n但使比邻健，过从日不妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食","author":"王世贞","text":"故人日以故，新冢岁行新。\n自惜无涯智，翻随有限身。\n落花寒食节，芳草旧园春。\n任是风光好，那无泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐子与之闽宪 其一","author":"王世贞","text":"踪迹乾坤满，行藏岁月深。\n一官初汝报，双鬓莫愁侵。\n霜色帷从动，星文剑可寻。\n嵯峨鳌顶上，时复快披襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐子与之闽宪 其二","author":"王世贞","text":"一马骢仍健，当年五马才。\n水怜丁字旧，人喜细侯来。\n鳄徙闽天雨，虹摅粤海雷。\n弹冠岂吾意，把袂独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄穆考功兼简石给事 其一","author":"王世贞","text":"穆生醴酒薄，邴氏宦情微。\n人昔冰壶是，官今水镜非。\n风云千态出，天地一身归。\n予亦穷途客，因之赋采薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄穆考功兼简石给事 其二","author":"王世贞","text":"物意毋深叹，君今试自看。\n枕高归卧易，钩直钓奇难。\n漳水鲂时上，淇园竹渐竿。\n有书堪送日，何必问弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄穆考功兼简石给事 其三","author":"王世贞","text":"故人有羊角，一疏忤龙鳞。\n生死交情在，行藏世事频。\n还将孤愤意，俱付耦耕人。\n倘遇栖栖者，春风指问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄穆考功兼简石给事 其四","author":"王世贞","text":"闻君读书处，乃在清漳源。\n小尔新蓬径，居然故漆园。\n暗芳书草发，空翠墨花翻。\n若语逍遥意，宁将出处论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄郜侍御郜时以按鹾山西有所论劾不合移疾归魏 其一","author":"王世贞","text":"一去宁因疾，孤臣敢爱身。\n年华开对卷，风采出埋轮。\n竹写淇园雨，花明澶苑春。\n还将独行意，解作倦游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄郜侍御郜时以按鹾山西有所论劾不合移疾归魏 其二","author":"王世贞","text":"休沐知何意，浮云万事停。\n心悬魏阙紫，泽满舜都青。\n懒不谈鹾算，醒难颂酒经。\n唯应杜门处，玄思入沈冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]