[{"title":"宪伯祝公野芳亭留咏","author":"傅汝舟","text":"越北开戎馆，清时寡牒书。\n榻含千竹净，亭落万峰疏。\n聚石攒奇草，联园匝野蔬。\n自公多逸暇，跃马亦林居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长至吴山中","author":"傅汝舟","text":"至日山雨过，眼中浮埃空。\n偶来沧海客，独醉紫霄宫。\n江色了人意，鹤群消晚风。\n岁时兴自好，云物任西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"亭会","author":"傅汝舟","text":"亭子临苍壁，高檐覆草菅。\n我来乘白鹿，蹴踏万花间。\n赤日避林幄，青芝抱竹关。\n飞扬剑歌在，酩酊散秋颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汎舟重经青原","author":"傅汝舟","text":"祖关冬再入，客路日多閒。\n崖色斜移树，泉声半出山。\n拂人黄叶过，穿竹白云还。\n不惜芳华晚，风霜且炼颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沙庄晚步","author":"傅汝舟","text":"晡景阁崇壕，还云泥羽袍。\n沙游仙迹横，秋捧雁行高。\n弗雨加天翠，微风亦海涛。\n密都曾窃觐，讵岂梦颁桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太安中秋","author":"傅汝舟","text":"迢迢三五夕，遑遑岐路前。\n入夜何用雨，出门不同天。\n云逗千林树，溪留百涧泉。\n自然念兄弟，况复仰神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过陈生山庄","author":"傅汝舟","text":"高言无与晤，㩦兴陟幽庄。\n燕泥纷上壁，蚕叶半垂筐。\n暖池鱼弄荇，晴坂草吞霜。\n欲奏思乡曲，关山绕夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访子发道中","author":"傅汝舟","text":"攀山辞玉笥，辍浦问珠林。\n四村流水暗，三月落花深。\n岭晦行云气，沙明止岸阴。\n所思若下士，被发正鸣琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日青原山作","author":"傅汝舟","text":"秋物祇林浅，禅阶古石平。\n香台七祖塔，法树十围荆。\n杖飞犹置井，山匝似为城。\n即此未遑息，徒令岩壑轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日集独髻山","author":"傅汝舟","text":"九日复九日，久客畏高临。\n云使乡心近，江承秋气深。\n杂花难似菊，孤雁不随禽。\n非君重节物，谁肯到松林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿张子湖堂","author":"傅汝舟","text":"别海迷回驾，依湖狎隐堂。\n玉枕冲朝采，珠灯汎夜光。\n款言霞上尽，投兴雪中长。\n还应艺松桂，同嗣大年芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"关山月","author":"傅汝舟","text":"白兔天边月，黄龙戍外城。\n蟠蛇明扎阵，哨马照归营。\n镜破佳期阻，轮圆虏命倾。\n丈夫取报国，莫念妾身轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访梅山","author":"傅汝舟","text":"隐吏烧丹地，飞楼灿碧峰。\n锦叶妆隋瓦，瑶阶起汉松。\n泉香经药洗，虎善与仙逢。\n探历未云毕，高城发暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上","author":"傅汝舟","text":"缆带水中苔，船从树里催。\n草声听岸过，沙色辨风回。\n洲土长崩屋，村山或起台。\n无论下与上，俱是离家来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏","author":"傅汝舟","text":"风炎蒸尽急，渚枉逗舟逶。\n僻岸无凉草，丛松有避枝。\n俜童载叶记，幼妇汲泉思。\n往迹兼今意，临觞首自欹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苏州逢黄子北归序","author":"傅汝舟","text":"吴门一夜对银缸，别后思前在异邦。\n国事野人那得问，烟波孤兴若为降。\n梅福变名会有意，黄香隔世又无双。\n何以故山恋初服，或因青桂待书窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶述","author":"傅汝舟","text":"山翁遁世有真癖，十年啸傲林之峦。\n惯栽薜荔护老屋，閒拾鹤羽为高冠。\n异书自得作者意，长剑不借时人看。\n市南熊僚久巳死，谁共白日谈弄丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"姜侯携酒过资寿寺中","author":"傅汝舟","text":"三年不到娱溪上，千里相逢沧海间。\n入寺杯盘留夜月，出城车马动秋山。\n松阴密傍星河转，鹤影低随灯火还。\n野客明时甘老去，劝君青鬓莫投閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"于瑞岩夜怀","author":"傅汝舟","text":"名岩不受炎天暑，折磴宵穿星汉连。\n亭上就云眠乱石，竹閒乘月享清泉。\n幽栖转觉风尘苦，僻性犹烦猿鹤怜。\n久办此身行脱屣，肯抛龙剑负飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟筑宛在堂奉招石门隐君","author":"傅汝舟","text":"城外西湖烟雾光，孤山宛在水中央。\n门开独树悬青磴，径绕千花上碧堂。\n兰艇桂桡操自稳，药房荷榻卧偏长。\n秋波不隔寻真路，乘兴须君到隐乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"堂成敬酬丰五溪学士之作","author":"傅汝舟","text":"卜居祇卜沧浪天，况复四山如几筵。\n城南茅屋弃汝去，岛上薜门行自专。\n钓鱼有客寄尺素，骑鹤笑予无一钱。\n短琴若果访他日，凉月相将看满川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"敬从汪郡公登屴崱峰值雨驻小顶还纪兴","author":"傅汝舟","text":"天入翠宫低窈窕，洞回沧海倒巃嵷。\n山林著处宜狂客，风雨閒游接上公。\n共倚短筇千涧底，独穿高木万烟中。\n观涛更许云边酒，待月思眠石上枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天游观即事呈同游","author":"傅汝舟","text":"众壁群峰夹路生，百花千竹引人行。\n螟虫餐叶声疑雨，涧碓翻泉响似更。\n春在客中偏易暮，世于方外亦难轻。\n因思少小瑶华洞，零落他山空复情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中丞南涧林公息机亭留宴","author":"傅汝舟","text":"日月衡门静，烟霞涧水寒。\n坐呼花鸟使，笑整薜萝冠。\n桁上悬鱼笱，桥边卧鹿鞍。\n野塘生杕杜，秋井长猗兰。\n秖作藏身惯，宁谈避客难。\n鸳鸯辞锦□，□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潘令夜半过访武夷欲予主观事戏答","author":"傅汝舟","text":"峰回壁转闭岩扃，永夜逢君剖玉经。\n黄发戴冠非我事，青天自有少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜国贤病起嘲之","author":"傅汝舟","text":"吾兄久抱烟霞病，七日山中斸药泉。\n起坐休贪水帘洞，兴回犹胜剡溪船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"面泉赠龙鲁之","author":"傅汝楫","text":"??云中泉，流沫一何多。\n回飙空夕景，近壁摇烟萝。\n盈虚有至理，古今无增波。\n损德必在足，损名必在高。\n谦谦君子心，面兹终岩阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"栖霞携酒观音溪避暑同用霞字","author":"傅汝楫","text":"溽暑那可避，言寻溪上花。\n逢人坐流水，不见泛胡麻。\n芝席移青嶂，冰盘荐紫霞。\n郭仙如可问，吾意浴丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘郎","author":"傅汝楫","text":"刘郎刘郎，女今三十自造命，身如削玉眼转镜。\n玄都种桃笑彼花，天台采药留芳径。\n散发冠高黄竹冠，山中早筑礼星坛。\n著成鸿宝云边卧，养得蟾蜍月下看。\n云边月下长回首，欲观瑶光过北斗。\n肘后丹经鸾凤翩，腰间宝剑蛟龙吼。\n我本箕躔一酒星，乞住人间五百龄。\n君若骖鸾归玉阙，莫言吾醉与君醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得闽海亨龙送邓介夫应贡北上","author":"傅汝楫","text":"金晶飞飞射龙屋，骊龙屋下眼珠熟。\n五雷惊散云作花，捧出明珠献天族。\n云归君别君犹龙，下天上天云相从。\n暗室投珠十载忌，寒潭化剑今朝逢。\n何人却笑渊潜者，相送残春江上峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武夷傲吏行赠潘勉甫","author":"傅汝楫","text":"君本罗浮列仙侣，武夷此日悬鱼组。\n傲世长回俗吏风，高谈莫作时人语。\n日得俸钱思买山，烟花九曲流春还。\n题诗直欲满青壁，搜奇随处携黄冠。\n夜卧孤琴足知己，秋风落叶凄闽邸。\n强项多时向长官，折腰远地依山水。\n世人相马失骅骝，怜君畏路仍淹留。\n诗书满腹祇自爱，礼乐为邑谁从周。\n只今达人多返古，如此与众应无伍。\n空惊远思歌凤凰，却用豪才赋鹦鹉。\n报国心悬百里劳，种桃满县红云高。\n他时吏隐金门里，偷实须君寄我曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"槦南行赠周子","author":"傅汝楫","text":"君不见槦哉南之植衣踰北，受性独异非自封。\n冰霜少到福地厚，蜒蜿始称根蛟龙。\n华叶碍风天不冬，远势干霄云避踪。\n身枝十抱肿而野，一回匠石一回舍。\n邓木相邀何有乡，商樗许结虚无社。\n周子屋角槦弗低，心日爱槦槦讵知。\n深苍窃比巢居子，散漫宁同木食儿。\n处世于人尽青眼，近能爱画烟云满。\n盐梅予后筑岩人，逢君尽日倾杯盌。\n君不闻三楚今输廊庙材，千山斤斧关风雷。\n架桥小木斫伐尽，大木翻从天上来。\n尚方律令急如火，同知缚住通判锁。\n何如散木之下与君饮美酒同醉倒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王文旭游海门","author":"傅汝楫","text":"长风吹岊水，客送大江秋。\n笑蹑飞凫舄，长穿控鹤楼。\n弟兄堪友爱，天地重交脩。\n渺渺沧洲去，终牵离恨流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夕园居有怀","author":"傅汝楫","text":"流光元夕到，春事半园居。\n映月花还嫩，随风柳未舒。\n枕欹招隐赋，笔阁绝交书。\n怅望烟霞外，何时返鹿车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岊湖","author":"傅汝楫","text":"湖堂背郭楼，湖水日悠悠。\n地即香莲界，山仍梅树秋。\n杯前狎鸥鸟，篱畔系渔舟。\n安稳风波外，吾生乐未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李指挥之京","author":"傅汝楫","text":"江干相送罢，去去望仙舟。\n不耐云山杳，其如岛树秋。\n龙颜欢谒帝，燕颔定封侯。\n他日收成绩，归来觅酒俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王甥春先省亲之琼州","author":"傅汝楫","text":"子往宁亲日，予惭得婿初。\n酒杯三接后，衣剑百愁馀。\n庾岭迟梅使，琼山少雁书。\n蛮方慎眠食，应足慰离居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得林时弼书","author":"傅汝楫","text":"月下飞天镜，影虚明角巾。\n故山看正好，秋况近高旻。\n白雁霜前下，黄花节后新。\n怀人天汉外，独寄一行音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬高成甫","author":"傅汝楫","text":"迩来高伯子，衰病复何如。\n药圃苦留价，文园漫著书。\n日眠花阁暗，风避草堂虚。\n未说长生诀，千金爱女躯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"匡惠先大夫","author":"傅汝楫","text":"肺病忧勤积，明时为政初。\n楚冈留竹虎，燕水泣银鱼。\n臣得终王事，儿惭读父书。\n回思弘化地，伽木正扶疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山居","author":"傅汝楫","text":"用世无中策，青山岂愿违。\n门开扬子宅，井息汉阴机。\n菰米秋田食，天蚕卒岁衣。\n閒垂一溪钓，呼酒换鱼肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日拜先垄追感寄丁戊伯兄","author":"傅汝楫","text":"四年违骨肉，五十到头颅。\n老至亲朋阔，年荒涕泪馀。\n生存幸儿女，丘垄暗楸梧。\n回首云中雁，飞飞影不孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冲天台对月次呈高宗吕三十一","author":"傅汝楫","text":"登台孤笑怀良友，江月于人色转清。\n坐懒诗篇虚岁月，交深山水识吾生。\n光垂露叶疏疏见，寒近星河曲曲明。\n为爱一樽长对此，风尘物色总浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30249,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"招隐","author":"傅汝楫","text":"极目秋山烟雾连，社钟村鼓自堪怜。\n行藏未梦商岩卜，既隐空存绵上田。\n日短风云终一变，家随麋鹿故三迁。\n藜羹可信狂奴足，高卧何心学草玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30250,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"聚月翠亭追感昔游用韵","author":"傅汝楫","text":"坐满高台虚月凉，万松风合石楼当。\n野人卧酒翻荷爵，山鬼缝衣傍荔墙。\n李贺凤悲贤者死，郑庄麟泣大夫良。\n冥冥夜色双鸿远，影落遥天声渐长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30251,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潘子积中将游白下索诗作此贻之","author":"傅汝楫","text":"汗漫潘郎赋大游，烟花三月动轻舟。\n腰缠不控扬州鹤，机息初回海上鸥。\n远地芝云劳得梦，高名冠盖定相求。\n白门见柳如堪折，迟尔沧洲觅钓俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30252,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋怀丁戊伯兄","author":"傅汝楫","text":"闭门坐月月未平，露下高歌银汉横。\n衣上桂花时自落，池边秋草梦还生。\n即看仙犬苍云幻，远度宾鸿紫塞轻。\n闻说海边招士榻，尚贤今喜得吾兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30253,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四山往教河阳留宿草堂赋此赠别","author":"傅汝楫","text":"桃树当窗隐小楼，草堂与子坐绸缪。\n经年一见一回别，为我三杯三日留。\n歌舞有人怀绛帐，琴书此去重仙舟。\n无闻白发惭知己，莫舍诗篇慰远愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30254,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再送四山至越台兼讯河阳二黄子","author":"傅汝楫","text":"舟楫春风桃李溪，送君晴日越台西。\n忍闻求友啼莺合，喜见留人芳草齐。\n积学郑玄非句读，传经刘向岂筌蹄。\n河阳幽事遥相报，门外垂杨几处低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30255,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀丁戊伯兄","author":"傅汝楫","text":"巾舄飘飘五岳游，庭前双鹊噪无休。\n桥成闻汝天边返，槎到何因汉上留。\n走日定巢欢玉树，喜人传信笑金瓯。\n归期拟醉东篱下，犹及香风一夜秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30256,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梨葡萄","author":"傅汝楫","text":"鸟惊午睡浓，起坐林花近。\n渴思谷口浆，醉唤梁州酝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30257,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白头翁","author":"傅汝楫","text":"海上春常满，人间日易斜。\n白头浑不老，岁岁阅桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30258,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访梅金粟阻雨","author":"傅汝楫","text":"梅依鹤膝自盘拿，石壁天风一一花。\n索笑未开尘上眼，结人愁雨半山斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30259,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏柬林子裘","author":"傅汝楫","text":"荒年卜筑正愁予，欲傍渔翁饱食鱼。\n贫病不关时事恶，西湖久断鹤来书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30260,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别张治世往严州","author":"傅汝楫","text":"钓龙早罢珊瑚竿，台下长流烟水寒。\n便欲乘槎访牛女，客星遥过五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30261,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野亭吟","author":"傅汝楫","text":"野翁抱瓮甘息机，懒梦山蕉无是非。\n独向山中伴麋鹿，白云时傍野亭飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30262,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"醉渔","author":"傅汝楫","text":"烟轻江上钓初回，呼伴携鱼换酒杯。\n便欲忘言醉芦苇，独醒恐有楚臣来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30263,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄嘲沙源","author":"傅汝楫","text":"寄语沙阳黄子正，如何不棹酒船来。\n碧筒五月多凉冷，梦在栟梧寺里回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30264,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠徐子仁","author":"文彭","text":"金陵帝王居，佳气郁以苍。\n幽人无外慕，遁迹含其章。\n结庐城之南，谢喧聊尚羊。\n鸟鸣青松下，麈挥白门傍。\n芳兰转光风，蕙帐霏芸香。\n纤鳞时泳跃，翠羽恣翱翔。\n对此忘利达，目澹心弥良。\n身逢明盛时，雅志差岩廊。\n默坐草太玄，高卧同羲皇。\n朗咏太冲篇，远慕淮南王。\n至理已云得，寿考日以强。\n逍遥尘寰中，此乐殊未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30265,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仲春履吉与之永之小集得草字","author":"文彭","text":"二月集嘉宾，骀荡春光早。\n白日堕游丝，黄鸟鸣声好。\n玄言互剖析，至理穷探讨。\n觥筹杂笑欢，高怀自倾倒。\n落霞尚迟留，初月出杲杲。\n虽无陈遵投，亦有魏公扫。\n相期终南山，去拾金光草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30266,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍顾华玉丈上方玩月","author":"文彭","text":"晨策入石湖，落景憩上方。\n上方连巘崿，叠嶂通河梁。\n窈窕入深谷，崎嵚陟崇冈。\n秋深气萧瑟，云薄天苍凉。\n万木振长风，群卉彫严霜。\n遐观谐夙心，周览穷八荒。\n径仄步逶迤，崖倾身低昂。\n缘葛采石华，扪萝拾兰芳。\n矫首睇飞鸿，俯视空微茫。\n皇皇殿阁森，霏霏蔼雾黄。\n望望皓首白，耿耿银河光。\n坐久凉飔集，泫露沾衣裳。\n佳会合章缝，友朋亦孔良。\n绿醑何淋漓，各举浮白觞。\n自怜肮脏骨，零落同高阳。\n邂逅山公醉，容我祢衡狂。\n山水能娱人，为乐殊未央。\n夜静心益閒，天籁杂鸣螀。\n安得孙登徒，长啸和鸾皇。\n何如王子晋，缑山吹笙簧。\n怀哉鸱夷子，功成谢岩廊。\n眷言仰前脩，千载永相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30267,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石子冈望江","author":"文彭","text":"长江望不极，划然射双眸。\n风帆迅飞鸟，却逐东逝流。\n落霞照寒影，爽气生清秋。\n羁怀三十日，何如此日游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30268,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"茅山","author":"文彭","text":"盘回绕山足，望望山之椒。\n丹厓出殿角，落日风萧萧。\n时闻金磬声，还向空中飘。\n阒寂无来踪，虑澹尘弥消。\n閒庭候月出，长松生夜涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30269,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]