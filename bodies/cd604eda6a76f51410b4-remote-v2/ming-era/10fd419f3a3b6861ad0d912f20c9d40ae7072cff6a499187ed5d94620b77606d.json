[{"title":"十八滩","author":"释今无","text":"岩巉石脚水痕乾，咫尺危锋碎不难。\n轻点似添无力棹，乱流竟作有情澜。\n客程处处俱藏险，身累年年只未安。\n欲剪鬓丝消愤闷，五更衣帽斗人寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万安道中","author":"释今无","text":"黄菊芳菲雁已过，山城吹笛引悲歌。\n十年苦累空成梦，万里投人更若何。\n露宿白鸥霜月冷，村藏红树锦云多。\n久将幻境同儿戏，一任前缘佛与魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠萧孟舫","author":"释今无","text":"看君声价重南州，况有名园可胜游。\n共订舣舟寻石户，知能扫径纳诸侯。\n冬青万树藏仙鸟，暮赤千楹敝画楼。\n近刊太平书就否，交情终拟久淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠胡敬济","author":"释今无","text":"灵光尚忆十年前，相见翛然别有天。\n我愧谈经如滞絮，君能饮露似秋蝉。\n胸中不用江波涤，眼底能窥岳色全。\n便是自家清净土，何须骑鹤逐飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出凤阳界","author":"释今无","text":"马头堕月马蹄风，百计消磨一梦中。\n独树鹊鸣疑着意，远烟人去似行空。\n身同浮世名难就，心忆灵文愿未穷。\n不学文鸾栖碧树，却惭紫柏与苍松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过桃城","author":"释今无","text":"策疲薄暮到桃城，又是南来一日程。\n只见身寒知絮薄，忽然梦醒是驴鸣。\n酒旗未易沾行色，夜月偏宜照此情。\n那似长安骑马客，风尘虽浊意尤清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峄山下作","author":"释今无","text":"尽将世界作波涛，身似轻轻一叶舠。\n城角有情吹晓月，马蹄无力踏残蒿。\n朝烟带雨看难见，夜梦还乡不厌劳。\n可笑此中消未得，陇云高亦未曾高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"章桥遇雪","author":"释今无","text":"粉作山河玉作亭，毡衫湿透欲成冰。\n尝疑海市光难似，却过章桥落未停。\n青映乡关长见树，白连天地不藏僧。\n北风一阵吹还起，鸾鹤烟霞梦未醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏赠掌鞭","author":"释今无","text":"披羊裹脚养驴骡，不用挥鞭只用呵。\n阿母垆头投意熟，王孙腰内取钱多。\n陆龙早困耽名客，雪地长为安乐窝。\n闻道神凝在姑射，若经风雨不如他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪","author":"释今无","text":"六出寒花掩路尘，飞空扑面最相亲。\n石桥晒日疑归夜，朔气侵肌已损神。\n草木光浮新世界，须眉白尽老成人。\n泰阶已见平如砥，更报丰年入好春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高唐道中","author":"释今无","text":"提鞭无力自行迟，亦为寒霜亦为诗。\n觅句喜当晴雪际，受风多在渡河时。\n十年讲席心魂懒，万里残冬客路疲。\n谁扫绿萝云外屋，却怜吾道苦驱驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入茌平","author":"释今无","text":"初日晴明午夜阴，辛勤苦乐在天心。\n霜珠欲结先行雨，薄面旋融直到襟。\n路鬼易欺形已瘦，马蹄愁滑路难寻。\n相随徒侣无言说，各自胸中有故岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡黄河","author":"释今无","text":"月沉初听五更鸡，立马黄河去路迷。\n人影远侵霜树白，酒旗寒挂驿亭低。\n烟村百里才三见，事业孤身有数题。\n却笑丹山飞白凤，碧梧种就不成栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过峄山","author":"释今无","text":"马头北指峄山寒，廿载重过勒马看。\n信有风云藏石洞，愈怜霜雪打征鞍。\n一枝倦鸟栖还易，万里投人事较难。\n欲学小乘心未稳，只教客路自漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸子不善骑驴每易失足作此嘲之","author":"释今无","text":"食饭不如齐鲁客，骑驴那数广南蛮。\n一头到地敲钟杵，两脚朝天笔架山。\n争觅高坡先上镫，忽逢低坳即愁颜。\n头陀苦行原安分，不是披衣学舞斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出东平","author":"释今无","text":"始知天地有浮萍，珠海翛然又玉京。\n大雪昨宵过泗水，小除今日出东平。\n艰难判就黄金骨，雨雪难消紫陌情。\n总是异乡无可恋，随行又作广南声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东平遇雪","author":"释今无","text":"东平山路石钩连，百里荒凉尽废阡。\n古庙门前留碧树，行人雪地裹红毡。\n天无半日温晴意，人定三冬去住缘。\n却比梅花寒彻骨，飘摇轻薄客心前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北月 其一","author":"释今无","text":"飞埃不到碧霄圆，失队哀鸿畏入烟。\n须发似明还似暗，冰霜如割亦如燃。\n光浮斗柄人何远，影落关山恨独先。\n回首秦淮歌舞地，可堪皎洁酒楼前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北月 其二","author":"释今无","text":"高无山势冷无秋，碛阔空低揽客愁。\n去马不嘶霜箭急，征鸿频过羽声稠。\n飘多白雪光偏厚，涷尽黄河影不流。\n南国明珠应可惜，逢人只是暗中投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北月 其三","author":"释今无","text":"蹄轮终古绕秦川，冷落窥人缺复圆。\n吹笛带光侵肺腑，飞霜无地着云烟。\n人当乞食逢初乱，事不酬心付曩缘。\n收拾泪痕支瘦骨，鸡鸣应有向南鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北月 其四","author":"释今无","text":"昭关曾照伍家须，失路方惭镇海珠。\n镜破持来吾瘦矣，我安归处汝知乎。\n乌啼地阔愁如海，魂醒人孤影在湖。\n劫火又烧山泽涸，重骑羸马出皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北月 其五","author":"释今无","text":"丈夫原不事王侯，短发星星月一钩。\n事在乾坤人自老，道存丘壑我何求。\n蜿蜒山势寒流玉，寂寞僧怀似着秋。\n投得旅邸茅阁小，依稀疑是仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪","author":"释今无","text":"摇心夺目瑞光浓，旅梦初回午夜中。\n共有情怀悲故国，忽无天地独凌风。\n鸿鸣大泽惭霜羽，树尽琼枝比月宫。\n谁识此中真富贵，锦堂春色未曾工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿温泗源尊人","author":"释今无","text":"文章阀阅发天葩，南极星辉拥瑞霞。\n宦海交情称令子，客中怀刺乞胡麻。\n居官万里劳清梦，着綵三冬亦到家。\n独惜邮亭催去急，玉堂回首愈天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿萧澹如方伯 其一","author":"释今无","text":"千寻珠树接层城，岳牧如君骨干清。\n三世宿因酬锦绣，一门閒雅见公卿。\n月临雪底成诗画，社号香山是弟兄。\n万里相投谈五岳，且抛时事不须听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿萧澹如方伯 其二","author":"释今无","text":"上池一掬满流霞，胜看桃源万树花。\n琥珀有杯斟夜酒，紫薇无梦扰山家。\n看人下奕棋枰响，老我眠云逸兴赊。\n试问出山谢安石，閒忙谁共计年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游趵突泉 其一","author":"释今无","text":"灵泉终古响辚辚，蓟北天南惜问津。\n活火带风烧地轴，银潢抽雪喷珠轮。\n三花已见朝元气，九转谁知造化神。\n无限红霞侵碧芷，鹤归疑是武陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游趵突泉 其二","author":"释今无","text":"铁牌三面压灵符，泉底无风窦自呼。\n龙虎岂当翻逆浪，乾坤原自有铜壶。\n方流何处寻温玉，直上分明散雪珠。\n久倚石栏衣更冷，感时心事满江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅秋日予客金陵景尚道兄出宰栗阳正欲趋贺忽有王师入镇予随之归岭欲乞路费于知己用寄此什","author":"释今无","text":"福星万里到金陵，咫尺穷途未可迎。\n忽有归帆随铁马，旋思舟麦送金经。\n祇园不藉衔环报，清俸还知好义轻。\n得入罗浮高处望，千秋犹记此时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中过先雪楼与梦也学士禅话","author":"释今无","text":"飞埃九陌尽流金，居士楼边万竹阴。\n帘挂水晶寒映晕，诗堆白雪气尤深。\n全无绮语添文思，只有清言长道心。\n多少朱门敲未得，翛然贫对是知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七月四日诸公集塔下喜雨之作","author":"释今无","text":"蓬莱水浅燄阳天，欲乞真经纸上传。\n社有莲花惭慧远，人多元亮只清泉。\n片云入座秋生袂，一雨倾盘玉满川。\n当宁忧民应志喜，秋登还是太平年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白海棠予素未之见甲寅八月寓金陵入高座寺一见之复从徐公辅江城阁一见偶作是诗 其一","author":"释今无","text":"月魂波影共微茫，冷澹迎秋意倍凉。\n烟水已空金谷圃，冰霜独重白云乡。\n笛中梅瓣原无色，世上胭脂岂耐芳。\n罗绮红楼千种态，一回梦破歇诸狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白海棠予素未之见甲寅八月寓金陵入高座寺一见之复从徐公辅江城阁一见偶作是诗 其二","author":"释今无","text":"琢月磨冰绝点埃，无端却下谪仙台。\n何曾富贵能收拾，止有烟云共往来。\n雪屋未寒先欲冷，玉簪凋罢始当开。\n铅华洗尽无工力，漫对江城意莫裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅中秋予以乞经留滞长干与诸公偕宿餐云鍊师道院却赠","author":"释今无","text":"与君同姓复同年，我在风尘君在天。\n丹熟易寻骑鹤侣，途穷难乞造经钱。\n龙沙远谶开灵府，地脉真人驻紫烟。\n客里感秋秋色冷，殷勤得遇大罗仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬方梦也见赠次元韵 其一","author":"释今无","text":"谈禅道韵维摩诘，文字功勋郭子仪。\n辽左雪中难寄语，长干竹里喜联诗。\n云侵夏榻书千帙，眼寄高峰杖一枝。\n若问曹源真滴水，总从清坐坐忘时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬方梦也见赠次元韵 其二","author":"释今无","text":"薰风吹陆草频生，说偈拈花共一城。\n宝镜解开圆八角，眉棱拂后落双茎。\n孙弘有阁春何在，绿野无堂道已成。\n翳凤骖鸾仙骨在，还看羊角水云程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬方梦也见赠次元韵 其三","author":"释今无","text":"法海吾师许共游，华胥智水出轻舟。\n高斋别号绀宫起，镌佛霜刀慧刃投。\n玉树笔花还着意，金绳雪干总须留。\n秦淮月色光无限，坐对萧萧芦荻洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬方梦也见赠次元韵 其四","author":"释今无","text":"南还已畏朔风侵，羽檄悲传铁马音。\n金字还求惭往哲，纸袍终欲乞香林。\n辛勤敢诉孤僧意，欢喜原知长者心。\n他日海门敲磬罢，思君犹欲下高岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠余二闻","author":"释今无","text":"博山道法倚中丞，三世因缘叶叶清。\n骨肉喜逢留滞日，水云未老解官情。\n双林衣钵光犹在，一室儿孙力未弘。\n金凤玉麟君自惯，碧天长照月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿孙启南","author":"释今无","text":"八宝池边菡萏香，车轮如日起扶桑。\n仙人自合苏门啸，寿岭其如白下长。\n绕膝凤毛光灿烂，衔筹鹤意早商量。\n丹期赴得蓬莱约，正值新秋万壑凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祝词","author":"释今无","text":"松风披拂绕阑干，滟滪堆翻六月寒。\n四海羽仪尊凤尾，千年文物重鸡坛。\n天高北极梯原易，箭美东南似更难。\n一粒神珠光合浦，自然不羡大还丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡方珠见赠用韵酬之","author":"释今无","text":"介然标致绝风尘，湖海谁当识隐沦。\n琥珀有杯收乐土，琼瑶无句不阳春。\n高怀直接柴桑里，好友皆为洛社人。\n暑气郭门三二里，怜予日日得相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸子宿万鍊师道院赏月","author":"释今无","text":"千门月色石城头，虎踞关前此夕秋。\n碧海路漫归梦远，玉虚天阔露华流。\n潭龙欲醒珠偏洁，洞鹤长鸣韵更幽。\n却怪同游赊酒客，纵横杯杓使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅九月杪予从江宁入句曲晤林明府仅人因得接黍谷钱中丞之欢同寓崇明寺畅谈捧腹已成三日夕之乐十月朔二鼓别归邻院而宿夜梦与中丞凭高俯视见有搅绵花者梦中幻境其花蒙茸如海风撼浪予谓中丞曰可共作搅绵花诗何如中丞诺之予遂先成二句曰却似白云生谷口还如泻水置平川及旦林紫君相过因与中丞同早饭王大席陈南浦俱在焉饭后相与步城头揽郭外秋色而凭高之意遂忆梦中因语中丞中丞索予续成欲和同游者各属一章即以此为相逢剪拂投赠之雅什也","author":"释今无","text":"寒衣梦里欲装绵，新絮茸茸搅暮天。\n却似白云生谷口，还如泻水置平川。\n凭高喜接中丞武，引玉先投野衲笺。\n若不吟诗庆相遇，沾泥心事笑枯禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅杪秋予客句曲崇明寺大席道兄频惠佳食且促膝谈心甚感知己赋此用赠","author":"释今无","text":"华阳胜地又相过，古寺逢君感慨多。\n人似淮阴惭布衲，饭如香国见维摩。\n楚云尚重衡文鉴，天马终腾拔宅窝。\n知己天涯敦气谊，天涯况复正干戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈南浦道兄为予图华阳秋色绘成即归金阊赋谢","author":"释今无","text":"一幅山光满素屏，多君共有水云情。\n未须结社营茆屋，已见谈空拥化城。\n千树暮云遮鸟道，半塘寒水浸秋萍。\n华阳此别将成梦，记别何年共月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅九月张南村携其所选风怀访友江上限韵索送予旅人也亦见采及","author":"释今无","text":"借得禅楼拟共游，廿年不见秣陵秋。\n言从江渚寻高士，更挟风怀上客舟。\n芦荻岸边霜月冷，鹔鹴园畔雁声流。\n旅情称意怜予苦，寂寞相思韵未酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李子先 其一","author":"释今无","text":"水犀军散剩龙泉，欲饮刀圭作地仙。\n玉带典空樽酒竭，清词谱出世人传。\n百年活佛长看綵，一个英雄只任天。\n着眼浮云秋叶外，惊涛方羡已归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李子先 其二","author":"释今无","text":"结庐天界寺旁边，疑圃疑农道总全。\n路少金吾埋姓字，袖藏猿臂带云烟。\n閒梳玉翅陪修羽，又见狂飙起大川。\n夜半见星如见月，凭谁光照一穷禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登高座寺","author":"释今无","text":"已知秋色满江关，此意凭高益莫删。\n世乱恰当为客苦，山空愈觉背人閒。\n秦淮万户晴烟里，高坐孤亭落照间。\n事事顿令华鬓改，菊花应亦笑衰颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡高士星卿","author":"释今无","text":"事事伤心岁月长，山河破碎失家乡。\n独支鹤骨倍青冢，难抱龙髯问玉皇。\n城内官街如隔世，村边孝帽晒斜阳。\n檐前乌鹊频频噪，喜见蟠桃熟渐香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿胡方诸","author":"释今无","text":"七个贤人八个仙，古今两席未曾迁。\n凭谁入座当虚左，独子持杯许大年。\n日日微醺长入社，时时閒念露全天。\n天涯投分情无限，石鼎炉烟别有缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠胡君渥","author":"释今无","text":"敲推未了死文章，冷煖难餐日月芒。\n认定一抔才是土，梦回深夜总如霜。\n血流杜宇三春尽，影结鸰原两翼长。\n蓬窦不须删蔓草，观空时或发幽香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠智林","author":"释今无","text":"千僧座上此僧雄，为象为狮气尽空。\n印佩毗卢尊觉义，人如晋代得玄风。\n花开富贵春为国，楼占云霞月作宫。\n一个路人无处着，却从君意问穷通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜舒亦恒相见金陵","author":"释今无","text":"数年一水限相思，此日穷途握手时。\n今古秦淮空见月，风尘湖海意同谁。\n灵台宝镜光无碍，幕府莲花去莫迟。\n便是空王真弟子，与君长作水云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠庞君杰","author":"释今无","text":"七尺身躯尺一须，丰姿应合寄蓬壶。\n材华用处春归树，心地平时月在湖。\n四百上方施愿力，九衢横术唤凡夫。\n古今又见庞居士，争肯还同实所无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠文及先年八十二矣善图章","author":"释今无","text":"声华名历几兴衰，八十看残更问谁。\n曼倩何曾知汉碣，伏生元可诵秦遗。\n字留正气存先节，山对秋光别有题。\n万里与君盟水鸟，瑶琴一曲入无为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯人日泊皖城同葵轩总戎紫君文学登近江寺得春字","author":"释今无","text":"登临此日正宜春，万里鲸波绝点尘。\n铜柱旧营高细柳，玉壶新月照归人。\n旌旗闪日遮龙藏，鹢鹳奔云逸凤津。\n剑阁燕然谁属笔，千秋大业始图麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张康之六十一","author":"释今无","text":"数载深峰插马芽，红云绿树野人家。\n典空玉带留香种，割断龙泉为稻花。\n万里键铃如隔代，满天烽火任悲笳。\n鹤来鹿往浑忘岁，一曲商山日未斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宇迁大士修大悲忏于雷峰洁诚静虑其勤恳以福先人者至矣于其还韶阳诗以送之","author":"释今无","text":"山中礼忏始出山，盘绕香云两袖间。\n陟岵只徒抒望眼，闻经真可破幽关。\n修诚已入莲花界，歛虑方依满月颜。\n泻瀑崩崖听不见，几多宿痗已存删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游曹溪与任崧翰宪使作 其一","author":"释今无","text":"荏苒流光梦欲残，重过祖席不胜欢。\n爱逢宪使探奇兴，得话孤峰白昼寒。\n旗影乱翻溪水入，萝阴高引碧云盘。\n尘心顿歇空门里，寥廓松杉插石坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]