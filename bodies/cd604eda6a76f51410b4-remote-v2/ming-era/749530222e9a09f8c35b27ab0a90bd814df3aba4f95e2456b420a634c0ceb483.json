[{"title":"秘魔岩 其二","author":"孙传庭","text":"岩前夏日冷，岩上晚云多。\n我到真遗世，人传古秘魔。\n深林禽鸟息，幽径虎狼过。\n老衲饶闻见，其如山鬼何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万年社","author":"孙传庭","text":"合受清凉福，还依云水僧。\n到来莲社寂，真似玉壶澄。\n夏日犹飞雪，东风不解冰。\n家乡逾百里，三伏苦炎蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过观来石断愚上人留斋微雨旋霁遂行 其一","author":"孙传庭","text":"灵石知何自，观来几岁华。\n地幽疏履舄，僧韵带烟霞。\n香供雷生菌，元言雨散花。\n阴晴莫递变，津渡已无差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过观来石断愚上人留斋微雨旋霁遂行 其二","author":"孙传庭","text":"归路临兰若，仍馀揽胜情。\n云烟携客至，麋鹿夹僧迎。\n经罢龙收雨，斋馀马趁晴。\n重来非漫约，诸衲记深盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张文岳吏垣过雁门留酌山园因邀田御宿大参同集 其一","author":"孙传庭","text":"雨散阴初敛，园林夕意幽。\n披襟临水榭，蹑屐上山楼。\n客兴优登眺，主情洽挽留。\n数峰横宿翠，相对豁吟眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张文岳吏垣过雁门留酌山园因邀田御宿大参同集 其二","author":"孙传庭","text":"阴晴日屡易，向晚复新霋。\n湛露花边下，繁星柳外迷。\n十年吾磊块，四海尔云霓。\n况是高阳侣，何妨醉似泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其一","author":"孙传庭","text":"惜别兼怀感，衔杯意未平。\n烽烟归远道，雨雪去孤城。\n罪合边臣任，功惟野史明。\n相看馀侘傺，不独为交情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其二","author":"孙传庭","text":"已作贤人隐，那禁义士伤。\n鱼还谁矢直，鸟尽尔弓藏。\n五岳游堪壮，千秋气转扬。\n惊看双鬓短，元不负君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其三","author":"孙传庭","text":"自抗西台节，已高北斗名。\n射墉矜独力，斥仗忌孤鸣。\n众论方纷沓，天心厌治平。\n故因寇祸搆，竟使撤长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其四","author":"孙传庭","text":"正切北堂恋，何妨早拂衣。\n荣名轻节钺，乐事慕庭闱。\n况有兰芽茁，更兼棣萼辉。\n悬知归子舍，绕膝共依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其五","author":"孙传庭","text":"白云萦渭水，紫气动函关。\n遽遣双龙失，惟将一鹤还。\n遗编窥韦绝，初服著莱斑。\n独我悲离索，冥鸿不可扳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其六","author":"孙传庭","text":"旧有蓬蒿径，新经兵火馀。\n到家惟四壁，解橐独群书。\n自信名心薄，宁嫌生计疏。\n公归吾意决，小草欲何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其七","author":"孙传庭","text":"图隐有新寄，懒斋及澹园。\n数椽兰作室，十亩竹为垣。\n静有琴樽对，僻无车马喧。\n避居非傲物，吾道拙中存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其八","author":"孙传庭","text":"何物送君去，城头勾注山。\n浮云连冀野，明月满秦关。\n拙宦终成蹶，工诗早得閒。\n二华几案上，行矣任开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其九","author":"孙传庭","text":"拂袖归秦陇，嚣然故作豪。\n人情泾水浊，君意华山高。\n结客怀燕侠，论诗续楚骚。\n悲歌亦我事，永矢托绨袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田御宿大参归里 其十","author":"孙传庭","text":"吾生常落落，于世总悠悠。\n龙剑殊难合，骊珠岂易投。\n浮樽分郢唱，飞舄共梁游。\n自许生平在，当为知己酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中小酌读杜律有作","author":"孙传庭","text":"一雨来新爽，移樽傍短檐。\n乡心愁里尽，诗思客中添。\n阅世才难老，惊人句可拈。\n偶然披一过，满座失蒸炎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未五月抵舍甫浃旬而北辕又发矣浪迹萍踪可胜惆怅因成一律以志感尤以道区区将母之私云","author":"孙传庭","text":"越年初返辔，十日又长征。\n聚散悲尘世，浮沉叹此生。\n塞云萦子舍，官柳促王程。\n为语闺中妇，怜予菽水情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其一 一东","author":"孙传庭","text":"惊见嘉莲涌，真成别样红。\n双葩霞采异，一干素心同。\n并映西溪日，平分十里风。\n似闻关瑞应，吾欲问玄工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其二 二冬","author":"孙传庭","text":"虚心知有约，一壑解相容。\n馥馥香如和，翩翩影自重。\n台箫齐下凤，津剑并飞龙。\n混迹污泥里，忻然得所从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其三 三江","author":"孙传庭","text":"矫矫风尘外，竞芳两不降。\n秪因无物并，只许自成双。\n湛露分襟挹，炎威合力扛。\n芙蓉空好妒，冷落向秋江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其四 四支","author":"孙传庭","text":"清溪标异致，灼烁照涟漪。\n元以一生两，翻因偶见奇。\n季昆畴命玉，伯仲孰操篪。\n芍药轻相谑，故因事可离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其五 五微","author":"孙传庭","text":"解语都无语，因知喻意微。\n飞扬同翠盖，绰约并红衣。\n幻岂方神女，愁宁托帝妃。\n独清怜众浊，水上自相依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其六 六鱼","author":"孙传庭","text":"奇葩开盛夏，香色两相如。\n得气谁吾闰，吐华不厌馀。\n凌波联缟带，映日缀霞裾。\n为谢尘中客，应难附执袪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其七 七虞","author":"孙传庭","text":"精灵元独种，瑞采合分敷。\n自信根心一，谁云生色殊。\n波流仍独立，风雨足相扶。\n莫遣齐谐志，由来德不孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其八 十一真","author":"孙传庭","text":"净土根深结，应窥未了因。\n浑忘尔我相，齐现后前身。\n不是全空蕴，安能并出尘。\n妙华宁可说，解到本来真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其九 二萧","author":"孙传庭","text":"自是芳心合，清溪如见招。\n角英高二陆，比艳薄双乔。\n偶矣终非蔓，奇哉竟不夭。\n倚栏频顾盼，一样绝尘嚣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其十 三肴","author":"孙传庭","text":"烟水芳菲际，依依不暂抛。\n日移花互隐，波动影频交。\n笑觑双鱼泳，愁防独燕捎。\n为言休陨落，翡翠欲来巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其十一 六麻","author":"孙传庭","text":"把盏看芳蒂，真如客兴奢。\n疑将双劝酒，岂合独开花。\n居共藐姑射，名同萼绿华。\n泽癯难应接，次第酌流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其十二 八庚","author":"孙传庭","text":"爱尔亭亭者，胡为并蒂生。\n临风香共远，濯水韵同清。\n仙子联肩立，天孙一手成。\n休将鸳侣拟，原不落凡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其十三 九青","author":"孙传庭","text":"倚槛延清赏，那禁眼并青。\n吾方嗟落落，尔自惜惺惺。\n拂镜齐生态，纫兰互袭馨。\n荷阴堪覆庇，风雨勿飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其十四 十三覃","author":"孙传庭","text":"静碧一泓澈，仙葩影并涵。\n晓抟空翠湿，夜抱水云酣。\n南岳双遗钿，西池两坠簪。\n同妍非互效，相对亦何惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"映碧园产并头莲三十首 其十五 十四盐","author":"孙传庭","text":"俱饶清远致，相并不相嫌。\n目岂学鱼比，翼非效鸟鹣。\n总缘头角异，奚但色香兼。\n若作芙蓉锷，应劳紫气占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答王炳藜检讨","author":"孙传庭","text":"不浅蓬瀛意，由来感慨多。\n文能倾海市，气欲挽天河。\n有客宵占剑，何人夜枕戈。\n出山余自哂，云壑未能那。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别吴鹿友中丞 其一","author":"孙传庭","text":"自是英雄别，那禁倍黯然。\n云霄空道路，天地正风烟。\n落日干戈外，孤城鼓角边。\n此时分手去，不独怅离筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别吴鹿友中丞 其二","author":"孙传庭","text":"已为苍生病，仍成社稷功。\n伏床亲草檄，裹药自临戎。\n毳帐连宵北，衮衣信宿东。\n岘山碑可续，堕泪古今同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别吴鹿友中丞 其三","author":"孙传庭","text":"正切安危倚，胡兴归去情。\n道看八座浅，官较一邱轻。\n鸾凤惟应隐，虎狼未是横。\n怜余不解事，叱驭一何营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别吴鹿友中丞 其四","author":"孙传庭","text":"自傍西溪隐，蹉跎十载馀。\n非能轻好爵，聊以爱吾庐。\n愁有堪呼酒，穷多未著书。\n时名谁复问，知己意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次冯二瑞韵留别 其一","author":"孙传庭","text":"迂僻殊多感，非耽一壑娱。\n衣冠犹蹻蹠，泉石亦穿窬。\n声气分高士，肝肠托腐儒。\n相期能不浅，吾世见唐虞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次冯二瑞韵留别 其二","author":"孙传庭","text":"自向青门隐，人情识大都。\n九疑横地轴，五纬暗天枢。\n共信飞为鸟，谁云赤匪狐。\n曝芹吾欲献，未卜圣明俞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次冯二瑞韵留别 其三","author":"孙传庭","text":"时趋日以伪，世路总嵚岖。\n无处寻昆璧，何由辨珷玞。\n识途嗟款段，变色骇于菟。\n分手深相惜，故园松菊芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余德先之任闽中取道云中省觐","author":"孙传庭","text":"霜飞木叶乱纷纷，京邸萧疏此送君。\n海内不堪多战伐，天涯偏是惜离群。\n闽江春色延青旆，冀岭秋风动白云。\n此去相思同万里，梅花驿路好相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜同武子联句","author":"孙传庭","text":"九十春光渐欲残，客心无事一凭阑。\n谈兵漫洒丁年泪，把酒堪消子夜欢。\n快阁烟霞同汝梦，芒山星月好谁看。\n愁听啼鸟声声急，一曲燕歌不忍弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别武子有感 其一","author":"孙传庭","text":"看君明日动归帆，把酒西风泪满衫。\n人在关河难作别，时当离乱易逢谗。\n一龙早起青云色，双鲤先飞白苧缄。\n江上故交如有问，王乔久拟脱嚣凡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别武子有感 其二","author":"孙传庭","text":"此去休悲行路难，高斋樽酒暂留欢。\n荷香乍度飘官路，榴火新垂照绣鞍。\n念乱有人争解绶，怀才我辈始弹冠。\n秋风咫尺高南浦，明月宁教按剑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同谢九如常振寰二广文饮三台阁漫赋 其一","author":"孙传庭","text":"飞阁嵯峨倚太清，凭栏一望失尘缨。\n西来树影摇金刹，南下烟光绕石城。\n丘壑有时归傲吏，乾坤何地著狂生。\n坐深月上高台静，片片幽芬落酒觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同谢九如常振寰二广文饮三台阁漫赋 其二","author":"孙传庭","text":"宦迹天涯感慨中，登高览胜解相同。\n思乡节候逢流火，玩世行藏任转蓬。\n涟水烟飞老子气，芒山云起汉王风。\n细论往事增惆怅，徙倚尊前意不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次前韵","author":"孙传庭","text":"为爱秋光逼眼清，閒来一笑绝冠缨。\n黄金徒散三千客，白璧难偿十五城。\n漫把閒愁消短鬓，谁将大药度长生。\n与君且尽登临兴，潦倒风前酒数觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王彭伯先生北上 其一","author":"孙传庭","text":"轺车明日问长安，尊酒离筵且尽欢。\n论将中原豪杰动，谈兵午夜斗星寒。\n新秋早见边声急，时政深怜外吏难。\n圣主久虚前席待，伫成霖雨到江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王彭伯先生北上 其二","author":"孙传庭","text":"多乱冥鸿不可寻，何来空谷转传音。\n烽烟正想匡时策，霄汉长悬报主心。\n上国群公疏漫切，强邻此日祸方深。\n驱车忽动中朝色，几席相看击筑吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闱中与许亦龄张斗垣二明府夜集","author":"孙传庭","text":"银烛辉煌照素秋，芳樽凉夜对清幽。\n香飘玉树风生户，翠拂金茎月满楼。\n车马昔怜燕市别，文章今作兔园游。\n酒阑忽漫谈时事，万里边声起暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许亦龄持朱允冈吉士扇头韵索和走笔次之","author":"孙传庭","text":"閒馆清言夜更宜，开襟又到酒酣时。\n尊前白雪生长铗，楼外青霞落远陂。\n梁苑秋光惊过眼，楚天露气欲沾脾。\n不知何处寒砧急，银汉迢遥月转迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮明远楼次李梦阳先生壁间韵","author":"孙传庭","text":"巀嶪飞楼俯夕烟，招携吾党一开筵。\n感时客有悲秋赋，揽胜人同入洛年。\n指点河山分槛外，笑谈星斗落檐前。\n元龙自昔多豪兴，应拟身临尺五天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓相国寺有怀","author":"孙传庭","text":"僧房落叶满荒苔，小院烟光暝欲开。\n万里秋风人入洛，一天夜月客衔杯。\n疏钟渐向高楼断，清梵频从古殿来。\n客舍不堪成独啸，近邻疑有谪仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送友人还里","author":"孙传庭","text":"正惜天涯聚首难，风尘何故促征鞍。\n百年兄弟三秋阔，千里关河十月寒。\n解橐自怜官况薄，开樽常忆故情欢。\n何时我亦偕归计，紫塞青山好共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜同杨慕垣贡二山小集醉后闻二山诵曹孟德短歌声甚悲壮漫赋","author":"孙传庭","text":"雨馀官署动新凉，纵饮高呼自酒狂。\n忽忆昔年歌转啸，相怜此夜慨当慷。\n愁听魏武乌三匝，惊见燕京雁几行。\n尽醉不须悲去日，乾坤万古总苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄年伯京兆招饮园亭留咏 其一","author":"孙传庭","text":"招游忽漫问名园，把酒偏怜北海樽。\n花径芳菲通近沼，竹篱宛转护高轩。\n三春浍水烟光远，一曲芒山夜色繁。\n尽醉不妨归去晚，几将时事坐中论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄年伯京兆招饮园亭留咏 其二","author":"孙传庭","text":"廿年幽赏寄丘园，谢傅东山道益尊。\n杨柳风来春绕砌，梨花雨过夜开轩。\n坐看兰玉前庭秀，仰视星河北阙繁。\n京兆新承明主诏，白门烟月正堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁大煦来自白下因言道逢倪武双致询出其扇头次韵诗次之","author":"孙传庭","text":"燕台一别几经秋，兄弟天涯尚黑头。\n音信漫凭天外雁，行藏都付水中鸥。\n梁园才子如君几，南国佳人不可求。\n二十四桥明月好，不知今夜共谁游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"考绩 其一","author":"孙传庭","text":"悠悠两地忽三年，抚字催科俱惘然。\n墨绶方惭臣职旷，丹书复荷主恩偏。\n九边此日仍多垒，四海何时可息肩。\n为语登闳新谏议，苍生满眼尽堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"考绩 其二","author":"孙传庭","text":"亳都潦倒竟何为，严剧疏庸总不宜。\n五凤人争推汉吏，双凫我自愧明时。\n传家清白虽无忝，治邑艰辛未有裨。\n圣主若虚前席待，愿将血泪洒彤墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁道中","author":"孙传庭","text":"桃花烂漫水潺湲，何事风尘恼客颜。\n四海几人堪定乱，百年吾道合投閒。\n怀中有璧羞逢主，囊里无钱欲买山。\n几度言归归未得，梦魂空绕雁门关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庞雪涛至署中留酌 其一","author":"孙传庭","text":"思君愁逐太行高，此夕芳尊任我曹。\n月满空庭生桂树，风翻清漏落松涛。\n百年道义交元古，一载天涯意转豪。\n多难独怜余未已，却因时事惨皮毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庞雪涛至署中留酌 其二","author":"孙传庭","text":"中原寥落总消魂，慷慨犹怜我辈存。\n旧有奇文倾海舶，今皈禅思叩风幡。\n深谈六月炎蒸失，尽醉三更意态翻。\n不道梁园俱是客，十年难得此宵论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿安平集","author":"孙传庭","text":"草舍茅檐障短屏，荒村事事总飘零。\n秋风况是愁中见，夜雨那堪客里听。\n浊酒漫供劳吏醉，邻鸡频唤仆夫醒。\n未明忽又驱车去，踪迹真同泛水萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]