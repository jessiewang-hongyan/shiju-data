[{"title":"东皋","author":"唐元","text":"喧晨步东皋，春风袭杖屦。\n溪流带落花，晴烟袅飞絮。\n濯足竹边泉，散策松下路。\n幽禽忽惊起，飞过溪南树。\n林深疑无人，俄闻响机杼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17667,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虞山秋夜","author":"唐元","text":"迢迢秋夜长，青灯半明灭。\n栖鹊绕疏枝，湿萤依腐叶。\n谷虚振幽响，室静生虚白。\n数声谁家笛，吹堕西窗月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17668,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登善住寺新成阁得江字","author":"束宗庚","text":"高阁新成俯大江，宏开雄丽控名邦。\n宿云不散连飞栋，红日初升射碧窗。\n目极蓬莱穷岛屿，神游阊阖见旌幢。\n群公此日频登眺，喜有清吟对怒泷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17669,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题听春雨轩","author":"束宗庚","text":"阶头燕雨润流酥，柳底鸥波已可渔。\n斗帐沉香欹枕后，青灯绮户把杯初。\n不愁泥滑妨过骑，喜有田歌起荷锄。\n明日云开花满眼，好令童子具蓝舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17670,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉山草堂","author":"束宗癸","text":"草堂只在沧江上，西户冯虚野气阴。\n秋屐行随苔径曲，春船坐泛柳塘深。\n久闻好事归时论，复喜交游尽苦吟。\n我欲乘闲来问讯，百壶送酒重论心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17671,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兵后过访顾仲瑛感赋（丙申十月）","author":"缪侃","text":"少年壮志已模棱，忆旧怀亲思不胜。\n我父竟为逃难客，故人近作在家僧。\n身居乱世惭何补，哭到穷途去未能。\n相见莫论生死事，且须泥饮尽寒灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17672,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云林生画林亭远岫（癸卯五月）","author":"顾敬","text":"云林八法写倪迂，夏木幽亭翠几株。\n雨后长洲政如此，骑驼山色近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17673,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠娄东朱叔重","author":"顾敬","text":"海岳庵头积翠峰，苍松两两似游龙。\n要知米老骑綍去，谁把云山写淡浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17674,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秀野轩诗","author":"余尧臣","text":"湿翠浮草芽，空青散木杪。\n轻舟理横塘，归人渡清晓。\n栖鸦返故巢，潜鳞濯新藻。\n倒景淡斜晖，回飙荡晴昊。\n衡门夜不扃，燕坐事幽讨。\n落叶秋自飘，残花春懒扫。\n我欲往从之，税驾苦未早。\n挥手谢孤云，去去没苍徼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17675,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日怀兄弟二首 其一","author":"宋克","text":"秋至忆兄弟，萧萧木落初。\n如何去乡国，不见有音书。\n漂泊全无定，存亡半是虚。\n风尘几时靖，还似昔同居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日怀兄弟二首 其二","author":"宋克","text":"相别几多时，相思泪满衣。\n家贫经难久，世乱得书稀。\n作吏诚全拙，从军事亦非。\n乡心秋塞雁，尽日向南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书云林画林亭远岫","author":"吕敏","text":"忆过梁溪宅，于今向廿年。\n赋诗清珣阁，试茗惠山泉。\n夜雨牵离梦，春云黯远天。\n乡情与离思，看画共茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辛亥五月过弘道西斋重题","author":"吕敏","text":"葱茜夏林绿，高斋方夕曛。\n幽花垂泫露，远岫敛归云。\n停箑风初至，移尊酒半醺。\n明朝忆佳赏，回首念离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题幼文蜀山书舍图","author":"吕敏","text":"云锁蜀山秋，重来佛慧游。\n含毫得诗句，题入画中愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为惠机长老题徐幼文写惠山图","author":"吕敏","text":"天寒华表鹤归迟，隔世令人起远思。\n偶见漪澜堂上画，犹看《悟澹》卷中诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄高季迪","author":"吕敏","text":"客馆俯江郊，秋深不自聊。\n别来心更苦，思去路还遥。\n桐叶风俱落，菱花雨半销。\n何由似流水，早晚赴归潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17682,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再寄高季迪","author":"吕敏","text":"空谷白驹那可羁，高踪只欲慕天随。\n吴江日去应无恙，甫里春来定有诗。\n花忆杏园携酒日，雨思山馆听莺时。\n去年乱里从游处，肯信于今又别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17683,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵邾仲经同登虎丘长句","author":"吕敏","text":"山上楼台山下城，朱旗夹道少人行。\n春风寂寞莺花梦，落日悲凉鼓角声。\n古冢金精来变幻，天池剑影随空明。\n老僧趺坐忘尘虑，石溜何须恨不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17684,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题云林画","author":"陈则","text":"落花愁杀未归人，乱后思家梦更频。\n纵有溪头茅屋在，也应芳草闭深春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17685,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朝真宫夜陪席炼师","author":"陈则","text":"萝径掩空扉，炎尘逐雨归。\n山明余夕在，草暗一萤飞。\n姹女鸾和驭，丹仙鹤羽衣。\n焚香与默坐，初悟幻情非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17686,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二月八日重游灵应奉简席炼师","author":"陈则","text":"昔年避乱久相依，今日重来却似归。\n客意欲随春北去，雁声犹带雪南飞。\n已多中国栖荆棘，不独阳山死蕨薇。\n倘向赤松方外住，愿陪鹤从莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17687,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过狮林精舍","author":"陈则","text":"清境超尘格，松龛映竹开。\n鱼惊幡影散，鸟听钵声来。\n梵像敷莲座，禅宗问木杯。\n山僧不虑世，白发也毰毸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17688,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后过狮林精舍","author":"陈则","text":"当晓一莺鸣，林收宿雨晴。\n网残虫脱罥，蜂闹蝶催成。\n梅气袈娑润，香花佛座清。\n回廊僧不见，看壁自吟行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17689,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋兴","author":"万白","text":"北郭垂杨日夜凋，清秋登望旅魂消。\n半生江海同浮梗，何处林泉可弃瓢。\n奔走风尘双鬓改，羁栖戎马一身遥。\n数奇李广萧条久，短服辕门独射雕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17690,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠播州田宣慰","author":"万白","text":"先朝才杰济时艰，使节分符镇百蛮。\n鸾诰锦云浮玉篆，龙媒香帕覆雕鞍。\n中流一柱当霄汉，南土诸蕃拱将坛。\n伫颂边城勋业盛，凌烟图像与人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17691,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"明朝","author":"胡悌","text":"明朝又上阖闾城，江上春潮一舸轻。\n过眼落花应有恨，傍人飞絮自多情。\n本因世乱依刘表，谁谓才多累祢衡。\n试问庞公归隐计，南阳何地可躬耕？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17692,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠章伯高二首 其一","author":"胡悌","text":"共是多情惜岁华，故应美酒送生涯。\n金齑细斫秋风鲙，玉髓新烹谷雨茶。\n每爱芙蓉依北渚，还思蝴蝶过西家。\n江南三月莺啼遍，不信樱桃未著花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17693,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠章伯高二首 其二","author":"胡悌","text":"平生豪气慕西州，莫怪眉攒万国愁。\n商皓不知秦正朔，荆人曾纪鲁春秋。\n新丰酒美春三月，剑阁诗多岁一周。\n中夜闻鸡真起舞，齐桓事业在营丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17694,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋宵七恨 其一 风","author":"李昱","text":"青蘋叶底声蓬蓬，当年曾号襄王雄。\n秋高八月势转急，忽来吹我茅屋东。\n令我夜坐难秉烛，使我发白成老翁，吁嗟恨尔之秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17695,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋宵七恨 其二 雨","author":"李昱","text":"六月一滴不沾土，连夜淋漓独何苦。\n红蕉碧梧语叶上，黄茅屋漏那能补。\n鸡鸣嘐嘐天欲曙，况乃萧条在羁旅，吁嗟恨尔之秋雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17696,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八月辞","author":"李昱","text":"鲤鱼吹长风，曲池芙蓉老。\n白天坠凉露，湿萤满衰草。\n兰房灯烬青，独宿知秋早。\n碧波弄明月，自惜颜色好。\n起按鸳鸯弦，酸声搅怀抱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17697,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月氏王头歌和杨铁崖","author":"顾亮","text":"月氏肉，碎如雪，月氏颅，劲如铁。\n快剑一斫天柱折，留取胡卢饮生血。\n冒顿老魅呼月精，夜酌葡萄陇月明。\n鬼妻蹋地号我天，可汗天灵哮唬声嘶酸。\n于乎，颅兮颅兮汝勿悲，我今酌汝金留犁。\n黔州都督有血顶，精魂夜夜溺中啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17698,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晚","author":"吴会","text":"风雨春如客，烟霞日似年。\n莺歌把酒听，花落抱琴眠。\n树暗藏书谷，香流洗药泉。\n好怀无处说，谁与系江船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17699,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江村","author":"吴会","text":"红树江村外，黄芦野水边。\n叶深风落地，禾偃涝余田。\n雁鹜违寒日，牛羊入远烟。\n岸人连棘户，尽室避军船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17700,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵奉题吴彦贞华林别业","author":"吴会","text":"郡城南去有华亭，花木成林竹绕汀。\n照影凤凰临月镜，传声鹦鹉隔云屏。\n分栽柳入《陶潜传》，点校茶归陆羽《经》。\n我亦延州老孙子，对江相望乐清宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17701,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题崇山刘氏园亭","author":"吴会","text":"西山三叠郁岧峣，亭上看山翠欲飘。\n杨柳小楼风满席，芙蓉清沼水平桥。\n美人歌处倾金杓，仙客来时度玉箫。\n我忆醉眠花底月，满衣香露夜萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17702,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送别阴阳教授","author":"吴会","text":"天官艺学久庞纷，太史名家属有闻。\n宝历敬时颁岁正，铜仪窥夜识星文。\n乌飞圭表移光影，龙咽筹壶定刻分。\n归后更详东井分，五珠何日聚贤群？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17703,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题扇赠首坐","author":"吴会","text":"提来电掣风千里，放下云沉月五更。\n举似坐中三百众，定从何处有风生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17704,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫人欠伸图","author":"吴会","text":"舞困歌慵酒梦迟，小栏舒腕转腰时。\n落花垂柳娇无力，都送春愁上两眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17705,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送赵文善之湘阴守","author":"王翊","text":"前代王孙夙相家，于今出牧向长沙。\n神龙正喜腾霄汉，天马宁容驻渥洼。\n江水流澌初阁棹，岳云点雪又催衙。\n好怀忍向高人别，折赠寒梅驿路花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17706,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"所闻有感","author":"游庄","text":"尘飞鹿走力难任，巡幸沙边悔恨深。\n鸟篆未经衔轵道，龙文先自徙汾阴。\n空传行在沦孤愤，无复寰区遏八音。\n圣德神功俱泯灭，英雄千载一沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17707,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻宋子瑜归","author":"游庄","text":"朝辞幕府解戎衣，夕向空山觅紫芝。\n弹铗自伤为客早，折腰方叹去官迟。\n萧萧白雁西风劲，采采黄花夕露滋。\n却忆江波垂钓叟，白头犹作帝王师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17708,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长门怨","author":"王中","text":"昭阳歌吹入，独自泪双垂。\n玉貌无如妾，君恩复在谁？\n凉风摇绣户，明月堕金闺。\n愁绝无人见，流萤点翠帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17709,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日述怀 其一","author":"王中","text":"潦倒羁游子，伤心两鬓华。\n途穷唯有泪，世乱更无家。\n雨暗闻寒雁，风悲急暮笳。\n艰难今一概，何处问生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17710,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日述怀 其二","author":"王中","text":"天下兵常斗，山中客未归。\n塞鸿南度早，星使北来稀。\n草草年光度，悠悠世态非。\n自悲同社燕，几处傍人飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17711,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄家洲客舍留别","author":"王中","text":"数载俱流落，相逢鬓已秋。\n生涯同寂寞，书剑只淹留。\n沙阔随天尽，江平带日流。\n别离殊不惬，回首思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17712,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田家杂兴","author":"王中","text":"烟火中林静，秋风岁律赊。\n清霜催橘柚，落日照蒹葭。\n石径通流水，山桥卧古槎。\n武陵元世境，不必问桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17713,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居述兴","author":"王中","text":"老来真懒慢，林下复无营。\n樵牧通名姓，禽鱼识性情。\n卧闻黄叶落，坐看白云生。\n更爱茅斋夜，泠泠风月清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀方二叔子","author":"王中","text":"闻说临濠客，衰年谪宦贫。\n爱憎多异报，消息定谁真。\n得失虽由命，才名实累身。\n平生交契重，东望苦伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病后述怀","author":"王中","text":"杖藜初雨后，试步夕阳时。\n草绿惊春久，山深得暖迟。\n病多因识药，兴短倦题诗。\n寂寞无人问，平居有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊镜口","author":"王中","text":"日暮风涛稳，扁舟泊此隅。\n云山归梦杳，邻舫语音殊。\n片月寒江永，平沙旅雁孤。\n无才合漂泊，不敢恨穷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐","author":"王中","text":"岁事行将尽，寂寥无所欢。\n书灯茅屋静，山月夜窗寒。\n旅况何曾好，人情愈可叹。\n乱离虽自苦，垂老值艰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中滞雨","author":"王中","text":"渌酒千钟醉，衰年百念阑。\n山深茅舍静，春暮雨声寒。\n花事随泥滓，苔痕上井栏。\n寂寥闻杜宇，羁思若为宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴","author":"王中","text":"小斋清寂雨晴初，养拙生涯偶自如。\n梦里屡寻芳草句，病来慵写绝交书。\n鸟啼绿树轻烟暖，花落闲阶过客疏。\n却羡陶潜幽趣好，长歌吾亦爱吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初夏寄兴","author":"王中","text":"日长庭馆倦琴书，久病情怀偶自如。\n苔遍空墙新雨后，泥香小径落花余。\n耽闲会遣形骸累，向老全将世味疏。\n风满北窗清梦觉，翛然心境上皇初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后夕凉柬友人","author":"王中","text":"山中向夕雨初收，窗户无人熠耀流。\n鸣杵几家临积水，征鸿一片度危楼。\n凉阴满地梧桐月，露气涵香薜荔秋。\n谁道平生甘寂寞，梦阑偏忆太平游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春即事","author":"王中","text":"尘事劳劳两鬓霜，愁将清镜阅年光。\n磨砻岁月归吟社，捡束生涯入醉乡。\n草引闲情频怅望，蝶随春梦屡悠扬。\n觉余一啜茶瓯罢，短笛清风正夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高大使吴淞归兴图","author":"陈安","text":"枫落吴江白雁飞，天涯游子正思归。\n香消夜月青绫被，凉入秋风白渼衣。\n江浦蒹葭含宿雨，驿亭杨柳带斜晖。\n分明记得西湖上，载酒兰舟近翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋有感","author":"陈安","text":"画省曾陪冠盖游，华筵诗酒宴中秋。\n星河不动天如水，风露无声月满楼。\n皓齿纤腰催象板，珠帘凉影上银钩。\n于今寂寞江城暮，乌帽西风叹白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题高理瞻所藏小景图","author":"陈安","text":"昔年为客楚江边，雨霁江南二月天。\n杨柳画桥深浅水，桃花春岸往来船。\n新篘白酒浮杯酽，旋买青鱼出网鲜。\n因见画图惊旧梦，东风吹面鬓萧然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哀完者公","author":"刘廉","text":"汝上孤城破，将军百战余。\n敌勍非剧孟，请援失包胥。\n鼓竭悲风劲，弓摧落月虚。\n水盘如剑处，徽芃重欷歔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次复登华盖山","author":"郑昂","text":"野老忧时泪不干，海天低燕麦风寒。\n秦关土蚀铜牙弩，汉殿月明金井阑。\n共喜寇恂重借颍，自惭李愿未归盘。\n江山如画人如玉，破帽空悲管幼安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林处士幽居","author":"郑昂","text":"山篱短短径斜斜，屋子三间竹半遮。\n岁馑无僧供菜把，天寒有鹤守梅花。\n武陵流水非秦世，姑孰青山落谢家。\n共约春晴草芽动，杖藜携酒踏晴沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邵炼师归江阴","author":"陈燧","text":"青门隐者人不识，骑鹤来寻华盖君。\n姹女夜栖丹鼎火，玉妃春绣紫衣云。\n愁闻南国旌旗暗，爱听中天歌吹分。\n此去玄都旧时路，桃花红雨正缤纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别景大","author":"陈燧","text":"力疾微吟苜蓿盘，忽闻君已驾征鞍。\n江湖千里去来易，故旧一樽离别难。\n荒草马蹄山色远，古藤松树莫阴寒。\n钱塘风物归吟稿，须寄山翁洗眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郭外夜归","author":"吴学礼","text":"草田高下乱虫鸣，凉袭衣襟夜气清。\n河汉横秋平野阔，山窗无月一灯明。\n孤蓬倦倚难成梦，宿鸟相呼忽转更。\n近郭不妨归近夜，到门犹有读书声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊横春馆","author":"吴学礼","text":"枯葑冰消水路遥，短长亭下一停桡。\n寒烟两岸客炊晓，残月小桥人待潮。\n山外钟声何处寺，柳边春入隔年条。\n到城不必争先后，华盖峰头手可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]