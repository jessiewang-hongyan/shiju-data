[{"title":"铜陵执热书怀十首，时苦旱 其七","author":"邓云霄","text":"吾家有丛竹，下映碧潭幽。\n过夏疑无午，含风早觉秋。\n茶瓜时可禦，童冠日同游。\n一别红尘远，星霜已八周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜陵执热书怀十首，时苦旱 其八","author":"邓云霄","text":"铜陵虽执热，犹胜在吴门。\n已脱簿书累，而无车马烦。\n下帘成小隐，对客祗清言。\n悟得逍遥理，凉风满北轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜陵执热书怀十首，时苦旱 其九","author":"邓云霄","text":"忽忆弹清角，呼儿理素琴。\n弦长知调古，夜静觉堂深。\n山水千秋意，鸾皇此夜心。\n客愁连玉轸，早已变南音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜陵执热书怀十首，时苦旱 其十","author":"邓云霄","text":"新茶烹顾渚，寒簟展湘波。\n睡破一床月，清消午夜魔。\n暑深秋气近，帘静砌虫多。\n节序催乡思，临风发浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"久旱戏柬黎明府","author":"邓云霄","text":"云拥奇峰暑未残，江焦石烂几时安。\n望中雷雨过傍邑，仙令元来是灌坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山城","author":"邓云霄","text":"返照落平芜，山城晚眺孤。\n岚光藏雾豹，江影舞樯乌。\n远屿涛声壮，层台暑气无。\n松楸归思急，不是为莼鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑朝","author":"邓云霄","text":"琴书静扫一虚堂，短榻临阶月浸床。\n怪底朝来肌骨冷，微风昨夜入清商。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黎明府南楼玩月","author":"邓云霄","text":"云物迎秋暑力微，大江高阁对清辉。\n光翻贝阙龙初醒，轮度银河鹊欲飞。\n渔浦寥寥闻远笛，村砧片片急寒衣。\n谁怜王粲伤留滞，作赋荆门尚未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又同黎明府游铜官山二首 其一","author":"邓云霄","text":"美人如玉树，作令得铜官。\n望气千峰紫，清谈六月寒。\n讼庭多暇日，幽境洽馀欢。\n归路澄湖晚，仙城隔水看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又同黎明府游铜官山二首 其二","author":"邓云霄","text":"山水元同调，烟霞引兴长。\n杯从莲社合，人似竹林狂。\n醉倚山公马，衣分荀令香。\n独怜离思促，蒹葭欲苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别黎明府却寄","author":"邓云霄","text":"棋局壶觞日往还，怜君卧治别来闲。\n寄声江上天王岭，何异城头姑射山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"皖城逢立秋","author":"邓云霄","text":"乡程迢递杳难期，又见江亭一叶飞。\n日月不饶孤客鬓，烟霞长护钓鱼矶。\n杜蘅远望愁堪结，鸿雁南还喜并归。\n欲挽银河洗残暑，夜来凉露湿征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜鸣榔歌","author":"邓云霄","text":"天上白榆历历光，夜深倒种江中央。\n骚人散发歌沧浪，鸣榔一啸雄风长。\n河转漂星低可摘，寻源忽忆乘槎客。\n挥手高攀织女机，不须更问君平宅。\n丹枫红蓼怨秋容，秋思人间几万重。\n借问横江徒梦鹤，何如天上跨茅龙。\n茅龙缥缈入空飞，云水高寒冷客衣。\n自有明霞裁玉女，更将江练剪湘妃。\n仙家不羡人间乐，素心一片秋寥廓。\n厌听江州商妇弦，还羞河畔看灵鹊。\n已知去住本随缘，一任秋江淹旅泊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过望江赠袁伯益二首 其一","author":"邓云霄","text":"为忆陈蕃榻，能回叔夜车。\n交情千里外，往事十年馀。\n暂聚惊分手，凭谁慰索居。\n秋江新雁过，莫惜数行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过望江赠袁伯益二首 其二","author":"邓云霄","text":"相逢成一笑，惜别转凄然。\n客鬓西风里，离亭落木边。\n班荆同此日，结社更何年。\n仕路迷津久，相期早著鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出伏","author":"邓云霄","text":"江行逢出伏，枫叶早知秋。\n霞带新鸿去，帆拖片两收。\n浮生空复尔，大药竟难求。\n莫道金风爽，萧萧起旅愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马当","author":"邓云霄","text":"共讶马当险，行来自觉平。\n风波不起处，鹳鹤两和鸣。\n柁背吴天杳，帆冲楚塞晴。\n遥听崖叶堕，淅淅助秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小姑二首 其一","author":"邓云霄","text":"过雨延新爽，秋江正耐看。\n小姑初沐罢，一镜晓妆残。\n霞佩摇空翠，云衣怯早寒。\n淩波朝复暮，独立尔应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小姑二首 其二","author":"邓云霄","text":"化石照江心，空山若有人。\n帘栊收宿雨，罗袜不生尘。\n青鸟频通信，蓬山几问津。\n寄言作赋客，休拟楚台神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖口逢故人之蜀","author":"邓云霄","text":"江湖落魄竟何如，昔别十年无尺书。\n苍龙袖里涩古色，碧草岭外怨离居。\n停舟把臂回白眼，秉烛酌酒脍神鱼。\n明朝解缆各南北，看月峨眉一望予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔阳江闻笛","author":"邓云霄","text":"西风瑟瑟吹寒莎，野笛如啼又似歌。\n砍竹定遇武昌老，抆泪尚咽湘江蛾。\n鱼龙欲睡移深浦，鸿雁惊飞掠远波。\n试问当年白司马，琵琶幽怨较谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望匡庐戏作五老歌","author":"邓云霄","text":"天边五老匡庐友，冥冥呼吸通南斗。\n掀髯箕星忽箕扬，长风吹落彭湖傍。\n湖上落星石，箕星化下□。\n群仙诉帝帝不怒，犹遣白龙驱瀑布。\n飞流一洗南箕羞，更与老人清杖屦。\n锦屏之下置香炉，俨若仙家祝寿图。\n为问泰山丈人石，近时书信有耶无。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖七夕","author":"邓云霄","text":"箕星好风喧上都，帝呵一夕谪鄱湖。\n谪来骄蹇犹狂粗，横鞭屏翳驱天吴。\n浪头高蹴银河水，乌鹊成桥忽倾圯。\n织女妆残愁不理，支机有石自难支。\n巧既莫施将乞谁，脉脉洪波徒尔为。\n西方月蛾窥冷笑，玉蟾香桂森相照，风波不到琼房悄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南昌即事","author":"邓云霄","text":"江湖襟带洪都郡，食鼎鸣钟几万家。\n彭蠡涛声摇铁柱，匡庐晴色映龙沙。\n云霞楼阁今犹壮，宾主东南昔共誇。\n遥望丰城知不远，更携雄剑问张华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续梦","author":"邓云霄","text":"旅榜依牛渚，清风满葛巾。\n澄江空对月，咏史更何人。\n酹酒唁狂客，燃犀辟水神。\n名高前后事，同是梦中身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其一","author":"邓云霄","text":"断虹呼飓母，津吏笑相迎。\n且慎风涛险，维舟缓去程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二","author":"邓云霄","text":"挂帆鸣越榜，击汰奏吴歌。\n休讶江行险，人间孰不波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其三","author":"邓云霄","text":"寒潮销铁锁，浪打石头城。\n莫问隋堤柳，徒伤远客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其四","author":"邓云霄","text":"江白郎如练，江青好染衣。\n不须施粉黛，隔浦见湘妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其五","author":"邓云霄","text":"夜静客帆稀，渔舟尚未归。\n问君何泛泛，浮宅本无依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其六","author":"邓云霄","text":"罗袖倚青荷，新妆映碧波。\n声从香里度，知是采莲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其七","author":"邓云霄","text":"最爱曲无毒，偏怜蟹有螯。\n舟中无所事，痛饮读离骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其八","author":"邓云霄","text":"孤棹迎风退，鹢人何日归。\n船头虽画鹢，犹作宋都飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其九","author":"邓云霄","text":"万树带鸣蝉，秋思满暮天。\n东流无尽日，不与驻华年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十","author":"邓云霄","text":"停桡惜余景，晚泊烟波静。\n颇怪行汲者，动摇山水影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十一","author":"邓云霄","text":"一带江村好，柴门水竹居。\n主人招海鸟，僮仆厌溪鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十二","author":"邓云霄","text":"江上闻长笛，能吹出塞声。\n衰杨秋折尽，孤客若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十三","author":"邓云霄","text":"月落西风急，秋萤点点流。\n却疑江上女，半夜弄珠游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十四","author":"邓云霄","text":"擘破双莲子，冰肌抱苦心。\n搴芳何限意，肠断为知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十五","author":"邓云霄","text":"舟楫几时闲，乘潮日往还。\n欲知潮尽处，咫尺是蓬山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十六","author":"邓云霄","text":"连日江云暗，今朝眼倍明。\n酒徒非爱酒，倩作斩愁兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十七","author":"邓云霄","text":"宿桨依村落，颇闻农者言。\n秋檐鸡黍熟，真乐在田园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十八","author":"邓云霄","text":"江上逢渔父，今时几逐臣。\n遥传一掬泪，为我吊灵均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其十九","author":"邓云霄","text":"隔船弦索响，人说到江州。\n司马当年泪，犹分九派流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十","author":"邓云霄","text":"彭蠡雨霏霏，匡庐隐翠微。\n不知瀑布落，错认白龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十一","author":"邓云霄","text":"片雨过孤村，晚溪晴洗马。\n复有如花人，浣纱明月下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十二","author":"邓云霄","text":"浦溆人家少，柴门白屋贫。\n年来增矿税，多作异乡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十三","author":"邓云霄","text":"野村无犬吠，夜哭绕秋云。\n处处诛求尽，哀声不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十四","author":"邓云霄","text":"秋裳堪制芰，午醉亦餔糟。\n孰识乾坤意，往来半反骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十五","author":"邓云霄","text":"雁回应蛩吟，萧萧落叶暮。\n谁知天籁鸣，尽是秋声赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十六","author":"邓云霄","text":"缥缈顺风舟，玲珑倚岸楼。\n思归与望远，两意各悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十七","author":"邓云霄","text":"泊滩樵且爨，晚兴倚芳洲。\n秋色行看老，芦花已白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十八","author":"邓云霄","text":"夕阳生晚愁，杜蘅秋浦阔。\n欲采寄远人，可望不可掇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其二十九","author":"邓云霄","text":"冉冉江上枫，丹青向来变。\n不信有炎凉，请看秋后扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上行三十首 其三十","author":"邓云霄","text":"社近燕怀归，呢喃逐队飞。\n能无怜旧垒，故国在乌衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词四首 其一","author":"邓云霄","text":"禹甸尧封乐太平，芳年淑气满神京。\n璇霄日映龙文合，宝幄兰销瑞雾清。\n上苑预催游猎宴，西场初歇打球声。\n夜来谁得君王宠，舞马妖鸡尽赐名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词四首 其二","author":"邓云霄","text":"万国时康赐大酺，六宫仙酒引醍醐。\n华清浴后摇红玉，香径人归步锦铺。\n南内歌声传晓漏，东方日影散啼乌。\n犹闻别院留王母，绛雪玄霜近到无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词四首 其三","author":"邓云霄","text":"元夕鳌山烂熳游，蹙金奇服异宸旒。\n广寒移下随龙仗，玉女飞来集凤楼。\n星错华灯迷陆海，风吹仙曲满皇州。\n彩云更指维扬路，传诏文成已拜侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词四首 其四","author":"邓云霄","text":"玉蝀金鳌别有春，上元遥泛碧桃津。\n霞遮龙舸翻成幄，香度琼楼散作尘。\n纨扇暗题班氏女，绛帏空忆李夫人。\n妆残更学侯门巧，堕马啼眉事事新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豫章寄楚中故人","author":"邓云霄","text":"湘水浮云望转迷，离情一片楚天低。\n衡阳已恨无来雁，况在衡阳又更西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八滩","author":"邓云霄","text":"危滩十八名，浮客转多惊。\n水性岂知险，人心自不平。\n垂堂须止足，洗耳喜同清。\n更忆吕梁叟，长歌散发行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滩上人家","author":"邓云霄","text":"鸟道云生石，人家水绕门。\n滩淙时乱听，鸡犬不闻喧。\n沙蜮窥渔网，山魈啸猎原。\n畏途逢九折，归思逐波翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣江","author":"邓云霄","text":"章贡分危濑，孤城控合流。\n野桥穿虎穴，云碓落龙湫。\n地热清砧少，田肥晚稻稠。\n山川连楚粤，幕府借持筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度梅关","author":"邓云霄","text":"扰扰嗟行役，风尘老客颜。\n车从叱驭度，人是□□还。\n鸟道千岩合，羊肠一径攀。\n粤天南望尽，云际认乡关。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅关道上古松歌","author":"邓云霄","text":"梅关夹道多古松，老龙鳞鬣争摩空。\n怪鸟时呼幽壑风，涛声万派山汹汹。\n客行八月方病暍，萧瑟对此如寒冬。\n苍颜可入韦偃画，行者息肩骑者下。\n亭午飕飕竽籁清，太阴黯黯云雷挂。\n日轮月驭回高枝，木魅山精避深夜。\n君不见泰山顶、徂徕巅，栋梁剥落大夫老，至今芳誉流青编。\n何如岭外冲南斗，粤天浩荡开元后。\n传闻植自曲江手，嶙峋气节俱不朽。\n神明呵护当再拜，仰止高山几回首。\n松上悬丝下有苓，花香叶苦通仙灵。\n谁能筑室依岩扃，花可酿兮苓可烹。\n科头箕踞烟霞里，下看度岭人如蚁。\n往来名利空老死，投簪服食果宿诺，我欲从之赤松子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"英州道中","author":"邓云霄","text":"丹岸锦石映行舟，水碧沙明散旅愁。\n几处刈禾依夕浦，谁家吹笛倚江楼。\n川回日暖犹含暑，山晚岚昏始觉秋。\n久客归心催落叶，榜歌乘月下中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"倦客","author":"邓云霄","text":"奚囊无长物，孤剑倚空镡。\n已厌宦途恶，方知野兴甘。\n入门童稚喜，一径蝶蜂酣。\n莫问王程急，山中且结庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"展二亲墓","author":"邓云霄","text":"酹酒荒阡草色殷，愁云苦雾结哀颜。\n痛将满掬风前泪，洒向他年梦里山。\n霜露渐看秋又老，松杉宁有鹤飞还。\n栖乌昨夜号寒月，不觉朝来鬓已斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同旧社中诸子集揖仙楼有感畴昔","author":"邓云霄","text":"六载微官叹陆沉，开尊真见故人心。\n归来尚有陶潜菊，燕喜惭无陆贾金。\n夜雨短檠伤往事，虚堂尘榻对沾襟。\n存亡更切山阳感，含笛休教助苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扫旧日山房","author":"邓云霄","text":"寂寂幽斋半草莱，北山逋客正归来。\n江头渔父休相笑，海上鸥群莫浪猜。\n荒径松篁宜晚对，故人鸡黍得重陪。\n含香襆被浑闲事，五柳惟知浊酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]