[{"title":"青楼怨寄郭生 其一","author":"景翩翩","text":"欲歌春望词，谁是知音者？\n门口木兰舟，常系垂杨下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1181,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青楼怨寄郭生 其二","author":"景翩翩","text":"兀坐掩房栊，捧心讵娇态。\n闻说金张儿，懒出堂前拜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1182,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得自君之出矣 其一","author":"马守真","text":"自君之出矣，怕听侍儿歌。\n歌入离人耳，青衫泪点多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得自君之出矣 其二","author":"马守真","text":"自君之出矣，不共举琼卮。\n酒是消愁物，能消几个时？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怆别","author":"马守真","text":"病骨淹长昼，王生曾见怜。\n时时对兰竹，夜夜集诗篇。\n寒雨三江信，秋风一夜眠。\n深闺无个事，终日望归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和诸社长小园看牡丹枉赠之作 其一","author":"马守真","text":"露滋绣萼弄轻寒，把酒同君带笑看。\n忆昔汉宫人去远，阿谁今倚玉阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和诸社长小园看牡丹枉赠之作 其二","author":"马守真","text":"春风帘幕赛花神，别后相思入梦频。\n楼阁新成花欲语，梦中谁是画眉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"延秀阁和顾太湖韵","author":"马守真","text":"飞阁凌云向水开，好风明月自将来。\n千江练色明书幌，万叠岚光拂酒杯。\n何处笛声梅正落，谁家尺素雁初回。\n芳尊竟日群公坐，得侍登高作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄马湘君","author":"梅蕃祚","text":"流澌十月下双鱼，传得金陵一纸书。\n马角未寒盟语后，蝇头犹湿泪痕馀。\n梦中暮雨题难就，镜里春山画不如。\n红杏碧桃千万树，待侬花下七香车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其一","author":"王稚登","text":"歌舞当年第一流，姓名赢得满青楼。\n多情未了身先死，化作芙蓉也并头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其二","author":"王稚登","text":"石榴裙子是新裁，叠在空箱恐作灰。\n带上琵琶弦不系，长干寺里施僧来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其三","author":"王稚登","text":"不待心挑与目招，一生辜负可怜宵。\n祇堪罚作银河鹊，岁岁年年只驾桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其四","author":"王稚登","text":"黄金不惜教婵娟，歌舞于今乐少年。\n月榭风台生蔓草，钿筝锦瑟化寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其五","author":"王稚登","text":"明珠缀在凤头鞋，白壁雕成燕子钗。\n换得秣陵山十亩，香名不与骨俱埋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其六","author":"王稚登","text":"舞裙歌扇本前因，绣佛长斋是后身。\n不逐西池王母去，定随南岳魏夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其七","author":"王稚登","text":"水流花谢断人肠，一葬金钗土尽香。\n到底因缘终未绝，他生还许嫁王昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其八","author":"王稚登","text":"平生犹未识苏台，为我称觞始一来。\n何意倏然乘雾去，旧时门户长青苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其九","author":"王稚登","text":"佛灯禅榻与军持，七载空房只自知。\n试向金笼鹦鹉问，不曾私畜卖珠儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其十","author":"王稚登","text":"兰汤浴罢净香熏，冉冉芳魂化彩云。\n遗蜕一坯松下土，只须成塔不须坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其十一","author":"王稚登","text":"红笺新擘似轻霞，小字蝇头密又斜。\n开箧不禁沾臆泪，非关老眼欲生花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马湘兰挽歌词 其十二","author":"王稚登","text":"描兰写竹寄卿卿，遗墨都疑泪染成。\n不遇西川高节度，平康浪得较书名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过湘兰故居","author":"姚旅","text":"曲榭残烟里，佳人昔此居。\n花犹笼锦瑟，苔自绣帷车。\n女侠名徒在，江神佩已虚。\n销愁不道酒，留恨若教除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过马姬湘兰废居","author":"陈玄胤","text":"树结寒阴鸟自啼，青楼闲琐板桥西。\n纱窗色改粘蜗壳，绣户香销冷麝脐。\n零雨残云春梦断，落花荒藓夕阳低。\n芳名犹在风流尽，烟水年年绕旧堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋对客","author":"赵今燕","text":"月从今夜满，秋向此时分。\n莫惜金尊数，清光喜共君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王仲房还新安","author":"赵今燕","text":"暮雪江南路，孤城尊酒期。\n殷勤折杨柳，还向去年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"燕来","author":"赵今燕","text":"独坐掩罗帏，愁看双燕飞。\n思君不如燕，一岁一来归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆故居","author":"赵今燕","text":"柳絮春泥玉垒封，珠帘深锁暮烟浓。\n分明记得双栖处，梦绕青楼十二重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"续首句成韵 其一","author":"赵今燕","text":"桃源人去绛帏寒，强折花枝带笑看。\n月上梅梢空有影，风吹柳絮不成团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"续首句成韵 其二","author":"赵今燕","text":"桃源人去绛帏寒，万树桃花春未残。\n洞口有云留白鹤，人间无路见青鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄陈八玉英时留姑苏","author":"赵今燕","text":"何处箫声独上楼，伤心桃叶水空流。\n一从南国春销后，谁复佳人字莫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮春江上送别","author":"赵今燕","text":"一片潮声下石头，江亭送客使人愁。\n可怜垂柳丝千尺，不为春江绾去舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张幼于还吴门","author":"赵今燕","text":"花前双泪湿衣裾，把酒江亭落日馀。\n此去吴江霜月满，逢人好寄洞庭书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送沈嘉则游广陵","author":"赵今燕","text":"秋风吹送木兰舟，处处青山待隐侯。\n莫向青山歌玉树，扬州花月使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对月","author":"朱无瑕","text":"一帘明月白纷纷，宝鸭香消欲断魂。\n侍女错传心上事，错将花柳怨黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闺梦","author":"朱无瑕","text":"清霜飞急漏声迟，遥夜孤帏忆别离。\n幽梦欲成明月去，却凭何处照相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋闺曲","author":"朱无瑕","text":"芙蓉露冷月微微，小院风清鸿雁飞。\n闻道玉门千万里，秋深何处寄寒衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春闺","author":"朱无瑕","text":"春和喧百鸟，寂寞坐春朝。\n蝉鬓少新洗，卖花声过桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芭蕉雨","author":"朱无瑕","text":"滴破愁中梦，听残叶上声。\n新诗题未得，偏送别虽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得霜上月","author":"朱无瑕","text":"夜色凉如水，霜华共月明。\n谁招青女出，来伴素娥行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游子","author":"朱无瑕","text":"北雁竞南飞，寒风正凛冽。\n客思倦长途，妾心伤久别。\n厌闻残漏声，愁见不圆月。\n日日数归期，空教泪成血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春闺怨","author":"朱无瑕","text":"学语新莺惊梦起，红妆满树催桃李。\n年华不管是风情，十二阑干春独倚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秦淮别怨诗赠期莲生","author":"郑如英","text":"秦淮二月新柳黄，折柳贻人人断肠。\n可怜袅袅秦淮柳，今朝又上离人手。\n离人手把柔条看，柔肠低拂紫骝鞍。\n紫骝欲嘶人落泪，谁当此际犹能醉。\n绸缪执手问前期，莲子花开是到时。\n但恐见莲君不见，令人空忆桃花面。\n青青草色长干道，偏使离人颜易槁。\n秦淮上流即丰溪，我心随水不复西。\n请看不断秦淮水，有心宁不相思死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留秋送刘冲倩","author":"郑如英","text":"我欲留秋住，寒衣不忍裁。\n归期何用速，尚有小桃开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答潘景升寄怀","author":"郑如英","text":"投我以明镜，照妾如蓬首。\n报以凝桂脂，馀膏染君手。\n遗我屑金墨，报君芙蓉纸。\n含毫若有怀，应念人千里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闺怨","author":"郑如英","text":"曲曲回廊十二阑，风飘罗袂怯春寒。\n桃花带雨如含泪，只恐多情不忍看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中送期莲生","author":"郑如英","text":"执手难分处，前车问板桥。\n愁从风雨长，魂向别离销。\n客路云兼树，妆楼暮与朝。\n心旌谁复定，幽梦任摇摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日寄怀 其一","author":"郑如英","text":"沉沉无语意如痴，春到窗前竟不知。\n忽见寒梅香欲褪，一枝犹忆寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日寄怀 其二","author":"郑如英","text":"月露西轩夜色阑，孤衾不耐五更寒。\n君情莫作花稍露，才对朝曦湿便乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日泛湖忆旧 其一","author":"马圭","text":"自昔湖山罗绮春，客中君喜及花辰。\n开尊向午催开舫，问水临沙拜问人。\n踏遍莎痕还碧嫩，眠馀柳色转清新。\n独怜车马多非故，歌舞依然十里尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日泛湖忆旧 其二","author":"马圭","text":"一只兰舟几日湖，同心暗结事难图。\n比来西子应无主，何处罗敷自有夫。\n沙暖燕归春阁早，醉馀人别暮桥孤。\n年年只解看花到，草色今朝独吊苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日泛湖忆旧 其三","author":"马圭","text":"春风堤柳碧初齐，不异芳游若异蹊。\n屟响空郎书舍里，泪痕渍姊墓田西。\n琵琶旧曲难为听，壶缶新醪自在携。\n但见青骢偏入感，可知日懒踏花堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日泛湖忆旧 其四","author":"马圭","text":"若个钗行忆昔招，曲池阡水渐萧萧。\n浪翻金锦犹馀丽，花落胭脂尚带娇。\n绮席已更莲叶舸，彩绳又挂绿杨桥。\n相逢此后欣非晚，荡桨从君不记朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过马十娘墓 其一","author":"马如玉","text":"南国容华谢，西陵松柏蕃。\n妍媸终有尽，修短复何言。\n舞态翔归鹤，歌声哽夜猿。\n伤情同伴女，时一吊高原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过马十娘墓 其二","author":"马如玉","text":"花月人千古，乾坤土一抔。\n霜疑铅粉剩，苔认翠钿留。\n孤冢埋幽恨，寒烟怆暮愁。\n相看怜病骨，清泪洒松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"烛花","author":"马如玉","text":"银烛透银帘，兰房瑞色融。\n丹葩应妒月，紫烬却愁风。\n杯映珠还浦，光流星度空。\n无香辜恋蝶，有焰引飞虫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斗草","author":"马如玉","text":"撷翠游芳陌，搴英度翠池。\n戏争人胜负，惊散蝶雄雌。\n莫折忘忧草，偏怜蠲忿枝。\n缤纷宁健羡，终委道旁泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蹴鞠","author":"马如玉","text":"腰支袅袅力微微，滚滚红尘拂羽衣。\n掩月鬓边星独坠，石榴裙底凤双飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"茅山道中送邢使君之西湖","author":"马如玉","text":"郎趁仙槎趁晚风，妾乘油壁入云中。\n寻常一样天边月，临水登山望不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别黄玄龙绝句 其一","author":"崔嫣然","text":"昨夜罗帏始觉霜，月中疏柳一时黄。\n晓灯欲暗将离室，不道离人畏曙光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别黄玄龙绝句 其二","author":"崔嫣然","text":"九月江南似小春，偷春花鸟殢归人。\n妆楼直对长干道，愁见行车起暮尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别黄玄龙绝句 其三","author":"崔嫣然","text":"枫落鸦翻秋水明，长桥衰柳古今情。\n从来歌板银罂地，多为伤离不忍行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别黄玄龙绝句 其四","author":"崔嫣然","text":"华裾赋别酒初醺，《水调》吴歌夜入云。\n此曲由来能解恨，一时凄切半缘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别孙子真","author":"郝文珠","text":"江左多名彦，惟君独擅奇。\n兴公山入赋，摩诘画兼诗。\n地忆重游处，人怜再晤时。\n分携且莫恨，千载托心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张隆父还闽","author":"郝文珠","text":"一曲春风酒一卮，渡头杨柳不开眉。\n从今海路三千里，有梦为云到也迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"帆影","author":"张回","text":"劳劳亭次别，无计共君归。\n一叶随风去，孤帆挟浪飞。\n目穷河鸟乱，望断浦云非。\n只在天涯畔，伤心隔翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答林景清","author":"杨玉香","text":"销尽炉香独掩门，琵琶声断月黄昏。\n愁心正恐花相笑，不敢花前拭泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨夜","author":"薛素素","text":"江城漏转夜超超，坐向芳尊叹寂寥。\n挑尽银灯愁不尽，满庭疏雨湿芭蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画兰竹题赠苏时钦","author":"薛素素","text":"翠竹幽兰入画双，清芬劲节伴闲窗。\n知君已得峨眉秀，我亦前身在锦江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀人诗","author":"薛素素","text":"良夜思君归不归，孤灯照客影微微。\n携来独枕谁相问，明月空庭泪湿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1249,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游韬光庵与沈千秋分韵作","author":"周文","text":"转径白云近，回风清磬残。\n霜花欺客眼，江雁怯秋翰。\n片石泉声细，千峰日影寒。\n烟深鸟不语，归路已漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1250,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋鸳湖夜别","author":"周文","text":"泣别鸳鸯湖，湖流泪不竭。\n去住无两心，水天有双月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1251,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴江夜泊 其一","author":"周文","text":"去魄如秋水，清晖未破云。\n眼看林影黑，何处照离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1252,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴江夜泊 其二","author":"周文","text":"月明波上白，风送夜声寒。\n数点蒹葭露，浑疑泪眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1253,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴江夜泊 其三","author":"周文","text":"愁人几点泪，不许秋风吹。\n吹入吴江里，江流无尽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1254,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中春道中送别","author":"周文","text":"酒香衣袂许追随，何事东风送客悲。\n溪遂飞花偏细细，津亭垂柳故丝丝。\n征帆人与行云远，失侣心随落日迟。\n满目流光君自惜，莫教春色共差池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1255,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日过吴门感旧","author":"周文","text":"香残带缓不胜愁，又见萧条一片秋。\n身到故乡翻是客，心惟明月许同舟。\n数声新雁凌江下，几点寒鸦逐水流。\n遮莫平生多少恨，闲吟欹枕更悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1256,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]