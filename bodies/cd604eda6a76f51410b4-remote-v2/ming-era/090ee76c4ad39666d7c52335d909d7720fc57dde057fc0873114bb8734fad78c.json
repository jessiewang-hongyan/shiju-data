[{"title":"矩洲杂咏五十首 其十九","author":"黄衷","text":"破釜曾无并日储，岩龛一席亦摊书。\n昔人若道无奇迹，草野何因有毁车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十","author":"黄衷","text":"箬笠修髯削玉身，顾予谈笑出风尘。\n石桥挥手终辞去，似是朱明洞里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十一","author":"黄衷","text":"箕踞荔阴闻鸟韵，回牛自逐来潮信。\n儿童路口笑相呼，矶脚筠篮有桑椹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十二","author":"黄衷","text":"久坐书床体力疲，柴关小立瘦藤支。\n憧憧镇日如流水，不问那知我是谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十三","author":"黄衷","text":"荜门居士古贤流，结屦元为易粟谋。\n三日桥边人不售，城中怪道缺云头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十四","author":"黄衷","text":"寰中几个闻鸡起，江上千艘缚鸭回。\n山鬼见时应冷笑，不知献颂有人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十五","author":"黄衷","text":"山欲升云晓气多，晚江风顺客帆过。\n閒人坐起少尘想，一对江山一放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十六","author":"黄衷","text":"江南千载尚仪形，鼎轴真同海燕轻。\n唐史后来谁捉笔，谩教房杜擅前名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十七","author":"黄衷","text":"洛水当时起卧龙，中朝名姓到儿童。\n一心天下忧都遍，浪得人称独乐翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十八","author":"黄衷","text":"仙游阁上想遗真，翔凤宁烦六诏频。\n蒲涧寻盟谁许伴，清泉白石自粼粼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其二十九","author":"黄衷","text":"千年赣石作安流，台谏才名六一俦。\n庙貌未成孤使节，至今遗恨满邕州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十","author":"黄衷","text":"上殿弹文皎日明，缒城偏见济时情。\n荆榛满地先高蹈，留与青编世上名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十一","author":"黄衷","text":"浮云日日换晴阴，林莽交加一径深。\n幽事满前看不定，高歌时发变商音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十二","author":"黄衷","text":"绕篱黄蝶闭关时，儿扫溪房爇柏脂。\n穷日一餐仍笋蕨，居然僧味欠披缁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十三","author":"黄衷","text":"蓬扉一扫马蹄尘，耒耜长随布谷春。\n不是衣冠不相惜，老夫元是老农身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十四","author":"黄衷","text":"远游歌罢卜居成，回首风波梦亦惊。\n可是穷愁似春草，每逢岐路剪还生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十五","author":"黄衷","text":"谩与闲林较浅深，肯将孤介混鱼禽。\n陈留老父为谁者，惠我千秋金玉音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十六","author":"黄衷","text":"匹士从来足国华，未应盐坂滞神骅。\n谁知江左清谈地，更有忠臣孝子家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十七","author":"黄衷","text":"方术争传内外丹，汞烟飞尽黍珠寒。\n无穷荒草埋仙骨，天上徒闻白玉棺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十八","author":"黄衷","text":"吹铙江上应鸣鼍，共道南夷贡象过。\n光耀定如唐二鸟，诗声吾愧老韩多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其三十九","author":"黄衷","text":"明时潦倒甘迂腐，岂有奇馀关宿度。\n空林惯见瞽翁过，隐几贪听鬼谷数。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十","author":"黄衷","text":"鼓角城头杀五更，瑶空太白尚西行。\n飞铃偏绕游仙枕，搅得周公梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十一","author":"黄衷","text":"白头野老对门居，早起曾收蛋客书。\n试问书中何所有，江乡四月上银鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十二","author":"黄衷","text":"盘云绛鹤凤相随，见说神翁海上骑。\n虾鳝一餐曾未饱，无人不看是清姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十三","author":"黄衷","text":"短翎斜日谩差池，黄口同栖只一枝。\n滚滚缁尘骑马路，几人回首见鸒斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十四","author":"黄衷","text":"尘里那能了世缘，市门行尽即林泉。\n凭谁寄谢丹青笔，安得风流似辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十五","author":"黄衷","text":"逃名唯有一渔竿，何必芬芳比蕙兰。\n时主亦知怜晚节，满朝歌赋饯黄冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十六","author":"黄衷","text":"草木无言亦有情，并花连理总春荣。\n数残归雁无单影，想为芙蓉落化城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十七","author":"黄衷","text":"独笑亭中独笑人，何年散发跨麒麟。\n秋风白遍郊东草，午夜空逢梦里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十八","author":"黄衷","text":"三年湘汉滥旌麾，棠茇谁云系去思。\n石鼓山头清夜月，至今空照武侯祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其四十九","author":"黄衷","text":"十二峰头望白盐，我行三月麦渐渐。\n呵钱欲问成都卜，只道君平已下帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲杂咏五十首 其五十","author":"黄衷","text":"捧杖闲随只小傒，奇峰长照水东西。\n幽人自是多幽思，庭下夷犹白宦鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南皋暮春入蒲涧四首 其一","author":"黄衷","text":"药日安孤梦，花期羡胜游。\n峰晴云有态，江迥水明眸。\n谷似泉声应，人缘履坦幽。\n苍崖留秀句，聊以散清愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南皋暮春入蒲涧四首 其二","author":"黄衷","text":"出廓振初服，登山寄远心。\n春杯临广莫，僧钵汲清深。\n景驻青蒲节，盟寒白石林。\n安期不可见，真迹想孤岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南皋暮春入蒲涧四首 其三","author":"黄衷","text":"国士宁辞老，奚囊未惮虚。\n龟灵依涧壑，犊扰戏郊墟。\n道古文车稳，林荒石蹬疏。\n廉泉应可挹，肺病有相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南皋暮春入蒲涧四首 其四","author":"黄衷","text":"斋磬微香积，玄谈秘法华。\n调同耽寂寞，德爱奉柔嘉。\n谁扫三生石，僮攀百合花。\n所思明月里，林杪看神蛙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中拨闷四首 其一","author":"黄衷","text":"自隔清明雨，寒欺敝纩轻。\n且堪愁湿痹，那暇怨沉冥。\n云结虹光隐，阴妨树色荣。\n不知羊仲坞，谁见草莱情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中拨闷四首 其二","author":"黄衷","text":"乾鹊犹藏柳，鸣鸠亦未家。\n市荒鱼特贵，潦进蚬偏赊。\n冻歙青苗跋，泥深紫苋芽。\n最嫌撩夜枕，漫招斗轻蛙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中拨闷四首 其三","author":"黄衷","text":"浃旬檐溜聒，病骨复何如。\n扫地仍焚术，垂帷且掩书。\n暂甘蒲笋美，长恐荔花疏。\n日报催科客，惭称大隐居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中拨闷四首 其四","author":"黄衷","text":"投簪谁谓早，谋拙悔归迟。\n狂极吾忘我，慵来诗戒诗。\n酣怜浮蚁净，老重蠹鱼痴。\n乌饭明朝具，溪翁素可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙巳灯夕立春力病戏笔","author":"黄衷","text":"清时仍忝古稀翁，谩雪芹芽照病容。\n隐隐鼓钟晴挟雨，欣欣桃李白矜红。\n试灯芳夕沾春酌，把火新畬散早农。\n为报游人休尽兴，秾华长在闰正中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答郑凫溪二首 其一","author":"黄衷","text":"捧履长辞圯上翁，邵窝遗我旧从容。\n且堪照眼春湖绿，未羡摇簪胜綵红。\n火树连城通狎客，土牛呈岁赛先农。\n把君昨日琼琚咏，恰是灯前笑语中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答郑凫溪二首 其二","author":"黄衷","text":"芳邻何幸接诗翁，鹤发酡颜总寿容。\n闲玩共怜山月白，狂游谁觉市尘红。\n台登优剧喧童稚，灶卧酤瓴笑老农。\n试向星桥回首望，一时佳气满寰中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读明妃曲","author":"黄衷","text":"汉室徒闻重拓边，安危曾是倚婵娟。\n万千香骨随荒草，只有明妃一曲传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蟠桃喜燕图寿刘梅国","author":"黄衷","text":"上界方壶閟，蟠桃翠海津。\n根株深九地，花实叠千春。\n灵樾依歌凤，玄蹊纵扰麟。\n自随王母驭，尽□汉筵珍。\n鼎剂收霞散，枰嬉博玉尘。\n似闻清浅日，长际寿昌辰。\n灏气沦华夏，穹阶殖甫申。\n至今梅岭表，谁复棘卿伦。\n越俗时评雅，升堂韵格新。\n三州均控扼，七业总儒绅。\n兴薄庐山赋，怀兼铁汉真。\n孤风齐斗岳，晚意付松筠。\n轩盖追贤里，耆英照古人。\n诒谋燕翼远，送喜鹊声频。\n适国嫌携杖，专工笑斫轮。\n不妨加璧至，拟听抑诗陈。\n东海宜杯酌，南山即主宾。\n期颐浑未艾，那羡五朝臣。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠梦山少参大贺赴阙","author":"黄衷","text":"南国春方晏，王程景已长。\n忠函金鉴古，锦导板舆香。\n舜奏薰风永，尧尊御气芳。\n仙筹登凤纪，天乐拥龙骧。\n岭海名藩牧，文章旧夕郎。\n清秋歌湛露，随地足恩光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"畜蜂","author":"黄衷","text":"偶营蜂蜜庐，颇蒙嗜甘訾。\n孰知甚么质，厥赋浑至理。\n作则贻君臣，事述关尹子。\n臭味惟馨香，逐膻恶丛蚁。\n禦侵厉繁虿，鸣衙若刻晷。\n况闻古将旗，义法屯队起。\n我观采芳来，精白尤足纪。\n充腹凡花须，王供负荣蕊。\n分窠首夏间，千百一攸止。\n其王苟摧伤，狼藉群命委。\n西林莳药畦，幽色杂万蘤。\n纷披纵垂芒，鲜洁脾最美。\n嗟嗟饴贩夫，锥刀日中市。\n平生嚼蜡翁，道心谅如水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碌碌篇","author":"黄衷","text":"碌碌困尘土，悠悠怀古先。\n落落委逝波，灼灼皆英贤。\n不见中山酝，一醉日已千。\n会须尽百醉，乾坤任回旋。\n不见游仙枕，心往神翩翩。\n愿安霜雪颅，一梦周八埏。\n红颜岂不佳，静志金石坚。\n白璧岂不佳，介士瓦砾捐。\n文车拥华绣，露槿照荒壖。\n何如卖畚叟，冷笑生霞烟。\n愚智均碌碌，吾人奚较然。\n支颐天全所，长玩秋水篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚庭","author":"黄衷","text":"凉雨到晚庭，月色带檐水。\n幽兰递微芳，候至靡草死。\n飞蚊犹聚雷，熏祛亦未已。\n仙鼠湿翅游，饥吻能有几。\n攲枕闻市喧，城门夜扃弛。\n列炬走饷夫，贼偪近郊垒。\n昼传谍骑报，战甲谩一委。\n病叟卧吞声，鸡号曙光起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李璧山述怀二首 其一","author":"黄衷","text":"秋郊含雨草芽新，委巷谁还数面亲。\n行李十年淹楚越，风流千古想朱陈。\n逃名祇爱三缄口，混世空惭七尺身。\n谩把穷愁疑那老，杜陵元只是孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李璧山述怀二首 其二","author":"黄衷","text":"满幅琳琅句尽新，扫庭长咏荷情亲。\n何曾辟谷能辞汉，恰有炊烟拟在陈。\n芳马试看调鹤诀，垂杨深映狎鸥身。\n一帘永日惟攲枕，甘作明时草莽臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述怀和邓沃泉","author":"黄衷","text":"曾携琴剑楚山栖，桃放仙源路已迷。\n赤壁梦中孤雁杳，黄陵行次一猿啼。\n怜才忍诵思玄赋，吊古空嗟荐福碑。\n岁晚几人同野兴，飞花风外舞鹍鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"责足","author":"黄衷","text":"百骸奉百司，而足荒厥职。\n苦疑海气沦，再恐瘴烟逼。\n中途辍脩程，期十不一即。\n朱门敢趑趄，委巷且偪侧。\n缅怀渊明舆，讵觊凿齿识。\n涪翁隐税监，姚相愁谮贼。\n斯贤苟弃捐，无亦汝作慝。\n况予顽顿姿，跬步如践棘。\n桧杖徒效能，终恨失汝力。\n家山节物天，怅望犹异域。\n医工汤液投，僮仆递按抑。\n何当复素履，庶肜慰衰息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈瑞山侍御","author":"黄衷","text":"独立清台表，重临粤海滨。\n众瞻曾握斧，吏怖旧埋轮。\n秋净千山月，风驱万里尘。\n衣冠趋令望，笳鼓拥新春。\n悬豹宫车壮，栖鸾署禁亲。\n一函多事会，六察盛弥纶。\n共忆巡功大，应知谏气伸。\n衰迟妨祖帐，幸爱济时身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪","author":"黄衷","text":"冬气嫌恒燠，玄冥似力争。\n排林风阵猛，走砌雪珠明。\n冻偪山犍老，狂知市犬惊。\n儿童誇暂见，贮掌弄琼英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雷","author":"黄衷","text":"始岁辰逢四，风雷动夜寒。\n榻虚衾较薄，室暗炬嫌残。\n刁斗严更转，香筒旧梦阑。\n羊占传往事，衰息谩长叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎岭脩墓书感","author":"黄衷","text":"窈窱堂封隔冥途，龙章长为照莱芜。\n千峰月色蹲麟晓，万壑松声吊鹤孤。\n碧落神游知丽日，白头泪迸愧非夫。\n纷丝总拟如心曲，可奈春山杜宇呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自■山过两洞","author":"黄衷","text":"款款平舆览物华，溪桥婉转到山家。\n自携茗钵孤僧逸，并掠风丝小燕斜。\n引目遥峰嫌刺竹，抛肩倦仆藉残花。\n鹧鸪晚傍归霞宿，不信朱明古洞赊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"畜鱼","author":"黄衷","text":"寒泉将雨小池浑，淡淡光风散藻蘋。\n丹鲫腾梭惊燕没，青鲢吹絮趁蛙喧。\n江湖若个长竿伴，日月依然直钓轩。\n最好夜深持烛看，碧虚如镜白波翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳阴","author":"黄衷","text":"闲园迟日柳阴中，小坐还同小隐风。\n旧事纵谈樗里子，野情端近紫溪翁。\n巢成总贺梁间燕，缴远空嗟汉上鸿。\n引□共愁农候晚，劳歌相和水西东。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"接芙蓉桃","author":"黄衷","text":"泫雾笼烟出短垣，轻红叠叠锦绡繁。\n嘉名早擅秋江品，芳裔还移旧圃根。\n恨尽一枝唐御苑，奇传千古晋仙源。\n闲庭风日无多地，欲买江乡种树盆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿沃泉翁八十一","author":"黄衷","text":"共瞻南斗降神时，喜溢帘栊日正迟。\n独把芝英骑白鹿，更披荷叶玩金龟。\n宫袍绣豸真宜老，筇杖栖鸠恰过眉。\n便拟排年陈赋颂，当筵应奏武公诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"开门","author":"黄衷","text":"啼蛄伸蠖晓酣时，树底游丝罥钓丝。\n劲薤含风垂篆籀，嘉蔬瀼露裛琉璃。\n病容久谢陶翁酒，懒性长抛董子帷。\n幽致满前还独赏，海棠枝上啭黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望雨","author":"黄衷","text":"三月骄阳怅旱农，江潭云是巨灵封。\n遗书自起稽繁露，往事空传赛土龙。\n涧口来潮浑爽候，云头将雨谩移踪。\n欲招张角魂何去，未得抽毫思已慵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨至","author":"黄衷","text":"一觞谁把酹先农，化却甘霖偏四封。\n灵石翩翩皆舞燕，玄云霭霭尽从龙。\n抛书且助山翁喜，荷畚宁求野客踪。\n爽气入帏春梦稳，不妨人讶是衰慵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野意四首 其一","author":"黄衷","text":"乌鸦引子随初旭，赤练飞花近晚春。\n自分不如田野叟，浊醪长有俗相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野意四首 其二","author":"黄衷","text":"踏青游子尘随马，垂白山农泪送春。\n时雨不来秧节老，邻庄稀见旧年人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野意四首 其三","author":"黄衷","text":"孤村亭午起炊烟，龙眼花繁似去年。\n蒿雀定应知我浅，惊飞时落涧西田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]