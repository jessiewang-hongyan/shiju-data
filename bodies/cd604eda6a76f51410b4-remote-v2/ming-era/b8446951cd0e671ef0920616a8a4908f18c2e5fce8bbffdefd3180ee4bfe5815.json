[{"title":"白头吟四首 其三","author":"胡应麟","text":"箱中犊鼻裈，碎破不堪著。\n回身掷向郎，将心自摸索。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白头吟四首 其四","author":"胡应麟","text":"当日临邛妻，今朝茂陵妾。\n金茎半勺露，那能救消渴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长史变二首 其一","author":"胡应麟","text":"懊恼爷娘痂，贪他门户热。\n措大作官人，儿命薄于叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长史变二首 其二","author":"胡应麟","text":"宁作中人妇，莫作上官妻。\n风波起平地，山岳移东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捉搦歌四首 其一","author":"胡应麟","text":"爷娘养女儿，但教学针线。\n许嫁前溪郎，十五不相见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捉搦歌四首 其二","author":"胡应麟","text":"采桑南陌头，田间日来往。\n傍人指笑侬，夫婿渐成长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捉搦歌四首 其三","author":"胡应麟","text":"阿母教女儿，殷勤候姑眠。\n女儿问阿母，若为得欢怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捉搦歌四首 其四","author":"胡应麟","text":"十四嫁官人，抱衾作小妻。\n终朝大妇骂，眼泪洗面啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采桑渡二首 其一","author":"胡应麟","text":"不采陌上桑，蚕在筐中饥。\n欲采陌上桑，使君道傍嬉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采桑渡二首 其二","author":"胡应麟","text":"采桑作罗绮，总为他人忙。\n不见长干娼，一曲衣盈箱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雀劳利二首 其一","author":"胡应麟","text":"禾傍雀啄啄，日暮不得饱。\n人生无百年，别家太草草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雀劳利二首 其二","author":"胡应麟","text":"丈夫各有志，不作笼中鸡。\n朝歌猛虎吟，暮从野雀栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白铜鞮","author":"胡应麟","text":"郭郎巾折角，孟嘉帽频落。\n底似山翁醉，接䍦翻转著。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌夜啼二首 其一","author":"胡应麟","text":"期欢中夜来，月光满庭柱。\n展转天欲明，乌啼石城树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌夜啼二首 其二","author":"胡应麟","text":"匆匆金犊车，上路正天晓。\n不恨欢来迟，但恨欢去早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵瑟曲","author":"胡应麟","text":"轻盈窕窈邯郸姬，挟琴鸣弦声乍希，梁尘拂空霜霰飞。\n霜霰飞，云雾集，月西沈，日东出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦笙曲","author":"胡应麟","text":"呼卢一掷百万强，妖姬如花出咸阳，筝声嘹呖夜何长。\n夜何长，管弦列，遏流云，弄华月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南弄","author":"胡应麟","text":"秋江日暮天无云，兰舟桂楫何纷纷，美人如花簇罗裙。\n簇罗裙，斗玉腕，歌采菱，归去晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙笛曲","author":"胡应麟","text":"楚山修竹云团栾，伶伦截管飞青鸾，美人一曲凭雕阑。\n凭雕阑，弄纤手，落梅花，折杨柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤笙曲","author":"胡应麟","text":"红炉炽炭玉筦骄，谁其吹者王子乔，羽衣玉氅行逍遥。\n行逍遥，听仙乐，万桃花，两玄鹤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲五首 其一","author":"胡应麟","text":"步障华灯光照屋，质如轻云色如玉。\n白马金环游狭斜，杨柳啼乌来妾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲五首 其二","author":"胡应麟","text":"郁金为堂玳瑁梁，床上流苏百合香。\n同心宝带合欢结，携手邀郎拜明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲五首 其三","author":"胡应麟","text":"锦幔银屏张五采，华堂宿雾笼香霭。\n此时心意两相怜，含娇顾影不自前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲五首 其四","author":"胡应麟","text":"叠股钗横金凤凰，连环交结双鸳鸯。\n啼乌哑哑楚天曙，荏苒容华逐郎去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲五首 其五","author":"胡应麟","text":"玳筵张烛三星低，罗襟绣褥怯分携。\n郎骑白马去关西，凤凰台前乌夜啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲八首 其一","author":"胡应麟","text":"白草连天大漠秋，千家铙吹古梁州。\n飞霜为洗燕然石，上客新从定远侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲八首 其三","author":"胡应麟","text":"接天烽火照平卢，乍夜单于猎上都。\n十万征人明月里，一时齐挽绣蝥弧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲八首 其四","author":"胡应麟","text":"绝碛霜飞塞草空，燕支晴色乱云中。\n将军醉拥吴钩出，万里霜天照白虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲八首 其五","author":"胡应麟","text":"冢上明妃草色青，征人立马问龙庭。\n西风片月秦城下，愁绝胡笳几处听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲八首 其七","author":"胡应麟","text":"战马骄腾大漠间，遥看敌骑薄阴山。\n横戈不待嫖姚令，静扫边尘入汉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲八首 其八","author":"胡应麟","text":"边烽不动边尘收，刁斗无声夜色流。\n醉杀歌姬油幕底，霜天遥按小凉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫曲四首 其一","author":"胡应麟","text":"昨夜春风拂苑墙，三千南内斗红妆。\n朝来凤辇花前过，报道君王入上阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫曲四首 其二","author":"胡应麟","text":"残雪初消太液前，御沟晴日柳如烟。\n披香殿上承恩早，千缕黄金拂御筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫曲四首 其三","author":"胡应麟","text":"长门花满月华高，云锁珠帘护碧桃。\n夜静南宫歌吹发，新声遥奏郁轮袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫曲四首 其四","author":"胡应麟","text":"玉阶草色上窗纱，深锁葳蕤隔翠华。\n添罢晚妆无一事，白樱桃下试琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋宫词","author":"胡应麟","text":"梧桐飞叶下银床，肠断秋声玉漏长。\n三十六宫明月里，夜听弦管出朝阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行五首 其一","author":"胡应麟","text":"匣底双龙斗色流，长安道上紫骅骝。\n燕姬二八弹筝坐，千树垂杨拂酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行五首 其二","author":"胡应麟","text":"平康归路欲黄昏，下马青蛾白玉尊。\n一曲菱歌挥袂去，月明装束候期门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行五首 其三","author":"胡应麟","text":"五陵楼殿雪初消，玉勒翩翩意气骄。\n落日万家春草外，呼鹰遥过灞陵桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行五首 其四","author":"胡应麟","text":"甲第新开上苑边，满堂花色照婵娟。\n醉携如意阶前舞，七尺珊瑚碎画筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行五首 其五","author":"胡应麟","text":"调鞭徐傍夕阳亭，绣箙雕弧架雁翎。\n夹路万人齐指处，碧天遥堕海东青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑客行","author":"胡应麟","text":"双丸耳畔雪花明，九陌长安任意行。\n片语楼中无处觅，夜飞龙蹻入青城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其一","author":"胡应麟","text":"玉检金泥柱下藏，书成函谷暂徜徉。\n流沙一望三千里，遥跨青牛出大荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其二","author":"胡应麟","text":"玄圃明霞望不穷，金银楼殿碧天中。\n春风似识周王面，乍夜蟠桃万树红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其三","author":"胡应麟","text":"百辟衣冠照鼎湖，轩辕台殿夕阳孤。\n云间独跨双龙背，万顷天风堕鹿卢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其四","author":"胡应麟","text":"七步文章焕斗牛，遮须聊作御风游。\n狂挥大笔天河畔，题遍瑶京十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其五","author":"胡应麟","text":"羽盖如云下夕阳，俱言浮海谒东皇。\n麻姑夜擘红虬脯，指爪偷看一尺长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其六","author":"胡应麟","text":"采石船头月溅衣，长鲸高擘绛霞飞。\n安期一见如相识，指点蓬莱万玉妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其七","author":"胡应麟","text":"洞里青霞照玉盘，飞星群洒石门寒。\n桃花五报西池发，可奈峰头局未残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其八","author":"胡应麟","text":"缥缈飞梁驾赤城，漫劳司马问初平。\n金泥玉版长生籍，同向丹台列姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其九","author":"胡应麟","text":"少室峰高接绛河，千秋词客斗嵯峨。\n谁言不是灵仙骨，遥夜天姝出大罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词十首 其十","author":"胡应麟","text":"海上朱明碧雾流，五仙同跨五羊游。\n何如野客金华洞，卧领群羊十万头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云龙引","author":"胡应麟","text":"芒砀秋空映赭袍，龙光云气与天高。\n五湖何处无明月，斫竹南山坐钓鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后采莲曲二首 其一","author":"胡应麟","text":"画舫青丝荡绿油，罗裙玉腕坐中流。\n生来菡萏元同蒂，若个芙蓉不并头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后采莲曲二首 其二","author":"胡应麟","text":"湖心涛浪拍天流，湖上王孙挟弹游。\n一派莲歌何处起，大堤齐控紫骅骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明妃曲","author":"胡应麟","text":"目断长安汉使来，五云何处是蓬莱。\n龙沙月色三千里，独抱琵琶上紫台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凉州词","author":"胡应麟","text":"静夜流云拂画檐，微风不动水晶帘。\n红牙拍按瑶台上，古调初翻昔昔盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伊州曲","author":"胡应麟","text":"碧天如水暮云收，明月平铺翡翠楼。\n楼上美人三十六，夜弹瑶瑟唱伊州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横江词二首 其一","author":"胡应麟","text":"结束腰肢赛水神，沙棠舟楫往来频。\n江风日暮连天起，愁杀西陵破浪人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横江词二首 其二","author":"胡应麟","text":"扬子江头风色狂，白波如山五丈强。\n自是吴姬惯迎客，来来去去木兰航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行五首 其一","author":"胡应麟","text":"大漠秋风吹铁衣，长城明月满征旗。\n捷书飞奏明光殿，乍夜前军获郅支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行五首 其二","author":"胡应麟","text":"九月边头朔气残，贺兰山北望长安。\n殷勤去雁传消息，欲寄征衣趁早寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行五首 其三","author":"胡应麟","text":"寥天霜色暮凄凄，无定河边落日低。\n欲问轮台前去路，黄云白草遍辽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行五首 其四","author":"胡应麟","text":"吹笛关山月半痕，梅花无数落辕门。\n不知何处旄头现，一夜渔阳万骑屯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行五首 其五","author":"胡应麟","text":"白马将军惯渡辽，笑提金勒扫氛嚣。\n五千剑客当前队，尽款名王入汉朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其一","author":"胡应麟","text":"紫燕双飞拂画梁，雕甍百尺隐垂杨。\n东华门外诸年少，携手先过白玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其二","author":"胡应麟","text":"西第千门簇五侯，御沟春水逐人流。\n罘罳烂漫黄金色，遥指梳妆近妾楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其三","author":"胡应麟","text":"金水桥边一百家，家家帘幕护桃花。\n青衣日暮浓妆出，指点萧郎白鼻騧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其四","author":"胡应麟","text":"珠帘不动控银钩，内苑春光入画楼。\n深夜月明弦管沸，露桃花下合梁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其五","author":"胡应麟","text":"双双罗袜斗凌波，两两沙棠泛玉河。\n日暮大堤流水急，回桡齐唱采莲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其六","author":"胡应麟","text":"别开金屋倚岧峣，白玉河边第二桥。\n夹岸紫骝三十骑，花时齐过董娇娆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其七","author":"胡应麟","text":"绮陌东头接上阳，娉婷年少舞霓裳。\n怪来香阁时常闭，尽日浓妆对海棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北院词八首 其八","author":"胡应麟","text":"灵济宫前翠幕悬，平康门巷百花连。\n西园公子携宾过，十六青娥舞玳筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南院词八首 其一","author":"胡应麟","text":"浮云楼观接蓬莱，五岳三山大内开。\n昨夜春风城外过，千花齐发凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南院词八首 其二","author":"胡应麟","text":"公子连翩挟弹游，垂杨偏拂紫骅骝。\n长干巷里三千队，若个新妆是莫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南院词八首 其三","author":"胡应麟","text":"紫燕衔泥度夕阳，双飞南陌认雕梁。\n高门不用寻王谢，卢女新开白玉堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南院词八首 其四","author":"胡应麟","text":"欢作沈香侬博山，双烟一气紫霞间。\n千门柳色啼鸦暮，自唤情人月下攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南院词八首 其五","author":"胡应麟","text":"桃叶年方十五强，春波摇荡木兰航。\n不知何事归来晚，狂杀王家白面郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南院词八首 其六","author":"胡应麟","text":"万户千门玉作台，春风何地不徘徊。\n乌衣巷口红妆亚，一路歌声斗草回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南院词八首 其七","author":"胡应麟","text":"垂杨千树拂红尘，压酒吴姬动绛唇。\n日暮狂风连袂起，飞花愁杀渡江人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]