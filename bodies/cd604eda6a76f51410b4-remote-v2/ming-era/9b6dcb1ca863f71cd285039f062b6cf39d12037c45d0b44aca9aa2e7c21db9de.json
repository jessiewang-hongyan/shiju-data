[{"title":"德庆城上高望二首 其一","author":"卢宁","text":"迟日危楼闪绛幖，凭高缥缈见龙桥。\n青山隔座横屏嶂，绿峡回澜纳海潮。\n五马神清孤月皎，两岐春煦四郊饶。\n蓬莱东隔沧溟远，夜半如闻玉女箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德庆城上高望二首 其二","author":"卢宁","text":"舟楫西行款政声，晏游酣下寿康城。\n春林带雾楼台隐，叠嶂藏风松桂生。\n陆里耕桑连万井，戍楼烽火熄诸营。\n长官杯斝疑投水，漱玉寒泉到海清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国村亩晓历莲花诸峰最高处","author":"卢宁","text":"径路萦纡接太清，早随弓丈关僧扃。\n振衣直向天头立，弥月都从云上行。\n红溢桑墟先见日，白分牛汉易瞻星。\n肯因险峻辞劳瘁，祈共吾民乐赋平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其一 引路松","author":"卢宁","text":"凤盖高团午荫连，岧峣苍翠上青天。\n交枝树底云长湿，拂雾岩前鹤正翩。\n客误引车掀绿帻，僧閒卓锡听冰弦。\n清时不植东巡怨，风节依稀挺万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其二 云关亭","author":"卢宁","text":"古寺长林怀葛乡，白云关上睆晴光。\n绕栏朝映阳台紫，出岫秋邻粟里芳。\n信节便成游物外，停骖犹自絷名缰。\n愿鞭黄囷携仙逸，共和卿歌补舜裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其三 钵盂峰","author":"卢宁","text":"团峰如铸奠云端，大器何为用世难。\n封植已闻崇肉案，清斋还取尚经坛。\n华夷青玉花同馥，霄汉金茎露自寒。\n拟借四轮输上国，君王丰积寿民丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其四 石笋峰","author":"卢宁","text":"崒玉抽灵森远峤，清苞簇阵锐先锋。\n不须枝附皆成竹，才出陂来便是龙。\n雨过苍玕凌上汉，雪残紫箨挺严冬。\n江城慈母山摇落，谁为移归孝子峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其五 伏虎石","author":"卢宁","text":"地踞虓灵境自豪，威严隐隐震平皋。\n雾迷东海赤刀荣，寒满南山白雪毛。\n飒飒霜风如助啸，凄凄烟树若愁号。\n金陵肯纪安邦绩，请檄边城镇静劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其六 仙女谭","author":"卢宁","text":"玄渚渟渟泛瑞莲，三神山果驾澄渊。\n相传尽道颜如玉，欲到祇愁风引船。\n解佩净依清汉藻，褰裳轻漾紫蒲涟。\n何当洧水多春意，触忤诗人作卫篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其七 香炉峰","author":"卢宁","text":"宝台神器耸蘼芜，彷佛庐山秋雨馀。\n势入紫微承玉座，影连黄道拂祥车。\n清芬静想蒸槐火，绀气晴看薄桂虚。\n欲炷心斋效华祝，帝阍玄默正愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其八 化僧亭","author":"卢宁","text":"白日芬刍度法乘，蜕形西望紫空凌。\n平生会解三真术，投老终传四远灯。\n香革履孤怜达祖，青莲花巧忆图澄。\n相看慧景无虚过，留取萧斋纪旧曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其九 象鼻峰","author":"卢宁","text":"仰沿文祖揖山神，爱尔聪闻独引伸。\n但把羲图占世道，肯随周鼎梦王人。\n半捲玉醴天心露，一喷香云佛面春。\n在处不妨韬大美，可防终老勿焚身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十 水月亭","author":"卢宁","text":"层轩高枕太阴愁，颢影漫漫两象浮。\n通白与心成气合，空明随处共神谋。\n云涛鱼兔多时幻，昼夜乾坤万里秋。\n便拟焚香来晏坐，一江寒练浸银钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十一 狮子峰","author":"卢宁","text":"平川不作河东吼，神岳如从西土还。\n已见锦衣雄虎帐，共贤彤陛犯龙颜。\n铜颅独举寒威重，金斗高悬正气殷。\n猛兽尽潜清兔夜，妖狸无跳白狼山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十二 玉珠泉","author":"卢宁","text":"银河一派泻松风，飞瀑倾泷日激舂。\n寒洁细嘘和露屑，轻圆难定落盘踪。\n甘分袅竹饶春席，泽净平畴慰旱农。\n浅浅磻溪宁滀得，终归沧海媚骊龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十三 观音岩","author":"卢宁","text":"普济慈宗广利门，芝崖彤穴尚阴尊。\n波心水藻媞青鲤，云背珠翚驻玉鹓。\n灵曜金宫流日月，宝陀香篆自朝昏。\n兴亡一慨齐梁事，夜雨寒山愁唳猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十四 碧环亭","author":"卢宁","text":"短草崇兰挹雾扉，东风随处绿依依。\n一湾净绕天光发，八叠芳围昙影晞。\n涓净深偏宜鹭浴，平连高不碍鸿飞。\n坐疑远外无春色，青帝相携上翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十五 白莲池","author":"卢宁","text":"绝尘独有公荷性，尚洁无如大觉仁。\n石井素培千叶种，金沙香绕四全身。\n信门慧植皆成果，化国灵根不待春。\n闻说濂溪花更好，得知爱马是谁贞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十六 方竹林","author":"卢宁","text":"数分天地悬常体，清到琅玕有异仪。\n知是古人遗絜矩，非因时物厌循规。\n虚心自信义长植，危行终为节所奇。\n岁晚他山宁得此，直须栽向凤凰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十七 归一门","author":"卢宁","text":"葶苈须弥无是宗，业缘明觉性灵冲。\n幻烟未灭苦群障，心月当悬色尽空。\n四梵宾从捐赤火，七华玄阖挹光风。\n长罗到此还何事，恨不形骸都自融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十八 芭蕉洞","author":"卢宁","text":"石室阴深草木鲜，更栽凉质养玄烟。\n新心捲露抽鸾轴，旧叶摧风舞凤翩。\n一瓣拟供无量佛，千章堪写白云篇。\n何年选胜耽诸翠，就此移居了太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其十九 月池","author":"卢宁","text":"半亩溶光绿映盈，柳堤蘅岸蔼芳晴。\n窗临石镜天长晓，影湛银蟾气倍清。\n万象虚涵呈太素，一圈无极自天精。\n江湖景色多如此，惟是游人不用情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴国灵山二十景和前令唐子侯氏 其二十 钓桥","author":"卢宁","text":"野岸迂回紫陌通，石桥流水一丝风。\n静看名利驱驰外，早定浮沉物理中。\n熊梦协占师已载，羊裘虽著汉无功。\n夕阳潋滟江光动，清对垂杨绾玉虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"摘花录寄方寒溪文衡山宗瓠川诸旧游","author":"卢宁","text":"掠袖笼冠启绿扉，树头红紫簇朝晖。\n高攀万叶荣随手，斜插一枝香满棑。\n浅甲润沾莺宿露，断芳晴与蝶晞衣。\n叮咛莫把春狼藉，留表江南信息稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵寄友人何瑞坛二首 其一","author":"卢宁","text":"故人书信报苏州，改邑虔南始拜收。\n青鸟翩翩烟岛去，明星灿灿夜窗浮。\n寄怀昆玉惭非宝，拭目池珠惊寡俦。\n便借秋风传半牍，直随云雁送双眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵寄友人何瑞坛二首 其二","author":"卢宁","text":"伐木篇中尚友求，和平今见古风流。\n绮罗俗态一时洗，金石芳心百岁酬。\n意远白华歌大雅，调高玄鹤唳清秋。\n为言宝历文章宴，绝倒元稹还上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天然亭","author":"卢宁","text":"摩诘川中景物晞，不烦栽植自芳菲。\n兰台心远青山待，草阁月明骢马归。\n坐竹静看流水过，移樽閒数落花飞。\n主翁惯得天然趣，直道庸知与世违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东岳醉眺","author":"卢宁","text":"苍帝祠前开锦席，青玕树底读碑文。\n深杯自可宽怀土，一饭谁能忘报君。\n地远祇应瞻紫气，山高赢得望红云。\n朱花瑶草春风媚，对饮何辞落日曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬子冬北上陆行遇风","author":"卢宁","text":"自揲囊箱买辔鞍，朔风吹岸剪眉酸。\n行行呼急征鸿暮，片片飞浮落木乾。\n竹叶浅黄怜力薄，芦花轻白觉衣单。\n笑从吏计围貂领，十载官资换尚难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦城高望","author":"卢宁","text":"濯锦江前万里秋，登临端不限梁丘。\n黑泉白草长年备，朔雪炎风无日休。\n天府文章明梓木，星桥氛祲净灵州。\n即看多士桢王国，肯负玄龟锡禹畴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"来衮亭高望","author":"卢宁","text":"来衮孤峰象太薇，千家井邑应星晖。\n城边二水龙双会，楼外诸山王四围。\n鸿雁西来何落落，云霞南下故飞飞。\n一方黎庶知何济，独对朱轓愁不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登东山寺","author":"卢宁","text":"梓州东寺涪江外，驻马先题大字碑。\n花木阵阳諠翡翠，亭台临水跃罘罳。\n塔酣灵露生朱草，鹤恋昙云复故枝。\n太守散衙无一事，不妨拂石辄盟诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东山寺留别限韵走笔","author":"卢宁","text":"彩鹢欲发涪江涯，攀翻再折青杨枝。\n青杨千缕数不尽，彩鹢一去来何时。\n吴宫花飞莺语切，蜀岭雪滞雁声迟。\n须知丈夫多意气，岂为中年难别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出蜀晓行野望","author":"卢宁","text":"晓起驱车控大堤，残星落落风凄凄。\n水声东去沧溟远，山势西来云岳低。\n行路说夷双刃捷，将军避虏选锋齐。\n绿林何处白莲教，北望青徐烟雾迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆饮西蜀王横水天然亭次韵寄之","author":"卢宁","text":"绿野融融春日晞，茂林脩竹术苗肥。\n峨眉月照清樽酒，巫峡云连白板扉。\n王褒金马诗初就，杨子玄经客正稀。\n东岳山前南国梦，何时重采蜀中薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送章小山擢南雄太守","author":"卢宁","text":"从容幕府孟嘉才，笑傲桓公酒一杯。\n行色未离江上柳，风光先到岭头梅。\n分符横带黄金重，除道遥迎皂盖来。\n他日定徵龚遂问，水衡应有议曹陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋早出太平堤","author":"卢宁","text":"城外长堤散九皋，西风跨马看鸿毛。\n玄湖日破浪花出，钟阜烟晞气彩高。\n绿拥双林迷册府，清分三路入秋曹。\n化深南国无多讼，按辔逍遥拽锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍览牛首山洪觉寺诸胜","author":"卢宁","text":"尽日双峰大觉前，摩崖同饮太虚泉。\n洞深怕犯昙云合，阁闭惊看塔影悬。\n步引健僧凌倒景，目随飞雁散江天。\n桂梅诸岭重重见，无奈乡怀入酒边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿天界寺留半峰上人","author":"卢宁","text":"深巷虚斋草露漙，高僧净戒夜忘寒。\n编篱拟畜白糜鹿，种竹尽长青琅玕。\n山谷七言云里和，楞伽四卷月中看。\n閒来梦觉游禅去，愧尔弥天释道安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺草堂落成","author":"卢宁","text":"为辟云窝附法坛，斩除恶竹可千竿。\n黄金有地还兹布，明镜无台何处安。\n避俗频来依佛榻，论心赢得聚儒冠。\n从前七火都灰未，更向人天一静观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨鸥海台幕邀赏梅花 其一","author":"卢宁","text":"幕府寒蘤冒雪开，赏心共醉凌风台。\n红芳如约年华在，白发无情岁月催。\n门对汉宫看半额，地邻东阁忆多才。\n疏枝欲折酬杨炯，惭向孤山歌八梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨鸥海台幕邀赏梅花 其二","author":"卢宁","text":"绛唇紫颔阵苍苔，笑向樽前慰客来。\n限令不遗姑射侣，陈诗还到柏梁台。\n有怀南国将春寄，入夜谁家吹笛催。\n一自商王收采去，至今同仰济时材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀友寒溪逸史二首 其一","author":"卢宁","text":"江左十年别，儒冠载道身。\n芙蓉峰上月，兰芷意中春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀友寒溪逸史二首 其二","author":"卢宁","text":"聚首忆郎水，赓歌想瓠川。\n金华秋嶂晚，人在白云巅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋蝉","author":"卢宁","text":"蜕落惊形别，风梢苦自吟。\n似怜失故我，故我在芳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍蝇","author":"卢宁","text":"枳棘载飞鸣，屯云过子城。\n花朝当席面，添得蝶蜂清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张罗莫深入","author":"卢宁","text":"张罗莫深入，回岩虎豹嗔。\n一苑博一饱，尔亦被罗人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江鸿莫耽睡","author":"卢宁","text":"江鸿莫耽睡，狡猎夜施罛。\n阿奴曩告急，畏海不敢呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍生小景三首 其一","author":"卢宁","text":"林光浮远媚，春色小平分。\n郎在丹青里，朱衣点绿云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍生小景三首 其二","author":"卢宁","text":"静会图书意，匡庐溪水濂。\n山僧横杖去，一卷破华严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍生小景三首 其三","author":"卢宁","text":"鸣跃林头鸟，相呼并欲飞。\n羽毛聊自试，不觉远藩篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰所二首 其一","author":"卢宁","text":"晓碧上栏干，暖风乍飏扇。\n春台雨露深，如对君王面。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰所二首 其二","author":"卢宁","text":"芬馥溢阶除，倚檐更不语。\n东风时度帘，线玉抽春雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何檗樵二首 其一","author":"卢宁","text":"暑谢秋气高，鸟鸣山院晚。\n握手杳金云，遗经籍谁阚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何檗樵二首 其二","author":"卢宁","text":"玉人隔沙渚，朱箔垂银虹。\n所思欲谓之，紫江淼无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀文衡山待诏二首 其一","author":"卢宁","text":"数雁来山外，听莺立柳边。\n黄麻金马诏，青史玉堂仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀文衡山待诏二首 其二","author":"卢宁","text":"自尔姑苏胤，机坊无锦章。\n人皆矜墨妙，吾独爱圭芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人游国学六首 其一","author":"卢宁","text":"杳杳清江去鹢，娟娟白帝流霞。\n东壁文星炳曜，玉堂金马谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人游国学六首 其二","author":"卢宁","text":"月晓烟分六馆，天空寒入疏槐。\n青鸟影垂碧沼，绿芹香绕兰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人游国学六首 其三","author":"卢宁","text":"帷褰髦弁云从，笔落鱼龙角抵。\n金风午夜长号，东溟一浪千里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人游国学六首 其四","author":"卢宁","text":"影环厢馆泉清，瑞满蓬莱天晓。\n夐夐彩凤楼高，隐隐青云梯峭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人游国学六首 其五","author":"卢宁","text":"渟渟绿水黉宫，艳艳丹香玉宇。\n一肩凤阁论思，可是兔园册子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人游国学六首 其六","author":"卢宁","text":"淮济逶迤路邈，帐帷烨耀灯孤。\n台阁文章藻丽，月明人在冰壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小景二首 其一","author":"卢宁","text":"石径云林幽静，翠岩碧嶂崔嵬。\n坐久谩寻花去，喜逢问讯人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小景二首 其二","author":"卢宁","text":"高壑苍厓远道，轻烟绿树前村。\n缓步呼僮问讯，度林可是桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪鸿池上送友人三首 其一","author":"卢宁","text":"山明林色平分，窗静花枝当午。\n无端落木萧疏，惊断连床风雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪鸿池上送友人三首 其二","author":"卢宁","text":"结义朋鸾树下，同文并蒂花前。\n半亩秋容湛璧，一囊林际横烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪鸿池上送友人三首 其三","author":"卢宁","text":"江上风樯桂棹，城南雪案韦编。\n道阻望怜洄沂，亭孤坐怅清涟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]