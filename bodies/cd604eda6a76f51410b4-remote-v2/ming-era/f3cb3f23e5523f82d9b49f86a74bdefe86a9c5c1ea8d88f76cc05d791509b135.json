[{"title":"再次李蒲汀韵","author":"钟芳","text":"三年往返两都间，每爱投閒竟得閒。\n松菊未应荒旧圃，鹓鸾久矣愧仙班。\n清泉静濯溪边石，碧落孤撑海上山。\n到处行吟足为乐，漫将诗史自褒删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送太守王君之邵武","author":"钟芳","text":"横金新绾大夫章，闽越秋清玉露凉。\n宿学共推今董贾，仁声先拟汉龚黄。\n溪边花气迎朱旆，城外岚光入画堂。\n省事固应民事省，野田处处足禾粱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新酿","author":"钟芳","text":"酿成鸭绿美如饴，瓦缶新尝一二卮。\n入圣敢云知味鲜，爱宾常恐及门稀。\n香浮玉颊酡颜润，清对兰皋晚节宜。\n谁唤柴桑居士醒，","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不寐","author":"钟芳","text":"行行万里还千里，望望天涯又海涯。\n更定风林闻野鹤，境幽霜苑噪寒鸦。\n生憎地远人俱远，为爱灯华笔有华。\n此去三山应咫尺，欲珰明月绶丹霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和刘静脩先生自适","author":"钟芳","text":"门外浮云任往还，荆扉客少昼常关。\n机忘自觉穷通好，心远偏宜杖屦闲。\n数曲疏篁成隐所，一天幽思在前山。\n年来白发都全白，丹鼎何时藉驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和杨澹斋韵","author":"钟芳","text":"茫茫谁识鹿门公，澹泊惭予臭味同。\n仙桂有香联甲乙，老梅无语任霜风。\n一生颜巷情终适，千首杜诗心独雄。\n海外是非浑孟浪，等闲都入笑谈中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华封岩二首 其一","author":"钟芳","text":"自笑颓龄六十三，揽衣登眺力犹堪。\n旁穿石磴迂还利，高引藤萝步且谈。\n千仞鸟飞横碧落，九霄人语隔尘凡。\n兴酣斜日不知倦，更上岩端看极南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华封岩二首 其二","author":"钟芳","text":"游遍天涯见此山，天然奇绝翠微间。\n嵁崖高下开重榻，形胜东南控百蛮。\n仙境人寰迥然别，海光山色静相关。\n未缘幽僻都忘世，咫尺彤云是帝颜。\n眼空丘壑尘嚣远，气合青冥语笑闲。\n得意鸟飞青嶂外，放歌人在白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祷雨和太守黄后溪韵","author":"钟芳","text":"旱甚游尘蚀紫苔，遍祈端为九农灾。\n泉迎龙窟联髦稚，田拆龟文杂草莱。\n处处云霓频在望，嗷嗷鸿雁有馀哀。\n南交方拟勤天讨，只恐征科急报来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诞日邓宪副子几贺以诗次韵 其一","author":"钟芳","text":"宦海蓬飘四七年，韶华催老鬓华鲜。\n弧辰重值涒滩岁，蠕息终惭咫尺天。\n组绶倦抛依老圃，林皋遍赏学游仙。\n何当更作香山会，同和阳春白雪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诞日邓宪副子几贺以诗次韵 其二","author":"钟芳","text":"联辔长安忆昔年，锦袍光映杏花鲜。\n青山归卧几千里，白首相思各一天。\n东野云龙同上下，磻溪渔钓足神仙。\n遗音欻堕南来雁，才拙何能续大篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡海和韵","author":"钟芳","text":"长年舣棹仆夫催，报道祥风习习来。\n地脉不缘沧海断，蜃楼端为使君开。\n舟从织女机边过，人自蓬莱鹤背回。\n万顷玻黎天混漾，固应坡老羡奇哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿海口值雨","author":"钟芳","text":"隔溪燃竹似星繁，秋色萧森蜃气昏。\n孤舶暂纚蓬外雨，馀熏遥破陇头云。\n途穷岭表仍浮海，行遍天南尚有村。\n莫向波涛售涓滴，长揪终夜暗消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中夜泊有怀","author":"钟芳","text":"渺渺鲸波无畔岸，北人到此骨应寒。\n鹏翎漫说图南海，鳌背俄惊负巨山。\n万里越裳来白雉，十年文宿动群蛮。\n而今正藉膏霖润，曾谓雕椎入化难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺邓沃泉","author":"钟芳","text":"谁将乔木颂乔年，乔木春容岁岁鲜。\n华毂久悬松径月，寿筵重启杏花天。\n坤从海窟撑鳌极，人向蓬丘望鹤仙。\n惭我无缘陪末宴，聊歌沅芷献遗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读书知要","author":"钟芳","text":"善学无如善读书，莫耽买椟委明珠。\n天人条贯归皇极，坟典精华是道腴。\n骏失辔衔驰愈放，车攒轮辐运常虚。\n晚年涵泳多滋味，倚杖林塘乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢经府","author":"钟芳","text":"相逢无人知峻才，蛮烟往复迷蒿莱。\n解鞍暂憩碧油幕，束装又上黄金台。\n柏老经霜贞性在，林疏见日滞阴开。\n西风一棹归家便，朋旧高谈惬素怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陈天游京兆韵","author":"钟芳","text":"敝裘游倦早归来，十亩菑畲翳草莱。\n紫府再瞻皆是幻，丹心一寸已成灰。\n多君遗佩光腾户，跃我循檐笑索梅。\n拟共浮丘歌一曲，海云片片万山回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫吟三首 其一","author":"钟芳","text":"细酌松醪荐柘浆，无端漂絮逐风狂。\n天池浩荡春如许，椿槿宁须校短长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫吟三首 其二","author":"钟芳","text":"深树鹪鹩借一柯，波光摇碧共婆娑。\n青山宜我看不厌，白发欺人生渐多。\n窗掩馀寒便旭照，径栽新绿趁微哦。\n田家风味儒家素，墙角烟条引薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫吟三首 其三","author":"钟芳","text":"蒙茸青草满方塘，晴岫屏开白鹭双。\n秫酒正香渔父醉，一蓑和月卧沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张大参静峰","author":"钟芳","text":"偶从天苑识祥麟，别后俄惊三十春。\n直上紫霄囊里物，再逢沧海梦中身。\n周咨民瘼车频牵，默运边筹笔有神。\n穷岛谁云有遗照，等闲举睫是枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀督学张公","author":"钟芳","text":"穷荒何意迓琼鸾，我昔垂髫幸识韩。\n赏鉴谩誇千里足，頖林偶借一枝安。\n南山赋就相期远，小草春妍欲报难。\n四十年来文士蹇，輶轩无复到琼南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀督学朱公","author":"钟芳","text":"匪但文儒仗切摩，罢癃无得济沈疴。\n海环晴嶂三千里，帐捲秋风两度过。\n峭璧岩岩齐泰华，渊泉滚滚沛江河。\n醑尊欲致湘坟奠，两鬓如霜奈病何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和蔡半洲督府韵","author":"钟芳","text":"瞳瞳尧日丽边城，衔命来司九伐兵。\n嘉谷每缘稂莠害，阳春须仗雪霜生。\n文猷武略同时奋，海沴山氛一旦清。\n夷徼从今殊俗变，未应专羡伏波名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中言怀 其一","author":"钟芳","text":"宦业如公少，勋阶未有涯。\n勋如登泰岳，阶合筑堤沙。\n鸣雁归中泽，云霓陋旱车。\n丈夫雄一世，端不在辞华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中言怀 其二","author":"钟芳","text":"地僻嫌溟隔，民穷患岁侵。\n共怜时雨润，同戴帝仁深。\n谁识冰霜性，中含造化心。\n三驱非玩寇，妙在失前禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"电白观海","author":"钟芳","text":"南北山头瘴厉开，思君呼酒赋台莱。\n行边诗句人人诵，到处声称特特来。\n客坐燕间挥盏斝，农郊旱暵荐云雷。\n黔黎皞皞韬钤外，击壤兴谣日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遂溪书事","author":"钟芳","text":"城依涨海昼阴阴，画戟千行幸一临。\n硗埆田畴生意少，萧条编户野茅深。\n等闲举目横秦望，几许攒眉动越吟。\n抚字独勤征赋拙，表臣真慰圣皇心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石笏洞","author":"钟芳","text":"洞开石笏迤天梯，步步陵空面面奇。\n不是嬉游心性癖，只缘清简吏民宜。\n座间云满凫鹥狎，脚底春生草木知。\n却笑九华丹灶冷，丹成不济鬓如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菊花紫色者俗号紫袍一奇也折小枝复栽即活二奇也腊月有花三奇也二花并蒂四奇也偶阅之有感漫赋一律录上一笑","author":"钟芳","text":"物理堪推造化心，黄华并蒂见斯今。\n玄霜淅沥二阳月，紫焰栏班一叠金。\n欲共岩梅标汉节，故连昆玉出姜衾。\n幽斋小座人声静，独嗅寒香自在吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再赓石宗海韵","author":"钟芳","text":"江花漠漠绕江开，江月光涵浊酒杯。\n避寇远来依旧约，结庐那暇择新材。\n万家桑梓风尘暗，千里貔貅鼓角哀。\n最爱宛山青四匝，政馀觞咏洗心怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大通桥送别西樵阁老次韵","author":"钟芳","text":"晓乘归舫逐溪云，溪上看云忍暂分。\n金鼎化惭沧海外，玉堂人恋白鸥群。\n敢缘休告忘忠荩，直与中流遏溃奔。\n九老未须牢结社，举头尧日戴晴薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日","author":"钟芳","text":"重阳对景独徘徊，菊爱寒香未遽开。\n幽眺且寻陶令乐，朗吟休数仲宣才。\n空明万象池塘影，磈礧千峰璧玉台。\n此去蓬瀛争几许，御风邀取列仙来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早朝","author":"钟芳","text":"带月徐过白玉桥，佩环声里听云璈。\n朝宗在处歌尧舜，补衮何功愧稷皋。\n风动百蛮鞮鞻合，瑞呈阿阁凤凰巢。\n圣心望道犹如渴，东殿时闻集俊髦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄程内翰","author":"钟芳","text":"忍使纤埃蔽斗光，暂韬锋锷向南荒。\n定知风日不到处，自有宝书森玉堂。\n危涉崄巇皆坦荡，澹甘藜藿亦膏粱。\n寒芳无数探春信，一任夭饶傍短墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"联句送贾会期 其一","author":"钟芳","text":"江上春风吹柳花，离筵斜日照晴霞。\n翩翩五马秦关迥，隐隐双旌楚望赊。\n几处疮痍归屏翰，千村父老乐桑麻。\n使君家学薇垣重，剩有殊勋属帝嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"联句送贾会期 其二","author":"钟芳","text":"昔年同醉上林花，酒色花容炫彩霞。\n汉节忽分民牧重，越吟先动客愁赊。\n羡君千里琴随鹤，惭我十年蓬倚麻。\n携手河梁各惆怅，满川风日对清嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗质夫处同胡孝思联句","author":"钟芳","text":"四海交情三益并，两都仕路十年同。\n座连樽酒谐今夕，秀挹江山让此翁。\n旧史断文虫篆古，小炉新火兽堆红。\n公馀莫厌频相过，对月怀君思正浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"越中同方宪副思道会合联句","author":"钟芳","text":"山中念离索，幽思托宾鸿。\n尊俎幸兹合，广榭歌春风。\n桧阴转斜日，重叠交房栊。\n小鸟咿嘎鸣，托之情亦融。\n人物并和洽，矧此时序丰。\n玄谈谢俗况，疑谊开我蒙。\n忆昔见君子，曲江水溶溶。\n瑶池共霜月，岂不怀愚忠。\n中间人事异，畏途各飘蓬。\n荏苒馀一纪，此酒何能同。\n去年发东服，期我吴山中。\n乘轺阻越水，伫望江云重。\n终焉结佳晤，情曲潜孚通。\n微酣坐迟莫，海月明林东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草书","author":"钟芳","text":"草书若图画，远景与意会。\n象归方寸间，妙在丹青外。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"景梅亭绝句","author":"钟芳","text":"宛水千年碧，敬亭千仞高。\n荒祠掩清寂，依约见诗豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题金门待漏图 其一","author":"钟芳","text":"漏尽金扉辟，绯袍艳赤日。\n卓哉富山翁，贞心合同色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题金门待漏图 其二","author":"钟芳","text":"仰极摅忠荩，临民薄赋徭。\n我来君已逝，凄切夜蛩号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涑水司马氏云人情苦厌其所有羡其所不可得未得则羡已得则厌厌而求新则无所不至矣予读之有感因赋绝句","author":"钟芳","text":"实德吾应愧，浮名信所遭。\n未能忘厌羡，祇觉一生劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹","author":"钟芳","text":"翠实连千亩，扶疏荫绿苔。\n秦台骈月管，应有凤凰来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅历科进士录 其一","author":"钟芳","text":"魁甲真么么，过眼成士苴。\n试看十科前，几个知名者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅历科进士录 其二","author":"钟芳","text":"好奇涉高虚，无奇亦苟苟。\n碌碌过一生，草木同腐朽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅历科进士录 其三","author":"钟芳","text":"悠悠扬扬，为鸾为凤。\n琐琐屑屑，为蠓为蠛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅历科进士录 其四","author":"钟芳","text":"饥鸱得腐鼠，昂头骄鹓雏。\n霄汉本空阔，彼生何太愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨震","author":"钟芳","text":"谗构溷宸听，清忠振典刑。\n胡为昧几见，落魄几阳亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜湖","author":"钟芳","text":"会稽饶竹箭，箈笋却堪菹。\n欲绘镜湖境，移家十胜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"畏醉","author":"钟芳","text":"畏醉常辞酒，那堪杜举频。\n主人无限意，倾倒对凫尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画菜四幅为冼罗江卿题 其一 芥菜","author":"钟芳","text":"雪重玻璃捲，苍然色不渝。\n苦辛通性窍，登荐后甘腴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画菜四幅为冼罗江卿题 其二 白菜","author":"钟芳","text":"闹处光阴短，澹中滋味长。\n畦蔬寒可掬，清白带凝霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画菜四幅为冼罗江卿题 其三 白萝卜","author":"钟芳","text":"风叶青罗嫩，霜根白玉鲜。\n不缘多故贱，菌耳合争妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画菜四幅为冼罗江卿题 其四 胡萝卜","author":"钟芳","text":"剪剪陂云碎，淩冬翠转深。\n土膏微启润，龙爪见黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次","author":"钟芳","text":"云来山蓊郁，云去山露石。\n山石宛如故，浮云自朝夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴","author":"钟芳","text":"斜月下西楼，凉飔袭毳裘。\n虚斋人语静，愁思漫悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小遣","author":"钟芳","text":"雅性不嗜酒，酒兴亦自豪。\n高歌待秋月，天籁连江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怨歌行","author":"钟芳","text":"闲幔捲丹霞，霜梧夜噪鸦。\n挑灯不成寐，游子在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀椿卷","author":"钟芳","text":"木落天陨霜，鹓雏恨独翔。\n空言诵参晰，何计续遗光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写景","author":"钟芳","text":"水落沙嘴出，木凋山色寒。\n小舟渔父醉，烟雨卧江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文中子","author":"钟芳","text":"累土成崇丘，师师固多益。\n年来此义微，反面交相贼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塔","author":"钟芳","text":"累壁卓天巧，玲珑镇空苍。\n空门本虚幻，金碧何荧煌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方心曲领","author":"钟芳","text":"象服师中古，惟时损益宜。\n函藏非贻厥，聊畀后人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八滩 其一","author":"钟芳","text":"滩声滚蛟鼍，层层溯天级。\n应与银河通，试探支机石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八滩 其二","author":"钟芳","text":"下滩若转丸，上滩若移石。\n难易系所乘，未论迟与疾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八滩 其三","author":"钟芳","text":"拿舟溯惊湍，万篙不能上。\n徐徐风一帆，历历如指掌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八滩 其四","author":"钟芳","text":"舟子引百丈，日行滩几重。\n登饭暮相向，竞说挽舟功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"止柴胡店避雨在滕县南故薛城近焉","author":"钟芳","text":"微雨斜侵车幰，仆夫先后咨嗟。\n暂倚蓬门小憩，为谈农圃生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynas