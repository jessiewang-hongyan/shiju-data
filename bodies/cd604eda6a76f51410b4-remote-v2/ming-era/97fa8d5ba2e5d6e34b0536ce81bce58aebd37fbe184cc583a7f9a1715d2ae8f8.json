[{"title":"雷峰山寮口占 其五","author":"释今无","text":"夜壑藏舟急，天风鼓箨轻。\n有刀分肺腑，无传写平生。\n旧榻眠吾病，新秋送汝行。\n两年伤悼意，衰飒旅魂惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雷峰山寮口占 其六","author":"释今无","text":"待死心还热，原空事未消。\n艰难菩萨行，辛苦病魔娇。\n冷意营新塔，孤灯照药瓢。\n交情那可已，哭汝向溪桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江夜 其一","author":"释今无","text":"精魄融消月，重冥习夜风。\n岸林千叶暗，船火五更红。\n老事思量遍，閒心着意攻。\n再休言建立，吾亦笑吾空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江夜 其二","author":"释今无","text":"总是无家客，家居亦野航。\n江边知月阔，水底见星长。\n林动疑豺虎，时危问稻粱。\n岩能孤坐好，贫只百般忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将米从蛋户换得鲤鱼一尾重二十斤鲇鱼一尾重三十六斤放生","author":"释今无","text":"方乞桃花米，先将换活鱼。\n红云生锦浪，绿背拔青蕖。\n万事浮生似，孤舟且慰予。\n龙门他日起，风雨慎村庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟至胥口有鲇鱼一尾重十四斤复买放生","author":"释今无","text":"复解鲇鱼索，全倾乞食囊。\n原无开济力，只检养心方。\n水更微生得，天从覆物长。\n年来衰白意，不可问沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊鸭凫水","author":"释今无","text":"胡为于此泊，孤舟满戒心。\n艰危已如此，寇盗岂相侵。\n自信疏星朗，他求浊世深。\n野猿相共警，清啸有馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远东林寺","author":"释今无","text":"清远东林寺，颓荒有岁年。\n琉璃高照郭，锦绣忽铺天。\n廊接飞来磴，门迎估客船。\n僧徒钟磬稳，追忆太王贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝入清远峡","author":"释今无","text":"翻江朝日丽，迎水峡船摇。\n草露茸茸滴，飞云淰淰飘。\n事閒人意好，春急鸟声娇。\n中岁从兹过，年年换寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上飞来寺 其一","author":"释今无","text":"数日逃人外，欣无礼法拘。\n披衫登古寺，赤脚看江鱼。\n亭记归猿迹，门仍拒盗馀。\n既看风境异，鬓际亦难如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上飞来寺 其二","author":"释今无","text":"石响山泉沸，台擎野果铺。\n峡风刚自起，舟子急相呼。\n眼挂杨朱泪，身依晋鄙符。\n自由何日得，对境倍踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"口占","author":"释今无","text":"天与孤僧便，萧萧一叶舟。\n月无通夕照，人有百般求。\n水鹤思量步，惊鱼造次游。\n自磨吾宝镜，高挂凤麟洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沸水方热锅为宽黔所堕行人泡足戏成","author":"释今无","text":"我饿方思饭，黔宽忽堕锅。\n脚能供炮烙，腹极怨蹉跎。\n国手调金酱，神仙爱玉禾。\n两般俱未得，失意事原多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至连州江口","author":"释今无","text":"江口今朝至，寒风昨夜多。\n宿云含石磴，断碣拜曹娥。\n庙古茆茨换，时危估客和。\n湟川当五岭，一路好岩阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟行","author":"释今无","text":"曲路嶙峋上，孤舟寂寞行。\n峰阴存石气，篙力尽滩声。\n世事为无益，生涯岂有程。\n黑貂穿破处，只醉未曾醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至麻步","author":"释今无","text":"石匠遗馀荫，云根拥独牢。\n戒心惊虎兕，麻步见旌旄。\n水急青天破，松长白鹤高。\n物情徒顺适，人外复波涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岸上摘枸杞","author":"释今无","text":"枸杞因吾有，舟行似少陵。\n盘餐供早晚，眼力得轻清。\n味觉甘辛厚，肠缘湿热鸣。\n此生粗粝过，那复有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿雷公滩","author":"释今无","text":"深到无何有，闲心总懒提。\n窗开山石入，滩宿水鸡啼。\n湿气重岩断，春花夹岸齐。\n山阴分接急，此路亦千蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳山守阃拨夫相送念无德以当纵之自去","author":"释今无","text":"何忍劳人力，予生且自艰。\n天风吹短鬓，山月照衰颜。\n路入羊肠径，人行马面滩。\n追呼到穷谷，木客几曾閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟行","author":"释今无","text":"浮久身难定，春深木尽平。\n风吹岩弄笛，云到石簪缨。\n水际无飞鹤，船舱足乱蝇。\n谁尤雄杰气，垂老笑沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望野","author":"释今无","text":"未可询行役，言寻好翠微。\n水添江路直，帆侧峡风归。\n残月波翻碎，閒鸥春浴肥。\n时时惭物外，何日坐忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"口占","author":"释今无","text":"草色甘衰白，天涯兴正赊。\n马蹄出塞健，燕翼过江斜。\n舟忆秦淮水，杯思庙后茶。\n乱来成一笑，期我总无瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽阳怀足两师","author":"释今无","text":"骨贫高卧亦添愁，噭噭啼猿长泪流。\n子建文章堪载笔，仲安身世委沉浮。\n云霾塞雪燕支黑，风冷江梅师子幽。\n知己感恩愁欲死，吾兄曾为一筹谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕和本师辛卯韵","author":"释今无","text":"怀师又在大关东，朔气山光一夜中。\n残梦不离三峡寺，閒情偏逐五更风。\n年来善病心如死，日抱寒愁道未穷。\n幸喜烧冰依佛眼，灯花还与几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登谪仙楼有怀千山","author":"释今无","text":"欸乃听残客思愁，来登江上谪仙楼。\n寒风直扇金陵雨，怒浪长连白鹭洲。\n万里中原腾杀气，三边朔漠怨貂裘。\n分明掩泣凫归日，回首茫茫又两秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别郑季生","author":"释今无","text":"城头吹角肃初寒，边客何人泪欲乾。\n久历冰霜忘道远，又从离别觉情难。\n传经自是诗书志，击筑须怜屠狗欢。\n细想与君交匪薄，回头不是望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用徐秀才游百花园韵","author":"释今无","text":"百丈苍崖路几层，何人清啸学孙登。\n松杉地阔风声急，牛斗星寒剑气腾。\n冷处看山高士眼，岩前扶病野人藤。\n明朝披薜凌霄去，珍重桥头护石冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周长孺过谈灯下口占贻之","author":"释今无","text":"湖海飘残意转深，归来未肯息长林。\n青衫拭尽新亭泪，白水难忘旧日心。\n云过草堂时倚剑，鸿鸣秋浦罢弹琴。\n分明不羡无生理，相对惭予乏好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠顾与治","author":"释今无","text":"唾壶敲罢已龙钟，潇洒文园一病翁。\n百二河山双眼老，三生魂梦十年空。\n泼残墨汁疑张旭，鍊尽丹砂想葛洪。\n雪底故人相忆甚，石头先遣问秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈柱江应策不第以诗慰之且言别","author":"释今无","text":"风流名已帝京闻，惊座陈家复见君。\n自有富钩归贾客，更无贫铗向田文。\n他年自展图南翮，此日谁空冀北群。\n出处穷通非所慰，独怜万里恨凫分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别即兄","author":"释今无","text":"哭罢穷途笑步兵，秋山病叶一身轻。\n木瓢潦倒人烟饭，竹笠萧条塞雪声。\n去住每怜予有恨，别离愈爱汝无情。\n感公古亦怀冰者，大法依然属老成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游金粟泉","author":"释今无","text":"天荒谁与问柴扉，胜地寻幽又着衣。\n开阁不因生客至，探泉何必主人归。\n水当澄彻方消暑，心得清凉是息机。\n千古从来多好事，苏公祠有缕烟微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠魏和公","author":"释今无","text":"天涯倾盖乐何如，况复神交三载馀。\n说剑崆峒跨斗气，摛文禹穴得新诗。\n风流久托寰中赏，磊落曾寻物外庐。\n击筑高歌弹铗好，王门原可曳长裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜诗 其一","author":"释今无","text":"皑皑孤城月照人，角吹一夜起烟尘。\n廿年将帅恩非薄，百队貔貅气欲伸。\n马踏官街惊睡犬，刀临屋角泣灵神。\n黄金死士君闻否，方信冯驩用处真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜诗 其二","author":"释今无","text":"街南街北尽喧声，黑纛城头绕月行。\n炮火惊心先入耳，犀纹坚甲耀新兵。\n明明大将星辰坠，寂寂银河杀气升。\n谁念客游当此际，此情惟有道能胜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜诗 其三","author":"释今无","text":"闻道量沙是阿瞒，令人特地忆芳魂。\n枭雄窃国虽无取，庙算成功亦足论。\n珠玉卫生非在朴，生灵有泪直须吞。\n可怜踏尽青青草，愁杀王孙望海门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜诗 其四","author":"释今无","text":"斗印黄金掌上悬，将军自有出机先。\n九头猬结终成暴，三略环才实仗贤。\n旆转星边光欲没，风临泽上德应全。\n忘怀我可随时劫，只为生民一怆然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜诗 其五","author":"释今无","text":"已成垂蹇到琼南，况复刀兵劫正酣。\n酸鼻霜戈公豕突，愁人壮岁失鸡谈。\n折冲不用追风马，弭祸无过白玉簪。\n若是王明今广烛，天威咫尺或能严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜诗 其六","author":"释今无","text":"戒旦鸡声动远空，企予东望海云红。\n惊魂稍定三更后，芳饵争传十月中。\n螺角正停皆秣马，炮声才动尽弯弓。\n入云帅府辕门壮，鱼烂愁看一霎风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"举稚鸡","author":"释今无","text":"坠羽虚弯怯未伸，相怜此际觉情真。\n回看六日悲同汝，幸得馀生复仗人。\n日料且分檀越米，年光难逐老僧春。\n处宗未必长为吏，禅几吟窗可话频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿冯孝廉载赓敏来斋斋中植鸡冠花数本一茎径可尺馀诸公同赋限红字","author":"释今无","text":"曾祀梁州色未工，移为窗下接谈丛。\n司晨既已惭嘉号，斗月犹能散舞氃。\n幸比灵芝于我小，竟誇梅瓣不能红。\n人间拟物当其似，堪笑人间尽拟中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏波祠","author":"释今无","text":"名祠衰草引颓垣，禹贡河山绝此峦。\n忆别楼船悲海气，看来铜柱泣王孙。\n朝廷版籍黎村渺，天地浮生马革存。\n千载英魂余欲奠，蘋蘩无力荐平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟秀才秉三以奇楠香坠赠别诗以谢","author":"释今无","text":"珊瑚风急岛门秋，握手论交笑便投。\n玄理共君看鸭脚，名香赠我过牛头。\n蛮中土物南方贵，海国朋情世外留。\n每到溪桥三伏际，素纨摇曳想风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喻耕三夜访宿茅亭","author":"释今无","text":"海门游宦足高才，觞饮沧溟气壮哉。\n说剑盛传扪虱久，谈玄终喜带星来。\n青莲有法那堪比，白眼无心各自开。\n世事欲冷身欲老，竹床期尔到千回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿谭兑子且言别","author":"释今无","text":"一杯秋露为君寿，寿君十日便辞君。\n笑谈胜结东林社，笔札堪传北地云。\n綵服好将供白发，青衫莫更负鸿文。\n论交最是初相识，握别桥头畏夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别赵庭宜","author":"释今无","text":"赋残穷鸟泪如麻，胜事回看日欲斜。\n岛上青山非赵土，津前桃叶少秦家。\n难将远恨频窥鬓，已是无园好种瓜。\n握别赠言原我事，愿君努力向烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼州留别巳虚","author":"释今无","text":"非君爱我不能来，此日分襟尽日哀。\n两地秋风悲旅雁，百年身世付高台。\n波声寂寞摇孤舫，野寺萧条罢茗杯。\n骨肉渐深兄弟谊，度人几载便应回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答周鹤田 其一","author":"释今无","text":"珠海霜飘叶未红，柴门揖客得高风。\n早传封事神州内，竟接鸿词白雪中。\n笑语性应归上乘，须眉气自可凌空。\n他年九带台边月，千载香花愿与同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答周鹤田 其二","author":"释今无","text":"书归金马道仍西，弃却银鱼世罕齐。\n镇海珠谁徒手得，摩天鹤不共鸡栖。\n摧残智勇留盘谷，开拓心胸选钓溪。\n莫遣秋霜攻玉质，莲华相待踏琉璃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴百子归琼海","author":"释今无","text":"相见先嗟失意殊，文章原自胜隋珠。\n三年辛苦二千里，万虑消归一字无。\n桂魄有心圆不彻，秋风何意冷还孤。\n忙忙未尽寒山话，寂寞琴书上客途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送诸子下第还琼海","author":"释今无","text":"摇落先悲秋气凄，谁怜剑锷擅铜溪。\n溟南有翼羞羊角，冀北无群笑马蹄。\n苦竹渡头椰酒冷，阳春山下黑猿啼。\n重逢讲彻无生话，客里清歌试一提。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁赓人秋捷","author":"释今无","text":"秋风羽翰识南图，独化沧溟道未孤。\n一代文能凌白雪，三州人羡得骊珠。\n笑拈綵笔飞金屑，静指冰轮对玉壶。\n况是少年多逸兴，明春花影满皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文人赓人卿人三昆玉赴秋闱赓人先捷二公南归此赠","author":"释今无","text":"白眉已见号贤良，兄弟双难孰可当。\n先喜家声高建水，旋嗟逸足失孙阳。\n极明霜月悬愁乐，如许归途有短长。\n好悟木樨真实义，重来赠汝一枝香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿杨天衢","author":"释今无","text":"盖州城下涌千峰，猿臂今看受气雄。\n红旆惯驱龙虎阵，白星长耀斗牛宫。\n閒持旧竹量觞酒，静对深堂捲画筒。\n道意百年还是少，祝君声已彻鸿濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆康侯还琼山","author":"释今无","text":"邻庵尚忆夜谈时，已识豪华气自奇。\n为吏不须哀漂母，轻身原许学要离。\n寒山有梦劳千日，客舍无愁畅万卮。\n别去倘思吾道好，灯光还照碧琉璃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬寅春扫先师翁塔 其一","author":"释今无","text":"江门觅路拜高岑，瞻仰嵯峨春暮阴。\n溪雨欲来山气歛，泉台长掩法源深。\n烟开孤白啼归鹤，土酿新红出远林。\n旧日绕床孙渐老，一盘荼味荐微忱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬寅春扫先师翁塔 其二","author":"释今无","text":"去年浮海上辞书，回首风烟几日馀。\n芳草无情空满地，浮云有泪独沾裾。\n山光十里银盛雪，泉影千年井觑驴。\n便拟种松三万本，青青长荫祖庭迂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢柱波招游厓门","author":"释今无","text":"欲吊沧茫一问津，楼船何必起征尘。\n乌衣旧姓能招客，白社新寻得故人。\n细草绿初厓尚冷，洪波碧尽海难春。\n灯前莫欣兴亡事，更有何源可避秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门感赋 其一","author":"释今无","text":"孤舟又向海门过，旧事厓山感慨多。\n三十已怜添白发，千秋谁与泣铜驼。\n云埋断碣迂黄土，树掩离宫长绿罗。\n自古兴亡终若此，不须弹泪落沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门感赋 其二","author":"释今无","text":"当时十万尽沉尸，幼主孤臣异代悲。\n身世到今都是幻，江山终古不曾移。\n双厓浪打高陵草，万木风摇失古祠。\n忠义果能移国祚，夕阳斜照有残碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿厓门","author":"释今无","text":"又随鹢首下云端，柔橹轻风破急湍。\n月色每因浮海得，松声依旧故宫寒。\n五年尚忆长陵役，万里还当大宋看。\n此意莫教今夜梦，慈元原不是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拜三忠祠","author":"释今无","text":"穷厓极海拜名祠，万古山河又一时。\n波浪独深臣子泪，死生惟有老僧知。\n鱼龙国冷人如梦，乌鹊枝危月亦悲。\n最是不堪投吊草，乾坤若个哭男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿大云监院睹者五十一","author":"释今无","text":"大云谁复振颓纲，赖有杨岐为播扬。\n入社里人欣后起，翻经山日爱初长。\n廊迂影过菩提绿，殿古光回画栋黄。\n已是护明今降此，看君岁岁礼慈光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺雷峰新监院见公","author":"释今无","text":"斑髻怡怡笑口开，无边功德鼻收来。\n牛头八百堪担米，云盖千年亦拨灰。\n且把金针藏绣带，好敲银盌闹香台。\n六衢赤脚同辛苦，梦到江城是几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘昆玉从关中来觅其伯祖同庵客生遗榇因得皈予座下别归诗以送之","author":"释今无","text":"梦蝶幽人骨久寒，流离谁复哭云端。\n能来海角真痴绝，复典春衫识路难。\n佛种有缘终莫断，世间如幻好平观。\n送行赠汝真三昧，百八轮珠万里安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]