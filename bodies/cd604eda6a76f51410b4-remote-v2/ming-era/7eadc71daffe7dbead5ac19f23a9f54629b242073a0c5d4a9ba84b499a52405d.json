[{"title":"题张诩母挽","author":"林光","text":"西风容易卷重帏，堂北萱花不耐吹。\n何处罗襦埋壮母，至今霜露泣孤儿。\n光华到老人咸愿，水菽承颜我合悲。\n幽思临风一挥洒，溪流南去绿漪漪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别石斋先生二首 其一","author":"林光","text":"江门杨柳绿丝丝，折赠先生更不疑。\n未可轻看惟出处，最难为别是相知。\n细鳞安敢辞盆水，老凤从来识圣时。\n再拜当筵无别祝，高堂垂老念归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别石斋先生二首 其二","author":"林光","text":"日日江门弄钓丝，清閒到老亦何辞。\n风波薄暮看投楫，裘葛无心祇顺时。\n身世频频催白日，文星恰恰照南陲。\n一樽相送情难尽，手擘轻红饯荔枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其一","author":"林光","text":"惜别吾何语，秋声动海涯。\n他时赋丹荔，今日赠黄花。\n别足移磐石，苍波照暮槎。\n大臣能体国，飞檄落烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其二","author":"林光","text":"流年过半百，敛迹只蒿逢。\n秋气清炎海，苍波起卧龙。\n南川留一榻，北极着双瞳。\n八表虽云远，能消几日风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其三","author":"林光","text":"三年留絮酒，不到一峰坟。\n老泪空缘梦，遗碑未有文。\n堪封疑此墓，谁为达明君。\n今日先生往，能无感激人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其四","author":"林光","text":"方舟展清眺，辍棹引离觞。\n潮水纡寒玉，秋山带夕阳。\n鹏飞天亦窄，鸥懒海俱忘。\n尽把行藏意，添诗入锦囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其五","author":"林光","text":"好月期来夜，黄花更几朝。\n远山娇入画，低岸忽吞潮。\n割袂头堪白，贪诗酒易消。\n倏然能化羽，霄汉逐王乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其六","author":"林光","text":"村酒还堪醉，官舟发未忙。\n霜催乌桕赤，山引白云长。\n怅望东湖水，应登孺子堂。\n如何东汉士，此老善埋光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其七","author":"林光","text":"每每定山子，诗传到海傍。\n闲情今转别，老笔更无双。\n黑发从渠白，流光去自忙。\n寄声泉石下，痴病只寻常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其八","author":"林光","text":"扁舟远相送，儗过峡山前。\n岚气清人骨，僧居出洞天。\n泥途甘我老，樽俎会何年。\n不洒童儿泪，支离只赠言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其九","author":"林光","text":"南海千年话，青天一道巾。\n离言贪月白，秋思入江深。\n赤手看经济，明时愧陆沈。\n白云闲宇宙，去住本无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠石斋先生十首 其十","author":"林光","text":"烟霞非痼癖，造物惜声名。\n当道烦连疏，先生着不行。\n秋青南海水，月满五仙城。\n去去逢明主，应谙子母情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯石斋于石门用前贪泉韵兼简诸友","author":"林光","text":"鬅鬙双鬓我何言，机会能逢几百年。\n共趁风光来野艇，更留声迹到名泉。\n烟波在处还诸子，鸾凤看飞上九天。\n回首东山明月上，更须留醉白沙船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安挥使惠靴兼诗见赠因韵奉谢","author":"林光","text":"谁念柴桑赤脚人，江门情绪盎如春。\n山村有酒虽堪典，争得烟霞步步新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初晴","author":"林光","text":"冬雨初晴日向曛，寒螀偏傍竹间闻。\n寻常又秉山中笔，只把文章换白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九后一日赋是日即馀余日","author":"林光","text":"天生两脚踏烟霞，老态从来日日加。\n不把西风移皂帽，还浇秋酒对黄花。\n凉侵院竹知秋老，醉舞莱衣到日斜。\n四十四年贫是福，眼边儿女莫咨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟移居二首 其一","author":"林光","text":"西风吹梦别庭帏，握手凭谁话细微。\n己悟山林终小隐，只从鱼鸟看真机。\n栽花莳药时将晚，饭稻羹鱼愿未违。\n何处洞天真可卜，即携妻子傍仙扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟移居二首 其二","author":"林光","text":"苍苍何处绿成闱，许我移居入翠微。\n白月清风贫士宅，行云流水哲人机。\n付身大冶从陶铸，置足迷途易拂违。\n安得此生闲到老，南川扉近白沙扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"食鱼鲫","author":"林光","text":"银鲫持来向野田，童儿欢扇晚厨烟。\n挥瓶小灌松花酿，共献先生一箸鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题丁明府三江渔樵人卷","author":"林光","text":"渔樵亦爱三江老，欲制荷衣苦未成。\n一笑横琴来粤海，几回飞梦绕金精。\n云归谷口真成懒，月到潭心本自明。\n一曲沧浪空乱耳，南溟千顷对长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忧旱","author":"林光","text":"苗稼相将稿在田，嗷嗷万户正潸然。\n乾雷滚荡无巴鼻，争讶神龙懒上天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅都台檄催赴省试四首 其一","author":"林光","text":"烟霞欲遂此生谋，台檄飞催未肯休。\n总把流光销卦画，更提双眼到伊周。\n行藏祇益山灵笑，贫病能忘老母忧。\n谁为当权声一语，且容樗栎长林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅都台檄催赴省试四首 其二","author":"林光","text":"一从幽谷弄云烟，科业隳来十五年。\n病骨自知难进取，衰龄谁更为周全。\n芋苗催老黄梅雨，豇豆披罗小洞天。\n剩水残山人不占，且随童冠看鱼鸢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅都台檄催赴省试四首 其三","author":"林光","text":"官衙严切不官书，不置山林一散樗。\n儗赭青袍寻钓艇，那驱老脚又方舆。\n卑微易拾圯桥履，艰阻难移节孝车。\n天北天南他夜梦，相看子母欲何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅都台檄催赴省试四首 其四","author":"林光","text":"行藏空使我怀疑，即鹿无虞事可知。\n千载风云看际会，一时机轴转何谁。\n苔封僻径人踪远，风荡游丝日影迟。\n间点一双观物眼，还将消息认庖羲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余不阅程试义十五年今始一阅","author":"林光","text":"才拈一卷一留神，睡思浓来辄欠伸。\n汶上投闲应自得，昌黎惭忸可无因。\n不辞筋力聊供世，祇恐轻肥解误人。\n一扇葵风清到骨，北窗谁炒葛天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将往苍梧三首 其一","author":"林光","text":"利前害后两相咻，世计催人可自由。\n倚棹长江看暑月，野夫乘兴欲西游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将往苍梧三首 其二","author":"林光","text":"寻舟欲出更逡巡，香菌初生暑畏人。\n不识顶湖山下露，风花还有去年春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将往苍梧三首 其三","author":"林光","text":"自是先生懒出门，岂因残暑废杯樽。\n海山六月还堪赏，红日升时露未乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石门","author":"林光","text":"火云童树共参差，江水江鸥我不疑。\n团扇小挥珠汗落，相看只诵去年诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜侄生舟中书寄克明弟","author":"林光","text":"苍凉红日欲东生，屋角西头月尚明。\n伏枕忽闻添阿买，应门端足慰徐卿。\n严亲地下偏含笑，小弟江东合寄声。\n欲识天南今日兴，一樽携过五仙城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三江","author":"林光","text":"人烟生两岸，江潦夺浮沙。\n矮屋编泥竹，虚檐覆水瓜。\n波回渔艇疾，风引寨旗斜。\n蚬子迎船市，村醪莫肯赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿三水","author":"林光","text":"长风何处起，雨脚散重阴。\n山月能留照，江流只自深。\n清宵无酷暑，远鹤有馀音。\n未有悲秋意，何如蟋蟀吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中","author":"林光","text":"边江不省是何村，老树交加绿绕门。\n万点山尖偏入画，老夫篷底正开樽。\n摇风欲借芭蕉扇，坐我思寻若竹根。\n更买江鱼消晚醉，鸾刀飞鲙水晶盆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再入羚羊峡","author":"林光","text":"何处軥辀隔岸闻，森森榕树傍江唇。\n笑看今日羚羊峡，应识当年入峡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长利和子翼","author":"林光","text":"云傍青山影傍溪，落花深处伯劳飞。\n静团云日边江树，斜掩风烟面水扉。\n爱踏莎堤移晚履，欲裁蕉叶当闲衣。\n婆娑竹径行还住，时听軥辀对落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羚头峡与子翼小酌","author":"林光","text":"罗列波光数百峰，一樽何惜与君同。\n江流恰共诗情远，山色何如酒兴浓。\n习习和风吹短鬓，萧萧凉雨洒孤蓬。\n寻常一笑非人世，疑是星河有路通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿肇庆","author":"林光","text":"晚雨何须不系舟，橹声咿哑尚中流。\n阴云未放端溪月，岚气先催肇庆秋。\n也许炉烟飘卧榻，不教灯影照眠鸥。\n鼻雷我惯甘云水，莫遣疏更到枕头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小湘峡","author":"林光","text":"江水来何急，江鸥泛自闲。\n濛濛天际雨，冉冉峡前山。\n谷树含秋意，岚风洒醉颜。\n何能伴渔子，一枕卧江湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挂帆","author":"林光","text":"洪流滚滚日趋东，西上孤舟怯柁公。\n萧飒忽回山谷气，蒲帆高挂小湘风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大湘峡晚酌","author":"林光","text":"帖帖江如镜，迟迟舟渐移。\n都将山饯酒，不管雨催诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐和子翼","author":"林光","text":"萤灯几点乱渔灯，远鼓时闻变寨更。\n欲把长江来酒盏，与君聊泻百年情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴","author":"林光","text":"云去云来山自闲，白云何事更遮山。\n天生只眼闲无用，只把云山仔细看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游三洲岩五首 其一","author":"林光","text":"蒙茸鹧鸪啼，珠露滴秋晓。\n揽衣寄幽情，岩风吹料峭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游三洲岩五首 其二","author":"林光","text":"迟迟晓履移，欲去犹返顾。\n了了知心人，一笑隔烟雾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游三洲岩五首 其三","author":"林光","text":"凉生昨宵雨，缺月晓仍挂。\n不逢葛稚川，尽我今朝话。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游三洲岩五首 其四","author":"林光","text":"晓露爱沾裳，夜游还秉烛。\n飘然遗世情，高飞逐黄鹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游三洲岩五首 其五","author":"林光","text":"青青岩畔草，点点珠露缀。\n来是去年人，岩风急吹袂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中昼枕二首 其一","author":"林光","text":"云满青山水满江，云自能闲水自忙。\n一枕篷窗供打睡，任教云水两相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中昼枕二首 其二","author":"林光","text":"白雨跳珠正满江，初秋一枕得新凉。\n不知峡内西来水，尽日东流有底忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发德庆","author":"林光","text":"千里河山不尽期，黄茅白苇满江湄。\n一樽何处逢人易，三伏中流系楫迟。\n渔艇来归云漠漠，午蝉初奏雨丝丝。\n如僧怪石苍江畔，似迓行舟索我诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏题和尚石二首 其一","author":"林光","text":"童头坐老碧山棱，欲逐飞仙去未能。\n点铁有丹堪点石，凭谁说与水边僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏题和尚石二首 其二","author":"林光","text":"三千公案自缠藤，谁道三乘语足凭。\n依旧结趺临野水，今年人笑去年僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洗头二首 其一","author":"林光","text":"缘鬓斑斑不自由，沧浪又送一声秋。\n谁云白发还堪变，欲挽长江一洗头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洗头二首 其二","author":"林光","text":"篷底烟飘一线香，含情无语对秋江。\n野人惯洗尘头腻，未洗尘头几点霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉谢陈总戎惠墰酒","author":"林光","text":"村醪野酌惯江乡，未饮元戎碧玉浆。\n满目旗旌催晚醉，一江云水展新凉。\n荷筒半卷初秋露，竹叶偏回午夜香。\n从此诗情应更远，濯缨随处起沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与秉之夜话兼寄时嘉","author":"林光","text":"何处登临费杖扶，平铺在眼尽夷途。\n从教鹤发催人世，不信牛衣泣丈夫。\n木榻可疑他夜雨，松灯还照旧时书。\n乘田委吏都吾事，只把宣尼作范模。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石门留别诸友兼群从弟侄","author":"林光","text":"笑拚筋力出驱驰，潦倒龙钟任后时。\n秋水于人还自照，江山对我不须疑。\n停舟野寺还浇酒，搔首西风忽有诗。\n偶折芙蓉花在手，别筵吾不作童儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入峡","author":"林光","text":"水光摇荡碧琉璃，正值斜阳倒照时。\n上峡孤舟偏入画，看山两眼欲成痴。\n林泉富贵终无极，尘世风波总浪驰。\n四百峰峦吾自有，一杯留嚼万年芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山寺","author":"林光","text":"长风两袖正披披，又上飞来引一卮。\n山峙水流俱自在，白云乌帽本无期。\n寻常影响驰人易，四十烟霞灭迹迟。\n何事尘头空搜搜，百年疑是未醒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凌江阻雨","author":"林光","text":"欲度梅关更作疑，淩江驿下雨霏霏。\n不嫌津吏迟夫马，只恐涂泥染袖衣。\n庾岭阴云还自蔽，浈江流潦疾如飞。\n三秋馀瘴连朝洗，谁识乾坤造化机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江重九日","author":"林光","text":"梦魂无夜不飞还，只在慈帏笑语间。\n华发又添重九节，扁舟已进曲江湾。\n黄茅瘴静无秋暑，苏合杯香得晚山。\n更傍滩头还击棹，月明歌枕听湲潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吕梁道中","author":"林光","text":"淮酒腾腾欺量浅，肩舆忽忽入冬深。\n聊将此日冲寒意，偿却平生愿仕心。\n桑枣人间频数九，轮蹄风土浪披襟。\n丈夫知遇非容易，懒向行边出素琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将至临城驿","author":"林光","text":"争先路径险难量，痴立踟蹰对夕阳。\n身计百年空自拙，马蹄今日为谁忙。\n月当残腊还留照，鬓看寒霜转易苍。\n谁道临城能馆吏，中宵犹为倒馀觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"受教职","author":"林光","text":"风云敛翮向长安，老恐无才称小官。\n花草渐看春意满，江湖容放酒杯宽。\n闲情忽忽添诗律，归梦频频傍钓竿。\n何处青精还一饱，乌纱聊裹弄吾丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"受教职将之平湖","author":"林光","text":"香茶白饭在东吴，笑领微官出大都。\n万里心情关子母，百年风教又平湖。\n黄云紫水横孤艇，菱叶蒲梢浴晚凫。\n囊底有诗樽有酒，昔吾元不异今吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别京师诸友","author":"林光","text":"何许倾心一笑逢，黄金台下未从容。\n尘途渴洒三春雨，归梦频催午夜钟。\n鹤发任教垂两耳，丝桐独抱向千峰。\n东风莫道无巴鼻，吹得都门绿又浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"屠秋官席上再叠","author":"林光","text":"饭颗山前亦偶逢，短篇那更用先容。\n烛花也解含春意，樽酒何妨及暮钟。\n孤艇旧回三塔寺，一筇曾柱九龙峰。\n青天乌帽吴门路，云水如今兴转浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张后府官寓与提学宪副冯佩之夜酌话别","author":"林光","text":"深云不放月轮孤，辗转方斋酒一壶。\n士气西江还易振，斯文赤子更须扶。\n百川宗派趋彭蠡，两袖清风过小姑。\n无限衷情言未了，千年公案在鹅湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]