sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"见武夷二首 其二","author":"蔡清","text":"泰山孔子登，武夷朱子寓。\n吾想万山灵，亦羡二山遇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13300,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别邹汝愚谪雷州某所吏目五首 其一","author":"蔡清","text":"识君未三月，别君遽万里。\n自疑非丈夫，泪落不能止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13301,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别邹汝愚谪雷州某所吏目五首 其二","author":"蔡清","text":"识君未三月，别君遽万里。\n终不为君恨，天地有正气。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13302,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别邹汝愚谪雷州某所吏目五首 其三","author":"蔡清","text":"识君未三月，别君遽万里。\n应思生才难，莫负乾坤意。\n此行比游学，十年观造诣。\n炎荒无友生，神交李伯纪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13303,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别邹汝愚谪雷州某所吏目五首 其四","author":"蔡清","text":"慷慨出门去，默与千秋期。\n饱吃惠州饭，少和渊明诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13304,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别邹汝愚谪雷州某所吏目五首 其五","author":"蔡清","text":"我观古丈夫，挥手构寰区。\n节士非得已，矧彼章句儒。\n六籍垂世意，岂为崇简书。\n心丹宜细炼，为邦者如愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13305,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哀邹汝愚六首 其一","author":"蔡清","text":"天地元无情，汝愚信死矣。\n举世嗤笑之，吾独不如尔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13306,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哀邹汝愚六首 其二","author":"蔡清","text":"汝愚信死矣，展转泪沾襟。\n一死未光明，为君恨转深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13307,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哀邹汝愚六首 其三","author":"蔡清","text":"年少心更赤，竟以死遐荒。\n英魂飘何许，愿返托班行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13308,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哀邹汝愚六首 其四","author":"蔡清","text":"思君真益友，过我拟十筹。\n思君不可作，缄恨付春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13309,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哀邹汝愚六首 其五","author":"蔡清","text":"君昔抗疏日，计亦念至死。\n正气由乾坤，有怀莫能止。\n有怀莫能止，一死亦吾事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13310,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哀邹汝愚六首 其六","author":"蔡清","text":"君气盖一世，君穷直至骨。\n身死无所归，妻孥无黔突。\n遥遥万里道，老父讶丧绋。\n生子愿聪明，为君长壹郁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13311,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送黄邦瑞还广","author":"蔡清","text":"抱病日茕茕，君今又远行。\n斯文谅有味，分手能无情。\n柳色才沾白，稍头又转青。\n百年真转毂，何以慰平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13312,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"第一山和胡太守","author":"蔡清","text":"一登第一山，自觉众山小。\n日起海门腾，云连边树杳。\n物情随运迁，元化无时了。\n一事类登山，怀哉愧不少。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13313,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜云谷室联句","author":"蔡清","text":"今夕复何夕，青灯共片心。\n联诗乘酒兴，弄月傍花阴。\n清趣伴光景，閒谈断古今。\n万年不尽意，要在自家寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13314,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"福州寄同志","author":"蔡清","text":"去家十五日，始入福唐州。\n宦心未汲汲，乡思奈悠悠。\n行亦诿双老，用何能一筹。\n途中每自问，揩目看春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13315,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白鹿洞书院武侯靖节祠二首 其一","author":"蔡清","text":"洞中那得卧龙踪，因石兴思盖世公。\n当日何人撑国事，洞中正尔卧真龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13316,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白鹿洞书院武侯靖节祠二首 其二","author":"蔡清","text":"靖节当年更隐忧，欲为诸葛势难筹。\n眼中风物皆非旧，惟有黄花共晚秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13317,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"尹太守遗爱祠二首 其一","author":"蔡清","text":"山自苍苍水自深，贤侯遗爱可胜吟。\n至今一个祠前月，犹照当年抚字心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13318,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"尹太守遗爱祠二首 其二","author":"蔡清","text":"饶他橐里有千金，难买邱民一点心。\n今日泉山一片石，千年永作牧民箴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13319,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题何子完孝感诗","author":"蔡清","text":"昊天罔极更何言，此事惟堪心自怜。\n满卷新诗传盛事，孝心当日岂其然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13320,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月梅","author":"蔡清","text":"冬里有春一味清，不因风雪不知名。\n问渠知己有谁在，月在天心人在庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13321,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四一迂士卷","author":"蔡清","text":"造物无言露却真，采真多是看花人。\n傍花随柳前川乐，数百年来几问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13322,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送唐给事两广盘粮三首 其一","author":"蔡清","text":"使君自说未更事，足认使君自老成。\n年来颇讶当途客，欲将矫拂辅升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13323,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送唐给事两广盘粮三首 其二","author":"蔡清","text":"钱谷元非吾分外，握算亦能助太平。\n学术多君非口耳，此行认取旧书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13324,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]