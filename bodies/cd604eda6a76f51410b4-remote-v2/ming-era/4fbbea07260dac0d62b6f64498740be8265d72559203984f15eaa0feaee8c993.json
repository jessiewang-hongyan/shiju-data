[{"title":"贺右沙张先生七十一诗","author":"王希文","text":"忆昔相从共少年，浴沂童冠对花前。\n竞船涌在今成沼，鱼袋洲旁亦作田。\n旧族书香仁里厚，新英才翰兆沙圆。\n莫将花甲从头数，秀耸南山更十千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢晚节表邀后园赏荔","author":"王希文","text":"四围绕屋绿阴浓，仰见璚枝缀火红。\n洁本脂凝称玉润，丹疑朱绘有天工。\n词臣啖老罗浮日，妃子欢联驿骑风。\n自是江南声价重，品题何以续诸公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其一 大岭云屏","author":"王希文","text":"山高出群岫，山下会双流。\n马跃云生锦，狮拖日作毬。\n壁立如屏翰，文连并斗牛。\n千年佳气旺，世泽想松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其二 鼓楼龙石","author":"王希文","text":"曙色连宵暝，旃林向晓红。\n嵯峨龙脱甲，空谷响丁冬。\n楼不闻吹笛，石更无敲钟。\n夜来行雨去，一喝满天风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其三 后山华盖谢氏居场后岭","author":"王希文","text":"岭峤多佳丽，天皇拥绣屏。\n露珠沾叶润，翠盖倚天擎。\n风入涛声閧，云连树色暝。\n古称仁寿里，千岁产松苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其四 蚬岭云窝","author":"王希文","text":"结茅傍云谷，云栖喜有亭。\n攀云朝又暮，坐石醉还醒。\n药圃自高下，山光四渺冥。\n夜无行雨意，孤枕卧云屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其五 沙井龙涎","author":"王希文","text":"昆崙出阿耨，星宿透河源。\n峡度鸳鸯起，龙从山水旋。\n清香流翰墨，爽气润芸荪。\n五曜联东井，占沙应此圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其六 榕湾晚渡","author":"王希文","text":"白蘋吹岸断，细雨带潮平。\n漫渺榕湾曲，微茫野渡横。\n中流看击楫，天下想澄清。\n为问济川者，临渊愿自生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其七 石台印迹","author":"王希文","text":"何为而累累，丢下此磷磷。\n鹊起明光浪，铜抛剥藓痕。\n无金悬肘重，似篆结纹新。\n想是解官去，遗封石上尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为母舅谢东园公题良平芝山八景 其八 鞍岭归樵","author":"王希文","text":"勒马何年去，空闻留下鞍。\n攀崖悬石凳，荷斧入云盘。\n山僻有樵径，林疏无酒幔。\n看棋柯已烂，归路指潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"王希文","text":"大金在京口，小金来粤江。\n金名有大小，产皆国之良。\n兑泽久淬砺，离炎百炼钢。\n屹立柱中流，上映天日光。\n铸为双雄剑，诛奸留上方。\n剸系久易缺，神功宜善藏。\n飘然化双龙，跳跃出大荒。\n暮宿若木西，朝游浴扶桑。\n时伴回仙飞，万劫妖魔降。\n偶来看故庐，云山空苍苍。\n过者千万人，视此皆寻常。\n大器不世用，神物肯处囊。\n天地无边极，此当与低昂。\n翩翩驾两袖，二鹤贴云翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山寺","author":"王希文","text":"招提何代辟，峡势似盘成。\n四野窗中尽，三山槛外平。\n梵随兜率落，香过竹林清。\n欲谢尘缘去，茅庵从此营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠戴宾竹","author":"王希文","text":"有客寻幽盟，排扉日相访。\n身披翠羽衣，手植青藜杖。\n挥麈恣高谈，扫门谢尘鞅。\n琅玕启新声，金玉戛清响。\n拈风入吟坛，弄月过书幌。\n逸思定三竿，孤骞挺千丈。\n淩云看少豪，傲霜誇老壮。\n笋列拜天书，金茎吸云酿。\n募醉忽拚袂，晚来复相向。\n宾至主不迎，主坐宾不让。\n愿作无言交，永言伴清况。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题兰窗别号","author":"王希文","text":"沙明水碧茅溪上，风露香中小结庐。\n何处杏坛孤操远，百年花圣一窗虚。\n清标自得天然致，太极谁知不在书。\n坐到无言浑与化，春风桃李又何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思平闻惊书怀","author":"陈圭","text":"忧国愿时平，思乡爱短程。\n麻衣霜后薄，烽火夜深明。\n蓐食催宵发，山行趁晓晴。\n春晖常在目，寸草若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张彪秀才","author":"陈圭","text":"昔年曾握手，今日喜重逢。\n樽酒论交旧，篇诗入兴浓。\n长途淹骏骥，稚子识人龙。\n待聘吾儒事，斯文岂遂穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同陆月岩游十里庄喜太监寺","author":"陈圭","text":"野寺依高柳，春流入乱畦。\n山门初下马，丛薄乍闻鸡。\n古柏枝全屈，新蒲叶半齐。\n老僧迟客久，携手上招提。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西林寺","author":"陈圭","text":"寺古径偏曲，僧稀山更幽。\n昙花如笑客，瑶草不知秋。\n风细炉烟袅，云开塔影浮。\n虎溪何处是，吾欲问踪由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中小搆姚宝山以诗见贺依答六首 其一","author":"陈圭","text":"不见高人久，含情日倚楼。\n雕龙思绪论，吐凤忆风流。\n笔底三江泻，胸中万宝褒。\n何当击舟楫，一过白沙洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中小搆姚宝山以诗见贺依答六首 其二","author":"陈圭","text":"气屈双龙剑，才微五凤楼。\n振衣登绝巘，濯足俯长流。\n杖履应谁共，诗书祇自褒。\n已成遗侣鹤，寂寞宿沙洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中小搆姚宝山以诗见贺依答六首 其三","author":"陈圭","text":"昔与君同学，如登百尺楼。\n文诠超上乘，声价重时流。\n志气三秋吐，英雄万国褒。\n愿言皆脱颖，携手上瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中小搆姚宝山以诗见贺依答六首 其四","author":"陈圭","text":"聆言尘外性，爱此山中楼。\n种菊开三径，藏书杂九流。\n田家酒初熟，邻叟日相褒。\n风雨前溪恶，移船入萩洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中小搆姚宝山以诗见贺依答六首 其五","author":"陈圭","text":"江水通幽涧，山云覆小楼。\n渔樵堪混迹，天地与同流。\n日夕牛羊下，秋风禾麦褒。\n野人争席罢，鸥鸟满前洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中小搆姚宝山以诗见贺依答六首 其六","author":"陈圭","text":"山中读礼暇，时复一登楼。\n意懒云俱寂，心閒水自流。\n禽鱼随在适，鹿豕伴人褒。\n徙倚听渔父，长歌过故洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过大关","author":"陈圭","text":"两腋翛翛生羽翰，朗吟飞上百寻关。\n高声直欲呼阊阖，回首翻惊出世寰。\n守吏迎人趋道左，仙翁烧药卧云间。\n官程无奈东征急，一路清风过大安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒九峰书院","author":"陈圭","text":"一曲溪头上小航，九峰祠下仰清光。\n典谟训诰一家传，礼乐文章四叶芳。\n吾道渊源从此溯，圣门正脉属谁当。\n瓣香端拜抠衣去，又向前川谒紫阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿双石寺 其一","author":"陈圭","text":"古寺幽深一径通，落花流水小桥东。\n松巢老鹤三千丈，云绕仙坛十二重。\n我欲息机聊同榻，僧归无语但闻钟。\n从今识得桃源洞，暇日还来觅旧踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿双石寺 其二","author":"陈圭","text":"遥从天上领春回，特向山中访衲来。\n一径通幽花木胜，两山高耸石门开。\n松声萧瑟风生榻，梧影扶苏月满阶。\n去去苍生悬望久，莫教猿鹤误惊猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答程内翰年兄","author":"陈圭","text":"谁将奇字问扬雄，司马凌云赋未工。\n一夜秋堂成夙契，百年萍海聚浮踪。\n论交莫厌家风薄，涉世翻惊俗态浓。\n归去逢人如问讯，病夫心事寄冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佛子冈别松溪年兄程诗有佛子冈头之句赋此奉和","author":"陈圭","text":"临皋道上停骖处，佛子冈头话别时。\n聚散浮踪悲海梗，屈伸吾道任天机。\n一杯醽醁金樽尽，万里云霄玉舄飞。\n宇宙事多皆分内，江湖廊庙更何期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游那射山","author":"陈圭","text":"山川自昔因人重，此地惟今我始游。\n愈上高峰愈奇胜，不登绝顶不教休。\n云浮阴洞疑无际，人倚青天欲尽头。\n独立苍茫看元化，遥瞻北极是神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游六王山","author":"陈圭","text":"第一峰头纵大观，千岩万壑品题间。\n卜居拟入烟霞洞，设险还依虎豹关。\n未暇罗浮寻石室，不须勾漏觅金丹。\n何年整顿乾坤了，决计携家入此山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹亭","author":"陈圭","text":"簇簇琅玕翼翼亭，江山千载重斯名。\n岁寒有节凌霄汉，昼静无尘到几屏。\n摘寔尚堪供凤食，开窗时复听莺鸣。\n主人若欲添风月，快剑还须斩数茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"觐回德化与钟省庵年兄酌别二首 其一","author":"陈圭","text":"长安陌上走红尘，杨子江头问去津。\n满目莺花春欲尽，孤篷灯火夜常分。\n堪怜萍梗真无定，唯爱芝兰久不闻。\n此别应须各努力，中原麟凤网罗频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"觐回德化与钟省庵年兄酌别二首 其二","author":"陈圭","text":"金陵佳气郁葱葱，太守堂前乐事浓。\n紫阁黄扉春色好，白鱼青笋晓盘充。\n孔庭诗礼今重对，武邑弦歌即此风。\n别后诗篇须寄我，秋来霄汉有飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈幕府二首 其一","author":"陈圭","text":"幕府春风坐几年，宦情如水只依然。\n无人不道功曹好，主诺欣逢太守贤。\n魏阙重沾新雨露，故园休恋旧云烟。\n须知宓子弹琴暇，时上江楼望尔船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈幕府二首 其二","author":"陈圭","text":"一骑红尘万里同，五更金阙听鸣钟。\n太丘令长亦不恶，南郡功曹岂易逢。\n后会莫教悬榻久，先归应是惜花浓。\n兴来欲举山阴棹，水满春江月满空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李中嵩江南审录","author":"陈圭","text":"画省人龙今复离，都门惆怅酒醒时。\n简书郑重遥怜尔，云树苍茫更忆谁。\n雨露九千凭彩笔，风云万里脱尘缁。\n江南到处饶芳草，寄向归鸿慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太清河阻渡正觉寺偶成","author":"陈圭","text":"白云仙客下青齐，满目风烟路欲迷。\n关吏望尘迎鼓吹，山僧烧茗款招提。\n孤舟野水人难渡，芳草斜阳马自嘶。\n潭畔行吟春日晚，满庭高树几乌栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沂山瀑布泉","author":"陈圭","text":"百尺崖头观瀑布，泠泠飞雪洒晴空。\n深山六月白虹见，哨壁三更银汉通。\n直奔到海何曾住，欲上寻源不可穷。\n救旱为霖浑易事，定须龙起此波中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宁海州烟霞洞","author":"陈圭","text":"海上三山知有无，壮游聊访此仙都。\n眼穷扶木疑萍梗，身入松萝意画图。\n石室烟消丹灶冷，洞门云锁鹤田芜。\n东风未尽登临兴，山下斜阳鸟乱呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月一日登泰山","author":"陈圭","text":"岱宗秋日气高寒，绝顶西风自整冠。\n岩畔进香何处客，山巅封禅几时坛。\n眼空寰海三千界，路入青冥十八盘。\n薄暮故人劳载酒，翠微银烛整馀欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺潢涧公九月十六初度","author":"陈圭","text":"寿酒频倾年复年，金章紫绶色长鲜。\n安期火枣秋初熟，方朔蟠桃晚更圆。\n丛菊霜清芳气袭，甘棠风静颂声传。\n蹇予下榻劳青眼，为赋南山松柏篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题双寿卷","author":"陈圭","text":"南极空闻主寿昌，西池之说亦荒唐。\n争如二老乾坤并，共羡双雏霄汉翔。\n花县早曾分禄养，杏园今复以名扬。\n貤封有典须看取，锦轴辉煌御墨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊月诞日李五林寄诗和韵奉答","author":"陈圭","text":"煖入江梅气渐匀，典衣沽酒醉生辰。\n周南留滞嗟司马，谷口栖迟愧子真。\n白发慈颜频入梦，青云仙侣故相亲。\n风前肠断清扬远，忽枉瑶华浣渴尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送乡人陈竹园","author":"陈圭","text":"都门樽酒凌清晓，泮水芹香忆少年。\n万里烟霞双望眼，九秋风雨一归船。\n悬知宦况青毡上，且托乡书白雁前。\n独羡儒官偏意气，朝游南粤暮游燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨贰厓之任辰州司训","author":"陈圭","text":"春风万里辰阳道，落日孤舟楚水濆。\n草色连天迷极目，雁声冲雨怨离群。\n鳣堂旧识三台象，龙剑新开百鍊文。\n把酒都门无限意，赠君惟有五溪云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿东林寺","author":"陈圭","text":"霜后丛林秋气深，天边斜日映峰阴。\n十年宦海嗟陈迹，一夜禅房净客心。\n爱菊欲辞陶令印，赏桃空洒阮郎襟。\n山灵似解羁栖意，鹤唳猿啼月色沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田二首 其一","author":"陈圭","text":"岭外温和二月赊，东皇助巧染精华。\n清风吹遍池中水，化日烘开野外花。\n酒旆斜悬三五市，笑颜可敌百千家。\n升平处处歌尧德，解绶归来日未斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田二首 其二","author":"陈圭","text":"少壮登朝志已酬，似从天上下岣嵝。\n新供细泻疑堆玉，间步芳池任钓钩。\n一笑功名花鸟外，半生诗酒雁峰头。\n清狂似有神仙分，留伴山翁物外游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放艇","author":"陈圭","text":"放艇珠江未老违，聊携三五赏春晖。\n柳间撑出花间转，笑里来时醉里归。\n红锦丛中尘务远，白头交外故人稀。\n乘时正好寻真乐，风橹逍遥载月辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋姚宝山有约不遂次日见过","author":"陈圭","text":"待月荒庐夜不扃，半天风雨更凄清。\n孤踪自觉多悲况，皓魄相知亦世情。\n赤壁羽仙还入梦，山阴夜雪已寒盟。\n今宵握手同看处，顿觉秋光分外生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高材山","author":"陈圭","text":"暂辍清朝鹓鹭班，稍分微禄买青山。\n非关猿鹤多情绪，难得渔樵识面颜。\n绕洞浮云春霭霭，灌园流水夜潺潺。\n谢安宁为苍生起，嘱咐白云好闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都门送王君静斋归里","author":"陈圭","text":"王子人中豪，经史富怀抱。\n壮岁游京师，予见恨不早。\n盍簪虽云初，一晤已倾倒。\n归哉益勉旃，勿愧梧山老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都门送王君静斋归里","author":"潘大宾","text":"桂玉关心已自惊，那堪旅邸送君行。\n家同岭海八千里，归人异留两样情。\n溽雨乍收尘陌静，和风时动叶舟轻。\n箕裘独羡青云志，肯对恩波负圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东平道中有感","author":"冯彬","text":"晓发东平道，淅沥风露秋。\n道旁有古坟，累累翳荆丘。\n翁仲互倾侧，隧路狐狸游。\n询之道上人，阅代公与侯。\n忆昔全盛时，赐葬承恩优。\n松楸蔽天日，碑板蟠龙虬。\n一朝陵谷变，名姓不可求。\n悠悠百年身，旦夕同蜉蝣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜雀台","author":"冯彬","text":"云掩西陵树，遥望自摧残。\n忍睹遗香线，点滴泪痕班。\n层垥任是花开落，晚妆慵整新梳掠。\n灯迷罗幌月黄昏，辇路封尘人寂寞。\n君不见邺水潺湲自今古，白杨花逐乳鸦舞。\n繁华转眼空尘迹，当日娥眉徒爱惜。\n行人谩指建安时，一带青山堆白砾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜辞","author":"冯彬","text":"空屏影浸黄昏月，深院生凉梳洗歇。\n移阶看月不胜情，何处鸾笙声欲裂。\n行人路隔关山远，八月鱼书尤未转。\n湘罗浥露透肌寒，朱户无人时独掩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛江词","author":"冯彬","text":"云黯黯，雨潇潇。\n急涨江天晚，孤舟海国遥。\n荻芽抽绿菱翻紫，螺蚬春铛越女桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日过吴","author":"冯彬","text":"两度吴门值岁移，风光如约兴难支。\n春来客里无多日，人别天涯又及期。\n彩胜喜看红锦灿，椒盘空系白云思。\n梅花有意怜孤寂，旋放清香入酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观奕","author":"冯彬","text":"自从楚汉割鸿沟，海宇纷纷未息谋。\n背水风云推赵壁，入关车马报秦雠。\n眼前势局纵横变，指下机关磊落投。\n坐我几回消世虑，閒中一博胜封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊戌九秋扈从山陵","author":"冯彬","text":"御香载道护双螭，许著行衣揽辔随。\n满路弋林屯虎旅，隔山铃索驻龙旗。\n金乌玉雁藏真宅，翠釜朱型荐孝思。\n千古舜文今再见，感怀还咏有周诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓟门怀古","author":"冯彬","text":"灯火重门夜漏迟，渔阳往迹系遐思。\n胡尘日向潼关暗，铃雨时增剑阁悲。\n两路河湟皆陷贼，百年幽蓟竟沦夷。\n乾坤否后应还泰，甸辅皇图属盛时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]