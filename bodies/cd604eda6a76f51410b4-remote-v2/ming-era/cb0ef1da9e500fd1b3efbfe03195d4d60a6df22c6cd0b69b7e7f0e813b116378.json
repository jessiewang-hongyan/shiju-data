[{"title":"十五夜赋","author":"刘崧","text":"素月流天外，华灯出树间。\n美人吹凤管，秋水落龙湾。\n清露缘萝坠，凉风傍竹还。\n远怀当此夕，载酒过西山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沙村道中","author":"刘崧","text":"隔水望东绵，看云忆阆川。\n人行秋草里，雁落夕阳边。\n败屋犹依砦，荒村少种田。\n征徭浑未已，野哭更凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日感事三首 其一","author":"刘崧","text":"山寇能骑马，官军解掠人。\n徒然縻国赋，何以净边尘。\n周雅歌三捷，苗顽格七旬。\n又闻宽诏下，谁忍负深仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日感事三首 其二","author":"刘崧","text":"钟步时传警，新安久被围。\n乡山孤垒在，戍卒几人归。\n夜月喧鸣柝，秋霜裂战衣。\n艰危依主将，羽檄夜频飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日感事三首 其三","author":"刘崧","text":"闻道泸江破，伤心却复疑。\n六年犹力抗，群盗竟猖披。\n壮士乘危数，官军出援迟。\n几人全骨肉，夜走哭荒陂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虞检校奉省相命南迓王御史十月舟过珠林承寄佳作依韵奉答","author":"刘崧","text":"瓜熟东湖日，长怀别故人。\n忽传舟楫近，先寄墨题新。\n远候轻千里，幽居少四邻。\n几时持使节，来赏菊花春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画鹰","author":"刘崧","text":"自是飞腾物，仍兼画作殊。\n英姿风飒爽，苍翮锦模糊。\n云雾终当击，轩楹未可呼。\n海天秋万里，回首独踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吕焕文挽诗","author":"刘崧","text":"叹息瑶冈下，斯人不可寻。\n故床芸帙在，新冢蔓丛深。\n有弟求哀诔，无人续苦吟。\n宁知风雪夜，回首独沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题彭氏背郭茆堂图","author":"刘崧","text":"日薄金华岭，云深白石塘。\n茆茨元背郭，水竹自成乡。\n图画看逾好，登临兴不忘。\n门前双杏树，叶叶是秋霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送雩都吴文学","author":"刘崧","text":"长忆吴文学，居官近十年。\n俗随风土变，诗入瘴乡传。\n晓郭寻山屐，春江出峡船。\n乱离愁复别，况是落花天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮归至江口无舟投宿洲上田家","author":"刘崧","text":"野渡初维楫，林居早闭门。\n陂塍交白水，灯火向黄昏。\n问客安行李，呼儿具酒樽。\n艰难昧生理，深愧老翁言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出郭","author":"刘崧","text":"出郭念农事，渡江仍涉溪。\n城边愁落日，林下趁幽栖。\n紫椹交萝径，红花间豆畦。\n学耕心未已，冲雨看锄犁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江口汎舟得船字","author":"刘崧","text":"凉露青天下，繁星白水边。\n歌呼仍劝酒，起坐忽欹船。\n喧已非尘境，清疑是水仙。\n沙头灯火起，飞鹭亦翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过龙湾五王阁访友人不遇","author":"刘崧","text":"野桥秋水落，江阁冥烟微。\n白日又欲午，高人犹未归。\n青林依石塔，虚馆净柴扉。\n坐久思题字，翻怜柿叶稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻赣已被围而东固大坑又欲兵攻兴国有怀伯氏子中寓赣县之礼原阻乱不得归 其一","author":"刘崧","text":"叹息荆花树，今年好远游。\n路从兵后断，书是乱前收。\n漂泊从谁问，艰危信自谋。\n时时惊梦见，不解说离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻赣已被围而东固大坑又欲兵攻兴国有怀伯氏子中寓赣县之礼原阻乱不得归 其二","author":"刘崧","text":"江口移兵日，山中散砦时。\n一家俱念尔，孤客定依谁。\n秋早衣裳薄，时危去住疑。\n故园久残落，犹恐未全知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀王子启寓赣在兵围中已兼月矣 其一","author":"刘崧","text":"南上记乘涛，千峰一郡高。\n共言坚可托，讵想战频鏖。\n危急输群策，艰虞倚二豪。\n亦知城有窦，柴也若为逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀王子启寓赣在兵围中已兼月矣 其二","author":"刘崧","text":"行李今何在，兵围飒暮秋。\n定依故人住，谁慰老亲忧。\n远道乖鱼素，孤城抗虎头。\n伤心对明月，莫谩赋鄜州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再怀伯兄子中时有同客兴国者从间道先归兄以道阻后期不果","author":"刘崧","text":"贫贱轻离别，艰危昧死生。\n独违同里伴，仍阻异乡程。\n爱想深山憩，愁闻间道行。\n几时秋树下，慰此泪纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送医士归豫章","author":"刘崧","text":"落叶满城隅，南归感岁徂。\n海边曾种玉，市上忆悬壶。\n山近烟岚薄，江寒岛屿孤。\n惜无黄犊卖，从子住东湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题真上人幽居图","author":"刘崧","text":"岂有人知处，千峰拥翠岚。\n背林通药径，隔水见茆庵。\n说法鱼应听，栖禅鹤共参。\n经秋忘出户，落叶满岩龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓翁","author":"刘崧","text":"问翁何所寓，非寓亦非真。\n落落林泉迹，悠悠天地身。\n弹琴忘雅俗，饮酒信醨醇。\n千载蒙庄叟，相看意独亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿道德坛柬胡山人袁炼师萧鹏举 其一","author":"刘崧","text":"月色下金銮，鸡鸣出紫坛。\n不眠惊地迥，相语向更阑。\n酒过怜初醒，琴疏忆再弹。\n永怀栖遁乐，亦欲挂吾冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿道德坛柬胡山人袁炼师萧鹏举 其二","author":"刘崧","text":"解剑旌阳宅，吹笙萧史台。\n惊看龙跃出，疑有凤飞来。\n窗曙浮青桂，庭深散紫苔。\n翛然心迹静，谁更问蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送友人入韶口山中","author":"刘崧","text":"问客买乌犍，去耕韶口田。\n地饶无恶草，山近有流泉。\n过雨听春鸟，寻墟望晓烟。\n野人应避席，莫遣识遗贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋清江送廖子谦之临江","author":"刘崧","text":"清江清见底，千尺下沈沈。\n白鸟晴飞远，石龙云卧深。\n遥知在泮乐，好听濯缨吟。\n念此登临地，因之见夙心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日次萧鹏举二首 其一","author":"刘崧","text":"野客愁无赖，春来常晏眠。\n有时携美酒，独酌向青天。\n种豆珠林下，看花石屋前。\n故人不可见，佳句乃联翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日次萧鹏举二首 其二","author":"刘崧","text":"闻说南溪上，乱馀春可怜。\n花开愁落日，草长记流年。\n赋拟传金谷，茶应记玉川。\n寻常西郭路，思尔隔风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉华山","author":"刘崧","text":"翠巘千峰合，丹崖一径通。\n楼台上云气，草木动天风。\n野旷行人外，江平落雁中。\n伤心俯城郭，烟雨正濛濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题达监州草庵在金华之左","author":"刘崧","text":"云气随轩盖，飘飘日往来。\n茆茨元自葺，窗户有谁开。\n棠茇歌仍在，桐乡事可哀。\n星袍五花马，犹想月中回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋秋水送友人之豫章","author":"刘崧","text":"秋水碧盈盈，无波似镜平。\n渚云低不渡，江月照偏明。\n色映群鸥净，光涵一雁横。\n望中征棹发，应过豫章城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宋国宾往宁都求父丧","author":"刘崧","text":"野哭求亲冢，南循贡水濆。\n招魂当落日，负骨出寒云。\n驯鹿穿崖送，慈乌隐树闻。\n残年候归楫，风雪定纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟夜次杳口柬萧鹏举","author":"刘崧","text":"扁舟沿绿屿，双橹拆苍波。\n秋气水边早，月明江上多。\n鱼龙今夜冷，鸿雁几时过。\n去住关幽兴，欹眠听棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"触目","author":"刘崧","text":"到处草离离，重城秋暮时。\n荒园交兔径，残屋带荆篱。\n自倚城如铁，谁怜命若丝。\n诛求方未已，富庶定何期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南涧夜雪怀子启前东塘雪中寄诗未答","author":"刘崧","text":"昨夜南溪雪，故人安可期。\n欲寻行处履，长忆寄来诗。\n龙蛰沧江水，乌啼冻树枝。\n武山千丈玉，思尔共游时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题墨鹰","author":"刘崧","text":"莫氏写翎毛，精神故自豪。\n轩然苍隼立，郁彼北林高。\n急想追星火，轻疑掣旋绦。\n向来飞动意，感激使心劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆萧翀","author":"刘崧","text":"闻尔去南溪，移船驻水西。\n家人应共载，书帙得同携。\n道在隆污定，时危去住齐。\n风尘嗟两地，何处觅封题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭七弟","author":"刘崧","text":"季也伤愚戆，林间第七枝。\n生尝劳父训，死竟重兄悲。\n缚兔工何益，囊萤计已迟。\n虎儿应迈尔，教养待来兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题田舍壁","author":"刘崧","text":"门巷带青枫，村西有路通。\n鸟鸣高竹上，水落乱藤中。\n耕凿常时惯，招游旧俗同。\n寄言城市客，未可薄田翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题山水小景","author":"刘崧","text":"倚石群松秀，横江五柳繁。\n水侵陶令宅，山掩谢公村。\n浴鹭依晴桨，啼莺近晚尊。\n乱馀宁复此，展卷一消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄周伯宁二首 其一","author":"刘崧","text":"交友今谁在，东游最忆君。\n清尊澄夜月，綵笔动春云。\n楚甸烽烟合，秦淮树色分。\n相思愁日暮，花落正纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄周伯宁二首 其二","author":"刘崧","text":"江雨何时歇，淮云尽日飞。\n谁知千里别，还作故园归。\n露草侵棋局，风花上钓矶。\n徒令南浦上，山水忆清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经亡友故宅","author":"刘崧","text":"草没门前路，葵荒井畔园。\n乱泉通废沼，败屋露颓垣。\n已觉鸡豚散，空馀鸟雀喧。\n欲行还复止，寒日向黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次樟镇","author":"刘崧","text":"匝地闾阎盛，缘江雾雨稠。\n舟航通百粤，征税出南州。\n故里谁从问，修程且自由。\n携壶初问酒，移棹已惊秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻萧尚志抱病次韵奉寄","author":"刘崧","text":"山路兼泥潦，其如怅望何。\n浮云低近树，细雨暗长河。\n城晚乌鸢少，沙寒雁鹭多。\n似闻抱微恙，来问愧蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题竹石图","author":"刘崧","text":"为爱筼筜竹，苍苔节节封。\n低枝兼雨重，密叶与烟浓。\n丹穴终栖凤，沧溟未化龙。\n几时裁紫玉，吹上白云峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉寄孔监县","author":"刘崧","text":"宝匣动龙泉，纶巾拂紫烟。\n酣歌明月下，起舞落花前。\n野雉红襦短，溪鱼白锦鲜。\n亦怜春似海，安得酒盈船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别李子翀之金陵七首 其一","author":"刘崧","text":"之子金陵去，秋风飒暮江。\n西维流大火，南纪奠雄邦。\n鱼落波涛市，鸟啼烟雾窗。\n登临闻伐木，未得此心降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别李子翀之金陵七首 其二","author":"刘崧","text":"南北舟车会，公侯地宅多。\n百年新雨露，六代旧山河。\n夜月铜驼陌，秋风玉树歌。\n昔人遗感嘅，不必问如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别李子翀之金陵七首 其三","author":"刘崧","text":"凤凰去千载，城曲尚崇台。\n落日台前下，长江天际来。\n锦袍随梦远，玉笛与秋哀。\n定有骑黄鹤，凭高日往回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别李子翀之金陵七首 其四","author":"刘崧","text":"龙蟠梵王宅，钟阜出南东。\n一水天光限，诸峰雾气通。\n幡幢低晚树，钟磬下晴空。\n茆屋如堪赋，能忘讯已公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别李子翀之金陵七首 其五","author":"刘崧","text":"独往堪谁语，沈歌秪自怜。\n才名三十著，诗律几人传。\n凉幕惊巢燕，炎波看站鸢。\n荆南有刘表，把剑故凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别李子翀之金陵七首 其六","author":"刘崧","text":"往昔庐陵掾，监仓出万安。\n白鱼供日馔，红腐足朝盘。\n云暝千峰雨，江喧十月滩。\n向来栖息地，三见菊花残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别李子翀之金陵七首 其七","author":"刘崧","text":"相知仍少聚，即别转多怀。\n用世悲才忌，乘时贵俗谐。\n江声通巨蜀，云气尽长淮。\n亦有南淮志，何由与子偕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送萧同可之肇庆","author":"刘崧","text":"端州萧幕府，五十老能文。\n命秩乡人羡，诗名朝士闻。\n石门明夜雪，铜鼓暗春云。\n暂尔鲲鹏运，终然鹓鹭群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨待制挽诗","author":"刘崧","text":"郡邑徵循吏，词林忆侍臣。\n青云嗟濩落，白首见清真。\n论秀终裨国，锄奸肯避人。\n百年文物尽，愁绝故山春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨州判挽诗二首 其一","author":"刘崧","text":"浩荡孤飞迥，从容万敌麾。\n仕方觇命达，清已畏人知。\n白璧泥涂近，朱弦雅奏迟。\n春风江海思，萧艾故离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨州判挽诗二首 其二","author":"刘崧","text":"万里秦中役，前年渝上官。\n长才沦判牍，多病促归鞍。\n山雨孤坟暝，江风十月寒。\n萧条前辈远，双泪落汍澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏呈庐陵李司曹","author":"刘崧","text":"羡尔城阴屋，居来颇类村。\n竹枝斜点地，松树直当门。\n稚子青衣短，慈亲白发繁。\n客愁仍满眼，骑马雨昏昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊蓼州登岸寻旷氏馆","author":"刘崧","text":"江雨冷萧萧，维舟近画桥。\n不愁春烂漫，故恐浪漂摇。\n溆口明花树，城阴散柳条。\n故人高馆近，未觉旅魂销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 其一","author":"刘崧","text":"上日之官去，东门祖帐开。\n青云明淑景，朱绂称清才。\n花乱雏莺啭，江晴旅雁回。\n倘逢孙学谕，为报寄书来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 其二 渡江","author":"刘崧","text":"二月风涛壮，渡江愁远人。\n舟航那可恃，童仆转须亲。\n日射黄牛渚，天低石马津。\n向来临眺地，及此故伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 其三 送靖安教谕王贤卿归南安","author":"刘崧","text":"千里王文学，南寻庾岭归。\n诸生供祖帐，吾道有光辉。\n野树重重合，林花日日飞。\n茆堂漳水近，莫遣信音稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 其四 溪上","author":"刘崧","text":"溪路出南港，野林依古原。\n偶行桑树曲，颇似桃花源。\n茅屋居人遍，晴滩稚子喧。\n依依耦耕者，相对已忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 其五 赠葛希亮","author":"刘崧","text":"丰城龙化远，湛湛墨池深。\n每爱葛希亮，亲承邓蔚林。\n紫云腾瀚海，香雾袭书林。\n胶法亲前辈，清贞见尔心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 其六 千叶黄杨","author":"刘崧","text":"黄杨一尺许，千叶更千枝。\n秪益阶庭玩，能忘云汉思。\n雨荒承碧藓，风定注游丝。\n伤极偏多感，南归得共移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 斋前黄棠棣生于山茶两株之间春花夏条扶疏可爱兹始及秋而萎黄日见矧后此霜霰交积之时乎感赋一首 其七","author":"刘崧","text":"弱质不自植，扶疏故满林。\n繁英春后尽，病叶雨中深。\n斩伐非吾意，匡持见夙心。\n山茶亦何事，晏岁足清阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠赵录判之九江兼柬孙伯虞 其八 秋夕怀大兄及四舍弟时俱客兴国县山川阻修音问邈然","author":"刘崧","text":"岂谓无家别，三人各远方。\n已嗟甘旨薄，翻作道涂长。\n潋水风湍白，瑶冈雾树苍。\n书来定早晚，莫遣雁相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]