[{"title":"莺啭皇州 其二","author":"朱元璋","text":"禁城新柳叶成帷，隐映黄鹂深处啼。\n晴蝶逐风翻上下，晨鸡阅日唱东西。\n华衢紫陌人烟盛，绣户朱门烛焰低。\n景物美看茶酒肆，粉钿遥拥坐轻蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏京师","author":"朱元璋","text":"臣民推戴号神京，叹息驱驰行伍行。\n转战群雄机尚记，帅征英俊气方平。\n如今已足勋功赏，向后无知孰永名。\n暇日试将铜镜昭，乌髭堪比玉垂缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏唐陶将军率舟师","author":"朱元璋","text":"昔人奉命驾兵船，为国精忠突晓烟。\n令出三军凭战鼓，呼来万马仗龙泉。\n相加若肯存生意，比并何须用著鞭。\n必定清尘要服外，收功应达九重天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏柳州城戍守","author":"朱元璋","text":"城居边徼垒遐荒，烟瘴盈眸疠气茫。\n日暮海风摇屋树，春秋溪水泛篱墙。\n思军久戍炎蒸地，念将巡防热中肠。\n但愿昊穹舒造化，洗清郁结利南乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思开平下毗陵","author":"朱元璋","text":"忆昔雄师罢战灰，开平犹有教军台。\n自从南向北征去，直到如今永不来。\n思起相从不惮役，想来奋战愈增哀。\n有时梦里还相见，抱鼓声中旗甲开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"询洛","author":"朱元璋","text":"洛水宫妃衣绛袍，伊河清碧净飞涛。\n千年翁仲长应立，万古铜驼永不劳。\n往昔崤函车路阔，当今憩鹤洞云高。\n世充罔识天垂象，以致唐皇展豹韬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢汀洲隐浦","author":"朱元璋","text":"泛入遥江渐渺茫，芦花飞落雪飞扬。\n天边云影浮舟静，村外秋光列雁行。\n觅隐谁知栖所在，用心无处不筹量。\n卢生避世深幽迹，故入沧浪野水乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山沧溟隐谷","author":"朱元璋","text":"野人孤寂万重山，夜听猿啼峰顶间。\n洞口白云时自长，溪中清水日流湍。\n柴扉半掩松森处，炉火频添月色閒。\n已绝世尘忘俗事，吞霞服气玩灵丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"川原和居野","author":"朱元璋","text":"满目平原桑枣馀，那将田地长青芜。\n黄童逐豕随牛后，白叟乘驴继马徂。\n烟树半遮村酒旆，云山常见市廛图。\n野人自是无拘束，一日三番醉尽壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巨罟叟渔鱼","author":"朱元璋","text":"悠悠江静日和暄，迥水歌声度晓烟。\n渔网布时天上晒，布帆张处斗移边。\n风恬喜目遥山嫩，岸湿频看迩草鲜。\n薄暮欲归星月上，流萤点点近船舷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莽苍叟歌山","author":"朱元璋","text":"仰目巍峰柱上穹，千岩万壑尽玲珑。\n玄猿啸月丹崖侧，紫燕摩天碧汉中。\n樵牧往来云树里，牛羊归去雾烟东。\n山中人物常歌道，岁岁年年莽苍翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"擒禽兽伏","author":"朱元璋","text":"机人设阱欲擒谋，利镞调弦劲弩头。\n禽兽无知腾跃进，云霾深处触婴收。\n汤仁祝网施洪惠，禹智刳山展大猷。\n今古人情常不一，孰将天道与心筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟山云雨","author":"朱元璋","text":"崔嵬万怪玉笼葱，叆叇云浓雨碧松。\n千古钟灵佳气盛，几年淮秀瑞光明。\n倚天绝壁参银汉，拔地穹崖搆梵宫。\n时向望中闲极目，神机造化正鸿濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春赓王釐韵","author":"朱元璋","text":"春到阳和万象舒，至阴深敛九泉居。\n山川气霭坚冰泮，岳渎云生冷露除。\n但向静中观造化，特专闲里运图书。\n仁闻尧德兼天地，大洽苍生惟舜虞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓刘仲质韵","author":"朱元璋","text":"阳升阴降转洪钧，柳眼初舒造物新。\n泮却坚冰澄碧海，浮游暖气拂玄旻。\n从兹宇宙皆清泰，始觉舆图治化淳。\n淑鸟啭音鸣处处，弄晴花蝶舞先春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日新水","author":"朱元璋","text":"山云叆叇节初暄，景色清明春水涟。\n谷鸟喜鸣花沐雨，岩猿悦跃树笼烟。\n仙家麦饭云蒸熟，旅馆薇美气育鲜。\n最好满川浑似锦，涨溪新水印晴天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春水满泗泽","author":"朱元璋","text":"阳舒阴畅泽盈流，不卜应当大有秋。\n春雨花红林木盛，晓晴岩紫气岚浮。\n江皋钓艇蓑翁乐，云谷山人鹤仗悠。\n麦已蟠科烟禁日，呢喃燕语祝皇猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨洗山松","author":"朱元璋","text":"四山松柏夕尘连，宵雨朝来洗涤鲜。\n声听微风翻碧浪，光舒初气捲青烟。\n啼猿日晚跳还跃，舞鹤云归旋更翩。\n林麓笙簧莺啭巧，洞仙骑鹿上遥天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨洗山","author":"朱元璋","text":"初光入暑木阴森，远迩层峦尘满林。\n浩荡薰风至时雨，洗清岩壑爽烦襟。\n天边浪滚因松绿，山外云飞仗气深。\n正是农家耕耨节，野田处处尽歌吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑霁遥岑","author":"朱元璋","text":"蒸云敛尽远山青，万壑凉生宇宙明。\n林影淡摇溪内水，崖光偏映洞边藤。\n倚栏极目天开画，凭槛吟诗纸耀星。\n但把此时观畎亩，筋疲力倦始秋成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叹秋","author":"朱元璋","text":"碧梧露结晓凝霜，芦蕊瀰漫积雪扬。\n鸿雁翩翻来薄雾，巨鱼跳跃下清江。\n风声落木深秋意，云影垂天印日阳。\n闲看满山黄菊蕊，因蜂摇动暗浮香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"设潘宗道送友人归山东","author":"朱元璋","text":"共到神州独尔归，相携握手更牵衣。\n秦淮鸟啭乾坤泰，钟阜岩生日月辉。\n去此鲁田多种粟，宁乡齐地广栽薇。\n逢交必谕王纲振，率土编氓莫法违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣使为大祀犠牲北至齐鲁","author":"朱元璋","text":"钦天惟恐不精诚，命尔赍符驰驿行。\n淮海济州连地阔，江河徐邑旷川平。\n智人一目胸怀爽，霸业千年帝道兴。\n俗异语殊南北辨，由来混一大嘉祯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题隐者","author":"朱元璋","text":"固洁精魂欲上天，幽居深处水云边。\n烟封远浦沙鸥尽，树锁前山草鹿眠。\n书假管城应复路，楮生墨客未回川。\n逢人更祝坚清志，必日云衢足蹑前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪山寺","author":"朱元璋","text":"极目遥岑起晓烟，深埋凝雪梵王禅。\n冰枝老树弥千壑，衲被苍僧布法筵。\n为美浮生贪著处，好将空寂化迷迁。\n六年岭际今犹见，行致天花覆八埏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓周衡韵","author":"朱元璋","text":"彤云昨夜布长空，晓日遥岑白愈丰。\n盖世银妆黎庶户，盈岩玉砌梵王宫。\n渔樵各伎谁容易，释道众生孰建功。\n造化亦由人事见，十朝一雨五当风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"僧目空山","author":"朱元璋","text":"孤寂凄凄一径微，处心应与世尘违。\n朝观松鹤摩天去，暮见岩猿挽树归。\n瓶水一炉香满座，锡镮丈室气盈衣。\n空山僧对知何日，化作苍龙挟雨飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"命板的达稳禅","author":"朱元璋","text":"居山本是出尘埃，何为游人役已骸。\n晨坐岩前观日上，暮禅松底听风来。\n从教市巷笙歌美，莫羡闾阎酒肆谐。\n十二时中香袅篆，迎来送往更毋开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早行","author":"朱元璋","text":"忙著征衣快著鞭，转头月挂柳稍边。\n两三点露不为雨，七八个星尚在天。\n茅店鸡鸣人过语，竹篱犬吠客惊眠。\n等闲拥出扶桑日，社稷山河在眼前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新月","author":"朱元璋","text":"谁将玉爪指长空，万里山河一样同。\n映水有钩鱼却钓，衔山无箭鹤疑弓。\n清光未放云霄外，素影遥分宇宙中。\n轮满待逢三五□，九州四海照无穷。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赐都督佥事杨文广征南","author":"朱元璋","text":"大将南征胆气豪，腰悬秋水吕虔刀。\n雷鸣甲冑乾坤静，风动旌旗日月高。\n世上麒麟真有种，穴中蝼蚁竟何逃。\n大标铜柱归来日，庭院春深听伯劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"接树","author":"朱元璋","text":"老干将来发去烧，从新接起旧枝条。\n虽然未历风霜苦，自是先沾雨露饶。\n三四锹泥牢护足，二三皮蔑紧缠腰。\n东君看顾归家后，分付儿童莫去摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石矶新秋月色","author":"朱元璋","text":"素月澄澄斗转移，银河一派彻东西。\n风随鼓角争先应，鸟避旌旗不敢啼。\n志若明蟾清绝翳，心同碧汉静无私。\n雄师夜宿同英武，气槩森森采石矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘伯温","author":"朱元璋","text":"妙策良才建朕都，亡吴灭汉显英谟。\n不居凤阁调金鼎，却入云山炼玉炉。\n事业堪同商四老，功劳卑贱管夷吾。\n先生叱去归何处，朝入青山暮泛湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟山","author":"朱元璋","text":"翠微突兀倚晴穹，日色暄和紫气浓。\n谷内野猿跳上下，莺啼悠韵乐三冬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望钟山白云 其一","author":"朱元璋","text":"钟山万叠白云浮，密锁松稍爽气流。\n石径雨痕苔藓绿，苍崖根底蛰龙湫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望钟山白云 其二","author":"朱元璋","text":"万壑松阴起晓风，朱崖云幕亘长穹。\n应知造化诚难测，顷刻霶?显至工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莺啭皇州 其一","author":"朱元璋","text":"嫩柳莺啼三月天，园林簪绵绿阴鲜。\n乾坤气集皇州处，景盛人繁势自然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莺啭皇州 其二","author":"朱元璋","text":"皇州春晓日增辉，旅馆廷餐赐远夷。\n淑气鸟催鸣上苑，篆烟细袅出彤闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萍生","author":"朱元璋","text":"性觉先春肤色金，垂青之后漫精英。\n飞来陆野还成柳，飘入渊池化作萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思游寺","author":"朱元璋","text":"雨落黄梅麦已秋，日思精舍梦还游。\n晨昏几度经钟听，岩壑云生出野楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓马从韵","author":"朱元璋","text":"霏霏飒飒又纷纷，致使平原草色新。\n一夜好花都结子，乾坤大地没埃尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓朱孟辨韵","author":"朱元璋","text":"潇潇雨洒坠花频，衬地由来似褥茵。\n独有乾坤能造化，生成万物最多仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓桂慎韵","author":"朱元璋","text":"好风吹谢实成花，纠结飞飞似锦霞。\n志者春光阴寸惜，人生一世几荣华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓刘仲质韵","author":"朱元璋","text":"天地多仁惟好生，致令草木结华英。\n因风细雨枝头看，花已飞时子已成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后晴云赓马懿韵","author":"朱元璋","text":"万叠晴云起远峰，举头极目见天中。\n江山如□民安乐，溽暑蒸曲秋不空。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑蒸物盛","author":"朱元璋","text":"殿础氤氲紫气生，石泉漉漉似流行。\n山蒸海涌薰风节，万物依时得遂亨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望雨","author":"朱元璋","text":"日望天边起密云，月常皎洁日常晴。\n忧思禾槁民何福，腹内心煎意自怦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济时雨","author":"朱元璋","text":"暑雨天晴江汉清，寰中击壤贺升平。\n群卿尽职人风古，省己修身合上明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"目远山","author":"朱元璋","text":"云蔼远山风送雨，一薕高揭暑咸收。\n太平无事民康日，正在调和理顺秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青山白云 其一","author":"朱元璋","text":"凌穹巀嶪翠江边，佳气氤氲素练缠。\n势若游龙真造化，油然缥缈似飞绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青山白云 其二","author":"朱元璋","text":"云凝雨后翠张绵，隐露遥岑将近天。\n潭水龙吟吹白浪，丹崖穹处暮收烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青山白云 其三","author":"朱元璋","text":"青山云霭雪凝枝，画你长生太古诗。\n猿鹤自如岩谷迥，出尘野老本心知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青山白云 其四","author":"朱元璋","text":"钟山万木暑阴森，岩壑松风奏玉琴。\n溪涧碧流声韵美，望中佳兴致题吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓易毅韵","author":"朱元璋","text":"钟山洞口彩霞长，万壑云生济至阳。\n猿鹤每栖浑意乐，黄旗紫盖兆兴王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓卢均泰韵","author":"朱元璋","text":"钟山曙色夏初长，岩壑岚生辅太阳。\n几度雨馀天一碧，遥岑罗列更非常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山顶白云","author":"朱元璋","text":"山椒极目白云崇，蕤色缤纷百丈松。\n新水潺岩闻鼓韵，女萝遥似洞门封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春望牛首","author":"朱元璋","text":"遥岑峙立势苍然，春听莺啼景物鲜。\n叠嶂倚天江月外，三山映带石城边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日钟山赓裴植韵","author":"朱元璋","text":"倚苍罗列数奇峰，岩谷云生万态容。\n或尔有时楼阁见，分明一体广寒宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏李白游洞庭湖","author":"朱元璋","text":"苍梧山色水何分，碧镜澄湖杳渺云。\n惟有古人堪羡处，湘妃犹自望虞君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏李白早发白帝城 其一","author":"朱元璋","text":"白帝城高万叠间，江云朝出暮犹还。\n信知千古英雄地，虽险应须德作山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏李白早发白帝城 其二","author":"朱元璋","text":"谪仙东下入睢间，一叶扁舟日日还。\n闻说冲涛千尺浪，两江极目尽皆山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏李白秋下荆门","author":"朱元璋","text":"布帆高挂映长空，且喜新秋冷露风。\n数日轻舟归似箭，须臾系柳泊吴中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老禅纸帐","author":"朱元璋","text":"楼阁峥嵘半倚天，老禅纸帐昼酣眠。\n精魂惟识黄龙剑，定省还知叩玉泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪诗赓韩文辉韵","author":"朱元璋","text":"阴极阳生脽玉花，飘飘飒飒遍天涯。\n歌楼酒肆呼茶急，绣户重裀乐贵家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓李睿韵","author":"朱元璋","text":"阴极阳生建至和，飞花滕六玉山阿。\n从斯瘴疠同云捲，喜见民人相与歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寺掩山深 其一","author":"朱元璋","text":"绝迹高人隐翠岑，山连叠嶂白云深。\n欲经无觅通人处，时忽林风送磬音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寺掩山深 其二","author":"朱元璋","text":"见说山中了道僧，不闻钟鼓不闻经。\n朝观树顶香烟袅，暮识禅机一镜明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓马懿韵","author":"朱元璋","text":"山深树密嵌幽岩，僧舍清虚门锁岚。\n有客问禅无觅路，已知出世不同凡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云山僧寺","author":"朱元璋","text":"云笼紫翠槩鸿濛，洞口风生度梵钟。\n我欲叩禅闲问道，老僧心地与天同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又赓吴沉韵","author":"朱元璋","text":"天生倚碧壮云奇，岩壑隆峰万古宜。\n谷内野人几面壁，从前甲子了无知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]