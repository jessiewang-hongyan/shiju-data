[{"title":"辛丑元日","author":"欧大任","text":"千官元会肃金貂，草莽何由听九韶。\n楚水舟航淹日月，汉京鹓鹭满云霄。\n边防北虏期更戍，凯奏南蛮已入朝。\n想见阳和遍寰宇，沧江谁道有渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大天界寺","author":"欧大任","text":"长干路转宝林西，古寺犹看御敕题。\n自昔翠华临玉殿，至今黄鹤下丹梯。\n松边石蕴烟霞秀，阁上峰连日月低。\n一入脩门云卧久，细萝芳杜忆深栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游徐氏西园","author":"欧大任","text":"上公别业傍金门，开国千秋带砺存。\n楼古尚题烽火字，台高犹识凤凰原。\n周京白水疏封地，汉主黄山御赐园。\n闻道长安足尘土，无如此处问桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万岁殿","author":"欧大任","text":"琪园珠瓛净尘埃，当日祈灵别殿开。\n草色偏承黄辇过，鹤群还逐翠华来。\n合宫旧识唐尧宅，大一空传汉武台。\n趋走五云瞻望地，何年仙仗下蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天坛登望","author":"欧大任","text":"帝京南望九门前，大祀郊丘碧草鲜。\n圜殿恍闻仙陛乐，泰坛虚想御炉烟。\n河山缭绕彤宫辟，星斗周遭贝阙悬。\n歌颂太平多盛事，杨雄何日奏甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答薛考功省中玩月见寄","author":"欧大任","text":"碧天凉夜思徘徊，知有仙郎作赋才。\n金镜正悬鳷鹊观，玉绳低映凤凰台。\n新林远客空相望，扬子孤舟去不回。\n谁谓山公方启事，清尊能待故人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游牛首山用童庶子壁上韵二首 其一","author":"欧大任","text":"江左祥光拂露盘，城南双阙俯巑岏。\n辟支洞口僧卢近，罗什台前辇路宽。\n紫阁平临珠斗丽，黄山半入白云寒。\n蓬莱咫尺堪回首，鸾鹤翩翩肃羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游牛首山用童庶子壁上韵二首 其二","author":"欧大任","text":"万壑千山绕洞门，断碑苔藓不堪扪。\n花岩缥缈标铜爵，玉殿玲珑锁绀园。\n却爱楼台淩倒景，独愁钟鼓送黄昏。\n翠华尚忆当年事，空向东都父老论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少司马石峰陈公哀词","author":"欧大任","text":"东风吹雨木兰洲，司马山前逝水流。\n无复中朝瞻剑舄，空令南海想旌斿。\n阡题京兆犹原氏，冢象祁连拟霍侯。\n都下有人称故吏，不堪涕泪过西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送萧八出塞","author":"欧大任","text":"驰驱万里过长安，书寄随登大将坛。\n戈指棘门西日落，旆翻榆塞北风寒。\n封侯想见从军乐，报主休嗟行路难。\n醉别尊前成慷慨，请缨犹欲系楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈维藩还楚","author":"欧大任","text":"两都作客今怜汝，三楚逢人定忆家。\n登阁郢云连大别，开门湘水隔长沙。\n王孙一笑挥如意，国士相看赠莫邪。\n狗监悬知能引荐，马卿词赋不须嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别薛考功仲常","author":"欧大任","text":"江边驻马路将分，画省清歌不可闻。\n南海自怜藜杖客，北山谁勒草堂文。\n还家日月瞻丹阙，去国衣裳恋白云。\n只恐秋深鸿雁少，天涯空自怅离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄主客赵谭二大理出饯江上","author":"欧大任","text":"征虏亭边早戒寒，归人双旆动江干。\n法曹宠饯搴舟送，客部题诗把袂看。\n别后鹓鸿趋紫禁，愁来钟鼓忆长安。\n烟波万里怜予远，日暮空歌澧有兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚次湖口候陈公载黎惟敬二子不至","author":"欧大任","text":"日暮兰舟驿路催，秋阴黯黯思生哀。\n江空独见千帆度，风急谁传尺素来。\n万里风尘今拚袂，两都辞赋旧登台。\n匡庐彭蠡俱形胜，惆怅难逢谢客才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻边报","author":"欧大任","text":"大漠秋深万马驰，小王轻徱逐胡儿。\n燕歌翻作从军乐，羌笛愁闻出塞悲。\n乌垒风传青海箭，雁门霜拂黑山旗。\n周疆汉戍千年事，谁建旄头捣裔夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同唐允治南归度鄱阳湖作","author":"欧大任","text":"湖上秋烟晚渐微，冥冥江鸟逐人归。\n鱼书朔塞催骁骑，龙旆燕门发佽飞。\n南北路岐双客鬓，风尘天地一戎衣。\n出关日远长安路，回首彤云忆禁闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州谒舜庙","author":"欧大任","text":"南狩昔闻衡岳下，岂知韶石有遗思。\n衣垂坐处瞻龙衮，乐奏巡时识凤仪。\n禹贡瑶琨通海峤，尧封冠带附蛮夷。\n只今泪竹苍梧渺，愁见行云向九疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮登楼寄梁二公实","author":"欧大任","text":"五噫归去卧沧洲，我亦长裾落魄游。\n玉琯东回占淑气，金茎北望忆清秋。\n垂杨袅袅新临浦，鸣雁翩翩半过楼。\n闻道君王好辞赋，梁园车骑莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卜居","author":"欧大任","text":"淮南桂树久相招，白社归来有药苗。\n多病已妨年少日，端居犹愧圣明朝。\n南临绝海风烟迥，北望中原涕泪遥。\n卜筑江干聊遣兴，岁寒门径转萧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻陈季谦将至","author":"欧大任","text":"独有幽怀对薜萝，故人消息尚蹉跎。\n已催开径延三益，为想回桡咏九歌。\n南浦烟波那可问，北风舟楫近如何。\n兼程早赴柴门约，篱下黄华晚渐多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意二首 其一","author":"欧大任","text":"窦家夫婿远从军，少妇闺中织锦文。\n沙幕关山犹在望，玉门音信未堪闻。\n可怜芦叶吹秋月，不见菱花落晚云。\n谁遣琵琶传塞外，至今犹恨汉明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意二首 其二","author":"欧大任","text":"日暮千花损妾颜，春光不到白登山。\n千年榆柳依秦塞，万里葡萄入汉关。\n北望云州犹可见，西流陇水未应还。\n别离已惜容华晚，芳树楼前祇自攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺送钧弟之江西赋得孺子祠","author":"欧大任","text":"聘君祠屋楚江干，到日祠前木叶丹。\n院近湖光临晚静，阁连山色入秋寒。\n霜清揽袂搴洲莽，日落回桡咏澧兰。\n尔向豫章寻旧隐，东都应忆汉衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同黄廷寅黎惟敬游菖蒲涧访玉舄亭故址","author":"欧大任","text":"九日高台坠露清，千年残观紫烟平。\n铁桥不见仙人过，玉舄空留海客名。\n鹄岭晓看阊阖色，鸾霄秋送佩环声。\n涧边瑶草空相待，游戏玄洲下赤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王子新","author":"欧大任","text":"杨子秋风十载馀，白门消息近何如。\n共知城阙能招隐，岂但江潭可卜居。\n阮籍独闻苏岭啸，马卿今著茂陵书。\n烟波渺渺难逢汝，四百峰头已结庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送赵仲履参藩广西","author":"欧大任","text":"昔从棘寺绾铜章，此去薇垣紫绶长。\n屏翰西南雄五岭，提封东北带三湘。\n青春行部开牙旆，白日题诗出射堂。\n会见使君勋业重，汉家铜柱更辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴三首 其一","author":"欧大任","text":"帝城春色正堪怜，紫禁钟声度九天。\n已报旌旃临泰畤，更闻车骑幸甘泉。\n银涛朝涌三山日，珠树晴飘二室烟。\n万岁共听来献寿，千官争向从祈年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴三首 其二","author":"欧大任","text":"闻道祈灵下玉銮，春风扈从出长安。\n金泥已册崇高邑，宝鼎重开太一坛。\n乐府解传朱鹭曲，侍臣多戴鵔鸃冠。\n竹宫桂馆瞻依地，遥想蓬莱夜月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春兴三首 其三","author":"欧大任","text":"方士神君候祝釐，苍龙阙下拥朱旗。\n风回桂观炉烟袅，日闪芝坛扇影移。\n白帝始尊鄜畤礼，蒲池亲拜渭阳祠。\n独知圣主精禋意，时向郊丘讲盛仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"询徐伯元陈维藩二子","author":"欧大任","text":"青溪何处掩柴关，迢递天涯客未还。\n杨柳尚连江令宅，楼台应对谢公山。\n乌衣冠盖今何似，白下风流尚可攀。\n遥想旧京行乐地，片帆何日楚云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何衡州见访","author":"欧大任","text":"幽栖蓬户欲张罗，岁晏谁期五马过。\n上客衣冠留北海，诸生琴剑老西河。\n身归白社思廊庙，门掩青山对薜萝。\n无奈相从又相别，不知何地听鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏答友人","author":"欧大任","text":"辛夷花过客来稀，篱落萧然独掩扉。\n梅雨欲晴收药去，柘烟初起买茶归。\n林香山户枇杷熟，水腻池塘属玉肥。\n别后沈郎腰更瘦，病来浑欲不胜衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日大仑山房","author":"欧大任","text":"文笔峰前偃敝庐，衡茅寥寂野人疏。\n山中叶落迷樵径，林下猿啼傍客居。\n溪冷兰花愁欲佩，霜馀杮叶醉堪书。\n弦歌更拟营三径，谁遣门前候鹿车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过族兄任充墓","author":"欧大任","text":"吾家居士老羊裘，逸气平生竟一丘。\n隐市未逢无忌访，著书应待所忠求。\n瑶琴寂寞诗坛晚，宝剑凄凉宰树秋。\n闻道五噫终避世，要离犹可慰同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题唐明皇按荔枝新曲图","author":"欧大任","text":"弦管催欢太液头，曲中消息奏涪州。\n骊宫正想金舆远，羯鼓空馀玉座愁。\n花萼稀闻承内宴，霓裳无复侍宸游。\n雨淋铃夜西川路，犹忆长安一叶秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同陈公载吴而待梁公实粱思伯集黎惟敬梅花堂得门字","author":"欧大任","text":"瓜地烟深迷竹径，荷池舟过转花源。\n能令野服同招隐，自有幽林足避諠。\n谢客宾朋游石井，王郎瓢笠入云门。\n须知乐事从真赏，秋水濠梁未可论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕城闉纳凉得多字","author":"欧大任","text":"万里寥天一雁过，沧洲日暮水增波。\n不禁玉笛吹江艇，何处瑶华送楚歌。\n城上清霜秋早落，桥前乌鹊夜深多。\n乘风便欲将归去，寒入琼楼奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴刺史祠","author":"欧大任","text":"古庙荒凉貌俨然，石门山下海如天。\n香从沉处犹遗浦，井戒贪馀尚有泉。\n濮水东归无旧宅，卢城南望起新烟。\n秋风不见龙骧节，日落啼鸦送客船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀伦三膳部","author":"欧大任","text":"名家擢甲擅文章，三载留都尚作郎。\n起草曾闻趋建礼，含香今待入明光。\n苍龙阙下云霄近，白鹭洲前烟水长。\n一别沧江劳伫望，明年鸡树忆翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同何库部子时看山过青萝嶂","author":"欧大任","text":"东来望气过萝阡，南渡家山五百年。\n句曲自留陶侍读，始宁今待谢临川。\n柴车雨后馀双笠，藜杖云中少百钱。\n知尔身轻能济胜，朱明何日更寻仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒陶氏二忠祠","author":"欧大任","text":"汉室金吾四海闻，过家恩宠荷明君。\n仗分柴禁辞三殿，敕拜彤墀下五云。\n田禄独沾新息庙，封营犹纪信陵坟。\n欲知世烈重光日，归向中朝早策勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五仙观同陈道吾方绍宣校书答李教授","author":"欧大任","text":"散帙香芸到几编，璈笙缥缈过窗前。\n青牛未遇函关吏，高阁疑逢太乙仙。\n石在风尘犹有穗，社残宾客尚馀莲。\n书成爱尔能题寄，不是玄经授草年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂秋日四首 其一","author":"欧大任","text":"商飙千树送鸣蝉，洛涘閒居颇自怜。\n田傍西畴歌帝力，星悬南极祝亲年。\n蓬庐日有三荆乐，竹径时从二仲贤。\n何处丘中招隐士，开门长啸白云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂秋日四首 其二","author":"欧大任","text":"茅斋江上带沙汀，隐几焚香养性灵。\n壁在自藏高士传，书成终愧太玄经。\n山川摇落疑湘浦，橘柚芳芬似洞庭。\n未得此中甘寂寞，何人虚拟少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂秋日四首 其三","author":"欧大任","text":"芙蓉开向越江头，晚色萧萧倦倚楼。\n目尽关山千里月，风传砧杵万家秋。\n秦人独抱漳滨病，楚客难禁泽畔愁。\n此际相思正无限，况逢边雁下汀洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂秋日四首 其四","author":"欧大任","text":"荒村一亩闭蓬蒿，浊酒弹琴亦解劳。\n蛩响夜寒依草榻，潮痕秋晚落蘅皋。\n郎曹不遇嗟三叶，骑省将归感二毛。\n勋业百年翻自笑，风云西望汉坛高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同曹幼兴潘启纯海楼登望","author":"欧大任","text":"凭高一望散忧忡，摇落山川恨不穷。\n十里松门同谢客，三年江夏识黄童。\n天寒远树投归鸟，日落残霞没断鸿。\n烽火至今归未得，钓船多在五湖东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古四首 其一","author":"欧大任","text":"路尽中原历数新，秋风江上水粼粼。\n南巡不返胶舟日，东渡空劳舣棹人。\n豫让死能酬国士，屈原终合作波臣。\n黍离麦秀无穷恨，谁向行朝忆紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古四首 其二","author":"欧大任","text":"航海飘零万里行，孤臣一旅计难成。\n空令虎士披千战，那复鸡人报六更。\n岛上岂无田氏客，江东惟有汉家兵。\n伤心南渡金牌诏，长使遗黎说汴京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古四首 其三","author":"欧大任","text":"胡骑长驱入海门，舆图非复旧乾坤。\n月情只托方诸泪，春恨空销杜宇魂。\n精卫未捐填海愤，鸱夷犹抱入江冤。\n巫阳纵遣招难返，日落荒山听断猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古四首 其四","author":"欧大任","text":"间关百战事堪怜，越鸟何心北向燕。\n魂逐白鹇游四海，骨无青树记千年。\n铜驼草没荒宫外，玉玺光沉浊浪前。\n抱石怀沙君莫问，厓门东下水如天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬金陵王子新见怀","author":"欧大任","text":"著书白下掩柴门，岁晏风尘不受昏。\n贫有故人怜鲍叔，老无知己念虞翻。\n茅茨寂寞溪云暗，松菊萧条野日暄。\n别久悬知最相忆，篇诗遥寄与谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访傅木虚不遇","author":"欧大任","text":"山人瓢笠思悠哉，遁迹难逢石壁开。\n紫气远从函谷路，白云初过郁洲台。\n茅君冉冉三峰下，桂父飘飘五岭来。\n我自相寻非兴尽，溪头谁忆棹船回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠易道人","author":"欧大任","text":"杖策南来寻旧师，璇房瑶室住经时。\n葛洪远忆丹砂去，王烈犹逢石髓疑。\n南海早传瓜是枣，零陵今有术如芝。\n去去三山应咫尺，白云无迹鹤无期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀傅木虚游勾漏未返","author":"欧大任","text":"葛洪昔日求丹处，闻尔飘飖驾羽车。\n风静乍疑鸾啸后，田荒犹识象耕馀。\n朝随石室攀圭洞，夜蹑天坛礼玉虚。\n龙峤有经何处觅，蒙山应授羡门书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送童侍御仲良之宣州","author":"欧大任","text":"岭南藩幕似君希，去拥缇油渐北归。\n春谷泉经溪馆过，敬亭云入郡厅飞。\n吏民尽喜迎朱绂，鱼鸟浑忘避绣衣。\n闻道宣城名胜地，风流今见谢玄晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘安元归杭州","author":"欧大任","text":"说剑谈诗旧识名，南来倾盖不胜情。\n邺中客有刘公干，洛下人推陆士衡。\n留舄何年沧海畔，观涛八月虎林城。\n送君未尽扁舟兴，我欲桐江放棹行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日泛楼船作军乐","author":"欧大任","text":"江上重阳霁色鲜，晚携宾从上楼船。\n鼓笳月似登楼夜，戈甲秋如下濑年。\n沧海东南风九万，浮云西北路三千。\n绕歌欲奏从军曲，醉放中流一扣舷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王光禄应瑞","author":"欧大任","text":"北征何日赋骊驹，底事南山恋旧庐。\n乐署俸钱聊自适，步兵监酒更何如。\n心驰远道空成梦，交绝当途未有书。\n君去平津东阁上，莫云词客滞公车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀延平龙别驾子文","author":"欧大任","text":"尺书曾寄武夷君，九曲题诗不可闻。\n墨绶暂辞山县长，铜符今领郡参军。\n题舆已见陈蕃起，岸帻谁同谢奕群。\n想见镡津千里外，何年双剑在风云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王懋功因询皓上人徐居士","author":"欧大任","text":"王郎涴壁慕家鸡，文苑名高父子齐。\n山拟谢安营白土，宅连江总夹青溪。\n江边弄笛人何在，雪后乘舟路不迷。\n为访支公与玄度，旧游多在秣陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁比部公实","author":"欧大任","text":"江阁孤登倚碧空，高恢何处觅梁鸿。\n心随去雁层城上，梦入残砧落月中。\n林隔七贤前日会，径荒二仲几时同。\n萧条欲报东篱事，颇有柴桑处士风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招彦国仲登二子入社得欢字","author":"欧大任","text":"翩翩华盖啸双鸾，翠壁丹厓欲见难。\n社待陶公应肯入，坐无车胤不成欢。\n兰湖正拟同纫佩，蒲涧曾期共考槃。\n雪后东来一乘兴，扁舟无惜剡溪寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]