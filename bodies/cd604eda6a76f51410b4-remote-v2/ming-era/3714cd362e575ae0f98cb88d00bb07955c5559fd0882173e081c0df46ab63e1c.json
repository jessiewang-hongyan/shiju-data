[{"title":"过居庸","author":"韩雍","text":"居庸天下险，山势入青苍。\n路转羊肠曲，溪分雁尾长。\n关门严虎豹，烽堠禦豺狼。\n愿保藩屏固，皇图万世昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄袁州莫别驾伯颙","author":"韩雍","text":"鸟外云初净，宜阳望眼舒。\n故人久相别，佐郡近何如。\n分驾春行部，休衙夜诵书。\n仰山遗庙在，希古莫踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山翁","author":"韩雍","text":"屋枕楚山麓，门临湘水滨。\n树深啼鸟乱，网便得鱼新。\n尘世无他虑，閒居老此身。\n悠悠倦行客，转盻慕斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41004,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为赵总兵题扇","author":"韩雍","text":"握柄炎荒外，三军听指麾。\n良筹先已定，多算出还奇。\n瘴雾随时扫，清风到处吹。\n题诗比勋德，无沗赵征夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41005,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"示彭节归任","author":"韩雍","text":"辟尔远从征，贤劳重有声。\n马前朝草檄，幕下夜谈兵。\n奏凯还乡去，迎亲宰驿行。\n中原若开府，徵用更非轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41006,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题三洲岩","author":"韩雍","text":"开辟分元气，陶镕属化工。\n一拳平地上，万象太虚中。\n感古思羊祐，脩真慕葛洪。\n登临动高兴，长啸海天空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41007,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送鸿胪寺邓主簿送安南使臣事竣还京师","author":"韩雍","text":"相逢遽相别，归计忆神京。\n百粤风尘净，孤舟日夜行。\n远人空恋德，老我不胜情。\n道出吴门下，烦君一寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41008,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周汉章还吴","author":"韩雍","text":"辕门一相见，声价重南金。\n献我平蛮策，怜君为国心。\n别违还锦里，崇报待纶音。\n无限思乡意，题诗泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41009,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜闻台长李公总戎赵公同奉命出师辽东心同力同功成必矣寄鄙诗预申贺臆","author":"韩雍","text":"爱我同台长，公清果独贤。\n立朝才几日，出塞屡经年。\n北敌终颠覆，东人解倒悬。\n征夷又豪杰，同拟上凌烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41010,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠南海张行人戟 其一","author":"韩雍","text":"十载皇华使，贤名动四方。\n又乘司马传，重过魏公乡。\n昼锦添新彩，寒梅发古香。\n荣恩须补报，莫遣岁时荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41011,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠南海张行人戟 其二","author":"韩雍","text":"塞北曾相识，越南今又逢。\n如何两蓬鬓，都未歇萍踪。\n对酒心同感，思乡兴独浓。\n无能了公事，怅别意重重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41012,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送骆司训秩满赴京","author":"韩雍","text":"羡君司训久，遗爱入人深。\n已有成材效，都无计利心。\n离筵歌白雪，别泪湿青襟。\n此去应遭遇，春风听好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41013,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"思亲堂为吴县主簿李京春题","author":"韩雍","text":"椿凋萱尚茂，游子思难禁。\n长望号天地，如何分古今。\n不回观化梦，空负倚闾心。\n惟有脩臣节，荣亲报亦深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41014,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽骆司训乃尊易简翁","author":"韩雍","text":"易简久即世，如何人共怜。\n曾看太史传，又见令郎贤。\n孝行词林颂，书香泮水传。\n悬知无愧怍，含笑入重泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41015,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题致政张起韶太守双雁图","author":"韩雍","text":"高飞出上林，旅立在江浔。\n不恋稻粱美，自怡云水深。\n弋人空远慕，野鸟谩相侵。\n还看腾霄去，春风听好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41016,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟至南浦适亲友袁州同知莫伯颙来考绩既送予至丰城书此赠别","author":"韩雍","text":"良会不易得，联舟三日行。\n喜君书上最，与我叙离情。\n循吏真无忝，交亲预有荣。\n明廷公论在，看尔奋鹏程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41017,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"成化七年春二月十有八日余与总镇太监陈公总兵官平江伯陈公视耀武扬威关二公留款庆林寺寺前山坡之上其平如掌下临长江旁列茂树众登览为之跃然喜胜地之偶得感二公之高情而慨念时事遂及西师不觉浩然兴发因作一诗书贻寺僧同游者参议王孟育冯文纲也","author":"韩雍","text":"严关阅初遍，下马憩禅林。\n树覆连天幕，泉鸣隔涧琴。\n忧民成老疾，报国喜同心。\n闻道西征急，何时听捷音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41018,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢陈总兵送毡帽","author":"韩雍","text":"瘴乡风力恶，头骨痛难禁。\n新帽劳君送，高情爱我深。\n清晨笼短发，暖气温华簪。\n感德惭无报，缄诗表寸忱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41019,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四月十三日西轩晚坐偶成","author":"韩雍","text":"池亭晚来坐，对景已忘言。\n月色犹未满，蛙声空自喧。\n八年游岭海，何日到乡园。\n西北还多事，冥思心更烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41020,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽南京大理何寺丞衷","author":"韩雍","text":"详刑初拜命，观化遽伤生。\n未授廷丞席，空蜚徐杜声。\n金陵归旅衬，玉峡起新茔。\n留得秋台绩，无惭甲第名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41021,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李节妇诗","author":"韩雍","text":"苦节三十载，一乡人共尊。\n荐书辞达上，恩典未旌门。\n笋采名不死，共姜诗尚存。\n相将荷褒赠，云路有贤孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41022,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿张同年都宪","author":"韩雍","text":"老我同年友，相逢总异乡。\n一尊初庆度，七夕喜新凉。\n抚镇勋劳大，驱驰道路长。\n无能遥附骥，凝睇海茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41023,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题聚奎楼 其一","author":"韩雍","text":"腰横博带气横秋，仿古抡材共倚楼。\n杨子从来识词赋，魏公元薄快恩雠。\n疏帘秀捲青山入，高栋光依白日浮。\n闻道边尘犹未洗，欲升豪杰挽河流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题聚奎楼 其二","author":"韩雍","text":"楼成星聚兆文明，此日登临客况清。\n报国未能酬素志，兴贤深望济苍生。\n云开南浦双眸豁，月照东湖一掌平。\n寄语苏公好珍重，莫教方叔误时名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题尘清亭 其一","author":"韩雍","text":"亭上花枝覆草塘，亭前流水引源长。\n移来湘浦千竿雨，分得濂溪十里香。\n吟到碧天明月上，醉眠白石晚风凉。\n太平自有无穷乐，不为吹笙杂鼓篁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题尘清亭 其二","author":"韩雍","text":"一尘不到草亭深，雅称秋台铁石心。\n星聚衣冠占太史，风流觞咏继山阴。\n柑分低树和烟摘，酒出行厨带月斟。\n宾主淹留归路晚，满天风露夜沈沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿詹事府唐录事先生","author":"韩雍","text":"满袖天香午退朝，华堂开宴沸云韶。\n青田白鹤仙风在，绣绂苍麟瑞应昭。\n事业终期齐广受，寿龄还拟等松乔。\n酒酣试倚阑干望，南极文星映九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重庆堂为贡士顾祯题","author":"韩雍","text":"可乐无如具庆心，君家重庆乐尤深。\n报刘殊胜陈情密，事点还同养志参。\n百岁奉萱培二本，一生爱日惜分阴。\n高堂华扁须珍重，早晚恩光拟照临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"营建纪成陈都堂命为阮太监题","author":"韩雍","text":"内相承宣下玉阶，经营殊不费民财。\n圣明仁化如天覆，黎庶欢心若子来。\n洛水功成光镐邑，斯干诗咏继灵台。\n有周俪美逢今日，欲献赓歌愧菲才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽道士陈缉熙求","author":"韩雍","text":"九转丹成生羽翰，烟霞拂袖出尘寰。\n壶中演秘龙初伏，岛外寻真鹤未还。\n松径净迷苍雪冷，竹窗空锁白云间。\n洞庭凉夜吹箫过，水满江天月满山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长洲张医士妻葬青龙坞陈都堂命作挽诗","author":"韩雍","text":"瑶池会看舞山香，尘满芙芙月满堂。\n乌鹊桥空红雨乱，青龙坞远白云荒。\n医传上国思贤助，学富东吴慕义方。\n嬴得乡评重潜德，为题诗句共揄扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽薛亚卿父","author":"韩雍","text":"词翰兼优绝代无，养高不受俗尘污。\n忽从瑶水群仙会，遂判香山九老图。\n丹凤衔书恩礼重，苍龙解绂泪痕枯。\n传家幸有皋陶子，大展经纶弼圣谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨练师受度牒还山陈缉熙求","author":"韩雍","text":"早闻学道出尘寰，今喜观光觐圣颜。\n黄石素书传圯上，青牛紫气度函关。\n九重帝泽千年遇，万里仙槎八月还。\n此去知君招不得，想应跨鹤入茅山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吴御史昌衍所藏先世菊隐卷","author":"韩雍","text":"三径黄花事退休，故家诗画几时留。\n满笺香墨腾风露，万斛明珠缀冕旒。\n流落久嗟遗泽泯，来归深喜后人求。\n珍藏莫道凋零尽，尚有文光射斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽姑苏张医士","author":"韩雍","text":"遁迹吴山世业医，家声高与古人期。\n杏栽董奉空千树，鹤驾苏耽去几时。\n松柏寒云愁满地，梧桐秋雨泪连枝。\n百年馀庆今何在，嬴得诸郎有白眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题顾仲礼藏春楼","author":"韩雍","text":"香满吴山总是春，楼中春意浩无垠。\n暖风入座鸟声细，晴雨捲帘花气新。\n万物均含形色性，一腔同寓发生仁。\n何当袖拂烟霞去，卜筑相依养道真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"屏山楼胡御史拱辰为舒安求","author":"韩雍","text":"名山相对搆层楼，山势如平翠欲流。\n云捲半帘天影近，风来满座雨声浮。\n羊元独卧筠床晚，苏轼重游赤壁秋。\n千载芳名今并美，好传家业振箕裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松轩为乡人题","author":"韩雍","text":"百亩田园万树松，结轩相对日从容。\n天风夜半来鸣鹤，雷雨春深起蛰龙。\n香入吟窗钩翡翠，清分坐榻湿芙蓉。\n几回乡梦曾相过，身在徂徕第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文会堂为姑苏唐以敏题","author":"韩雍","text":"新筑茅堂傍竹林，茅堂隐隐竹森森。\n朋簪累盍薰陶久，丽泽相资造诣深。\n明月半窗无俗侣，清风一曲有知音。\n何时归棹吴江上，共挹沧浪洗渴心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仁化草堂为曲江黄御史父处士题","author":"韩雍","text":"为爱茅堂近曲江，云山叠叠水淙淙。\n一筇晴雨行南亩，半榻清风卧北窗。\n少室山人今有几，杜陵野老古无双。\n传家又得宁馨子，衣绣乘骢在帝邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"恬澹轩为大德观王道士题","author":"韩雍","text":"昔年欲问参同契，暇日曾过恬澹轩。\n羽客相逢应悟道，黄庭诵罢竟忘言。\n宾墀苔老稀人迹，仙丈云深绝市諠。\n身世飘然如物外，何须更懝访桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都门别意送陈都宪从子佶省都宪毕归吴","author":"韩雍","text":"鸟啼花发媚皇州，袖拂东风去莫留。\n客计不知归路倦，乡心应念倚闾愁。\n百年门第天伦重，万卷诗书世德修。\n闻道严君思仲父，看云白昼卧江头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河阳亭为吴兴潘用中题其孙景善登太学岳之裔也","author":"韩雍","text":"潘氏园亭桃李盛，栽培先德动遐思。\n好花不异河阳县，明世应非典午时。\n尊俎当筵留野客，溪山入座助新诗。\n贤孙早晚腾霄汉，枯槁行沾雨露滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题沈进士纪松月扇面","author":"韩雍","text":"谁将轻箑图松月，一握双清惬素心。\n云净九霄仙兔出，风生万壑老龙吟。\n庙堂大用期登进，海宇馀光仰照临。\n珍重乌台挥动处，红尘相避不相侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"都门别意为曲江黄御史父作","author":"韩雍","text":"冠盖如云出帝都，送君何处是归途。\n曲江秋水鸥寻侣，丹穴朝阳凤忆雏。\n双屐行探春信早，一尊吟对月明孤。\n草堂到日多耆旧，重画香山九老图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送上虞罗御史澄使闽中","author":"韩雍","text":"使者新裁豸锦衣，故乡便道喜荣归。\n九重严命龙章宠，七帙慈亲鹤发稀。\n堂北花香秋正好，越南山色昼生辉。\n闽天后夜人瞻处，执法星光映太微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"交代芮御史钊按治江西诗送还京","author":"韩雍","text":"同年同志复同官，客里相逢握手欢。\n千里归心辞我易，一年新政继君难。\n鄱湖水落清秋度，庐阜峰高后夜看。\n朝退金门如有暇，老亲烦为报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41048,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠刘状元代祀舜帝便道故乡展焚黄礼","author":"韩雍","text":"远将玉帛祀先皇，秋雁寒云满路香。\n白发喜归梁颢第，锦衣荣过魏公乡。\n书衔彩凤光松梓，梦绕飞龙在庙堂。\n忧国忧民丈夫事，回轩莫待菊花黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41049,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻杨亚卿弟宜有御史之擢","author":"韩雍","text":"郡博先生庆泽深，传家昆季更谁伦。\n难兄久佐秋台政，阿弟新迁宪府臣。\n五色云中双凤鸟，九重天上对麒麟。\n匡时更有经纶事，不数三苏与二陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41050,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡御史渊还京次留别韵","author":"韩雍","text":"手持玉斧靖三边，人颂清名继四贤。\n恋阙久知心捧日，封章几见力回天。\n云开庐岳迎归旆，水满鄱湖送去船。\n万里同来不同往，江亭绿酒兴悽然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送姑苏潘进士暄淮府造坟事竣还京","author":"韩雍","text":"南浦西风酒一尊，乡情分袂暗销魂。\n成功已副贤王意，奏绩应沾圣主恩。\n家近松陵山有色，舟经杨子水无痕。\n欲知后夜相思处，月满霜台独倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"景泰改元正月一日王潘二进士赍敕奖劳亚卿杨公有清勤公正之褒且有金帛之赐诗以贺之","author":"韩雍","text":"中兴圣主重贤劳，衮冕临轩遣俊髦。\n宠遇共誇金帛赐，清勤无忝玺书褒。\n九霄雨露新春被，一代君臣此日遭。\n江石苍生望风采，庐山光价两相高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正统己巳秋客中闻大驾北狩未还惊号赋此","author":"韩雍","text":"翠华北狩正侵彊，未报归期重感伤。\n百辟有谁能扈跸，一身无计可勤王。\n龙沙碛里秋容惨，羌笛声中夜漏长。\n怅望何时遂迎复，西风吹泪洒苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"琴鹤轩为王仪宾题","author":"韩雍","text":"承运朝回脱锦衣，瑶琴白鹤两忘机。\n弦中一曲成连至，天外数声和靖归。\n台榭月明迷素羽，琅玕风动杂金徽。\n纷纷尘事浑忘却，歌舞何曾满绣帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冰壶为前人题","author":"韩雍","text":"幽人常在雪轩居，恍若清冰置玉壶。\n昼静一尘无处著，岁寒三友隔帘呼。\n间从芳沼寻鸥侣，睡起开笼放鹤雏。\n闻道丹青尤绝笔，时时写拟辋川图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵题李主事叔玉使节还京卷","author":"韩雍","text":"一点丹心忆翠华，无边风景送星槎。\n寒云渺渺随秋雁，孤鹜翩翩带落霞。\n自信穷经能致用，谁知忧国总忘家。\n何当拂袖同归去，十二街头扫雪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次李主事过惶恐滩韵","author":"韩雍","text":"锦缆牙樯江上过，滔天烟焰起风波。\n欲将一臂扶周鼎，可奈三军作楚歌。\n誓死不依元日月，精忠独照宋山河。\n试听惶恐滩头水，犹似当年呜咽多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41058,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"景泰庚午客中中秋有感去岁此日有土木之变鸾舆未复","author":"韩雍","text":"客里中秋忆去年，望云遥拜泪潸然。\n唐人未睹朝仪复，汉将谁扶国步颠。\n借问几人随幸辇，空传一雁到冰天。\n凄凉最是今宵月，莫向千门万户圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41059,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒鄂王祠","author":"韩雍","text":"南渡君臣社稷轻，独将大义振孤兵。\n两行泪滴中原地，一点心悬五国城。\n竹帛芳名今照古，庙堂遗像死犹生。\n九原若遇秦奸贼，为问谁家父子荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41060,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送朱御史骥出使淮楚","author":"韩雍","text":"面带霜威出内台，光腾执法射三台。\n观风久熟宜民政，按部今施济世才。\n当道豺狼何日遁，朝阳凤鸟几时来。\n知君素有澄清志，一点丹心莫暂灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41061,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张评事柷坐累出为处州知事暨丁内艰服阙朝京赋诗留别次韵奉赠","author":"韩雍","text":"早岁香名禁籍收，腰横博带气横秋。\n平反有誉传中外，谪宦无惭任去留。\n鸾凤终非鹰隼类，江湖须抱庙堂忧。\n朝天此去沾恩宠，肯使潮阳困白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41062,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸳湖归棹为姑苏屯田张指挥作","author":"韩雍","text":"九重宵旰重兵农，阅稼将军已建功。\n万顷垂花田似锦，一帆归棹气如虹。\n牙旗光射鸳湖水，鼓角声传虎帐风。\n自古忠臣报明主，济川勋业是英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41063,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拜都御史之命留别广东诸同寅","author":"韩雍","text":"相亲未久即相知，忍向江头话别离。\n明主恩深无可报，苍生望重有何为。\n舟移南海乘潮发，帆挂东风带雨吹。\n明到梅关重回首，天南天北几相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41064,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠吴中诸友","author":"韩雍","text":"皇华使者日边来，叨拜纶音总内台。\n四海澄清元有志，百寮表率愧非才。\n风霜敢谓摇山岳，雨露终期振草莱。\n却叹君恩无可报，惟将三尺效涓埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41065,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]