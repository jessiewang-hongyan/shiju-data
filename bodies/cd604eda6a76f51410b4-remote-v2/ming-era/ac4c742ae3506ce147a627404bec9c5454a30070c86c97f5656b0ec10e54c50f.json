[{"title":"送僧游吴","author":"王恭","text":"远师何处去，迢递别东林。\n浙水人烟积，吴门雨雪深。\n寒山孤烛影，建业暮钟音。\n处处应留偈，悬知不住心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与医者遇诗以赠之","author":"王恭","text":"长桑亲受诀，复饮上池清。\n卖药宁论价，还山尚隐名。\n杏林春露积，桔井野泉平。\n见遇能医国，何辞缨冕荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经鄱阳舟中作","author":"王恭","text":"扬帆渡彭蠡，云树晓冥冥。\n潮到浔阳白，山连建业青。\n乾坤随去鸟，江海任流萍。\n回首乡林远，归鸿不可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登雁山望太常峰有怀所知","author":"王恭","text":"雁山青翠里，遥见太常峰。\n胜槩无期到，幽人何处逢。\n仙源云缥缈，秪苑树蒙茸。\n兴尽独归去，空林闻暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠道省亲","author":"王恭","text":"独鸐下三天，吹笙度紫烟。\n道心飞鸟外，亲舍白云边。\n丹脉调香饭，霞衣拂寿筵。\n更教人代里，何处觅神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邑令秩满之天官","author":"王恭","text":"天南望帝畿，迢递入铨闱。\n作县三年别，趋朝几日归。\n楚江帆漠漠，淮岸马騑騑。\n想是龙池上，香名是尔稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"六平峰山送人之吴","author":"王恭","text":"斗酒临长驿，孤帆半夕阳。\n花催离思急，柳引醉歌长。\n楚树兼云远，吴江到海苍。\n六平山下路，何日更持觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田家喜晴","author":"王恭","text":"田家当惜雨，积雨转伤苗。\n诘旦云犹湿，新晴潦渐消。\n迅雷潜地底，初日映山椒。\n预卜丰年兆，何应荅圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人使边","author":"王恭","text":"汉节下青冥，边人望使星。\n绣衣辞凤阙，骢马入龙亭。\n雪净胡天绿，春回塞草青。\n须令月支长，函表到王庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲夏五日游盘石 其一","author":"王恭","text":"盘石临湖面，凉风薜荔清。\n酒酣山鸟狎，曲度水龙听。\n兴极飞兰棹，神游到玉瓶。\n不知湘木上，飘泊为谁醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲夏五日游盘石 其二","author":"王恭","text":"盘石苍山口，欢游重盍簪。\n酒醒荷气琼，云断水容阴。\n画楫浮空迥，青娥隔雨深。\n怀沙千古事，谁是独清心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏荔枝","author":"王恭","text":"忆昔开元日，繁华御里看。\n玉环天上去，无复到长安。\n香沁琼浆冷，红垂火剂团。\n九重思玉食，驰贡未应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀画史林景时 其一","author":"王恭","text":"故人何处住，独树孟家邻。\n水墨今谁重，云泉我共贫。\n襟期多古意，交态任时人。\n醉里从挥洒，无钱奉老亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀画史林景时 其二","author":"王恭","text":"木墨人皆羡，承平祗布衣。\n云山随处写，乡树暂时归。\n两地愁看月，孤村独掩扉。\n幽期应早计，何事久相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与同志泛舟得江字","author":"王恭","text":"浦口齐桡乐，沧波泛玉缸。\n云归山点点，天碧鸟双双。\n蚌月凉生夜，鱼风响渡江。\n兴来须剧饮，无使寸心降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送友人伸蒙岩读书","author":"王恭","text":"筹峰烟磬里，君去独垂帷。\n散帖林中晚，悬灯雨外微。\n书声连涧水，人影落苔衣。\n不独伸蒙子，辛勤似者稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人赴秋闱","author":"王恭","text":"凉露滴宫槐，黄花映古苔。\n秋风芹泮别，曙日棘闱开。\n战胜应谁敌，名香得意回。\n知君经济手，不愧子云才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠武夷僧","author":"王恭","text":"武夷山水好，潭影空禅心。\n挂袖云生石，翻经月照林。\n履行随竹静，钵洗向泉深。\n九江仙源里，惟闻钟磬音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲秋洪山经狂客墓","author":"王恭","text":"狂客今何在，风流世共传。\n夜台依宿草，陇树入新烟。\n月冷延陵剑，湖空贺监船。\n秋风正摇落，回首独潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠道人别","author":"王恭","text":"尘中那久住，飞佩入千山。\n片石松边住，孤云鹤上还。\n苔深丹灶绿，叶坠紫宫闲。\n后夜玄洲月，相思杳蔼间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题美人吹箫图","author":"王恭","text":"可怜嬴氏女，粉绘若平生。\n无复乘鸾偶，空馀弄玉名。\n隔花疑解语，横笛恍闻声。\n却忆秦楼月，偏关独客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"僧房秋夜","author":"王恭","text":"寂寂空门掩，三花隐乱峰。\n经残僧入定，林暝鹤归松。\n境静天香入，帘疏月影重。\n永怀禅榻夜，无梦到尘踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄建上客","author":"王恭","text":"建水接闽关，连峰鸟外闲。\n鱼商墟市远，虾菜野桥湾。\n烟火舟中饭，乡林梦里还。\n年年贪利涉，不道解离颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月下闻琴","author":"王恭","text":"空林微月出，花下一琴横。\n忽听宫商调，而多山水情。\n云边孤雁断，秋外百泉鸣。\n坐久长河没，犹馀灵籁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟题古山寺","author":"王恭","text":"灵源飞鸟外，崱顶翠蒙茸。\n雪覆经春叶，云残渡壑钟。\n逢僧留半偈，习静爱中峰。\n自笑红尘里，谁能寄远踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王摩诘山居即事韵","author":"王恭","text":"寥寥人境外，闲坐爱晴晖。\n谷转猿声迥，林幽鸟影稀。\n雨深苔藓壁，潭映薜萝衣。\n日夕忘机处，孤云去复归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"老将还乡","author":"王恭","text":"百战解重围，三边受铁衣。\n萧条关塞别，迢递故乡归。\n旧业春苗发，青山白发稀。\n独怜闲夜梦，犹绕羽林飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜寒曲","author":"王恭","text":"霜叶冷飕飕，鸦啼井上楼。\n辘轳哀响断，蟋蟀夜深愁。\n绣被兰香灭，银筝雁影流。\n相思红烛尽，敲碎玉搔头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮秋太常峰扫松楸","author":"王恭","text":"迢递孤峰里，含情对古丘。\n苔碑空鸟迹，山叶带猿愁。\n野烧泉门夕，寒花陇树秋。\n临风一浇酒，回首泪双流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文石渔家","author":"王恭","text":"海国春鸿外，人烟尽木乡。\n潮生孤屿没，月出白沙凉。\n夜火邻鲛室，云帆拂蛎房。\n从来少耕种，辛苦坐沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题鹫峰废寺","author":"王恭","text":"鹫岭郁苍苍，香台出上方。\n苔花侵佛像，荔叶满僧房。\n禅榻馀残霭，钟楼半夕阳。\n空门无色相，何必叹凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送道士还山中","author":"王恭","text":"仙台飞鸟外，灌木隐琳宫。\n归路多瑶草，还山尽锦峰。\n浴舟临野水，飞佩入寒松。\n愧我红尘里，空怜绝世踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟早朝","author":"王恭","text":"钟鼓金门曙，千官列雁行。\n西山含落月，北阙映初阳。\n御柳蓬莱色，宫花太液香。\n袖中有三策，思欲上君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中即事","author":"王恭","text":"习静当幽处，闲扉隐翠微。\n林间闻鸟近，云际见人稀。\n曲洞留残雪，高岩挂落晖。\n遥知铜墨贵，不羡薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春饯别","author":"王恭","text":"官柳拂晴烟，情多又别筵。\n且倾寒食酒，将赠绕朝鞭。\n远树青云外，孤帆夕鸟边。\n明朝相忆处，两地听啼鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春羁怀","author":"王恭","text":"旅馆春将尽，乡心醉不迷。\n人烟随去住，萍梗任东西。\n花落吴山暮，鸿归楚树低。\n解鞍空伫立，无那子规啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送僧省亲","author":"王恭","text":"空门恩爱稀，欲去省庭闱。\n亲舍无期别，白云长自飞。\n浮杯寻故里，洗钵见春晖。\n莫遣红尘里，人烟涴衲衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居写兴","author":"王恭","text":"幽栖青嶂下，尘事少相侵。\n亦有渔樵乐，而无缨冕心。\n竹闲书幌净，花汎墨池深。\n醉卧云萝下，机忘鸟自吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山路闻鹧鸪","author":"王恭","text":"朝入翠微畔，钩辀雨外鸣。\n声声行不得，去去若为情。\n苦竹湘南驿，黄茅岭外程。\n乡心正无那，闻尔泪沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐贾岛题李疑幽居仍次韵","author":"王恭","text":"爱尔幽栖处，清凉水竹园。\n远山频对酒，芳草独开门。\n卷幔通云影，横琴拂石根。\n仙源只如此，相对更何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行逢故人坟","author":"王恭","text":"系马荒林下，萧条对古坟。\n伤心逢断碣，挥泪读遗文。\n宿草今谁泣，清?不可闻。\n空馀三尺剑，落日挂楸枌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山寺读书 其一","author":"王恭","text":"赢粮寻翠巘，负笈入琳林。\n书映藤萝色，声随钟梵音。\n芸香孤鸟外，灯影断猿深。\n寂寂空门夜，闲窥往圣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山寺读书 其二","author":"王恭","text":"声声连梵音，人影与禅心。\n散帙维摩室，悬灯支遁林。\n灵花开户落，法雨下帷深。\n洙泗东流去，真源何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄衣曲","author":"王恭","text":"孤月照庭阑，相思剪合欢。\n泪从灯烛下，霜入□□寒。\n绝漠□□远，空闺锦帐残。\n凭君封裹里，谁为著时看。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜寄宿僧房","author":"王恭","text":"薄暮中峰里，遥闻仙梵音。\n独寻钟磬远，渐至薜萝深。\n月色虚禅室，泉声到客簪。\n谁知慧灯影，于此照尘心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄马秀才下第归","author":"王恭","text":"乡闱不得意，秋卷自呈亲。\n共恨持衡手，空怜泣玉人。\n拂衣枫叶冷，归棹菊花新。\n擢秀非难取，长歌泮水春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春阴","author":"王恭","text":"海国东风后，千门积曙阴。\n断云随雨薄，归雁带烟深。\n柳暗迷征骑，花寒笑客簪。\n翻怜胜游地，愁绝五陵心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫莺","author":"王恭","text":"宫漏晓沈沈，间关百啭音。\n声随天乐下，色借御袍深。\n柳外窥残黛，花间识堕簪。\n长门终日闭，闻尔独关心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春都门送客","author":"王恭","text":"四牡正騑騑，承恩出帝畿。\n五门宫漏断，千里布帆飞。\n烟火吴山远，莺花楚树稀。\n过门应暂住，不久换春衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新燕","author":"王恭","text":"乌衣何处别，迢递落春塘。\n旧垒逢新主，空帘见夕阳。\n水芹沾嘴活，烟柳拂衣香。\n何必吴宫树，秋风亦断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒食登临","author":"王恭","text":"山水空青处，烟萝鸟道边。\n千门初禁火，独树已啼猿。\n涓溜和清唱，飞花拂绮筵。\n回首古城下，新冢草芊芊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫井","author":"王恭","text":"甃石长门里，虚圆一鉴清。\n银床苔藓积，丝绠辘轳鸣。\n淡泊如恩浅，清泠似妾明。\n铅华空自照，惆怅若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田家留客","author":"王恭","text":"爨突曙烟新，蚕房绝四邻。\n相逢江上路，且醉瓮头春。\n稚子摘红叶，家人烹紫鳞。\n感君情独厚，应不笑家贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送春","author":"王恭","text":"绿树海边楼，年光逝水流。\n向来携手处，谁是少年游。\n池草生还梦，林花落更愁。\n若为送春去，吟发又成秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠故人陈孟敷牧安陆州","author":"王恭","text":"还乡能几日，五马又騑騑。\n阙下陈三策，人间望一麾。\n帆飞涢水阔，路绕凤山微。\n送别无穷恨，空惭独布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"睡觉山中","author":"王恭","text":"林栖无外事，心似野僧闲。\n万籁千峰起，空帘午梦还。\n松香飘蕙帐，苔色映柴关。\n独鹤归来晚，遥钟若个山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽僧","author":"王恭","text":"双树经行处，空怀结净因。\n松声禅榻夜，苔色影堂春。\n如意闲孤月，袈裟积暗尘。\n空门了生灭，尘世独沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜泊枫桥怀所知","author":"王恭","text":"落日阊门外，枫桥暂泊舟。\n寒山初上月，吴苑欲含秋。\n别梦千重远，残钟半夜愁。\n天明望乡树，迢递忆同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送袖子西游","author":"王恭","text":"游方参佛祖，一锡别东林。\n世路蛾眉外，人烟剑阁深。\n风霜移戒臈，水月印禅心。\n早晚离言说，还山思梵音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮秋登冶城平远台","author":"王恭","text":"山压无诸野，台芳半夕晖。\n连天孤树远，沧海片鸿飞。\n绀苑皆黄落，琳宫尽翠微。\n回看南陌上，四牡正騑騑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还建上","author":"王恭","text":"建水千峰外，春城送独归。\n雨花飘别酒，津柳拂行衣。\n剑浦孤帆远，闽天一雁飞。\n到家应几日，书信莫令稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫燕","author":"王恭","text":"杳杳别乌衣，还寻禁苑飞。\n结巢依绣户，识主近罗帏。\n影落宫潮小，声沈御柳微。\n长门春寂寂，犹忆海西归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日登龙华观","author":"王恭","text":"筹岩青翠里，琳馆是仙家。\n径转龙峰逼，林深鸟道斜。\n白云随杖舄，金磬出烟霞。\n幽觉尘心远，苍藤落数花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别陈孝廉赴京师","author":"王恭","text":"斗酒粤城闉，千门柳色新。\n孤帆辞海月，疋马入京尘。\n凤阙趋朝早，龙池听漏频。\n青云从此去，应念布衣贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳邑中值雨","author":"王恭","text":"潇潇江上雨，孤馆独留人。\n山水愁中趣，莺花客里身。\n县楼寒树合，僧舍曙烟新。\n遥忆兰亭会，凄凉几度春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山人以春茗见寄赋以荅之","author":"王恭","text":"仙峤多灵草，纷披谷雨前。\n色疑蒙顶雾，香讶武夷泉。\n林屋人稀到，山厨手自煎。\n愧无琼玖报，徒此寄云笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题山水雪景","author":"王恭","text":"双毫闲染处，隐见雪花飞。\n万壑飘琼树，千峰掩翠微。\n灞桥吟影度，剡曲棹舟归。\n因忆阳春调，而今和者稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张道士归山用唐人韵","author":"王恭","text":"烟霞宁久别，归去礼元君。\n养道看黄老，将身寄白云。\n人依松作伴，身远鹤同群。\n回首千峰暮，瑶歌鸟外闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邑长史","author":"王恭","text":"白面鲁诸生，宁知替画荣。\n一经谙治体，百里见民情。\n入幕郎官喜，挥毫案牍清。\n一贫今似水，处处见香名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送僧住崇圣寺","author":"王恭","text":"青山崇圣寺，方丈久荒苔。\n爱尔禅枝秀，如今法宇开。\n明心超上乘，真旨悟西来。\n振锡从兹去，云边施食台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题道人幽居","author":"王恭","text":"学道居人境，林扉昼亦关。\n烧丹传妙诀，采药问名山。\n醮罢三花落，经残一鹤还。\n黄精新酿熟，常有好容颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]