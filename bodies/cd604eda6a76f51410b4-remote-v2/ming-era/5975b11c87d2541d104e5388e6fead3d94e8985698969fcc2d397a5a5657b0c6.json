,"path":"明_3.csv","pointer":26252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江即事","author":"邓云霄","text":"绳床冰簟觅寒衣，帆影沾霜夹雁飞。\n两岸芦花如白草，行人疑自塞垣归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"分水塘书怀二首 其一","author":"邓云霄","text":"陇头呜咽断人肠，更有漓江别楚湘。\n却怪寸心随两水，半缘怀旧半思乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"分水塘书怀二首 其二","author":"邓云霄","text":"两水将分贮一塘，潆回惜别恨偏长。\n临流欲寄征人泪，南浦阳关各渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题尹冲玄荷花片小舫六首 其一","author":"邓云霄","text":"啸傲江湖自岁年，轻舟一瓣摘红连。\n主人惯向烟波住，不学天仙学水仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题尹冲玄荷花片小舫六首 其二","author":"邓云霄","text":"盈盈秋水坐来清，倒映莲花锦浪明。\n乘兴寻源那得尽？\n银潢深处近瑶京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题尹冲玄荷花片小舫六首 其三","author":"邓云霄","text":"彩虹摇曳挂轻帆，万里星河夜往还。\n遥望东溟平似镜，青螺一点是蓬山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题尹冲玄荷花片小舫六首 其四","author":"邓云霄","text":"曾闻佛国有莲台，人向花心结圣胎。\n莫讶红香浮小艓，前身原在蕊中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题尹冲玄荷花片小舫六首 其五","author":"邓云霄","text":"避世曾师河上公，丹砂换骨御罡风。\n谁言汉广莲舟小？\n大地元浮月镜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题尹冲玄荷花片小舫六首 其六","author":"邓云霄","text":"花片轻盈小似瓢，洛神龙女夹吹箫。\n仙衣制就裁江练，又剪鲛人几幅绡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其一","author":"邓云霄","text":"下界群生自执迷，名园大宅总醢鸡。\n侬家新构数椽屋，蓬海东邻弱水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其二","author":"邓云霄","text":"阶前病鹤不堪骑，醉踏青龙竹一枝。\n游遍洞天三十六，家家松下有残棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其三","author":"邓云霄","text":"宴罢馀酲一据梧，醒来石烂海全枯。\n傍人欲问逍遥意，日月双丸且弄珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其四","author":"邓云霄","text":"尘世谁开名利场，纷纷车马为他忙。\n那能拔置清凉界，借与天池洗热肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其五","author":"邓云霄","text":"袅袅金茎拂绛河，盘中玉露起微波。\n月瓢携去烹新茗，坐待东莱好客过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其六","author":"邓云霄","text":"员峤方壶小似拳，笑他徐福本无缘。\n近时东海殊清浅，谁道灵风辄引船？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其七","author":"邓云霄","text":"独上须弥古洞前，四溟如带罩深烟。\n去天尺五凭谁说，兜率还闻路八千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大游仙曲八首 其八","author":"邓云霄","text":"元气茫茫无尽期，先天混沌是吾师。\n偶逢太极逢初劫，亲见开天辟地时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听雨廊闻鹧鸪","author":"邓云霄","text":"禽声旅思共凄凄，犹忆戈船下五溪。\n今日园林閒纵步，鹧鸪从尔任情啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月晦日","author":"邓云霄","text":"残红和雨堕前檐，青帝回镳别恨添。\n莫道閒园浑冷落，榴花如火正迎炎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坐在藻轩望远堤行人","author":"邓云霄","text":"解组归来已白头，石栏鱼鸟伴清幽。\n不知世上缘何事，来往行人日未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"池上","author":"邓云霄","text":"积阴雨脚乱如麻，白鹭窥鱼立浅沙。\n怪底主人慵下钓，前溪两岸尽渔家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"邓云霄","text":"枫林黄叶洒行杯，岁晏登临旅思催。\n峡水东流无尽日，龙宫劫运转堪哀。\n帆冲楚塞心先折，书寄衡阳雁却回。\n莫向山门悲聚散，人间踪迹本飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉会亭","author":"邓云霄","text":"云拥阶级石作屏，洞中嘉会有新亭。\n几年风雨分龙剑，此日东南聚客星。\n天地一区同逆旅，弟兄四海总浮萍。\n无遮大会元寥阔，为报山门且莫扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏汝载自故乡来得韩孟郁寄札小斋留酌远忆孟郁兼话珠江别时事分得四支","author":"邓云霄","text":"六代人空草木衰，闲曹寥落少新知。\n忽逢词客携琴至，正值高斋锁印时。\n钟埠凉风留下榻，珠江明月忆传卮。\n白云深处人如玉，谁倩南鸿一问之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自君之出矣 其一","author":"李孙宸","text":"自君之出矣，妆匣久不开。\n思君如落叶，重重扫复堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自君之出矣 其二","author":"李孙宸","text":"自君之出矣，怀抱向谁说。\n思君如织梭，牵丝何日绝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雁塔瑶簪","author":"李士安","text":"花树似簪山，晴香高惹步。\n纵有五湖来，不浮孤影去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]