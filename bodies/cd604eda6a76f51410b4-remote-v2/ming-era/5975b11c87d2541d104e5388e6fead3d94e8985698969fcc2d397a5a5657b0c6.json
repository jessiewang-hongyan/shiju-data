[{"title":"拟古宫词一百首 其七十二","author":"邓云霄","text":"池中铺锦埒铺钱，水陆行游各丽妍。\n队队红妆随豹尾，少儿沿路拾金钿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十三","author":"邓云霄","text":"柏殿兰台秋兴高，词臣侍宴赐挥毫。\n斜飞墨雾鸾笺湿，赋就何人得锦袍？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十四","author":"邓云霄","text":"正地氍毹戏彩球，至尊含笑赏先筹。\n鹦鹉杯前香似雾，杜鹃花外月如钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十五","author":"邓云霄","text":"月冷霜清桂树丹，琉璃瓦上动微澜。\n双双白兔眠帘下，谁道深宫异广寒？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十六","author":"邓云霄","text":"院里霏霏三素云，却疑前世是元君。\n金钱不买长门赋，玉版亲书宝箓文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十七","author":"邓云霄","text":"天上人间迥不同，观名却月殿迎风。\n玉皇遥在红云里，十载深宫似梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十八","author":"邓云霄","text":"宝匣擎来彩胜新，金刀绣线佔阳春。\n中宫传谕加妆点，先赐椒房戚畹人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十九","author":"邓云霄","text":"御堤南望草萋萋，一半花香落燕泥。\n玉辇不来春又暮，谁云桃李易成蹊？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十","author":"邓云霄","text":"高高复道势凌空，步辇行游蹑彩虹。\n香屑霏微侵苑外，歌声摇曳落云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十一","author":"邓云霄","text":"万紫千红斗岁华，玉堤堆锦又蒸霞。\n春来秋去深宫里，惟有菖蒲不作花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十二","author":"邓云霄","text":"春院传柑赐内官，金相玉质映雕盘。\n喜看叶带青云湿，更忆枝垂白露团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十三","author":"邓云霄","text":"荔枝卢橘自南来，赤日黄尘驿使催。\n修贡谁怜飞骑远？\n荐新今见寝筵开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十四","author":"邓云霄","text":"水殿清波漾舞巾，轻盈罗袜不生尘。\n好邀西子湖边月，更照陈王赋里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十五","author":"邓云霄","text":"哀蝉落叶送秋声，圣主新歌最有情。\n不恨香魂迷帐幕，更催方士访蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十六","author":"邓云霄","text":"承恩有路到阳台，兰梦无征试堕钗。\n偷望前星佔气色，夜斟玄酒礼高禖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十七","author":"邓云霄","text":"千门万户望中赊，岁岁风吹御苑花。\n闻道画工随内使，又分十道选良家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十八","author":"邓云霄","text":"骊岫登高辇路长，行宫九日赐萸囊。\n莫言啼鴂芳菲尽，黄菊丛兰各佔香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八十九","author":"邓云霄","text":"大骂迎春耕籍田，三农九扈颂丰年。\n新雷隐隐随鸾辂，龙衮犹沾绿野烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十","author":"邓云霄","text":"三千粉黛各倾城，谁得君王唤小名？\n但愿身轻如燕子，更调歌嗓学流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十一","author":"邓云霄","text":"鹂黄札札弄金梭，织就花丛似绮罗。\n游遍六宫催秉烛，春光九十本无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十二","author":"邓云霄","text":"蒲针柳线拂横塘，避暑乘凉过上阳。\n閒把玉环牵吉了，更将金弹打鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十三","author":"邓云霄","text":"兽炭金炉似火城，纷纷瑞雪洒云屏。\n如今不是陈时世，玉树惊看照后庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十四","author":"邓云霄","text":"睡鸭香销烟霭浓，化为云气总从龙。\n谁知一片帘前雨，远隔巫山十二峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十五","author":"邓云霄","text":"班娘才退赵姬升，卖赋还闻聘茂陵。\n一任君恩他处暖，妾心元在玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十六","author":"邓云霄","text":"东宫花烛照芳春，鹤驭鸾车迓玉人。\n今夜洞仙三十六，争看织女度河津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十七","author":"邓云霄","text":"君王偏爱广寒游，霓羽声喧桂影幽。\n醉把玉鞭空外指，彩云中夜度扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十八","author":"邓云霄","text":"围栏换土护花王，爱尔春心不着忙。\n红玉一枝藏玳匣，百花开尽始成妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九十九","author":"邓云霄","text":"绿阴千顷洗残红，吹笛池边起晚风。\n折柳不须悲旧曲，飞花犹得入南宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其一○○","author":"邓云霄","text":"身在天皇玉案前，自誇无事小神仙。\n宫中一日如千日，圣主长生更万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其一 仙源","author":"邓云霄","text":"高循石磴踏罡风，寻得仙源杳霭中。\n怪底寒光浸星月，涟漪疑与绛河通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其二 水帘台","author":"邓云霄","text":"飞泉百道寒苍壁，雨过残雷隐隐闻。\n一幅珠帘长不卷，仙人石室正眠云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其三 金粟洞","author":"邓云霄","text":"谁将金粟种岩前？\n香色皆空不碍禅。\n试向如来问真谛，洞云深处是诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其四 逋岩","author":"邓云霄","text":"山中丛桂长相待，世上无名不用逋。\n珍重岩边苍石几，他年研墨著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其五 漱流石惟四尊人栖隐处","author":"邓云霄","text":"泠泠玉齿漱寒流，高士当年似许由。\n惆怅遗踪久寥落，猿愁鹤怨几时休？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其六 栎社","author":"邓云霄","text":"长松落落充高栋，古栎庸庸得大年。\n自笑生年不材者，社中应许结良缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其七 苍雪崖","author":"邓云霄","text":"寒深洞口无三伏，风急崖前有六花。\n何处山僧乘兴到？\n共融新水瀹新茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其八 琼岛","author":"邓云霄","text":"一片琼瑶倚浪堆，云根移自十洲来。\n临风试奏游仙曲，不信骑羊去不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其九 期云馆","author":"邓云霄","text":"期云馆中云氤氲，伊人疑是云中君。\n云本无心任来往，何须青鸟通殷勤？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其十 振衣亭","author":"邓云霄","text":"彼美亭亭立上方，荷衣蕙带紫霞裳。\n飘摇两袖春风细，惹得岩花百和香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其十一 载笔亭","author":"邓云霄","text":"自有名流酬胜迹，挥毫字字斗瑶华。\n一泓不散池中墨，五色常生笔里花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遍题朱惟四增置诸胜十二首 其十二 云萝道","author":"邓云霄","text":"采药往来常荷锸，寻僧朝夕自携琴。\n世尘不到山中道，寂寂云萝永日阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄城子路问津处","author":"邓云霄","text":"驿路喧喧车马尘，尘中还忆耦耕人。\n清溪一线寒流浅，行客毋劳更问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕旅怀又戏作二首 其一","author":"邓云霄","text":"汉津清浅漾轻波，闻道西山木石多。\n何事为桥役灵鹊，不教精卫去填河？","collection":"明","notice":"","provenance":{"repo":"W