[{"title":"宿南塔","author":"释今无","text":"南城宿野寺，北极望云林。\n星月还清夜，风尘奈客心。\n春光依树浅，沙气绕门深。\n多病穷愁集，萧然无好吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯下读梁同庵上剩师叔书因伤白庵石师","author":"释今无","text":"旧札看残烛，遗文惨晚烟。\n能将师友泪，洒向弟兄前。\n未遂临关志，空为隔世怜。\n同人多殒落，吟罢自潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郝侍御雪海","author":"释今无","text":"世事难容直，知君不可任。\n好将华岳诀，自慰柏台心。\n边月寒偏白，春云静独深。\n相逢话肝膈，余亦恋知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞下逢江东陈十一柱江","author":"释今无","text":"士有不可识，因人一见君。\n马驱边地月，剑拂蓟门云。\n市饮终何事，燕歌已蚤闻。\n苍茫逢日暮，握手暂云云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉生日宿沈阳南塔寺 其一","author":"释今无","text":"傍寺逢生日，趋庭忆往年。\n既无酬下地，犹自戴皇天。\n断戍荒烟合，孤城乡月悬。\n此时珠海上，清切乱啼鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉生日宿沈阳南塔寺 其二","author":"释今无","text":"几日为儿女，十年独苦辛。\n春云枯冢树，流水石梁人。\n侍烛遥归夜，悲天厌有身。\n幸还依塞下，犹自问迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈柱江还长安","author":"释今无","text":"一旬谈笑里，万里别离中。\n策马春山响，孤城旭日红。\n离杯归思满，分手客心同。\n珍重千金铗，长歌使我逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿千山龙泉寺","author":"释今无","text":"五更风雨密，孤枕暗钟频。\n白日愁为客，青山不定身。\n涧响虫声杂，窗虚花气新。\n何当一夜梦，两渡白门津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜","author":"释今无","text":"主人城郭去，柴门高更閒。\n雨过滴未启，月影到方关。\n虫小常邻屋，云多夜过山。\n经行情脉脉，何处觅跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜怀山中诸兄弟","author":"释今无","text":"黑水沙边路，终宵对月明。\n我无青嶂梦，谁有向秋情。\n塞草不成绿，孤松亦作声。\n几多旧朋好，何处话平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题","author":"释今无","text":"每到无言处，频行望九霄。\n中郎不可见，残爨自应烧。\n短褐欲成癖，萤光似见招。\n秋风一夕乱，寒气满山腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉九日南还别剩师叔","author":"释今无","text":"雁碛寒沙白，云峰野烧红。\n风声皆向北，人意未离东。\n锡振边尘落，书缄血泪空。\n依依看寸晷，愁听暮天钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将渡辽海先题牛庄寺 其一","author":"释今无","text":"平生无可信，辽海任飘蓬。\n学少诗情短，愁多客路穷。\n星随千里照，岸到九霄空。\n亦是酬恩事，毋令泪独浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将渡辽海先题牛庄寺 其二","author":"释今无","text":"钟声犹傍寺，海气已惊心。\n地是人间尽，云从此路深。\n风波供旅思，岛屿忆秋林。\n回首天山雪，何由寄一音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将渡辽海先题牛庄寺 其三","author":"释今无","text":"晨起听鸡声，关心事事生。\n独怜浮海意，仍是感恩行。\n怒浪迎风白，朝暾半夜明。\n一帆天地外，谁念此时情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿海州城闻砧","author":"释今无","text":"独立复长吟，孤城急夜砧。\n不知闺里意，只讶客途心。\n萧瑟江关远，洪濛天地深。\n愁来频不已，辜负启期琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发牛庄","author":"释今无","text":"发棹辞寒碛，扬舲起楫师。\n不关行处苦，仍是别时悲。\n落月孤星伴，浮生万事危。\n明朝出海望，应见黑云低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽海舟中 其一","author":"释今无","text":"黑水行无地，黄沙已近天。\n一帆风夜正，四望月空悬。\n宿雾不归岛，危樯半入烟。\n飘飘悽梗泛，木偶倩谁怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽海舟中 其二","author":"释今无","text":"落日孤舟晚，临风四望穷。\n鹤飞低近浪，云起远浮空。\n水怒人心善，霞明世界红。\n去年行碛雪，不与此情同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽海舟中 其三","author":"释今无","text":"鹢首喧难定，牙旗涷不飞。\n吟残深夜烛，着尽耐寒衣。\n浪飐惊风密，星随晓月稀。\n辽阳不可望，但逐塞鸿归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽海舟中 其四","author":"释今无","text":"不识伤心处，征蓬旅泊时。\n一宵频雨雪，千里尽流澌。\n石色看天近，云根出海迟。\n余生多所慨，自觉愧冯夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽海舟中 其五","author":"释今无","text":"沧溟十万里，日日石尤风。\n归梦寒难达，悲心久易穷。\n星飞人面白，蜃出海灯红。\n惟有无生理，安危自可通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽海舟中 其六","author":"释今无","text":"中宵风逾恶，千丈浪难平。\n有泪还肝胆，无亲任死生。\n星光迷去路，寒气咽金声。\n纵有维舟日，何堪此夜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时十月十四日作本师诞日也 其一","author":"释今无","text":"石梁不可见，夜梦独迢迢。\n山好连三楚，云寒尚六朝。\n师年愁里过，客泪海中摇。\n浅薄供驰逐，那堪慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时十月十四日作本师诞日也 其二","author":"释今无","text":"旸谷一帆去，天波万里迷。\n生如投马颊，死亦忆鸾溪。\n气逼星辰大，寒令日月低。\n行吟俱惨澹，无事不悽悽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时十月十四日作本师诞日也 其三","author":"释今无","text":"已见浮沉易，谁怜顾复难。\n龙鳞风自急，精卫血无乾。\n斜日含云暗，残霞染浪丹。\n莫惊蛟兕起，天地不禁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过菊花岛 其一","author":"释今无","text":"绝岛浮前浪，重岩出海滨。\n望之深汉月，疑尚有秦人。\n石白千层雪，松青万树春。\n扶筇欲一问，柔橹去何频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过菊花岛 其二","author":"释今无","text":"满山飞白鹤，几处傍青霄。\n蜃气深盘寺，钟声落应潮。\n荒台秦砌古，卧石汉功标。\n心恋身难住，临风一望遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"达淮上","author":"释今无","text":"千翼乱鸣湍，归心睇望欢。\n涷轻曲岸涩，云密大波寒。\n北极堪回首，南图愧素餐。\n三年橘已化，非止学邯郸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无终山下作","author":"释今无","text":"种玉先贤地，驱云过客情。\n霞光隐高木，碛路射寒星。\n马出高天阔，鸿归汉塞冥。\n何由投绝壑，回望见龙庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发露台","author":"释今无","text":"星没晓鸡号，夙驾上蓬蒿。\n岁月关河晚，风尘形影高。\n戍荒迷苦雾，魂冷想绨袍。\n人世须行乐，予生自可劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过压凤桥","author":"释今无","text":"昨宿盘龙渚，今过压凤桥。\n山形随地转，雪色隔江遥。\n草死文犹锦，烟空气未消。\n当年刁斗夜，曾驻霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游盘山","author":"释今无","text":"正厌风尘苦，投山一望欢。\n才经当路石，已爱古嶒峦。\n风度松声阔，霜明晓道乾。\n匡庐曾隐处，飞瀑为谁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游盘山中盘寺寻普化禅师塔","author":"释今无","text":"未到中盘寺，钟声先已闻。\n松低青覆雪，山阔午凝云。\n塔影双峰合，寒流几处分。\n驴鸣犹彷佛，垒垒见高坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凿龙池","author":"释今无","text":"龙德宜趋下，寒潭万丈深。\n莫言云易老，须信石难沉。\n势转长空静，光回乱壑阴。\n何人观气宇，世外许相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"净业庵","author":"释今无","text":"五峰皆暮雪，八石尽朝烟。\n路转无人迹，溪寻见鸟眠。\n楸梧犹往日，钟磬是何年。\n一饭从僧乞，扶筇又渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿上方寺","author":"释今无","text":"心閒宜落日，雪路认苔痕。\n云起鹿鸣树，帘垂僧到门。\n人间深壑见，石壁此峰尊。\n一夜寒空月，凄清急暮猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云罩寺","author":"释今无","text":"渐到中峰顶，斜看众壑低。\n乱云攀不住，深雪忽然迷。\n涧涷千条合，松青万树齐。\n何当极高旷，独占蓟城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊戌长安元日同陈中翰忝生诸公作","author":"释今无","text":"未忘玄徼梦，又度玉京春。\n曙色千门动，乡愁万里新。\n金钟开紫阙，玉佩点朝臣。\n借问桃源里，黄冠几隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日与诸子登观星台 其一","author":"释今无","text":"百尺悬梯上，千门映日开。\n山标天寿翠，江涌月明来。\n古戍流残雾，寒笳落早梅。\n璇玑看秘密，因忆古人才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日与诸子登观星台 其二","author":"释今无","text":"新岁登临望，亭亭欲近天。\n帝城金凤阙，春气碧山烟。\n旷野连三晋，黄云出九边。\n客心消未得，怀抱只凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春送姚巨六邓立人归循州","author":"释今无","text":"上国新杨柳，攀来带惠风。\n赠君从此去，春色正无穷。\n月过邮亭白，花经郡县红。\n甘泉知可献，那解叹飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再游燕山","author":"释今无","text":"又到佳山水，难为旧隐心。\n寻芳投北涧，选石得东林。\n地敞中原秀，峰环紫禁深。\n欲行情已怯，归路绕飞灊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登秘魔崖","author":"释今无","text":"秘魔高不极，正接太行踪。\n白日寒千树，阴崖护二龙。\n水帘风雨聚，云窦鬼神封。\n一望知何世，秦关见几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安逢韩掌邦时韩子拟出辽阳访剩师叔","author":"释今无","text":"一从彭蠡别，几岁广陵居。\n已得谋身策，毋膏出塞车。\n路寒云气黑，霜苦月轮虚。\n不重空相见，知君愿有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕台秋日 其一","author":"释今无","text":"律管笳灰散，檀林夏火移。\n气从今日变，人是此时悲。\n朝雾涵空迥，斜阳入户迟。\n望云情事切，何忍逗归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕台秋日 其二","author":"释今无","text":"时陟层楼望，萧条客思多。\n傃风吹大陆，秋色耿长河。\n剑气连天远，笳声送雁过。\n他乡愁日暮，谁为一扬戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时得本师和尚归粤信 其一","author":"释今无","text":"忽闻匡岳信，并起玉关愁。\n华表方迷鹤，鄱阳已泛舟。\n关山无近梦，江汉有新秋。\n一望西山色，萧条映御沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时得本师和尚归粤信 其二","author":"释今无","text":"几遇终南客，期餐地胏云。\n薜萝心自苦，湖海恨难云。\n枯冢别已久，维桑信不闻。\n一归乾泪血，即与世相分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送韩子入秦","author":"释今无","text":"之子当行役，秦关万里秋。\n驿云寒古戍，山月照吴钩。\n客久心还壮，年深志未酬。\n莫将凄别泪，时对汉宫流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭秋山 其一","author":"释今无","text":"赭山深友谊，渔海长离忧。\n别日悲新客，还家失旧游。\n松风开绝巘，塔影暝寒流。\n化鹤精灵在，犹应到十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭秋山 其二","author":"释今无","text":"堪怜披薜客，十载茹芝苓。\n未遂洪厓志，先登郭璞经。\n山风吹泪断，石色上苔青。\n一悟藏舟理，何心鍊鹤形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭台设阇黎","author":"释今无","text":"几年歌薤露，一旦掩泉台。\n既切芝焚苦，空馀蕙叹哀。\n秋阴松路暝，风急石云开。\n幽魄原无滞，他生愿不才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日留别吴太仆春坪 其一","author":"释今无","text":"自怜重九日，握别素心人。\n未饮茱萸露，先聆白雪音。\n潘花飞远瀑，卫玉映长林。\n自此起相忆，寒云万里深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日留别吴太仆春坪 其二","author":"释今无","text":"少小事空寂，难为人世间。\n三年携策出，万里逐鸿还。\n白雪关门树，黄云塞上山。\n征途多感叹，幸一识韩颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别陈路若","author":"释今无","text":"六十诗名旧，天涯始见君。\n望残乡井月，卧老帝城云。\n草色当轩静，嚣声入夜闻。\n市廛犹有此，握别惜相分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将出长安作","author":"释今无","text":"湖海气苍苍，并州拥大荒。\n断云归弱水，乡思望扶桑。\n月影官桥白，钟声禁树黄。\n年年理征铎，辛苦向羊肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邯郸道中","author":"释今无","text":"驱云投日观，带雾揽星光。\n槲叶飞无已，寒郊望自长。\n风霜燕草木，城郭赵封疆。\n敢动兴亡思，笳声起驿墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊挂剑坟","author":"释今无","text":"今夜维舟处，前贤挂剑坟。\n树声流暝色，庙貌老徐君。\n生死情何洽，豪雄世所闻。\n至今村父老，伏腊荐溪芹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"分水龙王庙","author":"释今无","text":"水势盘涡转，河流至此分。\n北归趋碣石，南绕逗淮云。\n月落无全影，风生有乱文。\n辉煌临庙貌，千古镇波臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临峄山湖","author":"释今无","text":"大湖千里驻，一气上洪濛。\n色变翔麟野，波连辨马峰。\n天寒乾草木，云暗蛰蛟龙。\n吾道风尘在，仙槎不可从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭无方阇黎","author":"释今无","text":"细想总茫然，哭君倍自怜。\n佳城迷白日，世上岂青天。\n道丧悲龙象，山春恨杜鹃。\n年年持鹤梦，无计到花田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漂母祠","author":"释今无","text":"行人瞻漂母，尽解忆王孙。\n昔日不图报，今朝始是恩。\n鸟归庭柏动，垣败旧碑存。\n读罢英雄事，升沈安可言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿郑元白楼却赠 其一","author":"释今无","text":"不是轻相见，知君自玉关。\n风尘为道苦，肝胆向人难。\n雪到穷檐厚，风摇夜烛寒。\n天涯存我辈，犹得共团栾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿郑元白楼却赠 其二","author":"释今无","text":"闭门谁可到，风雪满层楼。\n知有伤心泪，长为江水流。\n高名羞阚月，愿尔掷吴钩。\n去去罗浮路，相期在十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨花台逢冯大 其一","author":"释今无","text":"世有奇男子，飘零可奈何。\n风尘一剑苦，涕泪十年多。\n榆塞留馀策，梅关发浩歌。\n相逢一相揖，忆别自蓬婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨花台逢冯大 其二","author":"释今无","text":"茫茫湖海气，此别又何之。\n天道多艰日，英雄失路时。\n寒深辽左梦，愁到鬓边丝。\n直待封侯罢，云山与子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨花台逢冯大 其三","author":"释今无","text":"家国两难归，天涯一布衣。\n空怀名世业，难采越山薇。\n掌握分星斗，悲歌动翠微。\n当年垂钓叟，八十尚牛矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨花台逢冯大 其四","author":"释今无","text":"归思方寥寂，忽闻乡国音。\n君来征战里，我去草莱深。\n云水孤僧意，河山国士心。\n楼头笳吹动，又在石城阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望五老峰残雪","author":"释今无","text":"竟无看雪意，不奈倚楼心。\n草木于人贱，烟霞入眼深。\n到天寒愈阔，出谷势将沉。\n更爱消融尽，苍苍露几岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]