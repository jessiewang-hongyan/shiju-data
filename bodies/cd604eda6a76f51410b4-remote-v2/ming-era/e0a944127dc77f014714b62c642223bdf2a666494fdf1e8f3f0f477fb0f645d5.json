[{"title":"晚秋王喻二监察见过二首 其一","author":"李梦阳","text":"自种吾堂菊，无人共把卮。\n昨来三径雨，忽与两骢期。\n槛霁花逾爽，林寒酒故随。\n坐忘俱酩酊，莫遣白衣知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚秋王喻二监察见过二首 其二","author":"李梦阳","text":"霜日来骢并，晴杯汎菊频。\n古今元逆旅，天地几閒身。\n雁阵寒从急，篱香晚自新。\n豪吟不知夜，圆月在高旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菊日任君见过","author":"李梦阳","text":"菊筵开遇雨，秋色转增孤。\n冷翠元浮席，流香故洒壶。\n蕊沾卷袖摘，径滑倩人扶。\n莫谓无开霁，斜阳酒重沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄郑生二首 其一","author":"李梦阳","text":"故菊开谁对，新醪怅尔违。\n耳憎木叶下，心与塞鸿归。\n儿女催蓬鬓，家园滞綵衣。\n问君称庆暇，何处采山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄郑生二首 其二","author":"李梦阳","text":"节序仍黄菊，乾坤更白头。\n文章宁益世，衣食暂宽忧。\n遇客谁谈剑，思君独倚楼。\n远江寒细细，似有北行舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜繁台会两监察二首 其一","author":"李梦阳","text":"蹃叶风交落，台骢晚并行。\n时寒物色换，意远世缘轻。\n异国同觞地，危楼片月情。\n暝烟凭槛里，汴水冻犹声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜繁台会两监察二首 其二","author":"李梦阳","text":"万里危楼夜，中天朗月时。\n快心真托酒，凝望转停卮。\n野色霜元迥，林光烛并移。\n依依檐畔鹊，先占独栖枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李生还郡二首 其一","author":"李梦阳","text":"宦美庭闱隔，情深郡檄催。\n腊江舟自稳，暮日首频回。\n洞橘黄金摘，吴鱼白雪来。\n汝亲知更乐，愿展治邦才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李生还郡二首 其二","author":"李梦阳","text":"伯道吴门水，梁公冀北云。\n依亲岁聿暮，趋郡袂还分。\n腊动苏台色，春回震泽薰。\n重过应未远，良吏汉廷闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甥嘉北采出其谒逢干庙之作予为和之嘉时谪茂州判","author":"李梦阳","text":"汝谒双忠庙，徘徊几度吟。\n暴云连海白，积水带城阴。\n自抆看碑泪，谁知驻马心。\n未须悲远窜，不死是恩深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送甥嘉之茂州次玉溪侍御韵三首 其一","author":"李梦阳","text":"巳诧齐东谪，能堪蜀道行。\n自甘穷塞窜，争柰倚闾情。\n剑阁云中栈，蓬婆雪外城。\n大江秋见底，待尔濯长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送甥嘉之茂州次玉溪侍御韵三首 其二","author":"李梦阳","text":"蜀道元非易，人言此更难。\n虎风生万壑，蛇径动千盘。\n北望常思阙，西来不为官。\n无言羌性异，汝当郡民看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送甥嘉之茂州次玉溪侍御韵三首 其三","author":"李梦阳","text":"雪山天地外，经夏雪难消。\n气冷三城戌，光通万里桥。\n谁言州不好，汝去蹃宁遥。\n纵使胡笳夜，犹能梦入朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊原迟王豸使","author":"李梦阳","text":"岂少银鞍马，冲泥许故游。\n清风微进草，晴日澹生秋。\n扫径童将倦，看笼鹤但收。\n异时高李会，佳迹至今留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王豸使至","author":"李梦阳","text":"晴游番幸雨，午出更便风。\n柳重陶潜宅，花沾御史骢。\n达人元野性，浊酒本村翁。\n酌罢桑麻晚，归灯一径红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王豸使既返东月皎升乃与李曹二子径觞吹台之巅口占柬黄子","author":"李梦阳","text":"王归不待月，二子共登台。\n天地划然皎，山河相荡回。\n虫鸣崖底叶，雁影掌中杯。\n为问山阴客，还能棹雪来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日吕公西园同玉溪侍御二首 其一","author":"李梦阳","text":"圃胜城能曲，台高野更秋。\n席陪骢马出，情为碧云留。\n移坐铺林叶，添樽面水流。\n潜思歌舞地，指点问王州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日吕公西园同玉溪侍御二首 其二","author":"李梦阳","text":"入院看垂杮，临畦羡引泉。\n寒荽自满地，疏树不妨天。\n野老疑旌旆，林乌下酒筵。\n无云但游衍，公意在桑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西园酒半会玉溪侍御瓜代报至再赋二首 其一","author":"李梦阳","text":"北使还朝近，西城返照深。\n霜情留果实，晚意付花心。\n风助林皋爽，云横海岳阴。\n兹游如在念，应有寄南音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西园酒半会玉溪侍御瓜代报至再赋二首 其二","author":"李梦阳","text":"胜地留宾切，离筵散酒迟。\n网鱼生跃案，摘枣脆连枝。\n草夕鸣蛩动，天秋过雁知。\n河桥明日事，愿尽掌中卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"见和君病起须白辄有所赠亦咎其酒过","author":"李梦阳","text":"诧汝须添白，将无病苦形。\n眼前真过隙，身外是浮萍。\n客到留棋局，儿呼检药经。\n昔人曾颂酒，吾意不如醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和郑生行经凤阳","author":"李梦阳","text":"浩荡兴龙地，盘旋踞虎形。\n海吞淮水白，天插楚峰青。\n帝宅精灵聚，陵宫虎豹扃。\n万年禋祭礼，有道赖朝廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初冬见雪和鲍生","author":"李梦阳","text":"密云初布暝，疏雨忽成花。\n气浅冰从薄，寒轻白自斜。\n敝裘谁念汝，孤棹独思家。\n江上冥冥雁，春风迟去槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郑生至自泰山二首 其一","author":"李梦阳","text":"昨汝登东岳，何峰是绝峰。\n有无丈人石，几许大夫松。\n海日低波鸟，岩雷起窟龙。\n谁言天下小，化外亦王封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄鲍崇儒","author":"李梦阳","text":"去日犹零雪，庭葵遽复花。\n新诗谁和汝，久客自成家。\n水国乾侵夏，田风莽带沙。\n长淮日易暮，珍重早栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送赵训学满归二首 其一","author":"李梦阳","text":"六旬千里客，九载一毡归。\n路远琴书重，官贫妻子饥。\n塞云迎老鬓，河色恋征衣。\n会有秋行伴，关山新雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送赵训学满归二首 其二","author":"李梦阳","text":"宋代陈无巳，唐时郑广文。\n道高官独冷，名美世同闻。\n汝挈一毡去，予怜双袂分。\n潸潸白首泪，长向渭西云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋过内弟漫赋二首 其一","author":"李梦阳","text":"赫赫乘龙地，萧萧罗雀门。\n桑麻犹世业，书史但儿孙。\n数过看颜帖，今来为菊樽。\n显亲君太晚，愿化北溟鲲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋过内弟漫赋二首 其二","author":"李梦阳","text":"主宾俱不饮，相对坐同深。\n幸有黄花兴，无论白发心。\n游虫纷落日，高叶下疏林。\n静里闻鸿雁，疑添往岁音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈生嘉言二首 其一","author":"李梦阳","text":"少小期鹏运，于今尚未飞。\n蒿深仲蔚宅，鹑结宪生衣。\n背郭元桑树，临河只钓矶。\n奉亲知不苦，馔有白鱼肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈生嘉言二首 其二","author":"李梦阳","text":"白屋山中相，黄河水后田。\n家无酿酒秫，人索买书钱。\n雨过云留野，风来浪接天。\n行行牛角上，犹挂古人编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕雪台子过东庄","author":"李梦阳","text":"村落元相接，园林亦互游。\n酒天携榼就，花夜对床留。\n忽尔双星候，泠然万木秋。\n谁期白头日，萧洒共丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠程生东游","author":"李梦阳","text":"邹鲁风犹在，芒砀气有无。\n霸心空大泽，儒行乃长途。\n野艇冰迷雁，村楼冻集乌。\n无劳怨岁暮，随处是江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题高子君山别业二首 其一","author":"李梦阳","text":"一山背城起，万古号为君。\n秀揽江心月，雄吞海面云。\n金陵通地脉，玉港发人文。\n羡彼投簪客，中年卧紫氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55450,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题高子君山别业二首 其二","author":"李梦阳","text":"季札坟边业，春申邑后山。\n一江平展镜，两港曲成环。\n不雨云烟拥，长春草木斑。\n隐君梯万丈，倘许世人攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55451,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送刘尹赴徵","author":"李梦阳","text":"恋别当炎暑，淹留到夕晖。\n徵书昨日下，循吏古人稀。\n风树凉移席，庭萱晚就衣。\n明朝五云里，争看两凫飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55452,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日寺集观赵帅射","author":"李梦阳","text":"万里横霜气，长风快顺毛。\n将军只弩发，叠中两鸿号。\n取石敲新火，开鲜弄宝刀。\n回头问僧者，何处得醇醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55453,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁亥寒食柬养素","author":"李梦阳","text":"细雨秾花候，高斋独坐辰。\n春风无病物，清世有閒人。\n树湿莺穿稳，泥香燕下频。\n遥思养素者，何处卧松筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55454,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜程生自吴中回致五岳黄山人音问二首 其一","author":"李梦阳","text":"烂熳梁园树，江舟尔恰回。\n苑桃惟旧列，墙柳半新栽。\n枝为来人袅，花迎笑口开。\n吴门春更好，几上虎丘台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55455,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜程生自吴中回致五岳黄山人音问二首 其二","author":"李梦阳","text":"黄子吾真畏，程生尔更奇。\n江城倾盖日，渭北暮云时。\n宝剑神终合，冥鸿性不移。\n忽思千里驾，惭愧昔人为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55456,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"伏日载酒寻高司封读书处二首 其一","author":"李梦阳","text":"郑门古城曲，小筑成幽园。\n为厌朝簪扰，兼辞人境喧。\n矮堂交杂树，炎日驻游轩。\n默默林中意，相看对一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55457,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"伏日载酒寻高司封读书处二首 其二","author":"李梦阳","text":"养寂为园卧，寻幽当暑过。\n林深得日薄，地静觉蝉多。\n旧业元粳稻，新亭复薜萝。\n谁怜朱绂客，遽恋白云窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55458,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀五岳山人黄勉之","author":"李梦阳","text":"吴下元多士，黄生更妙才。\n心常在五岳，名巳动三台。\n系自汝南出，文从西汉来。\n各天难见汝，翘首独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55459,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊居东竹溪子","author":"李梦阳","text":"当春弄杯盏，花落恨纷纷。\n重来日复几，飞叶满秋云。\n寒流下雁影，古戍噪鸦群。\n残菊犹堪把，长谣独忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55460,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻吴郡黄山人将游五岳寄赠二首 其一","author":"李梦阳","text":"昨报三吴客，将寻五岳游。\n薜萝应制服，春水正宜舟。\n二室云中峻，三花烟外浮。\n住居吾幸迩，先肯到嵩丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55461,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻吴郡黄山人将游五岳寄赠二首 其二","author":"李梦阳","text":"天柱峰头雪，莲花岭畔云。\n朗吟惟李白，独往更黄君。\n婚嫁今应毕，藜鞋有幸分。\n共跻恒岱遍，归著五游文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55462,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东庄冬夜别程生自邑","author":"李梦阳","text":"万里孤村夜，疏灯对语心。\n风枝时响牖，寒月故明林。\n秦陇新游壮，江湖旧恨侵。\n侧知南橐重，为有华山吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巳丑八月京口逢五岳山人","author":"李梦阳","text":"夜雨清池馆，晨光散石林。\n一舟相过日，千里独来心。\n树拥江声断，潮生山气阴。\n异时怀旧意，应比未逢深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京口杨相国园赠五岳山人","author":"李梦阳","text":"远客乘秋至，名园水竹分。\n林寒番易两，池静合偏云。\n卧疴思知己，逢君惬素闻。\n萧萧绿云里，谁解有论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日黄花镇","author":"李梦阳","text":"黄花遇九日，风雨不逢花。\n水涌石梁断，溪吞山郭斜。\n将军午宴客，欲醉忽闻笳。\n困苦墩楼卒，经年谁见家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日应变斋居","author":"李梦阳","text":"时变逢摇落，斋心对暮天。\n未擒可汗日，新起泰陵年。\n听雁真无那，看花益泫然。\n将归思临水，愁绝宋生篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日慈恩寺阁二首 其一","author":"李梦阳","text":"宝地元依海，珠林更假山。\n登临重九遇，城阙五云还。\n歌吹喧侯里，边烽入汉关。\n望乡归未得，能对菊花斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日慈恩寺阁二首 其二","author":"李梦阳","text":"敕寺四围湖，秋林层阁孤。\n天空木更响，风口帽还扶。\n鱼群席下跃，鸟影镜中趋。\n泛菊看山海，寒烟暮有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"生日写怀","author":"李梦阳","text":"腊日明朝是，浮生此岁过。\n黄云薄暮积，白发向来多。\n壮士看雄剑，幽人恋薜萝。\n异时论出处，窃虑各蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十二月十日","author":"李梦阳","text":"今日吾兄寿，萧条自举觞。\n燕山非故里，汴水亦他乡。\n河鲤行思海，原鸰飞畏霜。\n客居怜小侄，潜望白云长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"腊日退朝口号","author":"李梦阳","text":"霁色催寒腊，鸡声下紫宸。\n至尊深抱戚，粥食罢尝新。\n宫雾戎戎薄，城鸦款款驯。\n小臣怜岁序，翘首待阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七月十五月食不见追往有叹","author":"李梦阳","text":"月食今年再，中元与上元。\n春晴灯火乱，秋瞑雨云繁。\n汉将高城垒，胡尘满塞垣。\n孤臣万古泪，偏洒泰陵园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月食","author":"李梦阳","text":"有明终不减，暂掩亦何亏。\n万国喧呼地，三更鼓角悲。\n轮生桂与发，光复兔还随。\n显晦每如此，人生秪自疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日汴上雪霁","author":"李梦阳","text":"旭日薰江舰，晴云丽竹扉。\n檐花雪色静，庭筱碧滋归。\n岁月高儿女，行藏老蕨薇。\n眼看人共醉，椒酒不堪挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明河上寓楼独酌","author":"李梦阳","text":"一自违京邑，飘飘叹此游。\n桃花是往岁，竹叶转新愁。\n暮雨津城树，春帆水国楼。\n汴河堤上柳，烟色似皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庚午除日","author":"李梦阳","text":"于今将四十，始悟昔年非。\n白发谁能那，红颜我渐违。\n行藏沙上鸟，日月故山薇。\n怅望劳歌起，风河柳色归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辛未元日","author":"李梦阳","text":"万事浑如昨，蹉跎四十临。\n取途伤老马，闻道愧前禽。\n日变风云气，春生海岳阴。\n趁时聊物赏，此外更何心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋南康","author":"李梦阳","text":"同是中秋月，匡庐只自看。\n故临石镜上，偏傍落星滩。\n北望关山隔，南飞乌鹊寒。\n凤歌喧太液，光忆满长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庐山九日","author":"李梦阳","text":"庐山随晚坐，江汉净秋襟。\n九日黄花雨，书堂红叶深。\n细云飘古帙，寒兕吼空林。\n不用风吹帽，尊前有静琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上元滕阁宴二首 其一","author":"李梦阳","text":"滕阁上元宜，章江登宴时。\n衣冠还大国，唐宋自残碑。\n灯火阑堪凭，风尘泪欲垂。\n黄云驱日暮，回首见征旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上元滕阁宴二首 其二","author":"李梦阳","text":"阳浦通新雾，阴城带古楼。\n君王罢歌舞，栋宇白云留。\n草色岁年换，客心江水流。\n暮昏仍一望，灯火万家州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日薛楼会集二首 其一","author":"李梦阳","text":"不倦登楼目，遥怜秋色重。\n枫村叠暗浦，霜日抱孤峰。\n楚越窗中地，江山战后容。\n倚阑浑不语，吾欲采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日薛楼会集二首 其二","author":"李梦阳","text":"恰送重阳日，能禁孤雁来。\n林稀山尽出，风顺橹齐开。\n况是薛楼会，难孤江上杯。\n菊芳看莫厌，秋色异乡催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]