[{"title":"晓起看梅","author":"徐熥","text":"花神催晓梦，枕上忽闻馨。\n路指梅林白，尊携竹叶青。\n萝衣沾宿露，藜杖带寒星。\n积雪看如絮，前村作杳冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜汝大见访留酌","author":"徐熥","text":"故人当夜至，倒屣出相迎。\n坐久诗情发，霜寒酒力轻。\n残更听渐促，微月欲西倾。\n分手柴门寂，惟闻天籁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭同年黄绍馨孝廉","author":"徐熥","text":"同领乡书者，才名君最先。\n赋成栖鹏日，笔绝获麟年。\n堂有双黄发，家无二顷田。\n交情尽一哭，泪洒寝门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜林逸民山人再至","author":"徐熥","text":"相见各欢悲，风光异昔时。\n如何赤城客，又赴白云期。\n情以重来密，诗从别后奇。\n试看双鬓里，添得几茎丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日閒居 其一","author":"徐熥","text":"草阁春方暮，柽阴日未斜。\n蜗涎分断壁，莺语共邻家。\n曲坞藏脩竹，轻云覆落花。\n卑栖有至性，长此卧烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日閒居 其二","author":"徐熥","text":"茅屋依青嶂，蒲团坐白云。\n新茶烧竹煮，老柏杂香焚。\n壁古苔纹见，林深鸟语闻。\n冥心忘早晚，花外已斜曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日閒居 其三","author":"徐熥","text":"一室通幽径，群峰列翠屏。\n空阶半夜雨，新竹几行青。\n山果猿争拾，岩扉鹤自扃。\n花间闻剥啄，客借太玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日閒居 其四","author":"徐熥","text":"焚香坐翠微，山色入荆扉。\n日午鸟啼歇，门閒人迹稀。\n休粮孤鹤瘦，积雨野蔬肥。\n欲识静中意，白云天际飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿陈七吸江亭","author":"徐熥","text":"高谈当子夜，人世几今宵。\n共步芦中月，因歌竹外桥。\n孤琴清澹露，寒磬落归潮。\n此地堪栖隐，频来岂用招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌石山赠僧","author":"徐熥","text":"鹫岭白云边，茅庵只数椽。\n污泥皆净土，人境即诸天。\n山现空中色，花明定后禅。\n蒲团今已烂，趺坐不知年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨","author":"徐熥","text":"风雨来何骤，虚堂白昼阴。\n木催愁破屋，巢落不归禽。\n水入花畦乱，云埋竹坞深。\n残虹开晚霁，飞瀑满遥岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿林熙工面壁洞 其一","author":"徐熥","text":"精舍锦溪东，依然梵宇同。\n一灯禅榻寂，孤磬世缘空。\n花散诸天雨，松生万壑风。\n池光与月色，相对意无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿林熙工面壁洞 其二","author":"徐熥","text":"古洞傍岩阴，烟萝一径深。\n白云皆幻迹，碧草自禅心。\n日午风幡影，月明霜磬音。\n已空人我相，任是世人寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同林熙吉邓汝高游锦溪竹林","author":"徐熥","text":"一路尽苍苔，浓阴画不开。\n山依迂涧转，泉逐断桥来。\n同坐松间石，还倾竹下杯。\n隔溪烟磬晚，欲别又迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水西迟陈伯孺不至","author":"徐熥","text":"之子来何暮，相思漫倚楼。\n望穷平楚月，魂断锦溪流。\n对酒不成醉，看云何处留。\n几回沙浦上，数尽往来舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈十二仲溱归柯屿幽居","author":"徐熥","text":"怜君复失意，别我向南还。\n落日□□渡，春风柯屿山。\n马行青草远，人语绿杨閒。\n归去应垂钓，溪流第几湾。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过白云寺","author":"徐熥","text":"寻僧到白云，便觉远尘氛。\n古道少人迹，流莺处处闻。\n泉声归涧寂，山色过桥分。\n坐听疏钟起，空林正夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘季德还岭南","author":"徐熥","text":"尽此一杯酒，送君心黯然。\n魂飞瘴岭外，路指海云边。\n春老花随马，潮平月到船。\n相思当后夜，闽粤异风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张叔韬博士自永嘉还长溪","author":"徐熥","text":"青毡坐未煖，白马永嘉还。\n梦绕龙湫水，门当天姥山。\n悲风起渡口，落月伤离颜。\n一望一惆怅，思君空闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀郑四琰客边","author":"徐熥","text":"仗剑干明主，壮心殊未休。\n风尘闽海梦，烟月蓟门游。\n相忆坐与卧，去家春又秋。\n君怀弃繻志，当斩楼兰头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄博士典试之楚 其一","author":"徐熥","text":"送汝正秋初，河桥柳渐疏。\n忽飞闽海鹢，去食武昌鱼。\n湖水连官驿，湘云拥使车。\n圣朝方急士，早上荐贤书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄博士典试之楚 其二","author":"徐熥","text":"万里楚天色，君行意若何。\n收将和氏璞，听遍郢人歌。\n帆影洞庭尽，马蹄衡岳多。\n胜游知有赋，莫惜吊湘娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周乔卿","author":"徐熥","text":"交驩才半载，岁晏复离群。\n马上程三日，囊中钱几文。\n行藏元似寄，世态总如云。\n莫笑吾贫甚，梅花可赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歌者陈郎戏作姬妆即席调赠","author":"徐熥","text":"梨园推丽质，结束作妖姬。\n妙舞风前合，清歌云外迟。\n綵衣裁袖窄，翠钿压眉低。\n何必悲黄鹄，愁多貌不移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"建溪中秋怀马季声诸子","author":"徐熥","text":"对君不能欢，乡心有万端。\n青天一片月，白社几人看。\n叶落知林瘦，溪深觉夜寒。\n南飞见乌鹊，何意独凭栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关门晓发","author":"徐熥","text":"关门何处通，路入乱云中。\n鸡唱逐残月，马蹄随晓风。\n泉飞秋涧响，叶尽暮山空。\n感此封疆异，离心谁与同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日集张幼于曲水草堂","author":"徐熥","text":"虚亭来爽气，秋色满疏篱。\n楚客纫兰佩，吴姬唱竹枝。\n假山遥对户，曲水暗通池。\n不负登高兴，浑忘故国思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄惟起弟","author":"徐熥","text":"别来音信稀，忆汝忽沾衣。\n细雨孤帆远，长天一雁微。\n魂随青嶂断，梦与白云违。\n明岁黄花节，知余归未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浒墅关逢王百谷","author":"徐熥","text":"才作吴门别，重逢在水涯。\n青蚨沽绿酒，彩鹢载黄花。\n坐久潮初满，谈深日易斜。\n虎邱一片月，相送到京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金昌赠钱功父","author":"徐熥","text":"半偈庵头别，春风又几年。\n相逢犹问姓，感旧各茫然。\n尔我形容改，江湖梦寐牵。\n此心倍悲喜，莫怪太留连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云间旅情","author":"徐熥","text":"一帆辞槜李，两日到云间。\n江路依松转，柴门映竹关。\n颜随秋色老，梦逐暮潮还。\n忽听华亭鹤，怅然思旧山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京口夜泊迟陈大不至","author":"徐熥","text":"落日横京口，停云更黯然。\n经旬同去住，此夕异风烟。\n目断寒芦外，魂销短烛前。\n榜歌频起听，永夜不能眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同彭正休陈子卿游金山遇张函一孝廉闵寿卿山人恩公若公","author":"徐熥","text":"万顷江如练，中流涌翠微。\n浪翻孤塔影，云恋定僧衣。\n客路同声少，空门聚首稀。\n斜阳各南北，惆怅水烟飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陈子卿过广陵访夏玄成吴叔嘉留饮席上分得灯来二字 其一","author":"徐熥","text":"岁晚天涯客，孤舟度广陵。\n论交疑是梦，对酒喜如渑。\n郭静涛声远，天寒露气凝。\n不愁归路黑，江上有渔灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陈子卿过广陵访夏玄成吴叔嘉留饮席上分得灯来二字 其二","author":"徐熥","text":"客路逢知己，飘零未可哀。\n冻云依树合，残月隔花来。\n喜对高阳侣，惭非邺下才。\n观涛吾有赋，秉烛为君裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬陆无从率尔见赠之作","author":"徐熥","text":"陆氏机云后，谁当夫子贤。\n赋能工白雪，官已薄青毡。\n地僻门如水，庭閒草似烟。\n芜城分手处，感激赠新篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"交河早发","author":"徐熥","text":"京华望不极，晓起戒行程。\n马怯霜桥路，鸡残月店声。\n晨光催断角，暝色破孤城。\n此际栖栖者，思乡无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河间宵征","author":"徐熥","text":"不尽风尘苦，宵行路更难。\n清霜蛩语急，斜月马蹄寒。\n砧捣闺心碎，笳吹乡梦残。\n驿楼看尚远，何处解征鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆故园梅花","author":"徐熥","text":"衰柳长途恨，寒梅故国思。\n微霜虚矮屋，残月冷疏篱。\n陇外人难寄，林中客到谁。\n藤山欢赏处，又是隔年期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北地","author":"徐熥","text":"北地非吾土，重游信可哀。\n鸦声喧白骨，马足起黄埃。\n野旷衰杨柳，田荒变草莱。\n江南风物好，一望一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至京","author":"徐熥","text":"客途劳役息，帝里物华新。\n马踏交河月，莺传上苑春。\n曙光开柳陌，云气恋枫宸。\n应待临轩日，抽毫赋大人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛夘除夜姑蔑舟中","author":"徐熥","text":"客路行无尽，终天恨转深。\n乾坤乌鸟泪，风雨狖猿吟。\n爆竹催残腊，梅花忆故林。\n未能委沟壑，聊慰北堂心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭士龙","author":"徐熥","text":"送尔不能歌，相看意若何。\n离心寄云水，春梦隔关河。\n草色晴尤媚，莺声暖渐和。\n梁间悬榻在，莫惜数来过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶廷荩","author":"徐熥","text":"我本倦游者，送君增苦颜。\n潮声螺女渡，归梦壶公山。\n春色莺啼外，行程鸟道间。\n所嗟璚树远，何日更追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中得王少文诗","author":"徐熥","text":"山楼才信宿，偃卧各经旬。\n负此看花约，蹉跎欲暮春。\n诗从愁里荅，神向梦中亲。\n谁复怜同病，相思长苦辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭张隐君","author":"徐熥","text":"先令云亡日，君犹恸哭过。\n芝焚方自叹，薤露忽成歌。\n耆旧乡中少，交游梦里多。\n因之动凄楚，肠断更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与惟秦夜话因怀惟起客水西","author":"徐熥","text":"春宵何太短，忽忽已三更。\n灯散疏林影，蛩传古砌声。\n谈深尘虑息，坐久月华生。\n为忆溪行者，应含两地情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食日熙吉玉生惟秦振狂伯孺少文集绿玉斋","author":"徐熥","text":"佳节逢寒食，孤斋聚德星。\n谈应同稷下，会可比兰亭。\n粥煮杨花白，尊浮竹叶青。\n春光能有几，取醉莫教醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜兴公弟游方广嵓归","author":"徐熥","text":"犬吠竹间扉，游山客乍归。\n杖头岚翠在，衣上水帘飞。\n路入羚羊谷，舟停鸥鹭矶。\n惭余多胜具，此地却相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石嵩废寺","author":"徐熥","text":"寺废久无钟，禅关掩万峰。\n空廊惟卧虎，弃钵不归龙。\n墙塌埋残碣，苔深翳古松。\n倘非樵子引，那识往来踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮送周乔卿","author":"徐熥","text":"忽惊春已去，况复送君归。\n别意有如此，前途花正飞。\n蝉声风外急，山色雨中微。\n后夜看明月，相思独掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林宗大之玉田","author":"徐熥","text":"飞花满驿亭，送子出郊坰。\n马影云边见，蝉声雨后听。\n沙看两岸白，山到五峰青。\n试向中宵望，何人是客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈道育下第归玉融","author":"徐熥","text":"怜汝复弃置，归寻海上山。\n相逢俱落魄，何以破愁颜。\n古渡春流外，孤城瘴雾间。\n离心当此夜，空对白云閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠隐者","author":"徐熥","text":"东郊称大隐，耕凿古风存。\n水竹开三径，桃花自一村。\n閒心馀白发，生事寄青尊。\n爱尔幽栖处，依稀似鹿门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠渔者","author":"徐熥","text":"不作风尘客，生涯寄钓纶。\n江湖孤棹远，烟雨一竿贫。\n鼓枻同渔父，藏名比富春。\n武陵溪尚在，为我问迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦","author":"徐熥","text":"梦里交驩者，平生识面稀。\n赠香疑贾女，解佩似江妃。\n锦水烟波阔，巫山云雨微。\n蘧然惊醒处，清泪满罗衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上送惟起弟","author":"徐熥","text":"别意孤帆远，行装一剑贫。\n何堪哀痛后，复际此风尘。\n旅馆常怀母，长途好爱身。\n江干一杯酒，相对总沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高广文之蜀 其一","author":"徐熥","text":"金粟台前别，征帆夕照催。\n猿声巫峡听，马帐锦城开。\n闽海风尘隔，巴流日夜回。\n此乡多俊彦，若个子云才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高广文之蜀 其二","author":"徐熥","text":"蜀道难如此，分携思不穷。\n秋风登剑阁，夜月度蚕丛。\n客路凭羸马，离心寄断鸿。\n讲堂闻尚在，好去继文翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠方伯书","author":"徐熥","text":"风尘初识面，尊酒罄交驩。\n人已如玄度，才能逼建安。\n青云名不薄，白雪和应难。\n此别何时遇，秋宵梦木兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得舍弟吴中书","author":"徐熥","text":"汝别三旬久，家书两度看。\n帆前江月迥，马首岭云残。\n路远愁装薄，秋高怯被寒。\n孤身千里客，若个劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠性言上人 其一","author":"徐熥","text":"多年坐沃洲，此日伴师游。\n白社閒中梦，丹枫客里秋。\n浣衣江月冷，扶杖岭云流。\n欲證无生诀，萍踪不可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠性言上人 其二","author":"徐熥","text":"南朝四百寺，师在几招提。\n法以莲花悟，诗将贝叶题。\n游踪闽海曲，归兴秣陵西。\n相见即相别，秋风惜解携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐氏池亭 其一","author":"徐熥","text":"名园依北郭，避俗此盘桓。\n鹤迹留苔径，莺声满药栏。\n池添春雨涨，楼对暮山寒。\n但得频投辖，相过意未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐氏池亭 其二","author":"徐熥","text":"桃源何处所，此地即仙家。\n林密藏春霭，楼虚纳晚霞。\n轻风三径竹，微月一庭花。\n晏坐尘心远，寒塘独听蛙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀惟起弟","author":"徐熥","text":"远客怜吾弟，离愁有阿兄。\n久无鸿雁信，空听鹡鸰声。\n岁月三秋晚，寒温两地情。\n山斋长寂寞，日日计归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧山庵逢亮上人","author":"徐熥","text":"清溪带远山，曲径入松关。\n客以参禅至，僧当乞食还。\n一瓢秋色澹，孤磬夕阳閒。\n别去仍回首，禅房云气间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李驿使之官雷阳","author":"徐熥","text":"驱马将何适，微官傍海涯。\n公庭饶蜃气，墟落半蛮家。\n路指羊城入，山邻象郡赊。\n地偏少束带，高枕咏皇华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过挹翠亭","author":"徐熥","text":"精舍祗园近，翛然远市喧。\n山光隔竹少，月色傍花繁。\n松影摇虚阁，萝阴翳短垣。\n小舠时可泛，彷佛武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日大风雨与黄道晦陈惟秦饮屋后小山","author":"徐熥","text":"九日忽风雨，登高事已非。\n秋声繁灌木，商意薄轻衣。\n众壑浮青霭，千峰失翠微。\n小山培塿甚，吟眺亦忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":23043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]