[{"title":"清明","author":"黄公辅","text":"桃花结实柳花繁，寒气初降晓日温。\n陇上鹃传三月语，枝头风到几花番。\n新烟燧改家家火，扫墓人归处处村。\n周野小梅青草长，杏饧麦粥怅黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冒嵩少公祖见惠佳刻诗扇答谢","author":"黄公辅","text":"光谢星岩剑气横，端溪涛静走鲵鲸。\n旌旗又动伊山色，刁斗更閒夜月声。\n忽向高楼闻赵倚，遂令危坐耸陈惊。\n若非缘假并州旧，那得披云睹太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署观桃 其一","author":"黄公辅","text":"春光景物渐舒森，官舍园亭对碧岑。\n含露生香桃自媚，随风舞瓣蝶来寻。\n祇缘吏隐馀长日，得藉花茵坐夕阴。\n数片斜飞红点袂，依稀点入客边心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署观桃 其二","author":"黄公辅","text":"嫩碧柔香共郁森，无劳短屐陟遥岑。\n春深署里还堪赏，桃傍柳边正可寻。\n未问栽时谁氏手，且看开处满庭阴。\n去年花也今年似，两度悠悠节序心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署观桃 其三","author":"黄公辅","text":"澹荡风翻万绿森，载阳光景六亭岑。\n也知春色难关住，只在桃花不费寻。\n好与游蜂分嫩蕊，还同眠鹤共清阴。\n虽然冉冉风尘客，亦有渔人再问心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署观桃 其四","author":"黄公辅","text":"迟日桃花对柳森，光浮林杪翠连岑。\n香从风绪飘来远，趣向閒中静里寻。\n豁眼绛英兼绿叶，怡神高影又疏阴。\n乡园亦有桃花坞，一处看心两处心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署观桃 其五","author":"黄公辅","text":"双树桃开出格森，红妆丹脸映云岑。\n芳魂恐逐东风老，逸兴宜携北海寻。\n倚槛婆娑生远韵，满身重叠逗轻阴。\n衙斋传舍谁为主，只是烟霞物外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭内","author":"黄公辅","text":"四十馀年举案情，风尘未遂鹿门耕。\n归心每逐飞云绕，炊臼遽从旅梦惊。\n永诀不闻知尔若，唤卿无语重予怦。\n寿元刚及慈亲寿，萱草兔丝总泪盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭余舅","author":"黄公辅","text":"郎舅居然骨肉敦，高怀雅韵洽寒暄。\n天涯到处同游屐，雨夜任时狎寤言。\n方借庄樗歌舞綵，岂将诗箑赋招魂。\n相随老姊泉台下，那管啼鹃血染裈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭五女","author":"黄公辅","text":"前身疑是谢家娘，好读诗书静绣房。\n玉种名门谐执栉，霜凋弱柳冷纁裳。\n雁声哀度衡阳浦，蜀魄凄侵宝署堂。\n二十六年空石火，深闺谁复问椒浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别徐蘧如郡守","author":"黄公辅","text":"交游宁事索形骸，此日那堪怅别怀。\n舟载民情波浩浩，鸟传骊语韵喈喈。\n邵江甘树长留润，铜岭閒云得偶谐。\n解组由来千古重，羡君我欲觅凡崖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初度写怀","author":"黄公辅","text":"悠悠何物束筋骸，多少非心搅旅怀。\n读罢蓼莪篇欲废，啼残鸾鸟韵谁喈。\n孤悬弧矢成虚度，得趣园林尚未谐。\n傍坞榴花应共笑，乡关回首几重崖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别陆周明四奇","author":"黄公辅","text":"数千里道喜相寻，邵水何如气谊深。\n赤汗名驹怜骏足，灵心抽茧重鸡林。\n离怀忽尔惊梧叶，行色那堪望远岑。\n别后能无忘雁序，明年秋好寄芳音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐怀岵侍御至攸县有书寄答之","author":"黄公辅","text":"二十馀年赋索居，各天消息隔双鱼。\n风尘易掷青山老，岁月堪怜白发疏。\n秋影忽来何处雁，霁光疑把故人徐。\n寒潭潦尽烟凝紫，忍负深谈一榻馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿吉藩承奉司黄濯阳","author":"黄公辅","text":"高林风动探梅天，紫气缤纷云母巅。\n邸第鹤閒眠月隐，梁园橘老带霜妍。\n凭将一掬阳和日，占得千秋栎杜年。\n天保为君歌一阕，可能携我拍崖肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄饷科游岳麓看禹王碑谒孔圣庙 其一","author":"黄公辅","text":"山环径仄碧层层，指点苔踪快一登。\n犬吠丛林知古刹，云横洞口见幽僧。\n禹碑勒处岩为石，圣庙光乖月是灯。\n引望高峰勤仰止，天空霞静赏心腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄饷科游岳麓看禹王碑谒孔圣庙 其二","author":"黄公辅","text":"丹枫穿日洒阴层，搜壑寻幽处处登。\n若悟安心原有偈，谁云游客不如僧。\n湘流岳峙烟岚幕，幡定风清梵贝灯。\n兴剧不知禽语夕，钟声树杪隔林腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又寻朱考亭张南轩二先生讲堂拜其遗趾","author":"黄公辅","text":"洞辟苍崖俗累稀，流风犹在讲堂非。\n四箴有石看来旧，万赖无声听欲微。\n寒色浅深知节序，野花开落是真机。\n偶来揽胜因怀古，山鸟自啼还自飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黄饷科小酌水陆洲寺","author":"黄公辅","text":"名胜不辞胜具稀，水分山色逗禅扉。\n人依叔度波光阔，话入宗乘棒喝微。\n但悟此中无二法，那从他处觅初机。\n烟洲月渚空人虑，别却山门事转非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽李门生","author":"黄公辅","text":"沆瀣契投恩义殊，名蜚琐闼焕青蒲。\n星轺才远燕山路，鹏鸟骤翔浙水隅。\n射斗剑沉金粟洽，飞霜简堕洛江徂。\n讣闻瑟罢湘灵渺，一片愁云暗夕晡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽谭天侗亲家","author":"黄公辅","text":"世谱世姻谊独绸，梗踪三楚亦同游。\n西邕正望霖为雨，南国遽闻玉是楼。\n庭畔棘人悲七子，天涯雁侣泪双眸。\n炙鸡絮酒从何酹，云树江山尽起愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星沙回宝","author":"黄公辅","text":"去日炎犹酷，回时林木稀。\n未知虫墐户，但觉冷侵衣。\n墙角梅初绽，篱边菊已非。\n客中岁易迈，转忆旧渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和岷府长至韵","author":"黄公辅","text":"春意先从邸第传，阳和有脚共欣然。\n仁风暖散双江水，白雪光浮五色烟。\n寒鸟迎曦争噪晓，岸容含露欲舒妍。\n负暄莫献空怀曝，一瓣心香祝大年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别扶东侄归粤","author":"黄公辅","text":"澬水龙山岁月赊，三看梅萼绽寒衙。\n离情忽逐飞鸿翥，望眼其如岭树遮。\n归去竹林穿霭暖，閒来苔径踏云斜。\n涧边鸥鸟应怀我，何日寻盟作主家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和宗室凤岐扇诗","author":"黄公辅","text":"梅花正绽腊，柳眼又舒年。\n乍捧阳春调，恰逢雪月天。\n珠从赤水得，茧自兰庭悬。\n披拂祛尘虑，氤氲意独颛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛巳除夕","author":"黄公辅","text":"楚国悠悠八载淹，柏觞寥寂不成拈。\n孤灯依恋延残腊，疏雨飘萧拂画檐。\n久指翔鸿思郭瑀，未能栽柳学陶潜。\n隔宵便作明年计，雪鬓沾尘也自嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬午元日","author":"黄公辅","text":"忆前壬午学之初，今又重逢觉梦如。\n世事乘除皆戏奕，生涯终始一琴书。\n先看春色争强健，后得屠苏任拙疏。\n最是庭梅堪着眼，隔年风韵更饶馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日怀诸父老子弟","author":"黄公辅","text":"青规转燠散条风，暖遍长林万树丛。\n昔日团炉相谑处，此时欢聚几人同。\n惊心榆柳思村圃，入手年华羡钓翁。\n遥祝庭花凝淑气，敷荣向日各争雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和扶东侄途次寄回署中","author":"黄公辅","text":"归路飞云渺，六亭谁与寻。\n峥嵘岁事晚，迢递关津心。\n雪色寒犹凛，春光霁又临。\n天涯惊节序，梦入阮山深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄寿耀皭侄六十一","author":"黄公辅","text":"山房盟结几何时，六十韶华又转支。\n白发相侵俱老大，戆心犹在只童儿。\n试看宦邸尘飞急，那似家山睡起迟。\n解组抽簪应不远，鸥凫重与结心知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元宵雨有感","author":"黄公辅","text":"春色春情总不胜，雪深云暗夜寒凝。\n如何佳节成虚度，赚却游人未可乘。\n数阵街头挝闷鼓，一枝堂上照愁灯。\n昔年欢聚枌榆事，欲觅些儿也未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙内种桃","author":"黄公辅","text":"夭桃趁雨带花移，疏影柔风舞弱枝。\n烂熳他年春色好，寻芳应有蝶蜂知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"似景侄二儿到衙","author":"黄公辅","text":"鹃声四月带馀寒，日日幽怀独倚栏。\n乍喜足音儿与侄，遂令意绪戚成欢。\n久知尘鞅为虚幻，惟有吾庐是所安。\n冉冉八年湖海梦，好将归计问渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜谢养元至署前韵","author":"黄公辅","text":"薰风渐次扫严寒，芳树阶前护曲栏。\n客里逢君双鬓改，衙斋话旧两情欢。\n丹凭善果心为炼，鹿附蕉隍梦亦安。\n欲共投闲何处好，古冈明月阮池竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝署午日","author":"黄公辅","text":"几度乞骸未得归，楚湖午日尚寒衣。\n乡园久别虚苍鬓，衙署犹惭对紫薇。\n偶望六亭凝宿雾，转怀三径逗清晖。\n虽然亦有承欢者，那似家常蟹蕨肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄刘亲家","author":"黄公辅","text":"倦飞未得遂幽栖，遥忆名园显水西。\n拂槛兰枝凝露馥，满窗花影闹禽啼。\n一从客楚漂蓬梗，几度惊心动鼓鼙。\n四次乞骸归梦亟，主恩应许共渔溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和岷王赐宴","author":"黄公辅","text":"遥望祥光奉命来，庆云璀璨辟天开。\n绵绵带砺千年巩，烨烨龙章五色裁。\n川谷流归咸有汇，鹿鸣歌振了无猜。\n宝坊从此垂光远，日丽风清扫祲埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和宗室干锥","author":"黄公辅","text":"谁氏声高武麓前，璇源毓派也多贤。\n河间自昔流光远，词赋于今大雅传。\n欲览上林春色好，先看芸局笔花鲜。\n八纮力辟兔置阔，凤羽期觇彩蔚然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过南桥铺步壁韵","author":"黄公辅","text":"云绕青山水映桥，丛林夹道鸟声骄。\n不堪鼙鼓惊鸿渚，犹赖芃芃一望遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答陈平若同门","author":"黄公辅","text":"怀人几度感秋蓬，消息遥凭健羽鸿。\n虽是停云浮影渺，犹然鸣鹤和声通。\n华山未许希夷擅，石峒还期鲁直同。\n自笑风尘空潦倒，扁舟泛向海之东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠平若乃弟","author":"黄公辅","text":"剡水悠悠一棹过，芬蒸兰味谱情多。\n季方高况星垂座，伯玉馀风雅入歌。\n无奈倦游惊岁月，遂令离恨动烟波。\n归家若问浮尘迹，已傍渔矶理钓蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方束归装得陆周明世兄书有怀老师及诸兄因寄答","author":"黄公辅","text":"别来又觉绿葵肥，节序天涯转眼非。\n南极一星光射斗，东阶群凤彩翻衣。\n君开紫剑看龙跃，我认清溪狎鹭飞。\n吴水粤山风雨改，嘤鸣声气共因依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵陵别意七首 其一 舒慎庵","author":"黄公辅","text":"自比幽岩鹤共飞，青田料得契玄机。\n一窝高卧尧夫乐，三载欣瞻德曜晖。\n时有庭枝翻绿袖，也无俗状溷渔矶。\n凭君醒我浮尘梦，始向烟霞觅所依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵陵别意七首 其二 马益轩","author":"黄公辅","text":"冥鸿迥尔逐高飞，早晚尘缘认静机。\n澬水烟恬渔唱晚，龙山月朗羽仪辉。\n白头青眼怜同调，黄菊苍松忆旧矶。\n别后弧南频引望，并州魂梦自依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵陵别意七首 其三 彭澄源","author":"黄公辅","text":"溟鲲健羽昔雄飞，鸥鸟于今共一机。\n萼楼高映增声价，兰谱光腾览德辉。\n试问投竿秋水老，可谁分坐绿苔矶。\n祇缘筮得天山兆，风笛离亭重恋依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵陵别意七首 其四 曾十洲","author":"黄公辅","text":"红尘不到野堂飞，何幸亲承杜德机。\n北海杯领酣独醉，南窗日就枕馀辉。\n相将栽柳拈花手，指点栖云睡鹭矶。\n赋续归来成远别，双清阁上梦频依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵陵别意七首 其五 府州县","author":"黄公辅","text":"金风乍觉叶初飞，撩动蒪鲈物外机。\n为厌坭途尘鞅急，转思秋坞晚霞辉。\n有人天路驰骐足，便我园林坐钓矶。\n显晦行藏从此判，月梁颜色耿相依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵陵别意七首 其六 孝廉文学","author":"黄公辅","text":"养翮图南任所飞，芹池飞跃有真机。\n秋光正好抟羊角，春色还看振凤辉。\n桃李参差争向日，丝纶早晚坐垂矶。\n临歧娓娓无多语，北阙东山各自依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵陵别意七首 其七 百姓","author":"黄公辅","text":"泽鸿那忍集惊飞，政拙惟期共息机。\n分外徒然增巧累，林中自足戴清辉。\n绿蓑青笠多长日，烟浦花村是稳矶。\n但把六箴勤付尔，朝昏佩服得归依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄归永言兄","author":"黄公辅","text":"寒冬一剑涉天涯，客路间关感物华。\n隐隐浮云攒万岫，漫漫浅水荡孤艖。\n计程不惮都畿远，回首那堪岭树遮。\n燕市虽然春色近，犹怀昔日咏梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄与区郎","author":"黄公辅","text":"觱发凛寒天，轻舟鼓枻前。\n江边天日近，岭上树烟联。\n抚景怀知己，因风忆去年。\n圣明方市骏，早著祖生鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过仙羊石","author":"黄公辅","text":"奇石参差列岸边，嶙嶙高耸势相连。\n初平异术今何在，叱起群羊不用鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄归耀爵侄","author":"黄公辅","text":"一槎荡漾向长安，历尽江山景冱寒。\n南北阮前人在念，中流独坐月团团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其一","author":"黄公辅","text":"连街童叟拥蹄轮，别酒三杯祝愿频。\n携得民情随马足，胜于囊橐闹衢尘。\n遥瞻越岭怀乡井，才出安门是野人。\n驿路长亭闻鸟语，声声如恋倦游身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其二","author":"黄公辅","text":"不堪驽蹇逐征轮，乡圃关心入梦频。\n归矣一湾新夜月，飘然两袖拂风尘。\n辞将竿木场中侣，结伴烟霞物外人。\n家住深乡城市迥，先人环堵可容身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其三","author":"黄公辅","text":"笑却羲车不驻轮，客途岁籥几惊频。\n羞看华发侵乌帽，惟羡青山远俗尘。\n遮道漫劳怜去骑，飞云正喜引归人。\n鱼肥沼里蒪蔬美，浪说季鹰称后身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其四","author":"黄公辅","text":"畏从埈阪叱奔轮，指使馀年乞致频。\n不羡锦衣甘野服，轻抛朱绶等浮尘。\n江山免笑为逋客，风月相邀作主人。\n世路故交如有问，深深薜荔稳藏身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其五","author":"黄公辅","text":"也曾涂抹学埋轮，扬历于今变态频。\n抽簪自是无嫌忌，制芰由来不染尘。\n碧水丹崖天赐我，月窗云榻我同人。\n閒居赋就无非想，笑比图南一觉身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其六","author":"黄公辅","text":"人间何必恋雕轮，得失那知宠辱频。\n手板已辞三院长，脚头不滚九衢尘。\n从他滟滪多狂浪，须识江湖有散人。\n料理平时栽荔圃，月来花影上闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其七","author":"黄公辅","text":"拟学尊生老斫轮，归途喜听马蹄频。\n先将草檄移花坞，早倩松风扫石尘。\n朋好不须新结社，鸥群应许旧盟人。\n轻舟已认回头岸，不似从前浪梗新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其八","author":"黄公辅","text":"天边缥缈耀红轮，引望宁无感恋频。\n祇以伐檀惭潦倒，遂凭丛桂隔炎尘。\n门前流水应归我，陇上闲云岂属人。\n耕凿犹然歌帝力，行藏总是主恩身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其九","author":"黄公辅","text":"每耽小睡思藤轮，况值秋声入户频。\n彭泽归来依绿柳，野堂飞不到红尘。\n问谁许我为知己，除却明农是故人。\n万境都归虚幻里，倘来何物役吾身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归田十首 其十","author":"黄公辅","text":"最是快心月一轮，几回见月忆归频。\n聊凭一曲良坑水，洗却八年世路尘。\n坐石投竿差得地，傍花随柳更宜人。\n一条烟际渔樵径，野老时过伴此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"全州舟行","author":"黄公辅","text":"倦羽思林愿不违，秋容已觉紫烟飞。\n几湾流水浮舟稳，一片轻帆挂月辉。\n山圃应知薯芋熟，江门料得蟹鲈肥。\n庭前三五儿童望，客子计程且晚归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":30342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]