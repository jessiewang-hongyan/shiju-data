[{"title":"读史二首 其一","author":"梁聪","text":"戎车铁骑出秦关，风雨崤函骨似山。\n纵使老臣能料晋，不知三帅可生还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读史二首 其二","author":"梁聪","text":"据城十万拥雄兵，要听将军奏凯声。\n底事一朝齐捲甲，江南愁杀庾兰成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄岭","author":"夏侯泰","text":"黄岭高朝拥，三峰玉削成。\n也知清淑气，毓秀在贤英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤凰台","author":"夏侯泰","text":"数百年间彩凤来，只今山下有荒台。\n梧桐叶落苍筠老，春雨年年长绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"道家山","author":"朱恪","text":"胜游何处觅蓬莱，十二栏杆迤逦开。\n丹灶火销龙虎伏，碧梧枝老凤凰来。\n春风瑶草烟霞窟，夜雨桃花锦绣堆。\n一自仙人骑鹤去，石坛陈迹半苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登凤台","author":"何潜渊","text":"凤凰台上踏新晴，叶落萧萧秋气清。\n惆怅紫霞仙远去，天风犹似步虚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海月岩","author":"何潜渊","text":"万里无风浪似平，古岩先映月华明。\n客舟不有波涛险，乐向中流自在行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠戴竹林","author":"罗泰","text":"蚤向丘园事晦藏，一生佳誉比琳琅。\n鹿门旧业庞公训，韦曲春风杜老庄。\n竹野玉沈清节在，松阡云冷翠华芳。\n年来跨灶传家好，赖有丹山孤凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠戴翠坡","author":"罗泰","text":"故人结构近陵坡，松竹成林翠作窝。\n岚气湿云青欲滴，石棱凝露?难磨。\n衣冠去古儒风朴，樽酒忘形乐趣多。\n何日卜居仁厚里，相从杖履沐春和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱明洞","author":"罗泰","text":"洞外野泉鸣，终古无人到。\n五色吐仙云，四面围丹灶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚寂甚成此","author":"罗泰","text":"深院无人来，日长疏应接。\n窗外冷斜阳，萧萧闻落叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅馆口占寄何时跃","author":"罗泰","text":"凤台风月近如何，客里怜予独啸歌。\n遥想故人相别后，分曹斗咏兴弥多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"道山春日","author":"蔡藩","text":"突兀高台百尺馀，道家山上接清虚。\n一番春信莺先报，几抹山光画不如。\n腮染嫩红桃乍吐，眉匀新绿柳初舒。\n共逢圣主文明日，凤鸟行看集碧梧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"象城秋望","author":"任彪","text":"惊风撼树寒飕飕，凝云压城颓不流。\n凤凰已去梧桐老，孤台屹立空清秋。\n清秋光景望不极，水共长天同一色。\n霜华著岸芙蓉红，芦叶凌波雁沙白。\n翠微深处烟迷迷，浮屠百尺与云齐。\n紫霞仙人逝不返，空馀草木寒鸦栖。\n倚楼停立吟未了，南桥日落行人少。\n千门万户砧杵閒，笳声连城山月小。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄奉崇善促父亲解组","author":"梁建","text":"民事伤心两鬓萧，海天归思竟无聊。\n悬鱼太守闻羊续，留犊贤侯有魏苗。\n晓日花边宜解绶，秋风江上莫停桡。\n应思膝下频兴慨，尽日莱堂首重翘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓金台送罗鼎归羊城省亲","author":"梁建","text":"拂袖轻风动客寒，都门相送暂为欢。\n关河迢递言归易，湖海交深欲别难。\n堤柳含青春尚浅，山梅褪白雪初乾。\n到家足慰双亲念，菽水承颜喜问安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沙浦呈族兄禘福","author":"梁建","text":"万顷沧波一个洲，坦夷清接玉山头。\n鸟如识主常书篆，潮解留人惯阁舟。\n买醉每投溪口市，豪吟偏上水边楼。\n青青杨柳低低月，笑破红尘傲五侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松庵","author":"周庠","text":"周遭多植岁寒松，庵后庵前翠万重。\n云隐晴梢巢缟鹤，月横凉影卧苍龙。\n叶供午灶茶初熟，花酿春缸酒正醲。\n未必冈梅同偃蹇，昔年曾见觅秦封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题沧洲别墅","author":"周庠","text":"栖迟遥傍数家村，占断沧洲隔市喧。\n红簇锦机花压槛，绿拖长带水横门。\n清风石上琴三弄，明月溪边酒一尊。\n有客还来寻胜境，停舟疑是武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼江自治明经","author":"吴氏两生","text":"问津闻讣涕如倾，水绿山青感旧程。\n解绨难忘先世德，含环惭负此心盟。\n梦云半榻高堂泪，斜月孤窗游子情。\n意欲买刍趋一奠，北风无奈马蹄轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘲曾双溪卖田买妾","author":"曾僖乡人","text":"卖田买妾人皆笑，四十无儿我独伤。\n但看山头无主墓，一杯谁肯酹斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送侄婿翟璲赴都会试","author":"王知谦","text":"鏖战秋闱先著鞭，宝安华胄冠才贤。\n桃花浪暖春如海，桂子香清月满船。\n庾岭风云催去马，瀛洲鸾鹤待登仙。\n摩娑老眼鳌台上，伫看飞腾睹九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江客思","author":"王知谦","text":"篱菊堆金木叶丹，江天秋老客衣寒。\n风高但觉征帆急，金尽那知行路难。\n岁月似梭忙里过，江山如画醉中看。\n从容归去鳌台隐，箬笠蓑衣与钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登望湖亭","author":"王知谦","text":"吴城山下草青青，春半南湖水未平。\n几点征帆来日下，数声渔笛起云层。\n鸥波浩荡兼天碧，蜃气氛氲带雾腥。\n倚遍栏杆倍惆怅，思亲何日复羊城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过飞来寺","author":"王知谦","text":"楼台隐隐翠微间，玉罍金尊特跻攀。\n薝卜有花香可爱，菩提无树地何悭。\n碧潭犀戏拖金锁，苍峡猿归献玉环。\n试问高僧知造化，飞来何日复飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友欧阳公宣之辽东","author":"王知谦","text":"客中送客恨无涯，强展花笺赋别诗。\n辽海岁寒应历涉，巴山春暖少驱驰。\n仲升投笔心先壮，仁贵荣归会有期。\n后夜相思何处是，柳营风细月明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望湖亭忆别","author":"王知谦","text":"望湖亭上访坡仙，倚遍危栏思渺然。\n彭蠡波涛翻白雪，匡庐林壑拥晴烟。\n客舟来往西风里，僧刹高低夕照边。\n遥忆故交分袂处，大姑山下水连天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺教授六十初度","author":"王知谦","text":"童颜鹤发一耆儒，文藻风流董仲舒。\n高志未尝图利禄，生涯还喜乐琴书。\n今朝花甲逢初度，昨夜祥星耿太虚。\n闻说世传仁者寿，遐龄当与古椿如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻鹃有感","author":"王知谦","text":"棱棱襟襫梦难成，又听鹃声更恼情。\n叫道不如归去好，蜀天何处是归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日即事","author":"王知谦","text":"软饱三杯午梦醒，扶筇纵步竹边行。\n清风满径襟怀爽，喜见儿孙次第生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵山寺","author":"庄呈龟","text":"策骑西游访大颠，萦纡一径锁云烟。\n山僧未见供茶茗，野鸟先闻奏管弦。\n宝塔永藏明镜在，上方迥与翠微连。\n个中无限清虚态，自是人间别有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白牛岩","author":"林煦","text":"禅房谁构碧峰巅，此日登临总俊贤。\n满地绿苔真净界，悬崖古木起寒烟。\n闲游试蹑乘云石，渴饮偏寻卓锡泉。\n昔日白牛看不见，空留古迹至今传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵山寺","author":"林煦","text":"衣钵真传道独尊，何年镇幻此山门。\n留衣人去堂犹在，瘗舌坟空迹尚存。\n老树笼烟侵岁月，落花啼鸟自朝昏。\n要知不二门中事，共把残碑细讨论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗汉寺","author":"林煦","text":"隐隐龙宫倚碧山，烟霞缥缈锁禅关。\n水帘挂洞谁收捲，野鸟巢林自往还。\n清磬声随青霭散，高僧心与白云闲。\n群公况复同游赏，樽酒何妨展笑颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日陪李犹登高","author":"陈观","text":"百年能几遇重阳，逐伴登高引兴长。\n邑宰喜陪元亮饮，参军那似孟嘉狂。\n山云映水摇秋色，浦树含风送晚凉。\n满地黄花应笑我，白头犹自客他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书上清万年观东壁","author":"陈观","text":"长松初日访仙家，万壑遥连一径斜。\n涧道云寒龟出曝，药栏风细鸟衔花。\n道人开院闲调鹤，童子分泉自瀹茶。\n湖海年来浑漫兴，寻真犹欲问丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题","author":"陈观","text":"记得年时共笑欢，别时何易见时难。\n鸾筝指下柔荑软，蝉翼钗分翠雾寒。\n红雨落花春事晚，绿阴成子鸟声残。\n金茎不赐文园渴，瘦减裙腰日日宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登西城楼","author":"陈观","text":"年光如水去悠悠，对景伤春易白头。\n歌舞楼台花外酒，风波湖海鸟边舟。\n平居有客迷蕉鹿，当道何人问喘牛。\n家在云山归未得，凭高无那长离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日","author":"蔡普和","text":"草堂睡起未归鸦，懒去寻芳采蕨芽。\n岩静煮茶烧竹叶，涧深流水散桃花。\n冰消万壑春回翠，落日千峰晚带霞。\n林里旃檀香蔼遍，东风吹送到谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴","author":"林光","text":"长薄消晨烟，返照啼幽鸟。\n飘然过片云，寒山青了了。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过同安谒余忠宣公祠","author":"林光","text":"同安郡前舟不进，忠宣祠下首频回。\n野云冥冥天地改，孤城落落心肝摧。\n长江风声自旦暮，青冢岁月老崔嵬。\n树根久坐兴长叹，山禽百种将予哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登戏马台","author":"林光","text":"逍逍步山坡，野花发幽香。\n累累多荒坟，行矣心独伤。\n偶逢道中人，语我西楚王。\n戏马留遗踪，遥遥指前冈。\n揽衣尽馀情，徘徊白云乡。\n群山招欲来，百感易中肠。\n如何豺虎心，一视空群羊。\n智术日相高，成败休论量。\n谁能揭日月，徒尔假隙光。\n我悲千载人，落落空荒唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过鄱阳湖","author":"林光","text":"滚滚浪头白，飘飘舟子轻。\n江吞庐阜足，云隔豫章城。\n风水行秋气，乾坤老客声。\n旧游瞻白鹿，百种起幽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吉水别袁德纯侍御","author":"林光","text":"风叶鸣乌桕，秋云起野烟。\n蹉跎别君意，迢递上江船。\n何处无薇蕨，斑衣且岁年。\n斜阳忽相失，凝睇入螺川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿明月寺","author":"林光","text":"杖藜投野寺，步月入山棱。\n方丈明孤烛，袈裟谒两僧。\n厨烟分异茗，炉火燃香藤。\n近识罗浮面，抟空一老鹏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿罗浮冲虚观","author":"林光","text":"山灵久相候，今夜宿冲虚。\n三岛天分处，双楼月到初。\n已觉非人世，端堪卜此居。\n豫章曾住处，万古一潸如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冲虚观遗羽士","author":"林光","text":"铁桥空在望，胜事几能同。\n此地堪投足，吾生易转蓬。\n剑光飞魍魉，云气隔崆峒。\n欲把长生术，从头问葛洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纪万梅书屋","author":"林光","text":"蓬岛知何处，终南异此区。\n林塘空怅怏，圜堵散抠趋。\n夜照辜山月，春归误燕雏。\n摩挲十年意，空看万梅图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄族弟秉之","author":"林光","text":"城市风声隔，林泉兴味新。\n眼中端望汝，地下足宁亲。\n黑发终成雪，青山岂负人。\n升沉休更问，颜子一生贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登圭峰二首 其一","author":"林光","text":"两目何曾瞬，诸山总有缘。\n跏趺临绝壑，独自听鸣泉。\n炎暑方初伏，安期共老禅。\n市廛无意绪，遥见上孤烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登圭峰二首 其二","author":"林光","text":"湖山万里曾开眼，此地还招我一来。\n老寺棱棱栖古佛，洪泉隐隐作真雷。\n垂观万状俱呈献，却叹浮生能几回。\n何日会寻王子晋，乘槎东去问蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南海浴日亭","author":"林光","text":"苍茫捣绝铜鼓声，风烟两袖云凝凝。\n海天吞吐终未了，今古滚荡成阳精。\n寒山万个揖光晕，残星几点将馀明。\n南州女儿慵于起，不问明朝阴复晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓南海祠","author":"林光","text":"祠庙星霜九百周，野人衰病久淹留。\n乾坤息息藏真念，云水依依谢胜游。\n布被梦恬南海月，绨袍坐老虎门秋。\n殷勤拾贮波罗子，怕有行人一舣舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别舍弟克明","author":"林光","text":"不作宗元别，宗元别易悲。\n瘦躯犹怯病，殇汝尚含思。\n老眼看时态，殷忧入腑脾。\n百年能骨肉，贫贱亦何辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦病","author":"林光","text":"二五有嘉惠，眇躯荷深仁。\n默默百年情，隆隆四体恩。\n璠玙思在匮，瓴甋嗟流尘。\n伤足在深想，垂堂屡逡巡。\n胡乃颠沛中，灾祸兴膂?。\n飘忽变故素，沈困在昏晨。\n万窍藏阴风，四肢成卧轮。\n焚蒸伏盲热，旦夕如环循。\n累累莫支吾，生虑谢伊人。\n两睫竟不交，八邪若相新。\n念攒水菽老，忧积糟糠贫。\n遗药饮孰疑，殷意沃且频。\n垢含思一濯，屈永作恒伸。\n三住秉躯要，百脉讶调驯。\n一点终不昧，耿然贯苍旻。\n形骸端可外，陶铸付大均。\n忽忽岁时易，一笑回阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示诸生","author":"林光","text":"张皇成废弛，隐约见精英。\n鲁叟高林放，齐侯内晏婴。\n谁能留白日，吾甚厌虚名。\n花鸟娇临屋，春杯愧独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行","author":"林光","text":"白帽欹蒙一敝裘，独乘羸马步山丘。\n春风面面天难老，溟海恢恢地亦浮。\n阅世不劳均置足，逃名也欲习科头。\n红尘断隔清湖洞，云鹤千峰任去留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮归次石斋先生韵二首 其一","author":"林光","text":"悬崖难置足，却顾几淹留。\n草草淩晨发，依依入暝投。\n年华更物候，世味白人头。\n昨夜霜天月，梅香尚暗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮归次石斋先生韵二首 其二","author":"林光","text":"看云遭鹿过，弄水见龙留。\n宝聚光须掩，声凡律岂投。\n毫毛即天宇，泰华亦针头。\n道眼无遗照，吾言愧浪浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送戴志达举人还莆田","author":"林光","text":"长日鸟声歇，山静若神守。\n跫然闻足音，两马山之右。\n开关询何客，拜此莆中友。\n款款致衷素，历历未释口。\n间关山路遥，会晤殊未偶。\n呼童摘新豆，荐此榄山酒。\n村酒那醉人，空歌拍铜斗。\n浮生亦易了，白日好西走。\n丈夫贵自树，穷通无好丑。\n乾坤有常业，可大还可久。\n千疮百孔馀，弥缝鲁中叟。\n贤曹抱素资，策鞭良未后。\n吾拙甘死穷，草木同枯朽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠饮者","author":"林光","text":"烂熳花前醉未休，漆园襟度晋风流。\n芳菲已夺游人魄，入耳莺声可自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答秉之","author":"林光","text":"曾贺微阳一点回，梦中消息亦胚胎。\n千红万紫今何若，莫负春声五夜雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"提学佥宪胡希仁先生访榄山留诗为识依韵奉答三首 其一","author":"林光","text":"野云相逐惯披衣，梦断丹青亦掩扉。\n忽枉烟霞一回首，令人空念十年非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"提学佥宪胡希仁先生访榄山留诗为识依韵奉答三首 其二","author":"林光","text":"不薄柴桑驾不回，村醪满引兴悠哉。\n含情未尽东周话，云合乌巾父老来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"提学佥宪胡希仁先生访榄山留诗为识依韵奉答三首 其三","author":"林光","text":"赤手争看拯陆沈，铎声遥振海云深。\n空山老我应无用，谩听南风换楚音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙未九月十四日登罗浮飞云顶","author":"林光","text":"立立空青明返照，遥遥行迈了崔嵬。\n身轻欲逐云飞去，机尽从知鸟不猜。\n四际莫遮天活脱，百年何幸此徘徊。\n褰衣细认经行处，知有游人取次来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别佥宪胡先生升宪副之浙东仍提学三首 其一","author":"林光","text":"采采青蒲叶，采之南海边。\n秋光不可象，吾意亦茫然。\n楚楚成梧槚，殷殷正诵弦。\n风声又于越，垂老话何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]