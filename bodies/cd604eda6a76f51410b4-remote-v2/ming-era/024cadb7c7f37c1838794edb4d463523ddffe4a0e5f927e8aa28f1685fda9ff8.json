[{"title":"住石莲洞赠念庵先生四首 其三","author":"胡直","text":"青莲居士宅，黄石老人书。\n久已从吾好，翛然应物虚。\n澹云空色相，脩竹见真如。\n凡骨参灵境，萧疏自丧吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"住石莲洞赠念庵先生四首 其四","author":"胡直","text":"山坼奇无尽，更疑琪树层。\n穿篱鹿豕惯，争席野人曾。\n高落山巅水，曲垂石窦藤。\n逃名犹未巳，住屋混禅僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石莲后洞转寻又一小洞二首 其一","author":"胡直","text":"不觉窥明见，先从踏暗来。\n忽然辟混沌，那复有尘埃。\n高窦容天入，重关付月开。\n未须嫌阒寂，作伴翠莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石莲后洞转寻又一小洞二首 其二","author":"胡直","text":"一洞复一洞，幽绝到无谁。\n鹿女寻难至，猿公望不知。\n玉书应鸟篆，丹灶自神泥。\n薄暮仙人返，披霞得共窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"坐林中","author":"胡直","text":"岩居一事稀，移屧过林围。\n荒舍无沽酒，隆寒未换衣。\n坐深樟子落，意静鸟声微。\n真有丘中况，随方得所归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同欧阳曰穑游通天岩","author":"胡直","text":"流光悲过客，幽意托名山。\n相与携僧往，悠然并鸟还。\n层巅天共语，曲洞石为关。\n梦里闻钟磬，泠泠非世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过茶山览亡友罗日表壁间题字追思曩昔怆然湿襟因识二首 其一","author":"胡直","text":"吾少谈经地，罗含后亦来。\n人今馀故迹，世早失高才。\n门户留妻女，文章落草莱。\n当时开万卷，莫是玉楼催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过茶山览亡友罗日表壁间题字追思曩昔怆然湿襟因识二首 其二","author":"胡直","text":"夫君何处往，遗墨使心疑。\n想像行花径，依稀弄酒卮。\n虽言长死别，只忆是生离。\n寂寞寒松影，空依壁上诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答兴化顾秀才","author":"胡直","text":"坐挹凌云气，留倾卷雾谈。\n囊开千首赋，宅傍百花潭。\n揽辔瞻天北，飞缨滞斗南。\n见愁胡马阔，语罢泪犹含。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽李光禄祖母","author":"胡直","text":"令德天孙降，徽音泽国倾。\n将雏威凤列，奕世石麟生。\n象服恩方渥，鱼轩罢可惊。\n归来李令伯，江树正秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别南刑部黎克芳蔡汝聘二首时淮阳方有寇警 其一","author":"胡直","text":"矫矫双黄鹄，南飞刷羽仪。\n关山冲暑雨，淮海傍鲸鲵。\n宦薄身应健，时危别转悲。\n悬知匡岳度，幽梦镇相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别南刑部黎克芳蔡汝聘二首时淮阳方有寇警 其二","author":"胡直","text":"四海朋簪合，两君交谊殊。\n贯星南共北，征棹楚连吴。\n叙齿皆为弟，同心已丧吾。\n但看明月共，莫漫怨骊驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早春送萧天宠之官莱芜二首以旧同石莲洞之游 其一","author":"胡直","text":"复作他乡别，深悲故侣稀。\n愁先江草合，望断岳云飞。\n世路凭呼马，官曹当食豨。\n知君兼吏隐，且莫赋初衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早春送萧天宠之官莱芜二首以旧同石莲洞之游 其二","author":"胡直","text":"古邑邻东岱，三峰更接连。\n去看民似鹿，转见吏为仙。\n念我淹金马，因君想石莲。\n乡心将别泪，并入酒杯传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邹二下第南还","author":"胡直","text":"怜君复不第，归去大江滨。\n抱剑从兹往，雕龙竟莫陈。\n帆依彭蠡雁，裘满蓟门尘。\n定遇匡山侣，多应问远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周经历","author":"胡直","text":"空有连城璧，当年竟莫售。\n一官聊佐郡，遥去越江头。\n霜重淹行骑，尘昏辨故裘。\n阊门如过棹，莫更问吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"何封君社中二首即何振卿父也 其一","author":"胡直","text":"讵识山中相，言从帝里过。\n花间九老宴，醉里八仙歌。\n大隐忘朝市，清时狎罻罗。\n为传匡世略，爱子在銮坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"何封君社中二首即何振卿父也 其二","author":"胡直","text":"上国开三径，燕歌异四愁。\n支颐观紫陌，适意度青牛。\n春院星恒聚，秋台月共酬。\n莫须寻阆苑，兹地胜昆丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴郎中出守福州","author":"胡直","text":"五马似龙骧，铜符发建章。\n春阳随盖远，雪月荡旌光。\n首郡雄蛮国，千峰接海防。\n吴公政第一，应为继遐芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日立春喜雪和胡子文太史","author":"胡直","text":"人日春兼至，天葩晓正飘。\n禁扉同贴胜，温树不封条。\n万国瑶图启，三时帝泽饶。\n伫将多富寿，歌舞颂神尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大朝门同午楼复建百官朝贺二首 其一","author":"胡直","text":"井干复天都，门成接斗枢。\n螭蟠衔瑞榜，凤绕夹金铺。\n巽命承中禁，离光照八区。\n万方何以庆，拟上泰阶符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大朝门同午楼复建百官朝贺二首 其二","author":"胡直","text":"轩阁看仪凤，尧阶俯濯龙。\n宸聪从此达，猎疏拟谁封。\n燎火光云汉，珂声接曙钟。\n定应门下省，承问独从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同署范郎中出守淮阳二首 其一","author":"胡直","text":"华省正鸣莺，青门别思萦。\n晓来五马去，春逐百花行。\n古郡依东海，危楼控两京。\n南邦愁带甲，到日有长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同署范郎中出守淮阳二首 其二","author":"胡直","text":"联佩鸣青琐，同曹住白云。\n欲成花下醉，其若席前分。\n鹢首瞻河曲，龙光逼海氛。\n预愁熊轼远，铙吹镇相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"况吉夫督学贵州","author":"胡直","text":"紫届切文昌，兰芬天上郎。\n新辞振鹭侣，去近碧鸡乡。\n剑佩穿蛮部，文章被鬼方。\n何妨轻万里，冠已著神羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重别吉夫","author":"胡直","text":"烂漫黄花日，难禁远别情。\n黔中希雁到，徼外剧猿鸣。\n绝巘扪天上，飞梁并鸟行。\n不因文教重，何自遣朝英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏况吉夫药湖别业二首 其一","author":"胡直","text":"闻道湖中胜，夫君宿所期。\n涵天为泛宅，浴日学咸池。\n鲛室幽相逼，蓬山浸欲移。\n年今瞻太液，潋滟起遥思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏况吉夫药湖别业二首 其二","author":"胡直","text":"辋水开南垞，濠梁得上游。\n鱼吹闻枕畔，荷气到床头。\n屿覆长生草，波回不系舟。\n蛟龙今作雨，曾是昔潜虬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"魏黄门册封汴藩便归省觐二首 其一","author":"胡直","text":"金简出天宫，分封节使雄。\n马乘照夜白，袍著郁轮红。\n嵩岳瑶幡驻，龙沙鹢舫通。\n还瞻双白发，西母并东公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"魏黄门册封汴藩便归省觐二首 其二","author":"胡直","text":"共羡朝阳翼，东飞别帝庐。\n到家仙作队，衔命玉为书。\n锦被应裁扇，蟠桃不羡鱼。\n花缸春烂漫，宴乐复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊外别振卿","author":"胡直","text":"初岁韶光润，离筵落日催。\n可怜燕市月，遥挂岭头梅。\n沧海看鹏运，颍川讶凤来。\n还令群岛国，朝汉有高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别","author":"胡直","text":"作尉明州去，寒风春正初。\n玉堤杨柳细，折赠渺愁予。\n邑里连鲸海，干戈剧羽书。\n如逢天北雁，秖寄釜中鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李太史承命奉二亲归丰城兼讯胡侍读二首 其一","author":"胡直","text":"身将双白发，遥返斗南隈。\n宝馔分神鼎，宫衣出上台。\n尧阶移舞去，汉殿谒归来。\n堂上称觞日，还思献寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李太史承命奉二亲归丰城兼讯胡侍读二首 其二","author":"胡直","text":"苑草半芊绵，堤花开欲然。\n独怜供奉客，遥理孝廉船。\n别绪萦千里，交情记十年。\n丰江双宝剑，暂去几时旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"每日省退归舍马上见西山","author":"胡直","text":"淹留何所贪，开户面青岚。\n夏取峰云慰，冬宜树雪谙。\n三茅仍在望，五老亦长参。\n日日归鞍上，如同故侣谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病省署同邹继甫作八首 其一","author":"胡直","text":"气回丹凤阙，春入爽鸠司。\n曲巷交槐影，长廊挂柳丝。\n才迂欣散局，地僻得冲规。\n更有谈天衍，知音胜子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病省署同邹继甫作八首 其二","author":"胡直","text":"隐吏非慵吏，官庐当草庐。\n莺声流枕席，竹影泛巾裾。\n竟日幽忧病，经年拥肿居。\n欲寻芳杜去，未敢即题书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病省署同邹继甫作八首 其三","author":"胡直","text":"椄槢经旬废，亭疑昼亦稀。\n剧谈松月出，习静鸟声微。\n扬子玄为白，蒙庄是亦非。\n惟馀怀土念，长在北山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病省署同邹继甫作八首 其五","author":"胡直","text":"休沐仍居府，閒情日上楼。\n未能薖轴隐，聊作逍遥游。\n省内开三径，窗中瞰九州。\n回看林霭合，可以当冥搜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病省署同邹继甫作八首 其六","author":"胡直","text":"偶挂乌纱帽，悠然脩竹林。\n却看青玉署，宁异白云岑。\n雪后生新箨，风前袅素馨。\n自非此君意，谁明大隐心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病省署同邹继甫作八首 其七","author":"胡直","text":"脾病宜蔬食，曲肱良在兹。\n盆鱼相吻沫，砌草恣葳蕤。\n坐接青云侣，閒倾白雪词。\n莫须怀禁近，随处是恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病省署同邹继甫作八首 其八","author":"胡直","text":"韶龄期学道，老去尚迷阳。\n日恐童心减，年惊旅鬓苍。\n欲归匡岳去，重使故交伤。\n未寤人间世，何由应帝王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春夜袁沔阳枉寻水塘庵下榻谈禅有独往之兴别后戏作却寄留之","author":"胡直","text":"参侍给孤园，皈依得世尊。\n双林一以寂，半偈两无言。\n慧剑宜剸象，禅枝足叩阍。\n达人无不可，莫羡隐空门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春夜过银锭桥在禁城外北海子","author":"胡直","text":"都城佳丽地，春夜喜重经。\n巨浸通银汉，长桥挂碧汀。\n云移千树月，冰坼半湖星。\n缥缈闻仙吹，祈坛近苑亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李二守 其一","author":"胡直","text":"岩郡连燕甸，官衙驻岳云。\n班应联刺史，人共仰神君。\n停骑春同到，烹鲜日有闻。\n好令箕颍客，鼓腹事耕耘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李二守 其二","author":"胡直","text":"少小结交欢，依稀各鬓残。\n共客长安日，翻悲会面难。\n中年宦始达，畏路梦相看。\n故里吾将返，岩巅望羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠兜率庵僧是僧曾随太平周都峰给舍步访关西杨斛山侍御遂游华山而归 其一","author":"胡直","text":"高迎泉洒落，深踏石嶕峣。\n崖辟支为户，松颓卧竹桥。\n女萝藏犬吠，仙吹和莺娇。\n静者心能惬，相看叹鹿蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠兜率庵僧是僧曾随太平周都峰给舍步访关西杨斛山侍御遂游华山而归 其二","author":"胡直","text":"曾逐江东隽，遥寻陜右贤。\n联翩登华岳，迢递返衡巅。\n口绝波旬语，心依智顗禅。\n还应有秘要，知欲为谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"予与邹继甫有岁晚邻舍翁之约时予赴楚便省过家见春流漫溢耒耜方兴感思宿盟慨然增怀","author":"胡直","text":"作客怀乡井，归乡忆友生。\n以吾今日意，知尔近年情。\n四泽春流溢，千林野鸟鸣。\n何由同抱犊，齐上陇头耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初至武陵官舍续陈后冈先生作","author":"胡直","text":"支离随浪迹，官舍武陵开。\n花近秦人洞，云依善卷台。\n簿书销日短，椄槢感心哀。\n敷政宜春令，幽篁亦趁栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜辰溪舟次对月怀万思节宪长","author":"胡直","text":"沿洄行未定，明月满孤航。\n轮亚双峰正，光涵一水凉。\n遥知吴地共，其奈楚山长。\n寂寞沅江芷，因谁发故芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华容道中闻万思节宪长以赴任延迟被言还阳羡","author":"胡直","text":"思君不可见，良夜若为酬。\n行认同游骑，愁登并济舟。\n云鸿今已远，矰缴更何求。\n洒扫张公洞，予将共卧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上封寺二首 其一","author":"胡直","text":"紫盖接芙蓉，层峦历上封。\n穿云迷后侣，失路听前钟。\n世界归天眼，烟花入性宗。\n莫矜凌绝顶，犹有最高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上封寺二首 其二","author":"胡直","text":"客有泠然兴，随予蹑紫烟。\n狂歌希散圣，宴坐见诸天。\n卧榻依南斗，斋厨注细泉。\n但同无爱染，那用礼金仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别望之后追送二首 其一","author":"胡直","text":"以我沈冥客，亲君澹荡人。\n相看若比翼，远别自沾巾。\n丛菊可怜色，冥鸿欲避身。\n才高休混俗，且卧故园春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别望之后追送二首 其二","author":"胡直","text":"棘寺瞻云切，江洲逐雁迟。\n遥知花烂漫，应对舞逶迤。\n末路唯存道，贫交只寄诗。\n汉庭名已盛，莫久恋陈陂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴武选谒诗贻其封君二首 其一","author":"胡直","text":"稼穑长为宝，诗书亦间操。\n自然真性在，不为隐名高。\n有道忘廛市，无机任桔槔。\n应笑天刑子，摵摵为谁劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴武选谒诗贻其封君二首 其二","author":"胡直","text":"掉头不肯仕，乃复挂金章。\n天语瑶华重，皇恩奕世芳。\n紫衣群鹿豕，乌帽照沧浪。\n匡济平生略，几语尚书郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过周平坡列十馀峰奇峭若笋林赋诗一首","author":"胡直","text":"连山陟未竟，嵂崒见兹岑。\n合作青莲朵，分为翠玉簪。\n可堪逢绝胜，无暇恣登临。\n怅望青天暮，逌然寄此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七月十三日夜坐月寄蒙山子","author":"胡直","text":"忽尔飞天镜，犹疑挂夕曛。\n竹光侵案泠，花气入书氛。\n中年偏爱月，游子剧瞻云。\n揽结难盈手，那能持赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重赠念庵先生","author":"胡直","text":"羡观青琐客，早卧白云坛。\n屋里登岩易，床头得月宽。\n为谢餐霞意，东山计恐难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越王台怀古","author":"胡直","text":"陈帝垒高屯虎豹，越王台夐筑琉璃。\n垒边暮脱黄金甲，台上春传白玉卮。\n禾黍几年云旆旆，莺花三月树离离。\n古今霸业空流水，日月江山有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日觉山寺江亭","author":"胡直","text":"春树花繁覆紫苔，春晴骑马隔花来。\n不禁江涨千寻媚，正听林莺百啭回。\n谷口人同玄豹卧，仙源兴逐碧桃开。\n登临未效东山屐，且向芳亭送野杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日江郊读书感怀简杨虚卿罗良弼欧阳文朝王尚涵","author":"胡直","text":"茅堂苔径俯江湾，终岁幽栖断往还。\n村雨双鸠啼白社，林烟一犬吠青山。\n短衣最爱秋垂钓，长剑能堪暮倚阑。\n弱冠当年怜贾谊，天门涕泪不知难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初春雪霁游妩姥赠谢萧晴川先生","author":"胡直","text":"危峦仙阁临霄霭，绝壁丹梯蹑晚霞。\n雪霁千峰回黛色，春还万树落天花。\n坐看北斗依南斗，行踏金华指玉华。\n愿假慈光分半席，应将文史载三车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送胡仰斋工曹北上工曹旧给谏以言事左迁十年今召还","author":"胡直","text":"赤旌怅望在楼船，翠盖留连向绮筵。\n催柳暖风薰别帐，唤花娇鸟杂离弦。\n一尊且酬东山月，十载还瞻北极天。\n明到金门寻旧侣，几人犹是禁中仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟访座主王吉水明府阻涨怀寄","author":"胡直","text":"江城索寞抱春愁，江草芊绵独倚楼。\n积雨正淹徐稚耒，停云空望李膺舟。\n黄莺选树枝枝湿，碧藻翻泥岸岸流。\n浅薄自知非贾谊，吴公门下负相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":31423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]