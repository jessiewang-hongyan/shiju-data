[{"title":"雨夜","author":"陆深","text":"入夜檐花细，回风雪片轻。\n岁寒如此候，愁绝最关情。\n灯火虚斋永，园林旷野平。\n重门须及早，波激大江横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"微雪不成","author":"陆深","text":"尚腊犹应雪，前春未谢寒。\n入帘看片片，隔竹听珊珊。\n旭日含花动，流云带雨乾。\n来牟如失望，谁续腐儒餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊庚申雨中步出西郊视葬先兄素庵","author":"陆深","text":"和泪北风雨，伤心西郭坟。\n江声空逝水，山色有浮云。\n未起隆中卧，先修地下文。\n池塘春又到，南雁不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和荅黄勉之","author":"陆深","text":"国器推豪俊，乡评熟姓名。\n风帆同偃蹇，歌调独凄清。\n故里层云映，长河片月生。\n非君敦素尚，老去若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题西青小隐","author":"陆深","text":"幽人肥遁处，一片夕阳深。\n入望连秋水，横空带晚林。\n琴书元寂寂，门巷自阴阴。\n云路苍茫里，鸿飞不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙酉岁际二首 其一","author":"陆深","text":"灯火高楼夜，人间岁又除。\n团圞儿女会，萧飒鬓毛初。\n椒叶频传令，桃符只自书。\n百年强过半，非是更何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙酉岁际二首 其二","author":"陆深","text":"扬燎明连汉，流星紫入烟。\n千门俱守岁，一夕共增年。\n寒勒梅香细，春回竹叶前。\n江湖身倘健，歌咏祝尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和刘仲素鸡鸣山","author":"陆深","text":"步入招提境，下方秋水浮。\n雪深枯壁定，云绕远江愁。\n钟伴黄昏去，泉依白石流。\n共僧分一榻，十日不梳头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四日济淮","author":"陆深","text":"云霞开晓色，舟楫乱黄流。\n千古濠梁意，当年帝业州。\n地灵山绕阙，天近水环楼。\n壮志随丹检，芳春感胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖泊阻风","author":"陆深","text":"风水一相激，江湖因改形。\n去来本无定，恩怨空有情。\n客路遥山瞑，渔灯极浦明。\n卧龙何处所，归雁自知更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过故城","author":"陆深","text":"燕蓟日巳远，薄行齐鲁郊。\n孔颜千古乐，管鲍一生交。\n无复歌长铗，何心学解嘲。\n舵楼风水急，落日挂林坳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至入侍内殿遇雪","author":"陆深","text":"夙直通明殿，云空雪片飞。\n履高防失足，怜湿畏沾衣。\n宫跸传来远，期簪望不稀。\n阳和通帝德，瑞白满皇畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自朝天宫还经海子雪甚有怀顾未斋","author":"陆深","text":"密云逗晨光，澄湖抱上方。\n混鹅声转细，碍马路偏长。\n道履三阳泰，花添两鬓苍。\n高楼正奇绝，清宴忆春坊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再集五贤堂次至日登山韵奉荅嵩野","author":"陆深","text":"路向高峰入，筵随落日开。\n客怜今雨到，人拟古风回。\n远暝含残雪，新阳动蛰雷。\n爱君清彻骨，不为看山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题来青轩次韵","author":"陆深","text":"禅定无来往，尘缘有送迎。\n每于冠盖入，先动塔铃鸣。\n天近多仙气，山深少世情。\n极知公为国，未问水云程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵何仲默别郑山人兼柬李献吉","author":"陆深","text":"岁晚同为客，冲寒对别尊。\n独怜辞帝阙，不羡曳王门。\n行计惟诗卷，相思有梦魂。\n南还逢李白，怅望几黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日遇徐子容","author":"陆深","text":"积雪霁人日，苦寒欺客襟。\n相看一杯酒，不负百年心。\n刘向俱中秘，相如独上林。\n共君回首地，十载赋春阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三日雪中入内署","author":"陆深","text":"瑞雪三阳候，祥云万里同。\n凤池留伴待，鹤驭入群空。\n林花犹怯冻，宫柳未禁风。\n老觉才情减，梁园赋独工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与盛希道太史谈玄二首 其一","author":"陆深","text":"愧乏山林骨，欣逢大隐人。\n时参言外意，己识相中身。\n斜月前溪水，微风别浦津。\n青山谁可住，春入柳条新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与盛希道太史谈玄二首 其二","author":"陆深","text":"我有江南屋，花丛挂月痕。\n湘帘风不捲，宝鼎火初温。\n仰面晨窥牖，低头夕掩门。\n千言难易辩，无语向君论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢类庵惠山菜数色","author":"陆深","text":"戢戢云能把，盈盈露带漙。\n琅玕难比色，苜蓿正虚盘。\n百事俱堪做，千金欲报难。\n偏惭名未识，细捡国风看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自忻州还度石岭关","author":"陆深","text":"北望沙场碛，南来石岭关。\n遥山看围合，新水送潺湲。\n短发苍茫里，高情紫翠间。\n晓阴浑未散，暂此寄悠閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予入晋以四月二日宿权店三日过南关抵盘陀八月东巡还亦以二日抵权店是晚遂宿南关三月午饷盘陀岂有定数耶","author":"陆深","text":"一饭盘陀驿，青山是再来。\n登临殊不尽，节物苦相催。\n树色庭除古，秋衣箧笥开。\n天涯俱作客，去住莫惊猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万善驿小憩","author":"陆深","text":"西山初出险，南日正随阳。\n客路逢残岁，人情怀故乡。\n河流看渺渺，云树入苍苍。\n天地留形胜，中州古帝王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望日观冰","author":"陆深","text":"十里湖南路，连空入望迟。\n日华流宝气，风景接瑶池。\n岸谷人间事，冰霜岁晚知。\n扬雄工奏赋，羽猎想当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"井陉道中遇雪","author":"陆深","text":"三白丰年兆，连朝瑞更多。\n岩阿皆入画，郢曲况闻歌。\n点缀乾坤好，调停节候和。\n青山如好客，乘兴远相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入平定州","author":"陆深","text":"雪拥频回马，山寒少见人。\n岁长不记历，风暖即知春。\n泉石谋生薄，烟霞即事新。\n此中有真隐，能望岂能亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓发包家集","author":"陆深","text":"残月晓犹上，清霜春正浓。\n背山过叠叠，前路去重重。\n野店客期集，沙村人力农。\n中原戎马地，开运忆飞龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东乡长至","author":"陆深","text":"至日复至日，萍乡更东乡。\n长途双客鬓，浮世两年光。\n水转溪无路，林寒夜有霜。\n天时与人事，消息看相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"露坐","author":"陆深","text":"露坐消江夜，开帘纳水风。\n十年常作客，百计若为工。\n星斗三天上，乡园大海东。\n南飞乌鹊侣，未必羡冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自山南过宣妙寺复会周约庵小燕","author":"陆深","text":"深慰停舟待，还承高燕开。\n雨中多宝树，风外妙高台。\n老爱尘凝榻，心惊梦破槐。\n空门多意味，欲去重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾颐斋进表","author":"陆深","text":"有美文章伯，楼船出汉嘉。\n万年天子寿，一统帝王家。\n滩下黄牛峡，江回白鹭沙。\n大官供赐酒，湛露映流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"习池","author":"陆深","text":"襄樊戎马地，山简爱高閒。\n胜事传千古，江流抱一湾。\n碧山罗户牖，翠筱漾潺湲。\n东望增乡思，宸游正北还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登祭江亭","author":"陆深","text":"春深羊傅庙，江涌鹿门山。\n一上孤亭望，遥空独鹤还。\n浪沙明浴日，苔砌晕成斑。\n耆旧登临地，高风乍可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"轰厩驿乘潮顺风北下","author":"陆深","text":"人生快心事，风水送归舟。\n况复青山曲，频过碧树洲。\n草深藏乳鸭，波远没轻鸥。\n苦爱观风地，终惭为国谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上虞道中","author":"陆深","text":"山海无藏秀，乾坤有奥区。\n土风兼百粤，习气近三吴。\n潮落曹娥渡，天垂贺监湖。\n画船牵锦缆，时复下菰蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉山西下换小舟乘月","author":"陆深","text":"平生爱山水，清兴此宵偏。\n两岸争开画，中流独进船。\n星河相隐映，波月共婵娟。\n又向滩声里，珠明练倒悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵送李都阃","author":"陆深","text":"相望极天涯，兹行况近家。\n弦惊云外雁，弓卧壁间蛇。\n南国收蛮雾，重湖静浪花。\n宏开仁寿域，那敢献餐霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"常州道中遇雨","author":"陆深","text":"片雨江南路，舟行幅画图。\n树头匀著翠，荷叶乱跳珠。\n秦望烟光晚，晋陵云气孤。\n所嗟舟子意，沾洒与泥涂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆门驿逢张常甫庶子","author":"陆深","text":"忽报荆门驿，俄传学士舟。\n喜来狂欲舞，起坐病俱瘳。\n客笥衣重改，人家麦已秋。\n风波自淹速，意绪且绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夹马营大风","author":"陆深","text":"不知游子意，正切故乡情。\n飘飖自南北，飒飁乱噌吰。\n撼树动地轴，飞沙迷日晶。\n急流江故逆，去棹布频横。\n前途劳问讯，舟子重论评。\n触日白云舞，漫空红雨倾。\n燕衔泥不度，鹊托杪偏惊。\n高阁心疑动，危峰势若撑。\n人间因苦乐，天道任虚盈。\n宋祖龙飞地，高皇虎脱婴。\n百年两陈迹，双眼独分明。\n更发斜阳里，浮萍是此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春分日大风","author":"陆深","text":"九十日春分一半，四千里路长风沙。\n寒衣欲变难为客，晓梦无凭数到家。\n关塞每怜新过雁，山城深护未开花。\n向阳剩有閒庭院，满意东来吹帐纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大风","author":"陆深","text":"昨夜雨沙今大风，美人高阁怨飞蓬。\n柳条万结浑欲断，梨花一株容易空。\n岂是宋都过退鹢，亦愁乡信阻归鸿。\n江南茅屋吾所爱，莫教吹捲瀼西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝","author":"陆深","text":"圣人勤政百工良，钟鼓声严夜未央。\n仗马但闻嘶落月，朝鸦不见带朝阳。\n班成鸳鹭当尧陛，影动云霞护舜裳。\n缓步归来纶阁静，尚添官烛校文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出北城与严唯中倪本端同行","author":"陆深","text":"天门积雨洗炎蒸，日射西山紫翠层。\n白发先朝老供奉，青衫骑马向诸陵。\n幸陪鸳侣时相并，欲挽龙髯却未能。\n流水稻田城北路，去来吾记昔年曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题函谷草堂为许廷纶","author":"陆深","text":"表里河山故国西，昔人曾费一丸泥。\n逃秦客去鸡犹唱，拟杜诗成手自题。\n天际浮云横紫逻，夜窗燃火照青藜。\n卧龙未许终藏雨，指点南阳是隔溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对月","author":"陆深","text":"庭树扶疏月转阴，烟销画烛候虫吟。\n隔帘秋色三千里，伴影离人一片心。\n门寂红颜频对镜，帐寒清梦尚挥金。\n去年燕赵今吴楚，指点明年意更深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄子和主事赴扬州钞关","author":"陆深","text":"潮弄船声发建康，计程明日到维扬。\n官桥夜锁初来客，辇道春摇故国杨。\n傍斗五云常捧日，横空一剑独飞霜。\n政成不隔来年路，儒雅风流日绕肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦淮渔笛","author":"陆深","text":"桃花新水满江流，一棹波连白鹭洲。\n网趁夕阳鱼在柳，酒随村店蚁初篘。\n高怀閒弄江梅晓，古调遥翻嶰竹秋。\n几度曲终潮正落，有人指点说东游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陶云湖墨花水仙","author":"陆深","text":"淡妆高韵北风寒，傍水犹宜月下看。\n神女误遗金约指，良工新制水晶盘。\n绿罗带引风初定，碧玉珰含露未乾。\n细检画图知苦意，春光不爱染云峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子殇后一首","author":"陆深","text":"小巷深深日似年，柴门寂寂掩风烟。\n一川花柳春无赖，三五婵娟夜可怜。\n狼籍头颅多殢酒，飘摇魂梦但高眠。\n少年事业真堪笑，囊有残诗近百篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦寒归心愈切次胡可泉韵","author":"陆深","text":"囊无杨震四知金，手种桓温柳十寻。\n残菊傲霜如恋客，栖鸦带日自投林。\n间来曝背犹堪献，惊起冲寒苦未禁。\n梦绕故园春事里，烟波门巷落花深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊","author":"陆深","text":"风涛满目月黄昏，晚泊澄湖独树村。\n渔艇隔溪常宿火，茅茨临水半开门。\n梦从五夜多逢赦，人过中年易感恩。\n圣主如天司节候，阳和须向岁寒论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闰月廿七日雨雹圆如龙眼书异","author":"陆深","text":"乱飐明珠玉不如，儿童惊喜走阶除。\n拾来颗颗圆相并，望里星星湿有馀。\n造物自应工变化，阴阳谁为管盈虚。\n为农复恐伤农事，细检春秋起例书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丹阳孙思和东游每当山水胜处辄绘为图冬夕过俨山示我光福一段赋此","author":"陆深","text":"看君画里汛扁舟，今夕披图数胜游。\n水面青峰七十二，山腰黄橘几千头。\n帆开远影江湖阔，天接中流日月浮。\n试问虎溪桥外水，为谁烟浪下苏州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵白雁二首 其一","author":"陆深","text":"秋传孤雁过潇湘，人在高楼望故乡。\n颜色总疑新变态，羽毛错认旧随行。\n关山雪后寒无影，禾黍风前夜有霜。\n赢得光辉照尘世，久从灵沼近文王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵白雁二首 其二","author":"陆深","text":"来从星汉下潇湘，妆点枫林入醉乡。\n锦字传情通万里，银筝移柱送斜行。\n溶溶月色怜孤影，渺渺归心滞晚霜。\n堪叹杨雄头尽白，惟将羽猎奏君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度太行而西多土垄层复风物都澹泊自沁北行溪山间始见梨花道傍杂卉红紫斑斑时四月二日也慨然有怀京国旧游","author":"陆深","text":"一路寻春何处寻，山中春色夏初临。\n依微杨柳风无力，惆怅梨花月有阴。\n陶穴尚存三代制，耦耕应抱古人心。\n旧游忽忆怜芳事，云路西南隔上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集夏桂洲宅送崔后渠","author":"陆深","text":"无限高怀付酒边，烛花如为吐红莲。\n雨馀残暑消帘幕，月转微风袅篆烟。\n东阁大开留别客，玳筵高启列群仙。\n不知今夕为何夕，疑在珠林玉树前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和荅胡汝载","author":"陆深","text":"琼林珠阁不胜寒，惭负时趋白玉阑。\n独抱琴书耽寂寞，谁从花竹问平安。\n沈腰己瘦频移带，潘鬓新添欲满冠。\n相对长安同作客，椷诗特地劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张甬川卧月书怀","author":"陆深","text":"可怜三五月婵娟，度榻穿帏搅客眠。\n只照长安情不极，共看千里意俱悬。\n金波欲动江湖迥，银汉斜流殿阁边。\n万户千门深夜里，清辉应为捣衣偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒曹九峰先生墓","author":"陆深","text":"清才巨笔更逍遥，白玉楼成赴紫霄。\n池上梦惊生碧草，碑前人到奠芳椒。\n阴森气候还松盖，摇落年华但柳条。\n多少汉朝金紫贵，将军只数霍骠姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自天姥望天台 其一","author":"陆深","text":"何处天台有石桥，行人指点碧云霄。\n刘郎欲度何由得，隐士难回枉见招。\n斋磬出林春漏永，征旗绕涧暖烟销。\n仙凡咫尺空惆怅，马首东来客路遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自天姥望天台 其二","author":"陆深","text":"两宿僧房病后身，高情聊与白云亲。\n青山似画閒门少，红日如轮世路新。\n吴楚地连多客户，潇湘天远有骚人。\n南中岁晚饶风雨，爱听钟声报四邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后入禁中供事","author":"陆深","text":"瑶翻层雪护黄金，天上清寒分外深。\n山绕帝京开玉障，气凝宫柳长琼林。\n凤凰池畔风先合，鳷鹊楼头月有阴。\n云物不须书异瑞，秪占三白慰民心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊坛演乐","author":"陆深","text":"金涌堤沙接凤城，西山晴雪照人明。\n阛扉出郭依黄道，台殿凌空锁太清。\n阳气正凝南至日，礼官频展奉常牲。\n圣人制作亲遭际，身到钧天听九成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]