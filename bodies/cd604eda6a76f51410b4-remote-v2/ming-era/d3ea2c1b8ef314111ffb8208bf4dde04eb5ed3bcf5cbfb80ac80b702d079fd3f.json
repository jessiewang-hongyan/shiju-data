[{"title":"暮秋酬王元美见寄","author":"谢榛","text":"仙郎久别听征鸿，两地登高怅望同。\n河岳愁云连赵北，海天佳气满吴中。\n老来避世家难定，乱后悲秋赋转工。\n篱畔黄花应自惜，一枝留取傲霜风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集陆道函官舍同丁子学张肖甫漫赋","author":"谢榛","text":"乌鹊翻飞月满城，可堪漂泊旅魂惊。\n三秋共赋嗟吾老，四海论心见友生。\n天转明河分夜色，风摧落木乱寒声。\n醉来击筑高台上，燕赵悲歌自古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕同顾圣甫宿漳河旅舍","author":"谢榛","text":"故人同宿浊漳濆，冰底春声近可闻。\n世事短长双鬓改，岁华新旧一宵分。\n当庭古树明残雪，何处清钟落断云。\n龙剑从来有离合，灯前把看七星文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀卢司业浚卿转留都通政","author":"谢榛","text":"旅雁孤飞惊物候，词人相忆采兰苕。\n梦回金马南云断，愁傍银台北斗遥。\n秋色几看钟阜树，寒声还听大江潮。\n风骚六代谁为主，潘陆冥冥不可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜酌吴明卿宅迟王元美不至得天字","author":"谢榛","text":"君成楚赋已多传，嗟我风骚鬓飒然。\n不厌疏狂同此夜，还令意气感他年。\n明河倒挂长安树，新月低摇太液天。\n虚左迟留待王子，犹疑兴尽剡溪船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蹇武选子修使秦中便道还巴郡","author":"谢榛","text":"都亭离宴对斜晖，万里星轺岁暮归。\n蜀岭云低迎昼锦，巴江草绿换春衣。\n天连上国书难达，山断中原梦不违。\n南北严兵当此日，岂容常掩故园扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张给事仲安擢蜀中参政","author":"谢榛","text":"暂停轩盖离人醉，忽听河桥去马嘶。\n怅望那堪春草遍，劳歌不尽夕阳低。\n天开鸟道三秦外，地入蚕丛万岭西。\n抗疏只今忧转切，几回清梦到金闺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧行人汝和还京兼答丘给事懋实见寄","author":"谢榛","text":"柳花飞尽使车还，肯向王程有醉颜。\n海峤春云征战里，河梁晚照别离间。\n旧交青琐每同赋，老愧沧洲长自閒。\n梦寐相逢论谏草，不知身世隔关山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭山人次甫游秦中","author":"谢榛","text":"马上吴歌壮尔行，度关非是弃繻生。\n黄金剩买新丰醉，红树遥含故国情。\n地出三峰雄陕服，天分八水杂秦声。\n霸陵纵目多秋兴，日夕雕飞蔓草平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北望有感寄梁公济陈宪卿张子畏万言卿四职方","author":"谢榛","text":"直北云霄几度看，燕京不异汉长安。\n边关飞檄黄尘惨，吴越连兵白日寒。\n画策应知司马重，抡才转见职方难。\n古来久将功名定，好向彤廷议筑坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈参政汝忠还任太原","author":"谢榛","text":"邺城春酒共跻攀，芳草相违一怆颜。\n北极云开燕道路，中原天划晋河山。\n宦情独感星霜下，国计长忧战伐间。\n后夜月明千里梦，随君西度马陵关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴给事明卿谪江西诗以寄之","author":"谢榛","text":"琐闱当日起才名，忽讶春风万里行。\n河北书传杨子路，天南帆落豫章城。\n骚人吊古非湘怨，迁客悲秋自楚声。\n帝里旧游今散尽，浮云回首独含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜卫河泛舟同王元美顾圣少醉赋","author":"谢榛","text":"王郎乘舸下重滩，相送清樽一尽欢。\n客路艰虞知己在，老年离合定期难。\n月光初上孤帆落，秋气平分万木寒。\n后夜登楼叹圆缺，回瞻北斗是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田户曹子仁督饷秦中","author":"谢榛","text":"几年郎署见多筹，西度函关得壮游。\n旗影极天开驿路，剑光终夜照边楼。\n吴江百战苍生泪，秦地长征白发愁。\n共道转输非旧日，帝京遥望朔云秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送圣甫之巴东兼讯唐兵宪","author":"谢榛","text":"凌霜走马心独雄，囊底不嗟金错空。\n故事还应问楚老，狂歌聊复随巴童。\n黄牛峡出晓帆外，白帝城开春树中。\n宪府听君一说剑，当樽寒色来天风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄石太守君采","author":"谢榛","text":"驱驰国计久知难，出守多劳感岁残。\n淮海一州宁卧治，东南千舸正愁看。\n石头路断云何惨，瓜步兵来水更寒。\n赤子归心龚遂事，遥闻渔唱起江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张佥宪子用赴滇南兼讯李司封隆仲","author":"谢榛","text":"旌旄飞去拂蛮烟，万里缄书不易传。\n对月几临滇水上，悲秋非复楚江边。\n地偏今古无多雪，春满西南欲尽天。\n迁客相逢莫辞醉，异乡梅柳叹华年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪子廷见过赠别","author":"谢榛","text":"疏才实愧建安人，茅屋频过见尔真。\n甘向清朝藏玉璞，自知幽事在纶巾。\n酒杯动落关山月，诗箧能收海岳春。\n老病送君成一笑，相看谁是葛天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方户曹兆行来自淮上夜话以赠","author":"谢榛","text":"词客为郎淮上游，楚城黄叶早惊秋。\n战云不辨千帆色，征马偏生两鬓愁。\n泽国波涛平远树，海天风雨暗层楼。\n即今兵解聊堪醉，飞挽南来拥帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢次楩赴留都谒陆仪部与绳","author":"谢榛","text":"有客清狂倒角巾，江湖未老报恩身。\n夕阳满地还驱马，秋水连天几问津。\n家在中原闻白雁，赋成南浦对青蘋。\n仙郎共醉金陵酒，不羡风流六代人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送武稚川使太和山","author":"谢榛","text":"使星清晓发征鞍，不惮冰霜行路难。\n三楚胜游当岁暮，万山深入正春寒。\n中天气动青霞馆，北斗光摇紫极坛。\n祝罢还应觅瑶草，归来好献主人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初春酬龚宪副性之见寄","author":"谢榛","text":"昨报襄阳使者过，归鸿雪后度关河。\n遥知游宦惊时序，不惜缄书到薜萝。\n日出汉江春气远，云连楚树晓阴多。\n岘山谁与同临眺，羊祐碑前一浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜同李太守应乾卢山人次楩醉登郡阁赋得秋字","author":"谢榛","text":"共坐前除松色幽，月临虚阁澹初秋。\n凉风自可山人意，清夜堪从地主游。\n身后声名吾且醉，兴来疏放老何求。\n卢敖况是非凡侣，天外閒云任去留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日寄魏顺甫兼忆社中诸友","author":"谢榛","text":"寂寞襟期对菊丛，思君几听北来鸿。\n暮云遥度燕台上，秋色偏归楚赋中。\n兵罢龙荒馀杀气，笳鸣狐塞更悲风。\n群才无那成脩阻，此日登高怅不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀靳太守子鲁","author":"谢榛","text":"送君丝管急清商，曾向都亭醉夕阳。\n聚散几年知鬓改，声名千里见才长。\n淮西未得归鸿雁，颍上犹思集凤凰。\n独倚郡楼兵檄过，乱云寒色满濠梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姜宗孝应辟过邺赋此用赠","author":"谢榛","text":"当年雪月醉宵分，十度梅花始见君。\n巴蜀胜游偏有赋，东南多事岂堪闻。\n江涛夕荡金陵月，山气寒生剑阁云。\n此去乘秋应上疏，三吴好练水犀军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送马德甫罢官归辽阳","author":"谢榛","text":"天涯宦迹有浮沉，薏苡谁知马援心。\n东去田园成老计，西来风物起孤吟。\n关城路断秦云渺，海甸秋生辽水深。\n莫向邻翁谈世事，从教白首卧丹岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄白羊口裴万户兼讯陈兵宪","author":"谢榛","text":"射猎遥知部伍閒，少年聊复破愁颜。\n奇功自出论兵外，侠气人看跃马间。\n日暮皂雕盘朔漠，天寒苍兕吼西山。\n祭遵战守无虚策，拟待明光奏捷还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄汪宪副伯阳","author":"谢榛","text":"朔风吹雁度幽州，凄断胡笳夜不休。\n世事转难仍独立，才名久著亦多忧。\n移官北塞论功日，返旆中林抱病秋。\n定采黄花怀旧侣，海天霜月一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄范方伯尧卿","author":"谢榛","text":"别后星霜远寄声，滇南何意念狂生。\n千山不隔三秋梦，片月高悬万里情。\n江海战馀仍走檄，渔樵业废半知兵。\n秣陵形胜劳长望，自古艰虞好著名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九董户部子才过邺饯别北园赋得中字","author":"谢榛","text":"上客论交樽酒空，高台送别剑歌雄。\n半天白雁登临外，九日黄花聚散中。\n草树西看凄晚照，关山北去急秋风。\n青云各重功名念，动说匡时有异同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李别驾宗器北上","author":"谢榛","text":"一樽聊醉浊河滨，衰老同怀复几人。\n赵瑟离声逢雨雪，郢歌高兴得阳春。\n严程目送双旌渺，战马心悬万户贫。\n丹凤城高天咫尺，壮心时拂宝刀尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读侯二谷诗集","author":"谢榛","text":"词人来自永嘉东，逸气千篇浩不穷。\n闭户越吟知思苦，登台楚赋见才雄。\n崖悬古木奇争出，涧落秋云澹自同。\n庾信即今谁并驾，老夫长叹倚天风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛城夜雨柬赵太守德聪","author":"谢榛","text":"建业当年骢马游，岛夷无定万家愁。\n心悬吴越严兵日，身隔江淮抗疏秋。\n耕稼可曾怀上谷，艰难每自念中州。\n嵩云昨夜来新雨，四野苍茫倚郡楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游嵩高山同莫子明","author":"谢榛","text":"相约登攀兴欲飞，山风吹我薜萝衣。\n碑存汉代莓苔古，地接周京气色微。\n二室仙踪云共渺，三花灵种月交辉。\n夜深谈罢长生诀，笙鹤犹疑天外归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张丈宅饮至深夜因赴乃叔德徵之招言别","author":"谢榛","text":"阿咸留客此同欢，阮籍相招待夜阑。\n城柝乱声连巷动，天河倒影傍人寒。\n张灯歌舞虚宾席，隔院风骚有鹖冠。\n莫讶到迟须剧饮，明朝分手会期难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范尧卿北渡黄河因东乃侄子宣","author":"谢榛","text":"云帆飞度大河流，应念萧条王粲楼。\n近榻蛩螀孤永夜，隔河风雨共清秋。\n疏才人讶成多病，厚禄天教系远忧。\n南北于今厌戎马，宁容小阮竹林游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠钱明府舜臣","author":"谢榛","text":"潘令悲歌秋雨天，遥闻战伐聚江船。\n才淹百里青云后，忧重三吴白发先。\n剑拂积尘星自动，琴鸣流水月孤悬。\n回看北极长安道，祖逖于今几着鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋集杜子奇园亭顾圣少同赋","author":"谢榛","text":"辞官高卧故园秋，亭榭常招枚马俦。\n老去襟期聊共赋，醉来风物转相留。\n霜花簇簇明三径，烟树苍苍暗一丘。\n莫向梁园重怀古，歌钟凄断使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗侍御还巴东","author":"谢榛","text":"遥闻柱史易投簪，寒夜相逢动蜀吟。\n万里田园归后计，两都烽火病中心。\n棹经巫峡云根险，家在巴江枫树深。\n谩说草玄长闭户，千山春色壮登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴子乔有弟从方士数年不归因访于梁宋间赋此以赠","author":"谢榛","text":"北来寻弟意何长，梁沼孤鸿又夕阳。\n消息难真悲道路，飘零未定感星霜。\n独吟灵运三春草，谁见初平万石羊。\n早晚相逢话丹诀，洞庭回首树苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季夏有感","author":"谢榛","text":"南风太狂吹树柯，愁催旅鬓镜中皤。\n炎天不雨徵求急，朔塞先秋战伐多。\n桑柘几家存旧业，烟霞何处有高歌。\n少年应募千金赏，昨日腰弓飞骑过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王苏州","author":"谢榛","text":"阖闾城外几烽烟，非复淮阳卧阁年。\n坐啸江山奇策定，仰看星斗壮心悬。\n石头云逐东征马，扬子波回北饷船。\n乱后不堪吴税重，行春海上问荒田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居张伊嗣见过","author":"谢榛","text":"邺都形胜带衡漳，风土相依即故乡。\n閒到白头真是拙，醉逢青眼不知狂。\n城云无色日将暮，篱菊多花天有霜。\n世故莫谈心自远，随君好去卧沙庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴汝秀考绩之京","author":"谢榛","text":"车马翩翩向北行，郡斋驯鸟送离声。\n一官曾化秦风俗，多事还忧汉甲兵。\n上国浮云秋黯澹，西山爽气夕分明。\n天王况复垂衣日，礼乐从今问鲁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过蕴公房访邹子序因忆乃舅吴子乔时寓大梁","author":"谢榛","text":"禅窗论旧思何穷，云月微明澹远空。\n客里无眠惊落木，老来多难感飞蓬。\n兵连沧海书犹滞，人隔黄河梦几通。\n逸气看君真似舅，可怜吴调各秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人李元博杜约夫徐子静陈石卿相继沦没悲感赋此","author":"谢榛","text":"药裹当窗岁月过，其如老病哭人多。\n徐陈已矣但衰草，李杜茫然空逝波。\n荒野暮烟迷怅望，孤城秋气动悲歌。\n文章不共浮云尽，异日相传竟几何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翟逸人之京兼寄张太史叔大","author":"谢榛","text":"别来几梦汉江干，瘦马长驱道路难。\n行李三秋云共远，飘蓬千里岁将残。\n黄金旧使燕台重，白雪今知楚调寒。\n独有高情张学士，故人北去好相看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓起","author":"谢榛","text":"老去翻多惜子孙，朝来且复问鸡豚。\n杖藜何处堪频往，诗草经年秪半存。\n白发懒梳书在手，青苔不扫客过门。\n閒云肯为山人住，好对西窗浊酒樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张宪副一真赴雁门","author":"谢榛","text":"命驾南来怀落落，扬旌北去路漫漫。\n九秋红叶行边赋，三晋青山战后看。\n狐塞风连笳鼓动，雁门霜拥甲兵寒。\n应知父老多惆怅，河内于今借寇难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对酒示五子","author":"谢榛","text":"冰雪频惊岁序过，向平心事独蹉跎。\n贫欺老子疏狂在，懒到儿曹感叹多。\n鸿雁暮依沙岸草，凤凰时下玉山禾。\n且倾陶令杯中物，月白空庭一放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雪过叶云羽","author":"谢榛","text":"风雪连朝城市閒，敝衣行子独愁颜。\n乱声猎猎摇千树，寒色茫茫失万山。\n事激眼前心自定，名垂身后老相关。\n寻君夜话聊杯酒，不是王猷空棹还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日武安野望有感","author":"谢榛","text":"短褐冲寒一杖随，孤城雪后漫游时。\n愁经残猎风何凛，老得新年春却迟。\n天外紫山晴自出，谷中黄鸟暗相期。\n今朝柏酒人多醉，伫立斜阳独赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜酌苏子川舟中话别因忆乃弟子冲子长子新时寓都门","author":"谢榛","text":"黄昏骑马到河濆，秉烛船窗此对君。\n星斗无光天暗转，琴樽有兴夜平分。\n幽人暂别山中侣，独雁还寻蓟北群。\n明发轻帆时极目，不知遥隔几重云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹太史一呈归金坛","author":"谢榛","text":"双阙归心春草后，三吴回首夕阳西。\n石头树隐摇鲸浪，京口帆飞转鹤溪。\n天许碧山聊著述，地邻丹洞几攀跻。\n茅君有约秋将暮，月白枫林路不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日过方晦叔书院","author":"谢榛","text":"蝉咽高枝秋满城，当轩松桂助幽情。\n地开清沼月相映，石作孤峰云自生。\n醉后转多忧国思，病来偏得著书名。\n讵凭狗监吹嘘力，献赋于今陋马卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑侍御元寿见过时谪深州","author":"谢榛","text":"世事相论感慨深，坐来庭树动萧森。\n才堪经济酬明主，官到艰虞是好音。\n白简尚驰双阙梦，黄云遥系九边心。\n京畿父老望骢马，莫为交游恋故林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋夜登楼望西河有感","author":"谢榛","text":"步屧河桥访旧游，野情物色自迟留。\n风林萧飒喧清夜，云月迷茫失素秋。\n元亮老看荒径菊，仲宣今倚故乡楼。\n吾生浪迹何时定，独对沧波愧白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠吕预所少冢宰","author":"谢榛","text":"忆昔词臣都下逢，几看秋色老芙蓉。\n南归读礼苍梧月，北转鸣珂紫禁钟。\n千里惊时闻旅雁，百年匡世见人龙。\n荐贤每助山公启，不使浮云蔽九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠谢太东少司空","author":"谢榛","text":"巴山倒压洞庭波，形胜相邻赋几何。\n金阙风云当代迥，琐闱章疏济时多。\n天垂南国分三楚，地入中原会九河。\n遥忆司空壮襟抱，千年王气郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄仇近漳别驾","author":"谢榛","text":"广平发轫抵皇州，燕赵风光总胜游。\n宿露尚滋官柳色，晴云远荡御河流。\n鹤通仙气能中养，龙抱天机不外求。\n况有怜才京兆尹，西山相对赋高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀马兰谷中翰","author":"谢榛","text":"留意仙丹了大还，镜中岂镊鬓毛斑。\n丝纶每出能天语，殿陛长趋近帝颜。\n凌晓霜威高北塞，满空秋气压西山。\n坐看飞檄应多感，谁为横戈虎豹关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]