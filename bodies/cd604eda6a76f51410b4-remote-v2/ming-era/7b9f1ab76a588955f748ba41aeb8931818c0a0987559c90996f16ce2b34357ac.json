e":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙牛岭阻雪即事 其十一","author":"成鹫","text":"山庵临别乞安名，信手拈来却现成。\n取次雪晴春草长，白牛饱食好躬耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙牛岭阻雪即事 其十二","author":"成鹫","text":"故山麻麦旧家风，莫与儿孙说异同。\n不见明星见山色，冰消瓦解日头红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦岩杂咏五首 其一 看上门","author":"成鹫","text":"入门有句客须知，举止抬头是阿谁。\n霹雳一声看点额，不妨识得转身时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦岩杂咏五首 其二 看下路","author":"成鹫","text":"莫道登山自不迷，路逢高处便须低。\n凭将一具云霄眼，俯视下方齐不齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦岩杂咏五首 其三 出米石","author":"成鹫","text":"一念贪痴万劫饥，山翁何事不忘机。\n明知信施难消得，日日城中乞食归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦岩杂咏五首 其四 仙人床","author":"成鹫","text":"石榻纵横长绿茵，枕边花发几经春。\n五龙出蛰成仙去，留与岩头打坐人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦岩杂咏五首 其五 锦石","author":"成鹫","text":"何年鬼斧斲嶙峋，石上犹存碧藓纹。\n满眼青钱无用处，空囊盈贮锦岩云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭元修广文入山话旧 其一","author":"成鹫","text":"三年两见锦江春，未识当途是故人。\n君若不来予不往，各分明月与嚣尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭元修广文入山话旧 其二","author":"成鹫","text":"乘车戴笠倍多情，长老峰头笑一声。\n僧未隐山官未擢，相逢不敢问前程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭元修广文入山话旧 其三","author":"成鹫","text":"问予何事在人间，却为无钱可买山。\n愿得旧游身早贵，大家成就一人閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭元修广文入山话旧 其四","author":"成鹫","text":"松寮一宿去匆匆，江上回舟趁好风。\n归去若逢贤地主，漫云城外有山翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"半呰题壁","author":"成鹫","text":"啼鸟声中啄剥频，山翁闭户已经旬。\n白云出入无拘束，笑杀门前面壁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喷玉泉祷雨","author":"成鹫","text":"闻说喷泉如喷玉，今来探水似探珠。\n殷勤报语山灵道，愿挽天河决作渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月窟","author":"成鹫","text":"谁将玉斧凿虚空，一片圆明想像中。\n僧老寒岩无晦逆，蒲团长在桂花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其一 湖山鼎峙","author":"成鹫","text":"湖光百里路千重，鼎足东南见此峰。\n函盖乾坤归大冶，莫愁金石不销镕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其二 峡水朝宗","author":"成鹫","text":"山前流水接牂牁，峡口无风也自波。\n閒上庆云高处望，江河日下更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其三 菩提花雨","author":"成鹫","text":"菩提有路好登临，三笑何如一笑深。\n不用灵山求直指，蒲团长在杂花林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其四 塔院香风","author":"成鹫","text":"风幡动处百花香，宝塔重重见瑞光。\n鼻观全空无入处，木樨花下笑人忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其五 龙潭飞瀑","author":"成鹫","text":"云静溪喧雨歇时，閒来观瀑策双眉。\n一条白练从何去，龙卧澄潭只自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其六 凤岭疏钟","author":"成鹫","text":"凤峤钟声出白云，更无一字可呈君。\n洪音敲落西山日，借问下方闻未闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其七 方池月印","author":"成鹫","text":"高悬古镜庆云边，印破山中水底天。\n月落池空人定后，不知何处别方圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云八咏 其八 曲径云封","author":"成鹫","text":"山前山后更藏山，石路云深户不关。\n却恐云随风雨去，独留曲径待僧还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隐泉诗院杂咏和马专城韵八首 其一 栖云亭","author":"成鹫","text":"五色卿云护一亭，天南铜柱有新铭。\n悬知旦夕为霖雨，留在炎方作翰屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隐泉诗院杂咏和马专城韵八首 其二 平山台","author":"成鹫","text":"高台酉接汉云台，棨戟遥临虎帐开。\n百二山河平似掌，伏波今日又重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隐泉诗院杂咏和马专城韵八首 其三 选石","author":"成鹫","text":"车转朱轮马白颠，频来选石事堪传。\n五丁赑屃山灵笑，笑道初平未是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隐泉诗院杂咏和马专城韵八首 其四 自适轩","author":"成鹫","text":"碧城云物赤城霞，姑射仙人拥绛纱。\n适情不独河阳宰，细柳营中亦种花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隐泉诗院杂咏和马专城韵八首 其五 学睡处","author":"成鹫","text":"太平无复羽书传，高枕真宜水石边。\n卸却铁衣初学睡，将军应是卧游仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隐泉诗院杂咏和马专城韵八首 其六 假山","author":"成鹫","text":"登山何事更寻山，花木参差乱石间。\n万壑千岩方寸地，谁能深入便忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]