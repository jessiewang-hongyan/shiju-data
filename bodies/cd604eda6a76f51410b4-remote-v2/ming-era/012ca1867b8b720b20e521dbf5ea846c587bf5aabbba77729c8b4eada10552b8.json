[{"title":"得家报喜咸儿生","author":"卢龙云","text":"千里椷书自粤南，真传消息喜逾深。\n官同鸡肋淹微禄，家有熊祥送好音。\n此日已徵兰入梦，他时应附桂为林。\n年来棣萼关情处，重睹连枝慰远心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郝太学侍亲赴阙便道还晋","author":"卢龙云","text":"新从帝里冠裳会，远赴亲闱定省来。\n绿鬓喜沾朝命早，斑衣全仗旅怀开。\n梯航正入中邦赋，裘马齐荣上国回。\n最是汾阳风土接，归家犹及柏为杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王皞如茂才省觐尊公太守兼谒外舅司理辱枉顾有赠赋此志别","author":"卢龙云","text":"寥寥薄宦托交疏，有客停桡问谪居。\n人在鸡群看羽翼，我缘玉润识璠玙。\n宾筵乍动南州榻，经笥毕藏外氏书。\n别后总殷儿女恋，庭槐须道应难虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"皞如阻风江上复有寄怀之作次和","author":"卢龙云","text":"遥望江头彩鹢飞，轻鸥点点暮烟微。\n心随驿路川原远，目断来鸿信息稀。\n天划重湖波淼淼，诗因同调思依依。\n石尤不谓翻留客，正值思君半掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊日饮李达卿国宾宅","author":"卢龙云","text":"年华江国递相催，公暇同君一举杯。\n日晚歌声箫史凤，岁寒花节寿阳梅。\n吴钩旧美传家重，徐榻新知为客开。\n醉别已先期后会，许随诗伴赏春来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张参军膺荐","author":"卢龙云","text":"白简霜飞楚甸清，程材郡国荷持平。\n三年画诺书劳最，万里风云应会生。\n日下长途看展骥，春来乔木喜迁莺。\n一时趋府多年少，孝友能如张仲名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答冯君奇","author":"卢龙云","text":"月下开尊隔岁馀，岭头逢驿折梅初。\n书邮念我依庐岳，剑气烦君望斗墟。\n赴陇鹤书南去暮，经年鱼素北来疏。\n尔家不用轻弹铗，代舍终看出有车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张伯子比部","author":"卢龙云","text":"回首看花越廿年，风流文藻故依然。\n非缘天上无知己，自是人间有谪仙。\n玩世我同方朔隐，倦游君似马卿贤。\n相逢欲就餐霞侣，共听庐山瀑布泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李大顺自蜀来移任增城泊舟章江过访","author":"卢龙云","text":"客舍春融二月初，文谈谁共对公馀。\n来从谕蜀功方就，喜接浮湘会未疏。\n垂橐可增循吏传，探囊多有异人书。\n双松又傍罗浮胜，河润应沾九里居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即席寿胡司理时东园桃柳方盛","author":"卢龙云","text":"二月中和淑景长，君家四美在东堂。\n已从绮席沾春酒，更喜华园对众芳。\n丽日暖浮桃锦烂，条风轻动柳金黄。\n上林伫报迁莺会，来岁谁同醉羽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗符卿起官入京","author":"卢龙云","text":"春风客路送弹冠，犹记相随策治安。\n启事向推公望重，尚符新拜主恩宽。\n赓歌渐喜虞庭近，漂泊能怜蜀道难。\n朝觐从容应有问，子虚谁奏圣明看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答惟学宗侯","author":"卢龙云","text":"见说南州榻屡悬，喜传新咏思翩翩。\n汉庭宗学推刘向，禹穴奇游慕马迁。\n胜事花间邀彩笔，尘心竹外涤流泉。\n惭余潦倒遭时晚，鞭弭词场藉汝先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜饮惟学宅","author":"卢龙云","text":"雨过云开月正圆，朱门宾从集初筵。\n西园尚美当春候，下里宁惭和郢篇。\n绮席沾香花似锦，金樽漾绿酒如泉。\n归来醉起更残后，犹记谈高座上玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送佐甫宗侯入永新兼寄何明府","author":"卢龙云","text":"风含绿筱雨初收，景物萧然五月秋。\n不傲羲皇閒处卧，偏思河朔暑中游。\n葵榴有艳归囊草，鸥鹭忘机傍客舟。\n此去羊何应共和，教人天畔忆登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄季重自闽中至南昌使君馆之僧舍","author":"卢龙云","text":"闽海当年忆漫游，公馀曾共语千秋。\n羊肠世路多漂梗，牛耳词坛代作裘。\n此际风尘羞吏隐，几回书札问沉浮。\n南州已下陈蕃榻，郡阁能无十日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"熊颜二茂才各以诗为贽赋答二首 其一","author":"卢龙云","text":"蓬莱宫阙待仙班，倾盖逢君暂解颜。\n结客少年场渐散，异乡岐路辙俱环。\n相看气味投兰芷，不为泥途弃蒯菅。\n珍重双珠来合浦，案头交映夜光寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"熊颜二茂才各以诗为贽赋答二首 其二","author":"卢龙云","text":"楚畹曾传大国香，相逢意气即飞扬。\n艰危鸟道非龙种，蹀躞词场总雁行。\n得路云霄终接武，论文风雨暂连床。\n荆州敢谓同司命，却喜文林集众芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送来参军转运入京兼寄其观察叔于东鲁","author":"卢龙云","text":"司农积贮水衡钱，岁岁梯航向日边。\n喜近尔家天尺五，何辞飞挽路三千。\n竹林自古高南阮，别墅由来爱侄玄。\n相见为余称契阔，更于何地附班仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答族弟仲升远寄二首 其一","author":"卢龙云","text":"家园韡萼总争妍，羁旅天涯思独牵。\n客类楚囚方落落，人言公子并翩翩。\n青衫谪吏吾兼隐，丹液寻真尔欲仙。\n神物几时当自合，祥光遥望斗牛连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答族弟仲升远寄二首 其二","author":"卢龙云","text":"帘捲西山翠竞流，几同高士集南州。\n时凭帝子千年阁，最忆元龙百尺楼。\n暂赋閒居招白社，难将吾道付沧洲。\n花光紫陌年年在，迟尔长安续胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆郊居并答仲升","author":"卢龙云","text":"旧辟郊亭称地主，别来花雨几阴晴。\n自缘旅泊悲龙剑，长忆仙流咽凤笙。\n下走马牛迹尚混，故山猿鹤怨难平。\n何时秉烛西园会，得句池头月五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王孙雪在堂","author":"卢龙云","text":"绵绵浚泽出天潢，作室于君羡肯堂。\n白雪高峰齐峻洁，朱门奕叶有辉光。\n日华宫比延贤旧，天禄楼如校艺长。\n人道本枝同百世，看看玉树久逾芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方伯闇应试南都","author":"卢龙云","text":"十年江国号齐驱，此日骅骝送过都。\n璧水槐风清劝驾，金陵桂月照操觚。\n应逢谢尚招牛渚，不遣方干恋鉴湖。\n得意秋高鸣鹿后，可因来雁慰思鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西行答黄季重时季重方在忧中","author":"卢龙云","text":"长年奔走逐微名，此去西南越百城。\n圣化菁莪均士类，儒襟羔雁待文衡。\n山光傍马琴声入，夜色冲牛剑气横。\n怪尔蓼莪今且废，远从天外念周京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙阳道中水涨以舟行","author":"卢龙云","text":"微茫浦溆汎孤舻，烟景何曾让五湖。\n习习轻风翔鹳鹤，曈曈初日照菰蒲。\n随波锦缆疑沉陆，傍险银鞍免戒途。\n跋涉敢辞王事苦，路难终日悯征夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"常德张使君祈晴有应为赋二首 其一","author":"卢龙云","text":"张君为政乐难支，露冕听歌穗两岐。\n乍见污邪愁毒潦，随看原隰转朝曦。\n丹诚自可苍穹格，黔首仍无暑雨咨。\n况是冲泥匹马倦，周行千里仗清夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"常德张使君祈晴有应为赋二首 其二","author":"卢龙云","text":"相府曾传燮理功，风流作郡此堪同。\n方迎千骑歌来暮，辄为三农愿岁丰。\n穑事已占虹见外，民愁不在雨阴中。\n归朝有问闾阎隐，疾苦无须对泽鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨明府惠酒叠至赋谢杨柳州人时谪居常武","author":"卢龙云","text":"廿年拙宦忆龙城，此日逢君盖复倾。\n往事总非南国召，相怜犹类故乡并。\n客厨楚醴频频酌，征路骊歌缓缓声。\n见说中朝方振滞，伫看前席问苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辰溪钟鼓洞用王文成公韵","author":"卢龙云","text":"广乐钧天来洞野，碧岩犹带鼓钟声。\n空虚已悟超千劫，音响依然会九成。\n风景流年容易度，山河举目未全更。\n不因世路惊夷险，九折羊肠亦自平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入黔答余定甫司理","author":"卢龙云","text":"匹马西来一月馀，岂期道路识君初。\n论文并许千秋业，叱驭同驰峻坂车。\n天遣法星岩雾歛，客迎秋色旅怀舒。\n逢人莫更轻谈虎，往事空能独怆余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同定甫游月潭寺飞云岩","author":"卢龙云","text":"选胜逢君遇亦奇，来游草木许先知。\n云生岩畔飞常入，月到潭心想更宜。\n清啸似依黄鹤岭，灵湫堪注白莲池。\n此中大可裁诗句，安得时同浊酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"棘闱事竣答别李士衡郡丞","author":"卢龙云","text":"西南天远净妖氛，佐郡风流此属君。\n刁斗村村秋里息，弦歌处处月中闻。\n识韩有客称司命，忆李他时隔论文。\n樽酒重逢殊未定，江东何地不停云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别杨弼泰进士归汉中杨久谪贵筑","author":"卢龙云","text":"秦越山川万里遥，临岐杯酒别魂销。\n喜看客舍萍初合，愁见离亭柳半凋。\n多士正投知己遇，孤卧终恋圣明朝。\n我因同病相期切，听尔除书下九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答徐仲仁别驾时镇毕节","author":"卢龙云","text":"闽海当年别思频，风烟澒洞渺无津。\n每缘旧事悲隍鹿，谁遣馀波及涸鳞。\n天末龙光悬紫气，途长骥足动清尘。\n干城此日功逾懋，萍梗他乡遇转亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月二日诸生招集会景楼","author":"卢龙云","text":"背郭楼高瞰大荒，西风向夕洒衣裳。\n层霄并擢三秋桂，满座初分万斛香。\n山霭远浮连近壑，波光回合映方塘。\n扶摇健翮从兹始，五色云中是帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周廷评张大行还朝二首 其一","author":"卢龙云","text":"使节迢遥自帝廷，真教南斗避文星。\n翘材或拟平津馆，驱传翻劳送客亭。\n玄草我惭嘲尚白，蓝成俱谢出于青。\n封轺再入邯郸道，莫笑卢生梦未醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周廷评张大行还朝二首 其二","author":"卢龙云","text":"词客名高大海东，王程万里下黔中。\n不缘桃李栽培始，那识菁莪雨露同。\n招俊一方荣拔茹，论文几度慰飘蓬。\n归朝车马应殊锡，荒徼尤难造士功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿靖州江口寄怀陆郡丞","author":"卢龙云","text":"风雨潇潇值晚秋，新寒入夜上衣裘。\n乱山四顾堪寥寂，旅舍孤灯感滞留。\n昨暮管弦叨上客，今宵云树忆他州。\n会看前席归宣室，樽酒逢君续旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟行寄谢张明府","author":"卢龙云","text":"历尽羊肠路几千，何缘孤棹到中川。\n乘流幸借张融舸，被酒兼如李白船。\n政乐已闻歌瑞麦，官贫时自赋贪泉。\n明廷此日甄群吏，会有褒书下九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送韩孟郁春试","author":"卢龙云","text":"清时难道少知音，入奏看君赋上林。\n吴苑未须怜紫玉，燕台元重结黄金。\n由来乐地因名教，谁识华园足会心。\n鹦鹉才高堪自爱，壮图端不误朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发五羊得报恒儿生","author":"卢龙云","text":"西来匹马自黔阳，又觅扁舟系五羊。\n忽睹远天传雁翼，喜闻大国应兰香。\n二年消息逢秋好，异日倡随嗣业长。\n薄宦不须愁未达，堪留雨露到庭芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水西驿值雪初晴以公事留者数日","author":"卢龙云","text":"雪夜孤舟傍水西，凝寒犹自恋衣绨。\n云开野色看逾净，石出江光望不迷。\n祇以吏情淹客棹，几能公暇对诗奚。\n乾坤大有阳和气，次第堪收入品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答冯明元明府","author":"卢龙云","text":"淮南仙令旧铜章，廿载衡门乐泌阳。\n倦鸟祇须怜羽翼，名驹堪自试腾骧。\n弹冠似我惭先达，怀璧从前惜夜光。\n君是冯家郎署后，不将晚暮笑回翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答高正甫郡伯","author":"卢龙云","text":"离筵冬尽忆分岐，晚出翻惭早退时。\n清尚已耽香社隐，微名初附白云司。\n莺花自美閒居赋，猿鹤偏教俗状窥。\n似尔著书深岁月，何人不慕子云奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答惟学王孙二首 其一","author":"卢龙云","text":"几缘结客傍词林，高论逢君足赏音。\n薄宦俸囊淹桂玉，淡交朋谊托兰金。\n并驱鞭弭千秋事，相忆河梁两地心。\n别后魂销春草绿，每凭新咏豁尘襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答惟学王孙二首 其二","author":"卢龙云","text":"江山曾为远人留，记忆中朝意亦优。\n策足久多行路叹，量才初试过都游。\n宦情似奕今于昨，时序如流春复秋。\n同调知君能念我，客星长望碧云头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答仲升二首 其一","author":"卢龙云","text":"廿载升沉付彼苍，年华今已丈人行。\n秣陵风月俱佳胜，汉署衣冠但末光。\n老去自知惭桂籍，握来人道总兰香。\n谢家兄弟芳传早，莫向衰迟拟漫郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答仲升二首 其二","author":"卢龙云","text":"家声两度法曹留，菲薄何堪嗣远猷。\n再世勋名追起草，百年天地附同舟。\n腐儒通籍思何补，拙宦无阶合晚收。\n待尔飞书来粤徼，帝城先起望英楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答孙肖延","author":"卢龙云","text":"南北尘途往复还，离杯忽漫接初筵。\n风云未遂相期意，犬马先惭各问年。\n几历艰危愁鸟道，自惭衰晚负龙渊。\n衡门羡尔多题咏，时有新篇可为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁幼宁明府","author":"卢龙云","text":"出关无复伯鸾诗，赋别还凭慰所之。\n奔逸未称骐骥步，量移初试鹴鸠司。\n中朝记忆恩如海，末路驱驰鬓欲丝。\n几处登临怀旧意，石头风雨益凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨中丞闻讣候代二首 其一","author":"卢龙云","text":"关西世业映中台，天惠南藩福曜来。\n开府声华悬八桂，承家勋泽自三槐。\n方期紫诰荣增秩，何意黄垆永夜台。\n共道修文如有待，可堪风木慕兰陔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨中丞闻讣候代二首 其二","author":"卢龙云","text":"承恩几度锡纶麻，紫气西来望转赊。\n时拟绛驺迎百粤，俄闻白马会三巴。\n已钦治第真容驷，其奈瞻云未及瓜。\n最是南陲资锁钥，不妨游子尚天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟水部重封二人并应奇瑞云","author":"卢龙云","text":"嘉祥屡兆识开先，次第鸾书岂偶然。\n主德固应符四瑞，臣劳亦幸格重玄。\n泽流北海遗思远，颂美南山集庆全。\n见说水衡推懋绩，湛恩端拟更从天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答杨肖韩民部二首 其一","author":"卢龙云","text":"缥缈山光带暮烟，怀人天畔望长悬。\n诗家景物多寻胜，子舍斑斓递击鲜。\n系帛书来丹徼外，草玄亭在碧云前。\n羁愁最恋餐霞侣，况复当春花正妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答杨肖韩民部二首 其二","author":"卢龙云","text":"出山惭我负流年，更忆林园乐事偏。\n五老峰辞青嶂外，六朝迹览白门边。\n身淹薄宦思来日，书至加餐念各天。\n彩笔纵横知寡和，琼琚报莫为君传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中连赏牡丹呈周姚苏谭四曹长共三首 其一","author":"卢龙云","text":"公馀呼酒问花神，秋署何缘别有春。\n林萼已堪过魏紫，樽醪况复得周醇。\n一时折柬俱能至，竟日飞觞未厌频。\n醉后天香衣更染，宝阑嘱护露华新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中连赏牡丹呈周姚苏谭四曹长共三首 其二","author":"卢龙云","text":"奇葩昔日美姚黄，清署依然擅众芳。\n酒态未应孤酒圣，花期谁更负花王。\n开帘秀色辉瑶席，授简飞香溢锦囊。\n多少向阳誇丽质，何如新艳出东皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中连赏牡丹呈周姚苏谭四曹长共三首 其三","author":"卢龙云","text":"列署名花次第开，招邀几度狎传杯。\n芳辰已渐看春去，胜赏宁辞结伴来。\n韡萼并迎新雨露，灵根细认旧栽培。\n樽前绣句多难和，彩笔何当后会催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答体健内弟","author":"卢龙云","text":"海畔风烟万里开，归鸿曾寄帛书来。\n品题羡尔多佳句，泉石于今亦隽才。\n吊古向谁歌玉树，怀人空自酌金罍。\n腐儒衰晚思何补，独有桑榆念未灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王孝廉归柳州兼寄刘司理","author":"卢龙云","text":"风尘漂泊始龙城，岁月长悬旧友生。\n拙宦积薪殊未达，故人怀璞晚初成。\n比年抚字能为政，阖郡循良并有声。\n问讯江头曾种柳，并州他日总多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄林郡丞","author":"卢龙云","text":"曾见双凫出尚方，旋看五马试飞黄。\n初闻渤海无刀剑，更道渔阳有麦桑。\n廿载壶觞差记忆，几村鸡犬半荒凉。\n风流佐郡须公等，露冕重歌召伯棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢友可请假南归","author":"卢龙云","text":"乡心长日念东山，渺渺仙帆不可攀。\n公府未须烦料理，讼庭偏爱有馀閒。\n交游白下风流最，词藻黄初伯仲间。\n可道尚书期不顾，帝城花月待君还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]