[{"title":"连川赵原沧洲图","author":"王恭","text":"冠盖纷纷多宦游，怜君生事寄沧洲。\n半池草梦飞残雨，一片荷衣挂远秋。\n卷幔云山天外小，近人鱼鸟镜中幽。\n遥知霜露松门夕，秋气寒泉兴未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偕陈叔韬宿崇山兰若期少尹陈思孝不至赋得近体一首遂书于壁","author":"王恭","text":"化成烟磬晚微微，何事同心也负期。\n双树焚香栖鸟定，空山对酒白云随。\n风飘仙梵清机远，月隐禅枝夜坐迟。\n明发寄声贤少尹，支公浑似郑当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送兵卫从事考满赴铨","author":"王恭","text":"几年从事总兵机，千里輶轩入帝畿。\n骠骑别时多载酒，故人分处尚留衣。\n秦淮远火春鸿断，长乐微钟晚雪稀。\n闻道宦游西上好，莫将莼菜忆东归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张明府入奏","author":"王恭","text":"满县棠梨春著花，郎官书奏觐京华。\n帆开楚水犹逢雁，道过金坛得到家。\n紫禁曙钟云外听，白门春酒日边赊。\n遥知马首春归早，不待青门尽种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人代兵后还乡","author":"王恭","text":"十年弓马似君稀，到老还乡愿不违。\n祖道百壶孤棹别，温陵千里远人归。\n江桥夜火霜蚝熟，野馆秋风海菜肥。\n好是北堂调膳后，閒看儿女笑牵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和詹时雨哭永宁许将军","author":"王恭","text":"剑锋销尽马啼穿，夷虏凭陵尚寇边。\n谁念将军能死国，远持兵印独归泉。\n荒城听雨伤秋早，沧海招魂怆暮烟。\n忠愤向来同感激，温陵南望泪潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉寄齐府纪善郑孟宣召还京","author":"王恭","text":"三年书信远寥寥，知在临淄道路遥。\n空使多情长忆别，谁知白首得还朝。\n曳裙几醉齐门酒，奉使应劳汉使轺。\n想到九重频顾问，好陈三策辅唐尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈仲全编修兼左春坊","author":"王恭","text":"宛陵曾采泮芹香，一上銮坡被宠光。\n禁里疏钟移夜直，花间鸣佩出春坊。\n思家几度江田绿，念别休惊陇树黄。\n遥羡阿戎同禁苑，朝朝如在竹林乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高待诏自京回必逊王修撰寄声相问赋诗以答之","author":"王恭","text":"几年分教向长沙，此日摛文在帝家。\n清禁日斜还视草，白门朝退暂看花。\n玉壶载酒多同醉，青鬓流年想未华。\n近得故人天上别，感君传语问烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄翰林王孟敷兼促皆山樵记","author":"王恭","text":"钓鲈桥上惜分簪，别后闻君入禁林。\n近道相如能献赋，谁言贾谊少知音。\n永阳独树还家梦，魏阙晴云捧日心。\n寂寞山林樵采事，何时为记比南金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诗寄梁浮丞陈思孝工篆入翰林","author":"王恭","text":"故人西上怅离魂，几度封书寄荜门。\n别梦正悬江口雁，相思谁那岭头?。\n晨朝染翰临飞阁，日夕闻钟出禁垣。\n宸睿若教金石刻，知君不久独承恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠林志仁博士","author":"王恭","text":"麟经独抱上王畿，宫锦新裁博士衣。\n六馆夜凉闻漏起，五门天曙退朝归。\n凤凰台上吹箫迥，鳷鹊楼前见雁飞。\n西掖环林应不远，相逢休道故人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄潘源润因悼黄山陈平叔","author":"王恭","text":"偶因行客问潘郎，忆得黄山醉墨堂。\n斗酒几回浇宿草，松门何处闭秋霜。\n尺书不到边鸿断，三径犹存旧业荒。\n何日远寻高待诏，扁舟能过辋川庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄玉融郑三秀才","author":"王恭","text":"空斋病起怯秋声，无那啼鸪向夕鸣。\n凉雨一天孤烛夜，断鸿千里故人情。\n寒花浥露江蓠白，独树含霜瘴海清。\n遥羡胜游多上日，瑞岩僧舍喜逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三山林文质索咏鹤骨笛","author":"王恭","text":"谁窍青田一片霜，宛疑横吹到山阳。\n声兼陇水将魂断，曲尽梅花带髓香。\n华表仙歌惊落月，瑶台秋梦怨清商。\n唯应吹上天坛去，好伴云璈事玉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为林中洲题马图","author":"王恭","text":"汉家神骥出宛西，凤臆兰筋破月蹄。\n冀北群空知汗血，长杨猎罢见霜蹄。\n青丝引辔穿花入，黄帕蒙鞍对御嘶。\n莫道时平淹栈豆，飞腾思与六龙齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽鳌峰十二明","author":"王恭","text":"伤心叹逝恨千重，云想秋衣月想容。\n青草泉门今独闭，绿樽池馆几时逢。\n棋山访寺馀残雪，花屿寻春有旧踪。\n何处临风堪洒泪，沙头南望见鳌峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢得圭东岚秋思图","author":"王恭","text":"海上仙山连翠岑，夕岚孤树远沉沉。\n遥天落叶鸿边尽，绝岛残钟雨外深。\n烟火数家馀旧业，渔樵几处动归心。\n秋来好是莼鲈美，知尔看图忆故林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高要严氏具庆堂","author":"王恭","text":"严助閒堂野水滨，每同兄弟日娱亲。\n到家几度瞻云迥，恋阙还应爱日频。\n山色半帘铜鼓曙，潮声入坐顶湖春。\n史臣定写茆容传，笑拂端溪紫石匀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海天离思送林生复琼州军","author":"王恭","text":"十年弓骑向边州，暂喜还家又别愁。\n绿酒江亭乡树晚，断云南雁海天秋。\n鲸波万里孤舟远，椰叶千峰片雨收。\n明到琼台霜渐冷，知君长夜看吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初秋留别石田阜阳诸公 其一","author":"王恭","text":"相逢那忍别匆匆，绿酒清诗兴不穷。\n病起异乡惊暮雨，坐来高馆见秋风。\n关河一叶离声里，江郭千峰醉影中。\n堪笑人生多是别，盍簪能得几回同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初秋留别石田阜阳诸公 其二","author":"王恭","text":"石田佳处阜阳亭，几度清游到玉瓶。\n金井夜凉初叶下，石门云尽数峰青。\n林间扫榻同僧定，洞里鸣琴共鹤听。\n正好欢携仍又别，不堪愁思晚冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀安蒋明府望云思亲卷","author":"王恭","text":"马上闽关若太行，白云飞处似河阳。\n宁教带雨将归梦，莫更因风度远乡。\n亲舍几回空外忆，宦情偏向此中忘。\n遥知吏散棠阴下，柱笏行看欲断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽梅江陈以仁先辈","author":"王恭","text":"龙峰耆旧几人存，独客心悲不忍论。\n华表鹤归尘梦远，少微星坠海云昏。\n留宾别馆空悬榻，点易寒窗静掩门。\n零落为君歌薤露，行人无泪也销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宪检校沈公望云图","author":"王恭","text":"隐侯家世巽湖阴，何事看云怅别心。\n亲舍几年违色养，宦游千里戴华簪。\n乌台月暗怀乡远，鹤发秋来入梦深。\n自昔忠臣缘孝子，白华歌尽有馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠判官秩满赴天官","author":"王恭","text":"府僚官满动行轩，西出闽关望白门。\n千里独随征骑别，一廉多付路人言。\n趋朝不用逢杨意，荐剡于今有巨源。\n明到南宫应考绩，政成此外更何论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邑造士萧戴贡胄监兼似国子博士林志仁","author":"王恭","text":"西上青云引兴浓，泮林才子蹑仙踪。\n边淮独树千峰雪，极浦寒山半夜钟。\n璧水到时春雁尽，金门朝退故人逢。\n风流博士如相问，白首林泉事事慵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春宴集海田张氏家楼","author":"王恭","text":"谷雨新晴海气凉，远山楼外色苍苍。\n烟深野树闻歌鸟，风急飞花落羽觞。\n玉屿金塘看月出，锦筵红烛醉宵长。\n独怜踪迹犹萍梗，客里挥毫谩自伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠邑长史高凉黄惟成","author":"王恭","text":"赞襄花县独驰名，高论心閒政自平。\n寸禄只充沽酒费，一廉谁似到官清。\n公馀束带横经坐，吏散空庭著履行。\n芹泮下车严释菜，棠阴悬榻待时英。\n宦游此日非梅福，宣室他年是贾生。\n宛马向来空冀北，吴钩终见发丰城。\n高凉月隐乡林梦，淮泗秋深魏阙情。\n知尔长才姑小试，不惭黄宪旧家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日游棋山寺燕集","author":"王恭","text":"尘中何处避炎蒸，静爱空王澹爱僧。\n沙界树凉晴作雨，石渠泉响暗流冰。\n青山载酒随閒到，飞阁观潮倚醉登。\n水绕莲花通宝藏，路回兰若转金绳。\n仙人棋局埋幽草，开士禅扉闭古藤。\n荒殿鸟啼时近榻，香台狷卧夜窥灯。\n老来行止愁无地，病后欢携愧有朋。\n明发别离方外去，何时清兴又同乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽镏牧","author":"王恭","text":"龙阳孙子参军裔，簪绂承家世已长。\n千里河流通地脉，一天奎壁焕星潢。\n衣冠况复明三礼，文采唯应备九章。\n华馆朋来秋寂历，枫江云断夜凄凉。\n贾生年少人皆惜，李贺才多世共伤。\n新垄渐随蒿里没，旧书犹带泮林香。\n云迷花屿空飞梦，月暗满江更断肠。\n惆怅筹峰峰下路，一回行到一沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送刘逸人还山中","author":"王恭","text":"落日鹧鸪鸣，遥村送独行。\n峰回看不见，望望有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋阴","author":"王恭","text":"寒云将远空，落叶与飞鸿。\n汉苑秦陵外，悲凉是此中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄叶","author":"王恭","text":"带雨飘阶冷，随风著幔凉。\n愁心故宫树，片片落寒霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻渔笛","author":"王恭","text":"渔人将楚竹，吹向月明中。\n莫奏凉州曲，金河有断鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归鸟","author":"王恭","text":"片影云边没，孤声月下微。\n云霄千万里，何似故巢归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"听?","author":"王恭","text":"十年闻笛恨，此夕更沾襟。\n别泪三声下，孤愁一夜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳塘鹭鸾","author":"王恭","text":"烟柳拂波声，霜衣汎日明。\n青山对孤影，宁倦五湖情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访邓山人","author":"王恭","text":"飞鸟落藤花，林幽小径斜。\n白云深解意，相与到君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏青","author":"王恭","text":"雨晴原草新，黄鸟恋行尘。\n年少看花伴，如今有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"草色","author":"王恭","text":"拂拂度林坰，霏霏上野亭。\n王孙归未得，空向雨中青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其一 绿湖","author":"王恭","text":"云归蘋叶齐，雨积波声小。\n日夕水容青，飞来双白鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其二 渔艇","author":"王恭","text":"白鸥将野棹，荡漾波光冷。\n木落秋气多，孤篷逗霜影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其三 莲塘","author":"王恭","text":"荷静香露圆，波深藕根白。\n白晢谁家儿，折花水边剧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其四 古柳堤","author":"王恭","text":"寒潮落沙堰，高柳入荒烟。\n莫把长条折，秋来欲系船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其五 白沙冈","author":"王恭","text":"连峰沙似雪，迢递带沧波。\n好是残阳外，人稀野鸟多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其六 钓矶","author":"王恭","text":"片石翳云根，隐映波光晓。\n君看直钓翁，机静忘鱼鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其七 桃花蹊","author":"王恭","text":"幽蹊入林深，仙花满高树。\n笑谢沧洲人，来去桃源路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其八 竹里轩","author":"王恭","text":"露叶凝晓烟，霜枝老苔石。\n夜半独行时，清凉满巾舄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其九 瓜圃","author":"王恭","text":"烟蔓日已长，露花日已滋。\n为问东陵子，何似青门时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲十咏 其十 秋香亭","author":"王恭","text":"池净秋气寒，黄花日朝露。\n卷幔待情人，幽香满林路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郑山人幽居","author":"王恭","text":"林虚孤鸟白，花落乳泉香。\n寂寂垂萝下，图书共一床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}