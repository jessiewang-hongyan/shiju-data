[{"title":"寄梁兵宪天津 其一","author":"区大相","text":"碣石横燕甸，天津控海门。\n梯航万国会，貔虎五营屯。\n远浪含夷岛，长沙接塞垣。\n人传新节制，清啸似刘琨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄梁兵宪天津 其二","author":"区大相","text":"鸣笳归陇坂，悬旆度天津。\n朔气临河尽，军容入塞新。\n蜃楼清海月，狐岭静边尘。\n要取黄金印，归图紫阁麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月十五月食大风","author":"区大相","text":"月食今宵异，风威特地狂。\n直吹阴曀灭，休遣恶氛扬。\n桂满摧虞折，轮移急虑伤。\n时祲兼贼盗，沾洒望清光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昌平道中","author":"区大相","text":"山家未夕昏，半已掩柴门。\n车马争途疾，牛羊下坂喧。\n春阴入陵树，雨色过湖村。\n谁道相如病，犹堪守汉园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝陵遇雨 其一","author":"区大相","text":"柏寝参玄漠，松区俯泬寥。\n威灵群帝接，风雨百神朝。\n穴地重关阻，升天此路遥。\n攀龙无处所，遗泽下丹霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝陵遇雨 其二","author":"区大相","text":"言避崤陵雨，翻行大壑云。\n微风清树气，积润洗山文。\n银海春波阔，龙池细涧分。\n九陵松柏路，香霭日氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"供事长陵 其一","author":"区大相","text":"文皇鼎成后，此地葬衣冠。\n日月神宫閟，山河帝寝安。\n塞云疑扈跸，关树想回銮。\n寂寞犁庭事，深知创业难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"供事长陵 其二","author":"区大相","text":"弓剑思轩后，山川会禹陵。\n翠旗何日返，龙驭几时升。\n寝殿行春草，幽宫寂夜灯。\n万年关路北，神武至今称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中祀长陵柬同事孙给谏林内翰诸公","author":"区大相","text":"冒雨祠官肃，山园禁漏稀。\n云轻沉穗帐，风细飒灵衣。\n淅沥松阶静，深沉燎火微。\n群公攀望处，入夜有龙归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山陵对雨同孙林二子","author":"区大相","text":"春雨忽成霖，春山不可寻。\n稍孤登陟兴，翻惬卧游心。\n香涧停呦鹿，新波带浴禽。\n看君幽事足，为我弹鸣琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿巩华城王将军宅","author":"区大相","text":"将军躩跞翁，壮岁事从戎。\n枥敝闲嘶骑，尘韬久挂弓。\n笳声来远塞，树影过离宫。\n只为时平久，农谈终夕同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月朔己酉日食","author":"区大相","text":"日月频见食，阴阳春夏更。\n岂应恒失度，无乃暂伤明。\n白昼麒麟斗，青天河汉横。\n何劳问徵应，宵旰是皇情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠关羽客还罗浮","author":"区大相","text":"频夜瑶台梦，君今采药还。\n终须去天上，常见在人间。\n葛令炉边宅，安期海上山。\n暂离亦千岁，记取别时颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝忆故园","author":"区大相","text":"故里花开日，壶觞特地忙。\n朝携东郭饮，暮宴西家庄。\n常恐人事累，兼愁风雨妨。\n如何系簪绂，端坐阅时芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲斋春日","author":"区大相","text":"长啸即山林，閒庭步绿阴。\n落花时有径，流水恨无琴。\n把酒宫莺乱，看云苑树深。\n寄言朝市者，知予大隐心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宗谦老年出塞壮之","author":"区大相","text":"嗟君垂老日，策马蓟门东。\n易酒颜犹壮，燕歌气尚雄。\n敝裘经积雪，颓鬓逐秋蓬。\n寄谢行间客，无轻塞上翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何仪部稚孝谪桂林","author":"区大相","text":"长沙非不远，南去更萧森。\n谪宦楚山尽，独行湘水深。\n乡书同雁少，官舍共猿吟。\n今夕怀人梦，随君到桂林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游满井同林检讨咨伯谭光禄子文","author":"区大相","text":"红亭罗灌木，碧甃泻银塘。\n仰面飞流洒，翻阶瀑水凉。\n居人闲抱瓮，游女竞明妆。\n似得持盈戒，还令机事忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘武库玄子","author":"区大相","text":"楼船横海日，属国护羌年。\n身保命不辱，名高谤愈全。\n乱蝉出深树，独鹤下秋烟。\n长揖去林壑，汝南多昔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苑西楼客至","author":"区大相","text":"小楼仙苑外，芳树碧城隅。\n留客因题竹，闲吟且据梧。\n浊醪过近市，粗饭具中厨。\n谑浪金门隐，风流即我徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汝纶将归南暂往吴门酒后赋此","author":"区大相","text":"万里狂歌客，三年混酒徒。\n掉头金马诏，携手玉人酤。\n夜月拈鹦鹉，春风泣鹧鸪。\n偶然不得意，长啸去游吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕家人宴","author":"区大相","text":"金宫珠树侧，凤阁绣屏东。\n月隐檐边桂，风来井上桐。\n晚凉清枕簟，秋色净房栊。\n楼外谁家妇，停砧思朔鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆山中","author":"区大相","text":"偶忆山中侣，连朝隔采薇。\n竹根棋局冷，松下酒杯稀。\n道路悠悠惯，风尘事事违。\n才微将宦薄，何日不堪归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宗谦至自塞上别归莆","author":"区大相","text":"木兰陂上客，还泛木兰舟。\n芳草还家路，黄榆入塞秋。\n海鸥翔不下，野鹤暮何求。\n莫讶游归晚，山人本姓游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜四家兄至","author":"区大相","text":"远道风和雪，连朝弟忆兄。\n三年此重见，万里独长征。\n翅接云鸿早，枝连苑树荣。\n所期对策后，鹓序拟随行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七舍弟以东明令入觐遂拜徵命 其一","author":"区大相","text":"三年重挹袂，几度各沾裳。\n问子容何减，忧时鬓欲苍。\n赤墀求直谏，青史纪循良。\n无恙图书在，萧然去日装。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七舍弟以东明令入觐遂拜徵命 其二","author":"区大相","text":"凫来丹灶令，凤去紫泥书。\n出宰贤声遍，还朝清问馀。\n鹓鸿班并入，台省席元虚。\n努力期同气，丹诚问玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邓德咸复任上杭","author":"区大相","text":"双凫明日远，斗酒为君倾。\n柳色宫城浅，桃花山县明。\n南人新□□，□□又销兵。\n别后闻为政，春江二月莺。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬少司空沈纯父春日见忆","author":"区大相","text":"同居凤城内，何事阻相期。\n忽枉看花句，翻成伐木诗。\n池光初解冻，莺语渐依枝。\n伫立碧云暮，如何慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经玉河堤上望瀛洲亭 其一","author":"区大相","text":"环岛疑无路，迢迢隔紫氛。\n池分太液水，亭出五城云。\n风静莺迁和，天高鹤散群。\n尘踪不到处，长日有论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经玉河堤上望瀛洲亭 其二","author":"区大相","text":"隔浦望仙瀛，开林接凤城。\n云藏珠玉字，风引佩环声。\n把酒思文友，临池想墨卿。\n盈盈一水隔，谁见有逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏窗月梅影","author":"区大相","text":"窗月照梅花，梅影印窗纱。\n乍恍临风动，谁知逐桂斜。\n美人问镜立，暗忆寄瑶华。\n不是香难掩，潏楼路复赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春送乡人南还","author":"区大相","text":"京华七日酒，岭树百重春。\n终朝念乡土，是日送交亲。\n嗟予久为客，因子访比邻。\n溪上一茅宇，山南松桂新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送大田令张","author":"区大相","text":"行人二月去，雨雪尚春明。\n闻道大田郭，终朝布谷声。\n山晴公事少，溪晚客吟清。\n借问舄凫出，何时车鹭迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送庄得全编修予告还湘川","author":"区大相","text":"春风黄鸟期，春日复多思。\n况当千里别，更作几重悲。\n绿蘋通远意，白芷动芳词。\n离恨樽前在，纷纷看柳丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别山上人房看牡丹","author":"区大相","text":"净土幻名花，春藏大士家。\n药王施法雨，天女散朝霞。\n妙相都无染，空香亦自奢。\n此真色色界，不是竞繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日张家湾舟中即事","author":"区大相","text":"绿树移官舫，清波蘸客衣。\n岁明行处见，采拾望中违。\n汉节新恩是，湘累旧俗非。\n自然爽意惬，纨扇不须挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初发潞河","author":"区大相","text":"舟行才几里，已觉清心魂。\n高岸隐遥郭，平沙出远村。\n鹤行汀有迹，云过水无痕。\n渐喜闻渔榜，程程近故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望月有怀侍御弟","author":"区大相","text":"昨夜西楼月，同欢对凤池。\n今来千里望，复值再圆期。\n思切披帷屡，情多度汉迟。\n乌栖知向府，鹊绕定何枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发卫水","author":"区大相","text":"鸣钲辞北渚，持节下南藩。\n历国方询俗，寻河尚识源。\n津妃歌自远，漕卒晚犹喧。\n行役今如此，羁怀未敢论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中对月","author":"区大相","text":"桂月宜芳夜，兰桡爱晚洲。\n镜随菱水泛，弦逐箭波流。\n岸白非关雪，沙明不辨鸥。\n移家方此夕，谁解有离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次故城谒澹台董子祠","author":"区大相","text":"问俗经遗里，钦贤得并祠。\n知人孔圣叹，策士汉皇私。\n径寂榛从塞，园荒鸟任窥。\n平生守正意，景行必于斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过武城","author":"区大相","text":"言子留遗邑，经过挹素芬。\n林光川上见，城影渡头分。\n政以得人美，官应学道闻。\n弦歌问遗俗，客思坐氛氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏分水","author":"区大相","text":"此水何南北，当由人所为。\n引来元共派，分去必因卑。\n顺逆流中判，盈虚浪乍移。\n从来歧路叹，逝者亦如斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济上酒楼","author":"区大相","text":"我忆任城会，风流贺季真。\n停杯待来客，果得谪仙人。\n万古此风月，千秋成主宾。\n良游不可再，何处访遗尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶到南池旋即登舟同咨伯检讨","author":"区大相","text":"南池好风景，行侣赏心违。\n地静日光薄，亭深花气微。\n鱼知寻藻乐，燕喜傍人飞。\n不见昔游辈，高吟倚棹归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题金山寺","author":"区大相","text":"万古金山寺，烟波四望分。\n对江吴共楚，终日水和云。\n灯影摇鲛室，香烟触雁群。\n最宜禅诵处，船客夜深闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游焦山 其一","author":"区大相","text":"碧岫沧波上，幽人旧隐称。\n云藏三诏洞，林寂四禅僧。\n岸火分京口，江涛接广陵。\n岂徒中泠水，能使客心澄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游焦山 其二","author":"区大相","text":"绀宇写澄瀛，丹台接化城。\n岸形临水断，楼势倚江清。\n潭月窥僧定，风潮杂梵声。\n禅居得清静，况乃事长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒焦君祠","author":"区大相","text":"言乘扬子渡，遂访焦君庐。\n天地一鸿羽，江山几鹤书。\n松阴入洞古，帆影过窗虚。\n因谢区中想，道心闲有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠山泉","author":"区大相","text":"问讯惠山寺，因知第二泉。\n饮冰当夏日，沸雪散炎烟。\n远汲通殊域，分流灌野田。\n何人漱玉齿，细读品茶篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"使过杭州船中七夕","author":"区大相","text":"南国秋砧起，西湖夕泛归。\n桥文依鹊远，槎影入河微。\n粉席连堤幕，针楼动水扉。\n明朝访卜肆，定自识支机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出钱塘门览古作 其一","author":"区大相","text":"驻马钱塘路，逢人说胜游。\n湖光吴苑晚，山色宋陵秋。\n岩桂密连寺，渚花高映楼。\n伤心六桥月，不照汴河洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出钱塘门览古作 其二","author":"区大相","text":"花月迷人去，江山胜事存。\n由来耽乐土，不复问中原。\n歌舞喧南渡，风尘暗北辕。\n祇馀湖上草，岁岁为王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊严滩寄桐庐刘宰","author":"区大相","text":"泠泠此滩水，尚有古人名。\n闻道桐江宰，鸣琴相与清。\n树笼芳霭淡，鸥泛晚波轻。\n俯仰情何限，临流一寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚霁玉峡驿望玉笥山","author":"区大相","text":"峡束江流窄，山欹堞影低。\n玉梁沉宿雾，金涧落晴霓。\n水鸟窥鱼下，林猿摘果啼。\n灵峰不可到，矫首问丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题环山楼","author":"区大相","text":"小楼通四望，面面惟烟霞。\n为爱群峰入，何曾半壁遮。\n翻疑岸岫矮，不觉磴途赊。\n最快清秋目，林林赤似花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自怡园为东君题","author":"区大相","text":"闻学华阳隐，为园取自怡。\n白云难赠客，芳草更遗谁。\n果熟禽来早，花疏蝶去迟。\n祇馀瑶瑟调，犹为美人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘东君招游家园","author":"区大相","text":"卿家好园馆，近郭复经廛。\n云沼野光润，林峦秋气鲜。\n广庭不直达，幽榭或斜穿。\n招我云鸿曲，酬之岩桂篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独游兴教寺","author":"区大相","text":"野寺平郊隐，幽人独骑过。\n旱田秋穫少，近郭晚樵多。\n树动霜摇橘，池荒风捲荷。\n安知花院里，不有病维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝界寺东廊有东坡画竹壁间年久剥落过半其存者笔气如生立玩移时","author":"区大相","text":"画竹僧廊在，尘埃年代深。\n捎檐随笔爽，穿石竞毫森。\n古壁烟云湿，晴天风雨吟。\n山灵亦爱惜，劲直到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自大庾度岭","author":"区大相","text":"肩舆历翠微，马首十年违。\n旧垒仍馀壁，新松又几围。\n林香木犀发，山晚翠禽飞。\n莫问符繻在，关云拥传归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平圃妇 其一","author":"区大相","text":"山途亦自别，恒避使君车。\n蛮结双环出，吴罗半面遮。\n定言长礼族，不必问谁家。\n何似长安道，香车竞狭斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平圃妇 其二","author":"区大相","text":"问俗怜兹朴，观风羡彼姝。\n远嫌兼达礼，薄粉且施朱。\n露叶翠迎鬓，山花红趁襦。\n定知夫婿异，不笑使君愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒张文献祠","author":"区大相","text":"一代孤忠在，千秋大雅存。\n诗才推正始，相业忆开元。\n曝日陈金鉴，蒙尘想剑门。\n更吟羽扇赋，摇夺不堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游清远峡山寺","author":"区大相","text":"香刹住峰头，花宫俯夕流。\n猿吟丹嶂静，鹤坐小松幽。\n片石窥僧榻，归云碍佛楼。\n迟回无不可，乘月上方留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还至胥江顺庆儒懿嘉贞恭慈国诸侄来迎 其一","author":"区大相","text":"八年思见汝，万里暂还人。\n兄弟皆成长，悲欢各自陈。\n山田数亩在，庭桂几枝新。\n闻道竹林宴，依然南阮贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还至胥江顺庆儒懿嘉贞恭慈国诸侄来迎 其二","author":"区大相","text":"远道能怜叔，相将短棹迎。\n书常隔岁至，学有十年成。\n欢剧追儿戏，情多唤小名。\n东山棋局在，或可谢苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还至胥江顺庆儒懿嘉贞恭慈国诸侄来迎 其三","author":"区大相","text":"楚楚几家驹，相迎万里途。\n别时犹稚小，归略具髭须。\n见汝知吾老，逢人笑客迂。\n勋名休借问，终日愧驰驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]