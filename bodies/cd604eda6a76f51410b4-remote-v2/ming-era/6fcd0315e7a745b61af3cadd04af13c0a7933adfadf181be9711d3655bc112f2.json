[{"title":"幽兴 其五","author":"袁登道","text":"仙人骑白鹿，夜卧南山云。\n举手揽月华，步虚声不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其六","author":"袁登道","text":"青鸟何时来，衔书过东海。\n报道瑶草春，三花日堪采。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其七","author":"袁登道","text":"玉露飞松门，秋空桂花发。\n林深寂无人，一犬吠山月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其八","author":"袁登道","text":"幽人隐翠微，不知日云暮。\n手燃金光草，笑指瀛洲路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其九","author":"袁登道","text":"白云净空山，朗月照寒水。\n群动尽无言，如如印元旨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其十","author":"袁登道","text":"山翁蓺长松，却入云深处。\n岁月几何时，虬枝作风雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其十一","author":"袁登道","text":"和舒运双轮，界破红尘路。\n杳杳长征人，劳劳谁与悟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其十二","author":"袁登道","text":"皎日丽春华，繁霜泣秋草。\n谁知寒松树，独向云中老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽兴 其十三","author":"袁登道","text":"我欲将飞龙，遐举陵八荒。\n超忽尘宇外，俯仰复高翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞下曲 其一","author":"袁登道","text":"大风扬尘沙，志士期饮血。\n晓战渡黄河，前旌卷霜雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞下曲 其二","author":"袁登道","text":"将军出金微，夜战交河北。\n一举夺龙城，承恩乃朝食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题笔底烟霞图","author":"袁登道","text":"苍茫元气自无穷，万叠云山一抹中。\n欲识烟霞真骨格，好将消息问鸿蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题山水图","author":"袁登道","text":"苍茫元气浩无垠，似雨如烟各未分。\n却是幽人亲领略，石田笔管自耕耘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山光云影图","author":"袁登道","text":"林壑苍茫宿雾浓，冥濛烟雨翠连空。\n岂知造化难收拾，却入幽人楮素中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烟水云林图","author":"袁登道","text":"淡烟和雨大微茫，造化由来点缀工。\n似与幽人安笔格，好将消息问鸿蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云深飞瀑","author":"袁登道","text":"灵源清寂碧林氛，谁把琼箫弄白云。\n明月满天风露冷，九霄飞下凤凰群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送萧邑博迁琼州教授","author":"邓信","text":"散袖秋风老一株，美人南去有诗无。\n六年相问不相见，梦隔城西晓月孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过陶外翰题其壁","author":"邓信","text":"陶潜今亦圣之清，五柳柴扉近市城。\n秋思满天人欲醉，碧云屏裹一箫声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日象山","author":"郑相","text":"象山九日招携地，万里秋光纵目馀。\n隔寺烟深人语静，背岩寒近菊花初。\n怀贤宇宙情偏迥，忧国江湖鬓未疏。\n莫笑平生閒自放，荜门犹喜读残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别黄一元","author":"郑相","text":"驿路柳新发，春风人远行。\n别怀拈未出，山阁语流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感怀","author":"郑相","text":"西北是吾庐，浮云乍舒卷。\n不见倚门人，空见缀衣线。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萱草","author":"郑相","text":"触目伤神倍怆然，此花曾向北堂妍。\n于今零落无寻处，那得忘忧似昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿黄鸣谷鸣山洞","author":"刘鸣世","text":"山中春日好，好处客尘稀。\n嫩草媚阶绿，流莺绕树飞。\n穿松花落帽，拾蕨雾沾衣。\n不断撩人目，晴烟下翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游圭峰","author":"刘鸣世","text":"风急残钟断，山遥古寺微。\n正堪松树下，卧看晚云飞。\n击石试新茗，弹棋掩竹扉。\n斜阳烟火绝，鸟道一僧归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门怀古","author":"刘鸣世","text":"百战乾坤去已休，夕阳残垒见荒邱。\n潮痕隐隐犹含恨，山色冥冥尚带愁。\n三字狱中亡宝鼎，半閒亭上覆金瓯。\n可堪极目思量处，枫叶芦花两岸秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题飞来寺","author":"刘鸣世","text":"曲曲江流带峡湾，昔人乘此住名山。\n六朝台榭兴亡后，百粤山河指顾间。\n林下鸟啼游客醉，竹边花落老僧閒。\n登临欲上和烟洞，无奈猿声泣玉环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游廓然楼","author":"刘鸣世","text":"石头楼阁倚晴空，飘缈遥峰紫翠重。\n谁挟飞仙三岛去，独留真迹断云封。\n依微雁影迷苍渚，欸乃渔歌起夕舂。\n日落长沙秋色远，扁舟乘兴采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十四夜","author":"刘鸣世","text":"月近中秋夜有辉，幽人恋月卧迟迟。\n及时光景宁须满，明日阴晴未可期。\n清影一帘金琐碎，喨声何处玉参差。\n倚阑无限怀人意，都在庭前桂树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日登圭峰瀑布岩","author":"刘鸣世","text":"此景仙源石洞幽，潺湲岩壑韵悠悠。\n黄花两岸笑人懒，野鸟数声唤客游。\n坡上松涛鸣复隐，林间霜叶坠还留。\n凭高一望天涯阔，万顷江山总是秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"李滨","text":"盛世投閒脱俗嚣，惯来岩畔濯诗瓢。\n清秋雨过层峦合，万壑涛飞匹练飘。\n石室坐忘参上乘，荒碑重洗认前朝。\n采奇直欲穷天际，回首峰头月色骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏新辟邑城","author":"严万宁","text":"无数盘蛮据虎穴，一朝时雨净神皋。\n帷筹已借留侯箸，版筑仍烦山甫劳。\n身畔长随惟一鹤，庭前旋种几株桃。\n如今百里同鸡犬，岭上锄云到月高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠幕史粹公罢政归钓鳌台","author":"王重师","text":"秋风吹动越江蘋，鳌海初归解绶人。\n十载已承丹阙宠，一竿闲与白鸥邻。\n宦途久历怜腰折，烟水长耽乐性真。\n况有亭台遗址在，不妨萧散谢红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠幕史粹公罢政归钓鳌台","author":"王炼","text":"几载金华宦业成，晚归鳌海钓舟轻。\n漫思鲈鲙间投饵，每笑羊裘浪得名。\n半柱白云春昼永，一竿明月夜潮生。\n同游喜有老太仆，日向沧浪共濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠幕史粹公罢政归钓鳌台","author":"王纥","text":"衣冠盛世正堪期，底事南归倚钓矶。\n风暖池亭春酒熟，秋清溪月晚鲈肥。\n身闲鳌海重开径，化洽乌城不闭扉。\n回首渺微天万里，清辉夜夜绕皇畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠幕史粹公罢政归钓鳌台","author":"王谕箴","text":"声誉遥遥表缙绅，几年东浙鹤随人。\n政归径植陶潜菊，身隐腰宽学士银。\n丛桂静看秋夜月，一竿闲弄碧江春。\n独怜吴越苍生眼，日日鳌台望钓轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠幕史粹公罢政归钓鳌台","author":"王极","text":"千古何人耻据鞍，宦情时作碧山看。\n壮怀报国频开幕，勇退惊人早挂冠。\n丛桂宴开春酒绿，薜萝月上钓台寒。\n溪头剩有桃花发，只恐渔翁卧未安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠幕史粹公罢政归钓鳌台","author":"王伴","text":"勘破浮名便洁身，拂衣归作钓鳌人。\n时招鸥鹭为三友，日傍烟波作四邻。\n奔走已忘燕郢路，恩波犹恋义乌人。\n收纶晚枕江亭月，赢得寒光照梦新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠幕史粹公罢政归钓鳌台","author":"王尧典","text":"十载衣冠一老臣，归来踪迹寄江滨。\n藏真渔酒堪乘兴，飘泊羊裘好结邻。\n南粤烟霞随藿艇，金华勋业付丝纶。\n六鳌此日知能绍，沧海谁怜理钓人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘泉井","author":"李林蓁","text":"千山烟树万山菁，泉冽潺湲弭客旌。\n已觉玄霜开玉液，却疑仙掌坠金茎。\n云凝鸟道连峰碧，石咽龙津彻底清。\n执杓不妨频满腹，汉家久矣渴长卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟行有感","author":"张彦修","text":"击棹东行恨转赊，江流徒自促年华。\n因思戎马征随急，减却沧州几钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀旧","author":"张彦修","text":"百年天地德何孤，洗却尘心半点无。\n几上仲宣楼外望，落霞飞处坠金乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵道中和海侄","author":"张洙","text":"樵山屹立看，巨镇难寻尺。\n峭峭插天峰，巉巉卧云石。\n青壁若开屏，丹崖犹列戟。\n高登绝顶中，一抹长空白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀旧","author":"张洙","text":"忆昔与君游，两两飞仙步。\n长袖挹风清，短钑////履月素。\n夜半始归来，溪边频呼渡。\n万籁寂空山，古木浓零露。\n窈窕踏歌行，错落群星布。\n如何今日游，寂寞空归路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题魁岩","author":"龙溪冯氏","text":"胜形开太古，灵养得魁岩。\n自是两仪里，风长日月函。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题肤功雅奏图","author":"邓桢","text":"和鸾望阙复临边，夹道人看气倍前。\n素鞸已终风木恨，黄麻亲向穸原宣。\n枢星影近台三象，卿月光摇尺五天。\n特简遄从归沐日，对扬恰值建元年。\n冠加廌角峨应甚，赐有龙文许自专。\n借箸独当天下计，折冲随运掌中权。\n黑衣岂直朝来补，朱帝繇兹世共联。\n身历四朝元未老，城如万里信加坚。\n可知横草无如此，见说分茒即在焉。\n勒石祇堪标懿绩，具瞻还为表淩烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平黎婺山赠庄参戎","author":"阙名","text":"登坛今日论谁雄，迅扫彝氛樽俎中。\n铜柱孤悬烟瘴外，金章新拜玺书隆。\n春回雾岭千家雨，剑倚炎方万谷风。\n更筑睥睨天堑固，燕然勒石颂元功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张公洞","author":"阙名","text":"张公婴世网，久抱烟霞致。\n兹焉远于役，登探始快意。\n晨邀二三子，振策戒徒隶。\n搜奇历榛莽，揽胜穷幽邃。\n言指灵洞游，贾勇各将事。\n于铄我皇明，奇甸标玉旨。\n卓彼称先觉，文庄昌其委。\n后来更数公，济济嗣英轨。\n寥落百馀年，于今无乃是。\n尝闻岳降神，申甫同一揆。\n元运有代谢，考时则可矣。\n谓予言无徵，请质东坡氏。\n金鸡第一星，文笔无双士。\n兹言谁与归，徵应当在此。\n主人顾予笑，子言良有以。\n作者非人一，吾生愧衰鄙。\n置此且勿谈，努力前修企。\n庶几异代名，或与兹峰比。\n语毕发长啸，何物终不毁。\n磨崖各大书，乾坤吾与尔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题司傅野选君万玉山房卷","author":"阙名","text":"名园修竹自檀栾，劲节千竿傍药栏。\n疏影月中摇委佩，轻音云际响琅玕。\n纡回似向潇湘绕，杳霭疑从兔苑看。\n敢对此君犹问主，玉山清彻照人寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏落花和魏季郎黄公绍邓希父蒋兆卿","author":"阙名","text":"惜春长自坐春晖，谁道春光处处非。\n妒雨暗催蜂使去，狂风空逐麝香微。\n辞条尚作莺莺舞，落絮还同燕燕飞。\n争似绛桃园里色，留花不发待郎归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨肖韩计郭谪判两淮","author":"阙名","text":"才高鹦鹉占时流，官领均输出帝州。\n丛桂正含淮海色，明珠谁抱汉宫愁。\n人间得失蕉中鹿，宦底浮沉水上鸥。\n盐铁且从文学议，大鹏终计碧霄游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南山","author":"邓允燧","text":"列巘争奇出，胜形羡此山。\n东流千涧汇，南望一屏环。\n雄作江城镇，初分岭海关。\n峰头凝紫气，支策愿跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"碧落洞","author":"邓允燧","text":"巨灵一擘洞天开，古迹磨崖次第裁。\n石乳乘帘悬画景，山空浮盖倒琼台。\n遇仙室近消应息，望气岩高往自回。\n且借清泉供吐纳，机忘是处有蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃溪书院 其一","author":"邓允燧","text":"寻幽郊外到桃溪，翠荻垂萝景物齐。\n瀛海有人摇采笔，气吞云梦跨虹霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃溪书院 其二","author":"邓允燧","text":"洞口桃花下碧池，淩云赋就及当时。\n甘棠仰止垂高荫，文运新兴政在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃溪书院 其三","author":"邓允燧","text":"胜地桃溪敞陌头，南山佳气蔼亭楼。\n风传竹韵笙簧奏，波漾霞光锦绣浮。\n豹变泽文看紫雾，仙才丛桂想千秋。\n地灵自是人多杰，蹊下芳名万古留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴那题壁","author":"钟士楚","text":"潘僧坐化已千年，洞口云封隔世缘。\n曲径通幽留鹤迹，石桥流水似龙涎。\n参禅翠柏老栖鹘，学语胡孙下种田。\n五指峰头饶独坐，拈将花片问天先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"相公邮亭","author":"钟士楚","text":"樵歌牧唱几欢喧，尽道名臣昔驻轩。\n剑阁雨铃悲蜀道，曲江风度忆开元。\n幽亭芳草人千古，白日重阳酒一樽。\n金镜当年曾上录，至今遗照遍乡村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳题石","author":"黎邦瑊","text":"坟前花落锦成茵，红粉何当化作尘。\n剩有清词遗乐府，尚留香骨恼情人。\n风吹蒿里宣灵籁，月印芳池误幻身。\n最是杜鹃多怨绪，年年啼血过残春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留石堂诗为严太守赋","author":"黎邦瑊","text":"蜚英甲第冠中朝，仙署声华动赤霄。\n万里旌麾临上郡，三城人士景高标。\n西京治行今重睹，南海珍奇无所取。\n群石飞来五马堂，云根列作中流柱。\n千秋劲节恰同坚，一片贞心好并悬。\n白雪调高诚确矣，朱弦韵远总铿然。\n依稀九曜难分色，仿佛三山如可即。\n鼎力还应鞭巨灵，请看重补天西北。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"黎邦瑊","text":"鹊桥惟此夕，灵境信奇哉。\n天上双星度，人间绣阁开。\n秋风下桐叶，夜雨湿莓苔。\n为问乘槎者，仙源几日回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"路出黄梅荷香十里因赋","author":"黎邦瑊","text":"芰荷缭绕碧池傍，客路如披楚泽裳。\n仿佛汉宫迷粉黛，依稀秦沼斗鸳鸯。\n和烟浥露千茎发，照水含霞一样妆。\n寄语若耶溪畔女，閒情须向此搴芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过勾漏洞","author":"黎邦瑊","text":"石室嶙峋径路遥，壶中灯火纪前朝。\n碧云迟客题秋叶，明月留人听洞萧。\n玄狖偷丹今不死，黄精出地尚堪樵。\n仙郎一去浑无迹，岂是当年厌折腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何象冈相国招饮胜好亭限韵","author":"黎邦瑊","text":"高高亭子敞晴岚，胜日跻攀乐事耽。\n地接风云非塞上，山分大小似淮南。\n桃花乍映珊瑚盏，春色偏寒玳瑁簪。\n共道谢公声妓好，不妨留听缓归骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梵刹晨钟","author":"黎邦瑊","text":"古刹逼云端，疏钟彻林早。\n缓步到禅栖，落花僧未扫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风门仙迹","author":"黎邦瑊","text":"仙驭淩风去，岩花空自芳。\n至今池水上，仿佛隐红妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙潭灵应","author":"黎邦瑊","text":"寒潭深不测，白昼吼风雷。\n欲就为霖意，天门点额回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪返照","author":"黎邦瑊","text":"灵景当花县，霞光夕夕环。\n昔传鹧鸪岭，今为双凤山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云台捧日","author":"黎邦瑊","text":"达曙彤云晓，高台散积阴。\n海隅天万里，犹自捧丹心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五指凌云","author":"黎邦瑊","text":"玉笋淩空出，参差翠霭多。\n还承天上露，入夜浣星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百丈飞泉","author":"黎邦瑊","text":"寒泉喷雪飞，晴空自风雨。\n客来濯尘襟，觅得庄生句。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]