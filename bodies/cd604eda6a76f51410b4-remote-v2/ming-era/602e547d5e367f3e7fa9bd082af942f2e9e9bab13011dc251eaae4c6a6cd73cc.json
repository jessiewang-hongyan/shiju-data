[{"title":"别众父老","author":"卢龙云","text":"宦情萧索与谁论，直道斯民喜尚存。\n岂有循良堪作传，谩劳苍赤苦攀辕。\n暗投已分无完璧，广照何由到覆盆。\n底事慇勤酬别绪，愿祈丰岁惠元元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓真州僧舍夜梦登恒山志感","author":"卢龙云","text":"单车几度涉滹沱，此日重来感慨多。\n回首不堪时事改，低眉祇傍畏途过。\n尘纷暂远宜僧话，酒禁初宽足浩歌。\n一梦恒山秋色远，芙蓉千叠奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒别吕翁祠","author":"卢龙云","text":"南北支离叹此身，相逢俱是梦中人。\n久知鸟道多危辙，曾见盐车解绝尘。\n社酒尚违元亮菊，秋风又美季鹰莼。\n滔滔骑从群游客，莫笑卢生梦未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠苏羽士","author":"卢龙云","text":"城郭何人识隐沦，黄冠绿发一閒身。\n早从相鹤仙群侣，更许笼鹅墨客亲。\n宅以谈玄誇胜事，室同虚白净纤尘。\n刘郎别后知何处，空记桃花满院春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓清源诸乡友携具过访","author":"卢龙云","text":"萧索西风独倚楼，殊方落日正悲秋。\n忽逢杯酌成嘉会，似为风尘慰倦游。\n一醉浑忘身是客，微名真与世同浮。\n相酬不尽乡园意，徙倚堪消万斛愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊","author":"卢龙云","text":"久淹末路秋多思，尚喜东篱菊有花。\n杯酒未曾输蒋径，诗篇犹自拟陶家。\n休悲摇落霜逾峻，独对幽香日未斜。\n不是岁寒徵晚节，却教桃李尽年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得从兄伟侯书却寄","author":"卢龙云","text":"书至遥怜汝尚存，几回飞梦绕乡园。\n风涛已恨惊蓬鬓，泉石何妨老席门。\n海上碧云悬故里，天涯芳草倦王孙。\n可能扫石溪头坐，往事同君仔细论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜泛舟","author":"卢龙云","text":"携壶理棹出江干，乘兴安流夜未阑。\n霜月浸空秋色老，风林摇岸叶声乾。\n短箫凄断中川听，长剑凭陵傍斗看。\n坐久黑貂寒渐彻，诗成还仗酒杯宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慰同寓者思归","author":"卢龙云","text":"长风万里困南图，游子天涯望眼枯。\n愧我出山成小草，怜君远道忆文芜。\n清江渡口听鸿雁，明月楼中唱鹧鸪。\n稍待青春堪作伴，何须雨雪问征途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送内弟体健南回","author":"卢龙云","text":"几回愁望雁南征，雪里何当复送行。\n投辖总难宽别绪，歌骊徒自切归情。\n渐看客散堪罗雀，谁及春来共听莺。\n兄弟故园如有问，十年不愧旧书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自清源入京","author":"卢龙云","text":"长途匹马又朝天，曾记驱车入赵年。\n惨淡风霜欺旅鬓，萧条山水傍孤弦。\n流言促驾成三仕，拙宦何阶待九迁。\n堪笑几回霄汉上，为他人望已登仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至日宿河间客舍","author":"卢龙云","text":"年年至日愁为客，此夕愁怀倍不舒。\n失路未论先策足，征途翻自怅离居。\n五更清梦随天阙，一点丹心到玉除。\n最恨邻鸡催晓曙，暗尘旋复满巾车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京中贻诸游好二首 其一","author":"卢龙云","text":"千里驱车又帝城，相看悲喜不胜情。\n旅颜尚带风涛色，生计重依日月明。\n且共狂歌燕市饮，休嗟故步寿陵行。\n当年志意飞扬甚，此夕还应剑气横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京中贻诸游好二首 其二","author":"卢龙云","text":"九陌红尘上玉珂，不妨文酒借烟萝。\n谈天气压青云壮，待月词雄白雪多。\n万里风霜驱傲骨，重来霄汉入悲歌。\n应刘此日公车满，轮囷无因奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何进士令嘉兴","author":"卢龙云","text":"吴越山川足胜游，喜君仗剑出皇州。\n阳回蓟北催征骑，春在江南舣客舟。\n民力总应宽保障，主恩有待借前筹。\n请看此日朝阳凤，棘地何能更复留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮杨贞复太史宅遇雪","author":"卢龙云","text":"白玉堂前满六花，天然色相斗瑶华。\n兴来不假山阴棹，坐久频煎学士茶。\n鳷鹊影分光入户，鹔鹴寒仗醉为家。\n罗浮一别无消息，忆共看梅到海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨肖韩民部谪陜州","author":"卢龙云","text":"执戟曾疲阙下班，那堪世路复多艰。\n流言尽属杯中影，同病俱怜镜里颜。\n二室莺花供客赏，五陵衣马待君还。\n周南岂必嗟留滞，逸驾长途未可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王孝廉奔讣还柳州","author":"卢龙云","text":"长年旅食傍金台，意气看君亦壮哉。\n岂以浪游忘寸草，祇缘先泽在三槐。\n云边泪眼天无极，雪里愁肠日几回。\n归去蓼莪应暂废，公车还待尔重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昼锦四荣诗为举主大司寇张公作加宫保","author":"卢龙云","text":"华发天书喜屡褒，乞归仍录旧臣劳。\n一时礼秩隆三少，二省恩光冠六曹。\n北斗声华悬郑履，上公休瑞应虔刀。\n已闻侧席思贤硕，须信东山卧未高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赐飞鱼服","author":"卢龙云","text":"都门争御衮衣频，又见中朝锡服新。\n光夺彩云摇剑佩，喜传丹陛动簪绅。\n尚方箧笥优承诏，五色文章稳称身。\n明到集贤欢昼锦，白衣谁道是山人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赐金","author":"卢龙云","text":"诏许辞荣访逸林，更于蕃赉识皇心。\n非缘绿野光亭榭，便与香山助醉吟。\n清德久传杨氏里，湛恩宁比陆生金。\n相携宾旧多欢洽，总沐天朝惠予深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赐驰驿","author":"卢龙云","text":"一自东都祖二疏，抗章谁复早悬车。\n寒辞蓟苑荣休沐，春望丛台赋遂初。\n乘传遍临先赐履，拥旄遥爱旧吾庐。\n祇怜负弩非前令，目极洺关一怆予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都门僧舍答黄汝纶岁暮述怀之作","author":"卢龙云","text":"相逢衣袂满缁尘，总是天涯一旅人。\n幸舍岂孤弹铗客，玄林空笑宰官身。\n吟馀白雪年垂暮，颂入青阳岁又新。\n即道淹留家万里，可能虚度帝城春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日汝纶过访留酌","author":"卢龙云","text":"东风随岁入长安，万户春光纵眼宽。\n幸与人同今日胜，更留君叙隔年欢。\n菜羹旅食堪循俗，柏酒馀杯解送寒。\n忽向江湖怜杜老，私忧直道路行难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与林孝廉小酌论旧并柬诸乡友","author":"卢龙云","text":"乡书十载忝齐贤，何意看花一日先。\n弱羽翻疑淹九万，彩毫终待奏三千。\n陵阳泪尽方呈璞，流水音高未绝弦。\n为问同来燕市客，有谁还愧在卢前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林志和明府过谈旅舍","author":"卢龙云","text":"马首当年忆并东，从前消息半相同。\n重来大集明堂吏，一笑谁怜塞上翁。\n百里多君工制锦，孤臣何地托飘蓬。\n亦知双剑时还合，未若延津气似虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别上计诸子","author":"卢龙云","text":"都门二月送征轮，冰雪寒消暖渐新。\n柳眼暗窥今日酒，花神潜动去年春。\n明堂礼就应增秩，独客愁多畏傍人。\n怪得望穷仙舄远，尚留衣袂满京尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何参军之衡阳","author":"卢龙云","text":"十年清誉美何郎，此日承恩出建章。\n细柳繁烟开梦泽，绿蘋疏雨渡潇湘。\n自缘簪组光莲幕，更喜风云傍梓乡。\n公暇尺书如有念，可因回雁寄衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日登毗卢阁","author":"卢龙云","text":"燕山胜事在青阳，与客乘閒叩上方。\n风转法云空外度，天开化日望中长。\n红尘端不侵莲界，紫气偏能入羽觞。\n宦海只今多自苦，欲移般若作慈航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答徐太学","author":"卢龙云","text":"握手他乡各问年，敝裘羸马总萧然。\n尊如北海宾长集，榻有南州士独贤。\n去就此时难任性，升沈末路只由天。\n汉朝故事须公等，诣阙书成合四迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别袁敬德","author":"卢龙云","text":"千树桃花去后栽，玄都何日更重来。\n黄金笑我非奇骨，綵笔怜君自逸才。\n易水馀寒侵别骑，阳关新绿照行杯。\n漂零剑气何由合，望极龙光烛上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱使君惠茶","author":"卢龙云","text":"春早仙芽出洞天，清泠堪试惠山泉。\n年年采撷占雷候，片片鎗旗爱雨前。\n一院真香烹野服，几杯沉困破愁眠。\n月团谏议恩元渥，祇阅斜封愧玉川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王郡丞有赠未答旋复惠酒并谢","author":"卢龙云","text":"驱车前后出金台，天末萍踪并傥来。\n官冷未应徒伏枕，公馀差可慰衔杯。\n亭因好事相携酒，我亦怀人姑酌罍。\n莫怪诗情太寥寂，苦无头上雨云催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其一 霸台朝阳","author":"卢龙云","text":"先朝遗胜有高台，晓日登临霁色开。\n望似泰山标日观，气如沧海射蓬莱。\n五云彩彻层霄迥，万里辉腾八极回。\n任是阳光能被远，苍凉先向此中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其二 老堤晚渡","author":"卢龙云","text":"郡城南接大堤游，日晚人归古渡头。\n家傍寒塘鱼作市，门临荒渚鹜为洲。\n夕阳舟楫频来往，野水乾坤任拍浮。\n景色不须愁已暮，月明还照荻花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其三 环城烟柳","author":"卢龙云","text":"郊原烟雨递相催，柳色微茫拂翠来。\n林际迁莺如上苑，街前走马类章台。\n栽移彭泽诗千首，折向阳关酒一杯。\n造物固知饶近地，春光漏泄遍城隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其四 堂淀风荷","author":"卢龙云","text":"东南凝望尽湖光，冉冉红蕖十里芳。\n渌水明霞娇欲语，白蘋过雨暗生香。\n吴娃曲调堪移舫，楚客衣裳好纳凉。\n似道今人俱解爱，淩波争艳水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其五 岳庙波光","author":"卢龙云","text":"崇祠寂寂出中阿，新涨环门有白波。\n草绿似因蓬作岛，天光疑用镜降魔。\n堂前说法龙堪绕，台上翻经鸟屡过。\n闻道泰云时挟雨，故添沧水濯盘涡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其六 觐光山色","author":"卢龙云","text":"城上高楼俯樾丛，山光隐映画图中。\n总无竞秀千岩逼，却有寻芳一径通。\n天入中原形具美，地临三辅势偏雄。\n郁盘灵淑知无尽，长为皇家壮镐丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其七 盐河春鸟","author":"卢龙云","text":"东风几日满城陬，冰雪凝寒已渐收。\n漠漠水云春自足，飞飞林泽鸟相求。\n即看市近机仍狎，何必山深景更幽。\n翔集总缘天性在，偶来觞咏亦沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"益津八景 其八 苑口秋涛","author":"卢龙云","text":"一线江流引急湍，奔腾长作劲潮看。\n九河瓴势浮空下，八月涛声杂雨寒。\n自是百川能学海，岂无砥柱善回澜。\n千年疏凿功思禹，咫尺沧溟大壑宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山斗图为掌院李公赋","author":"卢龙云","text":"早年芳誉彻丹霄，此日中台凛百僚。\n总为霜棱推独坐，更缘风采重三朝。\n登龙故溢名贤礼，旋马堪同圣相谣。\n伫望黄扉资燮理，八荒何地不春韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜雨","author":"卢龙云","text":"新瀑穿林出岸隈，雄风吹雨歇还来。\n霏微四野枯全润，霢霂三农望正开。\n昨日桑林成泽国，一时蓬巷已春台。\n不知旱魃归何处，更祝为霖遍八垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司马王公席上对月","author":"卢龙云","text":"待月庭阶月正圆，中天云净出婵娟。\n金波泛露辉长夜，玉宇生凉到四筵。\n七十主人方健饭，二三宾客尽忘年。\n高谈洛下应难数，会有安车自日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻岛夷犯朝鲜时西贼未平而朝鲜遣使告急不绝于道","author":"卢龙云","text":"二载宵衣正备胡，却传海上又鸣桴。\n一时斥堠多烽火，到处闾阎困转输。\n使者徵兵催草檄，藩邦乞援望衔舻。\n神州敢谓天将厌，干羽还能格后夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送薛德茂自文安应召入京","author":"卢龙云","text":"分符元傍五云乡，第一徵书荷圣王。\n日转觚棱腾凤羽，天开阊阖望龙光。\n硎新百鍊青萍壮，台重千金紫燕良。\n此日送君增感慨，揶揄花外笑偏狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和车一中七夕旅怀","author":"卢龙云","text":"华月娟娟入户明，开帘露下气初清。\n我惭儿女年年巧，君念关山处处情。\n天上独怜桥鹊影，人间无奈砌蛩声。\n罗浮一水非河汉，莫向牵牛恨未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同一中夜集慈华寺","author":"卢龙云","text":"南北飘零寡所欢，驱驰空自愧微官。\n秋风念旧鲈鱼脍，夜雨怜君苜蓿盘。\n客路相逢乡语熟，禅房深坐漏声寒。\n何时得共罗浮月，松露潇潇洒鹖冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十五夜王观察招饮狎鸥亭月色无几雷雨继至感而成咏","author":"卢龙云","text":"西园清夜忝嘉招，尊酒论文乐正饶。\n月魄何缘光乍掩，雨师疑亦妒难销。\n高谈列炬林鸦散，客思停觞旅雁遥。\n稍待风生云雾歛，一轮还自出层霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和大司马王公同钱使君月下园池泛舟之作二首 其一","author":"卢龙云","text":"辞荣十载惬投簪，其奈苍生属望心。\n庭下郎君能世业，座中宾客总词林。\n忘年许集耆英会，得句如闻正始音。\n况是大夫能作赋，胜游应不负招寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和大司马王公同钱使君月下园池泛舟之作二首 其二","author":"卢龙云","text":"水满池塘月满舟，芳亭难遽号宜休。\n且拚乐事归三径，自以閒身傲五侯。\n别墅开樽时坐啸，西园飞盖每淹留。\n已闻疏辅虚前席，此地何能绊绛驺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜杜工部凝香亭宴集时周太学兆通自吴下新至","author":"卢龙云","text":"杜曲穿花此会难，深尊谁与罄交欢。\n饮醇自昔知公瑾，命驾于今似吕安。\n入夜霜高闻朔雁，一时星聚对南冠。\n劝君且莫歌长铗，客里茱萸好共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登霸台时月落西方倒映台榭倚楼数酌而别","author":"卢龙云","text":"风雨连朝欲满城，今宵喜见月华明。\n半轮影动登高兴，万里光馀落帽情。\n两地茱萸分客思，几家砧杵乱秋声。\n酒酣莫更归来缓，怕遣楼头百感生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬送杜虞部入京","author":"卢龙云","text":"过里衣冠喜乍逢，尊前谈笑几相从。\n谢家池草多康乐，阮氏竹林有仲容。\n白下歌棠非宦巧，班生行李自仙踪。\n中朝若遇询卑湿，天气长沙赖已冬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永清境上遇张孝廉夜酌","author":"卢龙云","text":"谪宦何知复买邻，一时倾盖偶相亲。\n南州愧我非高士，东道逢君识主人。\n径拥蓬蒿怜仲蔚，辖投宾从美陈遵。\n追欢正合持螯醉，况喜当筵月色新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过张孝廉与张太学贾刘二茂才同集","author":"卢龙云","text":"扁舟容与水云乡，弭棹重逢有二张。\n狎坐更应推贾垒，高谈谁复短刘墙。\n黄催落叶羁愁晚，绿泼新醅旅兴长。\n闻说上林将献赋，声华久矣达明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄卢唐宪明府时起复至都下","author":"卢龙云","text":"回首尘途忆聚星，春风棠杏满龙城。\n交游本是同声侣，骨肉元非异姓兄。\n南望总愁云远去，北来犹怯路难行。\n岁寒莫道冰霜久，已见阳和次第生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王存初大行四首有引 其一","author":"卢龙云","text":"汉家嗣业有玄成，倾盖何如止慕荆。\n洛社漫开真率会，瀛洲初重斗山名。\n江湖尚识先忧在，云水聊教俗虑清。\n况是圣朝思宪老，几回侧席不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王存初大行四首有引 其二","author":"卢龙云","text":"背郭涟漪漾碧塘，雨馀新绿上茅堂。\n芙蕖拂艳依秋水，鸥鹭忘机狎野航。\n谢俗固多难老诀，羁人亦有却愁方。\n曾同飞盖沾清露，月色溶溶过海棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王存初大行四首有引 其三","author":"卢龙云","text":"龙卧当年忆滞淫，草庐曾自托悲吟。\n连城岂合终怀璞，流水多应会赏音。\n帝里风光淹彩笔，家庭乐事寄瑶琴。\n飞来一片云间月，照见游人此夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王存初大行四首有引 其四","author":"卢龙云","text":"艺苑何人最白眉，风前闻尔奏朱丝。\n敢云黄牡皆骊牝，直看飞雄愧伏雌。\n海上烽烟思赋槊，眼中景物类观棋。\n知君使节乘春下，花信先传梦草池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答徐内翰见讯","author":"卢龙云","text":"早春曾记傍金台，花下逢君识异才。\n恩并三朝殊赉渥，班联四辅近颜开。\n紫宫籍府连东璧，彩笔词垣切上台。\n清暇子虚如有问，可能促席慰衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]