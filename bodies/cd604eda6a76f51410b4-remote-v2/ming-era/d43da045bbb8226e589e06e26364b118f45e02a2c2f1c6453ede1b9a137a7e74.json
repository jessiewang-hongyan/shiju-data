[{"title":"烈妇祠雷人夫妇佣于新会，主人谋害其夫，沉之于江，尸浮逆流而上，妇见之痛哭，抱幼子同死。三尸浮至门，推去复来，事觉伏诛","author":"钟芳","text":"红颜不共春争媚，慨叹仳离稔祸胎。\n一死甘随流水去，三魂同结怒潮来。\n时乖身陷豺狼窟，天定名扬御史台。\n若并忠良评义烈，厓门相望不胜哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陈高吾生孙韵","author":"钟芳","text":"兰芽忽迸一枝新，可是前生在比邻。\n半百有孙曾谓晚，十千行酒故应频。\n代传相种元非偶，形肖阿翁定逼真。\n每爱将雏歌旧曲，春风瑶瑟夜相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄以和分教南平","author":"钟芳","text":"潮头带雨泊江城，宦况儒风一色清。\n人自天涯瞻日表，道传东鲁下南平。\n出门剑气乘时耀，在簴钟声待扣鸣。\n未问去留皆是客，共看秋水不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赏莲 其一","author":"钟芳","text":"荷影池光漾碧天，误疑西子浴平川。\n向人欲语笑声里，出水半攲樽酒前。\n戏奕枯棋忘胜算，坐依丛竹序生年。\n频来未厌观游兴，祇惜斜晖隔暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赏莲 其二","author":"钟芳","text":"渚蒲汀柳散薰风，六月新莲学吐红。\n并舞霓棠相伯仲，似怀萍梗自西东。\n亭开四面青山应，沼别三区碧水通。\n抚景乘闲须尽醉，莫缘毫末叹亡弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和紫薇楼韵","author":"钟芳","text":"森森岑阁倚高秋，省署乘闲独上楼。\n禹迹而今归大统，王生何用忆荆州。\n郊晴云敛千峰出，江晚波恬一艇浮。\n封境年来幸无事，具臣犹抱杞人忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊子十一月朔冬至次仪真","author":"钟芳","text":"长至曾闻晷影添，瑞香霄喷掩朱帘。\n心依宸极朝元客，暖似阳春数九天。\n潮长邗沟千艇入，鼓严官坝万灯悬。\n寒温自是江南别，上谷而今恐未然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺胡方伯","author":"钟芳","text":"昔曾联步上金台，五色云中御幄开。\n就列共闻天语近，散朝时逐相臣回。\n十年中外冰霜操，万仞东南屏翰才。\n官与君同分两地，却输吴越是蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代送胡南津","author":"钟芳","text":"三十年前宴鹿鸣，数千里外重寻盟。\n松筠并植元同操，霄汉联飞更有情。\n旆绕章干分野色，望依庐阜忆高名。\n薇垣底足廑良翰，咫尺庭阶即玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"筠州览景","author":"钟芳","text":"乘轩六月到筠州，蜀锦横江日夜流。\n烟火两涯夹城市，禾苗万顷翳田畴。\n时清已靖华林变，官正能分衮黼忧。\n老我服勤成底事，海天寥泬重回头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕王阁","author":"钟芳","text":"日斜高阁一登临，槛外轻岚叠翠岑。\n萍水渺然忘客主，寒温无定系晴阴。\n苞桑万邑番君泽，介石千年孺子心。\n景入琼觞人共醉，江空天阔起豪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出瑞河","author":"钟芳","text":"晓发筠州向市汊，双旌飞拂溯风斜。\n旱苗得雨易为好，游蝶过时仍采花。\n云结幻形添晚兴，树交疏影见人家。\n江藩又作三年梦，独对寒川咏物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺左都姚公寿七十","author":"钟芳","text":"行藏无意信苍穹，阅世今为鹤发翁。\n朔雪炎风鞭策地，文经武略范围中。\n丰培兰桂书千轴，远谢尘氛月一筇。\n我昔参藩叨任使，短歌聊赞寿筵红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至郊斋次少宰李公韵 其一","author":"钟芳","text":"早承天语戒斋期，共竭精虔对越时。\n帝飨定缘三礼正，律谐喜见八风夷。\n道随阳长思连茹，兴为诗催惯撚髭。\n何必风花堪玩弄，太音玄酒足清脾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至郊斋次少宰李公韵 其二","author":"钟芳","text":"日临长至日增长，再见郊禋出正阳。\n垂范岂惟周百世，圣衷端配古三皇。\n瑶空龙凤来神驭，宝鼎菥檀袭御裳。\n昨夜清台占瑞应，前星烨烨兆休祥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同年饮中丞恒山宅次符卿泾野韵 其一","author":"钟芳","text":"玄冬万木捲风沙，瓶菊犹存种种花。\n一段暗香留夕宴，几分红艳抹秋霞。\n最怜晚节老还劲，似入醉乡疏更斜。\n荒径有怀魂蝶乱，夜深和月到天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同年饮中丞恒山宅次符卿泾野韵 其二","author":"钟芳","text":"浮踪偶聚若抟沙，倚遍文轩叹落花。\n雪后金英看素节，瓮头春色写丹霞。\n令严掷采飞觥急，壶校翻翎著箭斜。\n饮罢出门人语静，霜天廖廓思无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次久庵黄宗伯韵","author":"钟芳","text":"南国江山翠可怜，与君登眺意忘年。\n同心每恨论交晚，蹇足谁云得步先。\n两浙衣冠称世族，五更魂梦接英贤。\n兰桡风便天南北，何处重逢共折旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次严宗伯介溪公韵题御书楼 其一","author":"钟芳","text":"钤山楼阁东南胜，十袭缃纨贮御书。\n恩戴丘峦千仞表，价增琼玖万钧馀。\n典谟奥义垂名教，琬琰祥光谢太虚。\n却忆南阳龙卧日，辛勤诵读力菑畲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次严宗伯介溪公韵题御书楼 其二","author":"钟芳","text":"三朝法从旧词臣，璀灿天章宠锡频。\n函锦数重还自爱，籯金万镒底须珍。\n义方共羡诒谋远，旨授钦承御幄亲。\n清夜焚香效嵩祝，此生何幸际熙辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿太守易士美","author":"钟芳","text":"昔年曾共玉京游，邂逅雷阳信宿留。\n寇竹裁蕃遗爱在，菟裘归老宦情休。\n青冥黄鹄谁能弋，水局山屏尽自由。\n七十周星初度合，从头重看碧湖秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚上舍良知归武康","author":"钟芳","text":"昔年校士苕湖上，羡子多才冠誉髦。\n大学春深时雨洽，归航冬晚朔风高。\n凤飞拟见翀千仞，鹤唳何曾限九皋。\n显隐由来非两事，好培嘉谷刈蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送万治斋都宪","author":"钟芳","text":"巨浸难将一苇杭，且抛簪绂振游缰。\n乌台数仞风霜老，皇祚千春日月长。\n卞璞未雕难必售，楚弓暂韠岂云亡。\n世承恩渥君家盛，咫尺天颜肯暂忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮半窗罗宪副宅限韵咏兰","author":"钟芳","text":"疏英春满翠云庄，清露猗猗静晚香。\n一任燕游谐色笑，不将秾艳斗寻常。\n骚人赋在思纫佩，尼父琴沦日望洋。\n滚滚庆源浑未艾，应随罴梦兆佳祥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初署国学","author":"钟芳","text":"浙中造士厚予颜，太学尤惭造士艰。\n才短范模资六馆，日长鼓铎肃三班。\n为山数仞成于篑，藏器周身臭若兰。\n昼漏声沉弦诵静，凭轩小坐碧筠间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄秀才卒业南雍","author":"钟芳","text":"南望钟峰促晓旌，凉飙祛暑露初零。\n君才自是万人敌，鹗荐固应先著名。\n湖海放舟波浪阔，筌蹄过目羽毛轻。\n莫缘举业妨儒业，数仞宫墙接紫清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次介溪宗伯韵","author":"钟芳","text":"屏开晓日瑞光重，处处亭台面面峰。\n境静戍楼闻画角，江寒渔艇散萍踪。\n雀桥乌巷流风远，虎锯龙盘王气钟。\n圣寿与天无尽藏，漫言仙露在乔松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈司训之乐会学","author":"钟芳","text":"十载文场志未疲，一官归作士林师。\n情牵风木烝尝便，道在琴书轨范宜。\n花县日迟闻鼓铎，芹池春暖咏风沂。\n育才自是吾儒事，况复乡关系所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周司寇寿七十秩满次渠原韵","author":"钟芳","text":"寿身寿国道为医，济美如公父子稀。\n南北卿丞司帝宪，□先周鲁拜宸衣。\n岁筹荐益神弥健，世味更尝觉渐非。\n上最又乘秋色里，锡来丹诰日星辉。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送秦司徒凤山迁司空","author":"钟芳","text":"玉墀林立佩珊珊，圣主迟回注笔难。\n廊庙徽猷归骏望，乾坤春色上龙颜。\n传飞羽翰徵书急，船放江津去思闲。\n民敝不须多事事，溶溶卿月照寒潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽秦举人","author":"钟芳","text":"双亲淮水隔东吴，千里来娱望眼孤。\n金缕侑觞称上寿，玉楼撰记促妖符。\n香遗深院三秋桂，声咽平林半夜乌。\n泉壤不须长抱恨，联翩绳武看群雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送太常胡九峰","author":"钟芳","text":"几度同君侍祼将，碧笼烧烛话更长。\n朝天忽报三年政，倚玉都忘两鬓苍。\n合殿香烟浮绣绂，旧铨人物在缥囊。\n长安若作同官会，梁栋榱题细品量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送上舍陈舜辅归揭阳","author":"钟芳","text":"养就鸾翰待次铨，一时贤俊共联翩。\n韬囊忽动归乡思，舣岸先寻上濑船。\n庾岭晴峰高巀嶪，海门春涨碧潺湲。\n莫将岁月蹉跎过，转盼霜华已满颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和少宗伯黄久庵韵","author":"钟芳","text":"乘闲缓屧跻风磴，积翠萦纡道院深。\n宝鼎气销龙火伏，玉台花杳凤音沉。\n九霄仙界人难到，一粒玄机径可寻。\n脉脉有怀延伫久，寒汀烟荻动微吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游灵谷寺","author":"钟芳","text":"梵宫今历几春秋，十里松杉石径幽。\n率土尽传禅法象，谈空何怪晋风流。\n茶铛有焰飞丹鹤，香殿无梁架赤虬。\n欲到上方无觉处，白云苍栝共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顾司徒","author":"钟芳","text":"江云结绮青荧荧，之子乘之朝太清。\n路过彭国暑渐薄，柳暗御堤葵独明。\n宦成冰蘖见完节，人在庙廊知素名。\n华渚正逢天庆候，九霄仙露下金茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林司成文俊方斋","author":"钟芳","text":"物外丰神玉不如，往来常在太微虚。\n两都模范归儒彦，天下英才入化枢。\n鸣佩彤墀尧日近，横经御幄禹谟俱。\n奠将芹藻曾承乏，他日书来肯忘予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"任兵部后怀九峰用渠齐居韵","author":"钟芳","text":"客台仙驾喜追攀，暂䮕联镳意自殷。\n话隔聊凭文字狎，时清仍得簿书闲。\n离朱鉴识骊黄外，夔契谟猷伯仲间。\n独坐有怀情漠漠，沣兰孤咏一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至前二日赏东麓亭和司马王浚川韵 其一","author":"钟芳","text":"山木经霜尽白颠，森森桧柏翠堪怜。\n物情岂为人呈媚，冰操由来晚更妍。\n鹤唳莺声图外景，岚光潭影镜中天。\n豪吟各负风云气，沽酒何曾论费钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至前二日赏东麓亭和司马王浚川韵 其二","author":"钟芳","text":"杳杳孤亭倚翠开，晓凭清霁首重回。\n江拖素练天边下，云结玄堂海上来。\n尺舄径登栖鹘处，半山如见读书台。\n相逢总是神仙骨，何必璚英入寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和冢宰刘紫岩韵","author":"钟芳","text":"长江缭绕自岷峨，此地英灵占独多。\n不爱烟霞留客住，每勤珠履带星过。\n清时信我频登眺，秀句输君善琢磨。\n拟效吴歈更答和，待君诗就为君歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东麓倡韵","author":"钟芳","text":"偶陪赏眺向朝阳，亭负苍岩竹气凉。\n城外江山来衽席，云中宫阙间玄黄。\n酡颜莫惜十分醉，煦影须怜一线长。\n遥忆枫宸嵩祝后，列仙齐献万年觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨都督","author":"钟芳","text":"昔年雄略镇淮阳，号令俄飞六月霜。\n垂老自耽陶径乐，投闲何惜楚弓亡。\n函关挹翠归程便，天府铭丹世绩长。\n高枕梦酣无一事，簪缨早付黑头郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何常州","author":"钟芳","text":"禁垣抗疏力回天，分牧名邦屈俊贤。\n双节先舆行处适，五台排戟望中妍。\n漫听老稚歌尧日，不问勋名着祖鞭。\n公事判馀黄阁静，荷香浮动水晶帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送恒山张中丞","author":"钟芳","text":"造物谁能寸寸量，青霄孤鹤自昂藏。\n几番剡荐成蕉梦，一夕飙回散鞠场。\n川险定资舟楫利，剑锋暂閟斗牛光。\n行休且爱初心遂，圃有霜梨粟酒香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丘少参","author":"钟芳","text":"莺啼春晓瑞光重，映日金绯换旧容。\n数谏共推师氏直，新衔初试楚藩雄。\n殊方经略风云外，万国舆图指掌中。\n驿路山花迎客笑，也分颜色到疲癃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林宪副","author":"钟芳","text":"金章玉节拥千夫，殊擢南科旧日无。\n气合太阿横素练，心如秋月湛冰壶。\n茝兰拟结湘灵佩，干羽常思帝舜谟。\n乡曲与君同海上，送君回首夜吟孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再和李蒲汀韵","author":"钟芳","text":"白帝扬麾夜雨濛，雪花渐结海云同。\n几番齐学霓裳舞，万片寒欺玉色珑。\n泽渗平田催麦长，冻添幽涧碍泉通。\n春来况值农祥正，鸡黍家家乐岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和凤山韵","author":"钟芳","text":"忧国心同事亦同，办香晨祷向瑶空。\n颙孚蝢觉神灵近，瑞应堪徵国步隆。\n竟日飞花三尺剩，普天堆玉万家丰。\n挥毫欲效元和咏，白雪阳春愧钜工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和太司寇周贞庵韵 其一 除夕","author":"钟芳","text":"暝色如烟刻漏长，喜看残腊入青阳。\n江山随在可为侣，萧鼓不眠何处郎。\n新火满城光烛汉，清觞到手玉浮香。\n无端岁月频虚掷，何物能玄两鬓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和太司寇周贞庵韵 其二 岁朝","author":"钟芳","text":"带病离家喜即医，素琴敢谓识音稀。\n年光流入催华发，柳色乘春上客衣。\n忙里风尘闲乃觉，梦中乡曲醒还非。\n登台欲效书云物，旭日朝腾五色辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李蒲汀","author":"钟芳","text":"百司领袖重南畿，上应文昌佐太微。\n五色云梦胸次阔，一门卿相眼中稀。\n虞廷化日锵鸣佩，莱彩春风炫舞衣。\n咫尺丹霄行色里，东人何怪咏鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄久庵","author":"钟芳","text":"绣服纡朱带绾金，南宫清望旧词林。\n世家簪笏传清白，方寸经纶贯古今。\n陂影晴涵千顷碧，虞音夜入五弦琴。\n只今庙议咨夔契，会有吁谟沃帝心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送怀宁侯孙","author":"钟芳","text":"不为霜颅爱乞闲，帝怜材隽暂交还。\n丹书旧衍山河誓，玉节重当虎豹关。\n恩重两朝陪辇毂，威伸南甸折凶顽。\n古来名将传孙子，我欲从君识一班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少宰李公五十二始生子 其一","author":"钟芳","text":"翩翩吉报迓宾鸿，象纬流光寝户东。\n仙果生迟延乃庆，渥驹神俊慰而翁。\n世连卿辅人矜戴，喜盎门阑气郁葱。\n遥忆寅僚称庆日，笙歌清彻画堂中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少宰李公五十二始生子 其二","author":"钟芳","text":"后先桥梓重朝班，更见孙枝臭拟兰。\n神自梦中亲抱送，珠于掌上递传看。\n魏家簪笏流风远，韦氏云仍奕业安。\n报政有期残臈外，绕炉烹雪更团栾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿周母太夫人八十","author":"钟芳","text":"儒绪官封冠士林，更推彝训作官箴。\n绣衣珠翟十分宠，雨草春辉一样心。\n户外江山怡灏景，堂前兰桂合重阴。\n潘生漫赋慈颜乐，荣寿兼隆正自今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别南都诸公","author":"钟芳","text":"同戴晨星拜紫宸，临溪忍逐塞鸿分。\n廿年羁旅风霜惯，万里离家仆隶亲。\n金阙鼓钟催客梦，凤台花柳负青春。\n幽情欲语终无语，回首江东几暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过玉山得雨溪涨重九怀马柳泉","author":"钟芳","text":"山溪易涨易为消，我到欣逢雨泽饶。\n旅馆暂停需晓霁，扁舟堪放趁秋涛。\n重阳节近黄花好，野塞云寒白雁高。\n淮上达人回首远，一樽谁与醉香醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"复姓拙稿","author":"钟芳","text":"生平情事郁丝桐，泣遍春衫杜宇红。\n草木有原天素定，川流到海性方融。\n民彝自合遵周典，华阀宁须附郭公。\n幽憾百年今始雪，揣心何以答重瞳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈太守常之建水州","author":"钟芳","text":"遗经独抱卧溪山，屡挫文场意自闲。\n晚岁一官分虎竹，边城万姓迓熊轓。\n时清何惮封疆僻，材骏谁云展布艰。\n浙上师模惭契旧，频行宁忍赠言悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽张中舍次陈司寇韵","author":"钟芳","text":"早岁来游白玉京，可怜重器丧垂成。\n官从中翰居新业，人自东瓯著夙名。\n华表夜寒孤鹤迥，锦林春烂一柯倾。\n泉台莫抱趋庭恨，棣有秾华不断生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次李少宰蒲汀韵","author":"钟芳","text":"浮踪汩没宦尘间，临事常閒退更閒。\n过眼繁华花上露，到头器业筦中班。\n渔樵自适歌黄鹄，轮辐高悬卧碧山。\n感旧徘徊去城阙，万年青史待君删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]