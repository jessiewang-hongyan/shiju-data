[{"title":"喜白鹿书院新成","author":"苏葵","text":"撤旧营新数十楹，日华星彩映丹青。\n轩窗爽闿意偏豁，尘土隔离心自清。\n檐外有山皆屹屹，门前无水不泠泠。\n病夫岂漫誇虚器，吾道真思托后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京还□溪道中感兴","author":"苏葵","text":"去去来来霜满颠，贪他毕竟被他缠。\n挥戈有术思回日，鍊石无功愧补天。\n崇让每探刘实论，□疑将续夏侯篇。\n酣来张袖江头舞，拂尽浮岚月在船。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过十八滩久晴水碧爱而咏之","author":"苏葵","text":"天光湛湛水泠泠，一色寒潭绿染成。\n孙楚枕边长自漱，子陵竿下不如清。\n绝无渴虎堪蛟取，只有潜鳞被鹭惊。\n闲煮凤团分数斗，翠涛甘冽失中?。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题郁孤台","author":"苏葵","text":"飞宇压城何处州，鹧鸪声里翠岚收。\n云连谢尚游谈渚，月满坡翁得句楼。\n天近每瞻文气在，夜深如傍酒星游。\n豪华满地消磨易，赖有青山惬醉眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟泊天津望京师有作","author":"苏葵","text":"东观编摩迹已灰，柁楼时倚望蓬莱。\n平津此日少新阁，郭隗千年空旧台。\n悟主片言谁有分，论文八斗我非才。\n凭君莫问升沈事，且得朝天一度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛酉南还过梅关","author":"苏葵","text":"昔去今来屈指频，梅花开落十经春。\n有情芳草碍骄马，无恙老松迎远人。\n一惬愧谁怀尺璧，八驺迟我引双轮。\n道旁关吏私翘盼，应讶终军白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过飞来寺","author":"苏葵","text":"舟过飞来欲驻桡，此桡非为此僧邀。\n米家水墨留真景，梵刹松涛落变韶。\n不必雨催诗得句，更无人劝酒倾瓢。\n凭君候我莲花社，五斗年来懒折腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暂归村居漫成柬晦峰逸士二首 其一","author":"苏葵","text":"处处花开衬马蹄，人间腐鼠欲何为。\n苦吟仲尉古应少，归去渊明今较迟。\n何梦更驰天上路，老年思琢竹间诗。\n杖藜小径聊回首，驷马分明是累棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暂归村居漫成柬晦峰逸士二首 其二","author":"苏葵","text":"车盖烟霞两路歧，低昂轻重至今疑。\n已无巢父凭谁会，除却图南到我知。\n高唱渔樵山落日，乱鸣鹤鹳雨添池。\n凭君莫道朱门贵，欲解簪缨换接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过鳌峰超然台谒东坡遗像","author":"苏葵","text":"此老南来世可怜，鳌峰诗在至今传。\n想应胜概须题品，未必忠良浪播迁。\n绍圣论诗元在剥，儋州归路自通天。\n穹苍后土知公处，不在词章百万篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游鳌峰宝陀寺","author":"苏葵","text":"独寻僧偶访头陀，若个禅师是鸟窠。\n秋入蒲团山色老，雨涵钟鼓浪声多。\n点头石在花将覆，结愿香深鹤正过。\n自笑尘心空未得，敢将禅学诮东坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予三十年前曾寄学乐昌后以道远之故得公牒移复本邑兹因川行道出前地感而有作二首 其一","author":"苏葵","text":"三十年前鼓箧游，石龟祠下惯夷犹。\n重来季子未金印，前度刘郎空白头。\n往事与风同过树，故人随柳半凋秋。\n行经要遣闲愁绪，暂代前闻作醉侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予三十年前曾寄学乐昌后以道远之故得公牒移复本邑兹因川行道出前地感而有作二首 其二","author":"苏葵","text":"弱冠迢迢事采芹，别来三十四经春。\n生涯落落徒悲梗，衣袂悠悠未拂尘。\n骢马漫寻新路去，江山应讶旧游人。\n摩挲往日题铭处，雨洗苔封认不真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过韩泷","author":"苏葵","text":"问津西上向湘潭，秋入韩泷思不堪。\n白浪滚花吞舴艋，翠岚飞瘴袭衣衫。\n日非停午山常碍，天剩中央水自涵。\n笑杀崎岖漫来往，白头真被利名酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"炼丹","author":"苏葵","text":"炼丹未成鸡犬愁，漫劳心事忆瀛州。\n仙家八洞无虚位，人世三生有尽头。\n颇怪洪崖悭接引，肯随秦政浪营求。\n丹台石室名空在，青鸟不来春复秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丫头山下与僧漫话","author":"苏葵","text":"丫头山下问浮屠，万劫千尘了得无。\n好把空禅悟薝卜，更将闲缠脱葫芦。\n如今僧远真谁子，在昔东坡是老夫。\n欲向山门更留偈，法华机上厌糊涂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与冯兵备宪副游衡州石鼓书院","author":"苏葵","text":"石鼓无声院宇清，木犀花拂豸衣馨。\n星回翼轸连衡岳，水合蒸湘入洞庭。\n人有天游聊纵酒，地多贤迹怯题铭。\n醉来敢辍忧时念，三诵灵均旧著经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长沙道中新寒","author":"苏葵","text":"寒气如砭入客舟，芙蓉凋尽楚江愁。\n朝吟尚拥公孙被，夜坐惟披晏子裘。\n黄苇叶旁银露结，丹枫树杪火星流。\n昨宵梦得西游路，玉垒峰前是益州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湘南舟中书怀","author":"苏葵","text":"天南天北路悠悠，帆影长时拂驿楼。\n身世本来同逆旅，利名终不是良谋。\n颠风白日江豚拜，骤雨黄昏海若游。\n安得养高林壑者，不将蓑笠傲王侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳阳楼投吕仙","author":"苏葵","text":"道骨仙风我有无，先生应为指迷途。\n许登天上清虚府，肯恋人间下大夫。\n老厌较书天禄阁，闲来闻笛洞庭湖。\n罗浮亦是烧丹处，拜赐微言便结炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三峡观山","author":"苏葵","text":"曾看佳山历几州，又从三峡放明眸。\n蛾眉云髻乱争晓，翠壁丹崖各自秋。\n耸处不知蹲处怪，雨中偏较月中优。\n胸怀磊落增多少，谁道浮生误远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日夷陵道中","author":"苏葵","text":"旋教篱落种黄花，恰好花时已别家。\n送酒不闻来水际，寻诗偏恨倚天涯。\n渣滩波急诸峰峭，阊阖风高一雁斜。\n莫道欲归归便得，也曾封事乞烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒黄陵庙二首 其一","author":"苏葵","text":"擘破青山白练飞，地平何独禹胼胝。\n灵通信是今犹在，名姓原来古未知。\n拳石尽能生恶浪，瓣香谁不叩行祠。\n远人欲究当时事，踏遍苔阶看断碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒黄陵庙二首 其二","author":"苏葵","text":"一牛触山山欲摧，巴江东注何悠哉。\n土能制水本堪据，神降自天胡可猜。\n旧典尽经秦火灭，无人亲见禹功来。\n威灵尚杀惊湍势，从众维舟奠酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫峡遣怀","author":"苏葵","text":"石牙欲齧江欲吞，蜀道险恶宁虚云。\n千金之子不垂坐，万里此行何独勤。\n青草接江愁白昼，玄猿挂树啸黄昏。\n典衣取醉复易醒，瓶罄凭谁添曲君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻观邸报三边消息二首 其一","author":"苏葵","text":"边塞扬尘明主忧，将军谁能除国仇。\n人才在世足供用，卿相留心旁采求。\n行伍感藏岳都统，推埋间有舞阳侯。\n寄声庶到金台上，骏骨如何可尽收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻观邸报三边消息二首 其二","author":"苏葵","text":"貂蝉人物未知兵，缩首边疆黠虏轻。\n所养大都非所用，求才须是不求名。\n驱羊搏虎事堪戒，捕兔择鹰功乃成。\n殉国捐生恨无地，夜深空梦受降城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题魏武庙","author":"苏葵","text":"功在元元血食宜，汉家赤子为公疲。\n江中怪木知谁姓，岸上老渔偏独痴。\n高鸟不栖山寂寂，野狐相狎草离离。\n至今一道西陵水，流到祠前也忸怩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过白帝城","author":"苏葵","text":"草昧英雄未定谁，路人先泣汉官仪。\n峡中形势非难恃，井底规模自不支。\n雉堞未颓春藓合，丽谯犹在夕阳迟。\n行人过日砧声急，欲和当年杜老诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过夔州八阵台","author":"苏葵","text":"经纬纵横八阵奇，也缘忠义鬼神知。\n三分事往台空在，千古江流石不移。\n每夜天欃犹避舍，当年汉贼欲何为。\n大星若更迟迟陨，衔璧谁云不在丕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三峡即事","author":"苏葵","text":"夷陵西去问夔州，过处方知禹绩优。\n七百里中山不断，万千年后水平流。\n黄陵祠古苔成褥，白帝城高鸟避楼。\n历尽间关心欲折，更堪深树叫軥辀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夔府","author":"苏葵","text":"夔府秋深滟滪平，凫鹥眠处水泠泠。\n百牢关外山偏怪，八阵台前石自灵。\n无复梦魂惊恶濑，尽将诗思寄高冥。\n坐来不觉江云起，细雨丝丝到驿亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁晏偶怀陈宪长金丹之谈赋此遣兴","author":"苏葵","text":"梅花催得岁华阑，日短乾坤却老难。\n百丈潭头惊白发，一炉何处觅金丹。\n未逢陇石封君达，空记嵩山靖长官。\n历把世间刍狗看，等閒真欲振飞翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日郊行","author":"苏葵","text":"东风披拂暖云移，草色梅香上酒旗。\n高盖何曾杀风景，二毛偏自愧花枝。\n闲来观物尧夫我，醉去寻诗杜老谁。\n篱落野翁相向笑，笑人尘土漫贪痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同前奉和江景吴寅长韵","author":"苏葵","text":"隔岁梅花也当新，游人不待艳阳辰。\n欲分牧竖松根石，谁献山杯竹叶春。\n啼鸟四郊张野乐，垂虹一道落天绅。\n才华独有文通富，乘兴题诗索简频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同前奉和陈宪长韵","author":"苏葵","text":"近水寻春酌酒忙，可流觞处便流觞。\n溪光浅漾酡颜影，花气浓薰白发香。\n自爱风流追鲍谢，谁将名利托金张。\n蓬蒿斥鴳怡然在，肯羡鹍鹏九万翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同前奉和张宪副韵","author":"苏葵","text":"花为东风树树开，是谁吟弄傍花来。\n阳春有倡承遗简，布鼓无声怯殷雷。\n市肆几家堪贳酒，故人随处许通才。\n寻常博得云安醉，拍板狂歌一剪梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉定舟中漫兴","author":"苏葵","text":"锦江三月水平沙，小泛人间博望槎。\n故郡叠楼山缭绕，长亭嘶马树周遮。\n心因险道常多折，发为浮名大半华。\n飞梦乡间何处是，石桥流水荔枝花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"童正郎曾使唐府册封事竣王以诗卷赠之至是出相视因题","author":"苏葵","text":"丰镐诸姬八百秋，剪桐安敢议西周。\n山川今有封藩册，风雅君能挟此辀。\n花下星回天使节，酒边烛影上公旒。\n归时却尽黄金赆，留得东平翰墨优。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重庆行台观山偶成","author":"苏葵","text":"雨添山色上行台，惹起寻山旧癖来。\n梦里尚磨文字鉴，峰头偏欠浊醪杯。\n五车糟粕真成梏，百丈岩崖未有媒。\n看到夕阳心欲折，数株高树鸟飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日发酆都东下","author":"苏葵","text":"滟滪江深亦畏途，行人春尽下酆都。\n苍烟飞翠迷旌旆，白雨跳珠上舳舻。\n周政以来皆大学，虞官之后少司徒。\n辞章却愧闲陶冶，试问青山笑客无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿分水公馆遣怀","author":"苏葵","text":"飞飞萤火闹疏帘，分付山精守四檐。\n小结烛光经几换，旋敲更鼓入三严。\n因无人语心偏静，为有诗魔睡不甜。\n拂尽薛笺天已曙，板舆轻度万山尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后道中漫兴","author":"苏葵","text":"溪水泠泠溪石平，山花红近水边明。\n行人过此不忍去，索酒对之聊寄情。\n贪坐自然忘却久，漫题非是强教成。\n何时谢得渔须困，洗耳矶头更濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过柏林漕岭绝顶","author":"苏葵","text":"仆夫轧轧送肩舆，数过长松一万株。\n山不到天惟咫尺，石无含雨亦须臾。\n怕惊幽鸟停笳鼓，爱惜名花戒吏胥。\n莫道升高不知止，欲收风景尽天隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒诫","author":"苏葵","text":"银瓶金醴十分斟，三爵从来不易禁。\n中圣偶同徐邈妄，滑稽浑忘子云箴。\n渑池以外危应戒，名教之中乐可寻。\n误笑吴公淹壑谷，不知红日上东岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿南无寺","author":"苏葵","text":"南无寺前苍玉森，凤凰戛戛乘风吟。\n三更入枕忽惊梦，一点旅愁偏上心。\n曙色未分僧出定，月华犹在鹤鸣阴。\n眼前景物尽诗料，得句不从天外寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿定水寺煨笋","author":"苏葵","text":"编棘为门竹插篱，山花艳艳草离离。\n寺能脱俗何妨野，僧奈谈禅不爱诗。\n宿鸟在林惊月起，闲云栖窦逐风移。\n老夫未必如何胤，夜静聊参玉版师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潼川州还雨多为断港所困因题壁以告有司者","author":"苏葵","text":"山潦横衡截路沟，昼长临水驻骅骝。\n乘舆已是无人肯，王政徒云有日脩。\n渡海压鞭嬴主石，济川能得傅岩舟。\n宾尸不待庖人事，此日谁怀受直修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望家书","author":"苏葵","text":"锦江不与海珠连，东去西来路九千。\n湘水亘澜黄耳路，巫山高碍白鸿天。\n乡关有梦曾终夕，父子无书又隔年。\n莫道居官还内顾，私恩公义两须全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和江景吴寅长经理屯田道中见寄","author":"苏葵","text":"强追霜押窘于徊，天放檐花著意催。\n自昔到公金掷地，如今惭我釜鸣雷。\n驱驰莫管青山讶，凋瘵真烦赤手培。\n王道本来嫌掊尅，曾将阡陌咎谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"首尾吟二首 其一","author":"苏葵","text":"老夫非是爱谈虚，世事纷纷与梦俱。\n莫道忘羊专博塞，须知得鹿亦蘧庐。\n曾闻聃叟论刀密，欲起坡翁笑磨驴。\n信有眼前一杯酒，老夫非是爱谈虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"首尾吟二首 其二","author":"苏葵","text":"老夫非是爱闲言，膏火怜渠谩自煎。\n汉史偶观方技传，南华深契达生篇。\n贤愚贵贱真同尽，才辨聪明不要全。\n几个孟郊鸣未了，老夫非是爱闲言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"成都即事","author":"苏葵","text":"春风岁岁少城隈，人物消沈若浪摧。\n花鸟未忘词赋客，江山曾识伯王才。\n三更井鬼星辰现，五月岷峨雪水来。\n惆怅卧龙招不起，雨声空过读书台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百丈潭","author":"苏葵","text":"千尺寒潭深未深，一泓清惬静来心。\n光浮元气天常蘸，脉接潜流地不沈。\n半夜月明猿渴饮，万山秋老鹤飞临。\n浴沂童冠今谁在，来和先生击节吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其一","author":"苏葵","text":"老去独怜诗思窘，秋光秋意尽撩人。\n青山几点雨中瘦，白雁一声天外新。\n九日不妨耽酒盏，东篱须酷护花神。\n酣来起舞张长袖，拂尽人间万劫尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其二","author":"苏葵","text":"九日无诗花亦笑，傍花吾敢当诗人。\n龙山落帽襟怀旷，栗里巾车句格新。\n倒尽松花和竹叶，吟翻牛鬼与蛇神。\n何人却浪牛山泣，世事从来等袜尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其三","author":"苏葵","text":"貂裘此日何妨典，忍作重阳醒面人。\n诗思许谁三峡涌，菊花为我一篱新。\n兴来放手争壶矢，醉后狂歌答酒神。\n一德惟馨宾主共，不扬香屑作芳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其四","author":"苏葵","text":"典午风流谁独最，尚遗馀韵到今人。\n逢秋酌酒年年是，作客看花处处新。\n有屐可酬山契分，无诗能为菊传神。\n醉中更欲清毛孔，自洗磁瓯点绿尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其五","author":"苏葵","text":"尊中白堕浇诗酒，台畔华裾把菊人。\n前此尽嫌良会少，几何能得好怀新。\n寒生暑退方流火，阴剥阳消漫怆神。\n抚景登高还有意，欲从千仞振衣尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其六","author":"苏葵","text":"论诗谁讶村夫子，爱酒自谈中圣人。\n先哲风标应未泯，重阳诗酒且从新。\n西风岂解通花信，万物原来有谷神。\n今日醉侯吾佩印，肯教螺盏旋生尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其七","author":"苏葵","text":"孟嘉本是风流客，靖节原非冲淡人。\n物换星移千古异，菊香山色至今新。\n酒逢知己酒无量，诗到名家诗有神。\n莫惜花前了清兴，明朝犹是马蹄尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其八","author":"苏葵","text":"长虹一饮百川竭，对景岂无弘量人。\n两鬓满簪霜底杰，百壶刚压瓮头新。\n何妨仕路逢山鬼，且弄秋光信笔神。\n醉后每多齐物意，欲将华岳等纤尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日饮冰玉堂和韵十首 其九","author":"苏葵","text":"天外蓐收将税驾，阶前蟋蟀欲依人。\n蝉楼老叶霜华重，雁抹残霞物候新。\n蜡屐乍穿怜屐齿，酒钱无办怪钱神。\n西风似解知人意，不送元规陌上尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]