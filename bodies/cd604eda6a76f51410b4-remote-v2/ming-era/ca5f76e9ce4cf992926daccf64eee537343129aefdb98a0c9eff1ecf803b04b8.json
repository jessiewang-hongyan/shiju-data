[{"title":"重咏杨妃菊","author":"张泰","text":"冷香微艳谢荒淫，谁遣狂心改道心。\n应向驿途零落怕，至今幽处托根深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35337,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夫子学师襄琴图","author":"姚纶","text":"周衰乐废缺，正声几湮沈。\n苟无独识者，世远将焉寻。\n所以孔夫子，俛学师襄琴。\n初弹猗兰操，再鼓文王音。\n至和格鸟兽，跄舞娱人心。\n此图写遗意，山高流水深。\n披玩发长嘅，视古犹视今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35338,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春闺怨","author":"姚纶","text":"春闺无人春日长，莺声恰恰啼垂杨。\n美人睡起倦梳洗，芳容娇褪梅花香。\n绿云鬅鬙钗半亸，蛾眉蹙处开愁锁。\n绣奁尘掩秋月辉，口脂红淡樱桃颗。\n玉笙何处吹伊凉，紫骝骄嘶隔粉墙。\n停针懒刺双鸳鸯，倚栏踌躇空断肠。\n守宫点腕红凝血，一寸芳心万愁结。\n宜男正开郎不归，东风满地梨花雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35339,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪景","author":"姚纶","text":"寒空飞雪满，天地玉壶中。\n一色梨花月，千家柳絮风。\n山童候虚牖，吟客载孤篷。\n试问阳春曲，何如白战工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35340,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画马","author":"姚纶","text":"何年来骏骨，画史貌能真。\n千里电一掣，五花云满身。\n香尘金谷道，青草玉关春。\n独立浑无侣，长鸣似向人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35341,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华山高睡图","author":"姚纶","text":"白云深似海，长日睡瞢腾。\n脱帽露双髻，支颐曲一肱。\n闻鹃时已定，化蝶梦无凭。\n惆怅华山顶，无人得解登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35342,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"红白荷花","author":"姚纶","text":"镜底新妆扇底歌，倚风无力舞婆娑。\n醉来西子容偏媚，老去秋娘鬓已皤。\n霞暖绣衾春梦雨，雪香罗袜晓凌波。\n分明太液池头见，点染风流更觉多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35343,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"城市山林为玄妙观羽士赋","author":"姚纶","text":"步入东关一径深，始知城市有山林。\n黄梁不作尘中梦，白日长閒世外心。\n凤载紫箫吹落月，鹤窥香霭听鸣琴。\n人间只此为蓬岛，何用仙槎海上寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35344,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪洞","author":"姚纶","text":"一室穹窿䨱地圆，宜留小榻坐神仙。\n凿开茧瓮浑无物，踏破冰壶别有天。\n梅谷花香春似海，梨云梦稳夜如年。\n几回酒醒灯残后，错认璚楼深处眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35345,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江湖胜览卷","author":"姚纶","text":"江湖随处豁吟眸，不满诗囊卒未休。\n日下风云瞻魏阙，淮东歌舞认扬州。\n一篷疏雨鸥边晚，千里残霞鹜外秋。\n见说武昌城畔柳，尚含青眼待重游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35346,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹石山房","author":"姚纶","text":"山房种满碧琅玕，怪石相依更好看。\n玉气暖蒸云五色，翠梢晴弄日三竿。\n白羊未化长眠雨，綵凤双栖不畏寒。\n补遍苍天人不老，清风日日报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35347,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"联璧卷","author":"姚纶","text":"仙子瑶台玉一双，碧桃红杏递生香。\n绛裙拂地春同步，宝镜开奁晓并妆。\n织翠舞衫封蛱蝶，泥金歌扇画鸳鸯。\n卷中乍识春风面，恼我题诗一断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35348,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"醉月楼","author":"姚纶","text":"清夜何须秉烛游，且邀明月共觥筹。\n口吞丹桂婆娑影，手掬金茎沆瀣秋。\n天上无梯登兔窟，人间有地筑糟丘。\n醒来不记更深浅，惊见东方白满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35349,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋闺怨","author":"姚纶","text":"黄叶满阶秋已阑，征人千里隔长安。\n年年怨杀西风雁，不送书来只送寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35350,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"脩竹仕女","author":"姚纶","text":"瑶台无信托青鸾，一寸芳心思万端。\n莫向东风倚脩竹，翠衫禁得几多寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35351,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花小幅","author":"姚纶","text":"贪看璧月挂梢头，几向花前倚醉游。\n无柰翠禽啼处苦，不容清梦到罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35352,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题汤公著都门话别","author":"姚绶","text":"忆昨都门别，雨雪正霏霏。\n今我湖上逢，春风吹罗衣。\n故里讵弗乐，疏戚聚成围。\n藉草对山花，羽觞急如飞。\n一醉万事忘，扁舟荡斜晖。\n天涯同气人，濡滞未得归。\n处世谁足意，相顾聊歔欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35353,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为朱良贞题扇","author":"姚绶","text":"考亭夫子安亭来，爱我溪上红莲开。\n手摇羽扇坐忘暑，戏折碧筒閒作杯。\n碧筒杯宽任鲸吸，却嫌玉童催饮急。\n李云处世若大梦，杜曰举觞须累十。\n白日欲下清风徐，我怀与世同卷舒。\n如何苦索题此扇，大呼墨卿当醉馀。\n为君遥想白鹿洞，那得武夷清景共。\n还期月夕究参同，似此前脩足珍重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35354,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画为杨司训作","author":"姚绶","text":"烟光漾风青入楼，立马回望湖山头。\n游丝飘飖几千丈，不系白日增人愁。\n春愁大半行乐少，渡口桃花镜中老。\n劝君尽醉如杜陵，莫待春归怨啼鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"桐村小隐","author":"姚绶","text":"河流南入市，径路北通村。\n新结草堂好，旧栽桐树繁。\n儿童知稼穑，鸥鹭识琴樽。\n有客问奇字，乘舟直到门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游虎丘","author":"姚绶","text":"舟行忽到寺门前，侵晓梳头废晏眠。\n老去已閒题柱手，平生多结看山缘。\n苔茵坐藉生公石，茗枕汤分陆羽泉。\n如此深春如此乐，还留馀兴待明年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和靖观梅","author":"姚绶","text":"人人尽识林和靖，不识平生隐者心。\n老去喜无封禅藁，兴来愁费爱山吟。\n梅花香影依然在，蔓草祠堂不可寻。\n今日匆匆书弗尽，六桥斜日满疏林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"菩提寺与雨庵夜话","author":"姚绶","text":"菩提绝似古招提，两屐行来自不迷。\n旧伴閒云归竺国，新添流水入曹溪。\n何人谩放双凫去，老我还同一鹤栖。\n刻烛相看过夜半，廿年心事重留题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寄荆门判俞君汝钦","author":"姚绶","text":"解携三度见秋残，开过黄花独倚阑。\n寄赠虽无青玉案，相期惟有紫宸班。\n书从回雁来千里，望绕荆门隔万山。\n宣室求贤正如渴，伫看明诏为催还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"慈乌","author":"姚绶","text":"昔乌巢我树，母在慈乌来。\n无母今何恃，惟增返哺哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"折花仕女","author":"姚绶","text":"爱濯蔷薇露，凌晨试折来。\n低鬟犹未插，含笑傍妆台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹寄内弟公操","author":"姚绶","text":"忆共江南水竹居，清风三径黑甜馀。\n而今对画思兄弟，纵有双鱼莫寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"常山道中","author":"姚绶","text":"鸟未投林日未曛，松头野鹤自成群。\n肩舆归去身强健，处处青山有白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为僧题画","author":"姚绶","text":"问渠何事懒参禅，答我新来结懒缘。\n窗外日高啼鸟乱，拥衾犹伴白云眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枯木竹石图","author":"姚绶","text":"秋风吹空古树叶，白雨压低新竹枝。\n净扫石头看霁色，满襟凉影鬓丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"周鼎代方文美送荥阳阴玺下第归","author":"姚绶","text":"与尔业同经，同期虎榜荣。\n相看虽失意，为别谩多情。\n伐木歌黄鸟，看花倒玉觥。\n驱车向宛洛，吾棹亦南征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日见杨花寄章文重","author":"姚绶","text":"见说浮萍草，前身是此花。\n但因随驿骑，转觉恋鸥沙。\n宛冉青春暮，微茫落照斜。\n怜予根蒂薄，相值共天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赤壁图","author":"姚绶","text":"月出大江流，鹤鸣天宇秋。\n霸图馀赤壁，逐客自黄州。\n頫仰违金马，登临命玉舟。\n曹刘顾安在，身世亦何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淡庵","author":"姚绶","text":"寻君秋色里，烟雨旧柴扉。\n妇具盘蔬出，童携市酒归。\n弹琴忘巧拙，得句学陶韦。\n笑指溪头水，交情似尔稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怡荣","author":"姚绶","text":"何以悦亲颜，儿从阙下还。\n玉壶春酒绿，金织舞衣斑。\n恺悌哦松外，从容问膳间。\n令人自兴孝，喜色满家山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南浦烟篷","author":"姚绶","text":"推篷南浦上，烟雨淡离愁。\n萧瑟菰蒲晚，微茫泽国秋。\n鱼盐通县市，蓑笠语邻舟。\n无限林泉意，凭轩下白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水榭荷风","author":"姚绶","text":"十顷澄波上，何人为筑台。\n藕花开自落，鸥鸟去还来。\n凉吹飘飘入，疏窗面面开。\n烦襟净如洗，更进碧筒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送黄给事晖奉使满剌国封王 其一","author":"姚绶","text":"远国来王日，深恩册拜时。\n玺书中禁出，天语使臣知。\n路指诸蕃近，山行四牡迟。\n故人青锁梦，无限五云思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送黄给事晖奉使满剌国封王 其二","author":"姚绶","text":"使节随重译，皇仁被百蛮。\n海天同日月，风土异云山。\n驿骑孤城外，楼船叠浪间。\n归将慕华事，敷奏悦龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送僧归昆山","author":"姚绶","text":"乞食遍京畿，春江一棹归。\n只留吟后槁，不受施来衣。\n物外机应息，尘中迹渐稀。\n玉峰知到日，花雨积岩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别","author":"姚绶","text":"酾酒酹江波，中流发浩歌。\n孤舟天际远，芳草雨中多。\n解剑酬知己，题诗赠舞娥。\n人生百年尔，为乐莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高邮阻风骑行至界首驿","author":"姚绶","text":"策马湖堤上，来帆拂去鞍。\n断楂依浦溆，衰柳映风湍。\n轩冕追随易，庭闱致养难。\n年年好秋色，多在异乡看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答王公佩见寄","author":"姚绶","text":"池上绿阴肥，天涯客赋归。\n心随流水远，迹与故人违。\n千里复万里，斑衣当锦衣。\n终焉林下梦，不逐五云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别张廷端","author":"姚绶","text":"野亭芳树下，崖石大溪南。\n客去閒秋色，云来作暮岚。\n谁家留信宿，何处倚清酣。\n拾得琅玕竹，时时寄一函。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐","author":"姚绶","text":"不寐坐来久，无家席屡移。\n窗风书叶乱，檐雨漏声疑。\n客鬓惊秋早，乡心欲旦迟。\n扁舟沧海上，谁和竹枝词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春怀吴天使","author":"姚绶","text":"紫泥封诏下彤闱，四牡騑騑出帝畿。\n到处江山开霁色，随车花柳映春晖。\n莺啼水驿人相忆，荔熟炎乡客正归。\n珍重绨袍情恋恋，此生惭与寸心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写怀","author":"姚绶","text":"终日摊书懒下楼，春来怀抱冷于秋。\n未能栗里归元亮，争说新丰寓马周。\n两屐青山应自远，半帘残月为谁留。\n东风莫遣杨花落，飘荡年年可暂休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武林归兴","author":"姚绶","text":"青山日日开图画，住久山中亦厌看。\n回首乡园归去好，恼情风雨别离难。\n悠悠杯酒陶潜醉，恋恋绨袍范叔寒。\n如此春光又啼鴂，兴来何必尽君欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻教谕见访","author":"姚绶","text":"故人风谊重丘山，车骑遥临巷陌间。\n酌水也能留客醉，看山何必待官閒。\n传呼列炬春生屋，指点严城夜启关。\n记得鸳鸯湖上月，为君三日未言还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贺美之见访","author":"姚绶","text":"贺家湖上看稽山，影落芙蓉清镜间。\n天宝诸公同祸乱，四明狂客自高閒。\n翠华南幸几亡国，紫气西来欲满关。\n今我逢君重吊古，酒船明月且忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"安亭朱良贞母节义","author":"姚绶","text":"节于夫尽义于姑，节义方能保二雏。\n人隔古今名独在，月分圆缺影同孤。\n未忘一日心先死，相见重泉泪始无。\n环燕纷纷争入画，等閒曾有柏舟图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陶耕学红白荷花扇面","author":"姚绶","text":"欲语还停隔扇罗，主家池馆晚凉多。\n红颜自得南薰意，皓齿偏能子夜歌。\n忽忆綵云湖上见，恍疑琼佩月中过。\n淡妆浓抹多相似，回首耶溪渺渌波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登灵岩山访张伯雨墓","author":"姚绶","text":"飞神曾谒紫宸朝，下上瑶天几泬寥。\n火宅已空谁堕甑，玉钩初解自成桥。\n千峰月色还相照，万古诗名耿不消。\n欲共山头黄鹤语，飙轮何日可予招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈希夷","author":"姚绶","text":"岳莲清入梦，倦眼为谁开。\n五季纷纷尽，真成一觉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武侯出师表","author":"姚绶","text":"王业偏安日，文章尔独醇。\n谆谆似伊训，初志亦耕莘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书","author":"姚绶","text":"池水欲成墨，古碑临罢时。\n閒从崖石上，风雨挟蛟螭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画","author":"姚绶","text":"画里还看画，都成物外春。\n云山落吾手，非赝亦非真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野兴","author":"姚绶","text":"鸥白野云轻，高云缺树明。\n无人到湖上，听我唱歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"睡起","author":"姚绶","text":"只为诗魔在，昏昏眼倦开。\n谁将春草色，青入梦中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚坐","author":"姚绶","text":"胡床高柳下，团扇入怀新。\n笑指纤纤月，蛾眉学未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄陈秋鸿","author":"姚绶","text":"閒事莫轻涉，困来思吃茶。\n谁将双蛱蝶，管领野棠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斑竹","author":"姚绶","text":"闻道湘妃泪，如何染得成。\n多应春夜雨，消尽又还生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨妃醉归图","author":"姚绶","text":"金鞍欲上更迟迟，满镫春风拥侍儿。\n一种馀酣消未得，渔阳醒眼却多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨妃醉仆","author":"姚绶","text":"妖环不醉三郎醉，银烛高烧看海棠。\n满地閒云扶不起，楚台无梦梦渔阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王母蟠桃","author":"姚绶","text":"周王八骏不能留，青鸟飞来汉殿秋。\n自是桃花非一度，等閒三被朔儿偷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨花","author":"姚绶","text":"淡淡东风又落晖，留春不住送春归。\n无人更上长亭饮，惟有杨花在客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其一","author":"姚绶","text":"露下閒阶华月明，相呼女伴作双行。\n归来小院閒相语，几度庭闱梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其二","author":"姚绶","text":"不敢殷勤拜露香，满衣凉月动辉光。\n初时被选同年者，已有升居在绣房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其三","author":"姚绶","text":"准拟明当直晓班，巧随新样学宫鬟。\n笑渠鸱吻东边月，也作西楼子夜弯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其四","author":"姚绶","text":"莫打流莺宫树阴，鸟中惟此凤韶音。\n时时啼向房栊近，免得春愁上妾心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蔡琰归汉图","author":"姚绶","text":"纵多文思出天机，赢得胡笳泪满衣。\n万里归来身再辱，不如青冢不言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子陵","author":"姚绶","text":"竹帛勋名已有人，可无能友不能臣。\n一丝千古桐江月，多少清风激后尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":35408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]