[{"title":"同莫公远张羽王梁公智过道院访陈忠甫","author":"黎民表","text":"一探壶中隐，居然离俗尘。\n石幢阴过午，花院晚留春。\n侠烈心相许，萧閒兴是真。\n抽簪吾已老，羡尔白云人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书陶贞白十赉文赠田叔系以小诗","author":"黎民表","text":"知从京口渡，还礼华阳云。\n紫气三茅馆，真言十赉文。\n参苓谁解给，鸾鹤可为群。\n岂是抽簪日，归朝万石君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同张羽王梁公智步双河庵堤上","author":"黎民表","text":"凭眺非无地，偏寻一径幽。\n风花过净院，芦荻满汀洲。\n月渐中宵减，人嗟两鬓秋。\n负羁将谪宦，俱厌五陵游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送歙僧大海真了游五台","author":"黎民表","text":"结伴西游去，灵山似竺乾。\n锡飞千嶂顶，灯现五峰前。\n辛苦头陀行，平生佛国缘。\n若论心印在，还问海南禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾兼亭为丘谦之赋 其一","author":"黎民表","text":"儤直常经此，为园亦在兹。\n隐偏金马籍，地即缙云司。\n苑树常分色，宫莺或借枝。\n秪应兰省客，来往洽襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾兼亭为丘谦之赋 其二","author":"黎民表","text":"讵意风尘里，还将一壑看。\n浮沉操案牍，懒慢著衣冠。\n长啸应怀古，端忧更倚阑。\n耽奇吾亦尔，不是恋微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾兼亭为丘谦之赋 其三","author":"黎民表","text":"密竹千茎翠，幽花一径迷。\n闭门初散吏，倚树更分题。\n赖是官曹简，能将物我齐。\n杜陵多遣兴，长钓浣花溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾兼亭为丘谦之赋 其四","author":"黎民表","text":"当代文章伯，裁诗画省中。\n风流今不见，丘壑得无同。\n翰墨虚留壁，兰苕失旧丛。\n怜才惟郢客，洒泪此亭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁公智移官吉州 其一","author":"黎民表","text":"怀禄非吾愿，移官肯叹嗟。\n鹭洲迎解佩，螺水忆乘槎。\n梦寐销丹地，行藏问酒家。\n拿音一回首，红发满溪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁公智移官吉州 其二","author":"黎民表","text":"握手平生好，青云几客途。\n马空疲皂枥，人渐老屠沽。\n词赋名何益，弦歌计总芜。\n飘零壮心在，龙剑未全孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应妙寺即白塔寺僧慧乾居之","author":"黎民表","text":"杖钵携来久，香灯静院偏。\n栽花成野径，接竹引春泉。\n支遁逍遥论，天台止观禅。\n坐来忘妙说，塔影挂窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"护国寺以居僧之使远国者中有赵文敏碑","author":"黎民表","text":"汉家勤绝国，檀施表奇观。\n梵品从天竺，真僧是法兰。\n护碑龙首缺，巢栋燕泥乾。\n不见金缯出，关门用一丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双塔寺兴隆寺别院有金党元英碑今废为内教场","author":"黎民表","text":"长安开甲第，舍卫接王城。\n古佛旃檀阁，将军细柳营。\n灯残留说偈，碑半减题名。\n此是红尘地，轮蹄终日行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"能仁寺旧藏有桦皮梵经字甚精凿","author":"黎民表","text":"游人方舍俗，释子复开关。\n白拂支颐久，清言酌茗閒。\n书难窥豹管，墨是出鸡山。\n若杜毗邪口，谁传出世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪庆寺马尾松","author":"黎民表","text":"亭亭垂翠盖，趺坐一僧来。\n梁栋非吾事，青黄是木灾。\n枝连拂衣石，凉荫译经台。\n樗散拚人弃，摩挲愧汝才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"法弘寺建新城时关地有僧涅槃龛中其形如生即寺僧也","author":"黎民表","text":"浩劫知何代，长林过客迷。\n不知今壁垒，犹是昔招提。\n定里人长寂，花间鸟自啼。\n醉来惟荷锸，岐路任东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁寺有舍利塔僧道衍曾隐此","author":"黎民表","text":"青青千柏林，隋唐留至今。\n佛光时隐现，塔影半晴阴。\n草细经游鹿，庭閒演戏禽。\n机心刊落久，那复异人寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发长清县","author":"黎民表","text":"丹梯初引兴，愁绝赴前期。\n未蜡登山屐，先题望岳诗。\n停车松日下，解带麦风吹。\n万里游今始，抽簪恨苦迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏公亭","author":"黎民表","text":"谋生本业屦，岂意学逃名。\n千金兼束帛，无乃故人情。\n凿湖从此遁，蓬门空自扃。\n潮中有兰芷，俎豆共芳馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游顾玄言二泉山亭二首 其一","author":"黎民表","text":"尘土梦初醒，招寻得此亭。\n泉分双井练，楼入四山青。\n倚树方成偈，烹茶旧续经。\n异时鸡黍约，风竹细来听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游顾玄言二泉山亭二首 其二","author":"黎民表","text":"谁解捐尘网，烟霞共一欣。\n引杯承竹露，展簟接山云。\n丘壑应忘我，鱼凫正属君。\n扁舟从此去，渔钓幸相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱明洞","author":"黎民表","text":"乘蹻入清都，居然景气殊。\n泉声迷远近，松籁荅虚无。\n神室留丹火，仙家閟玉壶。\n冲腾已迟暮，物色待潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青霞谷","author":"黎民表","text":"霞外昔沉冥，松篁尚匝青。\n桥边逢洗钵，石上记翻经。\n一壑专名胜，千秋更典刑。\n偶来忘絮酒，长揖谢山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄龙洞","author":"黎民表","text":"秀甲朱明外，何年辟草莱。\n悬萝千磴暝，飞瀑二楼开。\n采药应迷屐，翻经尚有台。\n相期看日出，云气在蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞云顶","author":"黎民表","text":"飞步上㠝岏，星辰渐可扪。\n一山浮海至，五岭此峰尊。\n元气回阴洞，丹霞辟妙门。\n从来尘劫外，别自有乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答邹方伯","author":"黎民表","text":"共赋燕台月，佳期得重寻。\n剧谈当世事，推毂昔贤心。\n画省开文苑，青衿列道林。\n时艰思共济，吾待拂朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答孙观察","author":"黎民表","text":"入幕吾何敢，寒宵重有期。\n披云占藻思，零雨见新诗。\n弭棹沧江外，怀人落日时。\n归鸿如报客，春在万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日梅华堂开社招君肃寅仲公补少仲仲登公绍开先诸子","author":"黎民表","text":"北郭曾招隐，深留水石踪。\n蓬蒿怜二仲，文史入三冬。\n霜径初封橘，寒畦晚摘菘。\n故山吾不负，琴酒许相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潘子迁过梅华堂待月梁士哲继至","author":"黎民表","text":"三径蓬蒿在，风流二子过。\n狂来忘我懒，坐久觉情多。\n竹下黄花酒，风前白雪歌。\n徘徊还秉烛，明月待羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱贞吉孔阳昆玉以予校刻复古编有诗见讯奉答","author":"黎民表","text":"天禄归来日，谁知四壁空。\n技应怜刻鹄，文不悔雕虫。\n副墨名山在，馀生雅尚同。\n何时捉谈麈，披写对兴公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万里乘风卷送友人北上","author":"黎民表","text":"握手念将别，清尊尚未空。\n离心悬岭树，客路值秋风。\n鹏翮搏南海，鸿仪会泽宫。\n甘泉多侍从，谁为荐扬雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿黄母六十一初度","author":"黎民表","text":"喜际嘉平月，奇龄六秩开。\n萱花凌绮树，慈竹映春杯。\n绛节排云下，金书附鹤回。\n浔阳正清浅，红日莫相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潘子携酒同欧氏诸子过清泉山中出吴笺索余拙书因留夜坐","author":"黎民表","text":"通家称孔李，联骑问幽居。\n性洽高阳酒，名惭大令书。\n行吟随一鹤，风雨待三鱼。\n十载尘缨解，烟霞礼法疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"澹台子羽墓","author":"黎民表","text":"临河闻返驾，高第乃南浮。\n行径无芳躅，松楸馀故丘。\n山川良不改，吾道日悠悠。\n谁怜卑薄地，千古有麟游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人惠菊夜至","author":"黎民表","text":"柴桑虽久卧，三径未曾栽。\n海上封书至，篱根带雨来。\n繁霜吹短鬓，红烬落苍苔。\n纵是相逢晚，犹胜二月开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕同陈任夫高正甫麦仲张林开先舍弟惟仁侄璘集清居得燕字","author":"黎民表","text":"阁道双星过，虚堂暮雨悬。\n清歌闻激楚，宝剑忆游燕。\n雁下沉秋色，萤流入野烟。\n词人方接席，应不恨华年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春草堂为巍甫作","author":"黎民表","text":"谢公携屐处，坐爱一池幽。\n朱邸依兰阰，青山入蕙楼。\n云容开浩渺，客思满汀洲。\n莫叹群芳歇，王孙正薄游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尚雅斋为佳甫作","author":"黎民表","text":"试问通侯印，何如乐志园。\n传家为竹素，入室有兰荪。\n玉度波千顷，清吟月满轩。\n款门无恶客，芳醴正盈尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同丁计部诸子集王鸿胪山斋怀五岳之胜得高字","author":"黎民表","text":"名山谁历遍，挥麈亦称豪。\n岩壑驱词古，风云入望高。\n金光遥可掇，藜杖肯辞劳。\n猿鹤应相笑，驰烟待尔曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾鸿胪诸子邀同丁计部游玉河堤上得明字","author":"黎民表","text":"久作尘中客，閒从堤上行。\n轻风花外度，残照雨边明。\n趋事联三省，游踪愧二京。\n当歌聊驻马，轻别若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后过沈纯甫同艾蔡二曹长小饮","author":"黎民表","text":"偶尔襟期合，相携坐竹根。\n霜华犹满径，风叶漫开尊。\n故国飞鸿断，长途老马存。\n非君慰寥寂，谁解扫行园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨参军","author":"黎民表","text":"谢家传玉树，倾盖即依然。\n谏草犹存笥，琴尊半在船。\n莲花分幕静，杨柳挂帆偏。\n若是过牛渚，长歌夜月前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄孔昭","author":"黎民表","text":"千山初落木，归客兴偏新。\n药饵经秋减，萝衣似旧贫。\n侯门无左席，渔艇有閒身。\n到处堪栖泊，原非失路人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答蔡伯华刑部","author":"黎民表","text":"衡门方昼掩，特枉法曹过。\n良晤寻鸡黍，秋风入薜萝。\n名山思裹足，烟雨忆披蓑。\n不为沉冥久，逢君白石歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同姚伯子黄定甫邵长孺李季常游甘露寺","author":"黎民表","text":"高阁生远兴，飘然在五湖。\n暮云低不散，远树近看无。\n说偈参莲座，游踪渺玉壶。\n长天一回首，唯有月明孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题迟贤亭靳仙笔迹","author":"黎民表","text":"白云飞不去，掷笔此亭幽。\n星宿垂芒在，虫鱼汗简留。\n识奇空白首，招手即丹丘。\n欲展青毡卧，荒生霹雳愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过顾叔潜得题字","author":"黎民表","text":"幽寻不在远，吏隐占青溪。\n乡梦衔杯失，新诗摘叶题。\n萤疏经雨乱，花好傍人低。\n日出铜街静，犹能散马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡山人","author":"黎民表","text":"悬壶谁解识，负笈且归休。\n招手丹丘近，摇心白岳秋。\n虫鱼窥秘简，虹月傍行舟。\n回首风沙地，逢人笑黑裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏匏冠","author":"黎民表","text":"苦蒂才堪摘，良工巧斲成。\n不知蝉翼贵，宁让竹皮轻。\n束发禁霜冷，穿花滴露清。\n终焉惭戴鹖，还有著书名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐惟良之广陵二首 其一","author":"黎民表","text":"邗水遥通海，乘槎复此过。\n儿童骑竹在，盐铁算缗多。\n市估帆樯乱，人烟岛屿和。\n徒劳君莫叹，留兴在沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐惟良之广陵二首 其二","author":"黎民表","text":"才名馀画省，吏隐得沧洲。\n汀草生春色，渔歌唤客愁。\n疏灯京口渡，孤刹大江流。\n试问观涛处，词人几度游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡伯华之闽中","author":"黎民表","text":"出处几人异，非缘薄省郎。\n交情异贫贱，世事有沧桑。\n煮海窥盐策，题诗出射堂。\n流年堪自惜，何用叹浮湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过天宁寺僧宝檀方丈 其一","author":"黎民表","text":"曾有黄金地，谁为苦行僧。\n仗经行路远，采药入云层。\n一食伊蒲饭，长明石枕灯。\n不依禅宿去，头白已无能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过天宁寺僧宝檀方丈 其二","author":"黎民表","text":"野外芳华早，何妨策杖寻。\n草深垂井口，碑卧古坛阴。\n高坐惟尊足，清斋尚摄心。\n给园留赏处，还似阮家林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄清甫偕顾舍人游滇中","author":"黎民表","text":"旧好如禽庆，名山得共陪。\n洱河神禹导，路箐爨王开。\n冠带名家子，登临济胜才。\n关城雄剑阁，应待勒铭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻故园草阁火","author":"黎民表","text":"架上馀千轴，俱随绿燄飞。\n平生惟蜡屐，旧物秪牛衣。\n信是冥怀待，谁言损读非。\n啸歌聊复尔，北叟可同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同顾鸿胪兄弟过王鸿胪宅永上人在焉","author":"黎民表","text":"委巷多车马，还因典客名。\n乡心灯下尽，谈麈坐中倾。\n径草抽新雨，风丝漾晚晴。\n归舟应可问，春浪此时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑伯良邀同诸公登万佛阁","author":"黎民表","text":"日送莺花去，风雩兴可乘。\n尘心攀阁远，野兴入林增。\n龙树栖孤影，蜂房飐万灯。\n若无光禄酒，春思杳难凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"市中得旧琴囊而予无琴也","author":"黎民表","text":"锦样已模糊，何时混世沽。\n秪馀空橐在，多半古音无。\n携可缄诗草，闲将覆局图。\n勿言无所用，五石汎江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过范子宣观王生临帖","author":"黎民表","text":"用意颇精勤，毫芒细细分。\n春丝抽独茧，惊电出重云。\n携我青藜杖，书君白练裙。\n长安应纸贵，馀子但纷纭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈从训还丹徒","author":"黎民表","text":"河朔衔杯日，蓬莱奏伎游。\n寸心酬国士，片语逊名流。\n衣湿离筵雨，帆开驿路秋。\n南云正翘首，一雁下芦洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆无从","author":"黎民表","text":"不为忧生产，谁能废啸歌。\n谈经须历下，贷粟少监河。\n秋雨生黄叶，寒江拥白波。\n不知蓬室底，玄草近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李季常","author":"黎民表","text":"才名空落拓，诗句转清新。\n推毂无先辈，论交见古人。\n思君淮水月，携手蜀山春。\n不是逢沮溺，依然又问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中奉讯唐惟良","author":"黎民表","text":"带印无多日，前期远见寻。\n摇心双阙下，理棹五湖阴。\n客邸嗟燃桂，朝廷有赐金。\n萧条黄叶里，休忆白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同左辖郭公过广济寺","author":"黎民表","text":"左辖中朝贵，空门物外游。\n白云邀入寺，红树引登楼。\n积雨逢新霁，乡心值早秋。\n相酬无丽句，谁解识汤休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭方伯应宿至自南中止广惠寺同刘观察仲脩携酒奉讯 其一","author":"黎民表","text":"未觉双峰远，方营一日閒。\n旃檀入古寺，雷雨过空山。\n苔滑停车处，风生捉麈间。\n禅房宁久住，人望在朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭方伯应宿至自南中止广惠寺同刘观察仲脩携酒奉讯 其二","author":"黎民表","text":"南中无信使，竹下有行踪。\n岂谓天涯远，还于佛国逢。\n解衣停暮雨，闻梵报疏钟。\n世事悠然里，寒暄已自慵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘观察园亭送唐惟良还扬州同欧桢伯作","author":"黎民表","text":"省署昔攀援，衡茅更接连。\n藤萝犹迸月，池沼欲分天。\n作赋人投楚，登台价在燕。\n一将摇落思，销尽绿尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]